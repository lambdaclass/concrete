// Toy authenticated-tag model — DRIFTED variant for drift testing
//
// ITS OWN PACKAGE, for the same reason `elf_header_drifted` is: this file used to sit beside
// `main.con` in `examples/crypto_verify/src/`, and both resolve to module `main`. The project loader
// picked `main.con`, so this file's drifted bodies were never analyzed through the project path —
// reports printed these line numbers with the other file's semantics.
//
// Changes from original:
//   1. compute_tag uses subtraction instead of addition (breaks tag computation)
//   2. check_nonce accepts nonce == 0 (off-by-one, weakens validation)
//   3. verify_tag is unchanged

// === Provable core (pure, no capabilities) ===

// DRIFTED: changed + to - (breaks tag computation)
#[spec(Concrete.Proof.computeTagExpr)]
#[proof_by(Examples.CryptoVerify.Proofs.compute_tag_correct)]
#[proof_coverage(iff)]
#[proof_fingerprint("v2:8fd9d38950ec5907778483f166e61e26")]
fn compute_tag(key: Int, message: Int, nonce: Int) -> Int {
    return key * message - nonce;
}

// Unchanged from original
#[spec(Concrete.Proof.verifyTagExpr)]
#[proof_by(Examples.CryptoVerify.Proofs.verify_tag_correct)]
#[proof_coverage(one_direction)]
#[proof_fingerprint("v2:e5cc8653ab87df9679ec9a084811d21e")]
fn verify_tag(key: Int, message: Int, nonce: Int, expected_tag: Int) -> Int {
    let computed: Int = compute_tag(key, message, nonce);
    if computed == expected_tag {
        return 1;
    } else {
        return 0;
    }
}

// DRIFTED: accepts nonce == 0 (>= instead of >)
#[spec(Concrete.Proof.checkNonceExpr)]
#[proof_by(Examples.CryptoVerify.Proofs.check_nonce_correct)]
#[proof_coverage(iff)]
#[proof_fingerprint("v2:47ad120ae2795812e4c855ab356556e1")]
fn check_nonce(nonce: Int, max_nonce: Int) -> Int {
    if nonce >= 0 {
        if nonce <= max_nonce {
            return 1;
        } else {
            return 0;
        }
    } else {
        return 0;
    }
}

// === Shell (with capabilities) ===

fn main() -> i32 {
    let key: Int = 42;
    let msg: Int = 100;
    let nonce: Int = 7;
    let tag: Int = compute_tag(key, msg, nonce);
    let valid: Int = verify_tag(key, msg, nonce, tag);
    let bad: Int = verify_tag(key, msg, nonce, 9999);
    let nonce_ok: Int = check_nonce(nonce, 1000);
    return 0;
}
