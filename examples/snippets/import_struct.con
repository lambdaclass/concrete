mod A {
    // `pub` exports the type name and the functions; the field stays private
    // to this module, so other modules build an X through `new`.
    pub struct X {
        a: i32
    }

    pub fn new(a: i32) -> X {
        return X { a: a };
    }

    pub fn hello(x: X) -> i32 {
        let X { a } = x;
        return a;
    }
}

mod ImportStruct {
    import A.{X, new, hello};

    pub fn main() -> i32 {
        let x: X = new(2);

        return hello(x);
    }
}
