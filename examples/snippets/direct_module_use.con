mod test_direct_use {
    mod ffi {
        extern fn malloc(size: u64) with(Alloc) -> *mut u8;
    }

    mod intrinsics {
        #[intrinsic = "sizeof"]
        pub trusted fn sizeof<T>() -> u64;
    }

    pub fn main() with(Alloc, Unsafe) -> i32 {
        let mut x: *mut i32 = ffi::malloc(4) as *mut i32;
        *x = 2 + (intrinsics::sizeof::<i32>() as i32);
        return *x;
    }
}
