mod opaque_vec {
    extern fn malloc(size: u64) with(Alloc) -> *mut u8;
    extern fn realloc(ptr: *mut u8, size: u64) with(Alloc) -> *mut u8;
    extern fn free(ptr: *mut u8) with(Alloc);

    // A type-erased growable buffer: it stores raw bytes and the element size,
    // and each typed access names the element type at the call site.
    struct OpaqueVec {
        ptr: *mut u8,
        len: u64,
        cap: u64,
        element_size: u64,
    }

    impl OpaqueVec {
        pub fn push<T>(&mut self, value: T) with(Alloc, Unsafe) {
            if self.len >= self.cap {
                let new_cap: u64 = self.cap * 2;
                self.ptr = realloc(self.ptr, self.element_size * new_cap);
                self.cap = new_cap;
            }
            let target_ptr: *mut T = (self.ptr + (self.len * self.element_size)) as *mut T;
            *target_ptr = value;
            self.len = self.len + 1;
        }

        // References never leave a function, so an element is read out by value.
        pub fn get<T: Copy>(&self, at: u64) with(Unsafe) -> T {
            // todo: bounds check
            let target_ptr: *mut T = (self.ptr + (at * self.element_size)) as *mut T;
            return *target_ptr;
        }

        // The buffer is linear: releasing it consumes the vector.
        pub fn free(self) with(Alloc, Unsafe) {
            let OpaqueVec { ptr, len, cap, element_size } = self;
            free(ptr);
        }
    }

    fn main() with(Alloc, Unsafe) -> i32 {
        // Still missing impl static methods.

        let element_size: u64 = 4;
        let mut vec: OpaqueVec = OpaqueVec {
            ptr: malloc(element_size * 32),
            len: 0,
            cap: 32,
            element_size: element_size,
        };

        vec.push::<i32>(2);
        vec.push::<i32>(3);
        vec.push::<i32>(4);
        vec.push::<i32>(5);
        let pushed: i32 = vec.get::<i32>(2);
        vec.free();

        return pushed;
    }
}
