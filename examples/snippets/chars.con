 mod Example {
    // chars are not arithmetic types: convert to their code points to add them.
    fn main() -> i32 {
        let a: i32 = hello_chars('\t');
        return a;
    }

    fn hello_chars(a: char) -> i32 {
        let x: char = 'b';
        let newline: char = '\n';

        return (x as i32) + (newline as i32) + (a as i32);
    }
}
