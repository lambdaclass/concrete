// Evidence class: partial contract (one direction linked, converse outstanding).
//
// ct_compare's #[ensures] is a full iff, but only the same-tag direction
// (a == b -> 1) is linked here (coverage one_direction, no ensures_proof). Since
// bug 089 a coverage label grants nothing: `--report contracts` shows the
// postcondition `unproven — NOT discharged` until exact property acceptance can
// check what the theorem concludes. `concrete prove` names it the next obligation.
// (The flagship links both directions; this subexample deliberately keeps
// only one, so it must never read stronger than the flagship.)
mod demo {
    #[spec(Concrete.Proof.ctCompareExpr)]
    #[proof_by(Examples.ConstantTimeTag.Proofs.ct_compare_same_tag_correct)]
    #[proof_coverage(one_direction)]
    #[ensures((a == b && result == 1) || (a != b && result == 0))]
    fn ct_compare(a: [u8; 16], b: [u8; 16]) -> i32 {
        let mut diff: u8 = 0;
        for (let mut i: i32 = 0; i < 16; i = i + 1) {
            diff = diff | (a[i] ^ b[i]);
        }
        if diff == 0 { return 1; }
        return 0;
    }
}

pub fn main() with(Std) -> Int { return 0; }
