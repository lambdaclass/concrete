    #[test]
    fn test_connect_bad_address_ipv6() with(Alloc, Network, Process, Env) -> i32 {
        // IPv6 address should fail with AddressFailed since we use AF_INET
        let addr: String = "::1";
        let result: Result<TcpStream, NetError> = TcpStream::connect(&addr, 1);
        addr.drop();
        match result {
            Result::Ok { value } => {
                let closed14: Result<u64, NetError> = value.close();
                discard(closed14.is_ok());
                return 1;
            },
            Result::Err { error } => {
                return 0;
            }
        }
    }

    #[test]
    fn test_bind_empty_address() with(Alloc, Network, Process, Env) -> i32 {
        // Binding to an empty string should fail with AddressFailed
        let addr: String = "";
        let result: Result<TcpListener, NetError> = TcpListener::bind(&addr, 8080);
        addr.drop();
        match result {
            Result::<TcpListener, NetError>::Ok { value } => {
                let closed15: Result<u64, NetError> = value.close();
                discard(closed15.is_ok());
                return 1;
            },
            Result::<TcpListener, NetError>::Err { error } => {
                return 0;
            }
        }
    }

    #[test]
    trusted fn test_write_to_refused_connection() with(Alloc, Network, Process, Env) -> i32 {
        // Create a socket manually and try to send to it without connecting
        // socket(AF_INET=2, SOCK_STREAM=1, 0)
        let fd: i32 = socket(2, 1, 0);
        if fd < 0 { return 1; }
        // send on an unconnected socket should return -1
        let msg: String = "hello";
        let n: i64 = send(fd, msg.raw_ptr() as *const u8, msg.len(), 0);
        msg.drop();
        close(fd);
        if n < 0 {
            return 0;
        }
        // Some OSes may return 0 rather than -1; either means no data sent
        if n == 0 {
            return 0;
        }
        return 1;
    }

    #[test]
    trusted fn test_read_from_unconnected_socket() with(Alloc, Network, Process, Env) -> i32 {
        // recv on an unconnected stream socket should return -1
        let fd: i32 = socket(2, 1, 0);
        if fd < 0 { return 1; }
        let buf: [u8; 16] = [0; 16];
        let n: i64 = recv(fd, &buf as *mut u8, 16, 0);
        close(fd);
        if n < 0 {
            return 0;
        }
        if n == 0 {
            return 0;
        }
        return 1;
    }

    #[test]
    fn test_bind_duplicate_port() with(Alloc, Network, Process, Env) -> i32 {
        // Bind to an ephemeral port, then try to bind again on the same port
        // First bind to port 0 to get an OS-assigned port
        // We use a fixed high port instead so we can try to double-bind
        let addr: String = "127.0.0.1";
        let result1: Result<TcpListener, NetError> = TcpListener::bind(&addr, 49321);
        match result1 {
            Result::<TcpListener, NetError>::Ok { value } => {
                // Try to bind a second listener on the same port
                let result2: Result<TcpListener, NetError> = TcpListener::bind(&addr, 49321);
                addr.drop();
                let closed16: Result<u64, NetError> = value.close();
                discard(closed16.is_ok());
                match result2 {
                    Result::<TcpListener, NetError>::Ok { value } => {
                        // SO_REUSEADDR may allow this on some OSes; close and accept either outcome
                        let closed17: Result<u64, NetError> = value.close();
                        discard(closed17.is_ok());
                        return 0;
                    },
                    Result::<TcpListener, NetError>::Err { error } => {
                        return 0;
                    }
                }
            },
            Result::<TcpListener, NetError>::Err { error } => {
                // Port might be in use — that's ok, test is about the double-bind path
                addr.drop();
                return 0;
            }
        }
    }

    // Ownership on failure: close(2) on a descriptor that is not open fails
    // with EBADF. The failure is REPORTED (it used to be ignored) and the
    // handle is consumed: the error carries none, so it cannot be closed twice.
    #[test]
    fn test_stream_close_failure_reported() with(Network) -> i32 {
        let s: TcpStream = TcpStream { fd: -1 };
        let rc: Result<u64, NetError> = s.close();
        match rc {
            Result::Ok { value } => { return 1; },
            Result::Err { error } => {
                match error {
                    NetError::SocketFailed => { return 1; },
                    NetError::SetsockoptFailed => { return 1; },
                    NetError::AddressFailed => { return 1; },
                    NetError::BindFailed => { return 1; },
                    NetError::ConnectFailed => { return 1; },
                    NetError::AcceptFailed => { return 1; },
                    NetError::CloseFailed => { return 0; },
                }
            },
        }
    }

    #[test]
    fn test_listener_close_failure_reported() with(Network) -> i32 {
        let l: TcpListener = TcpListener { fd: -1 };
        let rc: Result<u64, NetError> = l.close();
        match rc {
            Result::Ok { value } => { return 1; },
            Result::Err { error } => {
                match error {
                    NetError::SocketFailed => { return 1; },
                    NetError::SetsockoptFailed => { return 1; },
                    NetError::AddressFailed => { return 1; },
                    NetError::BindFailed => { return 1; },
                    NetError::ConnectFailed => { return 1; },
                    NetError::AcceptFailed => { return 1; },
                    NetError::CloseFailed => { return 0; },
                }
            },
        }
    }

    // The success path: closing a real socket reports Ok.
    #[test]
    fn test_listener_close_ok() with(Alloc, Network, Env) -> i32 {
        let addr: String = "127.0.0.1";
        let result: Result<TcpListener, NetError> = TcpListener::bind(&addr, 49333);
        addr.drop();
        match result {
            Result::Err { error } => { return 0; },
            Result::Ok { value } => {
                let l: TcpListener = value;
                let rc: Result<u64, NetError> = l.close();
                if rc.is_ok() { return 0; }
                return 1;
            },
        }
    }
}
