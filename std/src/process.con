mod process {
    import std.libc.{exit as libc_exit, _exit as libc_exit_now, getpid as libc_getpid, fork as libc_fork, kill as libc_kill, waitpid as libc_waitpid, execvp as libc_execvp};
    import std.alloc.{grow,dealloc};

    pub enum Copy ProcessError {
        ForkFailed,
        KillFailed,
        WaitFailed,
        SpawnFailed,
    }

    // Signal constants
    pub fn sig_int() -> i32 { return 2; }
    pub fn sig_kill() -> i32 { return 9; }
    pub fn sig_term() -> i32 { return 15; }

    pub enum Copy ExitStatus {
        Exited { code: i32 },
        Signaled { raw: i32 },
    }

    pub fn process_exit(code: i32) with(Process) {
        libc_exit(code);
    }

    pub fn process_getpid() with(Process) -> i32 {
        return libc_getpid();
    }

    pub fn process_kill(pid: i32, sig: i32) with(Process) -> Result<bool, ProcessError> {
        let ret: i32 = libc_kill(pid, sig);
        if ret != 0 {
            return Result::<bool, ProcessError>::Err { error: ProcessError::KillFailed };
        }
        return Result::<bool, ProcessError>::Ok { value: true };
    }

    // A Child is an OWNING handle to one child process of this process (R-0484, audit F1).
    // Only `spawn` constructs one, and only in the parent branch of its own fork, so the pid
    // is greater than zero and denotes a child no other Child owns. There is no public
    // constructor from a raw pid: `0` and negative values name process groups to `kill`, and
    // `-1` means "any child" to `waitpid`, so a forged Child could wait on, or signal, a
    // process it does not own. The field is private, so a struct literal outside this module
    // is refused (E0297) as well.
    pub struct Child {
        pid: i32,
    }

    trusted impl Child {
        pub fn pid(&self) -> i32 {
            return self.pid;
        }

        // Consuming: a process is waited on exactly once — the Child handle
        // IS the obligation, and wait() discharges it (linear process API).
        pub trusted fn wait(self) with(Process) -> Result<ExitStatus, ProcessError> {
            // Destructure = consume the handle up front (it owns only the pid).
            let Child { pid } = self;
            let status: i32 = 0;
            let status_ptr: *mut i32 = &status as *mut i32;
            let ret: i32 = libc_waitpid(pid, status_ptr as *mut i32, 0);
            if ret < 0 {
                return Result::<ExitStatus, ProcessError>::Err { error: ProcessError::WaitFailed };
            }
            // WIFEXITED: (status & 0x7F) == 0
            let low: i32 = status & 127;
            if low == 0 {
                // WEXITSTATUS: (status >> 8) & 0xFF
                let code: i32 = (status >> 8) & 255;
                return Result::<ExitStatus, ProcessError>::Ok { value: ExitStatus::Exited { code: code } };
            }
            return Result::<ExitStatus, ProcessError>::Ok { value: ExitStatus::Signaled { raw: status } };
        }
    }

    // SUPPORTED RUNTIME PROFILE (R-0484 F9 — stated, not checked by the compiler). `spawn` is
    // the only fork path in std; removing `process_fork` closed the public route by which a
    // forked child returned to arbitrary code holding every owning handle. Forking itself is
    // supported under these conditions:
    //  - The process is SINGLE-THREADED at the fork. Concrete starts no threads. A program in
    //    which foreign code has started threads is OUTSIDE the supported profile for `spawn`:
    //    fork copies only the calling thread, so locks other threads held stay locked in the
    //    child, and nothing here makes that safe.
    //  - Between fork and exec the child branch runs no arbitrary user callbacks, no
    //    allocation and no stdio: only `execvp`, then `_exit` if exec fails. `cmd` is
    //    converted before the fork, and `args` must already be a NUL-terminated argv the
    //    caller built beforehand.
    //  - Descriptors are inherited: the parent's open descriptors survive into the child
    //    across exec, because std sets no close-on-exec. A close-on-exec policy is a separate
    //    follow-up, not part of this contract.
    pub fn spawn(cmd: &String, args: *const *const u8) with(Unsafe, Process, Alloc) -> Result<Child, ProcessError> {
        // Bug 043: NUL-terminate before exec; child image replaces us so the
        // copy is never freed on the exec path (freed on fork-parent path).
        let ccmd: *mut u8 = cmd.to_cstr();
        let pid: i32 = libc_fork();
        if pid < 0 {
            dealloc::<u8>(ccmd);
            return Result::<Child, ProcessError>::Err { error: ProcessError::SpawnFailed };
        }
        if pid == 0 {
            // Child process: exec
            libc_execvp(ccmd as *const u8, args);
            // If execvp returns, it failed. `_exit`, not `exit`: this child's stdio
            // buffers are copies of the parent's, and `exit` would flush them, writing
            // the parent's pending output twice (bug 072).
            libc_exit_now(127);
            // unreachable
            return Result::<Child, ProcessError>::Err { error: ProcessError::SpawnFailed };
        }
        dealloc::<u8>(ccmd);
        // THE ONLY Child CONSTRUCTION (F1). Reached only when pid > 0: pid < 0 returned above,
        // and pid == 0 is the child, which execs or `_exit`s. So every Child names a real child
        // of this process that no other Child owns.
        let c: Child = Child { pid: pid };
        return Result::<Child, ProcessError>::Ok { value: c };
    }

    #[test]
    fn test_kill_invalid_pid() with(Process, Alloc) -> i32 {
        // kill with nonexistent pid should return Err
        let result: Result<bool, ProcessError> = process_kill(99999, 0);
        match result {
            Result::Ok { value } => {
                return 1;
            },
            Result::Err { error } => {
                return 0;
            }
        }
    }

    // Disabled: spawn forks which creates child processes that continue running tests
    // #[test]
    trusted fn test_spawn_bad_command() with(Process, Alloc) -> i32 {
        // Spawn a nonexistent command — child should exec-fail and exit 127
        let cmd: String = "/nonexistent/binary/that/does/not/exist";
        let args: [*const u8; 2] = [cmd.raw_ptr() as *const u8, 0 as *const u8];
        let result: Result<Child, ProcessError> = spawn(&cmd, &args as *const *const u8);
        cmd.drop();
        match result {
            Result::Ok { value } => {
                // Child was forked, but execvp failed — child exits 127
                let wr: Result<ExitStatus, ProcessError> = value.wait();
                match wr {
                    Result::Ok { value } => {
                        match value {
                            ExitStatus::Exited { code } => {
                                if code == 127 {
                                    return 0;
                                }
                                return 1;
                            },
                            ExitStatus::Signaled { raw } => {
                                return 1;
                            }
                        }
                    },
                    Result::Err { error } => {
                        return 1;
                    }
                }
            },
            Result::Err { error } => {
                // Fork itself failed — also acceptable
                return 0;
            }
        }
    }

    #[test]
    fn test_signal_constants() with(Process, Alloc) -> i32 {
        if sig_int() != 2 {
            return 1;
        }
        if sig_kill() != 9 {
            return 1;
        }
        if sig_term() != 15 {
            return 1;
        }
        return 0;
    }

    #[test]
    fn test_getpid() with(Process, Alloc) -> i32 {
        let pid: i32 = process_getpid();
        // PID must be positive
        if pid <= 0 { return 1; }
        // Calling again should return the same value
        let pid2: i32 = process_getpid();
        if pid != pid2 { return 1; }
        return 0;
    }

    #[test]
    fn test_kill_signal_zero() with(Process, Alloc) -> i32 {
        // signal 0 to own PID should succeed (existence check)
        let pid: i32 = process_getpid();
        let result: Result<bool, ProcessError> = process_kill(pid, 0);
        match result {
            Result::Ok { value } => { return 0; },
            Result::Err { error } => { return 1; }
        }
    }

    #[test]
    fn test_kill_invalid_signal() with(Process, Alloc) -> i32 {
        // Sending an invalid signal number (e.g. 99999) to own PID should fail
        let pid: i32 = process_getpid();
        let result: Result<bool, ProcessError> = process_kill(pid, 99999);
        match result {
            Result::Ok { value } => { return 1; },
            Result::Err { error } => { return 0; }
        }
    }

    #[test]
    fn test_kill_pid_zero_exists() with(Process, Alloc) -> i32 {
        // kill(0, 0) sends signal 0 to the entire process group — should succeed
        let result: Result<bool, ProcessError> = process_kill(0, 0);
        match result {
            Result::Ok { value } => { return 0; },
            Result::Err { error } => { return 1; }
        }
    }
}
