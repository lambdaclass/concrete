    // ---- ByteView tests ----

    #[test]
    fn test_byteview_new_and_access() with(Alloc, Console) -> i32 {
        let mut b: Bytes = Bytes::new();
        b.push(10); b.push(20); b.push(30); b.push(40); b.push(50);
        let mut rc: i32 = 0;
        match ByteView::new(1, 3, &b) {
            Option::Some { value } => {
                let v: ByteView = value;
                if !assert_eq::<u64>(v.off(), 1, "off should be 1") { rc = 1; }
                if !assert_eq::<u64>(v.len(), 3, "len should be 3") { rc = 1; }
                match v.byte(&b, 0) {
                    Option::Some { value } => { if !assert_eq::<u8>(value, 20, "byte 0 should be 20") { rc = 1; } },
                    Option::None => { rc = 1; }
                }
                // index 3 is out of the 3-byte view
                match v.byte(&b, 3) {
                    Option::Some { value } => { rc = 1; },
                    Option::None => {}
                }
            },
            Option::None => { rc = 1; }
        }
        b.drop();
        return rc;
    }

    #[test]
    fn test_byteview_out_of_bounds_rejected() with(Alloc) -> i32 {
        let mut b: Bytes = Bytes::new();
        b.push(1); b.push(2);
        let mut rc: i32 = 0;
        // off+len = 5 > len 2
        match ByteView::new(0, 5, &b) {
            Option::Some { value } => { rc = 1; },
            Option::None => {}
        }
        b.drop();
        return rc;
    }

    #[test]
    fn test_byteview_overflow_rejected() with(Alloc) -> i32 {
        let mut b: Bytes = Bytes::new();
        b.push(1);
        let mut rc: i32 = 0;
        let big: u64 = 18446744073709551610;
        match ByteView::new(big, 100, &b) {
            Option::Some { value } => { rc = 1; },
            Option::None => {}
        }
        b.drop();
        return rc;
    }

    #[test]
    fn test_byteview_out_of_bounds_buffer_rejected() with(Alloc) -> i32 {
        // R-0483. This test used to be `test_byteview_wrong_buffer_rejected` and asserted
        // that a view refuses a "wrong" buffer. It never established that. The old check
        // compared `buf.len()` against a recorded length, so it rejected this case only
        // because the two buffers happened to DIFFER IN LENGTH, and accepted a different
        // buffer of the SAME length silently — which is the substitution that mattered.
        //
        // A view is coordinates. What it can honestly promise is bounds, and that is what
        // is asserted here: a buffer too short is refused, a buffer long enough is
        // accepted, and accepting it is the documented contract rather than a gap. Where
        // the identity of the owner matters, own the buffer and hand out access through
        // the owner; a length is not an identity and should not be spelled like one.
        let mut a: Bytes = Bytes::new();
        a.push(1); a.push(2); a.push(3); a.push(4);
        let mut short_buf: Bytes = Bytes::new();
        short_buf.push(9);                       // len 1: too short for [0,2)
        let mut other: Bytes = Bytes::new();
        other.push(7); other.push(7); other.push(7); other.push(7);   // len 4, different bytes
        let mut rc: i32 = 0;
        match ByteView::new(0, 2, &a) {
            Option::Some { value } => {
                let v: ByteView = value;
                match v.cursor(&a) {
                    Option::Some { value } => {},
                    Option::None => { rc = 1; }
                }
                // Too short: refused on bounds.
                match v.cursor(&short_buf) {
                    Option::Some { value } => { rc = 1; },
                    Option::None => {}
                }
                // Long enough: accepted, by design. The range is valid for it.
                match v.cursor(&other) {
                    Option::Some { value } => {},
                    Option::None => { rc = 1; }
                }
            },
            Option::None => { rc = 1; }
        }
        a.drop();
        short_buf.drop();
        other.drop();
        return rc;
    }

    // ---- R-0483: the replacement API, exercised positively ----
    //
    // A repair that only DELETES an unsafe constructor is not covered by the resulting
    // compile errors: those prove the old spelling is gone, not that the new one works.
    // These exercise the safe path end to end, including the cases the old cursor got
    // wrong.

    #[test]
    fn test_cursor_over_bytes_reads() with(Alloc, Console) -> i32 {
        let mut b: Bytes = Bytes::new();
        b.push(0xDE); b.push(0xAD); b.push(0xBE); b.push(0xEF);
        let mut cur: ByteCursor = ByteCursor::over(&b);
        let mut rc: i32 = 0;
        if !assert_eq::<u64>(cur.remaining(), 4, "remaining should be 4") { rc = 1; }
        match cur.read_u8(&b) {
            Result::Ok { value } => { if !assert_eq::<u8>(value, 0xDE, "first byte") { rc = 1; } },
            Result::Err { error } => { rc = 1; },
        }
        match cur.read_u16_be(&b) {
            Result::Ok { value } => { if !assert_eq::<u16>(value, 0xADBE, "be16 after 1 byte") { rc = 1; } },
            Result::Err { error } => { rc = 1; },
        }
        match cur.read_u8(&b) {
            Result::Ok { value } => { if !assert_eq::<u8>(value, 0xEF, "last byte") { rc = 1; } },
            Result::Err { error } => { rc = 1; },
        }
        // Exhausted: the next read refuses rather than running off the end.
        match cur.read_u8(&b) {
            Result::Ok { value } => { rc = 1; },
            Result::Err { error } => {},
        }
        b.drop();
        return rc;
    }

    #[test]
    fn test_cursor_refuses_after_buffer_shrinks() with(Alloc, Console) -> i32 {
        // THE REGRESSION THIS REPAIR EXISTS FOR. The old cursor stored a pointer and a
        // length captured at construction, so it kept reading a buffer that had since
        // been cleared. The new one re-derives its bounds from the buffer it is GIVEN.
        let mut b: Bytes = Bytes::new();
        b.push(1); b.push(2); b.push(3); b.push(4);
        let mut cur: ByteCursor = ByteCursor::over(&b);
        let mut rc: i32 = 0;
        match cur.read_u8(&b) {
            Result::Ok { value } => { if !assert_eq::<u8>(value, 1, "reads before clear") { rc = 1; } },
            Result::Err { error } => { rc = 1; },
        }
        b.clear();
        match cur.read_u8(&b) {
            Result::Ok { value } => { rc = 1; },   // must not read a cleared buffer
            Result::Err { error } => {},
        }
        if !assert_true(!cur.has(&b, 1), "has() must refuse against the shrunk buffer") { rc = 1; }
        b.drop();
        return rc;
    }

    #[test]
    fn test_cursor_survives_reallocating_push() with(Alloc, Console) -> i32 {
        // Growing past capacity reallocates. A pointer-bearing cursor went stale here
        // with the owner still alive and nothing consumed; a coordinate cursor does not.
        let mut b: Bytes = Bytes::with_capacity(2);
        b.push(65); b.push(66);
        let cur_start: ByteCursor = ByteCursor::over(&b);
        let mut i: u64 = 0;
        while i < 64 {
            b.push(67);
            i = i + 1;
        }
        let mut cur: ByteCursor = cur_start;
        let mut rc: i32 = 0;
        match cur.read_u8(&b) {
            Result::Ok { value } => { if !assert_eq::<u8>(value, 65, "still reads the live buffer") { rc = 1; } },
            Result::Err { error } => { rc = 1; },
        }
        b.drop();
        return rc;
    }

    #[test]
    fn test_view_is_coordinates_not_identity() with(Alloc, Console) -> i32 {
        // A view is a RANGE and applies to any buffer satisfying its bounds. That is now
        // the stated contract rather than a length brand pretending to check identity.
        let mut a: Bytes = Bytes::new();
        a.push(10); a.push(11); a.push(12);
        let mut c: Bytes = Bytes::new();
        c.push(90);
        let mut rc: i32 = 0;
        match ByteView::new(1, 2, &a) {
            Option::Some { value } => {
                let v: ByteView = value;
                if !assert_true(v.fits(&a), "fits its own buffer") { rc = 1; }
                if !assert_true(!v.fits(&c), "does not fit a shorter buffer") { rc = 1; }
                match v.byte(&c, 0) {
                    Option::Some { value } => { rc = 1; },   // out of bounds for c
                    Option::None => {},
                }
            },
            Option::None => { rc = 1; },
        }
        a.drop();
        c.drop();
        return rc;
    }

    #[test]
    fn test_text_validation_survives_source_mutation() with(Alloc, Console) -> i32 {
        // The old `try_text` returned a view into `buf`; mutating the source left a
        // "validated" Text yielding unvalidated bytes. `to_text` copies, so the
        // validation holds for the value's whole life.
        let mut b: Bytes = Bytes::new();
        b.push(65); b.push(66); b.push(67);
        let mut rc: i32 = 0;
        match ByteView::new(0, 3, &b) {
            Option::Some { value } => {
                let v: ByteView = value;
                match v.to_text(&b) {
                    Option::Some { value } => {
                        let t: Text = value;
                        b.set(1, 0xFF);           // would have poisoned a borrowed Text
                        match t.byte(1) {
                            Option::Some { value } => {
                                if !assert_eq::<u8>(value, 66, "Text keeps its validated bytes") { rc = 1; }
                            },
                            Option::None => { rc = 1; },
                        }
                        t.drop();
                    },
                    Option::None => { rc = 1; },
                }
            },
            Option::None => { rc = 1; },
        }
        b.drop();
        return rc;
    }

    #[test]
    fn test_byteview_to_text() with(Alloc, Console) -> i32 {
        // "caf" + é(0xC3 0xA9) + '!'  -> valid view [0,5), split view [0,4) invalid
        let mut b: Bytes = Bytes::new();
        b.push(99); b.push(97); b.push(102); b.push(195); b.push(169); b.push(33);
        let mut rc: i32 = 0;
        match ByteView::new(0, 5, &b) {
            Option::Some { value } => {
                let v: ByteView = value;
                match v.to_text(&b) {
                    Option::Some { value } => {
                        if !assert_eq::<u64>(value.len(), 5, "text is 5 bytes") { rc = 1; }
                        value.drop();
                    },
                    Option::None => { rc = 1; }
                }
            },
            Option::None => { rc = 1; }
        }
        match ByteView::new(0, 4, &b) {
            Option::Some { value } => {
                let v: ByteView = value;
                match v.to_text(&b) {
                    Option::Some { value } => { value.drop(); rc = 1; }, // split codepoint must reject
                    Option::None => {}
                }
            },
            Option::None => { rc = 1; }
        }
        b.drop();
        return rc;
    }

    #[test]
    fn test_byteview_of_cursor() with(Alloc, Console) -> i32 {
        let mut b: Bytes = Bytes::new();
        b.push(7); b.push(3); b.push(10); b.push(20); b.push(30);
        let mut cur: ByteCursor = ByteCursor::over(&b);
        match cur.read_u8(&b) { Result::Ok { value } => {}, Result::Err { error } => {} }
        match cur.read_u8(&b) { Result::Ok { value } => {}, Result::Err { error } => {} }
        let start: u64 = cur.pos();
        match cur.skip(&b, 3) { Result::Ok { value } => {}, Result::Err { error } => {} }
        let v: ByteView = ByteView::of_cursor(start, &cur);
        let mut rc: i32 = 0;
        if !assert_eq::<u64>(v.off(), 2, "of_cursor off should be 2") { rc = 1; }
        if !assert_eq::<u64>(v.len(), 3, "of_cursor len should be 3") { rc = 1; }
        b.drop();
        return rc;
    }
}
