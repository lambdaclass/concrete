mod numeric {

    // ============================================================
    // Canonical validated wrappers — see docs/language/VALIDATED_WRAPPERS.md §4.
    //
    // Canonical construction is try_new / try_from_*; .0 remains the
    // representation-level extraction path. Instance methods on newtypes
    // are now supported, but these wrappers intentionally keep a small,
    // explicit surface.
    // ============================================================

    pub newtype NonZeroU32 = u32;
    pub newtype NonZeroU64 = u64;
    pub newtype Port = u16;

    impl NonZeroU32 {
        #[spec(Concrete.Proof.numericTryNewExpr)]
        #[proof_by(Examples.PureCore.Proofs.numeric_try_new_correct)]
        #[proof_coverage(iff)]
        #[proof_fingerprint("9ec8f1fd516e3daf1f0cd7dfa9a46ad7")]
        pub fn try_new(value: u32) -> Option<NonZeroU32> {
            if value == 0 { return Option::<NonZeroU32>::None; }
            return Option::<NonZeroU32>::Some { value: NonZeroU32(value) };
        }

        #[spec(Concrete.Proof.numericTryFromExpr)]
        #[proof_by(Examples.PureCore.Proofs.nonzero_u32_try_from_u64_correct)]
        #[proof_coverage(iff)]
        #[proof_fingerprint("e2fd55dd4caba0bf84444277651389c8")]
        pub fn try_from_u64(value: u64) -> Option<NonZeroU32> {
            if value == 0 { return Option::<NonZeroU32>::None; }
            if value > 4294967295 { return Option::<NonZeroU32>::None; }
            return Option::<NonZeroU32>::Some { value: NonZeroU32(value as u32) };
        }
    }

    impl NonZeroU64 {
        #[spec(Concrete.Proof.numericTryNewExpr)]
        #[proof_by(Examples.PureCore.Proofs.numeric_try_new_correct)]
        #[proof_coverage(iff)]
        #[proof_fingerprint("95f3bd3a52aa175412da63b513b560e1")]
        pub fn try_new(value: u64) -> Option<NonZeroU64> {
            if value == 0 { return Option::<NonZeroU64>::None; }
            return Option::<NonZeroU64>::Some { value: NonZeroU64(value) };
        }
    }

    impl Port {
        #[spec(Concrete.Proof.numericTryNewExpr)]
        #[proof_by(Examples.PureCore.Proofs.numeric_try_new_correct)]
        #[proof_coverage(iff)]
        #[proof_fingerprint("add908e23c2aa3730f721c9de6ded66b")]
        pub fn try_new(value: u16) -> Option<Port> {
            if value == 0 { return Option::<Port>::None; }
            return Option::<Port>::Some { value: Port(value) };
        }

        #[spec(Concrete.Proof.numericTryFromExpr)]
        #[proof_by(Examples.PureCore.Proofs.port_try_from_u32_correct)]
        #[proof_coverage(iff)]
        #[proof_fingerprint("f87fb5c677827de64b3ead111edf1faf")]
        pub fn try_from_u32(value: u32) -> Option<Port> {
            if value == 0 { return Option::<Port>::None; }
            if value > 65535 { return Option::<Port>::None; }
            return Option::<Port>::Some { value: Port(value as u16) };
        }
    }

    // ---- CursorError ----

    pub enum Copy CursorError {
        UnexpectedEnd,
        InvalidData,
    }

    // ---- ByteCursor: pointer-free, positioned, bounds-checked reader ----
    //
    // R-0483. A cursor stores COORDINATES ONLY — a window `[off, off+len)` and a read
    // position inside it — and never a pointer. The buffer is supplied on every access,
    // so the cursor cannot outlive it, cannot survive its destruction, and cannot be
    // left pointing at a reallocated allocation: there is nothing retained to dangle.
    //
    // Every access re-derives its bounds from the buffer it is GIVEN, not from what the
    // buffer was at construction. A buffer that shrank, was cleared, or was replaced by
    // a shorter one refuses the read rather than reading whatever now occupies the
    // address. This is the property the previous pointer-bearing cursor could not have.
    //
    // A cursor is deliberately COORDINATE-style: it accepts any buffer that satisfies
    // its bounds, and it does not claim to identify the buffer it was built from. Where
    // a specific owner matters, own the buffer and expose access through the owner.

    pub struct Copy ByteCursor {
        off: u64,
        len: u64,
        pos: u64,
    }

    impl ByteCursor {
        /// A cursor over the whole of `buf`.
        pub fn over(buf: &Bytes) -> ByteCursor {
            return ByteCursor { off: 0, len: buf.len(), pos: 0 };
        }

        /// A cursor over `[off, off+len)` of `buf`, or None if that is not in bounds.
        pub fn window(off: u64, len: u64, buf: &Bytes) -> Option<ByteCursor> {
            let blen: u64 = buf.len();
            if off > blen {
                return Option::<ByteCursor>::None;
            }
            if len > blen - off {
                return Option::<ByteCursor>::None;
            }
            return Option::<ByteCursor>::Some { value: ByteCursor { off: off, len: len, pos: 0 } };
        }

        // ---- Position queries (coordinates only; no buffer needed) ----

        pub fn pos(&self) -> u64 {
            return self.pos;
        }

        pub fn off(&self) -> u64 {
            return self.off;
        }

        pub fn len(&self) -> u64 {
            return self.len;
        }

        pub fn remaining(&self) -> u64 {
            if self.pos > self.len {
                return 0;
            }
            return self.len - self.pos;
        }

        pub fn is_empty(&self) -> bool {
            return self.pos >= self.len;
        }

        /// True iff `n` more bytes are readable from `buf` at the current position.
        /// Checked against the LIVE buffer length, overflow-safe throughout.
        pub fn has(&self, buf: &Bytes, n: u64) -> bool {
            if self.pos > self.len {
                return false;
            }
            if n > self.len - self.pos {
                return false;
            }
            let blen: u64 = buf.len();
            if self.off > blen {
                return false;
            }
            let avail: u64 = blen - self.off;
            if self.pos > avail {
                return false;
            }
            if n > avail - self.pos {
                return false;
            }
            return true;
        }

        // ---- Single byte ----

        pub fn read_u8(&mut self, buf: &Bytes) -> Result<u8, CursorError> {
            if !self.has(buf, 1) {
                return Result::<u8, CursorError>::Err { error: CursorError::UnexpectedEnd };
            }
            let val: u8 = buf.get_unchecked(self.off + self.pos);
            self.pos = self.pos + 1;
            return Result::<u8, CursorError>::Ok { value: val };
        }

        pub fn peek_u8(&self, buf: &Bytes) -> Result<u8, CursorError> {
            if !self.has(buf, 1) {
                return Result::<u8, CursorError>::Err { error: CursorError::UnexpectedEnd };
            }
            return Result::<u8, CursorError>::Ok { value: buf.get_unchecked(self.off + self.pos) };
        }

        // ---- Skip ----

        pub fn skip(&mut self, buf: &Bytes, n: u64) -> Result<u64, CursorError> {
            if !self.has(buf, n) {
                return Result::<u64, CursorError>::Err { error: CursorError::UnexpectedEnd };
            }
            self.pos = self.pos + n;
            return Result::<u64, CursorError>::Ok { value: self.pos };
        }

        // ---- Multi-byte reads ----
        //
        // One accumulator per endianness rather than six unrolled bodies. `has` has
        // already established that every index below is in the live buffer, which is
        // why `get_unchecked` is the right call here and not a second bounds check.

        fn read_be_n(&mut self, buf: &Bytes, n: u64) -> Result<u64, CursorError> {
            if !self.has(buf, n) {
                return Result::<u64, CursorError>::Err { error: CursorError::UnexpectedEnd };
            }
            let base: u64 = self.off + self.pos;
            let mut acc: u64 = 0;
            let mut i: u64 = 0;
            while i < n {
                acc = (acc << 8) | (buf.get_unchecked(base + i) as u64);
                i = i + 1;
            }
            self.pos = self.pos + n;
            return Result::<u64, CursorError>::Ok { value: acc };
        }

        fn read_le_n(&mut self, buf: &Bytes, n: u64) -> Result<u64, CursorError> {
            if !self.has(buf, n) {
                return Result::<u64, CursorError>::Err { error: CursorError::UnexpectedEnd };
            }
            let base: u64 = self.off + self.pos;
            let mut acc: u64 = 0;
            let mut i: u64 = 0;
            while i < n {
                acc = acc | ((buf.get_unchecked(base + i) as u64) << (i * 8));
                i = i + 1;
            }
            self.pos = self.pos + n;
            return Result::<u64, CursorError>::Ok { value: acc };
        }

        pub fn read_u16_be(&mut self, buf: &Bytes) -> Result<u16, CursorError> {
            match self.read_be_n(buf, 2) {
                Result::Ok { value } => { return Result::<u16, CursorError>::Ok { value: value as u16 }; },
                Result::Err { error } => { return Result::<u16, CursorError>::Err { error: error }; },
            }
        }

        pub fn read_u32_be(&mut self, buf: &Bytes) -> Result<u32, CursorError> {
            match self.read_be_n(buf, 4) {
                Result::Ok { value } => { return Result::<u32, CursorError>::Ok { value: value as u32 }; },
                Result::Err { error } => { return Result::<u32, CursorError>::Err { error: error }; },
            }
        }

        pub fn read_u64_be(&mut self, buf: &Bytes) -> Result<u64, CursorError> {
            return self.read_be_n(buf, 8);
        }

        pub fn read_u16_le(&mut self, buf: &Bytes) -> Result<u16, CursorError> {
            match self.read_le_n(buf, 2) {
                Result::Ok { value } => { return Result::<u16, CursorError>::Ok { value: value as u16 }; },
                Result::Err { error } => { return Result::<u16, CursorError>::Err { error: error }; },
            }
        }

        pub fn read_u32_le(&mut self, buf: &Bytes) -> Result<u32, CursorError> {
            match self.read_le_n(buf, 4) {
                Result::Ok { value } => { return Result::<u32, CursorError>::Ok { value: value as u32 }; },
                Result::Err { error } => { return Result::<u32, CursorError>::Err { error: error }; },
            }
        }

        pub fn read_u64_le(&mut self, buf: &Bytes) -> Result<u64, CursorError> {
            return self.read_le_n(buf, 8);
        }
    }

    /// Read byte `i` of a caller-owned region. Declares `Unsafe` rather than hiding
    /// behind `trusted`: the liveness obligation is the caller's and stays visible in
    /// every signature above it.
    fn read_byte_at(ptr: *const u8, i: u64) with(Unsafe) -> u8 {
        let p: *const u8 = (ptr as u64 + i) as *const u8;
        return *(p as *mut u8);
    }

    // ---- RawCursor: the same reader over a caller-owned region, behind `Unsafe` ----
    //
    // R-0483. Some readers genuinely have only a pointer: a stack array, or a region
    // handed over by FFI. That case does not disappear, but it must stop being
    // invisible. Holding a pointer is not permission to dereference it later, and the
    // previous `ByteCursor::from_raw` plus its capability-free reads let an ordinary
    // `fn` take a `*const u8` and read through it with nothing in its signature saying
    // so — while the same code written by hand was refused with E0521.
    //
    // So construction AND every read carry `with(Unsafe)`. The obligation is the
    // caller's and now appears in the caller's type: the region must be live and at
    // least `len` bytes for as long as the cursor is used. Nothing here can check that,
    // which is precisely why it is declared rather than assumed.
    //
    // Prefer `ByteCursor` whenever the bytes live in a `Bytes`. This type exists for
    // the cases where they do not.

    pub struct Copy RawCursor {
        ptr: *const u8,
        len: u64,
        pos: u64,
    }

    trusted impl RawCursor {
        pub fn from_raw(data: *const u8, len: u64) with(Unsafe) -> RawCursor {
            return RawCursor { ptr: data, len: len, pos: 0 };
        }

        pub fn pos(&self) -> u64 {
            return self.pos;
        }

        pub fn remaining(&self) -> u64 {
            if self.pos > self.len {
                return 0;
            }
            return self.len - self.pos;
        }

        pub fn is_empty(&self) -> bool {
            return self.pos >= self.len;
        }

        fn has(&self, n: u64) -> bool {
            if self.pos > self.len {
                return false;
            }
            return n <= self.len - self.pos;
        }

        pub fn read_u8(&mut self) with(Unsafe) -> Result<u8, CursorError> {
            if !self.has(1) {
                return Result::<u8, CursorError>::Err { error: CursorError::UnexpectedEnd };
            }
            let val: u8 = read_byte_at(self.ptr, self.pos);
            self.pos = self.pos + 1;
            return Result::<u8, CursorError>::Ok { value: val };
        }

        pub fn peek_u8(&self) with(Unsafe) -> Result<u8, CursorError> {
            if !self.has(1) {
                return Result::<u8, CursorError>::Err { error: CursorError::UnexpectedEnd };
            }
            return Result::<u8, CursorError>::Ok { value: read_byte_at(self.ptr, self.pos) };
        }

        pub fn skip(&mut self, n: u64) -> Result<u64, CursorError> {
            if !self.has(n) {
                return Result::<u64, CursorError>::Err { error: CursorError::UnexpectedEnd };
            }
            self.pos = self.pos + n;
            return Result::<u64, CursorError>::Ok { value: self.pos };
        }

        fn read_be_n(&mut self, n: u64) -> Result<u64, CursorError> {
            if !self.has(n) {
                return Result::<u64, CursorError>::Err { error: CursorError::UnexpectedEnd };
            }
            let mut acc: u64 = 0;
            let mut i: u64 = 0;
            while i < n {
                acc = (acc << 8) | (read_byte_at(self.ptr, self.pos + i) as u64);
                i = i + 1;
            }
            self.pos = self.pos + n;
            return Result::<u64, CursorError>::Ok { value: acc };
        }

        fn read_le_n(&mut self, n: u64) -> Result<u64, CursorError> {
            if !self.has(n) {
                return Result::<u64, CursorError>::Err { error: CursorError::UnexpectedEnd };
            }
            let mut acc: u64 = 0;
            let mut i: u64 = 0;
            while i < n {
                acc = acc | ((read_byte_at(self.ptr, self.pos + i) as u64) << (i * 8));
                i = i + 1;
            }
            self.pos = self.pos + n;
            return Result::<u64, CursorError>::Ok { value: acc };
        }

        pub fn read_u16_be(&mut self) with(Unsafe) -> Result<u16, CursorError> {
            match self.read_be_n(2) {
                Result::Ok { value } => { return Result::<u16, CursorError>::Ok { value: value as u16 }; },
                Result::Err { error } => { return Result::<u16, CursorError>::Err { error: error }; },
            }
        }

        pub fn read_u32_be(&mut self) with(Unsafe) -> Result<u32, CursorError> {
            match self.read_be_n(4) {
                Result::Ok { value } => { return Result::<u32, CursorError>::Ok { value: value as u32 }; },
                Result::Err { error } => { return Result::<u32, CursorError>::Err { error: error }; },
            }
        }

        pub fn read_u64_be(&mut self) with(Unsafe) -> Result<u64, CursorError> {
            return self.read_be_n(8);
        }

        pub fn read_u16_le(&mut self) with(Unsafe) -> Result<u16, CursorError> {
            match self.read_le_n(2) {
                Result::Ok { value } => { return Result::<u16, CursorError>::Ok { value: value as u16 }; },
                Result::Err { error } => { return Result::<u16, CursorError>::Err { error: error }; },
            }
        }

        pub fn read_u32_le(&mut self) with(Unsafe) -> Result<u32, CursorError> {
            match self.read_le_n(4) {
                Result::Ok { value } => { return Result::<u32, CursorError>::Ok { value: value as u32 }; },
                Result::Err { error } => { return Result::<u32, CursorError>::Err { error: error }; },
            }
        }

        pub fn read_u64_le(&mut self) with(Unsafe) -> Result<u64, CursorError> {
            return self.read_le_n(8);
        }
    }

    // ---- ByteView: owned, Copy, reference-free [off, len) handle ----
    //
    // See docs/language/BYTE_VIEW.md. A ByteView stores no pointer and borrows nothing, so
    // it is freely storable in struct fields, returnable, and Copy.
    //
    // R-0483: THIS IS A COORDINATE API AND SAYS SO. A view is a RANGE, not a handle on a
    // particular buffer, and it applies to ANY buffer that satisfies its bounds. The
    // previous `buf_len` field was described as "a cheap wrong-buffer brand"; it compared
    // a length, and length equality is not buffer identity, so a different buffer of the
    // same length passed it and was read silently. A brand that catches only some
    // substitutions is worse than none, because `describes(buf)` reads like a validation
    // that happened. The field is removed and the contract is stated instead.
    //
    // Where the identity of the owner matters, do not reach for a brand: own the buffer
    // and expose access through the owner, so substitution is unrepresentable rather
    // than rejected.

    pub struct Copy ByteView {
        off: u64,
        len: u64,
    }

    impl ByteView {
        /// A view of `[off, off+len)`, valid against any buffer at least that long.
        /// Returns None if `off+len` overflows or exceeds `buf.len()`.
        pub fn new(off: u64, len: u64, buf: &Bytes) -> Option<ByteView> {
            let blen: u64 = buf.len();
            if off > blen {
                return Option::<ByteView>::None;
            }
            if len > blen - off {
                return Option::<ByteView>::None;
            }
            return Option::<ByteView>::Some { value: ByteView { off: off, len: len } };
        }

        /// Parser idiom: capture `[start, cur.pos())` over the cursor's window.
        /// If `start` exceeds the cursor position, the view is empty.
        pub fn of_cursor(start: u64, cur: &ByteCursor) -> ByteView {
            let p: u64 = cur.off() + cur.pos();
            let s: u64 = cur.off() + start;
            let vlen: u64 = if s <= p { p - s } else { 0 };
            return ByteView { off: s, len: vlen };
        }

        pub fn off(&self) -> u64 {
            return self.off;
        }

        pub fn len(&self) -> u64 {
            return self.len;
        }

        pub fn is_empty(&self) -> bool {
            return self.len == 0;
        }

        /// True iff `buf` is long enough for this range. This is a BOUNDS test and
        /// nothing more: it does not and cannot establish that `buf` is the buffer the
        /// view was taken from. Named `fits` rather than `describes` so the call site
        /// cannot be misread as an identity check.
        pub fn fits(&self, buf: &Bytes) -> bool {
            let blen: u64 = buf.len();
            if self.off > blen {
                return false;
            }
            return self.len <= blen - self.off;
        }

        /// A cursor over this range of `buf`, or None if `buf` is too short. The cursor
        /// is pointer-free and re-checks `buf` on every read, so this conversion no
        /// longer hands out a value that can outlive the buffer.
        pub fn cursor(&self, buf: &Bytes) -> Option<ByteCursor> {
            return ByteCursor::window(self.off, self.len, buf);
        }

        /// The i-th byte of the view, or None if out of range for the view or `buf`.
        pub fn byte(&self, buf: &Bytes, i: u64) -> Option<u8> {
            if i >= self.len {
                return Option::<u8>::None;
            }
            if !self.fits(buf) {
                return Option::<u8>::None;
            }
            return buf.get(self.off + i);
        }

        /// Copy this range out of `buf` as an OWNED, validated `Text`, or None if the
        /// range does not fit or the bytes are not well-formed UTF-8.
        ///
        /// R-0483: this copies, and the copy is the point. The previous version returned
        /// a `Text` pointing into `buf`, so a later mutation left a "validated" value
        /// yielding bytes that were never validated. A `Text` now owns immutable
        /// storage, so the validation it performed stays true for as long as it exists.
        pub fn to_text(&self, buf: &Bytes) with(Alloc) -> Option<Text> {
            if !self.fits(buf) {
                return Option::<Text>::None;
            }
            return buf.range_to_text(self.off, self.len);
        }
    }

    // ---- BoundView: an owner-bound view (R-0483) ----
    //
    // A `ByteView` is reusable COORDINATES: it describes a range, and applies to any buffer
    // that is long enough, by contract. A `BoundView` is the other thing: a view that OWNS the
    // buffer it describes. Reads take no buffer argument, so reading a range against a different
    // buffer cannot be written — that is enforced statically, by ownership, not detected at
    // runtime. While bound, the owner cannot be mutated, reallocated or destroyed, because no
    // `&mut` or consuming access to it is exposed; `release` hands it back whole. Moving a
    // `BoundView` moves the owner with it, so the relationship survives transfer, including
    // across a package boundary. It is linear, like the `Bytes` inside it.
    //
    // What it does NOT establish: that the coordinates were derived from this owner's CONTENT.
    // `of_view` re-validates bounds against the owner and binds them; coordinates computed from a
    // different buffer of sufficient length bind successfully. The guarantee is "every read goes
    // to the owner it holds", which is the one substitution breaks.
    pub struct BoundView {
        owner: Bytes,
        off: u64,
        len: u64,
    }

    impl BoundView {
        /// Bind `[off, off+len)` of `owner`. On a range that does not fit, the owner is returned.
        pub fn bind(owner: Bytes, off: u64, len: u64) -> Result<BoundView, Bytes> {
            let blen: u64 = owner.len();
            if off > blen {
                return Result::<BoundView, Bytes>::Err { error: owner };
            }
            if len > blen - off {
                return Result::<BoundView, Bytes>::Err { error: owner };
            }
            return Result::<BoundView, Bytes>::Ok { value: BoundView { owner: owner, off: off, len: len } };
        }

        /// Bind existing coordinates to `owner`, re-validated against it.
        pub fn of_view(owner: Bytes, view: &ByteView) -> Result<BoundView, Bytes> {
            return BoundView::bind(owner, view.off(), view.len());
        }

        pub fn len(&self) -> u64 {
            return self.len;
        }

        /// The i-th byte of the bound range, or None past its end. No buffer argument: the read
        /// goes to the owner this view holds.
        pub fn byte(&self, i: u64) -> Option<u8> {
            if i >= self.len {
                return Option::<u8>::None;
            }
            return self.owner.get(self.off + i);
        }

        /// The range as reusable coordinates. Explicitly NOT owner-bound: a `ByteView` applies to
        /// any buffer that is long enough.
        pub fn coords(&self) -> ByteView {
            return ByteView { off: self.off, len: self.len };
        }

        /// End the binding and hand the owner back, unchanged.
        pub fn release(self) -> Bytes {
            let BoundView { owner, off, len } = self;
            return owner;
        }
    }

    // ---- Standalone endian functions (no cursor needed) ----

    trusted fn read_be16_at(data: *const u8, offset: u64) -> u64 {
        let p: *const u8 = data + offset;
        let b0: u64 = (*(p as *mut u8)) as u64;
        let p1: *const u8 = p + 1;
        let b1: u64 = (*(p1 as *mut u8)) as u64;
        return (b0 << 8) | b1;
    }

    trusted fn read_be32_at(data: *const u8, offset: u64) -> u64 {
        let p: *const u8 = data + offset;
        let b0: u64 = (*(p as *mut u8)) as u64;
        let p1: *const u8 = p + 1;
        let b1: u64 = (*(p1 as *mut u8)) as u64;
        let p2: *const u8 = p + 2;
        let b2: u64 = (*(p2 as *mut u8)) as u64;
        let p3: *const u8 = p + 3;
        let b3: u64 = (*(p3 as *mut u8)) as u64;
        return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
    }

    trusted fn read_le32_at(data: *const u8, offset: u64) -> u64 {
        let p: *const u8 = data + offset;
        let b0: u64 = (*(p as *mut u8)) as u64;
        let p1: *const u8 = p + 1;
        let b1: u64 = (*(p1 as *mut u8)) as u64;
        let p2: *const u8 = p + 2;
        let b2: u64 = (*(p2 as *mut u8)) as u64;
        let p3: *const u8 = p + 3;
        let b3: u64 = (*(p3 as *mut u8)) as u64;
        return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
    }

    // ---- ByteWriter: positioned writer into a mutable byte buffer ----

    pub struct Copy ByteWriter {
        ptr: *mut u8,
        len: u64,
        pos: u64,
    }

    trusted impl ByteWriter {
        /// Create a writer over a raw mutable pointer and length.
        /// Caller must ensure the pointer is valid for `len` bytes.
        pub fn from_raw(data: *mut u8, len: u64) with(Unsafe) -> ByteWriter {
            return ByteWriter { ptr: data, len: len, pos: 0 };
        }

        pub fn pos(&self) -> u64 {
            return self.pos;
        }

        pub fn remaining(&self) -> u64 {
            return self.len - self.pos;
        }

        // ---- Single byte write ----

        pub fn write_u8(&mut self, val: u8) -> Result<u64, CursorError> {
            if self.pos >= self.len {
                return Result::<u64, CursorError>::Err { error: CursorError::UnexpectedEnd };
            }
            let p: *mut u8 = self.ptr + self.pos;
            *p = val;
            self.pos = self.pos + 1;
            return Result::<u64, CursorError>::Ok { value: self.pos };
        }

        // ---- Big-endian writes ----

        pub fn write_u16_be(&mut self, val: u16) -> Result<u64, CursorError> {
            if 2 > self.len - self.pos {
                return Result::<u64, CursorError>::Err { error: CursorError::UnexpectedEnd };
            }
            let v: u64 = val as u64;
            let p: *mut u8 = self.ptr + self.pos;
            *p = ((v >> 8) & 0xFF) as u8;
            let p1: *mut u8 = p + 1;
            *p1 = (v & 0xFF) as u8;
            self.pos = self.pos + 2;
            return Result::<u64, CursorError>::Ok { value: self.pos };
        }

        pub fn write_u32_be(&mut self, val: u32) -> Result<u64, CursorError> {
            if 4 > self.len - self.pos {
                return Result::<u64, CursorError>::Err { error: CursorError::UnexpectedEnd };
            }
            let v: u64 = val as u64;
            let p: *mut u8 = self.ptr + self.pos;
            *p = ((v >> 24) & 0xFF) as u8;
            let p1: *mut u8 = p + 1;
            *p1 = ((v >> 16) & 0xFF) as u8;
            let p2: *mut u8 = p + 2;
            *p2 = ((v >> 8) & 0xFF) as u8;
            let p3: *mut u8 = p + 3;
            *p3 = (v & 0xFF) as u8;
            self.pos = self.pos + 4;
            return Result::<u64, CursorError>::Ok { value: self.pos };
        }

        pub fn write_u64_be(&mut self, val: u64) -> Result<u64, CursorError> {
            if 8 > self.len - self.pos {
                return Result::<u64, CursorError>::Err { error: CursorError::UnexpectedEnd };
            }
            let p: *mut u8 = self.ptr + self.pos;
            *p = ((val >> 56) & 0xFF) as u8;
            let p1: *mut u8 = p + 1;
            *p1 = ((val >> 48) & 0xFF) as u8;
            let p2: *mut u8 = p + 2;
            *p2 = ((val >> 40) & 0xFF) as u8;
            let p3: *mut u8 = p + 3;
            *p3 = ((val >> 32) & 0xFF) as u8;
            let p4: *mut u8 = p + 4;
            *p4 = ((val >> 24) & 0xFF) as u8;
            let p5: *mut u8 = p + 5;
            *p5 = ((val >> 16) & 0xFF) as u8;
            let p6: *mut u8 = p + 6;
            *p6 = ((val >> 8) & 0xFF) as u8;
            let p7: *mut u8 = p + 7;
            *p7 = (val & 0xFF) as u8;
            self.pos = self.pos + 8;
            return Result::<u64, CursorError>::Ok { value: self.pos };
        }

        // ---- Little-endian writes ----

        pub fn write_u16_le(&mut self, val: u16) -> Result<u64, CursorError> {
            if 2 > self.len - self.pos {
                return Result::<u64, CursorError>::Err { error: CursorError::UnexpectedEnd };
            }
            let v: u64 = val as u64;
            let p: *mut u8 = self.ptr + self.pos;
            *p = (v & 0xFF) as u8;
            let p1: *mut u8 = p + 1;
            *p1 = ((v >> 8) & 0xFF) as u8;
            self.pos = self.pos + 2;
            return Result::<u64, CursorError>::Ok { value: self.pos };
        }

        pub fn write_u32_le(&mut self, val: u32) -> Result<u64, CursorError> {
            if 4 > self.len - self.pos {
                return Result::<u64, CursorError>::Err { error: CursorError::UnexpectedEnd };
            }
            let v: u64 = val as u64;
            let p: *mut u8 = self.ptr + self.pos;
            *p = (v & 0xFF) as u8;
            let p1: *mut u8 = p + 1;
            *p1 = ((v >> 8) & 0xFF) as u8;
            let p2: *mut u8 = p + 2;
            *p2 = ((v >> 16) & 0xFF) as u8;
            let p3: *mut u8 = p + 3;
            *p3 = ((v >> 24) & 0xFF) as u8;
            self.pos = self.pos + 4;
            return Result::<u64, CursorError>::Ok { value: self.pos };
        }

        pub fn write_u64_le(&mut self, val: u64) -> Result<u64, CursorError> {
            if 8 > self.len - self.pos {
                return Result::<u64, CursorError>::Err { error: CursorError::UnexpectedEnd };
            }
            let p: *mut u8 = self.ptr + self.pos;
            *p = (val & 0xFF) as u8;
            let p1: *mut u8 = p + 1;
            *p1 = ((val >> 8) & 0xFF) as u8;
            let p2: *mut u8 = p + 2;
            *p2 = ((val >> 16) & 0xFF) as u8;
            let p3: *mut u8 = p + 3;
            *p3 = ((val >> 24) & 0xFF) as u8;
            let p4: *mut u8 = p + 4;
            *p4 = ((val >> 32) & 0xFF) as u8;
            let p5: *mut u8 = p + 5;
            *p5 = ((val >> 40) & 0xFF) as u8;
            let p6: *mut u8 = p + 6;
            *p6 = ((val >> 48) & 0xFF) as u8;
            let p7: *mut u8 = p + 7;
            *p7 = ((val >> 56) & 0xFF) as u8;
            self.pos = self.pos + 8;
            return Result::<u64, CursorError>::Ok { value: self.pos };
        }
    }

    // ---- Tests ----

    import std.test.{assert_eq, assert_true};

    #[test]
    trusted fn test_cursor_read_u8() with(Alloc, Console) -> i32 {
        let buf: [u8; 4] = [0xDE, 0xAD, 0xBE, 0xEF];
        let mut cur: RawCursor = RawCursor::from_raw(&buf as *const u8, 4);
        if !assert_eq::<u64>(cur.remaining(), 4, "remaining should be 4") { return 1; }

        let r0: Result<u8, CursorError> = cur.read_u8();
        match r0 {
            Result::Ok { value } => {
                if !assert_eq::<u8>(value, 0xDE, "first byte should be 0xDE") { return 1; }
            },
            Result::Err { error } => { return 2; }
        }
        if !assert_eq::<u64>(cur.remaining(), 3, "remaining should be 3") { return 3; }
        return 0;
    }

    #[test]
    trusted fn test_cursor_read_u16_be() with(Alloc, Console) -> i32 {
        let buf: [u8; 4] = [0x12, 0x34, 0x56, 0x78];
        let mut cur: RawCursor = RawCursor::from_raw(&buf as *const u8, 4);

        let r: Result<u16, CursorError> = cur.read_u16_be();
        match r {
            Result::Ok { value } => {
                if !assert_eq::<u16>(value, 0x1234, "u16 BE should be 0x1234") { return 1; }
            },
            Result::Err { error } => { return 2; }
        }
        if !assert_eq::<u64>(cur.pos(), 2, "pos should be 2") { return 3; }
        return 0;
    }

