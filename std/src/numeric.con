    trusted fn test_cursor_read_u16_le() with(Alloc, Console) -> i32 {
        let buf: [u8; 4] = [0x34, 0x12, 0x00, 0x00];
        let mut cur: RawCursor = RawCursor::from_raw(&buf as *const u8, 4);

        let r: Result<u16, CursorError> = cur.read_u16_le();
        match r {
