    trusted fn test_cursor_read_u32_le() with(Alloc, Console) -> i32 {
        let buf: [u8; 4] = [0x78, 0x56, 0x34, 0x12];
        let mut cur: RawCursor = RawCursor::from_raw(&buf as *const u8, 4);

        let r: Result<u32, CursorError> = cur.read_u32_le();
