mod libc {
    // R-0484 (2026-10-01): EVERY BINDING DECLARES ITS EFFECTS, and only bindings safe for
    // EVERY argument their types permit stay `trusted extern` (HANDLE_CAPABILITIES.md R3-R4,
    // classification in HANDLE_CAPABILITIES_AUDIT.md §3). A binding whose safety depends on
    // pointer validity, or that can invalidate a resource another handle owns (`close`,
    // `waitpid`), is a plain `extern`: its callers outside `trusted` code need `Unsafe`, and
    // std's trusted wrappers absorb it. Effects are declared either way, and bind every
    // caller, trusted ones included. The note below records the earlier design.
    //
    // EVERY DECLARATION HERE IS `trusted extern`, AND THAT IS THE POINT.
    //
    // `externFnRequiredCaps` (Concrete/Semantics/Capabilities.lean) types a PLAIN
    // `extern fn` as requiring `Unsafe` and a `trusted extern fn` as requiring nothing:
    // the trust boundary is the declaring author's responsibility. This block is that
    // boundary for the C standard library. Marking it explicitly is what keeps `Unsafe`
    // from going viral through the whole public surface — `String::eq` calls `memcmp`,
    // so under a plain `extern` every string comparison in every user program would have
    // to declare `with(Unsafe)`, and the marker would stop meaning anything.
    //
    // It had never been written down because it had never been CHECKED: until the
    // sibling-submodule signature repair (2026-09-20, R-0484), a call from `std.io` into
    // `std.libc` found no signature and was read as requiring nothing at all. The vouch
    // was always being made; it was being made silently. `examples/elf_header` has
    // declared its own externs this way from the start.
    //
    // Adding a declaration here is therefore a deliberate act: it asserts that the symbol
    // is the real C function it names and that calling it with well-typed arguments is
    // sound. It does NOT make what the symbol DOES visible — that is the separate
    // `performs` fact R-0484 is about, and this line is where effect tracking stops.
    trusted extern fn malloc(size: u64) with(Alloc) -> *mut u8;
    extern fn realloc(ptr: *mut u8, size: u64) with(Alloc) -> *mut u8;
    extern fn free(ptr: *mut u8) with(Alloc);
    extern fn puts(ptr: *mut u8) with(Console) -> i32;
    extern fn fopen(name: *mut u8, mode: *mut u8) with(File) -> *const u8;
    extern fn fdopen(name: i32, mode: *mut u8) with(File) -> *const u8;
    extern fn fclose(file: *const u8) with(File) -> i32;
    extern fn fflush(file: *const u8) with(File) -> i32;
    extern fn ferror(file: *const u8) with(File) -> i32;
    extern fn fread(buf: *mut u8, size: u64, count: u64, file: *const u8) with(File) -> u64;
    extern fn fwrite(buf: *const u8, size: u64, count: u64, file: *const u8) with(File) -> u64;
    extern fn fseek(file: *const u8, offset: i64, whence: i32) with(File) -> i32;
    extern fn ftell(file: *const u8) with(File) -> i64;
    trusted extern fn exit(status: i32) with(Process);
    // Terminates WITHOUT running atexit handlers or flushing stdio. Required in a forked
    // child that failed to exec: its stdio buffers are copies of the parent's, and
    // flushing them writes the parent's pending output a second time (bug 072).
    trusted extern fn _exit(status: i32) with(Process);
    trusted extern fn raise(signal: i32) with(Process);
    extern fn strlen(ptr: *const u8) with() -> u64;
    extern fn memcpy(dest: *mut u8, src: *const u8, n: u64) with() -> *mut u8;
    extern fn memset(ptr: *mut u8, value: i32, n: u64) with() -> *mut u8;
    extern fn memcmp(a: *const u8, b: *const u8, n: u64) with() -> i32;
    extern fn read(fd: i32, buf: *mut u8, count: u64) with(Console) -> i64;
    extern fn write(fd: i32, buf: *const u8, count: u64) with(Console) -> i64;
    trusted extern fn putchar(c: i32) with(Console) -> i32;
    extern fn getenv(name: *const u8) with(Env) -> *const u8;
    extern fn snprintf(buf: *mut u8, size: u64, fmt: *const u8) with() -> i32;
    extern fn strtol(str: *const u8, endptr: *mut *const u8, base: i32) with() -> i64;

    // Process
    extern fn setenv(name: *const u8, value: *const u8, overwrite: i32) with(Env) -> i32;
    extern fn unsetenv(name: *const u8) with(Env) -> i32;
    trusted extern fn getpid() with(Process) -> i32;
    trusted extern fn fork() with(Process) -> i32;
    extern fn execvp(file: *const u8, argv: *const *const u8) with(Process) -> i32;
    extern fn waitpid(pid: i32, status: *mut i32, options: i32) with(Process) -> i32;
    trusted extern fn kill(pid: i32, sig: i32) with(Process) -> i32;

    // Time
    extern fn time(t: *mut i64) with(Time) -> i64;
    extern fn clock_gettime(clk_id: i32, tp: *mut u8) with(Time) -> i32;
    extern fn nanosleep(req: *const u8, rem: *mut u8) with(Time) -> i32;

    // Random
    trusted extern fn rand() with(Random) -> i32;
    trusted extern fn srand(seed: u32) with(Random);

    // Platform detection
    extern fn uname(buf: *mut u8) with(Env) -> i32;

    // Networking
    trusted extern fn socket(domain: i32, typ: i32, protocol: i32) with(Network) -> i32;
    extern fn bind(sockfd: i32, addr: *const u8, addrlen: u32) with(Network) -> i32;
    trusted extern fn listen(sockfd: i32, backlog: i32) with(Network) -> i32;
    extern fn accept(sockfd: i32, addr: *mut u8, addrlen: *mut u32) with(Network) -> i32;
    extern fn connect(sockfd: i32, addr: *const u8, addrlen: u32) with(Network) -> i32;
    extern fn close(fd: i32) with(Network) -> i32;
    extern fn send(sockfd: i32, buf: *const u8, len: u64, flags: i32) with(Network) -> i64;
    extern fn recv(sockfd: i32, buf: *mut u8, len: u64, flags: i32) with(Network) -> i64;
    trusted extern fn htons(hostshort: u16) with() -> u16;
    trusted extern fn htonl(hostlong: u32) with() -> u32;
    extern fn inet_pton(af: i32, src: *const u8, dst: *mut u8) with() -> i32;
    extern fn setsockopt(sockfd: i32, level: i32, optname: i32, optval: *const u8, optlen: u32) with(Network) -> i32;
}
