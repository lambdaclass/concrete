mod text {
    import std.alloc.{grow,dealloc};

    // ============================================================
    // AsciiText — canonical validated wrapper (docs/stdlib/VALIDATED_WRAPPERS.md §4).
    //
    // Invariant: every byte in the inner String is in 0..=127. Validation
    // runs once in try_new; .0 extraction is zero-cost after that.
    // Instance methods on newtypes now work, but AsciiText keeps the
    // constructor-only public surface intentionally small.
    // ============================================================

    pub newtype AsciiText = String;

    impl AsciiText {
        /// Validate `s` as ASCII and wrap it. RETURNED ON FAILURE: a rejected
        /// string comes back unchanged in `Err`, so the caller still owns it
        /// (ownership-on-failure convention, docs/stdlib/STDLIB_DESIGN_PRINCIPLES.md).
        /// It used to be dropped behind a bare `None`.
        pub trusted fn try_new(s: String) -> Result<AsciiText, String> {
            let n: u64 = s.len();
            let mut i: u64 = 0;
            while i < n {
                let pb: *const u8 = s.raw_ptr() as *const u8 + i;
                let b: u8 = *(pb as *mut u8);
                if b > (127 as u8) {
                    return Result::<AsciiText, String>::Err { error: s };
                }
                i = i + 1;
            }
            return Result::<AsciiText, String>::Ok { value: AsciiText(s) };
        }
    }

    // An OWNING, validated UTF-8 string.
    //
    // R-0483: `Text` used to be a `Copy` pair of `*const u8` + length borrowing someone
    // else's bytes. Two things followed and neither was survivable. It could outlive the
    // buffer it pointed into, because `Copy` meant it could be returned and stored while
    // the owner was consumed. And its validation described the past: `try_text` checked
    // UTF-8 once, nothing rechecked, and mutating the source left a "validated" value
    // yielding bytes that had never been validated.
    //
    // A `Text` now OWNS its storage and nothing can reach that storage to change it:
    // the fields are private, there is no `&mut` accessor and no raw-parts escape, and
    // every constructor COPIES rather than aliasing. The UTF-8 property established at
    // construction therefore holds for the value's whole life, which is what calling
    // something validated ought to mean.
    //
    // It is consequently linear rather than `Copy` — it owns a heap buffer and must be
    // consumed exactly once. That cost is deliberate: it is what makes the guarantee
    // structural instead of a check someone has to remember to repeat.
    //
    // The storage is managed here rather than held as a `Bytes` because `bytes.con`
    // imports `validate_utf8` from this module, and owning a `Bytes` would close that
    // import cycle.
    // spec: TYPE-3 (docs/spec/types.md: Text is owned)
    pub struct Text {
        ptr: *mut u8,
        len: u64,
        cap: u64,
    }

    impl Text {
        /// Copy and validate `[ptr, ptr+len)`. None if it is not well-formed UTF-8.
        /// The caller must ensure the region is live for `len` bytes; the copy means
        /// the resulting `Text` no longer depends on it afterwards.
        pub fn copy_from_raw(ptr: *const u8, len: u64) with(Alloc, Unsafe) -> Option<Text> {
            if !validate_utf8(ptr, len) {
                return Option::<Text>::None;
            }
            let dst: *mut u8 = grow::<u8>(0 as *mut u8, len);
            let mut i: u64 = 0;
            while i < len {
                *((dst as u64 + i) as *mut u8) = byte_at(ptr, i);
                i = i + 1;
            }
            return Option::<Text>::Some { value: Text { ptr: dst, len: len, cap: len } };
        }

        /// Copy a `String`'s bytes into owned storage. A `String` is already valid
        /// UTF-8, so this cannot fail; it copies because sharing is what was unsound.
        pub trusted fn from_string(s: &String) with(Alloc) -> Text {
            let len: u64 = s.len();
            let dst: *mut u8 = grow::<u8>(0 as *mut u8, len);
            let src: *const u8 = s.raw_ptr() as *const u8;
            let mut i: u64 = 0;
            while i < len {
                *((dst as u64 + i) as *mut u8) = byte_at(src, i);
                i = i + 1;
            }
            return Text { ptr: dst, len: len, cap: len };
        }

        pub fn len(&self) -> u64 {
            return self.len;
        }

        pub fn is_empty(&self) -> bool {
            return self.len == 0;
        }

        /// The byte at `at`, or None if out of range. Bounds-checked: the unchecked
        /// accessor is gone, because a validated value handing out unchecked reads was
        /// part of what made the old type unsafe.
        pub trusted fn byte(&self, at: u64) -> Option<u8> {
            if at >= self.len {
                return Option::<u8>::None;
            }
            return Option::<u8>::Some { value: byte_at(self.ptr as *const u8, at) };
        }

        pub trusted fn eq(&self, other: &Text) -> bool {
            if self.len != other.len {
                return false;
            }
            let mut i: u64 = 0;
            while i < self.len {
                if byte_at(self.ptr as *const u8, i) != byte_at(other.ptr as *const u8, i) {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }

        /// Release the storage. `Text` is linear; this is the consume.
        pub trusted fn drop(self) with(Alloc) {
            let Text { ptr, len, cap } = self;
            dealloc::<u8>(ptr);
        }
    }

    impl Destroy for Text {
        pub trusted fn destroy(&self) with(Alloc) {
            dealloc::<u8>(self.ptr);
        }
    }

    // ---- UTF-8 well-formedness (RFC 3629 / Unicode Table 3-7) ----

    trusted fn byte_at(ptr: *const u8, i: u64) -> u8 {
        let p: *const u8 = ptr + i;
        return *(p as *mut u8);
    }

    fn in_range(b: u8, lo: u8, hi: u8) -> bool {
        return b >= lo && b <= hi;
    }

    /// True iff [ptr, ptr+len) is well-formed UTF-8. Rejects overlong encodings,
    /// surrogates (U+D800..U+DFFF), and code points above U+10FFFF via the
    /// per-leading-byte continuation ranges.
    pub trusted fn validate_utf8(ptr: *const u8, len: u64) with(Unsafe) -> bool {
        let mut i: u64 = 0;
        while i < len {
            let b0: u8 = byte_at(ptr, i);
            if b0 < (128 as u8) {
                i = i + 1;
            } else if in_range(b0, 194 as u8, 223 as u8) {
                // 2-byte: C2..DF | 80..BF
                if len - i < 2 { return false; }  // H2 overflow-safe
                if !in_range(byte_at(ptr, i + 1), 128 as u8, 191 as u8) { return false; }
                i = i + 2;
            } else if b0 == (224 as u8) {
                // E0 | A0..BF | 80..BF
                if len - i < 3 { return false; }  // H2 overflow-safe
                if !in_range(byte_at(ptr, i + 1), 160 as u8, 191 as u8) { return false; }
                if !in_range(byte_at(ptr, i + 2), 128 as u8, 191 as u8) { return false; }
                i = i + 3;
            } else if in_range(b0, 225 as u8, 236 as u8) {
                // E1..EC | 80..BF | 80..BF
                if len - i < 3 { return false; }  // H2 overflow-safe
                if !in_range(byte_at(ptr, i + 1), 128 as u8, 191 as u8) { return false; }
                if !in_range(byte_at(ptr, i + 2), 128 as u8, 191 as u8) { return false; }
                i = i + 3;
            } else if b0 == (237 as u8) {
                // ED | 80..9F | 80..BF  (excludes surrogates)
                if len - i < 3 { return false; }  // H2 overflow-safe
                if !in_range(byte_at(ptr, i + 1), 128 as u8, 159 as u8) { return false; }
                if !in_range(byte_at(ptr, i + 2), 128 as u8, 191 as u8) { return false; }
                i = i + 3;
            } else if in_range(b0, 238 as u8, 239 as u8) {
                // EE..EF | 80..BF | 80..BF
                if len - i < 3 { return false; }  // H2 overflow-safe
                if !in_range(byte_at(ptr, i + 1), 128 as u8, 191 as u8) { return false; }
                if !in_range(byte_at(ptr, i + 2), 128 as u8, 191 as u8) { return false; }
                i = i + 3;
            } else if b0 == (240 as u8) {
                // F0 | 90..BF | 80..BF | 80..BF
                if len - i < 4 { return false; }  // H2 overflow-safe
                if !in_range(byte_at(ptr, i + 1), 144 as u8, 191 as u8) { return false; }
                if !in_range(byte_at(ptr, i + 2), 128 as u8, 191 as u8) { return false; }
                if !in_range(byte_at(ptr, i + 3), 128 as u8, 191 as u8) { return false; }
                i = i + 4;
            } else if in_range(b0, 241 as u8, 243 as u8) {
                // F1..F3 | 80..BF | 80..BF | 80..BF
                if len - i < 4 { return false; }  // H2 overflow-safe
                if !in_range(byte_at(ptr, i + 1), 128 as u8, 191 as u8) { return false; }
                if !in_range(byte_at(ptr, i + 2), 128 as u8, 191 as u8) { return false; }
                if !in_range(byte_at(ptr, i + 3), 128 as u8, 191 as u8) { return false; }
                i = i + 4;
            } else if b0 == (244 as u8) {
                // F4 | 80..8F | 80..BF | 80..BF  (caps at U+10FFFF)
                if len - i < 4 { return false; }  // H2 overflow-safe
                if !in_range(byte_at(ptr, i + 1), 128 as u8, 143 as u8) { return false; }
                if !in_range(byte_at(ptr, i + 2), 128 as u8, 191 as u8) { return false; }
                if !in_range(byte_at(ptr, i + 3), 128 as u8, 191 as u8) { return false; }
                i = i + 4;
            } else {
                // C0, C1, F5..FF, or a stray continuation byte 80..BF as leader
                return false;
            }
        }
        return true;
    }

    import std.test.{assert_eq, assert_true};

    #[test]
    fn test_text_from_string() with(Alloc, Console) -> i32 {
        let s: String = "hello";
        let t: Text = Text::from_string(&s);
        if !assert_eq::<u64>(t.len(), 5, "text len should be 5") { t.drop(); s.drop(); return 1; }
        if !assert_true(!(t.is_empty()), "text should not be empty") { t.drop(); s.drop(); return 1; }
        t.drop();
        s.drop();
        return 0;
    }

    #[test]
    fn test_text_byte_checked() with(Alloc, Console) -> i32 {
        let s: String = "abc";
        let t: Text = Text::from_string(&s);
        let mut rc: i32 = 0;
        match t.byte(0) {
            Option::Some { value } => { if !assert_eq::<u8>(value, 97, "first byte should be 'a'=97") { rc = 1; } },
            Option::None => { rc = 1; },
        }
        match t.byte(2) {
            Option::Some { value } => { if !assert_eq::<u8>(value, 99, "third byte should be 'c'=99") { rc = 1; } },
            Option::None => { rc = 1; },
        }
        // Past the end is None, not an unchecked read.
        match t.byte(3) {
            Option::Some { value } => { rc = 1; },
            Option::None => {},
        }
        t.drop();
        s.drop();
        return rc;
    }

    #[test]
    fn test_text_eq() with(Alloc, Console) -> i32 {
        let s1: String = "hello";
        let s2: String = "hello";
        let s3: String = "world";
        let t1: Text = Text::from_string(&s1);
        let t2: Text = Text::from_string(&s2);
        let t3: Text = Text::from_string(&s3);
        let mut rc: i32 = 0;
        if !assert_true(t1.eq(&t2), "same content should be equal") { rc = 1; }
        if !assert_true(!(t1.eq(&t3)), "different content should not be equal") { rc = 1; }
        t1.drop();
        t2.drop();
        t3.drop();
        s1.drop();
        s2.drop();
        s3.drop();
        return rc;
    }

    #[test]
    fn test_ascii_text_try_new_happy() with(Alloc, Console) -> i32 {
        let s: String = "hello";
        match AsciiText::try_new(s) {
            Result::Ok { value } => {
                // `.0` is a move-out (no partial moves): unwrap ONCE, then use.
                let inner: String = value.0;
                if !assert_eq::<u64>(inner.len(), 5, "AsciiText wraps String of len 5") {
                    inner.drop();
                    return 1;
                }
                inner.drop();
                return 0;
            }
            Result::Err { error } => { error.drop(); return 2; }
        }
    }

    #[test]
    fn test_ascii_text_try_new_empty_ok() with(Alloc) -> i32 {
        let s: String = String::new();
        match AsciiText::try_new(s) {
            Result::Ok { value } => { value.0.drop(); return 0; }
            Result::Err { error } => { error.drop(); return 1; }
        }
    }

    #[test]
    fn test_ascii_text_try_new_rejects_non_ascii() with(Alloc) -> i32 {
        let mut s: String = String::new();
        s.push_char(72);
        s.push_char(200);
        s.push_char(105);
        // The rejected string comes back exactly once, unchanged: same
        // length, same bytes. The caller still owns it and must drop it.
        match AsciiText::try_new(s) {
            Result::Ok { value } => { value.0.drop(); return 1; }
            Result::Err { error } => {
                let back: String = error;
                let same: bool = back.len() == 3 && (back.get_unchecked(0) as u8) == 72 && (back.get_unchecked(1) as u8) == 200 && (back.get_unchecked(2) as u8) == 105;
                back.drop();
                if same { return 0; }
                return 2;
            }
        }
    }

    #[test]
    fn test_text_empty() with(Alloc, Console) -> i32 {
        let s: String = String::new();
        let t: Text = Text::from_string(&s);
        let mut rc: i32 = 0;
        if !assert_true(t.is_empty(), "empty text should be empty") { rc = 1; }
        if !assert_eq::<u64>(t.len(), 0, "empty text len should be 0") { rc = 1; }
        t.drop();
        s.drop();
        return rc;
    }

    // ---- UTF-8 validation (try_from_raw / validate_utf8) ----

    #[test]
    trusted fn test_copy_from_raw_valid_utf8() with(Alloc, Console) -> i32 {
        // "café" = 63 61 66 C3 A9 (the é is the 2-byte U+00E9)
        let buf: [u8; 5] = [0x63, 0x61, 0x66, 0xC3, 0xA9];
        match Text::copy_from_raw(&buf as *const u8, 5) {
            Option::Some { value } => {
                let ok: bool = assert_eq::<u64>(value.len(), 5, "valid utf8 len should be 5 bytes");
                value.drop();
                if !ok { return 1; }
                return 0;
            },
            Option::None => { return 2; }
        }
    }

    #[test]
    trusted fn test_copy_from_raw_split_codepoint_rejected() with(Alloc) -> i32 {
        // 0xC3 lead byte with no continuation -> invalid
        let buf: [u8; 4] = [0x63, 0x61, 0x66, 0xC3];
        match Text::copy_from_raw(&buf as *const u8, 4) {
            Option::Some { value } => { value.drop(); return 1; },
            Option::None => { return 0; }
        }
    }

    #[test]
    trusted fn test_copy_from_raw_surrogate_rejected() with(Alloc) -> i32 {
        // ED A0 80 = U+D800 (a surrogate) -> invalid in UTF-8
        let buf: [u8; 3] = [0xED, 0xA0, 0x80];
        match Text::copy_from_raw(&buf as *const u8, 3) {
            Option::Some { value } => { value.drop(); return 1; },
            Option::None => { return 0; }
        }
    }

    #[test]
    trusted fn test_copy_from_raw_overlong_rejected() with(Alloc) -> i32 {
        // C0 80 = overlong encoding of NUL; C0 is never a valid lead byte
        let buf: [u8; 2] = [0xC0, 0x80];
        match Text::copy_from_raw(&buf as *const u8, 2) {
            Option::Some { value } => { value.drop(); return 1; },
            Option::None => { return 0; }
        }
    }

    #[test]
    trusted fn test_copy_from_raw_4byte_valid() with(Alloc, Console) -> i32 {
        // F0 9F 98 80 = U+1F600 GRINNING FACE -> valid
        let buf: [u8; 4] = [0xF0, 0x9F, 0x98, 0x80];
        match Text::copy_from_raw(&buf as *const u8, 4) {
            Option::Some { value } => {
                let ok: bool = assert_eq::<u64>(value.len(), 4, "4-byte sequence is 4 bytes");
                value.drop();
                if !ok { return 1; }
                return 0;
            },
            Option::None => { return 2; }
        }
    }

    #[test]
    trusted fn test_copy_from_raw_4byte_too_large_rejected() with(Alloc) -> i32 {
        // F5 .. would encode beyond U+10FFFF; F5 is not a valid lead byte
        let buf: [u8; 4] = [0xF5, 0x80, 0x80, 0x80];
        match Text::copy_from_raw(&buf as *const u8, 4) {
            Option::Some { value } => { value.drop(); return 1; },
            Option::None => { return 0; }
        }
    }
}
