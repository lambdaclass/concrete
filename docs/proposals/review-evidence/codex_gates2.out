    25	# usage: slice0_artifacts.sh [REPORT_DIR]. Run inside the nix devshell, from the repository root.
    26	set -euo pipefail
    27	report=${1:-}
    28	# The sanitizer executions need an unbounded address-space reservation, so the gate sets no cap of
    29	# its own and caps every other command it starts (`capped`, and limited_exec.sh for executables).
    30	SLICE0_GATE_MEM_GB=0
    31	# shellcheck source=scripts/checks/lib/slice0_common.sh
    32	source scripts/checks/lib/slice0_common.sh
    33	: "${CONCRETE_SLICE0_LLVM:?run inside nix develop}"
    34	objdump=("${capped[@]}" "$CONCRETE_SLICE0_LLVM/llvm-objdump" -d --no-show-raw-insn)
    35	case "$target" in
    36	  x86_64-linux) arch=x86_64; objdump+=(--x86-asm-syntax=intel) ;;
    37	  aarch64-*) arch=aarch64 ;;
    38	esac
    39	gdb=
    40	if [ "$target" = x86_64-linux ]; then gdb=${CONCRETE_SLICE0_GDB:?the x86-64 Linux shell pins gdb}; fi
    41	[ -n "$report" ] || report="$work/report"
    42	mkdir -p "$report"
    43	sizes="$report/sizes.tsv"
    44	stack="$report/stack.tsv"
    45	printf 'example\tbackend\ttarget\tbytes\ttext\n' >"$sizes"
    46	printf 'example\tbackend\ttarget\tbound\tmeasured\texternals\n' >"$stack"
    47	# hard_rss_limit_mb and LeakSanitizer are Linux-only (ASan on Darwin refuses detect_leaks); on
    48	# macOS RLIMIT_AS is not enforced either, so there the job's memory is the bound, as for all runs.
    49	asan=abort_on_error=0:symbolize=0
    50	[ "$(uname -s)" != Linux ] || asan="$asan:hard_rss_limit_mb=1024:detect_leaks=1"
    51	san_env=("ASAN_OPTIONS=$asan" UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=0:symbolize=0)
    52	# stack_bound ARCH DISASM [--ranges]: the analysis, capped and bounded in time.
    53	stack_bound() { "${capped[@]}" timeout -k 10 60 python3 -I "$root/scripts/checks/lib/stack_bound.py" "$@"; }
    54	fail=0
    55	examples=0
    56	last_exe= last_analysis=
    57	
    58	# within MEASURED BOUND: the run stayed within the static bound (and actually ran).
    59	within() { [ "$1" -gt 0 ] && [ "$1" -le "$2" ]; }
    60	
    61	# measure EXE ANALYSIS EXPECT: the gdb run check's output (`measured N` or `error ...`), given the
    62	# analysis output (its `range` lines) and the expected exit status.
    63	measure() {
    64	  local ranges main
    65	  ranges=$(awk '$1 == "range" {printf "%s%s:%s", sep, $3, $4; sep=","}' <<<"$2")
    66	  main=$(awk '$1 == "range" && $2 == "main" {print $3}' <<<"$2")
    67	  STACK_RANGES=$ranges STACK_MAIN=$main STACK_EXPECT=$3 \
    68	    "${capped[@]}" timeout -k 10 300 "$gdb" -batch -nx -x "$root/scripts/checks/lib/stack_measure.py" \
    69	    "$1" 2>"$1.gdb.err" | awk '$1 == "measured" || $1 == "error" {print}' || true
    70	}
    71	
    72	# stack_check NAME BACKEND EXE: derive the bound, measure a run where supported, record both.
    73	stack_check() {
    74	  local name=$1 backend=$2 exe=$3 dis="$3.dis" out bound ext m measured=not-run
    75	  if ! timeout -k 10 60 "${objdump[@]}" "$exe" >"$dis" 2>"$dis.err"; then
    76	    echo "FAIL $name [$backend] stack: disassembly failed: $(head -c 300 "$dis.err")"; fail=1; return
    77	  fi
    78	  if ! out=$(stack_bound "$arch" "$dis" --ranges); then
    79	    echo "FAIL $name [$backend] stack: $out"; fail=1; return
    80	  fi
    81	  bound=$(awk '$1 == "bound" {print $2}' <<<"$out")
    82	  ext=$(awk '$1 == "external" {printf "%s%s@%s", sep, $2, $3; sep=","}' <<<"$out")
    83	  if [ -n "$gdb" ]; then
    84	    m=$(measure "$exe" "$out" "$(cat "$(dirname "$exe")/status")")
    85	    measured=$(awk '$1 == "measured" {print $2}' <<<"$m")
    86	    if [ -z "$measured" ] || ! within "$measured" "$bound"; then
    87	      echo "FAIL $name [$backend] stack: bound $bound, run: ${m:-no measurement} $(head -c 300 "$exe.gdb.err")"
    88	      fail=1; return
    89	    fi
    90	    last_exe=$exe last_analysis=$out
    91	  fi
    92	  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$backend" "$target" "$bound" "$measured" "$ext" >>"$stack"
    93	  echo "ok   $name [$backend] stack: bound $bound, measured $measured, externals ${ext:-none}"
    94	}
    95	
    96	size_report() { # size_report NAME BACKEND EXE
    97	  local bytes text
    98	  bytes=$(wc -c <"$3" | tr -d ' ')
    99	  text=$("${capped[@]}" timeout -k 10 60 "$CONCRETE_SLICE0_LLVM/llvm-size" "$3" 2>/dev/null | awk 'NR == 2 {print $1}') || true
   100	  printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$target" "$bytes" "${text:-unavailable}" >>"$sizes"
   101	}
   102	
   103	names=$(emit_examples)
   104	mkdir -p "$work/ctl"
   105	for name in $names; do
   106	  d="$work/ex/$name"
   107	  "${emitter[@]}" emit "$name" "$d" "$target"
   108	  build "$name" "$d/build.log" "${capped[@]}" timeout -k 10 300 bash "$root/scripts/checks/slice0_native.sh" "$d" "$lcb"
   109	  build "$name" "$d/build-san.log" \
   110	    "${capped[@]}" timeout -k 10 300 bash "$root/scripts/checks/slice0_native.sh" "$d" "$lcb" sanitize

