 succeeded in 0ms:
# lldb --batch -o 'command script import stack_measure_lldb.py' (README gate 12, aarch64-macos).
# PROVISIONAL.
#
# The LLDB counterpart of stack_measure.py (same contract, same environment: STACK_EXE, the
# executable; STACK_RANGES "LO:HI,..." in link-time addresses, from stack_bound.py --ranges;
# STACK_MAIN, main's LO; STACK_EXPECT, the expected exit status). It measures the stack depth one
# complete run reaches, below the stack pointer at `main`'s entry, by single-stepping every
# instruction of the Concrete-owned functions. An external function (entered by `bl`, so its
# return address is in the link register) runs at full speed to that return address; its own use
# is outside the bound, as in stack_bound.py, but the depth at its entry is measured. Once main has
# returned, the rest runs freely.
#
# Fail closed: the measurement counts only for a run that stopped first at main's runtime address,
# stopped after each external call exactly at its return address (or exited inside it), received
# no signal, and exited normally with status STACK_EXPECT. Prints `measured N` and `steps N`, or
# `error ...` (the gate fails on anything but a measurement).
import os

import lldb

LIMIT = 2_000_000


def measure(debugger):
    exe = os.environ["STACK_EXE"]
    ranges = [tuple(int(x, 16) for x in r.split(":")) for r in os.environ["STACK_RANGES"].split(",")]
    main_lo = int(os.environ["STACK_MAIN"], 16)
    expect = int(os.environ["STACK_EXPECT"])
    debugger.SetAsync(False)
    target = debugger.CreateTarget(exe)
    if not target.IsValid():
        raise RuntimeError(f"cannot load {exe}")
    bp = target.BreakpointCreateByName("main", target.GetExecutable().GetFilename())
    if bp.GetNumLocations() != 1:
        raise RuntimeError(f"main has {bp.GetNumLocations()} breakpoint locations")
    main_rt = bp.GetLocationAtIndex(0).GetLoadAddress()
    info = lldb.SBLaunchInfo([])
    info.SetLaunchFlags(lldb.eLaunchFlagDisableASLR)
    for fd, flags in ((0, os.O_RDONLY), (1, os.O_WRONLY), (2, os.O_WRONLY)):
        info.AddOpenFileAction(fd, "/dev/null", flags == os.O_RDONLY, flags != os.O_RDONLY)
    err = lldb.SBError()
    process = target.Launch(info, err)
    if not err.Success() or not process.IsValid():
        raise RuntimeError(f"launch failed: {err}")
    try:
        return run(process, target, bp, ranges, main_lo, main_rt, expect)
    finally:
        if process.GetState() not in (lldb.eStateExited, lldb.eStateDetached, lldb.eStateInvalid):
            process.Kill()


def check_live(process):
    """True while the process is stopped (not exited); raises on a signal or another stop."""
    state = process.GetState()
    if state == lldb.eStateExited:
        return False
    if state != lldb.eStateStopped:
        raise RuntimeError(f"unexpected process state {state}")
    thread = process.GetSelectedThread()
    if thread.GetStopReason() == lldb.eStopReasonSignal or thread.GetStopReason() == lldb.eStopReasonException:
        raise RuntimeError(f"signal or exception: {thread.GetStopDescription(200)}")
    return True


def run(process, target, bp, ranges, main_lo, main_rt, expect):
    if not check_live(process):
        raise RuntimeError("exited before main")
    thread = process.GetSelectedThread()
    frame = thread.GetFrameAtIndex(0)
    if frame.GetPC() != main_rt:
        raise RuntimeError(f"first stop at {frame.GetPC():#x}, not main ({main_rt:#x})")
    target.BreakpointDelete(bp.GetID())
    offset = main_rt - main_lo
    sp0 = frame.GetSP()
    low, steps = sp0, 0

    def owned(pc):
        return any(lo + offset <= pc <= hi + offset for lo, hi in ranges)

    while check_live(process):
        thread = process.GetSelectedThread()
        frame = thread.GetFrameAtIndex(0)
        pc, sp = frame.GetPC(), frame.GetSP()
        if sp > sp0:  # main has returned
            process.Continue()
            continue
        low = min(low, sp)
        if owned(pc):
            thread.StepInstruction(False)
            steps += 1
            if steps > LIMIT:
                raise RuntimeError(f"more than {LIMIT} steps")
        else:
            ret = frame.FindRegister("lr").GetValueAsUnsigned()
            if not owned(ret):
                raise RuntimeError(f"external code at {pc:#x} returns to {ret:#x}, outside the owned code")
            tb = target.BreakpointCreateByAddress(ret)
            tb.SetOneShot(True)
            process.Continue()
            if check_live(process) and process.GetSelectedThread().GetFrameAtIndex(0).GetPC() != ret:
                raise RuntimeError(f"stopped at {process.GetSelectedThread().GetFrameAtIndex(0).GetPC():#x}, "
                                   f"not the return address {ret:#x}")
            target.BreakpointDelete(tb.GetID())
    status = process.GetExitStatus()
    if status != expect:
        raise RuntimeError(f"exit status {status}, expected {expect}")
    if steps == 0:
        raise RuntimeError("no instruction stepped")
    return sp0 - low, steps


def __lldb_init_module(debugger, _dict):
    try:
        measured, steps = measure(debugger)
        print(f"measured {measured}")
        print(f"steps {steps}")
    except Exception as e:  # noqa: BLE001 - every failure is reported, the gate fails closed
        print(f"error {e}")
# shellcheck shell=bash
# Shared machinery of the slice-0 example gates (PROVISIONAL): slice0_backends.sh (gates 4, 6, 6a)
# and slice0_artifacts.sh (gates 10, 11, 12). Source it from the repository root, inside the nix
# devshell, with `set -euo pipefail`. It builds the compiler and LCB's command line under the
# gate's limits (lib/limits.sh: an address-space cap of SLICE0_GATE_MEM_GB GiB, default 64; 0 for
# a gate whose executables under test need no cap, slice0_artifacts.sh) and defines:
#   capped (a command prefix, an array): run under a 64 GiB address-space cap of its own, so
#     every build and analysis command is capped whatever the gate's cap;
#   bounded SECS CMD...: CMD under capped and bounded_run (the gates' only time bound);
#   root, work (removed on exit), lcb, target, emitter (the Lean emitter command, an array);
#   observe EXE OUT SECS RETRY [MEM_MB [ENV...]]: run EXE under bounded_run (and limited_exec.sh
#     MEM_MB, default 1024) with ENV assignments; OUT.status (status or "incomplete"),
#     OUT.stdout, OUT.stderr;
#   judge EXPECTED_DIR OBS: the observation OBS.* equals the expectation, byte for byte;
#   build NAME LOG CMD...: run CMD, or print LOG and fail the gate;
#   emit_examples: the example names, one per line, failing if there are none;
#   cap_out: copy stdin to stdout, failing above 1 MiB: every command output a gate captures
#     into a variable goes through it, so no producer can grow the gate's shell (which may run
#     with no address-space cap, see SLICE0_GATE_MEM_GB) without bound.
root=$(pwd)
work=$(mktemp -d)
trap 'rm -rf "${work:?}"' EXIT
BOUNDED_PARENT="$work"
# shellcheck source=scripts/checks/lib/bounded.sh
source scripts/checks/lib/bounded.sh
[ "$BOUNDED_HAVE_WATCHDOG" = 1 ] || { echo "slice0: python3 is required for bounded runs" >&2; exit 2; }
# shellcheck source=scripts/checks/lib/limits.sh
source scripts/checks/lib/limits.sh
gate_limits "${SLICE0_GATE_MEM_GB:-64}" 40000
capped=(bash "$root/scripts/checks/lib/limited_exec.sh" 65536)
# bounded SECS CMD...: CMD under `capped`, through bounded_run (stdin /dev/null; a timeout is
# re-run once with a larger budget; a second timeout writes no output, returns 124 and is reported
# INCOMPLETE, never a pass).
bounded() {
  local secs=$1 rc=0
  shift
  bounded_run -i /dev/null "$secs" -- "${capped[@]}" "$@" || rc=$?
  if [ "$rc" != 0 ] && bounded_is_incomplete "$rc"; then
    echo "slice0: INCOMPLETE (timed out twice): $*" >&2
  fi
  return "$rc"
}
bounded 1800 lake build Concrete lean-compiler-backend/lcb >/dev/null
lcb="$root/.lake/packages/lean-compiler-backend/.lake/build/bin/lcb"
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) target=x86_64-linux ;;
  Linux-aarch64) target=aarch64-linux ;;
  Darwin-arm64) target=aarch64-macos ;;
  *) echo "slice0: unsupported host $(uname -s)-$(uname -m)" >&2; exit 2 ;;
esac
# The time bounds of the emit step (the Lean emitter) and the native step (slice0_native.sh).
emit_secs=120
native_secs=300
emitter=(bounded "$emit_secs" lake env lean --run scripts/checks/slice0_bir.lean)

observe() {
  local rc=0 mem=${5:-1024}
  local envs=("${@:6}")
  bounded_run -i /dev/null -r "$4" "$3" -- env ${envs[@]+"${envs[@]}"} \
    bash "$root/scripts/checks/lib/limited_exec.sh" "$mem" "$1" \
    >"$2.stdout" 2>"$2.stderr" || rc=$?
  if bounded_is_incomplete "$rc"; then echo incomplete >"$2.status"; else echo "$rc" >"$2.status"; fi
}

judge() {
  cmp -s "$1/status" "$2.status" && cmp -s "$1/stderr" "$2.stderr" && [ ! -s "$2.stdout" ]
}

build() {
  local name=$1 log=$2; shift 2
  "$@" >"$log" 2>&1 || { cat "$log" >&2; echo "slice0: $name: build failed: $*" >&2; exit 1; }
}

cap_out() {
  local LC_ALL=C out
  out=$(head -c 1048577; echo x)
  out=${out%x}
  [ "${#out}" -le 1048576 ] || { echo "slice0: captured output over 1 MiB" >&2; return 1; }
  printf '%s' "$out"
}

emit_examples() {
  local names
  names=$("${emitter[@]}" list | cap_out) || { echo "slice0: listing the examples failed" >&2; exit 1; }
  [ -n "$names" ] || { echo "slice0: no examples listed" >&2; exit 1; }
  printf '%s\n' "$names"
}
#!/usr/bin/env bash
# Bounded runs: a timeout is INCOMPLETE, never a failure and never a pass.
#
# The rule (docs/project/PROMOTION_PIPELINE.md, result vocabulary): a test that exceeds its time budget
# has produced no observation. Under machine load a freshly linked binary or a compile can overrun
# a budget sized for an idle machine (test_ssa.sh once reported hundreds of 5-second alarms as
# failures), so a timeout is re-run once, alone, with a larger budget:
#   - the re-run completes      -> its result is judged normally (pass or FAIL), recorded "recovered";
#   - the re-run times out too  -> INCOMPLETE: not a pass, not a failure. A gate with an incomplete
#                                  result exits nonzero, and a qualifying run contains none.
#
# Each attempt runs under lib/bounded_exec.py, which makes the command the leader of a new process
# group, reports its outcome through a status file (never through the command's own streams, so
# nothing the command prints can fake or hide a timeout) and, when the budget expires, sends SIGTERM
# and then SIGKILL to the whole group, so no descendant outlives the attempt into the retry.
#
# Sourcing (`BOUNDED_PARENT="$TMP"; source scripts/checks/lib/bounded.sh`) gives the gate PRIVATE
# state: a fresh directory (mktemp under BOUNDED_PARENT, else $TMPDIR) with an outcome file and a
# log. Every sourcing creates its own directory, so nested or parallel gates never share state.
# With BOUNDED_PARENT under the gate's own scratch directory, its cleanup removes the state too.
#
#   bounded_run [-i STDIN_FILE] [-r RETRY_SECS] SECS -- CMD [ARGS...]
#     Runs CMD (an executable, not a shell function). Its stdout and stderr are buffered per
#     attempt and only a COMPLETED attempt's output is written: an incomplete run writes nothing,
#     so output-matching checks never pass on the partial output of a run that hung. Without -i the
#     command inherits stdin, which a re-run cannot replay: callers that feed input pass -i.
#     Returns CMD's status, or 124 when it timed out on both attempts or the runner reported no
#     outcome. SECS and RETRY_SECS are positive decimal seconds. A command may itself exit
#     124, so test with `bounded_is_incomplete "$rc"`, which also reads the outcome bounded_run
#     recorded (this works across `( cd dir && bounded_run ... )` subshells; run one bounded_run
#     at a time per sourcing). RETRY_SECS defaults to BOUNDED_RETRY_FACTOR (2) times SECS.
#   bounded_summary
#     Lists this gate's recovered and incomplete runs; gates print it before their final tally.
#   bounded_watchdog SECS  -> sets the array TO for the watchdog form: "${TO[@]}" CMD [ARGS...]
#     runs CMD through `bash bounded.sh SECS` in a separate process with the same retry; on a second
#     timeout it writes no command output, prints "INCOMPLETE: ..." on stderr and exits 124. Its
#     recovered and incomplete lines go to this gate's log (handed over on its command line).
#   bounded_gate_status
#     The end-of-gate verdict for a gate using the watchdog form: lists recovered, incomplete and
#     runner-failed runs, removes the state directory, and returns 1 when any run was incomplete or
#     the runner failed, so the gate exits nonzero whatever its own checks concluded from a hung
#     command's empty output. Last line:
#       bounded_gate_status && [ "$FAIL" -eq 0 ]
#
# If the runner itself fails (no outcome reported), the command's output is discarded and the run
# is incomplete (status 124, a "runner-failed" log line): never a pass. If the runner is cancelled (the
# gate is interrupted or terminated), it kills the command's group first.
#
# Without python3 commands run directly with no watchdog: one warning when the gate sources this
# file, never inside a command's output, and the watchdog form then runs commands directly too.
# Such a run is never incomplete.

BOUNDED_RETRY_FACTOR="${BOUNDED_RETRY_FACTOR:-2}"
if [[ "$BOUNDED_RETRY_FACTOR" =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk -v f="$BOUNDED_RETRY_FACTOR" 'BEGIN { exit !(f + 0 >= 1) }'; then :
else echo "bounded.sh: BOUNDED_RETRY_FACTOR must be a number >= 1; using 2" >&2; BOUNDED_RETRY_FACTOR=2; fi
# _bounded_secs_ok S: S is a positive decimal number of seconds (fractions allowed).
_bounded_secs_ok() { [[ "$1" =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk -v s="$1" 'BEGIN { exit !(s + 0 > 0) }'; }
# Fixed-point, trailing zeros trimmed: never scientific notation, which _bounded_secs_ok rejects.
_bounded_mul() { awk -v s="$1" -v f="$2" 'BEGIN { r = sprintf("%.6f", s * f); sub(/0+$/, "", r); sub(/\.$/, "", r); print r }'; }
BOUNDED_SH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
BOUNDED_EXEC="$(dirname "$BOUNDED_SH")/bounded_exec.py"
BOUNDED_DIR="$(mktemp -d "${BOUNDED_PARENT:-${TMPDIR:-/tmp}}/bounded.XXXXXX")"
BOUNDED_OUTCOME_FILE="$BOUNDED_DIR/outcome"
BOUNDED_LOG="$BOUNDED_DIR/log"
# The watchdog form appends to its caller's log, handed over explicitly on its command line.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  # A standalone watchdog removes its state however it ends.
  trap 'rm -rf "$BOUNDED_DIR"' EXIT
  [ -z "${BOUNDED_WATCHDOG_LOG:-}" ] || BOUNDED_LOG="$BOUNDED_WATCHDOG_LOG"
fi
: >> "$BOUNDED_LOG"
BOUNDED_HAVE_WATCHDOG=1
if ! command -v python3 >/dev/null 2>&1; then
  BOUNDED_HAVE_WATCHDOG=0
  [ "${BASH_SOURCE[0]}" = "$0" ] || echo "  warn python3 not found — commands run without a hang watchdog" >&2
fi

bounded_is_incomplete() {
  [ "$1" = 124 ] && [ "$(cat "$BOUNDED_OUTCOME_FILE" 2>/dev/null)" = incomplete ]
}

bounded_run() {
  local stdin_file="" retry="" secs="" rc tries=0 budget tmp outcome
  while [ $# -gt 0 ]; do
    case "$1" in
      -i) stdin_file="$2"; shift 2 ;;
      -r) retry="$2"; shift 2 ;;
      --) shift; break ;;
      *) if [ -z "$secs" ]; then secs="$1"; shift; else break; fi ;;
    esac
  done
  [ -n "$secs" ] && [ $# -gt 0 ] || { echo "bounded_run: usage: bounded_run [-i FILE] [-r SECS] SECS -- CMD..." >&2; return 2; }
  [ -n "$retry" ] || retry="$(_bounded_mul "$secs" "$BOUNDED_RETRY_FACTOR")"
  if ! _bounded_secs_ok "$secs" || ! _bounded_secs_ok "$retry"; then
    echo "bounded_run: budgets must be positive numbers of seconds (got $secs, retry $retry)" >&2; return 2
  fi
  echo done > "$BOUNDED_OUTCOME_FILE"
  if [ "$BOUNDED_HAVE_WATCHDOG" != 1 ]; then
    if [ -n "$stdin_file" ]; then "$@" < "$stdin_file"; else "$@"; fi
    return $?
  fi
  tmp="$(mktemp -d "$BOUNDED_DIR/run.XXXXXX")"
  budget="$secs"
  while :; do
    tries=$((tries + 1))
    rm -f "$tmp/status"
    if [ -n "$stdin_file" ]; then
      python3 -I "$BOUNDED_EXEC" --timeout "$budget" --kill-after "${BOUNDED_KILL_AFTER:-10}" --status "$tmp/status" -- "$@" < "$stdin_file" > "$tmp/out" 2> "$tmp/err"
    else
      python3 -I "$BOUNDED_EXEC" --timeout "$budget" --kill-after "${BOUNDED_KILL_AFTER:-10}" --status "$tmp/status" -- "$@" > "$tmp/out" 2> "$tmp/err"
    fi
    outcome="$(cat "$tmp/status" 2>/dev/null)"
    case "$outcome" in
      "exit "*) break ;;
      timeout) [ "$tries" = 1 ] || break; budget="$retry" ;;
      *) outcome=runner-failed; break ;;
    esac
  done
  if [ "$outcome" = timeout ]; then
    echo incomplete > "$BOUNDED_OUTCOME_FILE"
    echo "incomplete ${secs}s+${retry}s $*" >> "$BOUNDED_LOG"
    rc=124
  elif [ "$outcome" = runner-failed ]; then
    # The runner reported nothing (it failed or was cancelled): no observation, so the run is
    # incomplete exactly as a double timeout is (status 124, bounded_is_incomplete true).
    echo "bounded_run: the runner reported no outcome for: $*" >&2
    echo incomplete > "$BOUNDED_OUTCOME_FILE"
    echo "runner-failed ${secs}s $*" >> "$BOUNDED_LOG"
    rc=124
  else
    cat "$tmp/out"; cat "$tmp/err" >&2
    rc="${outcome#exit }"
    [ "$tries" = 2 ] && echo "recovered ${secs}s $*" >> "$BOUNDED_LOG"
  fi
  rm -rf "$tmp"
  return "$rc"
}

bounded_summary() {
  local nrec ninc
  nrec=$(grep -c '^recovered' "$BOUNDED_LOG" 2>/dev/null || true); nrec=${nrec:-0}
  ninc=$(grep -c '^incomplete\|^runner-failed' "$BOUNDED_LOG" 2>/dev/null || true); ninc=${ninc:-0}
  [ "$nrec" -gt 0 ] || [ "$ninc" -gt 0 ] || return 0
  echo "Bounded runs: $nrec recovered (timed out, then completed alone), $ninc incomplete (timed out twice, or the runner failed):"
  sed 's/^/  /' "$BOUNDED_LOG"
}

bounded_watchdog() {
  if [ "$BOUNDED_HAVE_WATCHDOG" = 1 ]; then
    TO=(env "BOUNDED_WATCHDOG_LOG=$BOUNDED_LOG" "BOUNDED_PARENT=$BOUNDED_DIR" bash "$BOUNDED_SH" "$1")
  else
    TO=(env)  # no python3: run commands directly (the gate warned once when it sourced this file)
  fi
}

bounded_gate_status() {
  local ninc
  bounded_summary
  ninc=$(grep -c '^incomplete\|^runner-failed' "$BOUNDED_LOG" 2>/dev/null || true); ninc=${ninc:-0}
  [ "$ninc" -eq 0 ] || echo "INCOMPLETE: $ninc command(s) timed out twice or lost their runner: this run is incomplete, not passed"
  rm -rf "$BOUNDED_DIR"
  [ "$ninc" -eq 0 ]
}

# Watchdog form: `bash bounded.sh SECS CMD...` (through bounded_watchdog's TO array).
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  [ $# -ge 2 ] || { echo "usage: bash $0 SECS CMD [ARGS...]" >&2; exit 2; }
  secs="$1"; shift
  bounded_run "$secs" -- "$@"; rc=$?
  if bounded_is_incomplete "$rc"; then
    echo "INCOMPLETE: timed out twice (${secs}s, then $(_bounded_mul "$secs" "$BOUNDED_RETRY_FACTOR")s alone) or lost its runner: $*" >&2
  fi
  exit "$rc"
fi

exec
/bin/bash -lc "git diff --stat; rg '"'^diff|''^@@'"' DELTA.diff; nl -ba scripts/checks/slice0_artifacts.sh | head -145; cat scripts/checks/lib/stack_measure.py" in /tmp/claude-30035/-home-unbalancedparen-projects-concrete2/e2c54e65-31b5-4145-8101-c2d7b071b97e/scratchpad/owner-review1
