+refuse_tp() { # refuse_tp NAME BODY: a beyond-reach thread-pointer operand gets the reach refusal
+  local f rc=0
+  f=$(ctl_dis "$1" <<<"$(printf "\n0000000000001010 <main>:\n$2")")
