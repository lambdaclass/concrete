# The memory addresses one instruction accesses, for the run checks (stack_measure.py under gdb,
# stack_measure_lldb.py under LLDB; README gate 12). PROVISIONAL. Plain Python 3.9 (Apple's LLDB
# runs its own), no imports beyond re.
#
# The run check counts the lowest byte each stepped instruction of the Concrete-owned code
# addresses, not only the stack pointer: code may use the target's red zone, below the stack
# pointer, without moving it (stack_bound.py counts the same bytes). An access's lowest byte is its
# effective address, whatever its size, so only the address is computed. Fail closed: an operand
# this module cannot evaluate is an error, never "no access".
import re

MASK = (1 << 64) - 1
NUM = re.compile(r"(?:0x[0-9a-f]+|\d+)$")
# Register names an address may use. Anything else is refused before it reaches the debugger (gdb
# reads `$name` as a convenience variable when it is not a register).
X86_REG = re.compile(r"(?:r(?:[abcd]x|[sd]i|[sb]p|(?:[89]|1[0-5])[dwb]?)|e(?:[abcd]x|[sd]i|[sb]p)|r?ip)$")
A64_REG = re.compile(r"(?:[xw](?:[12]?\d|30)|sp|fp|lr)$")


def _reg(reg, name, pattern):
    if not pattern.match(name):
        raise ValueError(f"unmodelled register {name!r} in an address")
    return reg(name)


def _num(text):
    return int(text, 0)


def x86_addresses(asm, reg, next_pc):
    """Effective addresses of the memory operands of one instruction in gdb's Intel syntax
    (`mov QWORD PTR [rsp-0x80],0x0`). reg(name) reads a register or segment base. lea and nop
    compute an address without accessing it; fs:/gs: operands include that segment's base."""
    asm = asm.split("#", 1)[0].strip().lower()
    mn = asm.split(None, 1)[0] if asm else ""
    if mn == "lea" or mn.startswith("nop") or mn.startswith("prefetch"):
        return []
    out = []
    for m in re.finditer(r"(?:(\w\w):)?\[([^\]]*)\]", asm):
        inner = m.group(2).replace(" ", "")
        if not inner or inner[0] not in "+-":
            inner = "+" + inner
        terms = re.findall(r"([+-])([^+-]+)", inner)
        if "".join(s + t for s, t in terms) != inner:
            raise ValueError(f"unparsed memory operand [{m.group(2)}] in {asm}")
        segment = m.group(1)
        addr = reg(segment + "_base") if segment in ("fs", "gs") else 0
        for sign, term in terms:
            if "*" in term:
                a, b = term.split("*", 1)
                r, scale = (b, a) if NUM.match(a) else (a, b)
                if not NUM.match(scale) or _num(scale) not in (1, 2, 4, 8):
                    raise ValueError(f"unparsed scaled index {term} in {asm}")
                v = _reg(reg, r, X86_REG) * _num(scale)
            elif NUM.match(term):
                v = _num(term)
            elif term == "rip":
                v = next_pc
            else:
                v = _reg(reg, term, X86_REG)
            addr += v if sign == "+" else -v
        out.append(addr & MASK)
    if not out and re.match(r"(?:rep\w*\s+)?(?:movs|stos|lods|cmps|scas)[bwdq]?(?:\s|$)", asm):
        raise ValueError(f"string instruction with implicit memory operands: {asm}")
    return out


def _a64_index(text, reg):
    """Value of an AArch64 index operand: `x9`, `x9, lsl #3`, `w9, sxtw #2`, `w9, uxtw`."""
    parts = [p.strip() for p in text.split(",")]
    r = parts[0]
    v = _reg(reg, "x" + r[1:], A64_REG) if r.startswith("w") else _reg(reg, r, A64_REG)
    if r.startswith("w"):
        v &= 0xFFFFFFFF
    shift = 0
    if len(parts) > 1:
        m = re.fullmatch(r"(lsl|sxtw|uxtw|sxtx|uxtx)(?:\s+#(\d+))?", parts[1])
        if not m:
            raise ValueError(f"unparsed index extension {parts[1]}")
        if m.group(1) == "sxtw" and v & 0x80000000:
            v -= 1 << 32
        shift = int(m.group(2) or 0)
    if len(parts) > 2:
        raise ValueError(f"unparsed index {text}")
    return v << shift


def a64_addresses(mnemonic, operands, reg):
    """Effective addresses of one AArch64 instruction in LLDB's syntax (`stp x29, x30, [sp,
    #-0x10]!`, `ldr x30, [sp], #0x10`, `ldr w8, [x9, x10, lsl #2]`). A post-indexed access is at the
    base; a pre-indexed or offset one at base plus offset. prfm/prfum only hint. Use
    a64_new_sp for the stack pointer a pre-indexed access is judged against."""
    mn, ops = mnemonic.lower(), operands.lower().split("//", 1)[0]
    if mn.startswith("prf"):
        return []
    m = re.search(r"\[([^\]]*)\](!?)", ops)
    if not m:
        return []
    parts = [p.strip() for p in m.group(1).split(",", 1)]
    base = _reg(reg, parts[0], A64_REG)
    post = ops[m.end():].strip()
    if post:
        if not re.fullmatch(r",\s*(#-?(0x[0-9a-f]+|\d+)|x\d+)", post) or len(parts) > 1:
            raise ValueError(f"unparsed post-index in {mn} {operands}")
        return [base & MASK]
    if len(parts) == 1:
        return [base & MASK]
    off = parts[1]
    if off.startswith("#"):
        return [(base + _num(off[1:])) & MASK]
    return [(base + _a64_index(off, reg)) & MASK]


def a64_new_sp(mnemonic, operands, reg, sp):
    """The stack pointer an access of this instruction is judged against: the written-back one for
    a pre-indexed sp access (`stp x29, x30, [sp, #-0x90]!` allocates the frame first, then stores
    at the new sp, as stack_bound.py treats it), else `sp`."""
    ops = operands.lower().split("//", 1)[0]
    m = re.search(r"\[\s*sp\s*(?:,\s*#(-?(?:0x[0-9a-f]+|\d+)))?\s*\]!", ops)
    if not m or mnemonic.lower().startswith("prf"):
        return sp
    return min(sp, (sp + _num(m.group(1) or "0")) & MASK)


def lowest_stack(addresses, sp, sp0, red_zone, span):
    """The lowest of `addresses` that lies on the stack below main's entry stack pointer sp0
    (within `span` bytes of it; the analysis' premise puts the image farther away), or None. An
    access deeper than the red zone below `sp` is an error: no bound holds for bytes a signal
    handler may overwrite. `sp` is the lower of the stack pointer before and after the access (a
    pre-indexed access is at the new one; a64_new_sp)."""
    low = None
    for a in addresses:
        if sp0 - span <= a < sp0:
            if a < sp - red_zone:
                raise ValueError(f"an access {sp - a} bytes below the stack pointer, beyond the "
                                 f"{red_zone}-byte red zone")
            low = a if low is None else min(low, a)
    return low
# gdb -batch -nx -x stack_measure.py EXE (README gate 12, x86-64 Linux). PROVISIONAL.
#
# Measures the stack depth one complete run of EXE reaches, below the stack pointer at `main`'s
# entry: the lowest of the stack pointer and every stack byte an instruction addresses (so the red
# zone, used below the stack pointer without moving it; lib/stack_access.py), by single-stepping
# every instruction of the Concrete-owned functions (STACK_RANGES:
# "LO:HI,..." in the executable's link-time addresses, from stack_bound.py --ranges; STACK_MAIN:
# main's LO). An external function (entered through a call, so its return address is at the stack
# pointer) runs at full speed to that return address; its own use is outside the bound, as in
# stack_bound.py, but the depth at its entry is measured. Once main has returned, the rest runs
# freely.
#
# Fail closed: the measurement counts only for a run that stopped first at main's runtime address,
# stopped after each external call exactly at its return address (or exited inside it), received
# no signal, exited normally with status STACK_EXPECT, and addressed no stack byte deeper than the
# target's red zone (STACK_RED_ZONE, from stack_bound.py) below the stack pointer. Prints `measured N` and `steps N`, or
# `error ...` (the gate fails on anything but a measurement).
import os
import sys

import gdb

sys.path.insert(0, os.environ["STACK_LIB"])
import stack_access  # noqa: E402 - the path is the gate's lib directory

LIMIT = 2_000_000
ranges = [tuple(int(x, 16) for x in r.split(":")) for r in os.environ["STACK_RANGES"].split(",")]
main_lo = int(os.environ["STACK_MAIN"], 16)
expect = int(os.environ["STACK_EXPECT"])
red_zone = int(os.environ["STACK_RED_ZONE"])
SPAN = 8 << 20  # stack bytes counted below main's entry (stack_access.lowest_stack)
state = {"exit": None, "signal": None}


def on_exit(event):
    state["exit"] = event.exit_code if hasattr(event, "exit_code") else "unknown"


def on_stop(event):
    if isinstance(event, gdb.SignalEvent):
        state["signal"] = event.stop_signal


gdb.events.exited.connect(on_exit)
gdb.events.stop.connect(on_stop)
gdb.execute("set pagination off")
gdb.execute("set confirm off")
gdb.execute("set disable-randomization on")
gdb.execute("set disassembly-flavor intel")


def reg(name):
    return int(gdb.parse_and_eval(f"(unsigned long) ${name}"))


def live():
    if state["signal"] is not None:
        raise RuntimeError(f"signal {state['signal']}")
    return state["exit"] is None


try:
    gdb.execute("break *main", to_string=True)
    gdb.execute("run </dev/null >/dev/null 2>/dev/null", to_string=True)
    if not live():
        raise RuntimeError("exited before main")
    main_rt = int(gdb.parse_and_eval("(unsigned long) &main"))
    if reg("pc") != main_rt:
        raise RuntimeError(f"first stop at {reg('pc'):#x}, not main ({main_rt:#x})")
    offset = main_rt - main_lo
    sp0 = reg("sp")
    low, steps = sp0, 0
    inferior = gdb.selected_inferior()
    arch = gdb.selected_frame().architecture()
    gdb.execute("delete", to_string=True)
    while live():
        pc, sp = reg("pc"), reg("sp")
        if sp > sp0:  # main has returned
            gdb.execute("continue", to_string=True)
            continue
        low = min(low, sp)
        if any(lo + offset <= pc <= hi + offset for lo, hi in ranges):
            insn = arch.disassemble(pc)[0]
            try:
                touched = stack_access.lowest_stack(
                    stack_access.x86_addresses(insn["asm"], reg, pc + insn["length"]),
                    sp, sp0, red_zone, SPAN)
            except ValueError as e:
                raise RuntimeError(f"at {pc:#x} ({insn['asm']}): {e}") from None
            if touched is not None:
                low = min(low, touched)
            gdb.execute("stepi", to_string=True)
            steps += 1
            if steps > LIMIT:
                raise RuntimeError(f"more than {LIMIT} steps")
        else:
            ret = int.from_bytes(inferior.read_memory(sp, 8).tobytes(), "little")
            if not any(lo + offset <= ret <= hi + offset for lo, hi in ranges):
                raise RuntimeError(f"external code at {pc:#x} returns to {ret:#x}, outside the owned code")
            gdb.execute(f"tbreak *{ret:#x}", to_string=True)
            gdb.execute("continue", to_string=True)
            if live() and reg("pc") != ret:
                raise RuntimeError(f"stopped at {reg('pc'):#x}, not the return address {ret:#x}")
    if state["exit"] != expect:
        raise RuntimeError(f"exit status {state['exit']}, expected {expect}")
    if steps == 0:
        raise RuntimeError("no instruction stepped")
    print(f"measured {sp0 - low}")
    print(f"steps {steps}")
except Exception as e:  # noqa: BLE001 - every failure is reported, the gate fails closed
    print(f"error {e}")
# lldb --batch -o 'command script import stack_measure_lldb.py' (README gate 12, aarch64-macos).
# PROVISIONAL.
#
# The LLDB counterpart of stack_measure.py (same contract, same environment: STACK_EXE, the
# executable; STACK_RANGES "LO:HI,..." in link-time addresses, from stack_bound.py --ranges;
# STACK_MAIN, main's LO; STACK_EXPECT, the expected exit status; STACK_RED_ZONE; STACK_LIB, the
# directory of stack_access.py). It measures the stack depth one complete run reaches, below the
# stack pointer at `main`'s entry: the lowest of the stack pointer and every stack byte an
# instruction addresses (so the red zone), by single-stepping every instruction of the
# Concrete-owned functions. An external function (entered by `bl`, so its
# return address is in the link register) runs at full speed to that return address; its own use
# is outside the bound, as in stack_bound.py, but the depth at its entry is measured. Once main has
# returned, the rest runs freely.
#
# Fail closed: the measurement counts only for a run that stopped first at main's runtime address,
# stopped after each external call exactly at its return address (or exited inside it), received
# no signal, exited normally with status STACK_EXPECT, and addressed no stack byte deeper than the
# red zone below the stack pointer. Prints `measured N` and `steps N`, or
# `error ...` (the gate fails on anything but a measurement).
import os
import sys

import lldb

sys.path.insert(0, os.environ["STACK_LIB"])
import stack_access  # noqa: E402 - the path is the gate's lib directory

LIMIT = 2_000_000
SPAN = 8 << 20  # stack bytes counted below main's entry (stack_access.lowest_stack)


def measure(debugger):
    exe = os.environ["STACK_EXE"]
    ranges = [tuple(int(x, 16) for x in r.split(":")) for r in os.environ["STACK_RANGES"].split(",")]
    main_lo = int(os.environ["STACK_MAIN"], 16)
    expect = int(os.environ["STACK_EXPECT"])
    debugger.SetAsync(False)
    target = debugger.CreateTarget(exe)
    if not target.IsValid():
        raise RuntimeError(f"cannot load {exe}")
    # Break at main's exact first instruction (a name breakpoint would skip its prologue, after
    # the frame is allocated, and misplace both sp0 and the slide).
    syms = [c.GetSymbol() for c in target.FindSymbols("main") if c.GetSymbol().IsValid()]
    syms = [s for s in syms if s.GetType() == lldb.eSymbolTypeCode]
    if len(syms) != 1:
        raise RuntimeError(f"{len(syms)} code symbols named main")
    entry = syms[0].GetStartAddress()
    bp = target.BreakpointCreateBySBAddress(entry)
    if bp.GetNumLocations() != 1:
        raise RuntimeError(f"main has {bp.GetNumLocations()} breakpoint locations")
    info = lldb.SBLaunchInfo([])
    info.SetLaunchFlags(lldb.eLaunchFlagDisableASLR)
    for fd, flags in ((0, os.O_RDONLY), (1, os.O_WRONLY), (2, os.O_WRONLY)):
        info.AddOpenFileAction(fd, "/dev/null", flags == os.O_RDONLY, flags != os.O_RDONLY)
    err = lldb.SBError()
    process = target.Launch(info, err)
    if not err.Success() or not process.IsValid():
        raise RuntimeError(f"launch failed: {err}")
    try:
        # Load addresses exist only once the process is loaded.
        main_rt = entry.GetLoadAddress(target)
        if main_rt == lldb.LLDB_INVALID_ADDRESS:
            raise RuntimeError("main has no load address")
        return run(process, target, bp, ranges, main_lo, main_rt, expect)
    finally:
        if process.GetState() not in (lldb.eStateExited, lldb.eStateDetached, lldb.eStateInvalid):
            process.Kill()


def check_live(process):
    """True while the process is stopped (not exited); raises on a signal or another stop."""
    state = process.GetState()
    if state == lldb.eStateExited:
        return False
    if state != lldb.eStateStopped:
        raise RuntimeError(f"unexpected process state {state}")
    thread = process.GetSelectedThread()
    if thread.GetStopReason() not in (lldb.eStopReasonBreakpoint, lldb.eStopReasonPlanComplete,
                                      lldb.eStopReasonTrace):
        raise RuntimeError(f"unexpected stop ({thread.GetStopReason()}): {thread.GetStopDescription(200)}")
    return True


def register(frame, name):
    """A general register's value (`sp`, `x0`..`x30`, `fp`, `lr`); unknown names fail closed."""
    v = frame.FindRegister(name)
    if not v.IsValid() and name in ("x29", "x30"):
        v = frame.FindRegister({"x29": "fp", "x30": "lr"}[name])
    if not v.IsValid():
        raise ValueError(f"no register {name}")
    return v.GetValueAsUnsigned()


def run(process, target, bp, ranges, main_lo, main_rt, expect):
    red_zone = int(os.environ["STACK_RED_ZONE"])
    if not check_live(process):
        raise RuntimeError("exited before main")
    thread = process.GetSelectedThread()
    frame = thread.GetFrameAtIndex(0)
    if frame.GetPC() != main_rt:
        raise RuntimeError(f"first stop at {frame.GetPC():#x}, not main ({main_rt:#x})")
    target.BreakpointDelete(bp.GetID())
    offset = main_rt - main_lo
    sp0 = frame.GetSP()
    # main's own return address: `bl` leaves it in the link register and the stack pointer unchanged,
    # so main has returned when the pc reaches it with the stack pointer back at its entry value.
    caller = frame.FindRegister("lr").GetValueAsUnsigned()
    low, steps, returned = sp0, 0, False

    def owned(pc):
        return any(lo + offset <= pc <= hi + offset for lo, hi in ranges)

    while check_live(process):
        thread = process.GetSelectedThread()
        frame = thread.GetFrameAtIndex(0)
        pc, sp = frame.GetPC(), frame.GetSP()
        if returned or sp > sp0 or (pc == caller and sp == sp0):  # main has returned
            returned = True
            process.Continue()
            continue
        low = min(low, sp)
        if owned(pc):
            insn = target.ReadInstructions(lldb.SBAddress(pc, target), 1).GetInstructionAtIndex(0)
            mn, ops = insn.GetMnemonic(target), insn.GetOperands(target)
            try:
                read = lambda r: register(frame, r)  # noqa: E731
                touched = stack_access.lowest_stack(
                    stack_access.a64_addresses(mn, ops, read),
                    stack_access.a64_new_sp(mn, ops, read, sp), sp0, red_zone, SPAN)
            except ValueError as e:
                raise RuntimeError(f"at {pc:#x} ({mn} {ops}): {e}") from None
            if touched is not None:
                low = min(low, touched)
            thread.StepInstruction(False)
            steps += 1
            if steps > LIMIT:
                raise RuntimeError(f"more than {LIMIT} steps")
        else:
            ret = frame.FindRegister("lr").GetValueAsUnsigned()
            if not owned(ret):
                raise RuntimeError(f"external code at {pc:#x} returns to {ret:#x}, outside the owned code")
            tb = target.BreakpointCreateByAddress(ret)
            tb.SetOneShot(True)
            process.Continue()
            if check_live(process) and process.GetSelectedThread().GetFrameAtIndex(0).GetPC() != ret:
                raise RuntimeError(f"stopped at {process.GetSelectedThread().GetFrameAtIndex(0).GetPC():#x}, "
                                   f"not the return address {ret:#x}")
            target.BreakpointDelete(tb.GetID())
    status = process.GetExitStatus()
    if status != expect:
        raise RuntimeError(f"exit status {status}, expected {expect}")
    if steps == 0:
        raise RuntimeError("no instruction stepped")
    return sp0 - low, steps


def __lldb_init_module(debugger, _dict):
    try:
        measured, steps = measure(debugger)
        print(f"measured {measured}")
        print(f"steps {steps}")
    except Exception as e:  # noqa: BLE001 - every failure is reported, the gate fails closed
        print(f"error {e}")
#!/usr/bin/env python3
"""Stack bound of a slice-0 executable, from its disassembly (README gate 12). PROVISIONAL.

usage: stack_bound.py TARGET DISASM           -> prints `bound N` and one `external SYM DEPTH` per call
       stack_bound.py TARGET DISASM --ranges  -> also prints `redzone N` (the target's) and
                                                `range SYM LO HI` per Concrete function
TARGET is a key of TARGETS (x86_64-linux, aarch64-macos, aarch64-linux); DISASM is `llvm-objdump -d --no-show-raw-insn` output of the LINKED
executable (x86-64 in Intel syntax).

The Concrete-owned code is `main` (the runtime entry), `concrete_rt_write_all` and the body
(`concrete_body`), with or without the Mach-O underscore. Each owned function is analysed over its
control-flow graph, from its entry, as a dataflow fixpoint over an abstract state (St): the stack
pointer's depth below the entry stack pointer, the frame pointer's value, the saved slots and the
link register (equal on every path into an instruction), and the stack bytes the function has
written (the intersection over those paths). A byte at depth n lies n bytes below the entry stack
pointer.

The bound is the deepest byte the function's stack pointer reaches or any of its instructions
addresses through the stack or frame pointer (so the red zone, used below the stack pointer without
moving it, is covered), with each owned callee's own bound added at its call, and each external
function (libc's `write`, `_exit`, `abort`) counted at its entry depth.

Why addresses cannot escape this accounting: memory is addressed only through the stack or frame
pointer (accounted), PC-relatively within a fixed reach of the code (x86 `rip` with a displacement
up to PC_REACH; on AArch64 a register holding an adrp/adr result within PC_REACH, plus at most one
add immediate, on every path since the last call, with a bounded offset and no writeback) or
through an x86 thread-pointer segment with an absolute displacement of at most TP_REACH in
magnitude. Any other register may hold a stack address (main's argv and envp, a value an external
function left), so no access goes through one. The analysis also refuses taking a stack address as
a value (`lea` of one, the stack or frame pointer copied, stored or used in arithmetic, except the
modelled frame setup), so only the frame save (`push rbp`, `stp x29, x30`) puts one in memory.
Saved slots may be read only by the modelled restore (`pop rbp`, `leave`, `ldp x29, x30` with base
sp). Any other stack read must be of bytes the function itself wrote, on every path, since its last
call: so no stale value (a callee's or the caller's saved frame pointer, libc's scratch) is ever
loaded. Accesses must lie below the entry stack pointer (never the return address or the caller's
frame) and at most the target's red zone below the current stack pointer (TARGETS: 128 bytes on
x86-64 System V and on Apple arm64, none under AAPCS64 on Linux; deeper bytes may be overwritten
asynchronously, by a signal handler, so code using them has no bound), returns must be at depth 0
with the caller's frame pointer restored and, on AArch64, with the link register holding the return
address.

The premises (outside the bound, listed in the gate's report): the stack lies farther than
PC_REACH + 4095 + A64_OFF_REACH bytes from the image's code, and farther than TP_REACH bytes from
each x86 thread-pointer base (fs and gs), in both directions; the external functions' own stack
use; that `_exit` and `abort` do not return (a path ends at a call to one); that external functions
follow the ABI's callee-saved rule (the frame pointer and stack pointer preserved).

Fail closed: an instruction outside the modelled set (X86_PLAIN, A64_PLAIN and the control
transfers), any of the refusals above, an unmodelled stack-pointer write, an indirect branch, call
or return, a branch leaving its function, two different states meeting, recursion, or a call to a
function that is neither Concrete-owned nor a PLT/stub symbol is an error (exit 1), never a bound.
"""
import re
import sys

OWNED = ("main", "concrete_body", "concrete_rt_write_all")
# External functions that do not return (part of the libc premise): a path ends at a call to one.
NORETURN = ("exit", "_exit", "_Exit", "abort")
ENTRY = "entry"


class Refuse(Exception):
    pass


def owned_name(sym):
    s = sym[1:] if sym.startswith("_") and sym[1:] in OWNED else sym
    return s if s in OWNED else None


def parse(path):
    """Functions: name -> list of (addr, mnemonic, operands). Also the stubs: ELF PLT symbol names
    (`write@plt`), and Mach-O stub entries, address -> imported symbol, from `stub ADDR SYMBOL`
    lines the gate appends (from `llvm-objdump --macho --indirect-symbols`, since the Mach-O
    disassembly names only the whole `__stubs` section)."""
    funcs, cur, stubs, section = {}, None, {"names": set(), "addrs": {}}, ""
    head = re.compile(r"^([0-9a-f]+) <([^>]+)>:$")
    inst = re.compile(r"^\s*([0-9a-f]+):\s*(\S+)\s*(.*)$")
    stub = re.compile(r"^stub 0x([0-9a-f]+) (\S+)$")
    for line in open(path, encoding="utf-8", errors="replace"):
        line = line.rstrip("\n")
        m = stub.match(line)
        if m:
            addr = int(m.group(1), 16)
            if addr in stubs["addrs"]:
                raise Refuse(f"two stub entries at {addr:#x}")
            stubs["addrs"][addr] = m.group(2)
            cur = None
            continue
        if line.startswith("Disassembly of section"):
            section = line.split()[-1].rstrip(":").split(",")[-1]
            cur = None
            continue
        m = head.match(line)
        if m:
            name = m.group(2)
            if section in (".plt", ".plt.sec", ".plt.got", "__stubs") or name.endswith("@plt"):
                # Stub code is never analysed. Only an ELF PLT entry's name (`write@plt`) makes a
                # call external; a Mach-O stub needs an exact `stub` address entry.
                if name.endswith("@plt"):
                    stubs["names"].add(name)
                cur = None
            else:
                cur = name
                funcs.setdefault(name, [])
            continue
        m = inst.match(line)
        if m and cur is not None:
            ops = m.group(3).split("#", 1)[0] if ARCH == "x86_64" else m.group(3).split("//")[0]
            funcs[cur].append((int(m.group(1), 16), m.group(2).lower(), ops.strip()))
    return funcs, stubs


def target_of(ops):
    m = re.search(r"0x([0-9a-f]+)\s*<([^>]+)>", ops) or re.search(r"\b([0-9a-f]+)\s*<([^>]+)>", ops)
    return (int(m.group(1), 16), m.group(2)) if m else (None, None)


def imm(s):
    t = s.strip().lstrip("#")
    try:
        return int(t, 16) if t.lower().startswith(("0x", "-0x")) else int(t)
    except ValueError:
        raise Refuse(f"not an immediate: {s}") from None


class St:
    """`d`: the stack pointer's depth. `fp`: the frame pointer's value: a depth (int), ENTRY (the
    caller's, which every return must restore) or None (unknown). `saved`: slots holding a saved
    frame pointer or link register, (lowest, highest, tag) in byte depths, tag ("fp", value) or
    ("lr", whether it is this function's return address); kept after the stack pointer moves past
    them and after a restore (memory keeps them) until an exact overwrite. `lr`: whether the
    AArch64 link register holds this function's return address on every path (not part of the
    key; joins take the conjunction). `w`: the stack bytes this
    function has written since its last call, on every path (not part of the equality key). `g`
    (AArch64): the registers holding a PC-relative address (adrp/adr, plus an immediate), on every
    path since the last call (not part of the key): the only registers memory may be addressed
    through besides the stack and frame pointers."""

    __slots__ = ("d", "fp", "saved", "lr", "w", "g")

    def __init__(self, d=0, fp=ENTRY, saved=frozenset(), lr=True, w=frozenset(), g=frozenset()):
        self.d, self.fp, self.saved, self.lr, self.w, self.g = d, fp, saved, lr, w, g

    def key(self):
        return (self.d, self.fp, self.saved)

    def but(self, **kw):
        s = St(self.d, self.fp, self.saved, self.lr, self.w, self.g)
        for k, v in kw.items():
            setattr(s, k, v)
        return s


def frame_depth(fp, what):
    """The frame pointer as a depth, for addressing; refused unless it is this frame's."""
    if not isinstance(fp, int):
        raise Refuse(f"frame-relative use of a frame pointer that is not this frame's: {what}")
    return fp


def slot_at(saved, lo, hi):
    return next((x for x in saved if x[:2] == (lo, hi)), None)


def touch(st, lo, hi, mode, what, restore=()):
    """Check an access of the bytes [lo, hi] (depths) in `mode` ("r", "w" or "rw") and return the
    new written set. The bytes must be the function's own (depth >= 1). A saved slot may be read
    only by a restore (`restore`: the slots being restored), and written only by an exact
    overwrite (which clears it; the caller removes it from `saved`). A read needs every byte
    written by this function on every path since its last call."""
    if lo < 1:
        raise Refuse(f"touches the return address or the caller's frame: {what}")
    for slot in st.saved:
        if slot[0] <= hi and lo <= slot[1] and slot not in restore:
            exact = (slot[0], slot[1]) == (lo, hi) or (lo <= slot[0] and slot[1] <= hi and mode == "w")
            if "r" in mode or not exact:
                raise Refuse(f"touches a saved frame pointer or link register: {what}")
    if "r" in mode and not all(b in st.w for b in range(lo, hi + 1)):
        raise Refuse(f"reads stack bytes this function has not written: {what}")
    return st.w | frozenset(range(lo, hi + 1)) if "w" in mode else st.w


def cleared(saved, lo, hi):
    """`saved` without the slots a write of [lo, hi] overwrote."""
    return frozenset(x for x in saved if not (lo <= x[0] and x[1] <= hi))


X86_SP = ("rsp", "esp", "sp", "spl")
X86_FP = ("rbp", "ebp", "bp", "bpl")
X86_STACK = X86_SP + X86_FP
X86_GPR64 = re.compile(r"^(r[abcd]x|r[sd]i|rbp|r(?:8|9|1[0-5]))$")
X86_SIZE = {"byte": 1, "word": 2, "dword": 4, "qword": 8, "tbyte": 10, "xmmword": 16,
            "ymmword": 32, "zmmword": 64}
MEM = re.compile(r"\[([^\]]*)\]")


# PC-relative addressing reaches at most PC_REACH bytes from the instruction (x86 rip
# displacement; AArch64 adrp/adr target) plus, on AArch64, one add immediate (at most 4095) and
# the access's own offset (at most A64_OFF_REACH): the premise that the stack lies farther than
# that from the image's code makes such an access never a stack access.
PC_REACH = 16 << 20
# No fs/gs operands occurred in the 64 owned-code disassemblies measured on 2026-11-08. This round
# bound also covers the stack-protector canary's fs:0x28 with 216 bytes of margin.
TP_REACH = 0x100
# TARGET -> (architecture, red zone in bytes): how far below the stack pointer code may address
# memory without moving it. x86-64 System V ABI section 3.2.2 (128); Apple, "Writing ARM64 code for
# Apple platforms" (128); AAPCS64 has none (0).
TARGETS = {"x86_64-linux": ("x86_64", 128), "aarch64-macos": ("aarch64", 128),
           "aarch64-linux": ("aarch64", 0)}
A64_OFF_REACH = 32760


def x86_inst(mn, ops, st, addr=0):
    """(new state, deepest byte touched or None) after a non-control x86 instruction."""
    what = f"{mn} {ops}"
    args = [a.strip() for a in ops.split(",")] if ops else []
    dst = args[0] if args else ""
    deepest, w, saved = None, st.w, st.saved
    for m in MEM.finditer(ops):
        terms = re.findall(r"[+-]?\s*[^+\-\s]+", m.group(1))
        regs = [t.strip(" +-") for t in terms if not re.fullmatch(r"[+-]?\s*(0x[0-9a-f]+|\d+)", t)]
        base = [r for r in regs if r in X86_STACK]
        if not base:
            # Any other register may hold a stack address (main's argv and envp, a value an
            # external function left), so memory is addressed only PC-relative or through a bounded
            # absolute thread-pointer displacement.
            k = sum(int(t.replace(" ", ""), 0) for t in terms if t.strip(" +-") not in regs)
            segment = re.search(r"\b[fg]s:\s*$", ops[:m.start()])
            if segment:
                if regs:
                    raise Refuse(f"thread-pointer-relative access through a register: {what}")
                if abs(k) > TP_REACH:
                    raise Refuse(f"thread-pointer-relative access beyond the premise's reach: {what}")
            elif regs == ["rip"]:
                if abs(k) > PC_REACH:
                    raise Refuse(f"PC-relative access beyond the premise's reach: {what}")
            else:
                raise Refuse(f"memory addressed through a register that may hold a stack address, "
                             f"or absolutely: {what}")
            continue
        if base[0] not in ("rsp", "rbp"):
            raise Refuse(f"stack address through a partial register: {what}")
        if len(regs) != 1:
            raise Refuse(f"indexed stack address: {what}")
        if mn == "lea":
            raise Refuse(f"stack address taken as a value: {what}")
        size = re.search(r"(\w+) ptr\s*(?:\w+:)?\s*$", ops[:m.start()])
        if not size or size.group(1) not in X86_SIZE:
            raise Refuse(f"stack access of unknown size: {what}")
        k = sum(int(t.replace(" ", ""), 0) for t in terms if t.strip(" +-") not in regs)
        top = (frame_depth(st.fp, what) if base[0] == "rbp" else st.d) - k
        lo = top - X86_SIZE[size.group(1)] + 1
        # The memory operand is the destination when it comes first: written only by mov and
        # setcc, read and written by the others, read only by cmp and test.
        first = ops.lstrip().find("[") < ops.find(",") if "," in ops else True
        if not first or mn in ("cmp", "test"):
            mode = "r"
        elif mn in ("mov", "movabs") or mn.startswith("set"):
            mode = "w"
        else:
            mode = "rw"
        w = touch(st.but(w=w, saved=saved), lo, top, mode, what)
        if "w" in mode:
            saved = cleared(saved, lo, top)
        deepest = top if deepest is None else max(deepest, top)
    st = st.but(w=w, saved=saved)
    outside = MEM.sub("", ops)
    modelled = (mn, ops) in (("push", "rbp"), ("pop", "rbp"), ("mov", "rbp, rsp"),
                             ("mov", "rsp, rbp"), ("leave", "")) or (
        mn in ("sub", "add") and re.fullmatch(r"rsp, (0x[0-9a-f]+|\d+)", ops))
    if not modelled and any(re.search(rf"\b{r}\b", outside) for r in X86_STACK):
        raise Refuse(f"stack or frame pointer used as a value: {what}")
    if mn == "push":
        if not X86_GPR64.match(dst):
            raise Refuse(f"push of other than a 64-bit general register: {what}")
        d = st.d + 8
        w = touch(st, d - 7, d, "w", what)
        saved = cleared(st.saved, d - 7, d)
        if dst == "rbp":
            saved = saved | {(d - 7, d, ("fp", st.fp))}
        return st.but(d=d, saved=saved, w=w), d
    if mn == "pop":
        if not X86_GPR64.match(dst):
            raise Refuse(f"pop of other than a 64-bit general register: {what}")
        return x86_pop(st, dst, st.d, what), None
    if mn == "leave":
        return x86_pop(st, "rbp", frame_depth(st.fp, what), what), None
    if mn in ("sub", "add") and dst == "rsp":
        n = imm(args[1])
        return st.but(d=st.d + n if mn == "sub" else st.d - n), deepest
    if (mn, ops) == ("mov", "rbp, rsp"):
        return st.but(fp=st.d), deepest
    if (mn, ops) == ("mov", "rsp, rbp"):
        return st.but(d=frame_depth(st.fp, what)), deepest
    if dst in X86_SP:
        raise Refuse(f"unmodelled stack-pointer write: {what}")
    if dst in X86_FP:
        return st.but(fp=None), deepest
    return st, deepest


def x86_pop(st, dst, at, what):
    """Pop the 8 bytes whose deepest is at depth `at` into `dst`: a saved frame pointer only into
    rbp, which then holds the saved value again (any other pop into rbp makes it unknown)."""
    slot = slot_at(st.saved, at - 7, at)
    if slot and dst != "rbp":
        raise Refuse(f"a saved frame pointer popped into {dst}: {what}")
    touch(st, at - 7, at, "r", what, restore=(slot,) if slot else ())
    if dst != "rbp":
        return st.but(d=at - 8)
    return st.but(d=at - 8, fp=slot[2][1] if slot and slot[2][0] == "fp" else None)


A64_SP = ("sp", "wsp")
A64_FP = ("x29", "w29")
A64_LR = ("x30", "w30")
A64_REGSIZE = {"x": 8, "w": 4, "q": 16, "d": 8, "s": 4, "h": 2, "b": 1}


def a64_size(mn, data, what):
    if mn in ("ldrb", "strb", "ldrsb", "ldurb", "sturb", "ldursb"):
        return 1
    if mn in ("ldrh", "strh", "ldrsh", "ldurh", "sturh", "ldursh"):
        return 2
    if mn in ("ldrsw", "ldursw", "ldpsw"):
        return 4 * len(data)
    if not data or data[0][0] not in A64_REGSIZE:
        raise Refuse(f"stack access of unknown size: {what}")
    return A64_REGSIZE[data[0][0]] * len(data)


def a64_reg(r):
    """The 64-bit name of a general register (w8 -> x8)."""
    return "x" + r[1:] if re.fullmatch(r"w([0-9]|[12][0-9]|30)", r) else r


A64_FLAGS_ONLY = ("cmp", "cmn", "tst", "ccmp", "ccmn", "nop")


def a64_inst(mn, ops, st, addr=0):
    """(new state, deepest byte touched or None) after a non-control AArch64 instruction, with `g`
    (the PC-relative address registers, as (register, level) pairs) updated: every register the
    instruction writes leaves it; adrp/adr with a target within PC_REACH of the instruction puts
    its destination in at level 0, and one add of an immediate up to 4095 to a level-0 register
    puts its destination in at level 1 (so the address stays within a fixed reach of the code)."""
    new, deepest = a64_core(mn, ops, st)
    args = [a.strip() for a in re.split(r",(?![^\[]*\])", ops)] if ops else []
    first_mem = next((i for i, a in enumerate(args) if a.startswith("[")), len(args))
    if mn.startswith(("ld", "st")):
        written = list(args[:first_mem]) if mn.startswith("ld") else []
        if first_mem < len(args) and (args[first_mem].endswith("!") or first_mem + 1 < len(args)):
            written.append(re.match(r"\[(\w+)", args[first_mem]).group(1))
    else:
        written = [] if mn in A64_FLAGS_ONLY or not args else [args[0]]
    out = {a64_reg(r) for r in written}
    g = {x for x in new.g if x[0] not in out}
    if mn in ("adrp", "adr") and len(args) == 2 and args[0].startswith("x"):
        t = re.fullmatch(r"(0x[0-9a-f]+)(?:\s*<[^>]*>)?", args[1])
        if t and abs(int(t.group(1), 16) - addr) <= PC_REACH:
            g.add((args[0], 0))
    elif (mn == "add" and len(args) == 3 and args[0].startswith("x") and (args[1], 0) in st.g
          and re.fullmatch(r"#(0x[0-9a-f]+|\d+)", args[2]) and imm(args[2]) <= 4095):
        g.add((args[0], 1))
    return new.but(g=frozenset(g)), deepest


def a64_core(mn, ops, st):
    """(new state, deepest byte touched or None) after a non-control AArch64 instruction."""
    what = f"{mn} {ops}"
    args = [a.strip() for a in re.split(r",(?![^\[]*\])", ops)] if ops else []
    first_mem = next((i for i, a in enumerate(args) if a.startswith("[")), len(args))
    data = args[:first_mem]
    is_load, is_store = mn.startswith("ld"), mn.startswith("st")
    deepest = None
    record = restored = single = False
    if first_mem < len(args):
        mem = args[first_mem]
        post = args[first_mem + 1] if first_mem + 1 < len(args) else None
        m = re.fullmatch(r"\[(\w+)(?:,\s*(#?-?(?:0x)?[0-9a-f]+))?\](!?)", mem)
        if not m:
            raise Refuse(f"unmodelled address form: {what}")
        else:
            base, off, pre = m.group(1), m.group(2), m.group(3) == "!"
            if base in A64_FP and (pre or post is not None):
                raise Refuse(f"writeback on the frame pointer: {what}")
            if base in A64_LR and (pre or post is not None):
                raise Refuse(f"writeback on the link register: {what}")
            if base not in ("sp", "x29") + A64_SP + A64_FP:
                # Any other register may hold a stack address (main's argv, envp and apple
                # vector, a value an external function left): only a PC-relative one is used.
                if base not in {x[0] for x in st.g}:
                    raise Refuse(f"memory addressed through a register that may hold a stack address: {what}")
                if pre or post is not None or (off and abs(imm(off)) > A64_OFF_REACH):
                    raise Refuse(f"PC-relative access beyond the premise's reach: {what}")
        if base in ("sp", "x29"):
            record = mn in ("stp", "ldp") and data == ["x29", "x30"] and base == "sp"
            size = a64_size(mn, data, what)
            k = imm(off) if off else 0
            d = st.d
            if base == "x29":
                top = frame_depth(st.fp, what) - k
            elif pre:
                d = d - k
                top = d
            else:
                top = d - k
            if post is not None:
                if base != "sp":
                    raise Refuse(f"unmodelled writeback: {what}")
                top = st.d
                d = d - imm(post)
            lo = top - size + 1
            saved, fp, lr = st.saved, st.fp, st.lr
            if record and is_store:
                # The frame record: x29 at the lower address (the deeper half), x30 above it.
                w = touch(st, lo, top, "w", what)
                saved = cleared(saved, lo, top) | {(lo + 8, lo + 15, ("fp", fp)), (lo, lo + 7, ("lr", lr))}
            elif record:
                fp_slot, lr_slot = slot_at(saved, lo + 8, lo + 15), slot_at(saved, lo, lo + 7)

