• Should read files current in parallel workflow, landing, trust, required, run, train portions, old workflow from git show. Use Read up to enough.name: Slice 0 backends

# PROVISIONAL (ROADMAP B0, Concrete/README.md gates 4, 6, 6a, 8, 9, 10, 11 and 12). The slice-0 backend gate,
# scripts/checks/slice0_backends.sh: every hand-written BIR example through the LLVM path and the
# LCB path, each executable's observation (exit status plus the fd-2 trap line) compared with the
# BIR semantics, plus LCB's own evaluator on the adapted body. It runs natively on x86-64 Linux and
# on AArch64 macOS (GitHub-hosted; LCB's first native proof profile is Apple AArch64), so the LCB
# output is executed on both targets. It joins
# required-checks.txt when the compiler lands on main; until then it runs on the slice-0 branches.

on:
  push:
    branches: ['wip/slice0', 'wip/slice0-*']
  workflow_dispatch:

concurrency:
  group: slice0-${{ github.ref }}
  cancel-in-progress: true

jobs:
  backends:
    name: Slice 0 backends (${{ matrix.arch }})
    strategy:
      fail-fast: false
      matrix:
        include:
          - arch: x86-64
            runner: ubuntu-latest
          - arch: aarch64-macos
            runner: macos-15
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 60
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - name: Install Nix
        uses: cachix/install-nix-action@v31
      - name: Backend gate (LLVM and LCB, native)
        run: nix develop --command bash scripts/checks/slice0_backends.sh

  artifacts:
    name: Slice 0 artifacts (${{ matrix.arch }})
    strategy:
      fail-fast: false
      matrix:
        include:
          - arch: x86-64
            runner: ubuntu-latest
          - arch: aarch64-macos
            runner: macos-15
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 60
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - name: Install Nix
        uses: cachix/install-nix-action@v31
      - name: Sanitizers, binary size (report-only) and stack bound (gates 10, 11, 12)
        run: nix develop --command timeout 3000 bash scripts/checks/slice0_artifacts.sh report
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: artifacts-${{ matrix.arch }}
          path: report
          if-no-files-found: error

  trusted-base:
    name: Slice 0 trusted base (gate 9, ${{ matrix.arch }})
    strategy:
      fail-fast: false
      matrix:
        include:
          - arch: x86-64
            runner: ubuntu-latest
          - arch: aarch64-macos
            runner: macos-15
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 60
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - name: Install Nix
        uses: cachix/install-nix-action@v31
      - name: Trusted-base golden (premises, axioms, toolchain and LCB pin)
        run: nix develop --command timeout 3000 bash scripts/checks/slice0_trusted_base.sh

  reproducibility:
    name: Reproducibility (${{ matrix.id }})
    strategy:
      fail-fast: false
      matrix:
        include:
          - id: linux-first
            runner: ubuntu-24.04
          - id: linux-independent
            runner: ubuntu-24.04
          - id: macos
            runner: macos-15
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 60
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - uses: cachix/install-nix-action@v31
      - name: Compare every stage in distinct build directories
        run: nix develop --command timeout 3600 bash scripts/checks/slice0_repro.sh manifest.txt
      - uses: actions/upload-artifact@v4
        with:
          name: reproducibility-${{ matrix.id }}
          path: manifest.txt
          if-no-files-found: error

  compare-linux:
    name: Cross-machine reproducibility (x86-64 Linux)
    needs: reproducibility
    runs-on: ubuntu-24.04
    permissions:
      contents: read
    steps:
      - uses: actions/download-artifact@v4
        with:
          pattern: reproducibility-linux-*
          path: manifests
      - name: Compare like targets, including compiler and toolchain identity
        run: |
          set -eu
          m1=manifests/reproducibility-linux-first/manifest.txt
          m2=manifests/reproducibility-linux-independent/manifest.txt
          # Both manifests carry the identity and at least one artifact hash.
          for m in "$m1" "$m2"; do grep -q '^compiler_commit=' "$m"; grep -q '/lcb.exe$' "$m"; done
          diff -u "$m1" "$m2"
