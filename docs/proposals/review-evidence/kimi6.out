   local o r
   o="$(bash "$TRAIN" land tm 2>&1)"; r=$?
   [ "$r" = 1 ] && has "$o" "is a legacy/ move candidate" && has "$o" "$2" && [ "$(git ls-remote origin refs/heads/main | cut -f1)" = "$MB" ] \
     && ok "land refuses the move with $1" || { no "land with $1 (exit $r)"; echo "$o" | sed 's/^/      /'; }
