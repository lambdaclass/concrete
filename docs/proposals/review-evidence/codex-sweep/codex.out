#!/usr/bin/env bash
# Markdown-link gate: every local link in the repository's Markdown names a path that exists and,
# into a Markdown file, a heading or explicit id that exists (scripts/checks/lib/doc_links.py holds
# the rules: GitHub slugs, duplicate-heading suffixes, root-relative changelog.d/ fragments).
#
# WHY A GATE AND NOT A MAKE TARGET. The checker used to be a Makefile target only, reached by
# nothing in CI or the pre-push selection, and it checked the path of `file.md#anchor` and dropped
# the anchor. Links to headings renamed or moved to another file passed, and it resolved changelog.d/
# fragments against changelog.d/ although they are folded into the root CHANGELOG.md, so a correct
# fragment link read as broken. Nobody saw either, because nothing ran it (bug 252).
#
# The controls below run the same checker on throwaway trees, so a checker that accepts everything,
# skips anchors, or resolves fragments against the wrong directory fails here before the real run.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"
CHECK="scripts/checks/lib/doc_links.py"
[ -f "$CHECK" ] || { echo "FATAL: $CHECK missing" >&2; exit 2; }

PASS=0; FAIL=0; INCOMPLETE=0
ok(){ echo "  ok   $1"; PASS=$((PASS+1)); }
no(){ echo "  FAIL $1"; FAIL=$((FAIL+1)); }
inc(){ echo "  INCOMPLETE $1"; INCOMPLETE=$((INCOMPLETE+1)); }
TMP="$(mktemp -d)" || { echo "FATAL: mktemp failed" >&2; exit 2; }
trap 'rm -rf "$TMP"' EXIT
BOUNDED_PARENT="$TMP"
source "$ROOT_DIR/scripts/checks/lib/bounded.sh"

# tree NAME: a fresh control tree with a target document carrying the anchors the controls use.
tree() {
  rm -rf "${TMP:?}/$1"; mkdir -p "$TMP/$1/docs" "$TMP/$1/changelog.d"
  cat > "$TMP/$1/docs/TARGET.md" <<'EOF'
# Target

## Phase 9: the `ledger` & its *views*

## Repeated

## Repeated

## A literal _ and __init__ and **bold**

<a id="REF-3"></a>

`<a id="in-code"></a>`

<!--
## Commented out
-->

```
## Not a heading
```
EOF
  printf '# Readme\n' > "$TMP/$1/README.md"
}
# expect NAME RC PATTERN DESCRIPTION: the checker on tree NAME exits RC and prints PATTERN.
expect() {
  local out rc
  out="$(bounded_run -i /dev/null 30 -- python3 -I "$CHECK" --root "$TMP/$1" 2>&1)"; rc=$?
  if bounded_is_incomplete "$rc"; then inc "$4: the checker timed out twice"; return; fi
  if [ "$rc" -eq "$2" ] && grep -qE -- "$3" <<<"$out"; then ok "$4"
  else no "$4 (exit $rc, wanted $2 and /$3/): $(awk 'NR<=3' <<<"$out" | tr '\n' ' ')"; fi
}

echo "=== controls: the checker on throwaway trees ==="
tree good
cat > "$TMP/good/docs/LINKS.md" <<'EOF'
[slug](TARGET.md#phase-9-the-ledger--its-views) [dup](TARGET.md#repeated-1) [id](TARGET.md#REF-3)
[case](TARGET.md#Repeated) [self](#local) [up](../README.md) [root](/README.md)
## Local
```
[inside a fence](MISSING.md)
```
`[inside a span](MISSING.md)` and `a span that
[crosses a line](MISSING.md)`
[literal](TARGET.md#a-literal-_-and-init-and-bold)
EOF
printf '### Entry\n\nSee [the target](docs/TARGET.md#repeated), [readme](README.md) and [the next](#second-entry).\n' \
  > "$TMP/good/changelog.d/2099-01-01-control.md"
printf '### Second Entry\n\nBody.\n' > "$TMP/good/changelog.d/2099-01-02-other.md"
printf '# Changelog\n\n## Major Milestones\n\n### Old Entry\n' > "$TMP/good/CHANGELOG.md"
expect good 0 'DOC-LINKS: PASS' "positive control: slugs (literal underscore, emphasis), duplicate suffix, explicit id, code skipped, root-relative fragment links and a sibling fragment's heading pass"

tree anchor
printf '[gone](TARGET.md#phase-8-renamed)\n' > "$TMP/anchor/docs/LINKS.md"
expect anchor 1 'no anchor #phase-8-renamed in docs/TARGET.md' "a link to a missing heading fails"

tree dup
printf '[third](TARGET.md#repeated-2)\n' > "$TMP/dup/docs/LINKS.md"
expect dup 1 'no anchor #repeated-2' "a duplicate suffix past the last repeated heading fails"

tree fenced
printf '[fenced](TARGET.md#not-a-heading)\n' > "$TMP/fenced/docs/LINKS.md"
expect fenced 1 'no anchor #not-a-heading' "a heading inside a code fence is not an anchor"

tree commented
printf '[ghost](TARGET.md#commented-out)\n' > "$TMP/commented/docs/LINKS.md"
expect commented 1 'no anchor #commented-out' "a heading inside an HTML comment is not an anchor"

tree codeid
printf '[ghost](TARGET.md#in-code)\n' > "$TMP/codeid/docs/LINKS.md"
expect codeid 1 'no anchor #in-code' "an id written inside a code span is not an anchor"

tree badge
printf '[![badge](NOPE.svg)](TARGET.md)\n' > "$TMP/badge/docs/LINKS.md"
expect badge 1 'missing local link NOPE.svg' "an image inside a link's text is checked"

tree missing
printf '[gone](NOPE.md)\n' > "$TMP/missing/docs/LINKS.md"
expect missing 1 'missing local link NOPE.md' "a link to a missing file fails"

tree outside
printf '[rel](docs/TARGET.md)\n' > "$TMP/outside/docs/LINKS.md"
expect outside 1 'missing local link docs/TARGET.md' "outside changelog.d/ a link resolves against its own directory"

tree fragrel
printf '### Entry\n\n[as if nested](../docs/TARGET.md)\n' > "$TMP/fragrel/changelog.d/2099-01-01-control.md"
expect fragrel 1 'missing local link ../docs/TARGET.md' "a changelog.d/ fragment resolves against the root, not changelog.d/"

tree fraganchor
printf '### Entry\n\n[renamed](docs/TARGET.md#gone)\n' > "$TMP/fraganchor/changelog.d/2099-01-01-control.md"
expect fraganchor 1 'no anchor #gone in docs/TARGET.md' "a fragment's anchor is checked too"

echo "=== the repository ==="
out="$(bounded_run -i /dev/null 60 -- python3 -I "$CHECK" 2>&1)"; rc=$?
if bounded_is_incomplete "$rc"; then inc "the repository run timed out twice"
elif [ "$rc" -eq 0 ]; then ok "$(grep -m1 'DOC-LINKS' <<<"$out")"
else
  grep '^FAIL' <<<"$out"
  no "$(grep -m1 'DOC-LINKS' <<<"$out" || echo "the checker exited $rc")"
fi

bounded_summary
echo ""
echo "DOC-LINKS-GATE: PASS=$PASS FAIL=$FAIL INCOMPLETE=$INCOMPLETE"
[ "$FAIL" -eq 0 ] && [ "$INCOMPLETE" -eq 0 ]
#!/usr/bin/env bash
# THE ROOT HOLDS ONLY THE DAY-ONE SET (ROADMAP R-0558). Every tracked top-level entry, and every
# first-level entry under docs/ and scripts/, must be listed in scripts/checks/root_inventory.txt,
# and every listed entry must exist. A negative control runs the same judgment on a synthetic
# listing first.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"
LIST=scripts/checks/root_inventory.txt
PASS=0; FAIL=0
ok(){ echo "  ok   $1"; PASS=$((PASS+1)); }
no(){ echo "  FAIL $1"; FAIL=$((FAIL+1)); }

# judge LIST: reads tracked paths on stdin, prints one problem per line.
judge() {
  python3 -I -c '
import sys
want = {l.strip() for l in open(sys.argv[1]) if l.strip() and not l.startswith("#")}
have = set()
for p in (l.rstrip("\n") for l in sys.stdin):
    if not p: continue
    parts = p.split("/")
    have.add(parts[0])
    if parts[0] in ("docs", "scripts") and len(parts) > 1:
        have.add(parts[0] + "/" + parts[1])
for e in sorted(have - want): print("not in the day-one set: " + e)
for e in sorted(want - have): print("listed but missing: " + e)
' "$1"
}

echo "=== negative controls ==="
TMP="$(mktemp -d)" || exit 2
trap 'rm -rf "$TMP"' EXIT
printf 'a\nb\ndocs\ndocs/x.md\n' > "$TMP/list"
[ -z "$(printf 'a\nb/c\ndocs/x.md\n' | judge "$TMP/list")" ] && ok "control: exactly the listed set passes" || no "control: listed set refused"
[ -n "$(printf 'a\nb/c\ndocs/x.md\nstray\n' | judge "$TMP/list")" ] && ok "control: an unlisted top-level entry is refused" || no "control: stray accepted"
[ -n "$(printf 'a\nb/c\ndocs/x.md\ndocs/y.md\n' | judge "$TMP/list")" ] && ok "control: an unlisted docs/ entry is refused" || no "control: docs stray accepted"
[ -n "$(printf 'a\ndocs/x.md\n' | judge "$TMP/list")" ] && ok "control: a missing listed entry is refused" || no "control: missing accepted"

echo "=== the tracked root against $LIST ==="
[ -f "$LIST" ] || { no "$LIST is missing"; echo "root_inventory: PASS=$PASS FAIL=$FAIL"; exit 1; }
out="$(git ls-files --cached | judge "$LIST")"
[ -z "$out" ] && ok "the root holds exactly the day-one set" || { no "the root differs from the day-one set:"; echo "$out" | sed 's/^/      /'; }
echo "root_inventory: PASS=$PASS FAIL=$FAIL"
[ "$FAIL" -eq 0 ]
# Landings that skipped the review leg, 2026-11-06 (audit)

Status: audit record (ISS-0012). History is not rewritten; every result here is bound to an exact SHA.

On 2026-11-06 three decision-recording trains landed after `train.sh check --no-review`. The automated
review leg refused decision recording (ISS-0011). Its `check` recorded a pass without a review note, and
`land` read no review record (ISS-0009). Each train had a separate manual Codex review, written down
only in its local train notes. The landing machinery now fails closed (`train.sh` review provenance,
landed at 4de277fe; dispatch CI run 42255918182, main run 42256339823, both green). This record checks, for each train,
whether that manual review covered the exact landed diff. It adds a retrospective review of each one.

The per-train logs are copies of the local landing logs (`<git-common-dir>/concrete-landing/log/`):
[docs-2026-11-06.tsv](docs-2026-11-06.tsv), [nht-decision.tsv](nht-decision.tsv),
[facts-decision.tsv](facts-decision.tsv) and, for the fix, [flm.tsv](flm.tsv).

## Contemporaneous review: did it cover the exact landed diff?

| train | landed diff (base..head) | CI (dispatch / main) | manual Codex review | covers the landed diff |
| --- | --- | --- | --- | --- |
| docs-2026-11-06 | 28889fbd3a..ac8e50404b | 42156910326 / 42157227191 green | round 1 NOT YET (3 findings), round 2 ACCEPT | yes: the reviewed `BATCH.diff` has the same content as the landed diff (blob-id abbreviation only), and round 1's files plus round 2's `DELTA.diff` equal the final files byte for byte. Round 1 focused on the new part; the first two commits were stated to replay a diff accepted earlier on wip/long-term-2026-11-06 (bf47b5cae, b172171ca), not re-verified here |
| nht-decision | ac8e50404b..d20e3ab333 | 42166696652 / 42167006263 green | round 1 NOT YET (2 findings), round 2 ACCEPT | yes: the reviewed `DIFF.patch` matches the landed diff on its 5 files; the other 3 landed files (`docs/archive/no-hidden-traps-2026-11-06/`) were given to the reviewer as sources and are byte-identical to what landed |
| facts-decision | 70e222d947..ab537833d7 | 42229695498 / 42230637757 green | rounds 1-3 NOT YET, round 4 ACCEPT (whole diff read) | yes: the round-4 `CHANGE.diff` has the same content as the landed diff, and its 5 files are byte-identical to ab537833d7. The automated leg's one finding (the OD82 extension) was owner-approved: "ok agreed with the 3 decisions" (2026-11-06) covered the three spellings, including the `#[may_not_terminate]` expression-prefix placement |

Gaps at landing time, for all three: no review note was written (verify.sh had nothing to read), and no
second reviewer of the exact diff was recorded (decided-project-review requires one when available, or
a record of its absence).

## Retrospective reviews (2026-11-06, after landing)

Codex ran through `scripts/review/review.sh` from main 4de277fe (the prompt with the recording rule), on
detached checkouts of each landed head, with the prompt marked RETROSPECTIVE. The notes are on the
landed heads under `refs/notes/concrete-review`. They are retrospective evidence and did not gate the
landings. Kimi ran as a read-only second reviewer (`kimi -p`) over each exact landed diff and tree.

| train | Codex (note on head) | Kimi |
| --- | --- | --- |
| docs-2026-11-06 | **findings** at ac8e50404b (16:53:53Z): `docs/decisions.md:440`, the long-term-changes row gave no quoted owner answer | **findings** (6): the same provenance gap; and five unconfirmed points (rule detail recorded beside "left to R-0574"; README obligations O7/O9 without a referent; A2i/A2c acceptance not naming R-0574; ROADMAP:13 phase-E wording against the LP0 pilot; the changelog's certificate wording) |
| nht-decision | clean at d20e3ab333 (16:54:12Z, 3 pieces) | **findings** (2, unconfirmed): README.md:10 drops the "safe code" qualifier; "termination is known beforehand" overstates what a d-site permission establishes |
| facts-decision | clean at ab537833d7 (16:54:32Z) | clean |

## Remediation

- The provenance gap is fixed on this branch: the long-term-changes row now quotes the owner's answer.
  On 2026-11-06 the owner asked "is this the best long term design". Asked whether to accept all five
  changes, the owner answered "1" (option 1: accept all five).
- Kimi's other findings are unconfirmed. Each needs Codex confirmation, and any wording change to a
  recorded decision goes to the owner. They are tracked in ISS-0014, and nothing here changes those
  rows.
- Structural fix: ISS-0009 and ISS-0011, on main at 4de277fe. `check` fails without a reviewer.
  `land` requires a verified clean review note at the head, or on every member at its exact SHA. The
  review prompt permits recording an owner-approved decision and checks its provenance.
# The old bug ledger's disposition (P10, P11)

`bug_disposition.tsv` gives every record of the old compiler's bug ledger (frozen at
`legacy/docs/bugs/`) one disposition across the restart, as decisions P10 and P11 prescribe
([decisions](../../decisions.md#decided-project-bugs)):

- **legacy-impl**: a defect of the old implementation. It is *retired with the old implementation*,
  never marked fixed. It keeps its reproducer, ruling and structural class, and its reproducer feeds
  the oracle comparisons (P10).
- **std**: a library or builtin obligation. It moves with std as a contract plus a regression (P11).
- **rule**: a language ruling. It keeps its ruling and becomes a conformance example of the new
  specification, or a recorded owner question (P11).
- **process**: tooling and gate-design records. Their lessons are kept; the obsolete gates are not.

Paths in `repro_path` are named as they were before the move: after it, `P` lives at `legacy/P`.
`legacy/` is frozen, so this table, not the ledger, carries every correction made since.

**Provenance.** The first classification was drafted on 2026-11-04 from the ledger at `b78fff1a5`
and reviewed by Codex the same day. The `correction` column records each change that review asked
for, and the changes the owner's 2026-11-05 decisions imply:

- eleven library records move from legacy-impl to the std class;
- 115 and 166 become rulings;
- 063, 074, 229 and 308 are answered by their decisions;
- 330 is decided by OD47;
- 313 is decided by P4 (duplicate enum variants and impl methods are refused);
- several expected outcomes are corrected (057, 318, 320, 324, 327);
- several citations are completed (307, 339, 341, 345);
- 063's outcome follows the revision of OD45/OD87 (explicit capability arguments);
- 186 notes the TRAIT-1 revision (Q2.8).

**Two known differences from the decision text.**
- P11 counts twelve std records; this table has eleven, the set the review identified. The twelfth
  is still to be named, or the count corrected, by R-0561.
- `browser_visible_open` is kept as recorded, but under P9 the site goes down at the move, so no
  record stays visible in a served browser compiler.

R-0561 builds the new ledger from this table. When it closes, every row here has its destination
there, and the `docs/bugs` row of `RETENTION.tsv` resolves.
