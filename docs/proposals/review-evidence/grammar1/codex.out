partial def parseImplBlock : ParseM (ImplBlock ⊕ ImplTraitBlock) := do
  let declSp ← peekSpan
  expect .impl_
  let (typeParams, typeBounds, implCapParams) ← parseTypeAndCapParams
  let firstName ← expectIdent
  -- Check for turbofish on impl type: impl<T> Name<T> { ... }
  let next0 ← peek
  -- `impl Name<T> { ... }`: the target's type arguments. Kept, not consumed: coherence
  -- (E0593) refuses any that are not exactly the impl's own parameters (bug 186).
  let mut firstArgs : Option (List Ty) := none
  if next0 == .lt then
    advance
    firstArgs := some (← parseTypeArgList)
    expect .gt
  -- Check: is it "impl Trait for Type" or "impl Type"?
  let tk ← peek
  match tk with
  | .for_ =>
    -- Trait impl: impl TraitName for TypeName with(Caps) { ... }
    if !implCapParams.isEmpty then
      throwParse "capability parameters on a trait impl are not supported; declare them on an inherent impl (`impl<cap C> Writer<C>`)"
    advance
    -- The head is spelled canonically (`i64` → `Int`, `bool` → `Bool`): every later pass keys an
    -- impl's methods by this spelling, and Elab names the method definitions by the canonical
    -- type, so `impl Tr for bool` reached Check and the interpreter as `bool_m` beside a
    -- definition `Bool_m` (bug 186).
    let typeName := tyName (tyFromName (← expectIdent))
    -- Conditional trait impl target may be generic: `impl<T: Destroy> Destroy
    -- for Vec<T>` — consume the target's type args (the impl's typeParams
    -- already name them).
    let tkTA ← peek
    let mut targetArgs : Option (List Ty) := none
partial def parseImport : ParseM ImportDecl := do
  let sp ← peekSpan
  expect .import_
  let mut modPath : String := ""
  let modName ← expectIdent
  modPath := modName
  -- Handle dotted module paths: A.B.{syms}
  let mut tk ← peek
  while tk == .dot do
    advance
    let next ← peek
    match next with
    | .lbrace =>
      -- We've reached the symbol list
      break
    | _ =>
      let nextName ← expectIdent
      modPath := modPath ++ "." ++ nextName
    tk ← peek
  expect .lbrace
  -- Bug 295: an Array, converted once (appending each element to the list built so far was O(n²)).
  let mut symbols : Array ImportSymbol := #[]
  tk ← peek
  while tk != .rbrace && tk != .eof do
    let sym ← expectIdent
    tk ← peek
    if tk == .as_ then
      advance
      let aliasName ← expectIdent
      symbols := symbols.push { name := sym, alias := some aliasName }
    else
      symbols := symbols.push { name := sym }
    tk ← peek
    if tk == .comma then advance; tk ← peek
  expect .rbrace
  expect .semicolon
  return { moduleName := modPath, symbols := symbols.toList, span := sp }
partial def parseAttribute : ParseM (String × Option String × Option ReprOpts × Option Expr) := do
  expect .hash
  expect .lbracket
  let attrSp ← peekSpan
  let key ← expectIdent
  -- Reject unknown attributes instead of silently ignoring them. Attributes
  -- here carry proof/capability/trust/test meaning, so a typo like
  -- `#[overflow_checkd]` or `#[tes]` would silently drop a security-relevant
  -- annotation — a semantically dark construct. Keep this list complete; a new
  -- attribute must be added here as well as wired into its consumer.
  let knownAttrs := ["repr", "test", "overflow_checked", "spec", "proof_by",
    "ensures_proof", "proof_coverage", "proof_fingerprint", "requires",
    "ensures", "invariant", "variant", "intrinsic", "langitem", "link_name", "export_name"]
  unless knownAttrs.contains key do
    throwParse s!"unknown attribute '#[{key}]'"
      (span := some attrSp)
      (hint := some s!"known attributes: {", ".intercalate knownAttrs}")
  let tk ← peek
  if tk == .lparen && (key == "ensures" || key == "requires" || key == "invariant" || key == "variant") then
    -- source-contract expressions: ensures/requires (function level) and
    -- invariant/variant (loop level). Each carries one expression.
    advance
    let e ← parseExpr
    expect .rparen
    expect .rbracket
    return (key, none, none, some e)
  else if tk == .assign then
    -- #[key = "value"]
    advance
    let valTk ← peek
    let val ← match valTk with
      | .strLit s => advance; pure s
      | _ =>
        let sp ← peekSpan
        throwParse "expected string literal in attribute value" (span := some sp)
    expect .rbracket
    return (key, some val, none, none)
  else if tk == .lparen && key == "repr" then
    -- #[repr(C, align(16), packed)]
    advance
    let mut opts : ReprOpts := {}
    let mut tk2 ← peek
    while tk2 != .rparen && tk2 != .eof do
      let arg ← expectIdent
      if arg == "C" then
        opts := { opts with isReprC := true }
      else if arg == "packed" then
        opts := { opts with isPacked := true }
      else if arg == "align" then
        expect .lparen
        let alignTk ← peek
        match alignTk with
        | .intLit n =>
          advance
          opts := { opts with reprAlign := some n.toNat }
        | _ =>
          let sp ← peekSpan
          throwParse "expected integer literal in align()" (span := some sp)
        expect .rparen
      else
| OD110 | <a id="od110"></a>Enums at the foreign boundary (added 2026-10-30, from the Codex and Kimi review of the absorption). Question: Whether a value of enum type may cross an `extern fn` boundary, and if so in what representation. Bears on FFI-3, FFI-7. The current compiler: refused: `extern fn f(x: E)` with `enum Copy E { A, B }` is E0574 (a non-FFI-safe parameter); only scalars, raw pointers and `repr(C)` structs cross. The design record [LAYOUT_CONTRACT.md](../legacy/docs/archive/design-records/LAYOUT_CONTRACT.md) says enums must not cross (§3.2); before it was archived it also said they cross as integers. Options: (a) refused, as in the current compiler; (b) a fieldless enum crosses as an integer of a stated width, which needs a stated discriminant for each variant. Austral: not checked. Pick: none given (raised by the Codex and Kimi review of the absorption, 2026-10-30). | refused (E0574) | FFI-3, FFI-7 | decided 2026-10-31 by the owner's rule (every reviewer agreed, as strict as Austral or stricter): Refused |
| OD111 | <a id="od111"></a>Misaligned fields of a packed struct (added 2026-10-30, from the Codex and Kimi review of the absorption). Question: Whether a `#[repr(packed)]` struct may hold a field whose alignment exceeds the alignment of its offset, and whether such a field may be borrowed. Bears on FFI-4, FFI-8, REF-5. The current compiler: both accepted: `#[repr(packed)] struct P { v: u8, l: u32 }` places `l` at offset 1, and `&p.l` is accepted and reads the field correctly in the binary and in `--interp`. [LAYOUT_CONTRACT.md](../legacy/docs/archive/design-records/LAYOUT_CONTRACT.md) §2 restricts a packed struct to fields whose alignment does not exceed their position, without saying what enforces it. Options: (a) refuse such a field; (b) accept it and refuse a reference to it; (c) accept both, as in the current compiler. Austral: not checked. Pick: none given (raised by the Codex and Kimi review of the absorption, 2026-10-30). | both accepted on both consumers | FFI-4, FFI-8, REF-5 | decided 2026-11-01 by the owner (final set): Accept field, refuse a reference to it |
| OD112 | <a id="od112"></a>Mutation through a shared reference (added 2026-10-30, from the Codex and Kimi review of the absorption). Question: Whether a value reached through a shared reference `&T` may be changed, by a write through a raw pointer derived from the reference or by a cell type. Bears on REF-10, OWN-10, TRUST-2, TRUST-5. The current compiler: safe code changes a value only through a `mut` binding or a `&mut` reference, and there is no cell type; a trusted function may convert `r: &Int` to `*mut Int` (`r as *const Int as *mut Int`) and store through it: the binary does the store, and `--interp` stops ("deref-assign through immutable ref"). The archived [MEMORY_SEMANTICS.md](../legacy/docs/archive/design-records/MEMORY_SEMANTICS.md) §12 said there is no `Cell`, `RefCell` or `UnsafeCell` equivalent and that mutation flows from `let mut` through `&mut`; the [overview](../legacy/docs/spec/overview.md) lists no interior mutability in safe code, with a later `UnsafeCell<T>` gated by `Unsafe`. Options: (a) never: a write through a pointer derived from a `&T` is undefined behaviour, a premise trusted code keeps (TRUST-2); (b) as (a), with a cell type gated by `Unsafe` as the one exception; (c) a trusted write through such a pointer is allowed. Austral: not checked. Pick: none given (raised by the Codex and Kimi review of the absorption, 2026-10-30). | safe code cannot; a trusted write through `r as *const T as *mut T` runs in the binary and stops `--interp` | REF-10, OWN-10, TRUST-2, TRUST-5 | decided 2026-10-31 by the owner's rule (every reviewer agreed, as strict as Austral or stricter): Never; UB premise trusted code keeps |
| OD113 | <a id="od113"></a>The ownership exceptions of trusted code (added 2026-10-30, from the Codex and Kimi review of the absorption). Question: Whether trusted code keeps its two exceptions to the ownership rules, destroying a value through a reference and releasing with `vec_free` a vector whose elements are not Copy. Bears on TRUST-5, TRUST-12, OWN-5, OWN-8. The current compiler: both are accepted in trusted code only (elsewhere E0290 under OWN-8 and E0287 under OWN-5): std's collections destroy an element through `(p as &T)` in drop glue after its owner was consumed, and a trusted function may free a buffer it has emptied. The archived [MEMORY_SEMANTICS.md](../legacy/docs/archive/design-records/MEMORY_SEMANTICS.md) §11 said that `trusted` does not relax linearity, and TRUST-5's rationale says the same. Options: (a) keep both, each a named trusted operation with its premise (the owner was consumed; the vector is empty); (b) remove both, drop glue moving the element out of raw memory instead (TRUST-7); (c) keep only destruction through a reference; (d) keep only `vec_free` of an emptied vector. Austral: not checked. Pick: none given (raised by the Codex and Kimi review of the absorption, 2026-10-30). | both accepted in trusted code only (E0290, E0287 elsewhere) | TRUST-5, TRUST-12, OWN-5, OWN-8 | decided 2026-10-31 by the owner's rule (every reviewer agreed, as strict as Austral or stricter): Remove both |
| OD114 | <a id="od114"></a>How integer division rounds (added 2026-10-30, from the Codex and Kimi review of the absorption). Question: How an integer division that does not abort rounds its quotient, and which sign a nonzero remainder takes. Bears on ARITH-3. The current compiler: the quotient is truncated toward zero and a nonzero remainder has the sign of the dividend, as C99 and LLVM's `sdiv` and `srem` give (`-7 / 2` is `-3`, `-7 % 2` is `-1`, `7 % -2` is `1`), in the binary, the interpreter and the constant folder (`IntArith.evalIntBinOp`). The archived [ARITHMETIC_POLICY.md](../legacy/docs/archive/design-records/ARITHMETIC_POLICY.md) states when division aborts (§5) but not how it rounds. Options: (a) truncation toward zero, as in the current compiler; (b) floored division, the remainder taking the divisor's sign; (c) Euclidean division, the remainder never negative. Austral: not checked. Pick: none given (raised by the Codex and Kimi review of the absorption, 2026-10-30). | the quotient is truncated toward zero and a remainder has the dividend's sign (C99) | ARITH-3 | decided 2026-10-31 by the owner's rule (every reviewer agreed, as strict as Austral or stricter): Truncation toward zero |
| OD115 | <a id="od115"></a>The body and totality of a specification function (added 2026-10-30, raised while absorbing the verification documents). Question: Whether a `spec fn` may be declared without a body, and whether its body must be shown total. Bears on CON-3, CON-5, CON-1. The current compiler: both `spec fn big(x: Int) -> bool;` and `spec fn big(x: Int) -> bool = x > 10;` are accepted, and so is a recursive body that never terminates (`spec fn loopy(x: Int) -> bool = loopy(x + 1);`), with no check. [CONTRACTS_GUIDE.md](../legacy/docs/verification/CONTRACTS_GUIDE.md) calls a `spec fn` "an erased mathematical specification, no body"; contracts.md's examples (CON-3) give it a body; [CONTRACTS_AND_VCS.md](../legacy/docs/verification/CONTRACTS_AND_VCS.md) (Soundness Bridge) requires it to be total. Options: (a) a body is required and must be total (structural recursion or a checked measure); (b) a body is optional, a body-less one an uninterpreted function a proof must constrain, and a body must be total; (c) as in the current compiler, no totality check. Austral: not applicable. Pick: none given (raised by the absorption of docs/verification, 2026-10-30). | see OPEN-115 | see OPEN-115 | decided 2026-11-01 by the owner (final set): Body required and total |
| OD116 | <a id="od116"></a>A checked total function category (added 2026-10-30, raised while absorbing the verification documents). Question: Whether the language has a `total fn` category, a runtime function checked to terminate without trapping that contracts may then call. Bears on CON-1, CON-3, CON-5. The current compiler: there is no such category (`total fn f(..)` is a parse error, E0001); a contract clause may still call a capability-free runtime function until CON-3's judgment lands. [CONTRACTS_AND_VCS.md](../legacy/docs/verification/CONTRACTS_AND_VCS.md) (Design Principles) distinguishes `spec fn`, a checked `total fn`, ordinary and trusted functions, and admits a `total fn` into contracts once its obligations close. Options: (a) add the category; (b) no category: contracts call only `spec fn` (CON-3's full judgment). Austral: not checked. Pick: none given (raised by the absorption of docs/verification, 2026-10-30). | see OPEN-116 | see OPEN-116 | decided 2026-11-01 by the owner (final set): No category |
| OD117 | <a id="od117"></a>`old`, quantifiers and implication in contracts (added 2026-10-30, raised while absorbing the verification documents). Question: Whether contract expressions gain `old(x)`, quantifiers and an implication or equivalence operator, and with what syntax. Bears on CON-2, CON-3, SYN-1. The current compiler: `#[ensures(result == old(x))]` compiles and runs, and `--report contracts` marks the clause `invalid_contract_expression` (unknown function `old`); `forall i: Int, ...` is a parse error (E0001); there is no implication operator. [CONTRACTS_AND_VCS.md](../legacy/docs/verification/CONTRACTS_AND_VCS.md) (Contract Expression V1) lists all three as deferred. Options: (a) add each, with a syntax decided per form; (b) keep them out, a claim needing one being a Lean theorem; (c) refuse `old(..)` now as an unknown name, deciding the rest later. Austral: not checked. Pick: none given (raised by the absorption of docs/verification, 2026-10-30). | see OPEN-117 | see OPEN-117 | decided 2026-11-01 by the owner (final set): No `old`, quantifiers or implication in contracts; state such properties as Lean theorems |
| OD118 | <a id="od118"></a>A proven run-time violation in trusted code (added 2026-10-30, raised while absorbing the verification documents). Question: Whether an index the compiler proves out of bounds, or a division it proves to be by zero, is refused in `trusted` and `with(Unsafe)` code as in safe code. Bears on MEM-6, ARITH-3, TRUST-5, TRUST-12. The current compiler: `a[5]` on a `[Int; 3]`, or `x / 0`, is refused in safe code (E0900, `error[runtime-safety]`) and compiles in a `trusted fn` (the index also in a function declaring `Unsafe`), where it aborts at run time on both consumers. MEM-6 states the refusal with no exemption; [KNOWN_HOLES.md](../legacy/docs/verification/KNOWN_HOLES.md) C7 records the exemption as intended. Options: (a) refuse everywhere, as MEM-6 reads; (b) keep the exemption and state it in MEM-6. Austral: not checked. Pick: none given (raised by the absorption of docs/verification, 2026-10-30). | see OPEN-118 | see OPEN-118 | decided 2026-10-31 by the owner's rule (every reviewer agreed, as strict as Austral or stricter): Refuse everywhere **Subsumed 2026-11-06 by [no hidden traps](#decided-project-no-hidden-traps): refusal of proven violations becomes refusal of unproven safety, everywhere.** |
| OD119 | <a id="od119"></a>Buffered output when the process aborts (added 2026-10-30, raised while absorbing the verification documents). Question: Whether output the program wrote before a trap or abort is flushed before the process ends. Bears on STMT-1, STMT-2, PASS-13, OPEN-101. The current compiler: print builtins write through C's buffered stdio, and `abort` does not flush it on glibc (a binary that prints `hello` and then traps prints nothing on Linux) while it does on Darwin; the interpreter models the same buffer and the same platform difference. STMT-2 says a failure ends the process at once and is silent on output already written, so the observable trace of a trapping program differs by platform. Recorded by [INTERPRETER_TRUST.md](../legacy/docs/verification/INTERPRETER_TRUST.md) §2. Options: (a) everything written before the trap is output (flush on abort, or unbuffered output); (b) what was written is unspecified on a trap, and PASS-13 compares output only for exiting runs. Austral: not checked. Pick: none given (raised by the absorption of docs/verification, 2026-10-30). | see OPEN-119 | see OPEN-119 | decided 2026-10-31 by the owner's rule (every reviewer agreed, as strict as Austral or stricter): Everything written before the trap is output |
| OD120 | <a id="od120"></a>A vacuous contract (added 2026-10-30, raised while absorbing the verification documents). Question: Whether a contract whose precondition is unsatisfiable is refused by the language or only reported, under a project policy. Bears on CON-1, CON-2. The current compiler: `#[requires(x > 5 && x < 3)]` compiles; a decided-unsatisfiable precondition makes the claim `vacuous`, never `proved`, and E0613 refuses it only under the `forbid-vacuous` policy (`Concrete.Policy`), not in a plain build. [CONTRACTS_AND_VCS.md](../legacy/docs/verification/CONTRACTS_AND_VCS.md) (Soundness Bridge) states the reporting rule. Options: (a) a language refusal in every build; (b) tooling only: always reported `vacuous`, refused under a policy, as in the current compiler. Austral: not checked. Pick: none given (raised by the absorption of docs/verification, 2026-10-30). | see OPEN-120 | see OPEN-120 | decided 2026-11-01 by the owner (final set): Tooling: reported `vacuous`, refused under policy **Qualified 2026-11-06 by [no hidden traps](#decided-project-no-hidden-traps): a vacuous precondition used for safety admission is refused in every build.** |
