{
  description = "Concrete development environment";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
  };

  outputs = { self, nixpkgs }:
    let
      systems = [
        "x86_64-linux"
        "aarch64-linux"
        "x86_64-darwin"
        "aarch64-darwin"
      ];
      forAllSystems = f:
        nixpkgs.lib.genAttrs systems (system:
          f {
            pkgs = import nixpkgs { inherit system; };
          });
    in {
      devShells = forAllSystems ({ pkgs }:
        let
          # LEAN IS THE OFFICIAL v4.34.1 RELEASE ARCHIVE, not nixpkgs' lean4 (R-0208). The checker identity a
          # receipt binds is the executable and libraries that actually load; nixpkgs builds Lean itself
          # (reporting its version tag as the githash), so the devshell and CI's elan ran DIFFERENT checkers
          # under one name. Pinning the archive elan installs makes them the same build. Hashes are the
          # sha256 GitHub publishes for each release asset. macOS binaries are left byte-identical
          # (dontFixup); Linux needs autoPatchelf to run under Nix, so its bytes — and identity — differ
          # from elan's there, which CI (elan) does not use.
          leanRelease =
            let
              sys = pkgs.stdenv.hostPlatform.system;
              asset = {
                "aarch64-darwin" = { name = "darwin_aarch64"; sha256 = "65f22a4f047738ec742667b3247e836a86ebf06eabc12655c3dee00637e37866"; };
                "x86_64-darwin"  = { name = "darwin";         sha256 = "c2fee70250444e46c1106a27bddfef948d1e563eef431eaac05bb946b2f73d3a"; };
                "x86_64-linux"   = { name = "linux";          sha256 = "47bf4bbd78f70c2e9670598ab7124d92b6efb7330ff33e5fbb4030f6fd72e4e4"; };
                "aarch64-linux"  = { name = "linux_aarch64";  sha256 = "fdb974c2cdb4627e090d5d4007b913e09d13c4868720fb5594e22808b3de9e37"; };
              }.${sys};
            in pkgs.stdenv.mkDerivation {
              pname = "lean4-release";
              version = "4.34.1";
              src = pkgs.fetchurl {
                url = "https://github.com/leanprover/lean4/releases/download/v4.34.1/lean-4.34.1-${asset.name}.tar.zst";
                sha256 = asset.sha256;
              };
              nativeBuildInputs = [ pkgs.zstd ]
                ++ pkgs.lib.optionals pkgs.stdenv.isLinux [ pkgs.autoPatchelfHook ];
              buildInputs = pkgs.lib.optionals pkgs.stdenv.isLinux [ pkgs.stdenv.cc.cc.lib pkgs.zlib ];
              autoPatchelfIgnoreMissingDeps = true;
              dontConfigure = true;
              dontBuild = true;
              dontStrip = true;
              dontFixup = pkgs.stdenv.isDarwin;
              unpackPhase = "tar --zstd -xf $src";
              installPhase = "mkdir -p $out && cp -R lean-4.34.1-${asset.name}/. $out/";
            };
          # pyyaml so scripts/tests/check_workflow_yaml.sh can actually run: it needs pyyaml or ruby
          # and FAILS (rather than skips) without either. The only non-stdlib module any gate imports.
          python = pkgs.python3.withPackages (ps: [ ps.pyyaml ]);

          # THE GATE USERLAND: the programs scripts/tests (and the scripts/ci, scripts/gen,
          # scripts/land helpers they call) run, and nothing else. Gates run in three places, the
          # dev shell, Linux CI runners and the macOS CI runner, and used to take these tools from
          # whatever host they landed on: GNU on Linux, BSD on macOS, where `timeout` does not exist
          # and `sed -i`, `stat`, `date` and `readlink` take other flags. CI now runs every gate step
          # inside `nix develop .#gates`, so all three see these exact builds.
          #
          # NO LEAN HERE, and no lake. CI takes Lean from elan, and the checker identity a receipt
          # records is the Lean that actually loads (R-0208); a shell that put the nix-built Lean
          # first on PATH would change it. The C/LLVM/Rust toolchains, z3, valgrind, zola, curl and
          # gh also stay the host's: CI provisions those separately today, and moving them is a
          # different change.
          gatesUserland = with pkgs; [
            bash
            coreutils          # timeout, stat, date, readlink, sha256sum, mktemp, ...
            findutils
            diffutils          # diff, cmp
            gnused
            gnugrep
            gawk
            gnutar             # check_tar_list_differential.sh compares against `tar -tf`
            gzip
            xz
            zstd
            bzip2
            which
            file
            gnumake
            git
            jq
            xxd                # check_hexdump_differential.sh skips its format legs without it
            # perl for `shasum`: the checker identity hashes the Lean images with it
            # (Concrete/Proof/Replay.lean, sha256Files), and without it every receipt is withheld
            # as "Checker: UNIDENTIFIED". The shell used to inherit it from the host, and Arch
            # keeps it in /usr/bin/core_perl, which only login shells put on PATH, so 17
            # receipt/replay/checker-identity gates failed on the Arch gate host (2026-10-23).
            # The digest it prints does not depend on which perl computes it.
            perl
            python
          ] ++ lib.optionals stdenv.isLinux [
            procps             # ps, pgrep, pkill (macOS keeps its own; nixpkgs' procps is Linux-only)
            util-linux         # flock, hexdump, column, script
          ];

        shell: "nix develop .#extcheck --command bash --noprofile --norc -eo pipefail {0}"
        run: bash scripts/proofs/external.sh

  # The oracle check on a GitHub-hosted runner (ISS-0005, P13; R-0564): proves that a runner other than
  # concrete-ci-2 gets a verified oracle from the release alone. A missing, corrupt or unverifiable
  # artifact makes ci_check.sh exit 3 (INCOMPLETE) and the job fail: it is never reported as passed.
  # It is a GitHub-hosted job, so a pull_request may run it (no self-hosted runner is involved).
  oracle-hosted:
    name: Oracle (GitHub-hosted fetch + smoke)
    needs: landing-record
    if: ${{ !cancelled() && needs.landing-record.outputs.recorded != 'true' }}
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4

      - name: Install Nix
        uses: cachix/install-nix-action@v31
        with:
          extra_nix_config: |
            experimental-features = nix-command flakes

      - name: "Oracle fetch (missing, corrupt or unverifiable artifact is INCOMPLETE; negative controls)"
        run: bash scripts/checks/oracle_fetch.sh

      - name: "Fetch the published oracle, verify it, run smoke.con through it (exit 42)"
        run: bash scripts/oracle/ci_check.sh

  # THE COMPILER'S GATES (Concrete/README.md gates 4, 6, 6a, 8, 9, 10, 11 and 12; slice 0, provisional),
  # scripts/checks/compiler/: not root checks (run.sh runs only scripts/checks/*.sh), because they need
  # the compiler's devshell, a native macOS runner and minutes each. Every hand-written BIR example
  # through the LLVM path and the LCB path, each executable's observation compared with the BIR
  # semantics; sanitizers, binary size (report-only) and the stack bound; the trusted-base golden; and
  # every build stage reproduced in distinct directories and on distinct machines. Each runs natively
  # on x86-64 Linux and on AArch64 macOS (LCB's first native proof profile is Apple AArch64), and every
  # matrix leg is a required job of its own name.
  backends:
    name: Slice 0 backends (${{ matrix.arch }})
    needs: landing-record
    if: ${{ !cancelled() && needs.landing-record.outputs.recorded != 'true' }}
    # The compiler's devshell (flake.nix default: Lean, clang, LLVM, gdb/lldb), entered per step;
    # the gates shell has no Lean.
    defaults:
      run:
        shell: bash
    strategy:
      fail-fast: false
      matrix:
        include:
          - arch: x86-64
            runner: ubuntu-latest
          - arch: aarch64-macos
            runner: macos-15
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 60
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - name: Install Nix
        uses: cachix/install-nix-action@v31
      - name: Backend gate (LLVM and LCB, native)
        run: nix develop --command bash scripts/checks/compiler/slice0_backends.sh

  artifacts:
    name: Slice 0 artifacts (${{ matrix.arch }})
    needs: landing-record
    if: ${{ !cancelled() && needs.landing-record.outputs.recorded != 'true' }}
    # The compiler's devshell (flake.nix default: Lean, clang, LLVM, gdb/lldb), entered per step;
    # the gates shell has no Lean.
    defaults:
      run:
        shell: bash
    strategy:
      fail-fast: false
      matrix:
        include:
          - arch: x86-64
            runner: ubuntu-latest
          - arch: aarch64-macos
            runner: macos-15
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 60
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - name: Install Nix
        uses: cachix/install-nix-action@v31
      - name: Sanitizers, binary size (report-only) and stack bound (gates 10, 11, 12)
        run: nix develop --command timeout 3000 bash scripts/checks/compiler/slice0_artifacts.sh report
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: artifacts-${{ matrix.arch }}
          path: report
          if-no-files-found: error

  trusted-base:
    name: Slice 0 trusted base (gate 9, ${{ matrix.arch }})
    needs: landing-record
    if: ${{ !cancelled() && needs.landing-record.outputs.recorded != 'true' }}
    # The compiler's devshell (flake.nix default: Lean, clang, LLVM, gdb/lldb), entered per step;
    # the gates shell has no Lean.
    defaults:
      run:
        shell: bash
    strategy:
      fail-fast: false
      matrix:
        include:
          - arch: x86-64
            runner: ubuntu-latest
          - arch: aarch64-macos
            runner: macos-15
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 60
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4

   **Classification uses the status and the runtime evidence, never the status alone.** `Observation.status` is many-to-one.
   - Status 134 **with** the runtime's trap line on fd 2 is `trapped k`.
   - Status 134 **without** it is `exited 134`.
   - Status 125 **with** the launcher's refusal line is `startupRefused`.
   - Status 125 **without** it is `exited 125`.

   Accepted examples `return 125;` and `return 134;` are in the corpus and must classify as exits. Slice 0 can't produce a real startup refusal, because it has no grants. The refusal and trap classifications are also exercised by comparator self-tests: stub images, and the trap via gate 6.

   **Refused examples have their own leg.** The Lean `check` result, the compiler's refusal (with its rule) and the refusal certificate must agree with `.expect`. No executable exists for a refused example. A separate supported-subset coverage report lists every grammar production and Core form that the corpus exercises. A reject-all compiler fails, because every accepted example must exit with its status.
5. **Differential at the source:** generated accepted programs, with replayable seeds; native exit = Lean `run`.
6. **Differential through the token-free lowering, both backends.** This covers overflow. Generated **well-scoped, unchecked** slice-0 programs over **arbitrary** `u8` operands, including `200 + 56`, take `lower q ∅ → memory → ssa`, so they have no tokens and no checker. Their Core `run` is compared with the LLVM path and the LCB path. Overflow must give exit 134 and the right site's trap line on fd 2, for both backends. This exercises token-aware lowering, Memory CFG and SSA, not only the backends.
   A second leg compares generated BIR directly with both backends, to cover BIR shapes that lowering does not produce.

   An in-process leg also compares `BIR.behaviour b` with LCB's own evaluator on the emitted body, an executable cross-check of `emit_correct`.
6a. **AArch64:** a GitHub-hosted AArch64 macOS job (`macos-15`) builds the LCB output for `aarch64-macos`, runs gates 4 and 6 there natively, and compares against Lean. LLVM-native also runs there, as a third cross-check. Gates 4 and 6 for x86-64 run on concrete-ci-2.
7. **Certificates:** the kernel checks every acceptance and refusal certificate, with measured budgets.
8. **Reproducibility** (implemented, `scripts/checks/compiler/slice0_repro.sh`): two independent builds give byte-identical outputs at every stage, on each target, and GitHub-hosted `ubuntu-24.04` and concrete-ci-2 give identical Linux manifests after their runner provenance is verified. See [Reproducible builds](#reproducible-builds-owner-2026-11-07).
9. **Trusted base** (owner, 2026-11-07): a golden test that `concrete facts` prints exactly the spec's premise list, so a premise added, removed or reworded anywhere fails until the golden is updated with it. Implemented provisionally in `scripts/checks/compiler/slice0_trusted_base.sh`: until `concrete facts` exists, `scripts/checks/compiler/slice0_trusted_base.lean` prints `Premises.report`: the premise registry `Concrete/Premises.lean`, the sorted axioms of each headline theorem (`Premises.theorems`) and each axiom's type; the gate appends the Lean toolchain and the Lake pins, and the result must equal `tests/golden/slice0_trusted_base.txt` byte for byte. The README's open-premise table must equal the registry's rendering (`Premises.tableRow`). Controls cover the comparison, a failing printer, the axiom collection and a drifted table. The statements are text until `FrontendPremises` and `NativePremises` land as Lean structures; each entry then names its field.
10. **Sanitizers** (owner, 2026-11-07; UBSan dropped by the owner, 2026-11-08; implemented in `scripts/checks/compiler/slice0_artifacts.sh`): every LLVM example also runs built with ASan in CI, and must give the same observation with no sanitizer report. ASan instruments only functions marked `sanitize_address`, which clang's C front end adds and the printed IR lacks, so the sanitizer build adds it to every definition (`slice0_native.sh sanitize`); a control body with an out-of-bounds load must be reported. There is no UBSan leg: UBSan's checks are inserted by clang's C front end, so on LLVM IR input it checks nothing. No C is compiled in slice 0, and the LLVM-level undefined behaviour of the printed IR (poison, `unreachable`) stays P_print's.
fails unless every dependency checkout is at the revision `lake-manifest.json` pins with no
modified or untracked (not ignored) file. The
planned `concrete facts` command will print this identity.

`scripts/checks/compiler/slice0_repro.sh [MANIFEST]` makes two independent builds: two source copies at
different paths with different TMPDIRs, each compiling the compiler, its dependencies and the `lcb`
executable itself, with no Lake artifact cache. They share only the pinned Lean toolchain and the
dependency sources (tracked files only). Each side
emits every hand-written BIR example and builds it natively, and every stage is compared without
normalization: the BIR and adapted LCB value dumps, both text formats, both LCB assembly outputs,
all objects and both executables. Negative controls check that the comparator refuses a flipped
byte, a missing artifact and a differing inventory. The slice-0 front end is not implemented yet, so
this gate starts at the hand-written BIR contract.

Both native gates use `scripts/checks/lib/slice0_native.sh` (a build helper, not a gate): the Nix-pinned clang 21 (`CONCRETE_SLICE0_CLANG`; the
shell's general `clang` is unchanged), an environment reduced to `PATH`, `HOME` and `TMPDIR`
(reduced, not hermetic), fixed relative object names and link order, epoch 1, UTC/C locale, no
debug information, path prefix maps, and no ELF build ID or Mach-O UUID (`ZERO_AR_DATE=1` on
both paths). The printers traverse ordered lists/arrays (including stable first-occurrence
intrinsic deduplication); site paths are project-relative source data. They emit no clock,
hostname or temporary path. CI repeats this on x86-64 Linux and AArch64 macOS. The Linux manifests
record the runner-reported `runner_environment` and `runner_name`; `compare-linux` requires one
manifest with `runner_environment=github-hosted` and one with `runner_environment=self-hosted` and
a `concrete-ci-2-gha<N>` runner name, excludes only that provenance, and compares every
build-identity and artifact-hash line. On `pull_request`, `linux-ci2` uses a GitHub-hosted runner
and its first step fails rather than accepting a substitute or executing PR code on concrete-ci-2;
pushes to main and dispatch runs use concrete-ci-2. Different targets are never compared. Changes to
these pins change the build identity; no reproducibility claim spans different toolchains or targets.

Every slice-0 gate runs under `scripts/checks/lib/limits.sh` (per-process address space 64 GiB on
Linux, since Lake reserves far more than it uses; at most 40000 processes for the user), with
every in-gate time bound (builds, emitter calls, analyses, executables) through `bounded_run`
(time, its whole process group killed, one re-run with a larger budget; a run that times out twice
is INCOMPLETE, listed when the gate exits, and makes the gate fail rather than pass; the CI job's
outer `timeout` is only a runaway guard). Every executable under test also runs under `lib/limited_exec.sh` (1 GiB address space, no core
file). Darwin does not enforce an address-space limit, so there the CI job's memory is the bound.
### Cross-machine reproducibility includes concrete-ci-2 (ISS-0029) (2026-11-08)

The required Linux reproducibility legs are now `linux-github` on GitHub-hosted `ubuntu-24.04` and
`linux-ci2` on self-hosted concrete-ci-2 for pushes to main and dispatch runs. On `pull_request`,
`linux-ci2` selects a GitHub-hosted runner and fails in its first step rather than running PR code
on concrete-ci-2 or passing on a substitute. Each manifest records the runner-reported environment
and name; `compare-linux` requires GitHub-hosted provenance for one and self-hosted provenance with
a `concrete-ci-2-gha<N>` name for the other, then compares all build-identity and artifact SHA-256
lines. Missing manifests or hashes, wrong provenance and differing artifacts fail closed. The
workflow check parses the runner guard and runs the extracted comparison step against passing and
failing fixture manifests.
     1	#!/usr/bin/env python3
     2	"""Compare GitHub-hosted and concrete-ci-2 slice-0 manifests, fail closed.
     3	
     4	usage: repro_manifest_compare.py GITHUB_MANIFEST CI2_MANIFEST
     5	
     6	Runner provenance is validated but excluded from the payload comparison. Every other line,
     7	including build identity and artifact SHA-256 records, must match exactly.
     8	"""
     9	import difflib
    10	import re
    11	import sys
    12	from pathlib import Path
    13	
    14	PROVENANCE = ('runner_environment', 'runner_name')
    15	CI2_RUNNER_NAME = re.compile(r'^concrete-ci-2-gha[0-9]+$')
    16	ARTIFACT = re.compile(r'[0-9a-f]{64}  .+')
    17	
    18	
    19	def fail(message):
    20	    sys.exit(f'FAIL cross-machine reproducibility: {message}')
    21	
    22	
    23	def read_manifest(argument):
    24	    path = Path(argument)
    25	    try:
    26	        lines = path.read_text().splitlines()
    27	    except (OSError, UnicodeError) as error:
    28	        fail(f'{path}: cannot read manifest ({error})')
    29	    fields = {}
    30	    payload = []
    31	    for line in lines:
    32	        key, separator, value = line.partition('=')
    33	        if separator and key in PROVENANCE:
    34	            if key in fields:
    35	                fail(f'{path}: duplicate {key}')
    36	            if not value:
    37	                fail(f'{path}: empty {key}')
    38	            fields[key] = value
    39	        else:
    40	            payload.append(line)
    41	    for key in PROVENANCE:
    42	        if key not in fields:
    43	            fail(f'{path}: missing {key}')
    44	    if not any(line.startswith('compiler_commit=') for line in payload):
    45	        fail(f'{path}: missing compiler_commit')
    46	    if not any(ARTIFACT.fullmatch(line) and line.endswith('/lcb.exe') for line in payload):
    47	        fail(f'{path}: missing lcb.exe SHA-256')
    48	    return fields, payload
    49	
    50	
    51	def check_provenance(path, fields, environment):
    52	    if fields['runner_environment'] != environment:
    53	        fail(f"{path}: expected runner_environment={environment}, "
    54	             f"got {fields['runner_environment']}")
    55	    if fields['runner_name'] == 'unknown':
    56	        fail(f'{path}: runner_name was not recorded')
    57	
    58	
    59	def main(argv):
    60	    if len(argv) != 3:
    61	        sys.exit(__doc__)
    62	    github, github_payload = read_manifest(argv[1])
    63	    ci2, ci2_payload = read_manifest(argv[2])
    64	    check_provenance(argv[1], github, 'github-hosted')
    65	    check_provenance(argv[2], ci2, 'self-hosted')
    66	    if not CI2_RUNNER_NAME.fullmatch(ci2['runner_name']):
    67	        fail(f"{argv[2]}: expected runner_name matching {CI2_RUNNER_NAME.pattern}, "
    68	             f"got {ci2['runner_name']}")
    69	    if github_payload != ci2_payload:
    70	        diff = difflib.unified_diff(github_payload, ci2_payload,
    71	                                    fromfile=argv[1], tofile=argv[2], lineterm='')
    72	        sys.stderr.write('\n'.join(diff) + '\n')
    73	        fail('GitHub-hosted and concrete-ci-2 manifests differ')
    74	    print('PASS cross-machine reproducibility: GitHub-hosted and concrete-ci-2 manifests match')
    75	
    76	
    77	if __name__ == '__main__':
    78	    main(sys.argv)
    65	        f"reproducibility legs are {sorted(by_id)}")
    66	require(by_id["linux-github"]["runner"] == "ubuntu-24.04",
    67	        "linux-github is not GitHub-hosted ubuntu-24.04")
    68	ci2_runner = by_id["linux-ci2"]["runner"]
    69	require(ci2_runner == '${{ github.event_name != \'pull_request\' && fromJSON(\'["self-hosted","linux","x64","concrete"]\') || \'ubuntu-24.04\' }}',
    70	        f"linux-ci2 does not exclude self-hosted runners on pull_request: {ci2_runner}")
    71	require(by_id["linux-ci2"]["machine"] == "concrete-ci-2",
    72	        "linux-ci2 does not record its machine")
    73	require(by_id["macos"]["runner"] == "macos-15", "the macOS leg changed")
    74	require(repro["runs-on"] == "${{ matrix.runner }}", "reproducibility does not use matrix.runner")
    75	guard = repro["steps"][0]
