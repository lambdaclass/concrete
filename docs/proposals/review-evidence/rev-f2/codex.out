    79	require("exit 1" in guard_run and
    80	        all(text in guard_run for text in ("concrete-ci-2", "self-hosted", "pull_request")),
    81	        "the concrete-ci-2 substitute guard does not fail with a clear message")
    82	nix = [step for step in repro["steps"] if step.get("uses") == "cachix/install-nix-action@v31"]
    83	require(len(nix) == 1 and nix[0].get("if") == "runner.environment != 'self-hosted'",
    84	        "Nix installation is not GitHub-hosted-only")
    85	build = next(step for step in repro["steps"]
    86	             if "slice0_repro.sh" in step.get("run", ""))
    87	require(build["env"]["CONCRETE_REPRO_RUNNER_ENVIRONMENT"] == "${{ runner.environment }}",
    88	        "runner.environment is not recorded")
    89	require(build["env"]["CONCRETE_REPRO_RUNNER_NAME"] == "${{ runner.name }}",
    90	        "runner.name is not recorded")
    91	require("CONCRETE_REPRO_RUNNER_HOST" not in build["env"],
    92	        "runner_host is declared by the matrix and is not runner attestation")
    93	compare = jobs["compare-linux"]
