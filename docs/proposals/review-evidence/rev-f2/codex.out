#!/usr/bin/env bash
# Slice-0 reproducibility gate (Concrete/README.md, gate 8). Two independent builds of the compiler
# and of LCB, from two source copies with different paths and TMPDIRs, emit every hand-written BIR
# example and build it natively; every stage is compared byte for byte, with no normalization.
# The two sides share only the pinned Lean toolchain and the dependency SOURCES (each side compiles
# them itself, with no Lake artifact cache). The comparator is checked by negative controls: a flipped byte, a missing artifact
# and a differing inventory must each be refused.
#
#   slice0_repro.sh [MANIFEST]   (inside nix develop, from the repository root)
#
# MANIFEST gets runner provenance, the build identity and one hash per artifact; CI compares the
# GitHub-hosted and concrete-ci-2 manifests of the same target.
set -euo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
cd "$root"
# shellcheck source=scripts/checks/lib/limits.sh
source scripts/checks/lib/limits.sh
# shellcheck source=scripts/checks/lib/slice0_sources.sh
source scripts/checks/lib/slice0_sources.sh
gate_limits 64 40000
work=$(mktemp -d)
# On every exit, the bounded-run summary (recovered and INCOMPLETE runs) goes to stdout before the
# scratch directory is removed, and a gate that would pass with an INCOMPLETE run exits 3 instead.
trap 'rc=$?; bounded_summary || true
  if [ "$rc" = 0 ] && grep -Eqs "^(incomplete|runner-failed)" "${BOUNDED_LOG:-/nonexistent}"; then
    echo "INCOMPLETE: a bounded run timed out twice; not a pass"; rc=3
  fi
  rm -rf "${work:?}"; exit "$rc"' EXIT
BOUNDED_PARENT="$work"
# shellcheck source=scripts/checks/lib/bounded.sh
source scripts/checks/lib/bounded.sh
[ "$BOUNDED_HAVE_WATCHDOG" = 1 ] || { echo "slice0_repro: python3 is required for bounded runs" >&2; exit 2; }
# bounded SECS CMD...: CMD through bounded_run (stdin /dev/null, one re-run on a timeout; a second
# timeout returns 124 with no output and is reported INCOMPLETE, never a pass).
bounded() {
  local secs=$1 rc=0
  shift
  bounded_run -i /dev/null "$secs" -- "$@" || rc=$?
  if [ "$rc" != 0 ] && bounded_is_incomplete "$rc"; then
    echo "slice0_repro: INCOMPLETE (timed out twice): $*" >&2
  fi
  return "$rc"
}
manifest=${1:-}
[ -z "$manifest" ] || manifest=$(realpath -m "$manifest")
compare=(python3 "$root/scripts/checks/lib/repro_compare.py")
# Materialize the dependency checkouts (no build): they must be the manifest's clean revisions,
# which build_identity.sh checks before anything is built.
bounded 600 lake env true
bash scripts/checks/compiler/build_identity.sh > "$work/identity"
target=$(bash scripts/checks/lib/slice0_native.sh target)
# Working source edits are included (the identity records their digest); no build product is.
for side in first second; do
  d="$work/$side/checkout-with-$side-path"
  mkdir -p "$d/.lake/packages" "$work/$side/tmp"
  git ls-files -z -- "${slice0_sources[@]}" |
    tar --null -T - -cf - | tar -xf - -C "$d"
  # Dependency checkouts: tracked files and .git (which Lake checks against the manifest) only.
  for pkg in .lake/packages/*/; do
    pkg=$(basename "$pkg")
    mkdir -p "$d/.lake/packages/$pkg"
    (cd ".lake/packages/$pkg" && { git ls-files -z; printf '.git\0'; } | tar --null -T - -cf -) |
      tar -xf - -C "$d/.lake/packages/$pkg"
  done
  (
    cd "$d"
    export TMPDIR="$work/$side/tmp" LC_ALL=C TZ=UTC SOURCE_DATE_EPOCH=1 ZERO_AR_DATE=1
    # No Lake artifact cache: each side compiles everything it uses.
    export LAKE_ARTIFACT_CACHE=false LAKE_CACHE_DIR="$work/$side/lake-cache"
    bounded 3000 lake build Concrete lean-compiler-backend/lcb >"$work/$side/build.log" 2>&1 ||
      { tail -50 "$work/$side/build.log" >&2; echo "slice0_repro: $side: build failed" >&2; exit 1; }
    lcb="$d/.lake/packages/lean-compiler-backend/.lake/build/bin/lcb"
    bounded 120 lake env lean --run scripts/checks/compiler/slice0_bir.lean list > names
    [ -s names ] || { echo 'slice0_repro: no examples' >&2; exit 1; }
    while read -r name; do
      bounded 120 lake env lean --run scripts/checks/compiler/slice0_bir.lean emit "$name" "$d/out/$name" "$target"
      bounded 120 bash scripts/checks/lib/slice0_native.sh "$d/out/$name" "$lcb"
    done < names
  )
done
a="$work/first/checkout-with-first-path"
b="$work/second/checkout-with-second-path"
"${compare[@]}" "$a" "$b" "$work/identity" ${manifest:+"$manifest"}

# Negative controls: the comparator must refuse each perturbation of an identical pair.
control() { # control LABEL EXPECTED-MESSAGE SETUP...
  local label=$1 expect=$2 c="$work/ctl/$1" rc=0; shift 2
  mkdir -p "$c"
  cp -R "$a" "$c/a"; cp -R "$a" "$c/b"
  (cd "$c/b" && "$@")
  "${compare[@]}" "$c/a" "$c/b" "$work/identity" >"$c/log" 2>&1 || rc=$?
  if [ "$rc" = 0 ] || ! grep -qF -- "$expect" "$c/log"; then
    echo "FAIL slice0_repro control $label: not refused as '$expect'" >&2; cat "$c/log" >&2; exit 1
  fi
  echo "ok slice0_repro control $label: refused"
}
first=$(head -1 "$a/names")
flip() { python3 -c 'import sys;p=sys.argv[1];d=bytearray(open(p,"rb").read());d[len(d)//2]^=1;open(p,"wb").write(d)' "$1"; }
control flipped-byte "$first: lcb.exe:" flip "out/$first/lcb.exe"
control missing-artifact "$first: lcb_rt.o: missing" rm "out/$first/lcb_rt.o"
control inventory 'example inventory differs' sh -c 'echo extra >> names'
echo 'PASS slice0_repro'
#!/usr/bin/env python3
"""Compare the stage outputs of two independent slice-0 builds, byte for byte.

usage: repro_compare.py SIDE_A SIDE_B IDENTITY [MANIFEST]

Each SIDE holds `names` (the example inventory) and `out/NAME/STAGE` for every stage. Every file
is read on both sides: a missing file, a differing inventory or one differing byte fails. With
MANIFEST, writes runner provenance and the identity lines followed by one `SHA256  NAME/STAGE`
line per artifact.
"""
import hashlib
import os
import sys
from pathlib import Path

STAGES = ['bir.txt', 'llvm.ll', 'lcb_job.txt', 'lcb_source.txt', 'lcb_body.ssa', 'lcb_body.s',
          'lcb_rt.ssa', 'lcb_rt.s', 'llvm.o', 'lcb_body.o', 'lcb_rt.o', 'llvm.exe', 'lcb.exe']


def main(argv):
    if len(argv) not in (4, 5):
        sys.exit(__doc__)
    a, b, identity = Path(argv[1]), Path(argv[2]), Path(argv[3])
    names = (a / 'names').read_bytes()
    if names != (b / 'names').read_bytes():
        sys.exit('FAIL slice0_repro: example inventory differs')
    if not names.strip():
        sys.exit('FAIL slice0_repro: no examples')
    lines = identity.read_text().splitlines()
    for name in names.decode().splitlines():
        for stage in STAGES:
            try:
                hashes = [hashlib.sha256((d / 'out' / name / stage).read_bytes()).hexdigest()
                          for d in (a, b)]
            except FileNotFoundError as e:
                sys.exit(f'FAIL slice0_repro: {name}: {stage}: missing ({e.filename})')
            if hashes[0] != hashes[1]:
                sys.exit(f'FAIL slice0_repro: {name}: {stage}: {hashes[0]} != {hashes[1]}')
            lines.append(f'{hashes[0]}  {name}/{stage}')
        print(f'ok slice0_repro: {name}: all stages byte-identical')
    if len(argv) == 5:
        provenance = [
            f"runner_environment={os.environ.get('CONCRETE_REPRO_RUNNER_ENVIRONMENT', 'unknown')}",
            f"runner_name={os.environ.get('CONCRETE_REPRO_RUNNER_NAME', 'unknown')}",
        ]
        Path(argv[4]).write_text('\n'.join(provenance + lines) + '\n')


if __name__ == '__main__':
    main(sys.argv)
#!/usr/bin/env bash
# Workflow-YAML gate.
#
# GitHub Actions workflows that fail to PARSE do not run at all — they report a
# 0-second "completed failure" with no logs, so every gate they were supposed to
# run is silently skipped. This actually happened: a `name:` value that began
# with a backtick (`` ` `` is a reserved YAML indicator and cannot start a plain
# scalar) killed `lean_action_ci.yml` for 40+ consecutive pushes without any
# obvious signal. This gate parses every workflow locally so a malformed file is
# caught before it is pushed, not after CI has been dark for days.
#
# Uses python3+PyYAML if available, otherwise ruby's psych (both ship the parser
# GitHub uses closely enough to catch indicator/indentation errors).

set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
# Per-run scratch (R-0546): a fixed /tmp path collides with a concurrent run of this gate.
GATE_TMP="$(mktemp -d)"; trap 'rm -rf "$GATE_TMP"' EXIT
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"

WF_DIR=".github/workflows"
[ -d "$WF_DIR" ] || { echo "no $WF_DIR — nothing to check"; exit 0; }

parse_one() {
  local f="$1"
  if python3 -c 'import yaml,sys; yaml.safe_load(open(sys.argv[1]))' "$f" 2>"$GATE_TMP/wfyaml.err"; then
    return 0
  fi
  # python3 missing PyYAML (ModuleNotFoundError) → fall back to ruby
  if grep -q "No module named 'yaml'" "$GATE_TMP/wfyaml.err" 2>/dev/null; then
    ruby -ryaml -e "YAML.load_file(ARGV[0])" "$f" 2>"$GATE_TMP/wfyaml.err"
    return $?
  fi
  return 1
}

PASS=0; FAIL=0
for f in "$WF_DIR"/*.yml "$WF_DIR"/*.yaml; do
  [ -e "$f" ] || continue
  if parse_one "$f"; then
    echo "  ok   $f"; PASS=$((PASS+1))
  else
    echo "  FAIL $f"; sed 's/^/         /' "$GATE_TMP/wfyaml.err" | head -4; FAIL=$((FAIL+1))
  fi
done

echo "=== cross-machine reproducibility (ISS-0029) ==="
if python3 -I - "$WF_DIR/lean_action_ci.yml" "$GATE_TMP/compare-linux.sh" <<'PY'
import sys
from pathlib import Path
import yaml

workflow, output = sys.argv[1:]
jobs = yaml.safe_load(open(workflow))["jobs"]
repro = jobs["reproducibility"]
rows = repro["strategy"]["matrix"]["include"]
by_id = {row["id"]: row for row in rows}

def require(condition, message):
    if not condition:
        raise ValueError(message)

require(set(by_id) == {"linux-github", "linux-ci2", "macos"},
        f"reproducibility legs are {sorted(by_id)}")
require(by_id["linux-github"]["runner"] == "ubuntu-24.04",
        "linux-github is not GitHub-hosted ubuntu-24.04")
ci2_runner = by_id["linux-ci2"]["runner"]
require(ci2_runner == '${{ github.event_name != \'pull_request\' && fromJSON(\'["self-hosted","linux","x64","concrete"]\') || \'ubuntu-24.04\' }}',
        f"linux-ci2 does not exclude self-hosted runners on pull_request: {ci2_runner}")
require(by_id["linux-ci2"]["machine"] == "concrete-ci-2",
        "linux-ci2 does not record its machine")
require(by_id["macos"]["runner"] == "macos-15", "the macOS leg changed")
require(repro["runs-on"] == "${{ matrix.runner }}", "reproducibility does not use matrix.runner")
guard = repro["steps"][0]
require(guard.get("if") == "matrix.machine == 'concrete-ci-2' && runner.environment != 'self-hosted'",
        "the first step does not guard a non-self-hosted concrete-ci-2 leg")
guard_run = guard.get("run", "")
require("exit 1" in guard_run and
        all(text in guard_run for text in ("concrete-ci-2", "self-hosted", "pull_request")),
        "the concrete-ci-2 substitute guard does not fail with a clear message")
nix = [step for step in repro["steps"] if step.get("uses") == "cachix/install-nix-action@v31"]
require(len(nix) == 1 and nix[0].get("if") == "runner.environment != 'self-hosted'",
        "Nix installation is not GitHub-hosted-only")
build = next(step for step in repro["steps"]
             if "slice0_repro.sh" in step.get("run", ""))
require(build["env"]["CONCRETE_REPRO_RUNNER_ENVIRONMENT"] == "${{ runner.environment }}",
        "runner.environment is not recorded")
require(build["env"]["CONCRETE_REPRO_RUNNER_NAME"] == "${{ runner.name }}",
        "runner.name is not recorded")
require("CONCRETE_REPRO_RUNNER_HOST" not in build["env"],
        "runner_host is declared by the matrix and is not runner attestation")
compare = jobs["compare-linux"]
require(compare["needs"] == "reproducibility", "compare-linux does not need both Linux legs")
download = next(step for step in compare["steps"]
                if step.get("uses") == "actions/download-artifact@v4")
require(download["with"]["pattern"] == "reproducibility-linux-*",
        "compare-linux does not download the Linux manifests")
run = next(step["run"] for step in compare["steps"]
           if "repro_manifest_compare.py" in step.get("run", ""))
for text in ("reproducibility-linux-github/manifest.txt",
             "reproducibility-linux-ci2/manifest.txt"):
    require(text in run, f"compare-linux does not read {text}")
Path(output).write_text(run)
PY
then
  echo "  ok   workflow excludes self-hosted ci2 on pull_request and refuses substitutes"; PASS=$((PASS+1))
else
  echo "  FAIL workflow reproducibility structure"; FAIL=$((FAIL+1))
fi

write_manifest() { # PATH ENVIRONMENT RUNNER_NAME HASH
  mkdir -p "${1%/*}"
  {
    printf 'runner_environment=%s\n' "$2"
    printf 'runner_name=%s\n' "$3"
    printf 'compiler_commit=0123456789abcdef\n'
    printf 'target=x86_64-linux\n'
    [ "$4" = none ] || printf '%s  example/lcb.exe\n' "$4"
  } > "$1"
}

compare_control() { # LABEL SECOND_ENVIRONMENT SECOND_RUNNER_NAME SECOND_HASH SECOND_KIND EXPECTED_ERROR
  local label=$1 env=$2 name=$3 hash=$4 kind=$5 expected=$6
  local d="$GATE_TMP/repro-$label" rc=0
  mkdir -p "$d/scripts/checks/lib"
  cp scripts/checks/lib/repro_manifest_compare.py "$d/scripts/checks/lib/"
  write_manifest "$d/manifests/reproducibility-linux-github/manifest.txt" \
    github-hosted github-actions aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
  if [ "$kind" != missing ]; then
    write_manifest "$d/manifests/reproducibility-linux-ci2/manifest.txt" \
      "$env" "$name" "$hash"
  fi
  (cd "$d" && bash "$GATE_TMP/compare-linux.sh") > "$d/output" 2>&1 || rc=$?
  if [ -z "$expected" ]; then
    if [ "$rc" = 0 ]; then
      echo "  ok   comparison control $label passes"; PASS=$((PASS+1))
    else
      echo "  FAIL comparison control $label refused"; sed 's/^/         /' "$d/output"; FAIL=$((FAIL+1))
    fi
  elif [ "$rc" != 0 ] && has_match -F "$expected" < "$d/output"; then
    echo "  ok   comparison control $label is refused"; PASS=$((PASS+1))
  else
    echo "  FAIL comparison control $label was not refused as '$expected' (rc=$rc)"
    sed 's/^/         /' "$d/output"; FAIL=$((FAIL+1))
  fi
}

if [ -s "$GATE_TMP/compare-linux.sh" ]; then
  a=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
  b=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
  compare_control identical self-hosted concrete-ci-2-gha1 "$a" normal ""
  compare_control differing-ci2 self-hosted concrete-ci-2-gha1 "$b" normal "manifests differ"
  compare_control wrong-ci2-name self-hosted concrete-ci-2-worker "$a" normal \
    "expected runner_name matching ^concrete-ci-2-gha[0-9]+$"
  compare_control two-github github-hosted concrete-ci-2-gha1 "$a" normal \
    "expected runner_environment=self-hosted"
  compare_control missing-manifest self-hosted concrete-ci-2-gha1 "$a" missing "cannot read manifest"
  compare_control missing-hashes self-hosted concrete-ci-2-gha1 none normal "missing lcb.exe SHA-256"
fi

echo ""
echo "WORKFLOW-YAML: PASS=$PASS  FAIL=$FAIL"
[ "$FAIL" -eq 0 ]
name: CI

# The root's CI after the legacy/ move. Eighteen jobs, all required (required-checks.txt):
#   Landing record  main's push run names the run that qualified its exact SHA (R-0570), kept from
#                the base unchanged; when it finds one, the jobs below are skipped on main.
#   Root checks  every check of scripts/checks/run.sh: legacy/ frozen, the day-one root inventory,
#                workflow YAML, Markdown links, the landing script and readiness, the review tool.
#   Spec build   lake build of the specification, warnings refused.
#   Proof axioms, Proof trust ban (sorry, native_decide), Kernel replay (leanchecker), External
#                re-check (con-leche, nanoda)  the proof-integrity checks of scripts/proofs.
#   Slice 0 backends, artifacts, trusted base, reproducibility (x86-64 Linux and AArch64 macOS)
#                the compiler's gates (scripts/checks/compiler), each in the compiler's devshell.
#   Oracle (GitHub-hosted fetch + smoke)  the published oracle fetched, verified and run on a
#                GitHub-hosted runner (ISS-0005, P13; R-0564), kept from the base unchanged.
# legacy/ is never built or run here: its gates were qualified at tag legacy-compiler-final. The old
# workflows are archived, unrun, under legacy/.github/workflows.
# A train's dispatch names its base: the run's title then says which base it was built on, and
# main's Landing record accepts a run only for the base main had before the push (R-0570).
run-name: ${{ github.event_name == 'workflow_dispatch' && inputs.base != '' && format('{0} at base {1}', github.ref_name, inputs.base) || '' }}

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:
    inputs:
      base:
        # THE BASE OF A TRAIN'S CANDIDATE, passed by train.sh ci (-f base=<sha>). The root has no
        # base-sensitive check yet; the title records the base so main's Landing record can require
        # that the run it accepts was built on the base main had before the landing.
        description: "Base SHA of a train's candidate (recorded in the run title)"
        type: string
        required: false
        default: ""

concurrency:
  group: ci-${{ github.ref }}-${{ github.event_name }}
  cancel-in-progress: ${{ github.event_name == 'push' || github.event_name == 'pull_request' }}

# Every run step executes in the gate userland (flake.nix, `gates` shell), which marks itself with
# CONCRETE_GATES_SHELL=1; scripts/checks/lib/gate_env.sh refuses anywhere else. It contains no Lean:
# lean-action's elan toolchain is the one on PATH in the spec job.
defaults:
  run:
    shell: "nix develop .#gates --command bash --noprofile --norc -eo pipefail {0}"

jobs:
  # MAIN'S RUN NAMES THE RUN THAT QUALIFIED ITS EXACT SHA (R-0570), as in the base's workflow. On a
  # push to main this job looks up, with train.sh record, a completed dispatch of this workflow at
  # exactly this SHA and at the base main had before the push, with every required job succeeded.
  # Found: every other job is skipped and the run links it. Not found, or any other event: every job
  # runs. Each job below needs it and carries the gate; check_landing_script.sh holds both.
  landing-record:
    name: Landing record
    runs-on: ${{ (github.event_name != 'pull_request' && vars.CONCRETE_SELF_HOSTED == 'true') && fromJSON('["self-hosted","linux","x64","concrete"]') || 'ubuntu-latest' }}
    timeout-minutes: 15
    permissions:
      actions: read
      contents: read
    outputs:
      recorded: ${{ steps.record.outputs.recorded }}
    steps:
      - uses: actions/checkout@v4
        if: github.event_name == 'push' && github.ref == 'refs/heads/main'

      - name: Install Nix (GitHub-hosted only)
        if: github.event_name == 'push' && github.ref == 'refs/heads/main' && runner.environment != 'self-hosted'
        uses: cachix/install-nix-action@v31
        with:
          extra_nix_config: |
            experimental-features = nix-command flakes

      - name: "Look up the run that qualified this exact SHA (none found: every job runs here)"
        id: record
        if: github.event_name == 'push' && github.ref == 'refs/heads/main'
        env:
          GH_TOKEN: ${{ github.token }}
          BEFORE: ${{ github.event.before }}
          HEAD_SHA: ${{ github.sha }}
          LAND_REPO: unbalancedparentheses/concrete2
          LAND_NO_NIX: "1"
        run: |
          recorded=false run=""
          if out="$(git fetch -q --depth=1 origin "$BEFORE" 2>&1 \
                    && bash scripts/land/train.sh record "$HEAD_SHA" --base "$BEFORE" --exclude-run "$GITHUB_RUN_ID" 2>&1)"; then
            run="$(printf '%s\n' "$out" | sed -n 's/^qualifying_run=\([0-9][0-9]*\)$/\1/p' | tail -1)"
          fi
          printf '%s\n' "$out"
          if [ -n "$run" ]; then
            recorded=true
            { echo "### Landing record"
              echo "Run [$run](https://github.com/$LAND_REPO/actions/runs/$run) passed every landing-tier and required job at exactly \`$HEAD_SHA\`."
              echo "This run skips those jobs: that run is the result for this SHA."; } >> "$GITHUB_STEP_SUMMARY"
          else
            { echo "### No landing record"
              echo "No run qualifies \`$HEAD_SHA\`, so every job runs here:"
              printf '\n```\n%s\n```\n' "$out"; } >> "$GITHUB_STEP_SUMMARY"
          fi
          echo "recorded=$recorded" >> "$GITHUB_OUTPUT"

  root-checks:
    name: Root checks
    needs: landing-record
    if: ${{ !cancelled() && needs.landing-record.outputs.recorded != 'true' }}
    # Self-hosted runners never take pull_request events (forks could run code on them).
    runs-on: ${{ (github.event_name != 'pull_request' && vars.CONCRETE_SELF_HOSTED == 'true') && fromJSON('["self-hosted","linux","x64","concrete"]') || 'ubuntu-latest' }}
    steps:
      # Full history: legacy_frozen.sh reads the move commit named in scripts/checks/legacy.lock.
      - uses: actions/checkout@v4
        with:
          key: ${{ runner.os }}-concrete-ext-${{ hashFiles('scripts/proofs/external.pins', 'lean-toolchain') }}

      - name: Install Lean and build the specification (via lean-action)
        id: lean_install
        continue-on-error: true
        uses: leanprover/lean-action@v1
        with:
          build-args: "--log-level=warning"

      - name: Wait before retrying the Lean install
        if: steps.lean_install.outcome == 'failure'
        run: sleep 60

      - name: Install Lean and build the specification (via lean-action) (retry)
        if: steps.lean_install.outcome == 'failure'
        uses: leanprover/lean-action@v1
        with:
          build-args: "--log-level=warning"

      - name: External re-check (con-leche, nanoda) (scripts/proofs/external.sh)
        shell: "nix develop .#extcheck --command bash --noprofile --norc -eo pipefail {0}"
        run: bash scripts/proofs/external.sh

  # The oracle check on a GitHub-hosted runner (ISS-0005, P13; R-0564): proves that a runner other than
  # concrete-ci-2 gets a verified oracle from the release alone. A missing, corrupt or unverifiable
  # artifact makes ci_check.sh exit 3 (INCOMPLETE) and the job fail: it is never reported as passed.
  # It is a GitHub-hosted job, so a pull_request may run it (no self-hosted runner is involved).
  oracle-hosted:
    name: Oracle (GitHub-hosted fetch + smoke)
    needs: landing-record
    if: ${{ !cancelled() && needs.landing-record.outputs.recorded != 'true' }}
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4

      - name: Install Nix
        uses: cachix/install-nix-action@v31
        with:
          extra_nix_config: |
            experimental-features = nix-command flakes

      - name: "Oracle fetch (missing, corrupt or unverifiable artifact is INCOMPLETE; negative controls)"
        run: bash scripts/checks/oracle_fetch.sh

      - name: "Fetch the published oracle, verify it, run smoke.con through it (exit 42)"
        run: bash scripts/oracle/ci_check.sh

  # THE COMPILER'S GATES (Concrete/README.md gates 4, 6, 6a, 8, 9, 10, 11 and 12; slice 0, provisional),
  # scripts/checks/compiler/: not root checks (run.sh runs only scripts/checks/*.sh), because they need
  # the compiler's devshell, a native macOS runner and minutes each. Every hand-written BIR example
  # through the LLVM path and the LCB path, each executable's observation compared with the BIR
  # semantics; sanitizers, binary size (report-only) and the stack bound; the trusted-base golden; and
  # every build stage reproduced in distinct directories and on distinct machines. Each runs natively
  # on x86-64 Linux and on AArch64 macOS (LCB's first native proof profile is Apple AArch64), and every
  # matrix leg is a required job of its own name.
  backends:
    name: Slice 0 backends (${{ matrix.arch }})
    needs: landing-record
    if: ${{ !cancelled() && needs.landing-record.outputs.recorded != 'true' }}
    # The compiler's devshell (flake.nix default: Lean, clang, LLVM, gdb/lldb), entered per step;
    # the gates shell has no Lean.
    defaults:
      run:
        shell: bash
    strategy:
      fail-fast: false
      matrix:
        include:
          - arch: x86-64
            runner: ubuntu-latest
          - arch: aarch64-macos
            runner: macos-15
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 60
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - name: Install Nix
        uses: cachix/install-nix-action@v31
      - name: Backend gate (LLVM and LCB, native)
        run: nix develop --command bash scripts/checks/compiler/slice0_backends.sh

  artifacts:
    name: Slice 0 artifacts (${{ matrix.arch }})
    needs: landing-record
    if: ${{ !cancelled() && needs.landing-record.outputs.recorded != 'true' }}
    # The compiler's devshell (flake.nix default: Lean, clang, LLVM, gdb/lldb), entered per step;
    # the gates shell has no Lean.
    defaults:
      run:
        shell: bash
    strategy:
      fail-fast: false
      matrix:
        include:
          - arch: x86-64
            runner: ubuntu-latest
          - arch: aarch64-macos
            runner: macos-15
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 60
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - name: Install Nix
        uses: cachix/install-nix-action@v31
      - name: Sanitizers, binary size (report-only) and stack bound (gates 10, 11, 12)
        run: nix develop --command timeout 3000 bash scripts/checks/compiler/slice0_artifacts.sh report
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: artifacts-${{ matrix.arch }}
          path: report
          if-no-files-found: error

  trusted-base:
    name: Slice 0 trusted base (gate 9, ${{ matrix.arch }})
    needs: landing-record
    if: ${{ !cancelled() && needs.landing-record.outputs.recorded != 'true' }}
    # The compiler's devshell (flake.nix default: Lean, clang, LLVM, gdb/lldb), entered per step;
    # the gates shell has no Lean.
    defaults:
      run:
        shell: bash
    strategy:
      fail-fast: false
      matrix:
        include:
          - arch: x86-64
            runner: ubuntu-latest
          - arch: aarch64-macos
            runner: macos-15
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 60
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - name: Install Nix
        uses: cachix/install-nix-action@v31
      - name: Trusted-base golden (premises, axioms, toolchain and LCB pin)
        run: nix develop --command timeout 3000 bash scripts/checks/compiler/slice0_trusted_base.sh

  reproducibility:
    name: Reproducibility (${{ matrix.id }})
    needs: landing-record
    if: ${{ !cancelled() && needs.landing-record.outputs.recorded != 'true' }}
    # The compiler's devshell (flake.nix default: Lean, clang, LLVM, gdb/lldb), entered per step;
    # the gates shell has no Lean.
    defaults:
      run:
        shell: bash
    strategy:
      fail-fast: false
      matrix:
        include:
          - id: linux-github
            runner: ubuntu-24.04
            machine: github
          - id: linux-ci2
            runner: ${{ github.event_name != 'pull_request' && fromJSON('["self-hosted","linux","x64","concrete"]') || 'ubuntu-24.04' }}
            machine: concrete-ci-2
          - id: macos
            runner: macos-15
            machine: github
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 60
    permissions:
      contents: read
    steps:
      - name: Refuse a substitute for concrete-ci-2
        if: matrix.machine == 'concrete-ci-2' && runner.environment != 'self-hosted'
        run: |
          echo "::error::linux-ci2 requires self-hosted concrete-ci-2; pull_request cannot use it, so this leg is intentionally red"
          exit 1
      - uses: actions/checkout@v4
      - name: Install Nix (GitHub-hosted only)
        if: runner.environment != 'self-hosted'
        uses: cachix/install-nix-action@v31
      - name: Compare every stage in distinct build directories
        env:
          CONCRETE_REPRO_RUNNER_ENVIRONMENT: ${{ runner.environment }}
          CONCRETE_REPRO_RUNNER_NAME: ${{ runner.name }}
        run: nix develop --command timeout 3600 bash scripts/checks/compiler/slice0_repro.sh manifest.txt
      - uses: actions/upload-artifact@v4
        with:
          name: reproducibility-${{ matrix.id }}
          path: manifest.txt
          if-no-files-found: error

  compare-linux:
    name: Cross-machine reproducibility (x86-64 Linux)
    needs: reproducibility
    # Runs only when every reproducibility job ran (landing-record gate inherited); no Nix here.
    defaults:
      run:
        shell: bash
    runs-on: ubuntu-24.04
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - uses: actions/download-artifact@v4
        with:
          pattern: reproducibility-linux-*
          path: manifests
      - name: Compare GitHub and concrete-ci-2 artifacts and build identity
        run: |
          set -eu
          m1=manifests/reproducibility-linux-github/manifest.txt
          m2=manifests/reproducibility-linux-ci2/manifest.txt
          python3 scripts/checks/lib/repro_manifest_compare.py "$m1" "$m2"
# Required CI jobs: a train lands only when every job named here ran at the candidate's exact SHA and
# succeeded (scripts/land/train.sh watch and land). One exact job name per line, as GitHub shows it.
# GitHub branch protection is not configured for main, so this file is the record. Every job of
# .github/workflows/lean_action_ci.yml is listed, each matrix leg under the name GitHub shows for it:
# the root has no campaign tier.
Root checks
Spec build
Oracle (GitHub-hosted fetch + smoke)
Landing record
Proof axioms
Proof trust ban (sorry, native_decide)
Kernel replay (leanchecker)
External re-check (con-leche, nanoda)
Slice 0 backends (x86-64)
Slice 0 backends (aarch64-macos)
Slice 0 artifacts (x86-64)
Slice 0 artifacts (aarch64-macos)
Slice 0 trusted base (gate 9, x86-64)
Slice 0 trusted base (gate 9, aarch64-macos)
Reproducibility (linux-github)
Reproducibility (linux-ci2)
Reproducibility (macos)
Cross-machine reproducibility (x86-64 Linux)
# The required-checks transition of the legacy/ move (R-0558, R-0563): one row per job the base's
# required-checks.txt names and this tree's does not. scripts/land/required_checks.py reads it at train
# watch and land: replacements must each be in required-checks.txt (so they run and are checked at
# the exact SHA), and `-` retires the job with a reason; a retired job is reported NOT RUN, never passed.
# "Root checks" keeps its name and is required on both sides, so it has no row. Delete a row once main
# no longer requires its job (required_checks.py reports it stale).
old_job	replacements	reason
Reproducibility (linux-first)	Reproducibility (linux-github)	ISS-0029 names the GitHub-hosted Linux reproducibility leg explicitly
Reproducibility (linux-independent)	Reproducibility (linux-ci2)	ISS-0029 makes concrete-ci-2 the mandatory second Linux reproducibility machine

exec
/bin/bash -lc "rg -n 'required.check|transition|reproduc|R-0577|OD[0-9]' scripts/land/train.sh scripts/checks/required_checks.py docs/decisions.md ROADMAP.md docs/PHILOSOPHY.md scripts/checks/lib/repro* scripts/checks/compiler/slice0* .github/workflows/*.yml" in /tmp/claude-30035/-home-unbalancedparen-projects-concrete2/e2c54e65-31b5-4145-8101-c2d7b071b97e/scratchpad/rev-f2/src
 exited 2 in 0ms:
rg: scripts/checks/required_checks.py: No such file or directory (os error 2)
ROADMAP.md:142:From the first day of the new root, a minimal issue record holds every defect: ID, reproducer or
ROADMAP.md:146:implementation*, never *fixed* (R-0561). Each keeps its reproducer, ruling and structural class.
ROADMAP.md:161:| E. Verified growth | Proof-order items 4–8, the Lean Compiler Backend native path, the verified parser, typed contracts, frame reasoning, termination proofs and the proof library. Earlier slices already contain example-specific program theorems; E expands reusable models and proof support. Contracts have no source `old` and no snapshot construct (OD117): a postcondition reaches the entry state only through an explicit Lean theorem. Spec functions are total (OD115). An ordinary function can get its own termination proof, and there is no total-function category (OD116). | Each item's theorem holds, with its residual assumptions stated. |
ROADMAP.md:172:| T0 | Prepare the restart beside the old tree (decision row P7, approved 2026-11-05) | R-0568, R-0564 | Checklist, each item on main before T1: (1) the new root's CI jobs; (2) `required-checks.txt`, enforced by `train.sh watch` and `train.sh land`; (3) the required-check transition mechanism, an explicit old-to-new job mapping that is validated and needs the replacement checks to pass at the exact candidate SHA, never marking a dropped legacy check passed; (4) `ISSUES.tsv` and its validator; (5) `RETENTION.tsv` and the task disposition table; (6) `scripts/oracle/ORACLE.lock` with the oracle release artifact and its digest; (7) the archive records of the stopped services. |
