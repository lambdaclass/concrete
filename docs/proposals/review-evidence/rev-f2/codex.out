#!/usr/bin/env python3
"""THE REQUIRED-CHECK VERDICT FOR ONE CANDIDATE (train.sh watch and land).

Usage: required_checks.py BASE_FILE CAND_FILE TRANSITION_FILE JOBS_FILE
  BASE_FILE        required-checks.txt as the base (main) has it; empty file if absent
  CAND_FILE        required-checks.txt as the candidate has it; empty file if absent
  TRANSITION_FILE  required-checks-transition.tsv as the candidate has it; empty file if absent
  JOBS_FILE        the run's jobs, "<tier>\\t<conclusion>\\t<id>\\t<name>" per line (train.sh run_jobs)
  (a missing file and an empty file are the same: "the commit has no such file")

Prints one line per finding and exits 0; train.sh refuses when any line starts with an unmet kind:
  missing: <job>            a required job is absent from the run
  <conclusion>: <job>       a required job did not succeed (skipped, cancelled, failure, pending...)
  invalid: <reason>         the files themselves are unusable (nothing required, a bad transition row)
and prints notes that never refuse and never count as a pass:
  retired: <job> (<reason>) a base requirement the candidate retires with no replacement; NOT RUN
  replaced: <job> by <jobs> a base requirement whose replacements are required (and checked) instead
  stale: <job>              a transition row for a job the base no longer requires (delete the row)

THE RULE. The required set is the candidate's list plus every job the base requires, except a base
job the candidate drops through an explicit transition row. Without a row, a dropped base job stays
required, so a candidate cannot weaken main's requirements by editing its own list. A row is
`old_job<TAB>replacements<TAB>reason`: replacements is a comma-separated list of jobs that must
each be in the candidate's list (so they are required and checked at this exact SHA), or `-` to
retire the old job outright, which needs a reason and is reported as retired, never as passed.
A row for a job the candidate still requires is contradictory and refused. Files are read
separately and newline-terminated, so names from two files never fuse.
"""
import sys

UNMET = ("missing:", "invalid:")


def names(path):
    try:
        text = open(path).read()
    except OSError:
        return set()
    out = set()
    for line in text.splitlines():
        line = line.split("#", 1)[0].strip()
        if line:
            out.add(line)
    return out


def transition(path):
    rows, bad = {}, []
    try:
        text = open(path).read()
    except OSError:
        return rows, bad
    for n, line in enumerate(text.splitlines(), 1):
        if not line.strip() or line.startswith("#"):
            continue
        f = line.split("\t")
        if f[0] == "old_job":
            continue  # header
        if len(f) != 3 or not all(x.strip() for x in f):
            bad.append(f"transition row {n} needs old_job, replacements, reason (tab-separated, non-empty)")
            continue
        old, repl, why = (x.strip() for x in f)
        if old in rows:
            bad.append(f"transition row {n} repeats {old}")
            continue
        if repl == "-":
            rows[old] = ([], why)
            continue
        parts = [r.strip() for r in repl.split(",")]
        if not all(parts):
            # "a,,b" or "," must not degrade into a retirement: only a literal "-" retires
            bad.append(f"transition row {n} has an empty replacement name in {repl!r} (use '-' to retire)")
            continue
        rows[old] = (parts, why)
    return rows, bad


def plan(base, cand, rows, bad):
    """-> (required set, findings list)"""
    out = [f"invalid: {b}" for b in bad]
    if not base and not cand:
        out.append("invalid: required-checks.txt (neither the base nor the candidate has one)")
        return set(), out
    req = set(cand)
    for old in sorted(base):
        if old in cand:
            continue
        if old not in rows:
            req.add(old)  # dropped without a transition row: still required
            continue
        repl, why = rows[old]
        if not repl:
            out.append(f"retired: {old} ({why}); not run, not passed")
            continue
        missing = [r for r in repl if r not in cand]
        if missing:
            out.append(f"invalid: replacement {', '.join(missing)} for {old} is not in the candidate's required-checks.txt")
            req.add(old)
            continue
        out.append(f"replaced: {old} by {', '.join(repl)}")
    for old in sorted(rows):
        if old in cand:
            out.append(f"invalid: transition row for {old}, which the candidate still requires")
        elif old not in base:
            out.append(f"stale: {old} (the base does not require it; delete the row)")
    return req, out


def verdict(req, jobs_path):
    seen = {}
    for line in open(jobs_path):
        f = line.rstrip("\n").split("\t")
        if len(f) >= 4:
            seen.setdefault(f[3], []).append(f[1])
    out = []
    for name in sorted(req):
        c = seen.get(name)
        if not c:
            out.append("missing: " + name)
        elif any(x != "success" for x in c):
            out.append(",".join(sorted(set(c))) + ": " + name)
    return out


def main():
    if len(sys.argv) != 5:
        sys.exit(__doc__)
    base, cand = names(sys.argv[1]), names(sys.argv[2])
    rows, bad = transition(sys.argv[3])
    req, notes = plan(base, cand, rows, bad)
    for line in notes + verdict(req, sys.argv[4]):
        print(line)


if __name__ == "__main__":
    main()
#!/usr/bin/env bash
# Canonical build identity, with no timestamps, hostnames or checkout paths.
# The compiler sources are identified by commit AND by a digest of the working-tree content of
# every tracked input (lib/slice0_sources.sh), with `source_tree=dirty` when they differ from the
# commit, so a local edit never reports a committed identity. Every dependency checkout must be
# at the revision lake-manifest.json pins with no modified or untracked file (its ignored `.lake`
# build directory aside); otherwise this script fails. slice0_repro.sh copies only a dependency's
# tracked files and its `.git`, so ignored files never reach the compared builds.
set -euo pipefail
cd "$(dirname "$0")/../../.."
: "${CONCRETE_SLICE0_CLANG:?run inside nix develop}"
# shellcheck source=scripts/checks/lib/slice0_sources.sh
source scripts/checks/lib/slice0_sources.sh
printf 'compiler_commit=%s\n' "$(git rev-parse HEAD)"
if [ -z "$(git status --porcelain --untracked-files=no -- "${slice0_sources[@]}")" ]; then
  echo 'source_tree=clean'
else
  echo 'source_tree=dirty'
fi
git ls-files -z -- "${slice0_sources[@]}" | python3 -c '
import hashlib,sys
paths=sorted(p for p in sys.stdin.buffer.read().split(b"\0") if p)
h=hashlib.sha256()
for p in paths:
    h.update(hashlib.sha256(open(p,"rb").read()).hexdigest().encode()+b"  "+p+b"\n")
print("source_sha256="+h.hexdigest())'
printf 'target=%s\n' "$(bash scripts/checks/lib/slice0_native.sh target)"
printf 'lean_pin=%s\n' "$(cat lean-toolchain)"
printf 'lean_version=%s\n' "$(lean --version)"
printf 'clang_version=%s\n' "$("$CONCRETE_SLICE0_CLANG" --version | head -1)"
python3 - <<'PY'
import hashlib,json,subprocess,sys
from pathlib import Path
lock=json.loads(Path('flake.lock').read_text())
print('nixpkgs_rev='+lock['nodes']['nixpkgs']['locked']['rev'])
for name in ('flake.nix','flake.lock','lake-manifest.json'):
    print(name+'_sha256='+hashlib.sha256(Path(name).read_bytes()).hexdigest())
for p in json.loads(Path('lake-manifest.json').read_text())['packages']:
    name=p['name'].removeprefix('«').removesuffix('»')  # Lake writes escaped names, «a-b»
    d=Path('.lake/packages')/name
    git=lambda *a: subprocess.run(['git','-C',str(d),*a],check=True,capture_output=True,text=True).stdout
    head=git('rev-parse','HEAD').strip()
    if head != p['rev'] or git('status','--porcelain','--untracked-files=all').strip():
        sys.exit(f"build_identity: {name}: checkout {head} is not the clean pinned {p['rev']}")
    print(name+'_rev='+p['rev'])
PY
#!/usr/bin/env bash
# The tracked inputs of a slice-0 build: what slice0_repro.sh copies and build_identity.sh digests.
# shellcheck disable=SC2034
slice0_sources=(Concrete Concrete.lean ConcreteSpec scripts/checks lakefile.toml lean-toolchain
  lake-manifest.json)
# Required CI jobs: a train lands only when every job named here ran at the candidate's exact SHA and
# succeeded (scripts/land/train.sh watch and land). One exact job name per line, as GitHub shows it.
# GitHub branch protection is not configured for main, so this file is the record. Every job of
# .github/workflows/lean_action_ci.yml is listed, each matrix leg under the name GitHub shows for it:
# the root has no campaign tier.
Root checks
Spec build
Oracle (GitHub-hosted fetch + smoke)
Landing record
Proof axioms
Proof trust ban (sorry, native_decide)
Kernel replay (leanchecker)
External re-check (con-leche, nanoda)
Slice 0 backends (x86-64)
Slice 0 backends (aarch64-macos)
Slice 0 artifacts (x86-64)
Slice 0 artifacts (aarch64-macos)
Slice 0 trusted base (gate 9, x86-64)
Slice 0 trusted base (gate 9, aarch64-macos)
Reproducibility (linux-github)
Reproducibility (linux-ci2)
Reproducibility (macos)
Cross-machine reproducibility (x86-64 Linux)
# The required-checks transition of the legacy/ move (R-0558, R-0563): one row per job the base's
# required-checks.txt names and this tree's does not. scripts/land/required_checks.py reads it at train
# watch and land: replacements must each be in required-checks.txt (so they run and are checked at
# the exact SHA), and `-` retires the job with a reason; a retired job is reported NOT RUN, never passed.
# "Root checks" keeps its name and is required on both sides, so it has no row. Delete a row once main
# no longer requires its job (required_checks.py reports it stale).
old_job	replacements	reason
Reproducibility (linux-first)	Reproducibility (linux-github)	ISS-0029 names the GitHub-hosted Linux reproducibility leg explicitly
Reproducibility (linux-independent)	Reproducibility (linux-ci2)	ISS-0029 makes concrete-ci-2 the mandatory second Linux reproducibility machine
# Required checks: required-checks.txt (one exact CI job name per line) and, for a candidate that
# changes the set, required-checks-transition.tsv. scripts/land/required_checks.py is the one owner
# of the rule (its header): the candidate's list plus every base requirement, except one the
# candidate drops through an explicit transition row (replaced by jobs it requires, or retired with
# a reason, reported as retired and never as passed). A required job absent from the run, or whose
# conclusion is not success, is no verdict. GitHub branch protection is not configured for main, so
# these files are the record of what is required.
REQUIRED_FILE="${LAND_REQUIRED_CHECKS_FILE:-required-checks.txt}"
TRANSITION_FILE="${LAND_REQUIRED_TRANSITION_FILE:-required-checks-transition.tsv}"
# Prints required_checks.py's findings for base, head and the run's jobs.
required_report() { # base head jobs
  local d; d="$(mktemp -d)" || return 1
  git show "$1:$REQUIRED_FILE" > "$d/base" 2>/dev/null || : > "$d/base"
  git show "$2:$REQUIRED_FILE" > "$d/cand" 2>/dev/null || : > "$d/cand"
  git show "$2:$TRANSITION_FILE" > "$d/trans" 2>/dev/null || : > "$d/trans"
  printf '%s\n' "$3" > "$d/jobs"
  python3 -I "$SELF_DIR/required_checks.py" "$d/base" "$d/cand" "$d/trans" "$d/jobs"; local rc=$?
  rm -rf "$d"; return "$rc"
}
# Prints the unmet lines (anything but a note); empty when the requirements are met.
unmet_required() { # base head jobs
  local r; r="$(required_report "$@")" || { echo "invalid: required_checks.py failed"; return 0; }
  printf '%s\n' "$r" | awk '/./ && !/^(retired|replaced|stale): /'
}
required_notes() { # base head jobs
  required_report "$@" 2>/dev/null | awk '/^(retired|replaced|stale): /' | sed 's/^/train: requirement /' || true
}

# every other landing-tier job of main's run is skipped, so main's run concludes success with a
# summary naming the qualifying run, instead of running everything twice or showing "cancelled".
# When it does not hold, nothing is skipped: main's run runs every job itself. So main is green
# only on a result obtained AT ITS EXACT SHA, by this workflow, under land's own rule:
#   * the NEWEST completed workflow_dispatch run of .github/workflows/lean_action_ci.yml in $REPO
#     (the train's repository, read by the mirror's CI too: both are public and a SHA names the same
#     tree in both) whose head SHA is exactly <head> and whose title says it ran at base <base>
#     (`<ref> at base <sha>`, written by the workflow's run-name from the `base` input `train.sh ci`
#     passes), other than the asking run. The base binds the base-sensitive checks (LL1_BASE,
#     TOTALITY_BASE, CONFORMANCE_BASE, SPEC_BASE) to the very base main had before the push, as a
#     push run of main would; an older green run never outvotes a later one of the same SHA and base;
#   * its landing tier is non-empty and every landing-tier job succeeded;
#   * every required job (required_checks.py on <base> and <head>, transition rows included) is
#     present and succeeded; <base> (the value main had before the push) must be in this clone and
#     <head> must be strictly ahead of it on GitHub (compare status "ahead").
# Any other finding, an unreadable API included, is no record (exit 1), never a pass. A record is
# never carried from one SHA to another. Prints `qualifying_run=<id>` on success.
cmd_record() {
  local head="" base="" exclude=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) base="${2:-}"; shift ;;
      --exclude-run) exclude="${2:-}"; shift ;;
      -*) die "record: unknown option $1" ;;
      *) head="$1" ;;
    esac; shift
  done
  [[ "$head" =~ ^[0-9a-f]{40}$ ]] || die "record: <head> must be a full 40-hex SHA, not '$head'"
  [[ "$base" =~ ^[0-9a-f]{40}$ ]] && [ "$base" != 0000000000000000000000000000000000000000 ] \
    || die "record: --base must be the full SHA main had before the push, not '$base'"
  case "$exclude" in ""|*[!0-9]*) [ -z "$exclude" ] || die "record: --exclude-run must be a run id" ;; esac
  git cat-file -e "$base^{commit}" 2>/dev/null || die "record: base ${base:0:10} is not in this clone (fetch it); its required-checks.txt binds the record"
  git cat-file -e "$head^{commit}" 2>/dev/null || die "record: head ${head:0:10} is not in this clone"
  local cmp
  cmp="$("$GH" api "repos/$REPO/compare/$base...$head" 2>/dev/null | python3 -I -c '
import json, sys
try: print(json.load(sys.stdin).get("status", "-"))
except ValueError: print("-")')" || cmp="-"
  [ "$cmp" = ahead ] || die "record: ${head:0:10} is not strictly ahead of ${base:0:10} on $REPO (compare: $cmp); no record"
  local runs
  runs="$("$GH" api "repos/$REPO/actions/runs?head_sha=$head&per_page=100" 2>/dev/null | python3 -I -c '
import json, sys
head, base, exclude = sys.argv[1], sys.argv[2], sys.argv[3]
try: runs = json.load(sys.stdin).get("workflow_runs", [])
except ValueError: sys.exit(0)
ok = [r for r in runs
      if r.get("head_sha") == head and r.get("path") == ".github/workflows/lean_action_ci.yml"
      and r.get("event") == "workflow_dispatch" and r.get("status") == "completed"
      and str(r.get("display_title", "")).endswith(" at base " + base)
      and str(r.get("id")) != exclude]
for r in sorted(ok, key=lambda r: r.get("id", 0), reverse=True): print(r["id"])' "$head" "$base" "$exclude")" || runs=""
  [ -n "$runs" ] || die "record: no completed CI dispatch of $REPO at ${head:0:10} at base ${base:0:10}; no record"
  # The newest such run decides: an older green run never outvotes a later one.
  local id sha jobs n bad unmet
  id="${runs%%$'\n'*}"
  read -r sha <<< "$(run_field "$id" headSha)" || die "record: cannot read run $id"
  [ "$sha" = "$head" ] || die "record: run $id ran ${sha:0:10}, not ${head:0:10}; no record"
  jobs="$(run_jobs "$id")" || die "record: cannot read the jobs of run $id"
  n="$(printf '%s\n' "$jobs" | awk -F'\t' '$1=="landing"{n++} END{print n+0}')"
  [ "$n" -gt 0 ] || die "record: run $id has no landing-tier jobs; an empty set is not green"
  bad="$(printf '%s\n' "$jobs" | awk -F'\t' '$1=="landing" && $2!="success" {print "    "$2": "$4}')"
  [ -z "$bad" ] || die "record: run $id, the newest at ${head:0:10}, has landing-tier jobs that did not succeed:
$bad"
  unmet="$(unmet_required "$base" "$head" "$jobs")"
  [ -z "$unmet" ] || die "record: run $id does not satisfy $REQUIRED_FILE on ${base:0:10}..${head:0:10}:
$(printf '%s\n' "$unmet" | sed 's/^/    /')"
  note "record: run $id passed every landing-tier and required job at exactly ${head:0:10} (base ${base:0:10})"
  echo "qualifying_run=$id"
}

