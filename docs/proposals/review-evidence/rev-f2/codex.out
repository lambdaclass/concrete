    95	download = next(step for step in compare["steps"]
    96	                if step.get("uses") == "actions/download-artifact@v4")
    97	require(download["with"]["pattern"] == "reproducibility-linux-*",
    98	        "compare-linux does not download the Linux manifests")
    99	run = next(step["run"] for step in compare["steps"]
   100	           if "repro_manifest_compare.py" in step.get("run", ""))
   101	for text in ("reproducibility-linux-github/manifest.txt",
   102	             "reproducibility-linux-ci2/manifest.txt"):
   103	    require(text in run, f"compare-linux does not read {text}")
