cat: scripts/checks/required_checks.py: No such file or directory
#!/usr/bin/env bash
# The gate environment guard. Every gate sources this first:
#
#   source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
#
# Gates run in three places: the dev shell, Linux CI runners and the macOS CI runner. When each took
# coreutils, sed, grep, python and the rest from whatever host it landed on, a gate could pass on one
# and fail on another for reasons unrelated to what it tests: macOS has no `timeout`, and BSD `sed -i`,
# `stat`, `date` and `readlink` take other flags. flake.nix now defines that userland once (the
# `gates` shell), CI runs every step inside it, and the dev shells include it. Each of those shells
# exports CONCRETE_GATES_SHELL=1; a gate started anywhere else refuses here, before it can produce a
# verdict about the wrong environment.
#
# Use `nix develop .#gates` (no Lean; what CI uses, with elan's Lean on PATH) or `nix develop` (the
# dev shell, with its own Lean). An entry point that must start outside both, like the pre-push
# hook, re-executes itself inside `nix develop` before it runs a gate.
#
# check_gate_hygiene.sh proves every gate sources this file.

if [ "${CONCRETE_GATES_SHELL:-}" != 1 ]; then
  echo "error: ${0##*/} refuses to run outside the gate shell: run inside nix develop .#gates (CI) or nix develop" >&2
  exit 2
fi

# Every gate matches text with has_match, never a pipe into grep -q (bug 283).
source "$(dirname "${BASH_SOURCE[0]}")/has_match.sh" || exit 2
      - uses: actions/checkout@v4
      - name: Install Nix
        uses: cachix/install-nix-action@v31
      - name: Trusted-base golden (premises, axioms, toolchain and LCB pin)
        run: nix develop --command timeout 3000 bash scripts/checks/compiler/slice0_trusted_base.sh

  reproducibility:
    name: Reproducibility (${{ matrix.id }})
    needs: landing-record
    if: ${{ !cancelled() && needs.landing-record.outputs.recorded != 'true' }}
    # The compiler's devshell (flake.nix default: Lean, clang, LLVM, gdb/lldb), entered per step;
    # the gates shell has no Lean.
    defaults:
      run:
        shell: bash
    strategy:
      fail-fast: false
      matrix:
        include:
          - id: linux-github
            runner: ubuntu-24.04
            machine: github
          - id: linux-ci2
            runner: ${{ github.event_name != 'pull_request' && fromJSON('["self-hosted","linux","x64","concrete"]') || 'ubuntu-24.04' }}
            machine: concrete-ci-2
          - id: macos
            runner: macos-15
            machine: github
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 60
    permissions:
      contents: read
    steps:
      - name: Refuse a substitute for concrete-ci-2
        if: matrix.machine == 'concrete-ci-2' && runner.environment != 'self-hosted'
        run: |
          echo "::error::linux-ci2 requires self-hosted concrete-ci-2; pull_request cannot use it, so this leg is intentionally red"
          exit 1
      - uses: actions/checkout@v4
      - name: Install Nix (GitHub-hosted only)
        if: runner.environment != 'self-hosted'
        uses: cachix/install-nix-action@v31
      - name: Compare every stage in distinct build directories
        env:
          CONCRETE_REPRO_RUNNER_ENVIRONMENT: ${{ runner.environment }}
          CONCRETE_REPRO_RUNNER_NAME: ${{ runner.name }}
        run: nix develop --command timeout 3600 bash scripts/checks/compiler/slice0_repro.sh manifest.txt
      - uses: actions/upload-artifact@v4
        with:
          name: reproducibility-${{ matrix.id }}
          path: manifest.txt
          if-no-files-found: error

  compare-linux:
    name: Cross-machine reproducibility (x86-64 Linux)
    needs: reproducibility
    # Runs only when every reproducibility job ran (landing-record gate inherited); no Nix here.
    defaults:
      run:
        shell: bash
    runs-on: ubuntu-24.04
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - uses: actions/download-artifact@v4
        with:
          pattern: reproducibility-linux-*
          path: manifests
      - name: Compare GitHub and concrete-ci-2 artifacts and build identity
        run: |
          set -eu
          m1=manifests/reproducibility-linux-github/manifest.txt
          m2=manifests/reproducibility-linux-ci2/manifest.txt
          python3 scripts/checks/lib/repro_manifest_compare.py "$m1" "$m2"
