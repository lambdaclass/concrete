mod bytes {
    import std.alloc.{grow,dealloc};
    import std.math.{max};
    import std.text.{validate_utf8, Text};

    pub struct Bytes {
        ptr: *mut u8,
        len: u64,
        cap: u64,
    }

    // The raw parts of a `Bytes`, handed out by `into_raw_parts`. `Copy` and
    // owns nothing — it is just a view onto a buffer the caller now owns.
    pub struct Copy BytesRaw {
        pub ptr: *mut u8,
        pub len: u64,
        pub cap: u64,
    }

    impl Bytes {
        pub trusted fn new() -> Bytes {
            let b: Bytes = Bytes {
                ptr: 0 as *mut u8,
                len: 0,
                cap: 0,
            };
            return b;
        }

        pub trusted fn with_capacity(cap: u64) with(Alloc) -> Bytes {
            let b: Bytes = Bytes {
                ptr: grow::<u8>(0 as *mut u8, cap),
                len: 0,
                cap: cap,
            };
            return b;
        }

        /// Copy a String's bytes into a fresh owned buffer. The always-safe
        /// direction of the bytes/text boundary (a String is valid UTF-8, and
        /// any valid UTF-8 is valid bytes — no validation, no failure path).
        /// Pulled by workload 1 (base64_cli): text→bytes programs were
        /// hand-writing this loop. The reverse crossing stays checked
        /// (`to_string` -> Option) per UNICODE_POLICY.
        pub trusted fn from_string(s: &String) with(Alloc) -> Bytes {
            let mut b: Bytes = Bytes::with_capacity(s.len());
            let mut i: u64 = 0;
            while i < s.len() {
                let p: *mut u8 = s.raw_ptr() + i;
                b.push(*p);
                i = i + 1;
            }
            return b;
        }

        pub trusted fn push(&mut self, byte: u8) with(Alloc) {
            if self.len >= self.cap {
                self.grow();
            }

            let target_ptr: *mut u8 = self.ptr + self.len;
            *target_ptr = byte;
            self.len = self.len + 1;
        }

