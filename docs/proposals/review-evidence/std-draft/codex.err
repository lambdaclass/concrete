     1	mod args {
     2	    import std.alloc.{grow};
     3	    import std.libc.{strlen,memcpy};
     4	    import std.text.{validate_utf8};
     5	
     6	    trusted extern fn __concrete_get_argc() with(Env) -> i32;
     7	    extern fn __concrete_get_argv(idx: i32) with(Env) -> *const u8;
     8	
     9	    /// Returns the number of command-line arguments (including the program name).
    10	    /// Requires `Env`: counting the arguments observes the environment as reading them
    11	    /// does (audit D2).
    12	    pub fn count() with(Env) -> Int {
    13	        let c: i32 = __concrete_get_argc();
    14	        return c as Int;
    15	    }
    16	
    17	    /// Returns the command-line argument at the given index as a String.
    18	    /// Index 0 is the program name. Returns "" if the index is out of range
    19	    /// OR the argument is not valid UTF-8 (argv is OS bytes — the Bytes/Text
    20	    /// boundary demands validation before it becomes a String; a raw-bytes
    21	    /// accessor can come later if a workload needs non-UTF-8 argv).
    22	    pub trusted fn get(idx: Int) with(Env, Alloc) -> String {
    23	        let i: i32 = idx as i32;
    24	        let raw: *const u8 = __concrete_get_argv(i);
    25	        if raw == (0 as *const u8) {
    26	            return "";
    27	        }
    28	        let n: u64 = strlen(raw);
    29	        if !validate_utf8(raw, n) {
    30	            return "";
    31	        }
    32	        let buf: *mut u8 = grow::<u8>(0 as *mut u8, n + 1);
    33	        memcpy(buf, raw, n);
    34	        let end: *mut u8 = buf + n;
    35	        *end = 0;
    36	        let s: String = String::from_raw_unchecked(buf, n, n + 1);
    37	        return s;
    38	    }
    39	}
