Author: Federico Carrone <mail@fcarrone.com>
Date:   Sun Nov 8 01:13:16 2026 +0000

    dev-home: the gate clone follows lambdaclass/concrete (REPO_URL; an existing clone gets exactly one origin url, no push url, and refuses an insteadOf that sends it elsewhere)

diff --git a/servers/dev-home.sh b/servers/dev-home.sh
index 0e7b882..3dc5edc 100755
--- a/servers/dev-home.sh
+++ b/servers/dev-home.sh
@@ -2,7 +2,7 @@
 # The `dev` user's gate-host setup for `~/bin/concrete-remote`. Run as root
 # (after users.sh). Idempotent; DRY_RUN=1 to preview.
 #
-#   ~dev/concrete2   https clone of unbalancedparentheses/concrete2 (public, so no
+#   ~dev/concrete2   https clone of lambdaclass/concrete (public, so no
 #                    key: concrete-remote only fetches pushed refs), with a warm
 #                    .lake from `nix develop -c lake build` on origin/main.
 #                    concrete-remote seeds each run's .lake from it.
@@ -18,7 +18,7 @@ set -euo pipefail
 need_root
 id dev >/dev/null 2>&1 || die "no user dev (run users.sh dev first)"
 
-REPO_URL=https://github.com/unbalancedparentheses/concrete2
+REPO_URL=https://github.com/lambdaclass/concrete.git
 H=/home/dev
 NIXBIN=/nix/var/nix/profiles/default/bin
 # cd / first: git refuses to start in a cwd dev cannot read (/root).
@@ -33,6 +33,25 @@ log "elan"
 log "concrete2 clone"
 fresh=0
 if ! [ -d "$H/concrete2/.git" ]; then as_dev git clone -q "$REPO_URL" "$H/concrete2"; fresh=1; fi
+# An existing clone follows REPO_URL (the repository moved to lambdaclass/concrete on 2026-11-08; the
+# landing tooling refuses a gate clone whose origin is any other repository): exactly one origin url,
+# no push url, and no url.*.insteadOf that sends either elsewhere. Reads bypass run(), so DRY_RUN=1
+# previews only the changes a real run would make.
+dev_git() { ( cd / && sudo -u dev -H git -C "$H/concrete2" "$@" ); }
+if [ -d "$H/concrete2/.git" ]; then
+  urls="$(dev_git config --get-all remote.origin.url || true)"
+  if [ -z "$urls" ]; then as_dev git -C "$H/concrete2" remote add origin "$REPO_URL"
+  elif [ "$urls" != "$REPO_URL" ]; then as_dev git -C "$H/concrete2" config --replace-all remote.origin.url "$REPO_URL"
+  fi
+  if dev_git config --get-all remote.origin.pushurl >/dev/null; then
+    as_dev git -C "$H/concrete2" config --unset-all remote.origin.pushurl
+  fi
+  if [ "$DRY_RUN" != 1 ]; then
+    eff="$(dev_git remote get-url --all origin) $(dev_git remote get-url --push --all origin)"
+    [ "$eff" = "$REPO_URL $REPO_URL" ] \
+      || die "~dev/concrete2 origin resolves to '$eff', not $REPO_URL (a url.*.insteadOf in dev's git config?); fix it by hand"
+  fi
+fi
 if [ "${REBUILD:-0}" = 1 ]; then
   as_dev git -C "$H/concrete2" fetch -q origin main
   as_dev git -C "$H/concrete2" checkout -q --detach origin/main
   102	}
   103	
   104	# retire_fail2ban: stop and uninstall fail2ban. SSH is reachable only over Tailscale (ufw allows
   105	# tailscale0 only; nmap 2026-10-31: every public TCP port filtered), so its sshd jail never sees a
   106	# login attempt. Removed 2026-10-31.
   107	retire_fail2ban() {
   108	  local installed=0
   109	  case "$(os_id)" in
   110	    arch) pacman -Q fail2ban >/dev/null 2>&1 && installed=1 ;;
   111	    *) dpkg -s fail2ban >/dev/null 2>&1 && installed=1 ;;
   112	  esac
   113	  [ "$installed" = 1 ] || [ -e /etc/fail2ban/jail.d/sshd.local ] || return 0
   114	  log "fail2ban: removed (SSH is Tailscale-only)"
   115	  retire_units fail2ban.service
   116	  if [ "$installed" = 1 ]; then
   117	    case "$(os_id)" in
   118	      arch) run pacman -Rns --noconfirm fail2ban ;;
   119	      *) run apt-get purge -y fail2ban ;;
   120	    esac
   121	  fi
   122	  [ ! -e /etc/fail2ban/jail.d/sshd.local ] || run rm -f /etc/fail2ban/jail.d/sshd.local
   123	}
   124	
   125	# farm_hold UNIT: the [Service] lines that keep the fuzz farm paused while UNIT (a measuring
   126	# service: perf, leanprof) runs, on a host that runs the farm; nothing elsewhere. The hold is
   127	# fuzz-farm-hold@UNIT.service (services/fuzz-farm.sh), which keeps the farm's own pause flag set.
   128	# Needs the host file loaded (SERVICES).
   129	farm_hold() {
   130	  [[ " ${SERVICES:-} " == *" fuzz-farm "* ]] || return 0
   131	  printf 'ExecStartPre=+/usr/bin/systemctl start fuzz-farm-hold@%s.service\n' "$1"
   132	  printf 'ExecStopPost=+/usr/bin/systemctl stop fuzz-farm-hold@%s.service\n' "$1"
   133	}
   134	
   135	# load_host NAME: read servers/hosts/NAME.env (role, users, runners, services).
   136	load_host() {
   137	  local f=$SERVERS_DIR/hosts/$1.env
   138	  [ -f "$f" ] || die "no host file $f"
   139	  # shellcheck disable=SC1090
   140	  . "$f"
   141	}
     1	#!/bin/bash
     2	# Machine-level setup for one server, in order. Run as root on that host:
     3	#   sudo servers/apply.sh fede-256gb              # apply
     4	#   sudo DRY_RUN=1 servers/apply.sh concrete-ci-2  # show what would change
     5	# Runners need a registration token on stdin (see runners.sh); without one,
     6	# already-registered runners are still checked and fixed up.
     7	# The agent user's home is separate: servers/agent-home.sh, run as agent.
     8	set -euo pipefail
     9	. "$(dirname "$0")/lib.sh"
    10	need_root
    11	[ "$#" -eq 1 ] || die "usage: apply.sh HOST"
    12	# The runner registration token, read ONCE, before any step can consume stdin, and handed to each
    13	# runners.sh call: both pools (RUNNERS, LIGHT_RUNNERS) may need it. Never echoed or written.
    14	RUNNER_TOKEN=""
    15	if [ ! -t 0 ]; then IFS= read -r RUNNER_TOKEN || true; fi
    16	exec </dev/null
    17	load_host "$1"
    18	# base.sh / base-arch.sh run as child processes and read this host setting.
    19	export SSH_TAILSCALE_ONLY="${SSH_TAILSCALE_ONLY:-0}"
    20	[ "$(hostname -s)" = "$1" ] || [ "$DRY_RUN" = 1 ] || die "this is $(hostname -s), not $1"
    21	log "$1: $ROLE"
    22	
    23	"$SERVERS_DIR/base.sh"
    24	# shellcheck disable=SC2086
    25	"$SERVERS_DIR/users.sh" $USERS
    26	[[ " $USERS " != *" dev "* ]] || "$SERVERS_DIR/dev-home.sh"
    27	# The runner caps (CONCRETE_RUNNERS_* / CONCRETE_*RUNNER_*) from the host file reach runners.sh.
    28	for v in $(compgen -v | grep -E '^CONCRETE_(LIGHT_)?RUNNERS?_' || true); do export "${v?}"; done
    29	# shellcheck disable=SC2086
    30	[ -z "$RUNNERS" ] || printf '%s\n' "$RUNNER_TOKEN" | "$SERVERS_DIR/runners.sh" $RUNNERS
    31	# shellcheck disable=SC2086
    32	[ -z "${LIGHT_RUNNERS:-}" ] || printf '%s\n' "$RUNNER_TOKEN" | RUNNER_LABEL=concrete-light "$SERVERS_DIR/runners.sh" $LIGHT_RUNNERS
    33	# shellcheck disable=SC2086,SC2046
    34	[ -z "${STABILEO_RUNNERS:-}" ] || printf '%s\n' "$RUNNER_TOKEN" | ( export $(compgen -v STABILEO_)
    35	  "$SERVERS_DIR/runners-stabileo.sh" $STABILEO_RUNNERS ${STABILEO_TIMING_RUNNERS:-} ${STABILEO_NIGHTLY_RUNNERS:-} )
    36	"$SERVERS_DIR/tailscale.sh"
    37	"$SERVERS_DIR/disk-health.sh"
    38	"$SERVERS_DIR/interactive-first.sh"
    39	"$SERVERS_DIR/memory-guard.sh"
    40	"$SERVERS_DIR/backup.sh" "$1"
    41	# Services moved off this host: `services/<name>.sh retire` stops and disables their units and
    42	# keeps their files and state on disk (lib.sh retire_units). Before SERVICES, so a host never
    43	# runs both sides of a move.
    44	for s in ${RETIRED_SERVICES:-}; do
    45	  [ -x "$SERVERS_DIR/services/$s.sh" ] || die "retired service $s: no services/$s.sh"
    46	  "$SERVERS_DIR/services/$s.sh" retire
    47	done
    48	# Deployment units with a script in services/ are applied; the rest are still
    49	# hand-installed on their host (README.md, Services).
    50	for s in $SERVICES; do
    51	  if [ -x "$SERVERS_DIR/services/$s.sh" ]; then "$SERVERS_DIR/services/$s.sh"
    52	  else log "service $s: no services/$s.sh yet (hand-installed)"; fi
    53	done
    54	log "$1 done"
# concrete-ci-2 — Hetzner AX102 (dedicated), 65.109.50.173. Arch Linux.
# Ryzen 9 7950X3D 16c/32t, 125 GB RAM, 2x 1.7 TB NVMe in md RAID1.
# The image comes up as archlinux-latest-64-minimal; set the name once:
#   hostnamectl set-hostname concrete-ci-2
#
# Role: CI (concrete's landing tier) plus the caches CI reads. GitHub self-hosted runners
# (label `concrete`, light pool `concrete-light`), the Lean seed cache (lakecache), the signed
# Nix binary cache (localhost only), and `CONCRETE_REMOTE=hetzner` gate runs (dev). Since
# 2026-10-26 the fuzz farm, perf and leanprof run on concrete-ci-3, so this host's CPU goes to
# CI alone (and compile-time measurements here are not disturbed by the farm).
# Runners: 6 (16 cores; Lean builds are memory-heavy, ~20 GB each).
ROLE="CI runners + caches"
USERS="dev agent lakecache"
# The repository the runners serve (runners.sh). The owner approved moving concrete to
# lambdaclass/concrete (2026-11-06): the runners move in stages with a per-invocation
# CONCRETE_RUNNER_REPO=lambdaclass/concrete RUNNER_REINSTALL=1 (runners.sh header), 7-8, then 4-6,
# then 1-3, and this line becomes lambdaclass/concrete once all eight have moved. Until then it
# states where they are, so apply.sh changes nothing.
CONCRETE_RUNNER_REPO=unbalancedparentheses/concrete2
RUNNERS="1 2 3 4 5 6"
# The light pool (label concrete-light): Branch health only, so the ~500 per-push
# fast-gate runs a day never take a landing-tier runner from a train. Two runners:
# a run is ~2 min and a later push to the same branch cancels the earlier one.
LIGHT_RUNNERS="7 8"
# Caps for all runners together (concrete-runners.slice, runners.sh; concrete ISS-0007,
# 2026-11-06): at most 24 of 32 CPU-equivalents and 96 GB; the rest is headroom (not reserved) for user.slice.
# Per runner: a landing runner may use 28 GB (a Lean build is ~20 GB), a light runner 4 cores, 8 GB.
CONCRETE_RUNNERS_CPU_QUOTA=2400%
CONCRETE_RUNNERS_MEMORY_MAX=96G
CONCRETE_RUNNERS_TASKS_MAX=16384
CONCRETE_RUNNER_MEMORY_MAX=28G
CONCRETE_LIGHT_RUNNER_MEMORY_MAX=8G
CONCRETE_LIGHT_RUNNER_CPU_QUOTA=400%
SERVICES="lean-cache nix-cache"
# Moved to concrete-ci-3 (2026-10-26). `retire` stops and disables their units and keeps the
# data: /home/fuzz (the user stays; findings, state and the concrete-ci-1 archive), ~dev/perf.
RETIRED_SERVICES="fuzz-farm perf leanprof-profile"
# SSH and mosh over Tailscale only (base.sh / base-arch.sh, servers/ssh-tailscale-only.sh).
SSH_TAILSCALE_ONLY=1

