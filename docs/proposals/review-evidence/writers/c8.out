  Spec/Adequacy.lean:
  import ConcreteSpec.Spec.Exec
  namespace ConcreteSpec.Core.Exec
  open ConcreteSpec.Core
  variable {O : Operands}

  structure Query (O) where
    events : List O.Event
    prim : O.Prim
    args : List O.Val
    site : SiteId
    store : O.Store
    occurrence : Nat

  def Query.sameSite (q : Query O) (site : SiteId) : Bool := decide (q.site = site)
  def occurrenceAt (issued : List (Query O)) (site) := (issued.filter fun q => decide (q.site = site)).length
  def Query.issue (hist) (p) ... (issued) : Query := ⟨hist,p,vs,site,st, occurrenceAt issued site⟩. Order args maybe issued last.

  structure QueryReport where
   events : List Event
   queries : List Query
   ending : Ending

  def runFromQ (P) (ρ : Oracle O) : Nat → List Event → List Query → Config → QueryReport
   | fuel,hist,issued,c =>
   match c.final?, fuel with ...
   request =>
    let q : Query O := ⟨hist,p,vs,site,st, occurrenceAt issued site⟩
    match ρ hist... with
    | none => ⟨hist, issued ++ [q], .noAnswer c⟩
    | some a =>
      if allows ... then
        match k a ...
        | some c' => runFromQ n (hist++event) (issued++[q]) c'
        | none => ...
      else ...
