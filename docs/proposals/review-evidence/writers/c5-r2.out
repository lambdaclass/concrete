import ConcreteSpec.Spec.Own
import ConcreteSpec.Spec.Authority

/-!
# C5: generative brands and linear grant transitions

PROPOSED, before Core freeze. Brands use `BrandId`, lineage uses `LineageId`, lexical
scopes use `BlockId`, and resource obligations use existing typed place/grant identities.
Dependencies distinguish lexical brand occurrence (including phantom tags) from live allocator
use (Q1.3, Q1.5). A reset changes generation, never lineage. This is the generative binder
transition; existential package syntax and structural dependency extraction remain C9 duties.

Grant rights below are abstract policy atoms, not a replacement target/network grant table.
Concrete resource identity/state is an opaque parameter and is retained, never erased as a
permission. Capability checks and a dynamic policy check are separate inputs (Q7.8).
-/
namespace ConcreteSpec.Core.Generative

structure Binder where
  brand : BrandId
  lineage : LineageId
  scope : BlockId
  allocatorLive : Bool
  deriving DecidableEq, Repr

/-- Phantom occurrences constrain scope but need not keep allocator storage alive (Q1.3). -/
structure Dependency where
  place : Hybrid.Place
  brands : List BrandId
  allocations : List BrandId
  deriving DecidableEq, Repr

structure State where
  binders : List Binder := []
  dependencies : List Dependency := []
  nextBrand : Nat := 0
  nextLineage : Nat := 0
  deriving DecidableEq, Repr

/-- Brand witnesses are nominal identities. Allocations require a still-live allocator;
phantom occurrences only require the binder to remain scoped (Q1.1–Q1.5). -/
def WellFormed (s : State) : Prop :=
  (s.binders.map Binder.brand).Nodup ∧
  (∀ b ∈ s.binders, b.brand.id < s.nextBrand ∧ b.lineage.id < s.nextLineage) ∧
  (∀ d ∈ s.dependencies,
    (∀ i ∈ d.brands, ∃ b ∈ s.binders, b.brand = i) ∧
    (∀ i ∈ d.allocations, i ∈ d.brands ∧ ∃ b ∈ s.binders, b.brand = i ∧ b.allocatorLive = true))
instance (s : State) : Decidable (WellFormed s) := by unfold WellFormed; infer_instance

def validate (s : State) : Option State := if WellFormed s then some s else none

/-- A generative binder allocates a new nominal identity, even at the same lexical loop site
(Q1.1, Q1.2). The allocator starts a new lineage. -/
def fresh (s : State) (scope : BlockId) : Option State :=
  validate { s with
    binders := ⟨⟨s.nextBrand⟩, ⟨s.nextLineage⟩, scope, true⟩ :: s.binders
    nextBrand := s.nextBrand + 1
    nextLineage := s.nextLineage + 1 }

/-- Dependency registration is explicit and refuses missing brand/lifetime witnesses. -/
def depend (s : State) (d : Dependency) : Option State :=
  if s.dependencies.any (·.place == d.place) then none else
    validate { s with dependencies := d :: s.dependencies }

/-- Discharge the dependent resource obligation, without implicitly cleaning up its allocator. -/
def consume (s : State) (p : Hybrid.Place) : Option State :=
  if s.dependencies.any (·.place == p) then
    validate { s with dependencies := s.dependencies.filter (·.place != p) }
  else none

/-- Release/reset cannot invalidate a live allocation dependency. Lexical phantom occurrences
remain valid until their brand binder ends (Q1.3, Q1.5). -/
def release (s : State) (i : BrandId) : Option State :=
  if s.binders.any (fun b => b.brand == i && b.allocatorLive) &&
      s.dependencies.all (fun d => decide (i ∉ d.allocations)) then
    validate { s with binders := s.binders.map fun b =>
      if b.brand = i then { b with allocatorLive := false } else b }
  else none

/-- A supported reset is generative on every execution, including loop iterations (Q1.2).
The old brand stays nominally scoped, but its allocator is consumed. -/
def reset (s : State) (i : BrandId) : Option State := do
  let b ← s.binders.find? (·.brand == i)
  let t ← release s i
  validate { t with
    binders := ⟨⟨s.nextBrand⟩, b.lineage, b.scope, true⟩ :: t.binders
    nextBrand := s.nextBrand + 1 }

/-- A lexical binder cannot escape its scope through any dependent value, even a zero-byte
phantom tag. No resource is implicitly consumed at scope exit (Q1.3, Q3.8). -/
def endScope (s : State) (scope : BlockId) : Option State :=
  if s.binders.all (fun b => b.scope != scope || !b.allocatorLive) &&
      s.dependencies.all (fun d => s.binders.all (fun b =>
        b.scope != scope || decide (b.brand ∉ d.brands))) then
    validate { s with binders := s.binders.filter (·.scope != scope) }
  else none

/-- Couple a brand transition to its concrete allocator operation. Brand witnesses and
lexical dependencies erase; allocator state and failures remain concrete (Q1.1, Q9.10). -/
def instrument {σ α : Type} (transition : State → Option State)
    (operation : σ → Option (α × σ)) (s : σ × State) : Option (α × (σ × State)) := do
  let ghost ← transition s.2
  let (result, concrete) ← operation s.1
  pure (result, (concrete, ghost))

namespace Examples

def initial : State := (fresh {} ⟨0⟩).getD {}
def heap : Dependency := ⟨⟨0⟩, [⟨0⟩], [⟨0⟩]⟩
def phantom : Dependency := ⟨⟨1⟩, [⟨0⟩], []⟩

/-- Accepted (rule `ConcreteSpec.Core.Generative.reset`): repeated resets at the same site produce distinct nominal generations. -/
example : (do
    let s ← reset initial ⟨0⟩
    let s ← reset s ⟨1⟩
    pure (s.binders.map Binder.brand, s.binders.map Binder.lineage)) =
      some ([⟨2⟩, ⟨1⟩, ⟨0⟩], [⟨0⟩, ⟨0⟩, ⟨0⟩]) := by decide
/-- Refused (rule `ConcreteSpec.Core.Generative.reset`): a live allocation prevents its allocator's reset. -/
example : (depend initial heap).bind (fun s => reset s ⟨0⟩) = none := by decide
/-- Accepted: a phantom tag does not prevent reset, but still constrains lexical scope. -/
example : ((depend initial phantom).bind (fun s => reset s ⟨0⟩)).isSome = true := by decide
/-- Refused (rule `ConcreteSpec.Core.Generative.endScope`): zero representation bytes do not end the phantom's linear obligation. -/
example : (do
    let s ← depend initial phantom
    let s ← release s ⟨0⟩
    endScope s ⟨0⟩) = none := by decide
/-- Accepted (rule `ConcreteSpec.Core.Generative.endScope`): explicitly consume the dependent, then release the allocator and end its binder. -/
example : (do
    let s ← depend initial heap
    let s ← consume s ⟨0⟩
    let s ← release s ⟨0⟩
    endScope s ⟨0⟩).isSome = true := by decide

end Examples
end ConcreteSpec.Core.Generative

namespace ConcreteSpec.Core.Grants
open ConcreteSpec.Authority (Cap)

/-- The runtime resource/identity is opaque; rights are abstract policy atoms. Permissions are
separate erased capability sets. No inference about Entropy or a network schema is made. -/
structure Resource (Handle : Type) where
  handle : Handle
  rights : List Nat
  permission : Cap
  live : Bool
  deriving DecidableEq, Repr

structure State (Handle : Type) where
  resources : AList GrantId (Resource Handle)
  next : Nat

/-- A successful lookup also checks linear availability. A consumed identity is never usable. -/
def usable {H : Type} (s : State H) (i : GrantId) : Option (Resource H) := do
  let r ← AList.lookup s.resources i
  if r.live then some r else none

/-- Mark consumption without removing the historical identity. -/
def consumed {H : Type} (s : State H) (i : GrantId) : State H :=
  { s with resources := AList.update s.resources i (fun r => { r with live := false }) }

/-- Issuing a new identity never reuses a previous one; launch supplies the initial resources. -/
def issue {H : Type} (s : State H) (r : Resource H) : State H :=
  ⟨(⟨s.next⟩, r) :: s.resources, s.next + 1⟩

/-- Narrowing consumes the parent and gives precisely the intersection of rights (Q7.2).
It is total for a live input; no dynamic policy failure is introduced. -/
def narrow {H : Type} (s : State H) (i : GrantId) (requested : List Nat) : Option (State H) := do
  let r ← usable s i
  pure (issue (consumed s i) { r with rights := r.rights.filter (fun x => decide (x ∈ requested)) })

/-- Acquisition keeps its parent, checks the declared capability and atomic dynamic policy,
and accepts only a child policy contained in parent ∩ request (Q7.2, Q7.8). The supplied handle
is the successful acquisition result; an external failure has no such transition. -/
def acquire {H : Type} (s : State H) (i : GrantId) (requested selected : List Nat)
    (permissions : List Cap) (policyAllowed : Bool) (handle : H) : Option (State H) := do
  let r ← usable s i
  if r.permission ∈ permissions ∧ policyAllowed = true ∧
      ∀ right ∈ selected, right ∈ r.rights ∧ right ∈ requested then
    some (issue s ⟨handle, selected, r.permission, true⟩)
  else none

/-- Close errors carry only a Copy error code, never a handle. -/
abbrev CloseResult := Except Nat Unit

/-- Close/give-up consumes on every specified outcome, including failure (Q7.3).
This contract assumes the platform adapter's release guarantee; it does not model syscalls. -/
def close {H : Type} (s : State H) (i : GrantId) (outcome : CloseResult) :
    Option (CloseResult × State H) := do
  let _ ← usable s i
  pure (outcome, consumed s i)

/-- A launch budget bounds every resource's rights, including consumed history. -/
def Bounded {H : Type} (budget : List Nat) (s : State H) : Prop :=
  ∀ e ∈ s.resources, ∀ right ∈ e.2.rights, right ∈ budget

/-- Historical identities remain below the monotonically increasing supply. -/
def Fresh {H : Type} (s : State H) : Prop := ∀ e ∈ s.resources, e.1.id < s.next

/-- Any finite sequence of the permitted grant transitions, without a minting operation. -/
inductive Steps {H : Type} : State H → State H → Prop where
  | refl (s) : Steps s s
  | narrow {s t u i requested} : Steps s t → narrow t i requested = some u → Steps s u
  | acquire {s t u i requested selected permissions allowed handle} : Steps s t →
      acquire t i requested selected permissions allowed handle = some u → Steps s u
  | close {s t u i result} : Steps s t → close t i result = some (result, u) → Steps s u

namespace Examples

def initial : State Nat := ⟨[(⟨0⟩, ⟨42, [0, 1], .fs, true⟩)], 1⟩
/-- Accepted (rule `ConcreteSpec.Core.Grants.narrow`): narrowing consumes the parent and intersects rather than replacing rights. -/
example : ((narrow initial ⟨0⟩ [1, 2]).map fun s =>
    ((usable s ⟨0⟩).isNone, (usable s ⟨1⟩).map Resource.rights)) = some (true, some [1]) := by decide
/-- Accepted (rule `ConcreteSpec.Core.Grants.acquire`): acquisition preserves its parent. -/
example : ((acquire initial ⟨0⟩ [1] [1] [.fs] true 99).map fun s =>
    ((usable s ⟨0⟩).isSome, (usable s ⟨1⟩).map Resource.handle)) = some (true, some 99) := by decide
/-- Refused (rule `ConcreteSpec.Core.Grants.acquire`): neither a new writable right nor a missing capability may be manufactured. -/
example : acquire initial ⟨0⟩ [2] [2] [.fs] true 99 = none := by decide
example : acquire initial ⟨0⟩ [1] [1] [] true 99 = none := by decide
/-- Refused: static permission cannot bypass an atomic dynamic scope check. -/
example : acquire initial ⟨0⟩ [1] [1] [.fs] false 99 = none := by decide
/-- Accepted (rule `ConcreteSpec.Core.Grants.close`): a failed close still consumes the handle. -/
example : ((close initial ⟨0⟩ (.error 5)).map fun (_, s) => (usable s ⟨0⟩).isNone) =
    some true := by decide
/-- Refused (rule `ConcreteSpec.Core.Grants.narrow`): a consumed resource cannot be used, narrowed or closed again. -/
example : (do
    let (_, s) ← close initial ⟨0⟩ (.ok ())
    narrow s ⟨0⟩ [0]) = none := by decide

/-- Refused (rule `ConcreteSpec.Core.Grants.close`): double close cannot revive a handle. -/
example : (do
    let (_, s) ← close initial ⟨0⟩ (.error 5)
    close s ⟨0⟩ (.ok ())) = none := by decide

end Examples
end ConcreteSpec.Core.Grants
import ConcreteSpec.Spec.Grant
import ConcreteSpec.Proofs.Basics

/-! # C5 brand lifetime and grant attenuation laws -/
namespace ConcreteSpec.Core.Generative

theorem validate_iff (s t : State) : validate s = some t ↔ s = t ∧ WellFormed t := by
  unfold validate
  split
  · rename_i hs
    constructor
    · intro h; cases h; exact ⟨rfl, hs⟩
    · rintro ⟨rfl, _⟩; rfl
  · rename_i hs
    constructor
    · intro h; cases h
    · rintro ⟨rfl, ht⟩; exact False.elim (hs ht)

theorem fresh_preserves (s t : State) (scope : BlockId) (h : fresh s scope = some t) :
    WellFormed t := (validate_iff _ _).mp h |>.2

theorem depend_preserves (s t : State) (d : Dependency) (h : depend s d = some t) :
    WellFormed t := by
  unfold depend at h
  split at h
  · contradiction
  · exact (validate_iff _ _).mp h |>.2

theorem consume_preserves (s t : State) (p : Hybrid.Place) (h : consume s p = some t) :
    WellFormed t := by
  unfold consume at h
  split at h
  · exact (validate_iff _ _).mp h |>.2
  · contradiction

theorem release_preserves (s t : State) (i : BrandId) (h : release s i = some t) :
    WellFormed t := by
  unfold release at h
  split at h
  · exact (validate_iff _ _).mp h |>.2
  · contradiction

theorem reset_preserves (s t : State) (i : BrandId) (h : reset s i = some t) :
    WellFormed t := by
  unfold reset at h
  obtain ⟨_, _, hh⟩ := Option.bind_eq_some_iff.mp h
  obtain ⟨_, _, hh⟩ := Option.bind_eq_some_iff.mp hh
  exact (validate_iff _ _).mp hh |>.2

theorem endScope_preserves (s t : State) (scope : BlockId) (h : endScope s scope = some t) :
    WellFormed t := by
  unfold endScope at h
  split at h
  · exact (validate_iff _ _).mp h |>.2
  · contradiction

/-- A new/reset generation is unequal to every previously scoped brand, independently of
representation or lexical site. Supplies are never decremented when a scope ends. -/
theorem nextBrand_fresh (s : State) (hs : WellFormed s) (b : Binder) (hb : b ∈ s.binders) :
    b.brand ≠ BrandId.mk s.nextBrand := by
  intro he
  have hn := (hs.2.1 b hb).1
  rw [he] at hn
  exact Nat.lt_irrefl _ hn

theorem fresh_generation (s t : State) (scope : BlockId) (h : fresh s scope = some t) :
    t.nextBrand = s.nextBrand + 1 ∧ ∃ b ∈ t.binders, b.brand = ⟨s.nextBrand⟩ := by
  obtain ⟨he, _⟩ := (validate_iff _ _).mp h
  subst t
  exact ⟨rfl, _, List.mem_cons_self, rfl⟩

theorem reset_generation (s t : State) (i : BrandId) (h : reset s i = some t) :
    t.nextBrand = s.nextBrand + 1 ∧ ∃ b ∈ t.binders, b.brand = ⟨s.nextBrand⟩ := by
  unfold reset at h
  obtain ⟨b, _, hh⟩ := Option.bind_eq_some_iff.mp h
  obtain ⟨u, _, hh⟩ := Option.bind_eq_some_iff.mp hh
  obtain ⟨he, _⟩ := (validate_iff _ _).mp hh
  subst t
  exact ⟨rfl, _, List.mem_cons_self, rfl⟩

/-- Successful lexical exit leaves no dependent value mentioning any brand bound in that
scope. This includes phantom dependencies, which need no live allocation. -/
theorem endScope_non_escape (s t : State) (scope : BlockId)
    (h : endScope s scope = some t) (b : Binder) (hb : b ∈ s.binders)
    (hscope : b.scope = scope) (d : Dependency) (hd : d ∈ t.dependencies) :
    b.brand ∉ d.brands := by
  unfold endScope at h
  split at h
  · rename_i guard
    obtain ⟨he, _⟩ := (validate_iff _ _).mp h
    subst t
    have hg := Bool.and_eq_true_iff.mp guard |>.2
    have hdg := List.all_eq_true.mp hg d hd
    have hbg := List.all_eq_true.mp hdg b hb
    simpa [hscope] using hbg
  · contradiction

/-- Reset/release cannot leave a dependent allocation naming a consumed allocator. -/
theorem allocations_have_live_allocator (s : State) (hs : WellFormed s) (d : Dependency)
    (hd : d ∈ s.dependencies) (i : BrandId) (hi : i ∈ d.allocations) :
    ∃ b ∈ s.binders, b.brand = i ∧ b.allocatorLive = true :=
  (hs.2.2 d hd).2 i hi |>.2

/-- Successful brand instrumentation preserves exactly the concrete operation's result,
state and branch. Reset generations cannot influence that result. -/
theorem instrument_erasure {σ α : Type} (transition : State → Option State)
    (operation : σ → Option (α × σ)) (s : σ × State) (a : α) (concrete : σ) (ghost : State)
    (h : instrument transition operation s = some (a, (concrete, ghost))) :
    operation s.1 = some (a, concrete) := by
  unfold instrument at h
  obtain ⟨_, _, hh⟩ := Option.bind_eq_some_iff.mp h
  obtain ⟨r, hr, hh⟩ := Option.bind_eq_some_iff.mp hh
  cases r
  cases hh
  exact hr

end ConcreteSpec.Core.Generative

namespace ConcreteSpec.Core.Grants
open ConcreteSpec.Authority (Cap)

variable {H : Type}

private theorem update_all {α : Type} (P : GrantId × α → Prop) (i : GrantId) (f : α → α)
    (hf : ∀ a, P (i, a) → P (i, f a)) (xs : AList GrantId α)
    (hxs : ∀ e ∈ xs, P e) : ∀ e ∈ AList.update xs i f, P e := by
  induction xs with
  | nil => simp [AList.update]
  | cons e xs ih =>
    rw [AList.update]
    split
    · rename_i he
      intro q hq
      simp only [List.mem_cons] at hq
      rcases hq with rfl | hq
      · subst he; exact hf e.2 (hxs e (List.mem_cons_self))
      · exact hxs q (List.mem_cons_of_mem _ hq)
    · intro q hq
      simp only [List.mem_cons] at hq
      rcases hq with rfl | hq
      · exact hxs e List.mem_cons_self
      · exact ih (fun q hq => hxs q (List.mem_cons_of_mem _ hq)) q hq

/-- Successful usability exposes both the original resource and its live flag. -/
theorem usable_some (s : State H) (i : GrantId) (r : Resource H) (h : usable s i = some r) :
    AList.lookup s.resources i = some r ∧ r.live = true := by
  unfold usable at h
  obtain ⟨a, ha, hh⟩ := Option.bind_eq_some_iff.mp h
  split at hh
  · cases hh; exact ⟨ha, by assumption⟩
  · contradiction

theorem consumed_bounded (budget : List Nat) (s : State H) (i : GrantId)
    (hs : Bounded budget s) : Bounded budget (consumed s i) :=
  update_all (fun (e : GrantId × Resource H) => ∀ right ∈ e.2.rights, right ∈ budget)
    i (fun r => { r with live := false }) (fun _ h => h) s.resources hs

theorem consumed_fresh (s : State H) (i : GrantId) (hs : Fresh s) : Fresh (consumed s i) :=
  update_all (fun (e : GrantId × Resource H) => e.1.id < s.next)
    i (fun r => { r with live := false }) (fun _ h => h) s.resources hs

theorem issue_bounded (budget : List Nat) (s : State H) (r : Resource H)
    (hs : Bounded budget s) (hr : ∀ x ∈ r.rights, x ∈ budget) : Bounded budget (issue s r) := by
  intro e he
  change e ∈ (⟨s.next⟩, r) :: s.resources at he
  rcases List.mem_cons.mp he with rfl | he
  · exact hr
  · exact hs e he

theorem issue_fresh (s : State H) (r : Resource H) (hs : Fresh s) : Fresh (issue s r) := by
  intro e he
  change e ∈ (⟨s.next⟩, r) :: s.resources at he
  rcases List.mem_cons.mp he with rfl | he
  · exact Nat.lt_succ_self _
  · exact Nat.lt_succ_of_lt (hs e he)

theorem narrow_bounded (budget : List Nat) (s t : State H) (i : GrantId) (requested : List Nat)
    (hs : Bounded budget s) (h : narrow s i requested = some t) : Bounded budget t := by
  unfold narrow at h
  obtain ⟨r, hr, hh⟩ := Option.bind_eq_some_iff.mp h
  cases hh
  apply issue_bounded _ _ _ (consumed_bounded budget s i hs)
  intro x hx
  exact hs _ (AList.lookup_mem (usable_some s i r hr).1) x (List.mem_filter.mp hx).1

theorem acquire_bounded (budget : List Nat) (s t : State H) (i : GrantId)
    (requested selected : List Nat) (permissions : List Cap) (allowed : Bool) (handle : H)
    (hs : Bounded budget s) (h : acquire s i requested selected permissions allowed handle = some t) :
    Bounded budget t := by
  unfold acquire at h
  obtain ⟨r, hr, hh⟩ := Option.bind_eq_some_iff.mp h
  split at hh
  · rename_i guard
    cases hh
    apply issue_bounded _ _ _ hs
    intro x hx
    exact hs _ (AList.lookup_mem (usable_some s i r hr).1) x (guard.2.2 x hx).1
  · contradiction

theorem close_bounded (budget : List Nat) (s t : State H) (i : GrantId) (result : CloseResult)
    (hs : Bounded budget s) (h : close s i result = some (result, t)) : Bounded budget t := by
  unfold close at h
  obtain ⟨_, _, hh⟩ := Option.bind_eq_some_iff.mp h
  cases hh
  exact consumed_bounded budget s i hs

/-- Every finite sequence of narrowing, acquisition and close stays within the initial
launch rights. Retaining parents during acquisition does not enlarge the authority set. -/
theorem rights_never_grow (budget : List Nat) (s t : State H) (hs : Bounded budget s)
    (h : Steps s t) : Bounded budget t := by
  induction h with
  | refl => exact hs
  | narrow _ hn ih => exact narrow_bounded _ _ _ _ _ ih hn
  | acquire _ ha ih => exact acquire_bounded _ _ _ _ _ _ _ _ _ ih ha
  | close _ hc ih => exact close_bounded _ _ _ _ _ ih hc

theorem narrow_fresh (s t : State H) (i : GrantId) (requested : List Nat)
    (hs : Fresh s) (h : narrow s i requested = some t) : Fresh t := by
  unfold narrow at h
  obtain ⟨_, _, hh⟩ := Option.bind_eq_some_iff.mp h
  cases hh
  exact issue_fresh _ _ (consumed_fresh s i hs)

theorem acquire_fresh (s t : State H) (i : GrantId) (requested selected : List Nat)
    (permissions : List Cap) (allowed : Bool) (handle : H)
    (hs : Fresh s) (h : acquire s i requested selected permissions allowed handle = some t) : Fresh t := by
  unfold acquire at h
  obtain ⟨_, _, hh⟩ := Option.bind_eq_some_iff.mp h
  split at hh
  · cases hh; exact issue_fresh _ _ hs
  · contradiction

theorem close_fresh (s t : State H) (i : GrantId) (result : CloseResult)
    (hs : Fresh s) (h : close s i result = some (result, t)) : Fresh t := by
  unfold close at h
  obtain ⟨_, _, hh⟩ := Option.bind_eq_some_iff.mp h
  cases hh
  exact consumed_fresh s i hs

/-- Consumption is a persistent historical fact, rather than absence from a map. -/
def Dead (s : State H) (i : GrantId) : Prop :=
  ∃ r, AList.lookup s.resources i = some r ∧ r.live = false

theorem dead_unusable (s : State H) (i : GrantId) (h : Dead s i) : usable s i = none := by
  obtain ⟨r, hr, hd⟩ := h
  simp [usable, hr, hd]

theorem consumed_dead (s : State H) (i : GrantId) (r : Resource H)
    (hr : AList.lookup s.resources i = some r) : Dead (consumed s i) i := by
  refine ⟨{ r with live := false }, ?_, rfl⟩
  simp [consumed, AList.lookup_update, hr]

theorem consumed_keeps_dead (s : State H) (i j : GrantId) (h : Dead s i) :
    Dead (consumed s j) i := by
  obtain ⟨r, hr, hd⟩ := h
  by_cases he : i = j
  · subst j; exact consumed_dead s i r hr
  · exact ⟨r, by simp [consumed, AList.lookup_update, he, hr], hd⟩

theorem issue_keeps_dead (s : State H) (r : Resource H) (i : GrantId)
    (hs : Fresh s) (h : Dead s i) : Dead (issue s r) i := by
  obtain ⟨a, ha, hd⟩ := h
  have hb := hs _ (AList.lookup_mem ha)
  have hi : GrantId.mk s.next ≠ i := by
    intro he; rw [← he] at hb; exact Nat.lt_irrefl _ hb
  exact ⟨a, by simp [issue, AList.lookup, hi, ha], hd⟩

/-- Every close outcome consumes; the result never contains a handle. -/
theorem close_consumes (s t : State H) (i : GrantId) (result : CloseResult)
    (h : close s i result = some (result, t)) : Dead t i := by
  unfold close at h
  obtain ⟨r, hr, hh⟩ := Option.bind_eq_some_iff.mp h
  cases hh
  exact consumed_dead s i r (usable_some s i r hr).1

theorem narrow_consumes (s t : State H) (i : GrantId) (requested : List Nat)
    (hs : Fresh s) (h : narrow s i requested = some t) : Dead t i := by
  unfold narrow at h
  obtain ⟨r, hr, hh⟩ := Option.bind_eq_some_iff.mp h
  cases hh
  exact issue_keeps_dead _ _ i (consumed_fresh s i hs)
    (consumed_dead s i r (usable_some s i r hr).1)

/-- Once consumed, no sequence of these operations can revive a resource identity. -/
theorem consumed_never_revives (s t : State H) (i : GrantId) (hs : Fresh s) (hd : Dead s i)
    (h : Steps s t) : Dead t i ∧ Fresh t := by
  induction h with
  | refl => exact ⟨hd, hs⟩
  | narrow _ hn ih =>
    obtain ⟨hd, hf⟩ := ih
    refine ⟨?_, narrow_fresh _ _ _ _ hf hn⟩
    unfold narrow at hn
    obtain ⟨_, _, hh⟩ := Option.bind_eq_some_iff.mp hn
    cases hh
    exact issue_keeps_dead _ _ i (consumed_fresh _ _ hf) (consumed_keeps_dead _ _ _ hd)
  | acquire _ ha ih =>
    obtain ⟨hd, hf⟩ := ih
    refine ⟨?_, acquire_fresh _ _ _ _ _ _ _ _ hf ha⟩
    unfold acquire at ha
    obtain ⟨_, _, hh⟩ := Option.bind_eq_some_iff.mp ha
    split at hh
    · cases hh; exact issue_keeps_dead _ _ i hf hd
    · contradiction
  | close _ hc ih =>
    obtain ⟨hd, hf⟩ := ih
    refine ⟨?_, close_fresh _ _ _ _ hf hc⟩
    unfold close at hc
    obtain ⟨_, _, hh⟩ := Option.bind_eq_some_iff.mp hc
    cases hh
    exact consumed_keeps_dead _ _ _ hd

/-- Narrowing's result is exactly an intersection, with the same opaque resource identity. -/
theorem narrow_intersection (s t : State H) (i : GrantId) (requested : List Nat)
    (h : narrow s i requested = some t) : ∃ r,
      usable s i = some r ∧ AList.lookup t.resources ⟨s.next⟩ =
        some { r with rights := r.rights.filter (fun x => decide (x ∈ requested)) } := by
  unfold narrow at h
  obtain ⟨r, hr, hh⟩ := Option.bind_eq_some_iff.mp h
  cases hh
  exact ⟨r, hr, by simp [issue, consumed, AList.lookup]⟩

/-- Acquisition leaves its parent's resource, rights and availability exactly unchanged. -/
theorem acquire_keeps_parent (s t : State H) (i : GrantId) (requested selected : List Nat)
    (permissions : List Cap) (allowed : Bool) (handle : H) (hs : Fresh s)
    (h : acquire s i requested selected permissions allowed handle = some t) :
    usable t i = usable s i := by
  unfold acquire at h
  obtain ⟨r, hr, hh⟩ := Option.bind_eq_some_iff.mp h
  have hb := hs _ (AList.lookup_mem (usable_some s i r hr).1)
  have hi : GrantId.mk s.next ≠ i := by
    intro he; rw [← he] at hb; exact Nat.lt_irrefl _ hb
  split at hh
  · cases hh
    simp [usable, issue, AList.lookup, hi]
  · contradiction

end ConcreteSpec.Core.Grants

