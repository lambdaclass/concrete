from pathlib import Path
p=Path('ConcreteSpec/Spec/Own.lean');s=p.read_text();i=s.index('/-- Accepted: a C1 run lends');s=s[:i]+'''/-- The concrete operand instance for this example erases all permission bookkeeping.
Reads/moves still fetch their concrete value from the same locals. -/
def erasedEval (locals : AList Var Int) (_ : Unit) : E → Res (Int × Unit)
  | .lit n => .ok (n, ())
  | .read x | .move x => match AList.lookup locals x with
    | some n => .ok (n, ())
    | none => .stuck
  | _ => .ok (0, ())

abbrev erasedOps : Exec.Operands where
  Val := Int
  Expr := E
  Ty := Unit
  Store := Unit
  Prim := Empty
  Event := Empty
  unitVal := 0
  unitTy := ()
  isCopy := fun _ => false
  eval := erasedEval
  life := fun _ s => some s
  test := fun n => some (n "'!= 0)
  allows := fun p => nomatch p

def erasedMoveRun : Exec.Report erasedOps :=
  Exec.run ⟨[]⟩ (fun _ p => nomatch p) 100
    ⟨.exec (.seq (.bind y (.move x) ⟨0⟩) (.ret (.read x) ⟨1⟩)), [(x, 7)], (), []⟩

/-- A planted unsafe execution refutes unconditional equality of final classifications:
the instrumented run is stuck, but the erased concrete run returns 7. A checker-safety
premise or a one-way successful-execution theorem is necessary for C1 erasure. -/
example : stuck (runBody (.seq (.bind y (.move x) ⟨0⟩) (.ret (.read x) ⟨1⟩))) = true ∧
    erasedMoveRun.ending = .final (.returned 7) := by decide
example : ¬ erasedMoveRun.ending = .final .normal := by decide

'"''' +s[i:];p.write_text(s)
p=Path('ConcreteSpec/Proofs/Grant.lean');s=p.read_text();i=s.index('end PreservationWitnesses');s=s[:i]+'''/-- A non-escaping dependent survives a different binder's successful scope exit:
the non-escape law's dependent-membership hypothesis is inhabited. -/
def outer : State := (fresh initial ⟨1⟩).getD {}
def outside : Dependency := ⟨⟨3⟩, [⟨1⟩], []⟩
def departing : State := ((depend outer outside).bind fun s => release s ⟨0⟩).getD {}
def departed : State := (endScope departing ⟨0⟩).getD {}
example : WellFormed departing ∧ endScope departing ⟨0⟩ = some departed ∧
    outside ∈ departed.dependencies ∧ (BrandId.mk 0) ∉ outside.brands := by decide
/-- Planted exit mutation lets the surviving dependent mention the exited brand. -/
example : ¬ ((BrandId.mk 0) ∉ ({ outside with brands := [⟨0⟩] } : Dependency).brands) := by decide
''' +s[i:];p.write_text(s)
PY
