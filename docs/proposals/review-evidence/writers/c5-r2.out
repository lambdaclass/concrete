private theorem insert_loan (s : State) (a : Loan) (hs : WellFormed s)
    (hid : a.id = ⟨s.nextLoan⟩) (hact : a.activation < s.nextActivation)
    (hroot : ∃ x ∈ s.slots, x.place = a.root ∧ x.status = .owned)
