  if name.endswith('axioms.golden'): return theirs+ours
  if name.endswith('Spec.lean'): return ours.replace('and "'`Grant`'"','"'`Observe` (C6, observations and the environment), and `Grant`'"')
  return ours.replace('C6–C10 remain.','C7–C10 remain.').replace('the split of a request from its response (C6) and ', '')
