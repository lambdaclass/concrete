import ConcreteSpec.Spec.Hybrid
import ConcreteSpec.Proofs.Memory

/-!
# Hybrid storage laws (C4)

Scalar representation round trip and decode validity; structured reads; materialization reuses
its stable projection; typed writes read back the value and frame inactive bytes. No theorem
assumes a materialized typed cache, and no write selects padding again.
-/
namespace ConcreteSpec.Core.Hybrid
open ConcreteSpec.Core.Mem

@[simp] theorem encode_length (tgt : Target) (v : Value) :
    (encode tgt v).length = sizeof v.ty := by
  cases v <;> simp [encode, Value.ty, sizeof, encodeBool]

theorem rep_roundtrip (tgt : Target) (v : Value) (hv : v.Valid) :
    Rep tgt v.ty (encode tgt v) v := by
  cases v with
  | int t n => simp [Rep, Value.ty, encode, decode, decodeInt_encodeInt tgt t n hv]
  | bool b => simp [Rep, Value.ty, encode, decode]

theorem decode_valid (tgt : Target) (t : Ty) (bs : List MByte) (v : Value)
    (h : decode tgt t bs = some v) : v.ty = t ∧ v.Valid := by
  cases t with
  | int t =>
    cases hd : decodeInt tgt t bs with
    | none => simp [decode, hd] at h
    | some n =>
      simp [decode, hd] at h
      subst v
      exact ⟨rfl, decodeInt_inRange tgt t bs n hd⟩
  | bool =>
    cases hd : decodeBool bs with
    | none => simp [decode, hd] at h
    | some b => simp [decode, hd] at h; subst v; exact ⟨rfl, trivial⟩

theorem read_structured (tgt : Target) (st : State) (p : Place) (t : Ty) (v : Value)
    (hc : st.places p = some ⟨t, .structured v⟩) (ht : v.ty = t) (hv : v.Valid) :
    st.read tgt p = some v := by simp [State.read, hc, ht, hv]

/-- Once materialized, repeated address-taking returns the same range and the same whole state. -/
theorem materialize_reuse (tgt : Target) (st : State) (p : Place) (t : Ty) (r : Range)
    (hc : st.places p = some ⟨t, .materialized r⟩) (s : AddrSpace) (base align : Nat)
    (padding : List MByte) : st.materialize tgt p s base align padding = some (r, st) := by
  simp [State.materialize, hc]

theorem write_read (tgt : Target) (st st' : State) (hw : st.memory.WellFormed tgt)
    (p : Place) (v : Value) (h : st.write tgt p v = some st') :
    st'.read tgt p = some v := by
  unfold State.write at h
  cases hc : st.places p with
  | none => simp [hc] at h
  | some c =>
    simp only [hc] at h
    dsimp at h
    split at h
    next hv =>
      cases hs : c.storage with
      | structured old =>
        simp only [hs, Option.some.injEq] at h
        subst st'
        simp [State.read, State.set, hv]
      | materialized r =>
        simp only [hs] at h
        cases hm : st.memory.store tgt r.ptr (encode tgt v) r.align with
        | none => simp [hm] at h
        | some m =>
          simp [hm] at h
          subst st'
          have hl := store_load tgt st.memory m hw r.ptr (encode tgt v) r.align hm
          rw [encode_length, hv.1] at hl
          simp only [State.read, hc]
          dsimp
          rw [hs]
          dsimp
          rw [hl]
          dsimp
          rw [← hv.1]
          exact rep_roundtrip tgt v hv.2
    next => simp at h

/-- The low-level store frame theorem applies verbatim to a typed write's active encoding.
In particular every padding byte, including initialization and fragments, is preserved. -/
theorem typed_store_frame (tgt : Target) (m m' : Memory) (hw : m.WellFormed tgt)
    (r : Range) (v : Value) (b : MemBlockId) (off i : Nat) (x : Block)
    (ha : m.access tgt r.ptr (encode tgt v).length r.align = some (some (b, off)))
    (hx : m.block b = some x) (h : m.store tgt r.ptr (encode tgt v) r.align = some m')
    (hi : i < off ∨ off + sizeof v.ty ≤ i) :
    (m'.block b).map (fun y => y.bytes[i]?) = some (x.bytes[i]?) := by
  exact store_same_block_frame tgt m m' hw r.ptr (encode tgt v) r.align b off i x ha hx h
    (by simpa using hi)

/-- Every successful materialization leaves the returned range as the place's sole projection. -/
theorem materialize_projection (tgt : Target) (st st' : State) (p : Place) (s : AddrSpace)
    (base align : Nat) (padding : List MByte) (r : Range)
    (h : st.materialize tgt p s base align padding = some (r, st')) :
    ∃ t, st'.places p = some ⟨t, .materialized r⟩ := by
  unfold State.materialize at h
  cases hc : st.places p with
  | none => simp [hc] at h
  | some c =>
    simp only [hc] at h
    dsimp at h
    cases hs : c.storage with
    | materialized old =>
      simp only [hs, Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      exact ⟨c.ty, by cases c; simp_all⟩
    | structured v =>
      simp only [hs] at h
      split at h
      next =>
        cases ha : (st.memory.alloc tgt s base (encode tgt v ++ padding).length align).toOption with
        | none => simp only [ha] at h; cases h
        | some pair =>
          obtain ⟨b, m⟩ := pair
          simp only [ha] at h
          dsimp at h
          cases hm : m.store tgt ⟨s, base, some b⟩ (encode tgt v ++ padding) align with
          | none => simp [hm] at h
          | some m' =>
            simp [hm] at h
            obtain ⟨rfl, rfl⟩ := h
            exact ⟨c.ty, by simp [State.set]⟩
      next => simp at h

/-- Materialization is idempotent after the first success, independently of later address,
alignment or padding inputs. In particular it never asks for another padding selection. -/
theorem materialize_idempotent (tgt : Target) (st st' : State) (p : Place) (s s' : AddrSpace)
    (base align base' align' : Nat) (padding padding' : List MByte) (r : Range)
    (h : st.materialize tgt p s base align padding = some (r, st')) :
    st'.materialize tgt p s' base' align' padding' = some (r, st') := by
  obtain ⟨t, ht⟩ := materialize_projection tgt st st' p s base align padding r h
  exact materialize_reuse tgt st' p t r ht s' base' align' padding'

end ConcreteSpec.Core.Hybrid
import ConcreteSpec.Spec

/-!
# Lemmas about association lists (`Spec/Basics.lean`).

PROPOSED: not normative until the owner freezes Core (ROADMAP A2c). See `ConcreteSpec/README.md`.
-/

namespace ConcreteSpec.Core.AList

variable {κ α β : Type} [DecidableEq κ]

theorem lookup_cons (k' : κ) (a : α) (l : AList κ α) (k : κ) :
    lookup ((k', a) :: l) k = if k' = k then some a else lookup l k := rfl

theorem update_cons (k' : κ) (a : α) (l : AList κ α) (k : κ) (f : α → α) :
    update ((k', a) :: l) k f = if k' = k then (k', f a) :: l else (k', a) :: update l k f := rfl

theorem erase_cons (k' : κ) (a : α) (l : AList κ α) (k : κ) :
    erase ((k', a) :: l) k = if k' = k then erase l k else (k', a) :: erase l k := rfl

theorem lookup_mem : ∀ {l : AList κ α} {k : κ} {a : α}, lookup l k = some a → (k, a) ∈ l
  | [], _, _, h => nomatch h
  | (k', b) :: l, k, a, h => by
    rw [lookup_cons] at h
    by_cases hk : k' = k
    · rw [ite_eq_left hk] at h; cases h; subst hk; exact List.Mem.head _
    · rw [ite_eq_right hk] at h; exact List.Mem.tail _ (lookup_mem h)

theorem lookup_isSome_of_mem : ∀ {l : AList κ α} {k : κ} {a : α}, (k, a) ∈ l →
    ∃ b, lookup l k = some b
  | [], _, _, h => nomatch h
  | (k', b) :: l, k, a, h => by
    rw [lookup_cons]
    by_cases hk : k' = k
    · rw [ite_eq_left hk]; exact ⟨b, rfl⟩
    · rw [ite_eq_right hk]
      cases h with
      | head => exact absurd rfl hk
      | tail _ h => exact lookup_isSome_of_mem h

theorem lookup_map (f : α → β) : ∀ (l : AList κ α) (k : κ), lookup (map f l) k = (lookup l k).map f
  | [], _ => rfl
  | (k', a) :: l, k => by
    show lookup ((k', f a) :: map f l) k = _
    rw [lookup_cons, lookup_cons]
    by_cases hk : k' = k
    · rw [ite_eq_left hk, ite_eq_left hk]; rfl
    · rw [ite_eq_right hk, ite_eq_right hk]; exact lookup_map f l k

theorem lookup_update (k : κ) (f : α → α) : ∀ (l : AList κ α) (q : κ),
    lookup (update l k f) q = if q = k then (lookup l k).map f else lookup l q
  | [], q => by
    show none = _
    by_cases hq : q = k
    · rw [ite_eq_left hq]; rfl
    · rw [ite_eq_right hq]; rfl
  | (k', a) :: l, q => by
    rw [update_cons, lookup_cons k' a l k, lookup_cons k' a l q]
    by_cases hk : k' = k
    · rw [ite_eq_left hk, ite_eq_left hk, lookup_cons]
      by_cases hq : q = k
      · rw [ite_eq_left hq, ite_eq_left (hk.trans hq.symm)]; rfl
      · have hkq : ¬ k' = q := fun h => hq (h ▸ hk)
        rw [ite_eq_right hq, ite_eq_right hkq, ite_eq_right hkq]
    · rw [ite_eq_right hk, ite_eq_right hk, lookup_cons, lookup_update k f l q]
      by_cases hq : q = k
      · have hkq : ¬ k' = q := fun h => hk (h ▸ hq)
        rw [ite_eq_left hq, ite_eq_left hq, ite_eq_right hkq]
      · rw [ite_eq_right hq, ite_eq_right hq]

theorem lookup_erase (k : κ) : ∀ (l : AList κ α) (q : κ),
    lookup (erase l k) q = if q = k then none else lookup l q
  | [], q => by
    show none = _
    by_cases hq : q = k
    · rw [ite_eq_left hq]
    · rw [ite_eq_right hq]; rfl
  | (k', a) :: l, q => by
    rw [erase_cons, lookup_cons k' a l q]
    by_cases hk : k' = k
    · rw [ite_eq_left hk, lookup_erase k l q]
      by_cases hq : q = k
      · rw [ite_eq_left hq, ite_eq_left hq]
      · have hkq : ¬ k' = q := fun h => hq (h ▸ hk)
        rw [ite_eq_right hq, ite_eq_right hq, ite_eq_right hkq]
    · rw [ite_eq_right hk, lookup_cons, lookup_erase k l q]
      by_cases hq : q = k
      · have hkq : ¬ k' = q := fun h => hk (h ▸ hq)
        rw [ite_eq_left hq, ite_eq_left hq, ite_eq_right hkq]
      · rw [ite_eq_right hq, ite_eq_right hq]

theorem mem_of_mem_erase (k : κ) : ∀ {l : AList κ α} {e : κ × α}, e ∈ erase l k → e ∈ l
  | [], _, h => h
  | (k', a) :: l, e, h => by
    rw [erase_cons] at h
    by_cases hk : k' = k
    · rw [ite_eq_left hk] at h; exact List.Mem.tail _ (mem_of_mem_erase k h)
    · rw [ite_eq_right hk] at h
      cases h with
      | head => exact List.Mem.head _
      | tail _ h => exact List.Mem.tail _ (mem_of_mem_erase k h)

theorem erase_map (f : α → β) (k : κ) : ∀ l : AList κ α, erase (map f l) k = map f (erase l k)
  | [] => rfl
  | (k', a) :: l => by
    show erase ((k', f a) :: map f l) k = map f (erase ((k', a) :: l) k)
    rw [erase_cons, erase_cons]
    by_cases hk : k' = k
    · rw [ite_eq_left hk, ite_eq_left hk]; exact erase_map f k l
    · rw [ite_eq_right hk, ite_eq_right hk, erase_map f k l]; rfl

/-- `update` with a function that keeps what `g` sees changes nothing `map g` sees. -/
theorem map_update (g : α → β) (f : α → α) (hg : ∀ a, g (f a) = g a) :
    ∀ (l : AList κ α) (k : κ), map g (update l k f) = map g l
  | [], _ => rfl
  | (k', a) :: l, k => by
    rw [update_cons]
    by_cases hk : k' = k
    · rw [ite_eq_left hk]; show (k', g (f a)) :: map g l = (k', g a) :: map g l; rw [hg]
    · rw [ite_eq_right hk]; show (k', g a) :: map g (update l k f) = (k', g a) :: map g l
      rw [map_update g f hg l k]

end ConcreteSpec.Core.AList
    (octets bs).map fun os => ofBits t (leValue (ordered tgt.byteOrder os))
  else none

/-- The byte of a `bool`. -/
def encodeBool (b : Bool) : List MByte := [.init ⟨boolToBits b, by cases b <;> decide⟩ none]

/-- The `bool` a byte holds: an initialized `0` or `1`. -/
def decodeBool : List MByte → Option Bool
  | [.init v _] => boolOfBits v.val
  | _ => none

/-- The bytes of a stored pointer: its address in the profile's order and pointer width, each byte
a fragment of the pointer. -/
def encodePtr (tgt : Target) (p : Ptr) : List MByte :=
  ((ordered tgt.byteOrder (leBytes tgt.ptrSize p.addr)).zipIdx).map fun (v, i) => .init v (some (p, i))

/-- The pointer the bytes hold, when they are exactly one stored pointer's fragments, in order. Any
other contents have no pointer meaning in this draft (see the module header). -/
def decodePtr (tgt : Target) (bs : List MByte) : Option Ptr :=
  match bs with
  | .init _ (some (p, 0)) :: _ => if bs = encodePtr tgt p then some p else none
  | _ => none

/-! ### Examples -/

/-- The target of the examples. -/
abbrev tgt : Target := linuxX8664

/-- A `u16` `0x1234` is stored little-endian on the x86-64 profile, and reads back. -/
example : encodeInt tgt .u16 0x1234 = [.init 0x34 none, .init 0x12 none] := by decide

example : decodeInt tgt .i16 (encodeInt tgt .i16 (-2)) = some (-2) := by decide

/-- On a big-endian profile the same value is stored the other way round. -/
example : encodeInt { tgt with byteOrder := .big } .u16 0x1234 = [.init 0x12 none, .init 0x34 none] :=
  by decide

/-- An uninitialized byte has no value; byte `2` is no `bool`. -/
example : decodeInt tgt .u8 [.uninit] = none ∧ decodeBool [.init 2 none] = none ∧
    decodeBool (encodeBool true) = some true := by decide

/-- A fresh block is uninitialized: reading it gives bytes, but no integer. -/
example : (do
    let (b, m) ← (Memory.empty.alloc tgt ⟨0⟩ 4096 4 4).toOption
    let bs ← m.load tgt ⟨⟨0⟩, 4096, some b⟩ 4 4
    pure (decodeInt tgt .u32 bs)) = some none := by decide
structure AddrSpace where
  id : Nat
  deriving DecidableEq, Repr

/-- `n` is a positive power of two. -/
def IsPow2 (n : Nat) : Prop := 0 < n ∧ n &&& (n - 1) = 0

instance (n : Nat) : Decidable (IsPow2 n) := by unfold IsPow2; infer_instance

/-- A target profile. Every field is read-only: rules read it and never change it.

- `addrBits`: the width of an address, in bits.
- `ptrSize`, `ptrAlign`: the bytes a stored pointer occupies and its alignment.
- `lenBits`: the width, in bits, a length or index is stored in (its meaning stays `u64`, Q3.5).
- `byteOrder`: the order of a stored value's bytes.
- `spaces`: the address spaces the target has; `dataSpace` is the one ordinary values live in.
- `null`: the distinguished null address.
- `maxObject`: the largest number of bytes one object may occupy. -/
structure Target where
  addrBits : Nat
  ptrSize : Nat
  ptrAlign : Nat
  lenBits : Nat
  byteOrder : ByteOrder
  spaces : List AddrSpace
  dataSpace : AddrSpace
  null : Nat
  maxObject : Nat
  deriving DecidableEq, Repr

/-- What every profile must satisfy.

- An address has at least one bit, and a stored pointer has room for all of them.
- A stored pointer's alignment is a power of two, and its size is a multiple of it (the layout law
  that a size is a multiple of its alignment, FOUNDATION C3).
- A stored pointer fits in one object.
- A stored length has between 1 and 64 bits, since its meaning is a `u64` (Q3.5).
- The data space is one of the target's spaces.
- The null address is an address.
- No object is as large as the address range: `maxObject` is below `2 ^ addrBits`. This is only
  the profile's size bound; that a placed object's one-past address is an address, row Q3.10's
  `base + size ≤ 2^64 − 1` generalized to `2 ^ addrBits − 1` (question 3), is an obligation on each
  block's base and size, stated with memory (C4), not here. -/
def Target.WellFormed (t : Target) : Prop :=
  0 < t.addrBits ∧ t.addrBits ≤ 8 * t.ptrSize ∧ IsPow2 t.ptrAlign ∧ t.ptrSize % t.ptrAlign = 0 ∧
  t.ptrSize ≤ t.maxObject ∧
  0 < t.lenBits ∧ t.lenBits ≤ 64 ∧ t.dataSpace ∈ t.spaces ∧
  t.null < 2 ^ t.addrBits ∧ t.maxObject < 2 ^ t.addrBits

instance (t : Target) : Decidable t.WellFormed := by unfold Target.WellFormed; infer_instance

/-- The existing target, linux-x86_64-hosted (row Q7.1): 64-bit addresses, 8-byte pointers aligned
to 8, 64-bit lengths, little-endian, one data space, null at address 0, and objects of at most
`2^64 − 1` bytes (row Q3.10). -/
def linuxX8664 : Target where
  addrBits := 64
  ptrSize := 8
  ptrAlign := 8

