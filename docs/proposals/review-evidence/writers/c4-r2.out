s=s[:idx]+defs+s[idx:];open(p,'w').write(s)
p='ConcreteSpec/Spec/Hybrid.lean';s=open(p).read();a=s.index('/-- The scalar types');b=s.index('/-- Active byte count',a)
s=s[:a]+'''/-- The common scalar type universe; this byte-storage slice admits int/bool only. -/
abbrev Ty := CTy

/-- Values share the constant subset's scalar model, defined once in Scalar. -/
abbrev Value := CVal

abbrev Value.ty := CVal.ty
abbrev Value.Valid := CVal.Valid

/-- Byte storage in this slice supports integers and bools. Unit has no representation here;
sharing the common value universe does not add unit layout or materialization rules. -/
def Value.Storable (v : Value) : Prop := v.Valid ∧ v.ty ≠ .unit

instance (v : Value) : Decidable v.Storable := by
  cases v <;> dsimp [Value.Storable, Value.Valid, Value.ty, CVal.Valid, CVal.ty] <;> infer_instance

'''+s[b:]
s=s.replace('| .bool => 1','| .bool => 1\\n  | .unit => 0').replace('| .bool b => encodeBool b','| .bool b => encodeBool b\\n  | .unit => []').replace('| .bool, bs => (decodeBool bs).map .bool','| .bool, bs => (decodeBool bs).map .bool\\n  | .unit, _ => none')
s=s.replace('v.Valid','v.Storable') # repairs definition accidentally below
s=s.replace('def Value.Storable (v : Value) : Prop := v.Storable ∧','def Value.Storable (v : Value) : Prop := v.Valid ∧')
s=s.replace('"'`sizeof`'"','"'`sizeof`'"')
open(p,'w').write(s)
p='ConcreteSpec/Proofs/Hybrid.lean';s=open(p).read().replace('v.Valid','v.Storable')
s=s.replace('decodeInt_encodeInt tgt t n hv','decodeInt_encodeInt tgt t n hv.1')
s=s.replace('  | bool b => simp [Rep, Value.ty, encode, decode]','  | bool b => simp [Rep, Value.ty, encode, decode]\\n  | unit => exact False.elim (hv.2 rfl)')
s=s.replace('exact ⟨rfl, decodeInt_inRange tgt t bs n hd⟩','exact ⟨rfl, decodeInt_inRange tgt t bs n hd, by decide⟩')
s=s.replace('exact ⟨rfl, trivial⟩','exact ⟨rfl, trivial, by decide⟩\\n  | unit => cases h')
s=s.replace('    have hpos : 0 < sizeof v.ty := by cases v <;> simp [Value.ty, sizeof, intBytes] <;>\\n      (try cases ‹IntTy› <;> decide)','    have hpos : 0 < sizeof v.ty := by\\n      cases v with\\n      | int t n => cases t <;> decide\\n      | bool b => decide\\n      | unit => exact False.elim (hv.2 rfl)')
open(p,'w').write(s)
p='ConcreteSpec/README.md';s=open(p).read().replace('  of its scalar slice. C5–C10 remain.','  of its scalar slice. The old slice-1 "'`Spec/Rep.lean` still has its own `MByte` and integer'"\\n  encoding over the old type universe. The slice-1-to-Core integration slice must port that\\n  layer to "'`Mem.MByte`/`Mem.encodeInt` and retire the old encoders while preserving its proofs;'"\\n  C4 has not completed that port. Core constants and Hybrid share "'`CTy`/`CVal` from `Scalar`.'"\\n  C5–C10 remain.')
open(p,'w').write(s)
