codex
The hybrid write/read and materialization-idempotence proofs now build. Repeated materialization returns the same range and state even with different address, alignment, or padding inputs.

I’ll add concrete checks for preserved padding and invalid raw bool writes, then run the permitted rule and trust checks. Struct field layouts, C5 permissions, and the C8 oracle remain outside this scalar slice.
exec
/bin/bash -lc "python3 - <<'PY'
p='ConcreteSpec/Proofs/Memory.lean';s=open(p).read();i=s.index('\\nend ConcreteSpec.Core.Mem');s=s[:i]+'''
/-- The allocated block is live and unexposed and every byte is uninitialized. -/
theorem alloc_initialized (tgt : Target) (m : Memory) (s : AddrSpace) (base size align : Nat)
    (b : MemBlockId) (m' : Memory) (h : m.alloc tgt s base size align = .ok (b, m')) :
    ∃ x, m'.block b = some x ∧ x.live = true ∧ x.exposed = false ∧
      x.bytes = List.replicate size .uninit :=
  ⟨candidate s base size align, alloc_block tgt m s base size align b m' h, rfl, rfl, rfl⟩

/-- Releasing a block cannot permit any existing identity to be reused by the next allocation,
even when the allocator reuses the released address. -/
theorem free_alloc_ne_existing (tgt : Target) (m freed allocated : Memory)
    (hw : m.WellFormed tgt) (b c new : MemBlockId) (x : Block)
    (hf : m.free b = some freed) (hc : m.block c = some x)
    (s : AddrSpace) (base size align : Nat)
    (ha : freed.alloc tgt s base size align = .ok (new, allocated)) : new ≠ c := by
  obtain ⟨_, _, _, hn⟩ := free_retains m b freed hf
  obtain ⟨he, _, _⟩ := alloc_result tgt freed s base size align new allocated ha
  have hlt := hw.fresh c x hc
  intro heq
  rw [heq] at he
  have hid := congrArg MemBlockId.id he
  dsimp at hid
  omega

end ConcreteSpec.Core.Mem
''';open(p,'w').write(s)
p='ConcreteSpec/Spec/Hybrid.lean';s=open(p).read();i=s.index('\\nend ConcreteSpec.Core.Hybrid');s=s[:i]+'''
/-- Accepted: materialize once with uninitialized and initialized padding, rewrite the bool,
then observe exactly the original padding. Refused: a raw write of byte 2 leaves no bool value. -/
example : (do
    let st : State := ⟨fun p => if p = ⟨0⟩ then some ⟨.bool, .structured (.bool true)⟩ else none,
      Memory.empty⟩
    let (r, st) ← st.materialize linuxX8664 ⟨0⟩ ⟨0⟩ 4096 1 [.uninit, .init 73 none]
    let st ← st.write linuxX8664 ⟨0⟩ (.bool false)
    let typed := st.read linuxX8664 ⟨0⟩
    let padding := st.memory.load linuxX8664 { r.ptr with addr := 4097 } 2 1
    let st ← st.rawWrite linuxX8664 r.ptr [.init 2 none] 1
    pure (typed, padding, st.read linuxX8664 ⟨0⟩)) =
      some (some (.bool false), some [.uninit, .init 73 none], none) := by decide

/-- Accepted: another raw address-taking reuses the first mapping and first padding, even
when given different proposed storage and padding. -/
example : (do
    let st : State := ⟨fun _ => some ⟨.bool, .structured (.bool true)⟩, Memory.empty⟩
    let (r, st) ← st.materialize linuxX8664 ⟨0⟩ ⟨0⟩ 4096 1 [.init 73 none]
    let (r', st) ← st.materialize linuxX8664 ⟨0⟩ ⟨0⟩ 8192 8 [.init 99 none]
    pure (r.ptr == r'.ptr, st.memory.load linuxX8664 r'.ptr 2 1)) =
      some (true, some [.init 1 none, .init 73 none]) := by decide

end ConcreteSpec.Core.Hybrid
''';open(p,'w').write(s)
PY
