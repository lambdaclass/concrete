s=s.replace('simp only [decodeInt, encodeInt_length, ↓reduceIte, encodeInt, octets_init, Option.map_some,\\n    ordered_ordered]','unfold decodeInt\\n  rw [encodeInt_length, if_pos rfl]\\n  simp only [encodeInt, octets_init, Option.map_some, ordered_ordered]')
s=s[:s.index('  cases hs : tgt.ptrSize')]+'''  have hl : (ordered tgt.byteOrder (leBytes tgt.ptrSize p.addr)).length > 0 := by simpa using hp
  cases hs : ordered tgt.byteOrder (leBytes tgt.ptrSize p.addr) with
