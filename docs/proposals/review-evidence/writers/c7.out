  ```
  theorem no_step_of_final {P} {c} {f} (hf:c.final?=some f) l c' : ¬ Step... := by
   intro hs
   cases hs with
   | silent h =>
     cases c with
     | mk ctrl L st k =>
       cases ctrl with
       | exec s => simp [Config.final?] at hf
       | done =>
         cases k with
         | nil => simp [step] at h
         | cons => simp [Config.final?] at hf
       | exiting e =>
         cases e with
         | ret v =>
           cases k with
           | nil => simp [step] at h
           | cons => simp[Config.final?] at hf
         | _ => simp[Config.final?] at hf
