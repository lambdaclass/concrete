pos=s.index('/-- A report\\'s events')
s=s[:pos]+'''/-- Refusing instrumentation: a local flagged by identity "'`x` may not be dropped.
This only illustrates C1'"'s refusal channel; C5 supplies the actual loan discipline. -/
abbrev refusingOps : Operands := { ops with
  life := fun e st => match e with
    | .drop xs => if x ∈ xs then none else some (DState.life e st)
    | _ => some (DState.life e st) }

/-- Accepted: unflagged locals leave scope normally. Refused: dropping the flagged local
ends in unsafe stuckness, including at the final scope exit. -/
example : (match (run (O := refusingOps) ⟨[]⟩ (fun _ _ _ _ _ => none) 10
    ⟨.exec (.block ⟨0⟩ (.bind x (.lit 1) s)), [], .init, []⟩).ending with
    | .stuck _ => true
    | _ => false) = true := by decide

example : (match (run (O := refusingOps) ⟨[]⟩ (fun _ _ _ _ _ => none) 10
    ⟨.exec (.block ⟨0⟩ (.bind y (.lit 1) s)), [], .init, []⟩).ending with
    | .final .normal => true
    | _ => false) = true := by decide

'''+s[pos:];p.write_text(s)
p=Path('ConcreteSpec/README.md');s=p.read_text().replace('shared state is abstract until C4 and C5 instantiate it.','shared state is abstract until C4 and C5 instantiate it. Lifecycle instrumentation may refuse\\n  an event ("'`Option.none`), making execution stuck, including initial activation and primitive'"\\n  result binding; cleanup laws require successful lifecycle events.');p.write_text(s)
PY
