    dev-home: the gate clone follows lambdaclass/concrete (REPO_URL; an existing clone gets exactly one origin url, no push url, and refuses an insteadOf that sends it elsewhere)

diff --git a/servers/dev-home.sh b/servers/dev-home.sh
index 0e7b882..1d5aabd 100755
--- a/servers/dev-home.sh
+++ b/servers/dev-home.sh
@@ -2,7 +2,7 @@
 # The `dev` user's gate-host setup for `~/bin/concrete-remote`. Run as root
 # (after users.sh). Idempotent; DRY_RUN=1 to preview.
 #
-#   ~dev/concrete2   https clone of unbalancedparentheses/concrete2 (public, so no
+#   ~dev/concrete2   https clone of lambdaclass/concrete (public, so no
 #                    key: concrete-remote only fetches pushed refs), with a warm
 #                    .lake from `nix develop -c lake build` on origin/main.
 #                    concrete-remote seeds each run's .lake from it.
@@ -18,7 +18,7 @@ set -euo pipefail
 need_root
 id dev >/dev/null 2>&1 || die "no user dev (run users.sh dev first)"
 
-REPO_URL=https://github.com/unbalancedparentheses/concrete2
+REPO_URL=https://github.com/lambdaclass/concrete.git
 H=/home/dev
 NIXBIN=/nix/var/nix/profiles/default/bin
 # cd / first: git refuses to start in a cwd dev cannot read (/root).
@@ -33,6 +33,27 @@ log "elan"
 log "concrete2 clone"
 fresh=0
 if ! [ -d "$H/concrete2/.git" ]; then as_dev git clone -q "$REPO_URL" "$H/concrete2"; fresh=1; fi
+# An existing clone follows REPO_URL (the repository moved to lambdaclass/concrete on 2026-11-08; the
+# landing tooling refuses a gate clone whose origin is any other repository): exactly one origin url,
+# no push url, and no url.*.insteadOf that sends either elsewhere. Reads bypass run(), so DRY_RUN=1
+# previews only the changes a real run would make.
+dev_git() { ( cd / && sudo -u dev -H git -C "$H/concrete2" "$@" ); }
+if [ -d "$H/concrete2/.git" ]; then
+  # The clone's own settings (--local: what the writes below change); an inherited origin url, push
+  # url or rewrite is not ours to edit and fails the effective check below.
+  urls="$(dev_git config --local --get-all remote.origin.url || true)"
+  if ! dev_git remote | grep -qx origin; then as_dev git -C "$H/concrete2" remote add origin "$REPO_URL"
+  elif [ "$urls" != "$REPO_URL" ]; then as_dev git -C "$H/concrete2" config --local --replace-all remote.origin.url "$REPO_URL"
+  fi
+  if dev_git config --local --get-all remote.origin.pushurl >/dev/null; then
+    as_dev git -C "$H/concrete2" config --local --unset-all remote.origin.pushurl
+  fi
+  if [ "$DRY_RUN" != 1 ]; then
+    eff="$(dev_git remote get-url --all origin) $(dev_git remote get-url --push --all origin)"
+    [ "$eff" = "$REPO_URL $REPO_URL" ] \
+      || die "~dev/concrete2 origin resolves to '$eff', not $REPO_URL (an inherited origin url, push url or url.*.insteadOf in dev's git config?); fix it by hand"
+  fi
+fi
 if [ "${REBUILD:-0}" = 1 ]; then
   as_dev git -C "$H/concrete2" fetch -q origin main
   as_dev git -C "$H/concrete2" checkout -q --detach origin/main
     1	#!/bin/bash
     2	# The `dev` user's gate-host setup for `~/bin/concrete-remote`. Run as root
     3	# (after users.sh). Idempotent; DRY_RUN=1 to preview.
     4	#
     5	#   ~dev/concrete2   https clone of lambdaclass/concrete (public, so no
     6	#                    key: concrete-remote only fetches pushed refs), with a warm
     7	#                    .lake from `nix develop -c lake build` on origin/main.
     8	#                    concrete-remote seeds each run's .lake from it.
     9	#   ~dev/runs        concrete-remote's per-run checkouts.
    10	#   ~dev/.elan       elan + the repo's lean-toolchain, for the gates that call
    11	#                    ~/.elan/bin/lake directly (check_external_checker.sh).
    12	#   devshells        `nix develop` and `.#provers` profiles in ~/.cache/devshell,
    13	#                    linked from /nix/var/nix/gcroots/concrete so
    14	#                    nix-collect-garbage keeps them warm.
    15	# REBUILD=1 fast-forwards the clone to origin/main and rebuilds.
    16	set -euo pipefail
    17	. "$(dirname "$0")/lib.sh"
    18	need_root
    19	id dev >/dev/null 2>&1 || die "no user dev (run users.sh dev first)"
    20	
    21	REPO_URL=https://github.com/lambdaclass/concrete.git
    22	H=/home/dev
    23	NIXBIN=/nix/var/nix/profiles/default/bin
    24	# cd / first: git refuses to start in a cwd dev cannot read (/root).
    25	as_dev() { ( cd / && run sudo -u dev -H env PATH="$H/.elan/bin:$NIXBIN:/usr/local/bin:/usr/bin:/bin" "$@" ); }
    26	
    27	[ -d "$H/runs" ] || as_dev mkdir -p "$H/runs"
    28	
    29	log "elan"
    30	[ -x "$H/.elan/bin/elan" ] \
    31	  || as_dev sh -c 'curl -sSfL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh | sh -s -- -y --default-toolchain none --no-modify-path'
    32	
    33	log "concrete2 clone"
    34	fresh=0
    35	if ! [ -d "$H/concrete2/.git" ]; then as_dev git clone -q "$REPO_URL" "$H/concrete2"; fresh=1; fi
    36	# An existing clone follows REPO_URL (the repository moved to lambdaclass/concrete on 2026-11-08; the
    37	# landing tooling refuses a gate clone whose origin is any other repository): exactly one origin url,
    38	# no push url, and no url.*.insteadOf that sends either elsewhere. Reads bypass run(), so DRY_RUN=1
    39	# previews only the changes a real run would make.
    40	dev_git() { ( cd / && sudo -u dev -H git -C "$H/concrete2" "$@" ); }
    41	if [ -d "$H/concrete2/.git" ]; then
    42	  # The clone's own settings (--local: what the writes below change); an inherited origin url, push
    43	  # url or rewrite is not ours to edit and fails the effective check below.
    44	  urls="$(dev_git config --local --get-all remote.origin.url || true)"
    45	  if ! dev_git remote | grep -qx origin; then as_dev git -C "$H/concrete2" remote add origin "$REPO_URL"
    46	  elif [ "$urls" != "$REPO_URL" ]; then as_dev git -C "$H/concrete2" config --local --replace-all remote.origin.url "$REPO_URL"
    47	  fi
    48	  if dev_git config --local --get-all remote.origin.pushurl >/dev/null; then
    49	    as_dev git -C "$H/concrete2" config --local --unset-all remote.origin.pushurl
    50	  fi
    51	  if [ "$DRY_RUN" != 1 ]; then
    52	    eff="$(dev_git remote get-url --all origin) $(dev_git remote get-url --push --all origin)"
    53	    [ "$eff" = "$REPO_URL $REPO_URL" ] \
    54	      || die "~dev/concrete2 origin resolves to '$eff', not $REPO_URL (an inherited origin url, push url or url.*.insteadOf in dev's git config?); fix it by hand"
    55	  fi
    56	fi
    57	if [ "${REBUILD:-0}" = 1 ]; then
    58	  as_dev git -C "$H/concrete2" fetch -q origin main
