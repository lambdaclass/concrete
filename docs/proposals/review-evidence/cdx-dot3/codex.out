    73	    as_dev bash -c "cd $H/concrete2 && nix develop .#$shell --profile $H/.cache/devshell/$shell -c true"
    74	  fi
    75	  [ "$(readlink "/nix/var/nix/gcroots/concrete/dev-devshell-$shell" 2>/dev/null)" = "$H/.cache/devshell/$shell" ] \
    76	    || run ln -sfn "$H/.cache/devshell/$shell" "/nix/var/nix/gcroots/concrete/dev-devshell-$shell"
    77	done
    78	
    79	if [ "$fresh" = 1 ] || [ "${REBUILD:-0}" = 1 ] || ! [ -d "$H/concrete2/.lake/build" ]; then
    80	  log "lake build (warm .lake for concrete-remote)"
    81	  as_dev bash -c "cd $H/concrete2 && nix develop -c lake build > $H/build.log 2>&1 && echo ok > $H/build.done"
    82	fi
    83	# The gate-host contract concrete-remote relies on, checked in the session it actually gets: a
    84	# non-login `ssh dev@host bash -s` whose PATH comes from pam_env (/etc/environment), then
    85	# `nix develop`. The devshell inherits that PATH, so a tool the host must supply has to be on it.
    86	# 2026-10-23: Arch's `shasum` was only on login PATHs, and 17 checker-identity gates failed.
    87	if [ "$DRY_RUN" != 1 ]; then
    88	  PAM_PATH=$( { sed -n 's/^PATH=//p' /etc/environment 2>/dev/null || true; } | tail -1 | tr -d "\"'")
    89	  [ -n "$PAM_PATH" ] || PAM_PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/bin
    90	  sudo -u dev env -i HOME="$H" PATH="$PAM_PATH" sh -c 'echo x | shasum -a 256 >/dev/null 2>&1' \
    91	    || die "gate host: shasum not on dev's ssh PATH ($PAM_PATH); concrete's checker identity needs it"
    92	  # pam_env reads /etc/environment everywhere and /etc/default/locale on Ubuntu.
    93	  grep -hqsE '^LANG="?[A-Za-z_]+\.(UTF-8|utf8)' /etc/environment /etc/default/locale \
    94	    || die "gate host: no UTF-8 LANG for pam_env; dev's ssh sessions would run under POSIX"
    95	fi
    96	log "dev ok: $(sudo -u dev git -C "$H/concrete2" rev-parse --short HEAD)"
     1	#!/bin/bash
     2	# Shared helpers for the servers/ scripts. Sourced, not run.
     3	#
     4	# Every script here is idempotent: it compares before it changes anything, so a
     5	# re-run on a configured host reports "ok" and changes nothing. DRY_RUN=1 makes
     6	# every mutation print what it would do instead (reads still happen), which is
     7	# how to check a script against a live host without touching it:
     8	#   sudo DRY_RUN=1 servers/apply.sh fede-256gb
     9	
    10	DRY_RUN=${DRY_RUN:-0}
    11	SERVERS_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    12	
    13	log()  { printf '[%s] %s\n' "${0##*/}" "$*"; }
    14	die()  { printf '[%s] ERROR: %s\n' "${0##*/}" "$*" >&2; exit 1; }
    15	need_root() { [ "$(id -u)" -eq 0 ] || [ "$DRY_RUN" = 1 ] || die "run as root"; }
    16	
    17	# runners_busy: true while any GitHub Actions runner on this host runs a job.
    18	# A Runner.Worker process exists only for the duration of a job. Same answer
    19	# from anywhere: gh api repos/unbalancedparentheses/concrete2/actions/runners \
    20	#   -q '.runners[]|"\(.name) \(.busy)"'
    21	runners_busy() { pgrep -f '/actions-runner-[0-9]+/bin/Runner\.Worker' >/dev/null 2>&1; }
    22	
    23	# guard_runners WHAT: never install/upgrade packages or restart services while
    24	# a runner job is active. On 2026-10-22 an apt install (tailscale.sh) let
    25	# needrestart restart gha3 mid-job and killed a CI run. Waits up to
    26	# RUNNER_WAIT seconds (default 1h) for the runners to go idle, then gives up.
    27	guard_runners() {
    28	  runners_busy || return 0
    29	  if [ "$DRY_RUN" = 1 ]; then printf '  would wait for idle runners before: %s\n' "$1"; return 0; fi
    30	  local waited=0 limit=${RUNNER_WAIT:-3600}
    31	  log "runner jobs active; waiting for idle runners before: $1"
    32	  while runners_busy; do
    33	    [ "$waited" -lt "$limit" ] || die "runners still busy after ${limit}s; not running: $1"
    34	    sleep 30; waited=$((waited + 30))
    35	  done
    36	}
    37	
    38	# run CMD...: execute, or print it under DRY_RUN. Package installs/upgrades and
    39	# service restarts go through guard_runners first, so no script here can
    40	# disturb a running CI job.
    41	run() {
    42	  case " $* " in
    43	    *" apt-get install "*|*" apt-get upgrade "*|*" apt-get dist-upgrade "*|*" pacman -S"*|\
    44	    *" systemctl restart "*|*" systemctl reload "*|*" systemctl stop "*|*" --now "*|*"svc.sh stop"*|*"svc.sh start"*|*"svc.sh uninstall"*|*"nix-install.sh"*)
    45	      guard_runners "$*" ;;
    46	  esac
    47	  if [ "$DRY_RUN" = 1 ]; then printf '  would run: %s\n' "$*"; else "$@"; fi
    48	}
    49	
    50	# write_file PATH MODE OWNER < content: replace PATH only if the content differs.
    51	# Returns 0 if it changed (or would), 1 if it was already up to date, so
    52	# callers can restart a service only when its config moved.
    53	write_file() {
    54	  local path=$1 mode=$2 owner=$3 tmp
    55	  tmp=$(mktemp)
    56	  cat >"$tmp"
    57	  if [ -f "$path" ] && cmp -s "$tmp" "$path"; then
    58	    rm -f "$tmp"; return 1
    59	  fi
    60	  if [ "$DRY_RUN" = 1 ]; then
    61	    printf '  would write: %s\n' "$path"; rm -f "$tmp"; return 0
    62	  fi
    63	  install -D -m "$mode" -o "${owner%%:*}" -g "${owner##*:}" "$tmp" "$path"
    64	  rm -f "$tmp"
    65	  log "wrote $path"
    66	}
    67	
    68	# apt_install PKG...: install only what's missing.
    69	apt_install() {
    70	  local missing=() p
    71	  for p in "$@"; do
    72	    dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q 'install ok installed' || missing+=("$p")
    73	  done
    74	  [ "${#missing[@]}" -eq 0 ] && return 0
    75	  run env DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing[@]}"
    76	}
    77	
    78	# pacman_install PKG...: install only what's missing (Arch).
    79	pacman_install() {
    80	  local missing=() p
    81	  for p in "$@"; do pacman -Qq "$p" >/dev/null 2>&1 || missing+=("$p"); done
    82	  [ "${#missing[@]}" -eq 0 ] && return 0
    83	  run pacman -S --needed --noconfirm "${missing[@]}"
    84	}
    85	
    86	# os_id: ID from /etc/os-release: "arch", or "ubuntu"/"debian" for the apt path
    87	# (Debian-family; fede-256gb is Ubuntu). Arch is the default for new servers
    88	# (decided 2026-10-22).
    89	# shellcheck disable=SC1091
    90	os_id() { . /etc/os-release; echo "$ID"; }
    91	
    92	# retire_units UNIT...: take a service off this host (apply.sh, RETIRED_SERVICES): disable and stop
    93	# its units. The unit files, the service's user and all its state stay on disk, so the data remains
    94	# for reference and the move can be undone by listing the service in SERVICES again. Stops go
    95	# through run(), so they wait for idle runners like every other restart.
    96	retire_units() {
    97	  local u
    98	  for u in "$@"; do
    99	    if [ "$(systemctl is-enabled "$u" 2>/dev/null)" = enabled ]; then run systemctl disable "$u"; fi
   100	    if systemctl is-active -q "$u" 2>/dev/null; then run systemctl stop "$u"; fi
   101	  done
   102	}
   103	
   104	# retire_fail2ban: stop and uninstall fail2ban. SSH is reachable only over Tailscale (ufw allows
   105	# tailscale0 only; nmap 2026-10-31: every public TCP port filtered), so its sshd jail never sees a
   106	# login attempt. Removed 2026-10-31.
   107	retire_fail2ban() {
   108	  local installed=0
   109	  case "$(os_id)" in
   110	    arch) pacman -Q fail2ban >/dev/null 2>&1 && installed=1 ;;
   111	    *) dpkg -s fail2ban >/dev/null 2>&1 && installed=1 ;;
   112	  esac
   113	  [ "$installed" = 1 ] || [ -e /etc/fail2ban/jail.d/sshd.local ] || return 0
   114	  log "fail2ban: removed (SSH is Tailscale-only)"
   115	  retire_units fail2ban.service
   116	  if [ "$installed" = 1 ]; then
   117	    case "$(os_id)" in
   118	      arch) run pacman -Rns --noconfirm fail2ban ;;
   119	      *) run apt-get purge -y fail2ban ;;
   120	    esac
   121	  fi
   122	  [ ! -e /etc/fail2ban/jail.d/sshd.local ] || run rm -f /etc/fail2ban/jail.d/sshd.local
   123	}
   124	
   125	# farm_hold UNIT: the [Service] lines that keep the fuzz farm paused while UNIT (a measuring
   126	# service: perf, leanprof) runs, on a host that runs the farm; nothing elsewhere. The hold is
   127	# fuzz-farm-hold@UNIT.service (services/fuzz-farm.sh), which keeps the farm's own pause flag set.
   128	# Needs the host file loaded (SERVICES).
   129	farm_hold() {
   130	  [[ " ${SERVICES:-} " == *" fuzz-farm "* ]] || return 0
   131	  printf 'ExecStartPre=+/usr/bin/systemctl start fuzz-farm-hold@%s.service\n' "$1"
   132	  printf 'ExecStopPost=+/usr/bin/systemctl stop fuzz-farm-hold@%s.service\n' "$1"
   133	}
   134	
   135	# load_host NAME: read servers/hosts/NAME.env (role, users, runners, services).
   136	load_host() {
   137	  local f=$SERVERS_DIR/hosts/$1.env
   138	  [ -f "$f" ] || die "no host file $f"
   139	  # shellcheck disable=SC1090
   140	  . "$f"
   141	}

