   279	                    check_bytes(st, lo, top, what, allowed=tuple(s for s in saved if s[0] >= lo and s[1] <= top))
   280	                    lr = bool(lr_slot and lr_slot[2] == ("lr", True))
   281	                    saved = frozenset(s for s in saved if not (s[0] >= lo and s[1] <= top))
   282	                    fp = None
