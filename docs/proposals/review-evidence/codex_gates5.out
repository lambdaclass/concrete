   350	
   351	def control(mn, ops):
   352	    """(kind, target) for a control instruction, or (None, None)."""
   353	    if ARCH == "x86_64":
   354	        if mn == "call":
   355	            return "call", ops
   356	        if mn == "jmp":
   357	            return "jmp", ops
   358	        if X86_JCC.match(mn):
