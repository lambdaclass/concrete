   432	                    deepest = max(deepest, st.d, touched or 0)
   433	                    i += 1
   434	                    continue
   435	                if kind == "indirect":
   436	                    raise Refuse(f"{key}+{addr:#x}: indirect branch {mn} {ops}")
   437	                if kind == "ret":
   438	                    if st.d != 0:
   439	                        raise Refuse(f"{key}+{addr:#x}: return at depth {st.d}")
   440	                    if not st.lr:
   441	                        raise Refuse(f"{key}+{addr:#x}: return through a link register not restored")
   442	                    break
   443	                if kind == "stop":
   444	                    break
   445	                tgt, sym = target_of(arg)
   446	                if tgt is None:
   447	                    raise Refuse(f"{key}+{addr:#x}: indirect {mn} {ops}")
