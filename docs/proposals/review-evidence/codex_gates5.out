   383	
   384	def analyse(funcs, stubs):
   385	    """(bound, externals, owned): main's bound, each external's deepest entry depth, both from
   386	    main's entry, and the owned functions' names."""
   387	    owned = {owned_name(n): n for n in funcs if owned_name(n)}
   388	    if "main" not in owned:
   389	        raise Refuse("no main")
   390	    memo, active = {}, set()
