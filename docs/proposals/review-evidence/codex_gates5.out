   393	    plain = X86_PLAIN if ARCH == "x86_64" else A64_PLAIN
   394	
   395	    def add_ext(ext, sub, base):
   396	        for name, depth in sub.items():
   397	            ext[name] = max(ext.get(name, 0), base + depth)
   398	
   399	    def fn_bound(key):
   400	        """(deepest, externals) of owned function `key`, relative to its own entry."""
   401	        if key in memo:
   402	            return memo[key]
   403	        if key in active:
   404	            raise Refuse(f"recursion through {key}")
   405	        active.add(key)
   406	        code = funcs[owned[key]]
   407	        if not code:
   408	            raise Refuse(f"{key}: no instructions")
   409	        index = {a: i for i, (a, _, _) in enumerate(code)}
   410	        seen, work, deepest, ext = {}, [(0, St())], 0, {}
   411	        while work:
