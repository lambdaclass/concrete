   334	# The data-processing instructions whose only effect on the stack is what x86_inst and a64_inst
   335	# model (memory operands, and writes to the stack, frame and link registers). Any other
   336	# instruction on a reachable path is refused: an unknown one may move the stack pointer or
   337	# transfer control (x86 `loop`, a `rep` prefix), so the analysis never treats it as a fallthrough.
   338	X86_PLAIN = re.compile(
   339	    r"^(mov|movabs|movzx|movsx|movsxd|lea|add|sub|adc|sbb|imul|mul|and|or|xor|not|neg|inc|dec"
   340	    r"|cmp|test|shl|shr|sar|sal|rol|ror|cdq|cqo|cdqe|cwde|cbw|cwd|nop|endbr64"
   341	    r"|push|pop|leave|set[a-z]+|cmov[a-z]+)$")
   342	A64_PLAIN = re.compile(
   343	    r"^(mov|movz|movk|movn|add|adds|sub|subs|neg|negs|mul|madd|msub|mneg|smull|umull|smulh|umulh"
   344	    r"|smaddl|umaddl|sdiv|udiv|and|ands|orr|orn|eor|eon|bic|bics|mvn|lsl|lsr|asr|ror|lslv|lsrv"
   345	    r"|asrv|cmp|cmn|tst|ccmp|ccmn|cset|csetm|csel|csinc|csinv|csneg|cinc|cneg|sxtb|sxth|sxtw"
   346	    r"|uxtb|uxth|ubfx|sbfx|ubfm|sbfm|bfi|bfxil|extr|adr|adrp|nop"
   347	    r"|ldr|ldrb|ldrh|ldrsb|ldrsh|ldrsw|ldur|ldurb|ldurh|ldursb|ldursh|ldursw"
