scripts
     1	#!/usr/bin/env python3
     2	"""Stack bound of a slice-0 executable, from its disassembly (README gate 12). PROVISIONAL.
     3	
     4	usage: stack_bound.py ARCH DISASM             -> prints `bound N` and one `external SYM DEPTH` per call
     5	       stack_bound.py ARCH DISASM --ranges    -> also prints `range SYM LO HI` per Concrete function
     6	ARCH is x86_64 or aarch64; DISASM is `llvm-objdump -d --no-show-raw-insn` output of the LINKED
     7	executable (x86-64 in Intel syntax).
     8	
     9	The Concrete-owned code is `main` (the runtime entry), `concrete_rt_write_all` and the body
    10	(`concrete_body`), with or without the Mach-O underscore. From `main`'s entry, every path through
    11	them is followed over the control-flow graph, tracking the stack pointer's depth below its value
    12	at `main`'s entry (and the frame pointer's). The bound is the deepest point reached, by the stack
    13	pointer or by any byte addressed relative to it or the frame pointer (the red zone below the
    14	stack pointer is used without moving it), counting each
    15	internal callee's own bound and the depth at which each external function (libc's `write`,
    16	`_exit`, `abort`) is entered; the external functions' own use is outside it (a premise, listed),
    17	and so is that `_exit` and `abort` do not return (a path ends at a call to one) and that external
    18	functions preserve the frame pointer (the ABI's callee-saved rule; every owned function's return
    19	is checked to restore it).
    20	
    21	Stack addresses never leave the stack and frame pointers: taking one as a value, storing or
    22	loading a saved frame pointer other than through the modelled frame save and restore, touching
    23	bytes at or above the entry stack pointer (the return address, the caller's frame) and returning
    24	through a link register that does not hold the return address are all refused (St, x86_inst,
    25	a64_inst).
    26	
    27	Fail closed: an instruction outside the modelled set (X86_PLAIN, A64_PLAIN and the control
    28	transfers), any instruction that writes the stack pointer in a way not modelled here, an indirect
    29	branch or call, a branch leaving its function, two different depths at one address, a return at a
    30	nonzero depth, recursion, or a call to a function that is neither Concrete-owned nor a PLT/stub
    31	symbol is an error (exit 1), never a bound.
    32	"""
    33	import re
    34	import sys
    35	
    36	OWNED = ("main", "concrete_body", "concrete_rt_write_all")
    37	# External functions that do not return (part of the libc premise): a path ends at a call to one.
    38	NORETURN = ("exit", "_exit", "_Exit", "abort")
    39	
    40	
    41	class Refuse(Exception):
    42	    pass
    43	
    44	
    45	def owned_name(sym):
    46	    s = sym[1:] if sym.startswith("_") and sym[1:] in OWNED else sym
    47	    return s if s in OWNED else None
    48	
    49	
    50	def parse(path):
    51	    """Functions: name -> list of (addr, mnemonic, operands). Also the set of stub symbols."""
    52	    funcs, cur, stubs, section = {}, None, set(), ""
    53	    head = re.compile(r"^([0-9a-f]+) <([^>]+)>:$")
    54	    inst = re.compile(r"^\s*([0-9a-f]+):\s*(\S+)\s*(.*)$")
    55	    for line in open(path, encoding="utf-8", errors="replace"):
    56	        line = line.rstrip("\n")
    57	        if line.startswith("Disassembly of section"):
    58	            section = line.split()[-1].rstrip(":")
    59	            cur = None
    60	            continue
    61	        m = head.match(line)
    62	        if m:
    63	            name = m.group(2)
    64	            if section in (".plt", ".plt.sec", ".plt.got", "__stubs") or name.endswith("@plt"):
    65	                stubs.add(name)
    66	                cur = None
    67	            else:
    68	                cur = name
    69	                funcs.setdefault(name, [])
    70	            continue
    71	        m = inst.match(line)
    72	        if m and cur is not None:
    73	            ops = m.group(3).split("#", 1)[0] if ARCH == "x86_64" else m.group(3).split("//")[0]
    74	            funcs[cur].append((int(m.group(1), 16), m.group(2).lower(), ops.strip()))
    75	    return funcs, stubs
    76	
    77	
    78	def target_of(ops):
    79	    m = re.search(r"0x([0-9a-f]+)\s*<([^>]+)>", ops)
    80	    if not m:
    81	        m2 = re.search(r"\b([0-9a-f]+)\s*<([^>]+)>", ops)
    82	        if not m2:
    83	            return None, None
    84	        m = m2
    85	    return int(m.group(1), 16), m.group(2)
    86	
    87	
    88	def imm(s):
    89	    t = s.strip().lstrip("#")
    90	    try:
    91	        return int(t, 16) if t.lower().startswith(("0x", "-0x")) else int(t)
    92	    except ValueError:
    93	        raise Refuse(f"not an immediate: {s}") from None
    94	
    95	
    96	X86_SP = ("rsp", "esp", "sp", "spl")
    97	X86_FP = ("rbp", "ebp", "bp", "bpl")
    98	X86_STACK = X86_SP + X86_FP
    99	X86_GPR64 = re.compile(r"^(r[abcd]x|r[sd]i|rbp|r(?:8|9|1[0-5]))$")
   100	X86_SIZE = {"byte": 1, "word": 2, "dword": 4, "qword": 8, "tbyte": 10, "xmmword": 16,
   101	            "ymmword": 32, "zmmword": 64}
   102	MEM = re.compile(r"\[([^\]]*)\]")
   103	
   104	
   105	ENTRY = "entry"
   106	
   107	
   108	class St:
   109	    """The abstract state at an instruction: `d`, the stack pointer's depth below the function's
   110	    entry; `fp`, the frame pointer's value: a depth (an int), ENTRY (the caller's frame pointer,
   111	    which every return must restore) or None (unknown); `saved`, the stack slots holding a saved
   112	    frame pointer or link register, as (lowest, highest) byte depths with a tag (("fp", value) or
   113	    ("lr", whether it holds the function's own return address)), kept after the stack pointer
   114	    moves past them, since the memory keeps their contents; `lr`, whether the AArch64 link
   115	    register holds the function's own return address. A byte at depth n lies n bytes below the
   116	    entry stack pointer; the function's own bytes have depth >= 1."""
   117	
   118	    __slots__ = ("d", "fp", "saved", "lr")
   119	
   120	    def __init__(self, d=0, fp=ENTRY, saved=frozenset(), lr=True):
   121	        self.d, self.fp, self.saved, self.lr = d, fp, saved, lr
   122	
   123	    def key(self):
   124	        return (self.d, self.fp, self.saved, self.lr)
   125	
   126	    def but(self, **kw):
   127	        s = St(self.d, self.fp, self.saved, self.lr)
   128	        for k, v in kw.items():
   129	            setattr(s, k, v)
   130	        return s
   131	
   132	
   133	def frame_depth(fp, what):
   134	    """The frame pointer as a depth, for addressing; refused unless it is one."""
   135	    if not isinstance(fp, int):
   136	        raise Refuse(f"frame-relative use of a frame pointer that is not this frame's: {what}")
   137	    return fp
   138	
   139	
   140	def slot_at(saved, lo, hi):
   141	    return next((x for x in saved if x[:2] == (lo, hi)), None)
   142	
   143	
   144	def check_bytes(st, lo, hi, what, allowed=()):
   145	    """The bytes [lo, hi] (depths) are the function's own and overlap no saved slot, except the
   146	    slots `allowed` (the frame-record save/restore itself)."""
   147	    if lo < 1:
   148	        raise Refuse(f"touches the return address or the caller's frame: {what}")
   149	    for slot in st.saved:
   150	        if slot not in allowed and slot[0] <= hi and lo <= slot[1]:
   151	            raise Refuse(f"touches a saved frame pointer or link register: {what}")
   152	
   153	
   154	def x86_inst(mn, ops, st):
   155	    """(new state, deepest byte touched or None) after a non-control x86 instruction. Fails closed:
   156	    a stack or frame pointer read as a value (other than the modelled frame setup), a stack
   157	    address taken (`lea`), an indexed or partial-register stack address, an access of unknown size,
   158	    an access at or above the entry stack pointer or into a saved frame pointer, a stack-pointer
   159	    write that is not modelled, a push or pop of other than a 64-bit general register."""
   160	    what = f"{mn} {ops}"
   161	    args = [a.strip() for a in ops.split(",")] if ops else []
   162	    dst = args[0] if args else ""
   163	    deepest = None
   164	    for m in MEM.finditer(ops):
   165	        inner = m.group(1)
   166	        terms = re.findall(r"[+-]?\s*[^+\-\s]+", inner)
   167	        regs = [t.strip(" +-") for t in terms if not re.fullmatch(r"[+-]?\s*(0x[0-9a-f]+|\d+)", t)]
   168	        base = [r for r in regs if r in X86_STACK]
   169	        if not base:
   170	            continue
   171	        if base[0] not in ("rsp", "rbp"):
   172	            raise Refuse(f"stack address through a partial register: {what}")
   173	        if len(regs) != 1:
   174	            raise Refuse(f"indexed stack address: {what}")
   175	        if mn == "lea":
   176	            raise Refuse(f"stack address taken as a value: {what}")
   177	        size = re.search(r"(\w+) ptr\s*(?:\w+:)?\s*$", ops[:m.start()])
   178	        if not size or size.group(1) not in X86_SIZE:
   179	            raise Refuse(f"stack access of unknown size: {what}")
   180	        k = sum(int(t.replace(" ", ""), 0) for t in terms if t.strip(" +-") not in regs)
   181	        if base[0] == "rbp":
   182	            top = frame_depth(st.fp, what) - k
   183	        else:
   184	            top = st.d - k
   185	        check_bytes(st, top - X86_SIZE[size.group(1)] + 1, top, what)
   186	        deepest = top if deepest is None else max(deepest, top)
   187	    outside = MEM.sub("", ops)
   188	    modelled = (mn, ops) in (("push", "rbp"), ("pop", "rbp"), ("mov", "rbp, rsp"),
   189	                             ("mov", "rsp, rbp"), ("leave", "")) or (
   190	        mn in ("sub", "add") and dst == "rsp" and re.fullmatch(r"rsp, (0x[0-9a-f]+|\d+)", ops))
   191	    if not modelled and any(re.search(rf"\b{r}\b", outside) for r in X86_STACK):
   192	        raise Refuse(f"stack or frame pointer used as a value: {what}")
   193	    if mn in ("push", "pop"):
   194	        if not X86_GPR64.match(dst):
   195	            raise Refuse(f"push/pop of other than a 64-bit general register: {what}")
   196	        if mn == "push":
   197	            d = st.d + 8
   198	            check_bytes(st, d - 7, d, what)
   199	            saved = st.saved | {(d - 7, d, ("fp", st.fp))} if dst == "rbp" else st.saved
   200	            return st.but(d=d, saved=saved), d
   201	        return x86_pop(st, dst, st.d, what), None
   202	    if mn == "leave":
   203	        return x86_pop(st, "rbp", frame_depth(st.fp, what), what), None
   204	    if mn in ("sub", "add") and dst == "rsp":
   205	        n = imm(args[1])
   206	        return st.but(d=st.d + n if mn == "sub" else st.d - n), deepest
   207	    if (mn, ops) == ("mov", "rbp, rsp"):
   208	        return st.but(fp=st.d), deepest
   209	    if (mn, ops) == ("mov", "rsp, rbp"):
   210	        return st.but(d=frame_depth(st.fp, what)), deepest
   211	    if dst in X86_SP:
   212	        raise Refuse(f"unmodelled stack-pointer write: {what}")
   213	    if dst in X86_FP:
   214	        return st.but(fp=None), deepest
   215	    return st, deepest
   216	
   217	
   218	def x86_pop(st, dst, at, what):
   219	    """Pop the 8 bytes whose deepest is at depth `at` into `dst`: a saved frame pointer only into
   220	    rbp, which then holds the saved value again (any other pop into rbp makes it unknown)."""
   221	    slot = slot_at(st.saved, at - 7, at)
   222	    if slot and dst != "rbp":
   223	        raise Refuse(f"a saved frame pointer popped into {dst}: {what}")
   224	    check_bytes(st, at - 7, at, what, allowed=(slot,) if slot else ())
   225	    if dst != "rbp":
   226	        return st.but(d=at - 8)
   227	    fp = slot[2][1] if slot and slot[2][0] == "fp" else None
   228	    return st.but(d=at - 8, fp=fp, saved=st.saved - {slot} if slot else st.saved)
   229	
   230	
   231	A64_SP = ("sp", "wsp")
   232	A64_FP = ("x29", "w29")
   233	A64_LR = ("x30", "w30")
   234	A64_REGSIZE = {"x": 8, "w": 4, "q": 16, "d": 8, "s": 4, "h": 2, "b": 1}
   235	
   236	
   237	def a64_inst(mn, ops, st):
   238	    """(new state, deepest byte touched or None) after a non-control AArch64 instruction. Fails
   239	    closed as x86_inst does, and on: writeback on x29; a register offset from sp or x29; sp or
   240	    x29 stored or read as a value other than the frame record (`stp x29, x30` / `ldp x29, x30`
   241	    with base sp) and the modelled frame setup; a write to x30 other than the frame-record
   242	    restore."""
   243	    what = f"{mn} {ops}"
   244	    args = [a.strip() for a in re.split(r",(?![^\[]*\])", ops)] if ops else []
   245	    first_mem = next((i for i, a in enumerate(args) if a.startswith("[")), len(args))
   246	    data = args[:first_mem]
   247	    is_load, is_store = mn.startswith("ld"), mn.startswith("st")
   248	    d, deepest, saved, fp, lr = st.d, None, st.saved, st.fp, st.lr
   249	    base, record, restored = None, False, False
   250	    if first_mem < len(args):
   251	        mem = args[first_mem]
   252	        post = args[first_mem + 1] if first_mem + 1 < len(args) else None
   253	        m = re.fullmatch(r"\[(\w+)(?:,\s*(#?-?(?:0x)?[0-9a-f]+))?\](!?)", mem)
   254	        if not m:
   255	            if re.search(r"\b(sp|x29|w29|wsp)\b", mem):
   256	                raise Refuse(f"register-offset stack address: {what}")
   257	            base = None
   258	        else:
   259	            base, off, pre = m.group(1), m.group(2), m.group(3) == "!"
   260	        # The frame record: stp/ldp of x29 and x30, with base sp only.
   261	        record = mn in ("stp", "ldp") and data == ["x29", "x30"] and base == "sp"
   262	        if base in A64_FP and (pre or post is not None):
   263	            raise Refuse(f"writeback on the frame pointer: {what}")
   264	        if base in ("sp", "x29"):
   265	            if mn in ("ldrb", "strb", "ldrsb", "ldurb", "sturb", "ldursb"):
   266	                size = 1
   267	            elif mn in ("ldrh", "strh", "ldrsh", "ldurh", "sturh", "ldursh"):
   268	                size = 2
   269	            elif mn in ("ldrsw", "ldursw", "ldpsw"):
   270	                size = 4 * len(data)
   271	            else:
   272	                if not data or data[0][0] not in A64_REGSIZE:
   273	                    raise Refuse(f"stack access of unknown size: {what}")
   274	                size = A64_REGSIZE[data[0][0]] * len(data)
   275	            k = imm(off) if off else 0
   276	            if base == "x29":
   277	                top = frame_depth(fp, what) - k
   278	            elif pre:
   279	                d = d - k
   280	                top = d
   281	            else:
   282	                top = d - k
   283	            if post is not None:
   284	                if base != "sp":
   285	                    raise Refuse(f"unmodelled writeback: {what}")
   286	                top = st.d
   287	                d = d - imm(post)
   288	            lo = top - size + 1
   289	            if record:
   290	                # x29 at the lower address (the deeper half), x30 above it.
   291	                if is_store:
   292	                    check_bytes(st, lo, top, what)
   293	                    saved = saved | {(lo + 8, lo + 15, ("fp", fp)), (lo, lo + 7, ("lr", lr))}
   294	                else:
   295	                    fp_slot, lr_slot = slot_at(saved, lo + 8, lo + 15), slot_at(saved, lo, lo + 7)
   296	                    inside = tuple(x for x in saved if x[0] >= lo and x[1] <= top)
   297	                    check_bytes(st, lo, top, what, allowed=inside)
   298	                    lr = bool(lr_slot and lr_slot[2] == ("lr", True))
   299	                    fp = fp_slot[2][1] if fp_slot and fp_slot[2][0] == "fp" else None
   300	                    saved = frozenset(x for x in saved if x not in inside)
   301	                    restored = True
   302	            else:
   303	                check_bytes(st, lo, top, what)
   304	            deepest = top
   305	        elif base is not None and (pre or post is not None) and base in A64_SP:
   306	            raise Refuse(f"unmodelled stack writeback: {what}")
   307	    if is_store and not record and any(a in A64_SP + A64_FP for a in data):
   308	        raise Refuse(f"stack or frame pointer stored as a value: {what}")
   309	    if is_load:
   310	        if any(a in A64_SP for a in data):
   311	            raise Refuse(f"stack pointer loaded: {what}")
   312	        if any(a in A64_LR for a in data) and not record:
   313	            raise Refuse(f"link register overwritten: {what}")
   314	        if any(a in A64_FP for a in data) and not restored:
   315	            fp = None
   316	        return st.but(d=d, fp=fp, saved=frozenset(saved), lr=lr), deepest
   317	    if is_store:
   318	        return st.but(d=d, fp=fp, saved=frozenset(saved), lr=lr), deepest
   319	    # Not a memory instruction.
   320	    dst, srcs = (args[0] if args else ""), args[1:]
   321	    if dst in A64_SP:
   322	        if mn in ("sub", "add") and len(args) == 3 and args[1] == "sp" and args[2].startswith("#"):
   323	            n = imm(args[2])
   324	            return st.but(d=d + n if mn == "sub" else d - n), None
   325	        if (mn, args[1:]) == ("mov", ["x29"]):
   326	            return st.but(d=frame_depth(fp, what)), None
   327	        if mn in ("sub", "add") and len(args) == 3 and args[1] == "x29" and args[2].startswith("#"):
   328	            n = imm(args[2])
   329	            f = frame_depth(fp, what)
   330	            return st.but(d=f + n if mn == "sub" else f - n), None
   331	        raise Refuse(f"unmodelled stack-pointer write: {what}")
   332	    if dst in A64_FP:
   333	        if (mn, srcs) == ("mov", ["sp"]):
   334	            return st.but(fp=d), None
   335	        if mn == "add" and len(args) == 3 and args[1] == "sp" and args[2].startswith("#"):
   336	            return st.but(fp=d - imm(args[2])), None
   337	        if any(a in A64_SP + A64_FP for a in srcs):
   338	            raise Refuse(f"stack or frame pointer used as a value: {what}")
   339	        return st.but(fp=None), None
   340	    if dst in A64_LR:
   341	        raise Refuse(f"link register overwritten: {what}")
   342	    if any(a in A64_SP + A64_FP for a in srcs):
   343	        raise Refuse(f"stack or frame pointer used as a value: {what}")
   344	    return st, None
   345	
   346	
   347	X86_JCC = re.compile(r"^j(?!mp$)[a-z]+$")
   348	A64_COND = re.compile(r"^b\.[a-z]+$")
   349	
   350	# The data-processing instructions whose only effect on the stack is what x86_inst and a64_inst
   351	# model (memory operands, and writes to the stack, frame and link registers). Any other
   352	# instruction on a reachable path is refused: an unknown one may move the stack pointer or
   353	# transfer control (x86 `loop`, a `rep` prefix), so the analysis never treats it as a fallthrough.
   354	X86_PLAIN = re.compile(
   355	    r"^(mov|movabs|movzx|movsx|movsxd|lea|add|sub|adc|sbb|imul|mul|and|or|xor|not|neg|inc|dec"
   356	    r"|cmp|test|shl|shr|sar|sal|rol|ror|cdq|cqo|cdqe|cwde|cbw|cwd|nop|endbr64"
   357	    r"|push|pop|leave|set[a-z]+|cmov[a-z]+)$")
   358	A64_PLAIN = re.compile(
   359	    r"^(mov|movz|movk|movn|add|adds|sub|subs|neg|negs|mul|madd|msub|mneg|smull|umull|smulh|umulh"
   360	    r"|smaddl|umaddl|sdiv|udiv|and|ands|orr|orn|eor|eon|bic|bics|mvn|lsl|lsr|asr|ror|lslv|lsrv"
   361	    r"|asrv|cmp|cmn|tst|ccmp|ccmn|cset|csetm|csel|csinc|csinv|csneg|cinc|cneg|sxtb|sxth|sxtw"
   362	    r"|uxtb|uxth|ubfx|sbfx|ubfm|sbfm|bfi|bfxil|extr|adr|adrp|nop"
   363	    r"|ldr|ldrb|ldrh|ldrsb|ldrsh|ldrsw|ldur|ldurb|ldurh|ldursb|ldursh|ldursw"
   364	    r"|str|strb|strh|stur|sturb|sturh|ldp|stp|ldpsw)$")
   365	
   366	
   367	def control(mn, ops):
   368	    """(kind, target) for a control instruction, or (None, None)."""
   369	    if ARCH == "x86_64":
   370	        if mn == "call":
   371	            return "call", ops
   372	        if mn == "jmp":
   373	            return "jmp", ops
   374	        if X86_JCC.match(mn):
   375	            return "jcc", ops
   376	        if mn == "ret":
   377	            if ops:
   378	                return "indirect", ops
   379	            return "ret", None
   380	        if mn in ("ud2", "hlt", "int3"):
   381	            return "stop", None
   382	        return None, None
   383	    if mn == "bl":
   384	        return "call", ops
   385	    if mn == "b":
   386	        return "jmp", ops
   387	    if A64_COND.match(mn) or mn in ("cbz", "cbnz", "tbz", "tbnz"):
   388	        return "jcc", ops
   389	    if mn in ("blr", "br", "braa", "blraa", "braaz", "blraaz"):
   390	        return "indirect", ops
   391	    if mn == "ret" and not ops:
   392	        return "ret", None
   393	    if mn in ("ret", "retaa", "retab"):
   394	        return "indirect", ops
   395	    if mn in ("brk", "udf", "hlt"):
   396	        return "stop", None
   397	    return None, None
   398	
   399	
   400	def analyse(funcs, stubs):
   401	    """(bound, externals, owned): main's bound, each external's deepest entry depth, both from
   402	    main's entry, and the owned functions' names."""
   403	    owned = {owned_name(n): n for n in funcs if owned_name(n)}
   404	    if "main" not in owned:
   405	        raise Refuse("no main")
   406	    memo, active = {}, set()
   407	    ret_push = 8 if ARCH == "x86_64" else 0
   408	    inst = x86_inst if ARCH == "x86_64" else a64_inst
   409	    plain = X86_PLAIN if ARCH == "x86_64" else A64_PLAIN
   410	
   411	    def add_ext(ext, sub, base):
   412	        for name, depth in sub.items():
   413	            ext[name] = max(ext.get(name, 0), base + depth)
   414	
   415	    def fn_bound(key):
   416	        """(deepest, externals) of owned function `key`, relative to its own entry."""
   417	        if key in memo:
   418	            return memo[key]
   419	        if key in active:
   420	            raise Refuse(f"recursion through {key}")
   421	        active.add(key)
   422	        code = funcs[owned[key]]
   423	        if not code:
   424	            raise Refuse(f"{key}: no instructions")
   425	        index = {a: i for i, (a, _, _) in enumerate(code)}
   426	        seen, work, deepest, ext = {}, [(0, St())], 0, {}
   427	        while work:
   428	            i, st = work.pop()
   429	            while True:
   430	                if i >= len(code):
   431	                    raise Refuse(f"{key}: runs off its end")
   432	                addr, mn, ops = code[i]
   433	                if addr in seen:
   434	                    if seen[addr] != st.key():
   435	                        raise Refuse(f"{key}+{addr:#x}: states {seen[addr]} and {st.key()} meet")
   436	                    break
   437	                seen[addr] = st.key()
   438	                kind, arg = control(mn, ops)
   439	                if kind is None:
   440	                    if not plain.match(mn):
   441	                        raise Refuse(f"{key}+{addr:#x}: unmodelled instruction: {mn} {ops}")
   442	                    try:
   443	                        st, touched = inst(mn, ops, st)
   444	                    except Refuse as e:
   445	                        raise Refuse(f"{key}+{addr:#x}: {e}") from None
   446	                    if st.d < 0:
   447	                        raise Refuse(f"{key}+{addr:#x}: stack above the entry")
   448	                    deepest = max(deepest, st.d, touched or 0)
   449	                    i += 1
   450	                    continue
   451	                if kind == "indirect":
   452	                    raise Refuse(f"{key}+{addr:#x}: indirect branch {mn} {ops}")
   453	                if kind == "ret":
   454	                    if st.d != 0:
   455	                        raise Refuse(f"{key}+{addr:#x}: return at depth {st.d}")
   456	                    if not st.lr:
   457	                        raise Refuse(f"{key}+{addr:#x}: return through a link register not restored")
   458	                    if st.fp != ENTRY:
   459	                        raise Refuse(f"{key}+{addr:#x}: return without the caller's frame pointer restored")
   460	                    break
   461	                if kind == "stop":
   462	                    break
   463	                tgt, sym = target_of(arg)
   464	                if tgt is None:
   465	                    raise Refuse(f"{key}+{addr:#x}: indirect {mn} {ops}")
   466	                if kind == "call":
   467	                    base = sym.split("+")[0]
   468	                    callee = owned_name(base)
   469	                    d = st.d
   470	                    if any(x[0] > d for x in st.saved):
   471	                        # The callee's frame lies below d, where a freed saved slot still holds
   472	                        # a stack address the callee could read.
   473	                        raise Refuse(f"{key}+{addr:#x}: call over a freed saved frame slot")
   474	                    if callee and "+" not in sym:
   475	                        sub_deep, sub_ext = fn_bound(callee)
   476	                        deepest = max(deepest, d + ret_push + sub_deep)
   477	                        add_ext(ext, sub_ext, d + ret_push)
   478	                    elif base in stubs or base.endswith("@plt"):
   479	                        # ELF `write@plt`; Mach-O stubs carry one extra leading underscore.
   480	                        name = base.removesuffix("@plt") if base.endswith("@plt") else base[1:]
   481	                        add_ext(ext, {name: 0}, d + ret_push)
   482	                        deepest = max(deepest, d + ret_push)
   483	                        if name in NORETURN:
   484	                            break
   485	                    else:
   486	                        raise Refuse(f"{key}+{addr:#x}: call to {sym}, neither owned nor a stub")
   487	                    if ARCH == "aarch64":
   488	                        st = st.but(lr=False)  # bl wrote x30: this function's return address is gone
   489	                    i += 1
   490	                    continue
   491	                if tgt not in index:
   492	                    raise Refuse(f"{key}+{addr:#x}: branch leaves the function: {mn} {ops}")
   493	                if kind == "jmp":
   494	                    i = index[tgt]
   495	                    continue
   496	                work.append((index[tgt], st))
   497	                i += 1
   498	        active.discard(key)
   499	        memo[key] = (deepest, ext)
   500	        return memo[key]
   501	
   502	    total, ext = fn_bound("main")
   503	    return total, ext, owned
   504	
   505	
   506	if __name__ == "__main__":
   507	    if len(sys.argv) not in (3, 4) or sys.argv[1] not in ("x86_64", "aarch64"):
   508	        sys.exit("usage: stack_bound.py x86_64|aarch64 DISASM [--ranges]")
   509	    ARCH = sys.argv[1]
   510	    try:
   511	        funcs, stubs = parse(sys.argv[2])
   512	        total, ext, owned = analyse(funcs, stubs)
   513	    except Refuse as e:
   514	        print(f"refused: {e}")
   515	        sys.exit(1)
   516	    print(f"bound {total}")
   517	    for name, depth in sorted(ext.items()):
   518	        print(f"external {name} {depth}")
   519	    if len(sys.argv) == 4 and sys.argv[3] == "--ranges":
   520	        for key, name in sorted(owned.items()):
   521	            code = funcs[name]
   522	            print(f"range {key} {code[0][0]:#x} {code[-1][0]:#x}")

exec
