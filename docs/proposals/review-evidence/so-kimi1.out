diff --git a/scripts/land/signoff.sh b/scripts/land/signoff.sh
new file mode 100644
index 00000000..20551dd7
--- /dev/null
+++ b/scripts/land/signoff.sh
@@ -0,0 +1,120 @@
+#!/usr/bin/env bash
+# OWNER SIGN-OFF RECORDS (ROADMAP R-0618; owner, 2026-11-08: "when a branch reaches its review-round
+# cap, the owner may approve one exact commit SHA after Codex, Kimi and agy have all reviewed it; the
+# approval is recorded"). A sign-off is review provenance for that one commit, as a clean
+# refs/notes/concrete-review note is (scripts/review/verify.sh); train.sh accepts either for a member.
+#
+#   signoff.sh record <commit> --date YYYY-MM-DD --quote TEXT --codex FILE --kimi FILE --agy FILE
+#   signoff.sh verify <commit>
+#
+# THE RECORD is the ref refs/owner-signoff/<full sha>, a commit whose tree holds record.txt and the
+# three reviewers' verdict outputs, copied in byte for byte (codex.txt, kimi.txt, agy.txt), so any
+# clone that fetches the ref can check them. record.txt is `key: value` lines, each key once:
+#   signoff: owner
+#   commit: <the 40-hex SHA approved>
+#   date: YYYY-MM-DD
+#   quote: <the owner's words, verbatim; they name the commit by a prefix of at least 7 hex digits>
+#   verdict-codex: codex.txt <sha256>
+#   verdict-kimi: kimi.txt <sha256>
+#   verdict-agy: agy.txt <sha256>
+# `record` writes the ref locally and pushes nothing (push it to both remotes: the pre-push hook takes
+# refs/owner-signoff/* in its no-source-tree tier). Only the owner's recorded words go in a quote.
+#
+# `verify` accepts the record only if the ref exists, the tree holds exactly those four files, every
+# key is present once and well formed, `commit` is the commit asked about, the quote names it, each
+# file's sha256 is the recorded one, and each output's last VERDICT line is `VERDICT: ACCEPT`. It
+# judges the exact commit: a sign-off says nothing about any other commit.
+#
+# Exit codes: 0 a valid sign-off; 1 a sign-off that does not qualify (the reason is printed);
+#             2 no sign-off, or a usage error.
+set -euo pipefail
+PREFIX=refs/owner-signoff
+REVIEWERS="codex kimi agy"
+
+usage() { awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"; }
+die() { echo "signoff: $*" >&2; exit 2; }
+sha256() { if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -d' ' -f1; else shasum -a 256 | cut -d' ' -f1; fi; }
+
+cmd_record() {
+  [ $# -ge 1 ] || die "record: name the commit"
+  local sha date="" quote="" r f v; sha="$(git rev-parse -q --verify "$1^{commit}")" || die "record: not a commit: $1"; shift
+  local codex="" kimi="" agy=""
+  while [ $# -gt 0 ]; do
+    [ $# -ge 2 ] || die "record: $1 needs a value"
+    case "$1" in
+      --date) date="$2" ;; --quote) quote="$2" ;;
+      --codex) codex="$2" ;; --kimi) kimi="$2" ;; --agy) agy="$2" ;;
+      *) die "record: unknown option $1" ;;
+    esac; shift 2
+  done
+  [[ "$date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "record: --date YYYY-MM-DD is required"
+  [ -n "$quote" ] && [[ "$quote" != *$'\n'* ]] || die "record: --quote is required, on one line"
+  local rec="signoff: owner
+commit: $sha
+date: $date
+quote: $quote" entries=""
+  for r in $REVIEWERS; do
+    f="${!r}"; [ -f "$f" ] || die "record: --$r FILE is required (the reviewer's verdict output)"
+    v="$(git hash-object -w -- "$f")"
+    rec="$rec
+verdict-$r: $r.txt $(sha256 < "$f")"
+    entries="${entries}100644 blob $v	$r.txt
+"
+  done
+  v="$(printf '%s\n' "$rec" | git hash-object -w --stdin)"
+  local tree commit
+  tree="$(printf '%s100644 blob %s\trecord.txt\n' "$entries" "$v" | git mktree)"
+  commit="$(git commit-tree "$tree" -m "owner sign-off of $sha ($date)")"
+  git update-ref "$PREFIX/$sha" "$commit"
+  echo "signoff: recorded $PREFIX/$sha -> ${commit:0:10}; verify, then push it to both remotes"
+  cmd_verify "$sha"
+}
+
+cmd_verify() {
+  [ $# -eq 1 ] || die "usage: signoff.sh verify <commit>"
+  local sha ref; sha="$(git rev-parse -q --verify "$1^{commit}")" || die "verify: not a commit: $1"
+  ref="$PREFIX/$sha"
+  git rev-parse -q --verify "$ref^{commit}" >/dev/null || { echo "$sha has no owner sign-off ($ref)"; exit 2; }
+  bad() { echo "$sha owner sign-off does not qualify: $*"; exit 1; }
+  local rec line k v seen=" " F_signoff="" F_commit="" F_date="" F_quote="" F_verdict_codex="" F_verdict_kimi="" F_verdict_agy=""
+  rec="$(git cat-file blob "$ref:record.txt")"
+  while IFS= read -r line; do
+    [[ "$line" =~ ^([a-z-]+):\ (.*)$ ]] || bad "record.txt line is not key: value: '$line'"
+    k="${BASH_REMATCH[1]}" v="${BASH_REMATCH[2]}"
+    case "$seen" in *" $k "*) bad "record.txt repeats $k" ;; esac
+    seen="$seen$k "
+    case "$k" in signoff|commit|date|quote|verdict-codex|verdict-kimi|verdict-agy) ;; *) bad "record.txt has the unknown key $k" ;; esac
+    printf -v "F_${k//-/_}" '%s' "$v"
+  done <<< "$rec"
+  for k in signoff commit date quote; do case "$seen" in *" $k "*) ;; *) bad "record.txt has no $k" ;; esac; done
+  [ "$F_signoff" = owner ] || bad "signoff is '$F_signoff', not owner"
+  [ "$F_commit" = "$sha" ] || bad "the record is for $F_commit, not $sha"
+  [[ "$F_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || bad "date '$F_date' is not YYYY-MM-DD"
+  local named=0 w
+  for w in $(printf '%s' "$F_quote" | tr -c '0-9a-f' ' '); do
+    [ "${#w}" -ge 7 ] && [ "${sha#"$w"}" != "$sha" ] && named=1
+  done
+  [ "$named" = 1 ] || bad "the quote does not name ${sha:0:10} (a prefix of at least 7 hex digits): '$F_quote'"
+  local r n entry file hash got verdict
+  for r in $REVIEWERS; do n="F_verdict_$r"; [ -n "${!n}" ] || bad "the record has no $r verdict"; done
+  local want="agy.txt codex.txt kimi.txt record.txt" have
+  have="$(git ls-tree --name-only "$ref" | sort | tr '\n' ' ')"
+  [ "$have" = "$want " ] || bad "the record holds [${have% }], not exactly [$want]"
+  for r in $REVIEWERS; do
+    n="F_verdict_$r"; entry="${!n}"
+    file="${entry%% *}" hash="${entry#* }"
+    [ "$file" = "$r.txt" ] && [[ "$hash" =~ ^[0-9a-f]{64}$ ]] || bad "verdict-$r is '$entry', not '$r.txt <sha256>'"
+    got="$(git cat-file blob "$ref:$file" | sha256)"
+    [ "$got" = "$hash" ] || bad "the sha256 of $file is $got, not the recorded $hash"
+    verdict="$(git cat-file blob "$ref:$file" | grep -E '^[[:space:]]*VERDICT: (ACCEPT|REJECT)[[:space:]]*$' | tail -1 | tr -d '[:space:]')" || true
+    [ "$verdict" = "VERDICT:ACCEPT" ] || bad "the $r output's last verdict is '${verdict:-none}', not VERDICT: ACCEPT"
+  done
+  echo "$sha signed off by the owner ($F_date; codex, kimi and agy accepted): \"$F_quote\""
+}
+
+case "${1:-}" in
+  record) shift; cmd_record "$@" ;;
+  verify) shift; cmd_verify "$@" ;;
+  -h|--help) usage ;;
+  *) usage >&2; exit 2 ;;
+esac
diff --git a/scripts/land/train.sh b/scripts/land/train.sh
index 59d79cd2..5079a36f 100755
--- a/scripts/land/train.sh
+++ b/scripts/land/train.sh
@@ -393,176 +393,217 @@ cmd_build() {
 # ~/bin/concrete-remote (the default), or scripts/land/run-at-ref.sh on the server; empty disables.
 # The runner must print `sha=<sha>` for the commit it ran; a run of any other SHA is no result.
 # With LAND_REMOTE_PUSH=1 (default) the head is first published as wip/land-<name>-<sha>-<pid>-<n>
 # (the hook's backup tier) so a runner that fetches from the remote can see it, and deleted
 # afterwards; the
 # server's local runner fetches from this clone instead (LAND_REMOTE_PUSH=0, ref = the SHA).
 remote_runner() {
   local r="${LAND_REMOTE_RUNNER-$HOME/bin/concrete-remote}"
   if [ -n "$r" ] && [ -x "$r" ]; then echo "$r"; fi
   return 0
 }
 
 remote_leg() { # name head
   local name="$1" head="$2" runner ref
   runner="$(remote_runner)"
   ref="$head"
   if [ "${LAND_REMOTE_PUSH:-1}" = 1 ]; then
     refuse_fork "$REMOTE"
     # One ref per run, created only if absent (no --force), so concurrent checks never share one.
     # Created only if ABSENT. An empty lease is not enough: git reports a ref that already holds
     # this SHA as "up to date" (success) before it looks at the lease, so ownership is taken only
     # from --porcelain's `*` (new ref) line; `=` is another run's ref and gets a fresh name.
     local try ok=0 out
     for try in 1 2 3; do
       ref="${LAND_REMOTE_REF_FIRST:-wip/land-$name-${head:0:12}-$$-$RANDOM$RANDOM}"; LAND_REMOTE_REF_FIRST=""
       out="$(git push --porcelain --force-with-lease="refs/heads/$ref:" "$REMOTE" "$head:refs/heads/$ref" 2>&1)" || true
       case $'\n'"$out"$'\n' in *$'\n*\t'"$head:refs/heads/$ref"$'\t'*) ok=1; break ;; esac
       echo "remote: refs/heads/$ref was not created by this run (${out//$'\n'/ | }); trying another name"
     done
     [ "$ok" = 1 ] || return 1
     # Removed even when the leg is interrupted. A deletion publishes nothing, so it skips the gates
     # (the hook's wip tier exempts only non-deletions), and the lease removes only this run's ref.
     trap 'CONCRETE_SKIP_GATES=1 git push -q --force-with-lease="refs/heads/'"$ref"':'"$head"'" "'"$REMOTE"'" ":refs/heads/'"$ref"'" 2>/dev/null || true' EXIT
   fi
   local rc=0 out
   out="$("$runner" "$ref" "${LAND_FULL_GATES_CMD:-lake build && bash scripts/checks/run.sh}" 2>&1)" || rc=$?
   printf '%s\n' "$out"
   if [ "${LAND_REMOTE_PUSH:-1}" = 1 ]; then
     # The normal-path deletion, logged; the EXIT trap above stays as the backstop for interruptions.
     local dout
     # The backstop is disarmed BEFORE this one attempt, which is never retried: a push that fails
     # may still have deleted the ref, and a later run may have re-created the name at the same SHA,
     # where a retry's lease would match. An unconfirmed deletion is reported and left alone.
     trap - EXIT
     if dout="$(CONCRETE_SKIP_GATES=1 git push --force-with-lease="refs/heads/$ref:$head" "$REMOTE" ":refs/heads/$ref" 2>&1)"; then
       echo "remote: deleted refs/heads/$ref"
     else
       echo "remote: deletion of refs/heads/$ref NOT confirmed; left for a human (not retried): ${dout//$'\n'/ | }"
     fi
   fi
   case "$out" in *"sha=$head"*) ;; *) echo "remote: the runner did not report running ${head:0:10}; no result"; return 1 ;; esac
   return "$rc"
 }
 
 # The gate host (heavy legs default to concrete-ci-2, docs/LANDING.md "Gate host"):
 # LAND_GATES_HOST if set (empty = none), else `git config land.gatesHost`. With a gate host the impact
 # leg runs there through scripts/land/gates_remote.sh, for the exact head SHA, and its pass is
 # attested so the `ci` push's hook reuses it. An unreachable host is INCOMPLETE and fails the check;
 # running the gates on this machine instead takes the explicit `check --local-gates`.
 gates_host() {
   if [ -n "${LAND_GATES_HOST+x}" ]; then echo "$LAND_GATES_HOST"
   else git config --get land.gatesHost 2>/dev/null || true; fi
   return 0
 }
 
 # The review command: LAND_REVIEW_CMD, else scripts/review/review.sh, called with --base --head.
 # Empty when there is neither, which `check` refuses (it never skips the leg silently).
 review_cmd() {
   if [ -n "${LAND_REVIEW_CMD:-}" ]; then echo "$LAND_REVIEW_CMD"
   elif [ -f scripts/review/review.sh ]; then echo "bash scripts/review/review.sh"; fi
   return 0
 }
 
 # REVIEW PROVENANCE (fail closed; docs/LANDING.md, "check" and "land"). A train is reviewed when its
 # head carries a clean review note, or when its head carries no review note and every member carries
 # one at its exact recorded SHA (each member was reviewed at its own head: the landing bot's trains,
 # and a train rebuilt from reviewed branches). Every note is judged by scripts/review/verify.sh, on
 # $REMOTE's notes (fetched first, replacing the local copy, as verify.sh --fetch does): an absent,
 # malformed, blocked or findings note qualifies nothing, and a head note that is not clean is not
 # overridden by its members. Prints what qualified; on failure prints why and returns 1.
+#
+# OWNER SIGN-OFF (R-0618). A member without a clean note qualifies instead by a valid owner sign-off
+# at its exact SHA (scripts/land/signoff.sh verify, on $REMOTE's refs/owner-signoff/*, fetched first).
+# A sign-off approves that commit only, never what the train did with it, so a train with a signed-off
+# member must be exactly the clean merge of its members onto its base: one --no-ff merge per member,
+# in order, each merge's tree the conflict-free `git merge-tree --write-tree` of its two parents, and
+# nothing else (no resolved conflict, no regenerated view, no extra commit).
 VERIFY="$SELF_DIR/../review/verify.sh"
+SIGNOFF="$SELF_DIR/signoff.sh"
+
+# pure_merge BASE HEAD SHA... → empty when HEAD is BASE plus exactly one clean merge of each SHA, in
+# order; otherwise prints why.
+pure_merge() {
+  local base="$1" head="$2" cur="$2" i p t want; shift 2
+  local shas=("$@")
+  for ((i = ${#shas[@]} - 1; i >= 0; i--)); do
+    read -r -a p <<< "$(git rev-list --parents -n 1 "$cur")"
+    if [ "${#p[@]}" != 3 ] || [ "${p[2]}" != "${shas[i]}" ]; then
+      echo "${head:0:10} is not the clean merge of its members onto ${base:0:10}: ${cur:0:10} is not the merge of ${shas[i]:0:10}"; return 0
+    fi
+    if ! t="$(git merge-tree --write-tree "${p[1]}" "${shas[i]}" 2>/dev/null | head -1)" || [ -z "$t" ]; then
+      echo "${head:0:10} is not the clean merge of its members onto ${base:0:10}: merging ${shas[i]:0:10} conflicts"; return 0
+    fi
+    want="$(git rev-parse "$cur^{tree}")"
+    if [ "$t" != "$want" ]; then
+      echo "${head:0:10} is not the clean merge of its members onto ${base:0:10}: ${cur:0:10} differs from the clean merge of ${shas[i]:0:10}"; return 0
+    fi
+    cur="${p[1]}"
+  done
+  [ "$cur" = "$base" ] || echo "${head:0:10} is not the clean merge of its members onto ${base:0:10}: the merges start at ${cur:0:10}"
+}
 review_provenance() { # name head
   local name="$1" head="$2" out m n=0 bad=""
   [ -f "$VERIFY" ] || { echo "no review verifier ($VERIFY is missing)"; return 1; }
   git fetch -q "$REMOTE" "+refs/notes/concrete-review:refs/notes/concrete-review" 2>/dev/null \
     || { echo "could not fetch refs/notes/concrete-review from $REMOTE"; return 1; }
   if out="$(bash "$VERIFY" "$head" 2>&1)"; then echo "the head ${head:0:10} carries a clean review note"; return 0; fi
   if git notes --ref=refs/notes/concrete-review show "$head" >/dev/null 2>&1; then
     echo "the head's review note does not qualify: ${out//$'\n'/ }"; return 1
   fi
+  local signed=0 shas=() so impure
+  git fetch -q --prune "$REMOTE" "+refs/owner-signoff/*:refs/owner-signoff/*" 2>/dev/null \
+    || { echo "could not fetch refs/owner-signoff/* from $REMOTE"; return 1; }
   for m in $(state_get_soft "$name" members | tr ',' ' '); do
-    n=$((n + 1))
-    out="$(bash "$VERIFY" "${m##*@}" 2>&1)" || bad="$bad; member ${m%@*}: ${out//$'\n'/ }"
+    n=$((n + 1)); shas+=("${m##*@}")
+    out="$(bash "$VERIFY" "${m##*@}" 2>&1)" && continue
+    if so="$(bash "$SIGNOFF" verify "${m##*@}" 2>&1)"; then signed=$((signed + 1)); continue; fi
+    bad="$bad; member ${m%@*}: ${out//$'\n'/ }; ${so//$'\n'/ }"
   done
   [ "$n" -gt 0 ] || { echo "the head ${head:0:10} has no review note and the train records no members"; return 1; }
-  [ -z "$bad" ] || { echo "the head ${head:0:10} has no review note, and not every member has a clean one$bad"; return 1; }
+  [ -z "$bad" ] || { echo "the head ${head:0:10} has no review note, and not every member has a clean one or an owner sign-off$bad"; return 1; }
+  if [ "$signed" -gt 0 ]; then
+    impure="$(pure_merge "$(state_get_soft "$name" base)" "$head" "${shas[@]}")"
+    [ -z "$impure" ] || { echo "$signed member(s) signed off by the owner, but $impure"; return 1; }
+    echo "the head has no review note; every member ($n) carries a clean one or an owner sign-off ($signed) at its exact SHA, and the head is their clean merge"
+    return 0
+  fi
   echo "the head has no review note; every member ($n) carries a clean one at its exact SHA"
 }
 
 # Codex review leg. It passes without running the reviewer when the train already has review
 # provenance. Otherwise it runs the review command; a non-zero exit fails, and so does a zero exit
 # that leaves no provenance (no note, or a malformed, blocked or findings note at the head).
 review_leg() { # name base head
   local why
   if why="$(review_provenance "$1" "$3")"; then echo "review: $why; not reviewed again"; return 0; fi
   echo "review: $why; running the reviewer"
   bash -c "$(review_cmd) --base $2 --head $3" || return $?
   why="$(review_provenance "$1" "$3")" || { echo "review: the reviewer exited 0, but $why"; return 1; }
   echo "review: $why"
 }
 
 cmd_check() {
   local name="" remote=1 review=1 local_gates=0
   while [ $# -gt 0 ]; do
     case "$1" in
       --no-remote) remote=0 ;;
       --no-review) review=0 ;;
       --local-gates) local_gates=1 ;;
       -*) die "check: unknown option $1" ;;
       *) name="$1" ;;
     esac; shift
   done
   valid_name "$name"
   require_train_checkout "$name"
   stage_start
   local base head; base="$(state_get "$name" base)"; head="$(git rev-parse HEAD)"
   # A new check withdraws the previous one: a failing re-run must not leave an old pass standing.
   [ "$DRY" = 1 ] || state_set "$name" checked ""
   if [ "$remote" = 1 ] && [ -z "$(remote_runner)" ]; then remote=0; fi
   if [ "$review" = 1 ] && [ -z "$(review_cmd)" ]; then
     log_row "$name" check failed "no review command"
     die "check: no review command (LAND_REVIEW_CMD is unset and scripts/review/review.sh is missing); the review leg is required and is never skipped silently. Restore the reviewer, or pass --no-review explicitly (land still requires review provenance)"
   fi
   local ghost=""; [ "$local_gates" = 1 ] || ghost="$(gates_host)"
   local impact_cmd=(bash "$SELF_DIR/impact_gates.sh") impact_where="here"
   if [ -n "$ghost" ]; then impact_cmd=(bash "$SELF_DIR/gates_remote.sh" --host "$ghost"); impact_where="on $ghost"
   elif [ "$local_gates" = 0 ]; then note "no gate host configured (LAND_GATES_HOST / git config land.gatesHost): the impact gates run on this machine"; fi
   # The attestation describes one run; a new check withdraws the previous one before it starts.
   [ "$DRY" = 1 ] || rm -f "$(git rev-parse --git-path concrete-prepush-remote-record)" \
     "$(git rev-parse --git-path concrete-prepush-remote-record).log"
 
   # The legs are independent, so they run AT THE SAME TIME and are all collected (LANDING.md,
   # "Pipelining"): the impact selection over exactly the range the `ci` push will present
   # (base..head on ci/<name>, so that push reuses the hook's record), the remote full set, and the
   # Codex review. Any failing leg fails the check.
   if [ "$DRY" = 1 ]; then
     note "(dry-run) would run in parallel: impact gates $impact_where (hook line 'refs/heads/train/$name $head refs/heads/ci/$name $base')"
     if [ "$remote" = 1 ]; then note "(dry-run)   + remote full gates: $(remote_runner) <ref of ${head:0:10}> '${LAND_FULL_GATES_CMD:-lake build && bash scripts/checks/run.sh}'"; fi
     if [ "$review" = 1 ]; then note "(dry-run)   + review: the train's review provenance, else $(review_cmd) --base $base --head $head"; fi
     return 0
   fi
   local dir="$STATE_ROOT/$name/check-${head:0:12}"; mkdir -p "$dir"
   local t0; t0="$(date +%s)"
   legs_start impact "$dir/impact.log" "${impact_cmd[@]}" --base "$base" --head "$head" \
     --src-ref "refs/heads/train/$name" --dst-ref "refs/heads/ci/$name"
   if [ "$remote" = 1 ]; then legs_start remote "$dir/remote.log" remote_leg "$name" "$head"; fi
   if [ "$review" = 1 ]; then legs_start review "$dir/review.log" review_leg "$name" "$base" "$head"; fi
   legs_wait
   local wall=$(( $(date +%s) - t0 )) leg
   cat "$dir/impact.log"
   for leg in $LEGS_FAILED; do
     [ "$leg" = impact ] && continue
     note "$leg leg FAILED at ${head:0:10}; tail of $dir/$leg.log:"; tail -n 40 "$dir/$leg.log" || true
   done
   note "legs: $LEGS_REPORT; wall ${wall}s, sequential ${LEGS_SUM}s"
   # gates_remote.sh exit 3: no result about head (host unreachable, wrong SHA, lost log). It blocks
   # like a failure and is recorded as INCOMPLETE, never as a pass or as a gate failure.
   local impact_rc=0; [ -f "$dir/impact.log.rc" ] && read -r impact_rc _ < "$dir/impact.log.rc"
   local verdict; verdict="$([ -z "$LEGS_FAILED" ] && echo passed || echo failed)"
   if [ -n "$ghost" ] && [ "$impact_rc" = 3 ]; then verdict=incomplete; fi
   log_row "$name" check-legs "$verdict" "$LEGS_REPORT wall=${wall}s sum=${LEGS_SUM}s"
   if [ -z "$LEGS_FAILED" ]; then
     state_set "$name" checked "$head"
     log_row "$name" check passed "impact $impact_where$([ "$remote" = 1 ] && echo ' + remote')$([ "$review" = 1 ] && echo ' + review')"
     note "check passed at ${head:0:10}; next: train.sh ci $name"
   elif [ "$verdict" = incomplete ]; then
diff --git a/.githooks/pre-push b/.githooks/pre-push
index d7eb97c3..d9efe8d4 100755
--- a/.githooks/pre-push
+++ b/.githooks/pre-push
@@ -1,118 +1,119 @@
 #!/usr/bin/env bash
 # Pre-push gate for the restarted root.
 #
 # A push that can reach main or a ci/* candidate builds the specification and runs every root check
 # (scripts/checks/run.sh), the same set CI's "Root checks" and "Spec build" jobs run. The set is small
 # and fast, so there is no selection: everything runs on every such push. legacy/ is frozen and never
 # run; scripts/checks/legacy_frozen.sh is the only check that looks at it.
 #
 # Tiers decided from git's ref lines on stdin (`<local ref> <local sha> <remote ref> <remote sha>`):
 #   - only refs/heads/wip/* updates or deletions: a backup of unfinished work, which can never become
 #     main. Conflict markers are refused; nothing else runs.
 #   - only the review-note refs (refs/notes/concrete-review, refs/notes/concrete-review-findings,
-#     written by scripts/review/review.sh): no source tree, nothing to check.
+#     written by scripts/review/review.sh) and owner sign-off records (refs/owner-signoff/<sha>,
+#     written by scripts/land/signoff.sh): no source tree, nothing to check.
 #   - anything else, including a by-hand run with no stdin: the full root set, and only from a full
 #     clone (a linked worktree is refused; ISS-0015).
 #
 # Deliberate bypass:  CONCRETE_SKIP_GATES=1 git push   (you then own the CI result)
 set -uo pipefail
 HOOK_SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
 # train.sh asks the hook git would run which hook it is (ISS-0015): called with the single argument
 # --concrete-identify (git always passes a remote name and URL, never this), this one answers with
 # its real path and runs nothing. A wrapper that passes its arguments on to it (acceptance.sh's
 # guard) gets the same answer; a hook that never runs this one gives none. An argument, not an
 # environment variable, so nothing a push inherits can turn the gates off.
 if [ "$#" = 1 ] && [ "$1" = --concrete-identify ]; then
   echo "concrete-pre-push $(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
   exit 0
 fi
 ROOT_DIR="$(git rev-parse --show-toplevel)"
 cd "$ROOT_DIR"
 
 if [ "${CONCRETE_SKIP_GATES:-0}" = "1" ]; then
   echo "pre-push: gates SKIPPED by CONCRETE_SKIP_GATES=1 — you own the CI result." >&2
   exit 0
 fi
 
 wip_refs=0; wip_dels=0; note_refs=0; other_refs=0; wip_shas=""; full_shas=""
 # Kept whole so the hook can hand the same lines to itself when it re-enters the gate shell (below).
 HOOK_STDIN="$(cat)"
 while read -r _localref localsha remoteref _remotesha; do
   [ -z "${localsha:-}" ] && continue
   case "${remoteref:-}" in
     refs/heads/wip/*)
       case "$localsha" in
         *[!0]*) wip_refs=$((wip_refs+1)); wip_shas="$wip_shas $localsha" ;;
         *) wip_dels=$((wip_dels+1)) ;;
       esac ;;
-    refs/notes/concrete-review|refs/notes/concrete-review-findings)
+    refs/notes/concrete-review|refs/notes/concrete-review-findings|refs/owner-signoff/*)
       case "$localsha" in
         *[!0]*) note_refs=$((note_refs+1)) ;;
         *) other_refs=$((other_refs+1)) ;;   # deleting a review note takes the full tier
       esac ;;
     *) other_refs=$((other_refs+1))
        case "$localsha" in *[!0]*) full_shas="$full_shas $localsha" ;; esac ;;
   esac
 done <<< "$HOOK_STDIN"
 
 if [ "$other_refs" -eq 0 ] && [ $((wip_refs + wip_dels)) -gt 0 ]; then
   bad=""
   for sha in $wip_shas; do
     rc=0; git grep -qE '^(<{7}|>{7}|\|{7})( |$)|^={7}$' "$sha" -- . ':(exclude)legacy/' >/dev/null 2>&1 || rc=$?
     case "$rc" in
       0) bad="$bad $sha" ;;
       1) ;;
       *) echo "pre-push (wip tier): could not scan $sha (git grep exit $rc) — refusing"; exit 1 ;;
     esac
   done
   [ -z "$bad" ] || { echo "pre-push (wip tier): conflict markers in$bad — refusing"; exit 1; }
   echo "pre-push: wip/* backup push ($wip_refs update(s), $wip_dels deletion(s)) — conflict-marker check only; the full set runs on ci/* and main"
   exit 0
 fi
 if [ "$other_refs" -eq 0 ] && [ "$note_refs" -gt 0 ]; then
-  echo "pre-push: review-notes push — no source tree, no gates"
+  echo "pre-push: review-notes push (review notes, owner sign-offs) — no source tree, no gates"
   exit 0
 fi
 
 # The checks build sandbox repositories, and a linked worktree hands its hook
 # GIT_DIR=<repo>/.git/worktrees/<name>: on 2026-11-06 that turned a review-tool check into writes on a
 # real clone and on GitHub (ISS-0015). Every repository-making script now clears git's variables, and
 # as a second wall a push that runs the checks must come from a full clone. The wip and notes tiers
 # above run nothing, so a worktree may still back up its branch.
 if [ "$(cd "$(git rev-parse --git-dir)" && pwd -P)" != "$(cd "$(git rev-parse --git-common-dir)" && pwd -P)" ]; then
   echo "pre-push: refusing: this push runs the root checks, and $ROOT_DIR is a linked worktree; push it from a full clone (git clone), never a worktree." >&2
   exit 1
 fi
 
 # The checks run in the gate shell (scripts/checks/lib/gate_env.sh refuses anywhere else). From
 # outside it, the hook re-executes itself inside `nix develop` with the same arguments and stdin.
 if [ "${CONCRETE_GATES_SHELL:-}" != 1 ] || ! command -v lake >/dev/null 2>&1; then
   if [ "${CONCRETE_PREPUSH_REENTERED:-0}" = 1 ]; then
     echo "pre-push: nix develop did not provide the gate shell with Lean — refusing to push." >&2; exit 1
   fi
   command -v nix >/dev/null 2>&1 || {
     echo "pre-push: the checks run inside nix develop, and nix is not on PATH — refusing to push." >&2; exit 1; }
   echo "pre-push: entering nix develop for the checks"
   CONCRETE_PREPUSH_REENTERED=1 exec nix develop "$ROOT_DIR" --command bash "$HOOK_SELF" "$@" <<< "$HOOK_STDIN"
 fi
 
 # The checks judge the work tree, so it must be the commit being pushed, unmodified.
 head="$(git rev-parse HEAD)"
 for sha in $full_shas; do
   [ "$sha" = "$head" ] || {
     echo "pre-push: pushing ${sha:0:10}, but the checkout is at ${head:0:10}; the checks would judge the wrong commit — check it out and push from there." >&2
     exit 1; }
 done
 if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
   echo "pre-push: the work tree has uncommitted changes to tracked files; the checks would not judge what is pushed — refusing." >&2
   exit 1
 fi
 
 echo "pre-push: building the specification…"
 BUILD_LOG="$(mktemp "${TMPDIR:-/tmp}/prepush-build.XXXXXX")" || BUILD_LOG=/dev/null
 lake build >"$BUILD_LOG" 2>&1 || { echo "pre-push: BUILD FAILED — see $BUILD_LOG" >&2; exit 1; }
 
 echo "pre-push: root checks…"
 bash scripts/checks/run.sh || { echo "pre-push: ROOT CHECKS FAILED (above) — fix, or bypass deliberately." >&2; exit 1; }
 echo "pre-push: build and root checks pass"
 exit 0
diff --git a/scripts/checks/landing_script.sh b/scripts/checks/landing_script.sh
index 421e8402..446d820f 100755
--- a/scripts/checks/landing_script.sh
+++ b/scripts/checks/landing_script.sh
@@ -1057,177 +1057,238 @@ out="$(bash "$TRAIN" --dry-run land tm3 2>&1)"; rc=$?
 [ "$rc" = 5 ] && has "$out" "the record holds other candidates only" \
   && ok "a staged move (legacy/ already on the base) still needs a rehearsal of its own" || { no "staged move: dry-run land exit $rc"; echo "$out" | sed 's/^/      /'; }
 MB="$HM"
 # acceptance.sh's dry-run leg passes a refusal only when it is exit 5 with the marker as a whole line.
 (
   . "$ROOT_DIR/scripts/land/lib.sh"
   dryland_only_move_gate 5 "x"$'\n'"$MOVE_GATE_MARKER"$'\n'"train: land: ..." && echo pass1
   dryland_only_move_gate 5 "train: land: refused" || echo pass2
   dryland_only_move_gate 1 "$MOVE_GATE_MARKER" || echo pass3
   dryland_only_move_gate 4 "$MOVE_GATE_MARKER" || echo pass4
   dryland_only_move_gate 5 "note: $MOVE_GATE_MARKER" || echo pass5
   dryland_only_move_gate 5 "${MOVE_GATE_MARKER%.}" || echo pass6
 ) > "$TMP/dl.out" 2>&1
 [ "$(tr '\n' ' ' < "$TMP/dl.out")" = "pass1 pass2 pass3 pass4 pass5 pass6 " ] \
   && ok "acceptance's dry-run leg: exit 5 + whole marker line passes; no marker, another exit, a prefixed or altered marker fail" || { no "dryland classifier: $(cat "$TMP/dl.out")"; }
 # acceptance.sh refuses a --name or --ref that could forge a record row, before writing anything.
 for bad in "--name x"$'\n'"y" "--ref wip/a"$'\t'"b"; do
   o="$(cd "$W" && ACCEPT_REHEARSALS="$TMP/reh.forged" ACCEPT_RECORD="$TMP/acc.forged" bash "$ROOT_DIR/scripts/land/acceptance.sh" --ref wip/x ${bad%% *} "${bad#* }" 2>&1)"; r=$?
   [ "$r" = 2 ] && has "$o" "${bad%% *} must" && [ ! -e "$TMP/reh.forged" ] && [ ! -e "$TMP/acc.forged" ] \
     && ok "acceptance refuses ${bad%% *} with a record delimiter and writes no row" || { no "acceptance ${bad%% *} delimiter: exit $r"; echo "$o" | sed 's/^/      /'; }
 done
 # acceptance.sh's check leg keeps the review leg (it never passes --no-review), and its build leg and
 # broken-build control run the one build command, the root's.
 ACC="$ROOT_DIR/scripts/land/acceptance.sh"
 grep -qxF 'do_check() { TRAIN check "$NAME" --no-remote; }' "$ACC" && ! grep -qE '^[^#]*--no-review' "$ACC" \
   && grep -qxF 'BUILD_CMD="${ACCEPT_BUILD_CMD:-nix develop --command lake build}"' "$ACC" \
   && [ "$(grep -cF 'bash -c "$BUILD_CMD"' "$ACC")" = 2 ] && ! grep -qF 'make build' "$ACC" \
   && ok "acceptance: check keeps the review leg; both build legs run nix develop --command lake build" || no "acceptance check or build wiring"
 # A run that fails before it has a train (here, a ref that does not exist) records its failure in
 # acceptance.tsv and writes no rehearsal row, so it cannot block the next rehearsal or land.
 o="$(cd "$W" && for v in $(compgen -e); do case "$v" in LAND_*|CONCRETE_SKIP_*) unset "$v" ;; esac; done
      ACCEPT_REHEARSALS="$TMP/reh.early" ACCEPT_RECORD="$TMP/acc.early" bash "$ROOT_DIR/scripts/land/acceptance.sh" --ref wip/no-such-ref 2>&1)"; r=$?
 [ "$r" != 0 ] && [ ! -e "$TMP/reh.early" ] && has "$(cat "$TMP/acc.early" 2>/dev/null)" $'verdict\tfailed' \
   && has "$o" "binds no candidate" && ok "an acceptance run that fails before building a train writes no rehearsal row" || { no "early acceptance failure: exit $r"; echo "$o" | sed 's/^/      /'; }
 # The gate keys on what the candidate touches, not on a name: a non-move train needs no record (t1
 # landed above with none), and the new root's inventory alone also makes a move.
 rm -f "$REH"
 git checkout -q -b bmove2 "$MB"; mkdir -p scripts/checks; printf 'README.md\n' > scripts/checks/root_inventory.txt; commit_all bmove2
 bash "$TRAIN" build tm2 bmove2 >/dev/null 2>&1 || no "inventory train build"
 git checkout -q train/tm2; HM2="$(git rev-parse HEAD)"
 bash "$TRAIN" check tm2 --no-remote >/dev/null 2>&1 || no "inventory train check"
 printf '[{"databaseId": 5252, "headSha": "%s", "createdAt": "9999-01-01T00:00:00Z"}]' "$HM2" > "$FAKE_GH_DIR/list.json"
 bash "$TRAIN" ci tm2 >/dev/null 2>&1 || no "inventory train ci"
 runjson "$HM2" success success
 out="$(bash "$TRAIN" --dry-run land tm2 2>&1)"; rc=$?
 [ "$rc" = 5 ] && has "$out" "no rehearsal record" && ok "a candidate adding scripts/checks/root_inventory.txt is a move too" || { no "inventory move: dry-run land exit $rc"; echo "$out" | sed 's/^/      /'; }
 # Only the inventory's TOP-LEVEL entry set counts. main gets an inventory first (a direct push, as
 # the moved-main leg above does); then a candidate that edits only nested entries, comments and the
 # order needs no rehearsal, while one that adds a top-level entry, and one that changes legacy/, does.
 ( cd "$TMP/other" && git fetch -q origin && git reset -q --hard origin/main && mkdir -p scripts/checks \
   && printf '# day one\nREADME.md\nlegacy\ndocs\ndocs/LANDING.md\n' > scripts/checks/root_inventory.txt \
   && git add -A && git commit -qm inventory && CONCRETE_SKIP_GATES=1 git push -q origin main )
 git checkout -q main && git fetch -q origin && git reset -q --hard origin/main
 MI="$(git rev-parse HEAD)"
 inv_leg(){ # train branch run-id -> builds, checks and runs CI for the train; dry-run land in $out/$rc
   bash "$TRAIN" build "$1" "$2" >/dev/null 2>&1 || no "$1 build"
   git checkout -q "train/$1"; local h; h="$(git rev-parse HEAD)"
   bash "$TRAIN" check "$1" --no-remote >/dev/null 2>&1 || no "$1 check"
   printf '[{"databaseId": %s, "headSha": "%s", "createdAt": "9999-01-01T00:00:00Z"}]' "$3" "$h" > "$FAKE_GH_DIR/list.json"
   bash "$TRAIN" ci "$1" >/dev/null 2>&1 || no "$1 ci"
   runjson "$h" success success
   out="$(bash "$TRAIN" --dry-run land "$1" 2>&1)"; rc=$?
 }
 git checkout -q -b binv-nested "$MI"
 printf '# the day-one root, reordered\ndocs/proposals\ndocs/LANDING.md\ndocs\nlegacy\nREADME.md\n' > scripts/checks/root_inventory.txt
 commit_all binv-nested
 inv_leg tin1 binv-nested 5454
 [ "$rc" = 0 ] && ! has "$out" "move candidate" \
   && ok "an inventory change of nested entries, comments and order only (docs/proposals) needs no rehearsal" || { no "nested inventory change: dry-run land exit $rc"; echo "$out" | sed 's/^/      /'; }
 git checkout -q -b binv-root "$MI"
 printf '# day one\nREADME.md\nNEWS.md\nlegacy\ndocs\ndocs/LANDING.md\n' > scripts/checks/root_inventory.txt
 commit_all binv-root
 inv_leg tin2 binv-root 5455
 [ "$rc" = 5 ] && has "$out" "no rehearsal record" \
   && ok "an inventory change that adds a top-level entry still needs a rehearsal" || { no "top-level inventory change: dry-run land exit $rc"; echo "$out" | sed 's/^/      /'; }
 git checkout -q -b binv-legacy "$MI"; printf 'edited old tree\n' > legacy/old.txt; commit_all binv-legacy
 inv_leg tin3 binv-legacy 5456
 [ "$rc" = 5 ] && has "$out" "no rehearsal record" \
   && ok "a change under legacy/ (inventory untouched) still needs a rehearsal" || { no "legacy change: dry-run land exit $rc"; echo "$out" | sed 's/^/      /'; }
 
+# An owner sign-off record (scripts/land/signoff.sh), published to origin. put-signoff <sha> <mode>
+# [<other sha>]: valid; none removes it; othersha records <other sha> and files it under <sha>;
+# tampered changes kimi.txt after recording; noagy drops agy's verdict; reject ends agy's output
+# with VERDICT: REJECT; unnamed has a quote that names no commit.
+printf '#!/usr/bin/env bash\nSIGNOFF=%q\n' "$ROOT_DIR/scripts/land/signoff.sh" > "$TMP/put-signoff"
+cat >> "$TMP/put-signoff" <<'SIGNOFF_EOF'
+set -e
+sha="$(git rev-parse "$1")"; mode="$2"; R=refs/owner-signoff
+git update-ref -d "$R/$sha" 2>/dev/null || true
+CONCRETE_SKIP_GATES=1 git push -q origin ":$R/$sha" 2>/dev/null || true
+[ "$mode" = none ] && exit 0
+d="$(mktemp -d)"
+for r in codex kimi agy; do printf 'review by %s\n  VERDICT: ACCEPT\n' "$r" > "$d/$r"; done
+[ "$mode" = reject ] && printf 'withdrawn\nVERDICT: REJECT\n' >> "$d/agy"
+q="sign off ${sha:0:8}, yes"; [ "$mode" = unnamed ] && q="sign off the branch"
+target="$sha"; [ "$mode" = othersha ] && target="$(git rev-parse "$3")"
+bash "$SIGNOFF" record "$target" --date 2026-11-08 --quote "$q" --codex "$d/codex" --kimi "$d/kimi" --agy "$d/agy" >/dev/null 2>&1 || true
+c="$(git rev-parse "$R/$target")"
+tab="$(printf '\t')"
+case "$mode" in
+  othersha) git update-ref "$R/$sha" "$c"; git update-ref -d "$R/$target" ;;
+  tampered) b="$(printf 'review by kimi, edited\nVERDICT: ACCEPT\n' | git hash-object -w --stdin)"
+    t="$(git ls-tree "$c" | sed "s/blob [0-9a-f]*${tab}kimi.txt\$/blob $b${tab}kimi.txt/" | git mktree)"
+    git update-ref "$R/$sha" "$(git commit-tree "$t" -m tampered)" ;;
+  noagy) b="$(git cat-file blob "$c:record.txt" | grep -v '^verdict-agy:' | git hash-object -w --stdin)"
+    t="$(git ls-tree "$c" | grep -v 'agy.txt$' | sed "s/blob [0-9a-f]*${tab}record.txt\$/blob $b${tab}record.txt/" | git mktree)"
+    git update-ref "$R/$sha" "$(git commit-tree "$t" -m noagy)" ;;
+esac
+rm -rf "$d"
+CONCRETE_SKIP_GATES=1 git push -q -f origin "$R/$sha"
+SIGNOFF_EOF
+
 echo "=== review: check fails closed, land requires review provenance ==="
 git checkout -q main && git fetch -q origin && git reset -q --hard origin/main
 MR="$(git rev-parse HEAD)"
 git checkout -q -b brv1 "$MR"; printf 'rv1\n' > rv1.txt; commit_all brv1
 git checkout -q -b brv2 "$MR"; printf 'rv2\n' > rv2.txt; commit_all brv2
 bash "$TRAIN" build trv brv1 brv2 >/dev/null 2>&1 || no "review train build"
 git checkout -q train/trv; HR="$(git rev-parse HEAD)"; R1="$(git rev-parse brv1)"; R2="$(git rev-parse brv2)"
 out="$(LAND_REVIEW_CMD= bash "$TRAIN" check trv --no-remote 2>&1)"; rc=$?
 [ "$rc" != 0 ] && has "$out" "no review command" && has "$out" "never skipped silently" \
   && ok "check with no review command fails instead of skipping the leg" || { no "missing reviewer: check exit $rc"; echo "$out" | sed 's/^/      /'; }
 for m in none malformed blocked findings; do
   echo "$m" > "$FAKE_GH_DIR/review.mode"
   out="$(bash "$TRAIN" check trv --no-remote 2>&1)"; rc=$?
   [ "$rc" != 0 ] && has "$out" "review leg FAILED" \
     && ok "a reviewer that exits 0 leaving $( [ "$m" = none ] && echo 'no note' || echo "a $m note") fails check" || { no "reviewer $m: check exit $rc"; echo "$out" | sed 's/^/      /'; }
 done
 rm -f "$FAKE_GH_DIR/review.mode"
 out="$(bash "$TRAIN" ci trv 2>&1)"; rc=$?
 [ "$rc" != 0 ] && has "$out" "no passing check" && ok "a failed review leg leaves no pass for ci" || no "ci after a failed review leg: exit $rc"
 # land: check --no-review passes the gates alone; land then judges the notes itself.
 bash "$TMP/put-review" "$HR" none
 bash "$TRAIN" check trv --no-remote --no-review >/dev/null 2>&1 || no "check --no-review"
 printf '[{"databaseId": 6161, "headSha": "%s", "createdAt": "9999-01-01T00:00:00Z"}]' "$HR" > "$FAKE_GH_DIR/list.json"
 bash "$TRAIN" ci trv >/dev/null 2>&1 || no "review train ci"
 runjson "$HR" success success
 prov_leg(){ # label head-mode m1-mode m2-mode expect(refuse|pass) [expected text]
   bash "$TMP/put-review" "$HR" "$2"; bash "$TMP/put-review" "$R1" "$3"; bash "$TMP/put-review" "$R2" "$4"
   local o r; o="$(bash "$TRAIN" --dry-run land trv 2>&1)"; r=$?
   if [ "$5" = refuse ]; then
     [ "$r" = 1 ] && has "$o" "has no review provenance" && has "$o" "${6:-}" && [ "$(git ls-remote origin refs/heads/main | cut -f1)" = "$MR" ] \
       && ok "land refuses $1" || { no "land with $1 (exit $r)"; echo "$o" | sed 's/^/      /'; }
   else
     [ "$r" = 0 ] && has "$o" "${6:-}" && ok "land accepts $1" || { no "land with $1 (exit $r)"; echo "$o" | sed 's/^/      /'; }
   fi
 }
 prov_leg "no review note anywhere" none none none refuse "member brv1:"
 for m in malformed blocked findings; do
   prov_leg "an unreviewed head over a $m member note" none clean "$m" refuse "member brv2:"
   prov_leg "a $m head note, whatever the members" "$m" clean clean refuse "the head's review note does not qualify"
 done
 prov_leg "an unreviewed head with one member unreviewed" none clean none refuse "member brv2:"
 prov_leg "an unreviewed head whose every member is clean at its exact SHA" none clean clean pass "every member (2) carries a clean one"
 prov_leg "a clean head note" clean none none pass "the head ${HR:0:10} carries a clean review note"
 # check over reviewed members takes the members' provenance and does not run the reviewer again.
 bash "$TMP/put-review" "$HR" none; bash "$TMP/put-review" "$R1" clean; bash "$TMP/put-review" "$R2" clean
 : > "$FAKE_GH_DIR/review.log"
 out="$(bash "$TRAIN" check trv --no-remote 2>&1)"; rc=$?
 [ "$rc" = 0 ] && [ ! -s "$FAKE_GH_DIR/review.log" ] \
   && ok "check over members reviewed clean passes the review leg without running the reviewer" || { no "check over reviewed members: exit $rc, reviewer calls '$(cat "$FAKE_GH_DIR/review.log")'"; echo "$out" | sed 's/^/      /'; }
 
+echo "=== review: an owner sign-off at a member's exact SHA is its review provenance (R-0618) ==="
+# brv1 is reviewed clean; brv2 has no note and is signed off, or carries a record that must not count.
+so_leg(){ # label mode expect(refuse|pass) text
+  bash "$TMP/put-signoff" "$R2" "$2" "$R1"
+  prov_leg "$1" none clean none "$3" "$4"
+}
+so_leg "a member with a valid owner sign-off and a clean merge" valid pass "owner sign-off (1) at its exact SHA, and the head is their clean merge"
+so_leg "a sign-off recorded for another commit" othersha refuse "the record is for $R1, not $R2"
+so_leg "a sign-off whose verdict file was changed after recording" tampered refuse "the sha256 of kimi.txt is"
+so_leg "a sign-off without agy's verdict" noagy refuse "the record has no agy verdict"
+so_leg "a sign-off whose agy output ends in REJECT" reject refuse "the agy output's last verdict is 'VERDICT:REJECT'"
+so_leg "a sign-off whose quote names no commit" unnamed refuse "the quote does not name ${R2:0:10}"
+so_leg "a member with neither a note nor a sign-off" none refuse "$R2 has no owner sign-off"
+# The same valid sign-off, but a head beyond the clean merge of its members. train.sh already refuses
+# a head that is not the built train; pure_merge is the provenance's own check, run here on heads that
+# add a commit, or that change a merge's tree, over the built train.
+bash "$TMP/put-signoff" "$R2" valid
+BR="$MR"   # the train was built on main at MR
+git checkout -q --detach "$HR"; printf 'extra\n' > extra.txt; git add extra.txt; git commit -qm extra; HX="$(git rev-parse HEAD)"
+git checkout -q --detach "$HR"; printf 'extra\n' > extra.txt; git add extra.txt; git commit -q --amend --no-edit; HY="$(git rev-parse HEAD)"
+git checkout -q train/trv
+pm(){ bash -c 'eval "$(sed -n "/^pure_merge() {/,/^}/p" "$1")"; pure_merge "$2" "$3" "$4" "$5"' _ "$TRAIN" "$BR" "$1" "$R1" "$R2"; }
+o="$(pm "$HR")"; [ -z "$o" ] && ok "pure_merge: the built train is the clean merge of its members" || no "pure_merge refused the built train: '$o'"
+o="$(pm "$HX")"; has "$o" "${HX:0:10} is not the clean merge of its members onto ${BR:0:10}: ${HX:0:10} is not the merge of ${R2:0:10}" \
+  && ok "pure_merge refuses a head with an extra commit ($o)" || no "pure_merge on an extra commit: '$o'"
+o="$(pm "$HY")"; has "$o" "${HY:0:10} is not the clean merge of its members onto ${BR:0:10}: ${HY:0:10} differs from the clean merge of ${R2:0:10}" \
+  && ok "pure_merge refuses a merge whose tree carries an extra change ($o)" || no "pure_merge on a changed merge: '$o'"
+bash "$TMP/put-signoff" "$R2" none
+
 echo "=== where a train runs: a full clone with the repository hook (ISS-0015) ==="
 cd "$W" || exit 2
 git checkout -q -f main
 git worktree add -q --detach "$TMP/linked-wt" main
 out="$(cd "$TMP/linked-wt" && bash "$TRAIN" build twt --no-fetch b1 2>&1)"; rc=$?
 [ "$rc" != 0 ] && has "$out" "refusing to run in a linked worktree" && [ ! -e "$TMP/state/twt" ] \
