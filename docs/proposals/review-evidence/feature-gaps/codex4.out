#!/usr/bin/env bash
# INDEPENDENT RE-CHECK: every theorem of the specification exported with lean4export and re-checked
# by two checkers that share no code with the Lean kernel or with each other.
#
#   con-leche (leanprover/con-leche, Lean): machine-checked consistency proof: an accepted stream has
#     a set-theoretic model, so it contains no proof of False. Run in --verified, the mode the
#     theorem is about, single-threaded (--jobs=1: Lean 4.35.0's lean4#15288 fixed a thread-sharing
#     bug that named Lean-based checkers such as con-leche as possibly affected).
#   nanoda (ammkrn/nanoda_lib, Rust): no consistency proof; implementation diversity.
#
#   P  the three tools are the revisions pinned in scripts/proofs/external.pins, and every con-leche
#      call goes through one function that passes --verified --jobs=1;
#   I  population: every theorem scripts/proofs/theorems.lean lists, all of them on the standard
#      axioms (a theorem on any other is refused here, not left out of the export);
#   A  the export is from this toolchain, holds every theorem of the population, and declares only
#      the three standard axioms;
#   S  declaration fidelity: every declaration of the stream (theorem statements and proofs, the
#      definitions and inductive types they name, Lean core's included) equals Lean's own, in the
#      kernel's view (lean4export is unverified, and con-leche's theorem is about what it was handed,
#      so this is what ties the re-check to what Lean checked);
#   C  con-leche --verified accepts the export;   K  so does nanoda, the standard axioms permitted.
#
# NEGATIVE CONTROLS, each on a corrupted copy of the real export:
#   X  one theorem handed another's proof: con-leche rejects it as a type mismatch AT that theorem,
#      nanoda at its definitional-equality check (the reason is checked, never the exit code alone);
#   T  the export cut inside a record, and D  the export missing one expression record: both refuse;
#   F  a definition's body replaced, or an (anonymous) universe parameter added to one, while every
#      statement stays the same: S reports exactly that definition;
#   N  names whose dotted spellings collide, and a non-ASCII one, are encoded apart and alike by both
#      renderers (every comparison is by that injective encoding).
#
# Tools are built once per pinned SHA into $CONCRETE_EXT_TOOLS (default ~/.cache/concrete-ext):
# lean4export with THIS toolchain (it reads our .olean files), con-leche with its own (elan installs
# it), nanoda with cargo (CI runs this script in `nix develop .#extcheck`, which adds cargo and rustc
# to the gate userland).
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../checks/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"
CHECK_NAME=PROOF-EXTERNAL
source scripts/proofs/lib.sh
# A pre-push hook in a linked worktree exports repository-local Git variables; without clearing
# them, `git -C "$tool" rev-parse HEAD` reads this repository's HEAD instead of the tool's
# (the sandbox helper, ISS-0015).
source scripts/checks/lib/git_sandbox.sh || exit 2
git_sandbox || exit 2

# shellcheck source=external.pins
. scripts/proofs/external.pins
EXPECT_FORMAT=3.1.0
INV="python3 scripts/proofs/export_inventory.py"
TOOLS="${CONCRETE_EXT_TOOLS:-$HOME/.cache/concrete-ext}"
TOOLCHAIN="$(cat lean-toolchain)"

# The cache is shared by every run of this user on the machine (a self-hosted runner's HOME persists,
# and worktrees share it): building holds an exclusive lock on it, builds in a private directory and
# publishes the finished one with a rename, so no run sees, or removes, another's half-built tool.
mkdir -p "$TOOLS" && exec 9> "$TOOLS/.lock" && flock 9 \
  || { echo "error: cannot lock the tool cache $TOOLS" >&2; exit 2; }
# publish DIR BUILD-COMMAND… → runs the command in DIR.partial.$$ (already cloned) and renames it to DIR
publish() {
  local dir=$1 work="$1.partial.$$"; shift
  (cd "$work" && "$@" >&2) && touch "$work/.built" && rm -rf "$dir" && mv "$work" "$dir"
}
# build_lake_tool NAME URL REV TOOLCHAIN-OVERRIDE TARGET → prints the source dir; builds once per SHA
build_lake_tool() {
  local name=$1 url=$2 rev=$3 tc=$4 target=$5
  # The toolchain override is part of the build's identity (an exporter built with another toolchain
  # cannot read this build's .olean files), so it names the directory alongside the SHA.
  local dir="$TOOLS/$name-$rev${tc:+-$(printf '%s' "$tc" | tr -c 'A-Za-z0-9._-' '_')}"
  if [ ! -f "$dir/.built" ]; then
    local work="$dir.partial.$$"; rm -rf "$work"
    git clone -q "$url" "$work" >&2 && git -C "$work" checkout -q "$rev" >&2 || return 1
    [ -n "$tc" ] && echo "$tc" > "$work/lean-toolchain"
    publish "$dir" "$LAKE" build "$target" || { rm -rf "$work"; return 1; }
  fi
  [ "$(git -C "$dir" rev-parse HEAD)" = "$rev" ] || return 1
  echo "$dir"
}

echo "=== P: pinned tools ==="
EXPORT_DIR=$(build_lake_tool lean4export "$LEAN4EXPORT_URL" "$LEAN4EXPORT_REV" "$TOOLCHAIN" lean4export) \
  && ok "lean4export at $LEAN4EXPORT_REV, built with $TOOLCHAIN" \
  || { no "could not build lean4export at $LEAN4EXPORT_REV"; finish; }
CHECK_DIR=$(build_lake_tool con-leche "$CONLECHE_URL" "$CONLECHE_REV" "" con-leche) \
  && ok "con-leche at $CONLECHE_REV" \
  || { no "could not build con-leche at $CONLECHE_REV"; finish; }
EXPORTER="$EXPORT_DIR/.lake/build/bin/lean4export"
CONLECHE="$CHECK_DIR/.lake/build/bin/con-leche"
CONLECHE_FLAGS=(--verified --jobs=1)
conleche() { "$CONLECHE" "${CONLECHE_FLAGS[@]}" "$1"; }
# Every con-leche run goes through conleche(): a direct call would run at the default worker count.
DIRECT=$(grep -nE '^[^#]*"\$CONLECHE"' "$0" | grep -v 'CONLECHE_FLAGS\[@\]')
[ "${CONLECHE_FLAGS[*]}" = "--verified --jobs=1" ] && [ -z "$DIRECT" ] \
  && ok "con-leche runs as --verified --jobs=1 at every call site" \
  || no "con-leche flags are [${CONLECHE_FLAGS[*]}]; direct calls: $(echo $DIRECT | cut -c1-200)"
NANODA_DIR="$TOOLS/nanoda-$NANODA_REV"
if [ ! -f "$NANODA_DIR/.built" ]; then
  command -v cargo >/dev/null || { echo "error: building nanoda needs cargo (nix develop .#extcheck)" >&2; exit 2; }
  W="$NANODA_DIR.partial.$$"; rm -rf "$W"
  # The thread stack is raised from 16 MiB to 256 MiB exactly as the Lean Kernel Arena patches it.
  { git clone -q "$NANODA_URL" "$W" && git -C "$W" checkout -q "$NANODA_REV" \
    && has_match -F 'STACK_SIZE: usize = 16_777_216;' < "$W/src/lib.rs" \
    && sed -i.orig 's/STACK_SIZE: usize = 16_777_216;/STACK_SIZE: usize = 268_435_456;/' "$W/src/lib.rs" \
    && publish "$NANODA_DIR" cargo build --release -q; } >&2 || rm -rf "$W"
fi
NANODA="$NANODA_DIR/target/release/nanoda_bin"
[ -x "$NANODA" ] && [ "$(git -C "$NANODA_DIR" rev-parse HEAD)" = "$NANODA_REV" ] \
  && ok "nanoda at $NANODA_REV (thread stack patched as the Arena does)" \
  || { no "could not build nanoda at $NANODA_REV"; finish; }
#!/usr/bin/env python3
"""Read a lean4export NDJSON stream (format 3.1.0) for scripts/proofs/external.sh.

  export_inventory.py meta FILE            lean version, exporter version, format version
  export_inventory.py theorems FILE        every exported theorem's name (encoded), one per line
  export_inventory.py axioms FILE          every exported axiom's name (dotted), one per line
  export_inventory.py names FILE           every exported declaration's name (encoded), one per line
  export_inventory.py encode FILE          every name of the stream's name table (encoded), one per line
  export_inventory.py decls FILE           every exported declaration in the canonical declaration
                                           form theorems.lean renders (PROOF_MODE=decls)
  export_inventory.py swap FILE A B OUT    copy FILE to OUT with the later of theorems A/B (encoded)
                                           given the earlier's proof; prints "RECEIVER DONOR" dotted,
                                           then both encoded

`swap` is the hostile control: the receiver keeps its statement, the proof it is given proves the
donor's. A checker that accepts the result is not checking the proofs it is handed.
"""
import json
import sys


def records(path):
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line:
                yield json.loads(line)


def name_table(path, encoded=False):
    """Every name of the stream, by index: dotted for display (`a.b.0`), or with encoded=True in the
    injective encoding theorems.lean's `enc` uses (each component as `s<utf-8 length>:<bytes>` or
    `n<digits>:`), which is what every comparison uses: dotted names of different structure can agree."""
    names = {0: ""}
    for r in records(path):
        if "str" in r and "in" in r:
            pre, s = r["str"]["pre"], r["str"]["str"]
            if any(ord(c) < 32 or ord(c) == 127 for c in s):
                # every output is line-based: such a name could split one line into two (an axiom
                # list gaining an allowlisted line); fail closed, as theorems.lean does
                sys.exit(f"export_inventory.py: a name component holds a control character: {s!r}")
            if encoded: names[r["in"]] = names[pre] + "s" + lstr(s)
            else: names[r["in"]] = s if names.get(pre, "") == "" else names[pre] + "." + s
        elif "num" in r and "in" in r:
            pre, i = r["num"]["pre"], r["num"]["i"]
            if encoded: names[r["in"]] = names[pre] + f"n{i}:"
            else: names[r["in"]] = str(i) if names.get(pre, "") == "" else f"{names[pre]}.{i}"
    return names


def lstr(s):
    return f"{len(s.encode('utf-8'))}:{s}"


def decls(path):
    """Every declaration of the stream in the canonical declaration form theorems.lean renders from
    Lean's own environment (PROOF_MODE=decls; change both or neither): declarations in name order,
    each field's expression before the next field and an expression's children left to right; each
    distinct node numbered when first met and written as `<number>\t<node>` naming its children by
    number; then the line `D\t<name>\t<kind>\t<fields>`. Binder names, binder annotations, the let
    `nondep` flag and metadata are erased: the kernel ignores them, and lean4export shares one index
    among expressions equal under Lean's `Expr` BEq, which ignores exactly those."""
    names, lvrec, exrec, consts = name_table(path, encoded=True), {0: None}, {}, {}
    for r in records(path):
        if "in" in r:
**PROPOSED, awaiting owner decision (2026-11-06); reviewed by Codex, agy, Kimi.**

# Ideas from the previous compiler: forgotten or at risk (2026-11-06)

**Scope.** This covers ideas, features, design lessons and assets in `legacy/` (origin/main `d20e3ab333`), checked against the new design:
- `docs/decisions.md`
- `docs/PHILOSOPHY.md`
- `ROADMAP.md`
- `README.md`
- ConcreteSpec on `origin/wip/spec-root`
- `docs/archive/roadmap-2026-11/task_disposition.tsv`

Each old task in the disposition table is mapped to a new task in its `destination` column. Compile-time checks and reports are covered in `../legacy-checks/INVENTORY.md` and are not repeated here.

**Status values:**
- **CARRIED:** in a decided rule or the spec.
- **PLANNED:** a live task, directly or through a disposition destination.
- **DEFERRED:** a disposition trigger, with no live task.
- **RETAINED-ONLY:** a RETENTION row exists, but there is no plan.
- **FORGOTTEN:** no trace anywhere.
- **DROPPED-ON-PURPOSE:** dropped by a cited decision.

## Ranked: forgotten or at risk (v2, after Codex and Kimi review)

| # | Idea (legacy source) | Status | Recommendation |
|---|---|---|---|
| 1 | **Facts query and audit at source level** (`legacy/research/compiler/semantic-query-interface.md`; R-0179–R-0185 → R-0201) | PLANNED **in phase F**, which conflicts with the owner's "from the start" (2026-11-06). The query isn't yet on main; the recording batch is in flight. | **Roadmap:** split R-0201. Facts query in B0/B1 (per function: capabilities, allocation, termination, may-abort, stack, trust, evidence, each with a source location). Keep audit, diff and trust-diff in F. |
| 2 | **Policy declaration mechanism.** Legacy `Concrete.toml [policy]`, `POLICY_FILES.md`; capability budgets (R-0184, R-0186) | PLANNED **in phase F** (R-0201). The format, scope and composition across dependencies are undecided. | **Owner decision before B1:** one policy file, with scoping and composition, over the same facts. Predictable, termination and capability budgets all use it. |
| 3 | **Capability and fact preservation across indirect calls, monomorphization and packages** (structural class 6) | At risk: the spec covers direct calls only | **Spec, A2i/A3:** preservation statement. **Phase B:** a theorem. The facts query reports through these boundaries. |
| 4 | **Bounded execution, split.** (a) Termination, depth, stack and abort facts: CARRIED by the decision (Q11–Q14) and R-0574. (b) Quantitative step, time and allocation-count bounds (`legacy/research/stdlib/allocation-budgets.md`; R-0405, R-0415, R-0445): DEFERRED. The decision says "bounded" gives **no execution-time deadline**. | (b) DEFERRED | **Owner decision:** whether the predictable policy needs allocation-count and step certificates (R-0445), and when. |
| 5 | **Frames and dependency-flow facts** (reads/writes/modifies, `depends`; `legacy/docs/verification/SPARK_CLASS_ASSURANCE.md`) | PLANNED: R-0524 frames (E); R-0239 → R-0473; package summaries R-0380 → R-0383 (G). Missing from v1 of this list. | Keep. Add "what memory it writes" and "what its outputs depend on" to the facts-query schema now, as "not established" until E. |
| 6 | **Obligation sufficiency, spec adequacy and vacuity** (`legacy/docs/verification/PROVER_NEUTRAL_OBLIGATIONS.md`) | PLANNED: R-0460 retained (E); R-0193 and R-0213 → R-0219 (F). Missing from v1. | Keep. Vacuity (a proof that holds only under an unsatisfiable precondition) should block a "proved" fact from the first proof slice, not only from F. |
| 7 | **Exact source locations on every fact and obligation** (`examples/source_maps`; spec O4) | At risk: Core spans are absent and O4 is open | **Spec/compiler:** carry spans from slice 0 into CheckedCore and the facts schema. |
| 8 | **Fixed-capacity, non-allocating std** (`examples/fixed_capacity`) | RETAINED-ONLY. The std/examples migration is *open* (RETENTION.tsv); no predictable std subset is planned. | **Roadmap:** a predictable std subset in C, fixed-capacity containers first. |
| 9 | **I/O driver for the Lean reference evaluator** (`VERIFIED_PIPELINE.md`) | Implicit in R-0491/R-0496; no explicit task | **Roadmap:** name it inside R-0491 by B1. Independent expected outcomes for I/O programs need it. |
| 10 | **Independent expected outcomes / golden-oracle rule** (`GOLDEN_ORACLES.md`, bug 121) | PLANNED: R-0094 → R-0491; R-0425. v1 wrongly said FORGOTTEN. | Keep. Make sure R-0491's gate refuses expectations recorded from the compiler. |
| 11 | **Constant-time / secret flow** (`examples/constant_time_tag`; R-0136, R-0225, R-0527) | DEFERRED | **Owner:** make the first crypto port the trigger. |
| 12 | **Error conventions** (`ERROR_CONVENTIONS.md`) | PLANNED: R-0057 → R-0071 (C). Signature normalization (R-0017) is DEFERRED. | Keep. |
| 13 | **Historical replay vs current acceptance and revocation** (`EVIDENCE_ARCHITECTURE.md`, "Replay receipt") | PLANNED: R-0430 → R-0353 (F) | Keep. Certificates must not treat "was valid" as "is accepted". |
| 14 | **Debug info on the LLVM path** | PLANNED only for LCB (R-0517) | **Roadmap, C:** unverified, with a no-codegen-change check. Low priority. |
| 16 | **Declared assumptions file** (`legacy/docs/verification/ASSUMPTION_FILES.md`: target, heap, stack, FFI and trusted-surface assumptions, with a diff gate) | Probably FORGOTTEN: no disposition row found by grep (agy) | **Spec/roadmap:** a project assumptions view, derived from facts where possible and declared only where it can't be, beside the policy file (#2). |
| 17 | **Contract-strength labels** (point / one-direction / iff / full contract; `legacy/tests/showcase/manifest.toml`, `EVIDENCE_ARCHITECTURE.md`) | Probably FORGOTTEN: no row found | **Facts query:** report the strength of each proved claim, so that a single-input proof never reads as a universal contract. |
| 18 | **Paired "Concrete catches this" negative fixtures per flagship** (`legacy/tests/showcase` catches/) | RETAINED-ONLY (showcase) | **Roadmap:** every port in C/D ships its rejected-violation twins. |
| 15 | **Freestanding / embedded; deterministic fault simulation** (R-0322/R-0324 deferred; R-0030 → R-0071) | DEFERRED / PLANNED | Leave. Name the first embedded workload as the trigger. |

## Other ideas, by status

