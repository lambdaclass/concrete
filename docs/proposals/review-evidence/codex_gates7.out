from unittest.mock import patch
s=importlib.util.spec_from_file_location('sb','scripts/checks/lib/stack_bound.py'); m=importlib.util.module_from_spec(s); s.loader.exec_module(m)
n=0
for line in open('scripts/checks/slice0_artifacts.sh'):
 if not line.startswith('refuse '): continue
 a=shlex.split(line); name,body=a[1:3]; m.ARCH=a[3] if len(a)>3 else 'x86_64'; main=a[4] if len(a)>4 else 'main'
 dis='Disassembly of section .text:\\n\\n0000000000001010 <'+main+'>:\\n'+bytes(body,'utf8').decode('unicode_escape')
 with patch('builtins.open',return_value=io.StringIO(dis)): f,st=m.parse('unused')
 try: m.analyse(f,st); print('UNEXPECTED ACCEPT',name)
 except m.Refuse as e:
  n+=1
  if name in ('restored-slot-reread','a64-restored-record-reread'): print(name+': '+str(e))
print('refused controls:',n)
