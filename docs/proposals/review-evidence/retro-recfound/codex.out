+  git archive "\$sha" scripts/land scripts/checks/lib/git_sandbox.sh | tar -x -C "\$snap.tmp"
   mv "\$snap.tmp" "\$snap"
   ls -1t "\$snaps" | tail -n +6 | while read -r old; do rm -rf "\${snaps:?}/\$old"; done
 fi

