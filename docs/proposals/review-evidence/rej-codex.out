#!/usr/bin/env bash
# OWNER SIGN-OFF RECORDS (ROADMAP R-0618; owner, 2026-11-08: "when a branch reaches its review-round
# cap, the owner may approve one exact commit SHA after Codex, Kimi and agy have all reviewed it; the
# approval is recorded"). A sign-off is review provenance for that one commit, as a clean
# refs/notes/concrete-review note is (scripts/review/verify.sh); train.sh accepts either for a member.
#
#   signoff.sh record <commit> --base BASE --rounds-at NOTED --date YYYY-MM-DD --quote TEXT
#                     --codex-request FILE --codex FILE --kimi-request FILE --kimi FILE
#                     --agy-request FILE --agy FILE
#   signoff.sh verify <commit> --base BASE
#
# THE RECORD is the ref refs/owner-signoff/<full sha>, a parentless commit whose tree holds exactly
# seven plain files: record.txt and, for each reviewer r in codex, kimi and agy, r-request.txt and
# r.txt. The output is copied byte for byte. The request is copied verbatim after a structured first
# line, `reviewed: <full sha>`, which `record` prepends to attest the commit reviewed. Thus a clone
# that fetches the ref can check what each reviewer was asked and its output separately. record.txt
# is `key: value` lines, each key once:
#   signoff: owner
#   commit: <the 40-hex SHA approved>
#   date: YYYY-MM-DD
#   quote: <the owner's words, verbatim; they name the commit by an unambiguous prefix of 7+ hex digits>
#   rounds-at: <the 40-hex SHA of the commit whose scripts/review/review.sh note records the rounds used>
#   request-codex: codex-request.txt <sha256>
#   verdict-codex: codex.txt <sha256>
#   request-kimi: kimi-request.txt <sha256>
#   verdict-kimi: kimi.txt <sha256>
#   request-agy: agy-request.txt <sha256>
#   verdict-agy: agy.txt <sha256>
# `record` builds the record, verifies it, and only then writes the ref locally; it pushes nothing
# (push the ref to both remotes: the pre-push hook takes a refs/owner-signoff/* record in its
# no-source-tree tier). Only the owner's recorded words go in a quote.
#
# THE CAP (R-0618) comes from the class of the member's diff against its base, classified by path,
# the highest class present winning: docs and roadmap 2, scripts 3, compiler and spec 5; a path in no
# class counts as compiler and spec. A sign-off qualifies only when the review rounds recorded on the
# member's own commits reach that cap: `rounds-at` must be the commit itself or one of its ancestors
# not on BASE, and carry a well-formed review.sh note (scripts/review/verify.sh: clean, findings or
# blocked) whose round is at least the cap, whatever its verdict
# (the cap counts rounds used: the other reviewers' rejections are why a branch reaches it).
#
# `verify` accepts the record only if the ref exists, the tree holds exactly those seven 100644 blobs,
# every key is present once and well formed, `commit` is the commit asked about, the quote names it,
# the cap was reached, and every file's sha256 is the recorded one. Each request's `reviewed:` line
# must equal the signed commit, and its body must name that commit by an unambiguous prefix of 7+
# hex digits; output mentions do not bind a review to a commit. Each output's last VERDICT line must
# be `VERDICT: ACCEPT`, and an output without one is refused; request lines never count as verdicts.
# The sign-off judges the exact commit and says nothing about any other commit.
#
# Exit codes: 0 a valid sign-off; 1 a sign-off that does not qualify (the reason is printed);
#             2 no sign-off, or a usage error.
set -euo pipefail
PREFIX=refs/owner-signoff
NOTES_REF=refs/notes/concrete-review
REVIEWERS="codex kimi agy"
VERIFY="$(cd "$(dirname "${BASH_SOURCE[0]}")/../review" && pwd)/verify.sh"

usage() { awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"; }
die() { echo "signoff: $*" >&2; exit 2; }
sha256() { if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -d' ' -f1; else shasum -a 256 | cut -d' ' -f1; fi; }

# path_class PATH → docs | scripts | compiler (anything unlisted is compiler: the highest class)
path_class() {
  case "$1" in
    docs/*|changelog.d/*|ROADMAP.md|CHANGELOG.md|README.md|AGENTS.md|CLAUDE.md) echo docs ;;
    scripts/*|.githooks/*|.github/*|.claude/*|required-checks.txt|required-checks-transition.tsv) echo scripts ;;
    *) echo compiler ;;
  esac
}
# names SHA → reads text on stdin; succeeds when a hex word of at least 7 digits in it is an
# unambiguous name of SHA in this repository (git refuses an ambiguous prefix)
names() {
  local w
  for w in $(tr -c '0-9a-f' ' '); do
    [ "${#w}" -ge 7 ] && [ "${1#"$w"}" != "$1" ] && [ "$(git rev-parse -q --verify "$w^{commit}" 2>/dev/null)" = "$1" ] && return 0
  done
  return 1
}
class_cap() { case "$1" in docs) echo 2 ;; scripts) echo 3 ;; *) echo 5 ;; esac; }
# diff_class SHA BASE → the highest class among the paths SHA changes against its merge base with BASE
diff_class() {
  local mb p c best=docs
  mb="$(git merge-base "$2" "$1")" || return 1
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    c="$(path_class "$p")"
    case "$c" in compiler) best=compiler ;; scripts) [ "$best" = compiler ] || best=scripts ;; esac
  done < <(git diff --no-renames --name-only "$mb" "$1")
  echo "$best"
}

cmd_record() {
  [ $# -ge 1 ] || die "record: name the commit"
  local sha date="" quote="" base="" at="" r f q v; sha="$(git rev-parse -q --verify "$1^{commit}")" || die "record: not a commit: $1"; shift
  local codex="" kimi="" agy="" codex_request="" kimi_request="" agy_request=""
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || die "record: $1 needs a value"
    case "$1" in
      --date) date="$2" ;; --quote) quote="$2" ;; --base) base="$2" ;; --rounds-at) at="$2" ;;
      --codex) codex="$2" ;; --kimi) kimi="$2" ;; --agy) agy="$2" ;;
      --codex-request) codex_request="$2" ;; --kimi-request) kimi_request="$2" ;; --agy-request) agy_request="$2" ;;
      *) die "record: unknown option $1" ;;
    esac; shift 2
  done
  [[ "$date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "record: --date YYYY-MM-DD is required"
  [ -n "$quote" ] && [[ "$quote" != *$'\n'* ]] || die "record: --quote is required, on one line"
  [ -n "$base" ] || die "record: --base BASE is required"
  at="$(git rev-parse -q --verify "$at^{commit}")" || die "record: --rounds-at must name the noted commit"
  local rec="signoff: owner
commit: $sha
date: $date
quote: $quote
rounds-at: $at" entries=""
  for r in $REVIEWERS; do
    q="${r}_request"; q="${!q}"; [ -f "$q" ] || die "record: --$r-request FILE is required (the verbatim review request)"
    f="${!r}"; [ -f "$f" ] || die "record: --$r FILE is required (the reviewer's verdict output)"
    v="$({ printf 'reviewed: %s\n' "$sha"; cat -- "$q"; } | git hash-object -w --no-filters --stdin)"
    rec="$rec
request-$r: $r-request.txt $({ printf 'reviewed: %s\n' "$sha"; cat -- "$q"; } | sha256)"
    entries="${entries}100644 blob $v	$r-request.txt
"
    v="$(git hash-object -w --no-filters -- "$f")"
    rec="$rec
verdict-$r: $r.txt $(sha256 < "$f")"
    entries="${entries}100644 blob $v	$r.txt
"
  done
  v="$(printf '%s\n' "$rec" | git hash-object -w --no-filters --stdin)"
  local tree commit
  tree="$(printf '%s100644 blob %s\trecord.txt\n' "$entries" "$v" | git mktree)"
  commit="$(git commit-tree "$tree" -m "owner sign-off of $sha ($date)")"
  local out
  out="$( check "$sha" "$commit" "$base" )" || { printf '%s\nsignoff: not recorded (nothing written)\n' "$out" >&2; exit 1; }
  git update-ref "$PREFIX/$sha" "$commit"
  echo "$out"
  echo "signoff: recorded $PREFIX/$sha -> ${commit:0:10}; push it to both remotes"
}

# check SHA RECORD BASE: judge the record commit RECORD as a sign-off of SHA (exit 1 with the reason)
check() {
  local sha="$1" obj="$2" base="$3"
  bad() { echo "$sha owner sign-off does not qualify: $*"; exit 1; }
  [ "$(git cat-file -t "$obj:record.txt" 2>/dev/null)" = blob ] || bad "the record holds no record.txt"
  local rec line k v seen=" " F_signoff="" F_commit="" F_date="" F_quote="" F_rounds_at=""
  local F_request_codex="" F_verdict_codex="" F_request_kimi="" F_verdict_kimi="" F_request_agy="" F_verdict_agy=""
  rec="$(git cat-file blob "$obj:record.txt")"
  while IFS= read -r line; do
    [[ "$line" =~ ^([a-z-]+):\ (.*)$ ]] || bad "record.txt line is not key: value: '$line'"
    k="${BASH_REMATCH[1]}" v="${BASH_REMATCH[2]}"
    case "$seen" in *" $k "*) bad "record.txt repeats $k" ;; esac
    seen="$seen$k "
    case "$k" in signoff|commit|date|quote|rounds-at|request-codex|verdict-codex|request-kimi|verdict-kimi|request-agy|verdict-agy) ;; *) bad "record.txt has the unknown key $k" ;; esac
    printf -v "F_${k//-/_}" '%s' "$v"
  done <<< "$rec"
  for k in signoff commit date quote rounds-at; do case "$seen" in *" $k "*) ;; *) bad "record.txt has no $k" ;; esac; done
  [ "$F_signoff" = owner ] || bad "signoff is '$F_signoff', not owner"
  [ "$F_commit" = "$sha" ] || bad "the record is for $F_commit, not $sha"
  [[ "$F_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || bad "date '$F_date' is not YYYY-MM-DD"
  printf '%s' "$F_quote" | names "$sha" \
    || bad "the quote does not name ${sha:0:10} (an unambiguous prefix of at least 7 hex digits): '$F_quote'"
  # The cap: the class of the member's diff, and the rounds review.sh recorded on its own commits.
  local cls cap at rounds
  cls="$(diff_class "$sha" "$base")" || bad "no merge base of ${sha:0:10} and ${base:0:10}"
  cap="$(class_cap "$cls")"
  at="$F_rounds_at"
  [[ "$at" =~ ^[0-9a-f]{40}$ ]] || bad "rounds-at '$at' is not a full commit SHA"
  { git merge-base --is-ancestor "$at" "$sha" 2>/dev/null && ! git merge-base --is-ancestor "$at" "$base" 2>/dev/null; } \
    || bad "rounds-at ${at:0:10} is not one of ${sha:0:10}'s own commits (an ancestor or itself, not on ${base:0:10})"
  # verify.sh judges the note as review.sh wrote it: 0 clean, 1 findings or blocked (both well formed,
  # and both count: the cap is rounds used); 2 is no note or a malformed one.
  local vout vrc=0
  vout="$(bash "$VERIFY" "$at" 2>&1)" || vrc=$?
  [ "$vrc" = 0 ] || [ "$vrc" = 1 ] || bad "rounds-at ${at:0:10} carries no well-formed review.sh note: ${vout//$'\n'/ }"
  rounds="$(printf '%s\n' "$vout" | sed -n 's/.*(round \([1-9][0-9]*\), reviewer .*/\1/p' | head -1)"
  [ -n "$rounds" ] || bad "rounds-at ${at:0:10}: no round count in '$vout'"
  [ "$rounds" -ge "$cap" ] \
    || bad "the review cap was not reached: a $cls change has cap $cap, and ${at:0:10} records $rounds round(s)"
  local r n entry file hash got reviewed verdict
  for r in $REVIEWERS; do
    n="F_request_$r"; [ -n "${!n}" ] || bad "the record has no $r request"
    n="F_verdict_$r"; [ -n "${!n}" ] || bad "the record has no $r verdict"
  done
  local want="100644 blob agy-request.txt 100644 blob agy.txt 100644 blob codex-request.txt 100644 blob codex.txt 100644 blob kimi-request.txt 100644 blob kimi.txt 100644 blob record.txt " have
  have="$(git ls-tree --format='%(objectmode) %(objecttype) %(path)' "$obj" | LC_ALL=C sort | tr '\n' ' ')"
  [ "$have" = "$want" ] || bad "the record tree is not exactly the seven sign-off files as 100644 blobs"
  for r in $REVIEWERS; do
    n="F_request_$r"; entry="${!n}"
    file="${entry%% *}" hash="${entry#* }"
    [ "$file" = "$r-request.txt" ] && [[ "$hash" =~ ^[0-9a-f]{64}$ ]] || bad "request-$r is '$entry', not '$r-request.txt <sha256>'"
    got="$(git cat-file blob "$obj:$file" | sha256)"
    [ "$got" = "$hash" ] || bad "the sha256 of $file is $got, not the recorded $hash"
    reviewed="$(git cat-file blob "$obj:$file" | sed -n '1p')"
    [[ "$reviewed" =~ ^reviewed:\ [0-9a-f]{40}$ ]] || bad "the $r request's first line is not a 'reviewed: <full 40-hex SHA>' line"
    [ "$reviewed" = "reviewed: $sha" ] || bad "the $r request's reviewed line is '${reviewed#reviewed: }', not $sha"
    git cat-file blob "$obj:$file" | tail -n +2 | names "$sha" \
      || bad "the $r request body does not name ${sha:0:10} (an unambiguous prefix of at least 7 hex digits)"
    n="F_verdict_$r"; entry="${!n}"
    file="${entry%% *}" hash="${entry#* }"
    [ "$file" = "$r.txt" ] && [[ "$hash" =~ ^[0-9a-f]{64}$ ]] || bad "verdict-$r is '$entry', not '$r.txt <sha256>'"
    got="$(git cat-file blob "$obj:$file" | sha256)"
    [ "$got" = "$hash" ] || bad "the sha256 of $file is $got, not the recorded $hash"
    verdict="$(git cat-file blob "$obj:$file" | grep -E '^[[:space:]]*VERDICT: (ACCEPT|REJECT)[[:space:]]*$' | tail -1 | tr -d '[:space:]')" || true
    [ -n "$verdict" ] || bad "the $r output has no verdict"
    [ "$verdict" = "VERDICT:ACCEPT" ] || bad "the $r output's last verdict is '$verdict', not VERDICT: ACCEPT"
  done
  echo "$sha signed off by the owner ($F_date; $cls change, cap $cap reached at ${at:0:10} with $rounds round(s); codex, kimi and agy accepted): \"$F_quote\""
}

cmd_verify() {
  local sha base=""
  [ $# -ge 1 ] || die "usage: signoff.sh verify <commit> --base BASE"
  sha="$(git rev-parse -q --verify "$1^{commit}")" || die "verify: not a commit: $1"; shift
  while [ $# -gt 0 ]; do
    case "$1" in --base) [ $# -ge 2 ] || die "verify: --base needs a value"; base="$2"; shift 2 ;; *) die "verify: unknown option $1" ;; esac
  done
  [ -n "$base" ] || die "verify: --base BASE is required (the cap is the class of the diff against it)"
  base="$(git rev-parse -q --verify "$base^{commit}")" || die "verify: --base is not a commit"
  git rev-parse -q --verify "$PREFIX/$sha^{commit}" >/dev/null || { echo "$sha has no owner sign-off ($PREFIX/$sha)"; exit 2; }
  check "$sha" "$(git rev-parse "$PREFIX/$sha^{commit}")" "$base"
}

case "${1:-}" in
  record) shift; cmd_record "$@" ;;
  verify) shift; cmd_verify "$@" ;;
  -h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
MI="$(git rev-parse HEAD)"
inv_leg(){ # train branch run-id -> builds, checks and runs CI for the train; dry-run land in $out/$rc
  bash "$TRAIN" build "$1" "$2" >/dev/null 2>&1 || no "$1 build"
  git checkout -q "train/$1"; local h; h="$(git rev-parse HEAD)"
  bash "$TRAIN" check "$1" --no-remote >/dev/null 2>&1 || no "$1 check"
  printf '[{"databaseId": %s, "headSha": "%s", "createdAt": "9999-01-01T00:00:00Z"}]' "$3" "$h" > "$FAKE_GH_DIR/list.json"
  bash "$TRAIN" ci "$1" >/dev/null 2>&1 || no "$1 ci"
  runjson "$h" success success
  out="$(bash "$TRAIN" --dry-run land "$1" 2>&1)"; rc=$?
}
git checkout -q -b binv-nested "$MI"
printf '# the day-one root, reordered\ndocs/proposals\ndocs/LANDING.md\ndocs\nlegacy\nREADME.md\n' > scripts/checks/root_inventory.txt
commit_all binv-nested
inv_leg tin1 binv-nested 5454
[ "$rc" = 0 ] && ! has "$out" "move candidate" \
  && ok "an inventory change of nested entries, comments and order only (docs/proposals) needs no rehearsal" || { no "nested inventory change: dry-run land exit $rc"; echo "$out" | sed 's/^/      /'; }
git checkout -q -b binv-root "$MI"
printf '# day one\nREADME.md\nNEWS.md\nlegacy\ndocs\ndocs/LANDING.md\n' > scripts/checks/root_inventory.txt
commit_all binv-root
inv_leg tin2 binv-root 5455
[ "$rc" = 5 ] && has "$out" "no rehearsal record" \
  && ok "an inventory change that adds a top-level entry still needs a rehearsal" || { no "top-level inventory change: dry-run land exit $rc"; echo "$out" | sed 's/^/      /'; }
git checkout -q -b binv-legacy "$MI"; printf 'edited old tree\n' > legacy/old.txt; commit_all binv-legacy
inv_leg tin3 binv-legacy 5456
[ "$rc" = 5 ] && has "$out" "no rehearsal record" \
  && ok "a change under legacy/ (inventory untouched) still needs a rehearsal" || { no "legacy change: dry-run land exit $rc"; echo "$out" | sed 's/^/      /'; }

# An owner sign-off record (scripts/land/signoff.sh), published to origin. put-signoff <sha> <mode>
# [<other sha>]: valid; none removes it; othersha records <other sha> and files it under <sha>;
# tampered changes kimi.txt after recording; otherreview makes kimi's request body name <other sha>;
# otherreviewed gives that request a reviewed line for <other sha> while its body and output name
# <sha>; noreviewed removes its reviewed line; requestverdict puts ACCEPT only in agy's request;
# unnamedbody gives kimi's request no commit name; noagy drops agy's verdict; reject ends agy's output
# with VERDICT: REJECT; unnamed has a quote that names no commit.
printf '#!/usr/bin/env bash\nSIGNOFF=%q\n' "$ROOT_DIR/scripts/land/signoff.sh" > "$TMP/put-signoff"
cat >> "$TMP/put-signoff" <<'SIGNOFF_EOF'
set -e
sha="$(git rev-parse "$1")"; mode="$2"; R=refs/owner-signoff; tab="$(printf '\t')"
base="${SO_BASE:-$(git rev-parse origin/main)}"; rounds="${SO_ROUNDS:-5}"
git update-ref -d "$R/$sha" 2>/dev/null || true
CONCRETE_SKIP_GATES=1 git push -q origin ":$R/$sha" 2>/dev/null || true
[ "$mode" = none ] && exit 0
# The member's own review.sh note: the rounds it used (any verdict), which the cap is judged against.
bash "$(dirname "$0")/put-review" "$sha" "findings@$rounds"
d="$(mktemp -d)"
for r in codex kimi agy; do
  printf 'review of %s by %s\n' "$sha" "$r" > "$d/$r-request"
  printf '  VERDICT: ACCEPT\n' > "$d/$r"
done
bash "$SIGNOFF" record "$sha" --base "$base" --rounds-at "$sha" --date 2026-11-08 --quote "sign off ${sha:0:8}, yes" \
  --codex-request "$d/codex-request" --codex "$d/codex" \
  --kimi-request "$d/kimi-request" --kimi "$d/kimi" \
  --agy-request "$d/agy-request" --agy "$d/agy" >/dev/null
c="$(git rev-parse "$R/$sha")"
# variant SED [drop:FILE | set:FILE:BLOB]...: the valid record with record.txt edited by SED and files
# dropped or replaced (record writes only valid records, so every refused variant is built from one).
variant() {
  local rec entries t f b change
  rec="$(git cat-file blob "$c:record.txt" | sed "$1" | git hash-object -w --stdin)"
  entries="$(git ls-tree "$c" | grep -v "${tab}record.txt\$")"
  shift
  for change in "$@"; do
    case "$change" in
      drop:*) entries="$(printf '%s\n' "$entries" | grep -v "${tab}${change#drop:}\$")" ;;
      set:*) f="${change#set:}"; f="${f%%:*}"; b="${change##*:}"
        entries="$(printf '%s\n' "$entries" | sed "s/blob [0-9a-f]*${tab}${f}\$/blob ${b}${tab}${f}/")" ;;
    esac
  done
  t="$(printf '%s\n100644 blob %s\trecord.txt\n' "$entries" "$rec" | git mktree)"
  git update-ref "$R/$sha" "$(git commit-tree "$t" -m variant)"
}
set_request() { # reviewer stored-request-file
  local r="$1" q="$2"
  variant "s/^request-$r: .*/request-$r: $r-request.txt $(sha256sum < "$q" | cut -d' ' -f1)/" \
    "set:$r-request.txt:$(git hash-object -w "$q")"
}
case "$mode" in
  valid) ;;
  othersha) variant "s/^commit: .*/commit: $(git rev-parse "$3")/" ;;
  unnamed) variant "s/^quote: .*/quote: sign off the branch/" ;;
  tampered) variant "" "set:kimi.txt:$(printf 'edited output\n  VERDICT: ACCEPT\n' | git hash-object -w --stdin)" ;;
  otherreview) printf 'reviewed: %s\nreview of %s by kimi\n' "$sha" "$(git rev-parse "$3")" > "$d/kimi-o"
    set_request kimi "$d/kimi-o" ;;
  otherreviewed) printf 'reviewed: %s\nreview of %s by kimi\n' "$(git rev-parse "$3")" "$sha" > "$d/kimi-q"
    printf 'review of %s by kimi\nVERDICT: ACCEPT\n' "$sha" > "$d/kimi-o"
    variant "s/^request-kimi: .*/request-kimi: kimi-request.txt $(sha256sum < "$d/kimi-q" | cut -d' ' -f1)/;s/^verdict-kimi: .*/verdict-kimi: kimi.txt $(sha256sum < "$d/kimi-o" | cut -d' ' -f1)/" \
      "set:kimi-request.txt:$(git hash-object -w "$d/kimi-q")" "set:kimi.txt:$(git hash-object -w "$d/kimi-o")" ;;
  noreviewed) printf 'review of %s by kimi\n' "$sha" > "$d/kimi-q"; set_request kimi "$d/kimi-q" ;;
  unnamedbody) printf 'reviewed: %s\nreview the branch\n' "$sha" > "$d/kimi-q"; set_request kimi "$d/kimi-q" ;;
  requestverdict) printf 'reviewed: %s\nreview of %s by agy\nVERDICT: ACCEPT\n' "$sha" "$sha" > "$d/agy-q"
    printf 'agy output without a verdict\n' > "$d/agy-o"
    variant "s/^request-agy: .*/request-agy: agy-request.txt $(sha256sum < "$d/agy-q" | cut -d' ' -f1)/;s/^verdict-agy: .*/verdict-agy: agy.txt $(sha256sum < "$d/agy-o" | cut -d' ' -f1)/" \
      "set:agy-request.txt:$(git hash-object -w "$d/agy-q")" "set:agy.txt:$(git hash-object -w "$d/agy-o")" ;;
  noagy) variant "/^verdict-agy:/d" "drop:agy.txt" ;;
  reject) printf 'VERDICT: REJECT\n' > "$d/agy-r"
    variant "s/^verdict-agy: .*/verdict-agy: agy.txt $(sha256sum < "$d/agy-r" | cut -d' ' -f1)/" \
      "set:agy.txt:$(git hash-object -w "$d/agy-r")" ;;
  *) echo "put-signoff: unknown mode $mode" >&2; exit 2 ;;
esac
rm -rf "$d"
CONCRETE_SKIP_GATES=1 git push -q -f origin "$R/$sha"
SIGNOFF_EOF

echo "=== review: check fails closed, land requires review provenance ==="
git checkout -q main && git fetch -q origin && git reset -q --hard origin/main
MR="$(git rev-parse HEAD)"
git checkout -q -b brv1 "$MR"; printf 'rv1\n' > rv1.txt; commit_all brv1
git checkout -q -b brv2 "$MR"; printf 'rv2\n' > rv2.txt; commit_all brv2
bash "$TRAIN" build trv brv1 brv2 >/dev/null 2>&1 || no "review train build"
git checkout -q train/trv; HR="$(git rev-parse HEAD)"; R1="$(git rev-parse brv1)"; R2="$(git rev-parse brv2)"
out="$(LAND_REVIEW_CMD= bash "$TRAIN" check trv --no-remote 2>&1)"; rc=$?
  local o r; o="$(bash "$TRAIN" --dry-run land trv 2>&1)"; r=$?
  if [ "$5" = refuse ]; then
    [ "$r" = 1 ] && has "$o" "has no review provenance" && has "$o" "${6:-}" && [ "$(git ls-remote origin refs/heads/main | cut -f1)" = "$MR" ] \
      && ok "land refuses $1" || { no "land with $1 (exit $r)"; echo "$o" | sed 's/^/      /'; }
  else
    [ "$r" = 0 ] && has "$o" "${6:-}" && ok "land accepts $1" || { no "land with $1 (exit $r)"; echo "$o" | sed 's/^/      /'; }
  fi
}
prov_leg "no review note anywhere" none none none refuse "member brv1:"
for m in malformed blocked findings; do
  prov_leg "an unreviewed head over a $m member note" none clean "$m" refuse "member brv2:"
  prov_leg "a $m head note, whatever the members" "$m" clean clean refuse "the head's review note does not qualify"
done
prov_leg "an unreviewed head with one member unreviewed" none clean none refuse "member brv2:"
prov_leg "an unreviewed head whose every member is clean at its exact SHA" none clean clean pass "every member (2) carries a clean one"
prov_leg "a clean head note" clean none none pass "the head ${HR:0:10} carries a clean review note"
# check over reviewed members takes the members' provenance and does not run the reviewer again.
bash "$TMP/put-review" "$HR" none; bash "$TMP/put-review" "$R1" clean; bash "$TMP/put-review" "$R2" clean
: > "$FAKE_GH_DIR/review.log"
out="$(bash "$TRAIN" check trv --no-remote 2>&1)"; rc=$?
[ "$rc" = 0 ] && [ ! -s "$FAKE_GH_DIR/review.log" ] \
  && ok "check over members reviewed clean passes the review leg without running the reviewer" || { no "check over reviewed members: exit $rc, reviewer calls '$(cat "$FAKE_GH_DIR/review.log")'"; echo "$out" | sed 's/^/      /'; }

echo "=== review: an owner sign-off at a member's exact SHA is its review provenance (R-0618) ==="
# brv1 is reviewed clean. brv2 used its rounds (a findings note, round 5: rv2.txt is in no class, so
# its cap is the highest, 5) and is signed off, or carries a record that must not count.
so_leg(){ # label mode expect(refuse|pass) text
  bash "$TMP/put-signoff" "$R2" "$2" "$R1"
  prov_leg "$1" none clean "$( [ "$2" = none ] && echo none || echo findings@5)" "$3" "$4"
}
so_leg "a member with a valid owner sign-off and a clean merge" valid pass "owner sign-off (1) at its exact SHA, and the head is their clean merge"
so_leg "a sign-off recorded for another commit" othersha refuse "the record is for $R1, not $R2"
so_leg "a sign-off whose verdict file was changed after recording" tampered refuse "the sha256 of kimi.txt is"
so_leg "a sign-off whose kimi request body names another commit" otherreview refuse "the kimi request body does not name ${R2:0:10}"
so_leg "F1: a reviewed line for another commit despite body and output naming the signed SHA" otherreviewed refuse "the kimi request's reviewed line is '$R1', not $R2"
so_leg "F1b: a request without a reviewed first line" noreviewed refuse "the kimi request's first line is not a 'reviewed: <full 40-hex SHA>' line"
so_leg "F2: ACCEPT in agy's request but no verdict in its output" requestverdict refuse "the agy output has no verdict"
so_leg "a request body that names no commit" unnamedbody refuse "the kimi request body does not name ${R2:0:10}"
so_leg "a sign-off without agy's verdict" noagy refuse "the record has no agy verdict"
so_leg "a sign-off whose agy output ends in REJECT" reject refuse "the agy output's last verdict is 'VERDICT:REJECT'"
so_leg "a sign-off whose quote names no commit" unnamed refuse "the quote does not name ${R2:0:10}"
so_leg "a member with neither a note nor a sign-off" none refuse "$R2 has no owner sign-off"
# The cap is the class of the member's diff: docs 2, scripts 3, compiler and spec 5, the highest wins.
git checkout -q -b bsodoc "$MR"; mkdir -p docs; printf 'd\n' > docs/so.md; commit_all bsodoc; SD="$(git rev-parse HEAD)"

exec
/bin/bash -lc "rg -n 'put-review|reviewer:|round:|verdict:' scripts/checks/landing_script.sh scripts/review/verify.sh; rg -n -i 'sign.off when|owner may approve|outstanding finding|2026-11-08' docs/decisions* docs/LANDING.md ROADMAP.md | head -60; sed -n '1,190p' scripts/review/verify.sh; sed -n '1050,1110p' scripts/checks/landing_script.sh" in /home/unbalancedparen/projects/clones/signoff-reject-confirm
 succeeded in 0ms:
scripts/checks/landing_script.sh:107:# to origin. put-review <sha> <clean|findings|blocked|malformed|none>[@rounds]; none removes the note.
scripts/checks/landing_script.sh:108:cat > "$TMP/put-review" <<'EOF'
scripts/checks/landing_script.sh:115:  malformed) git notes --ref=$R add -f -m "verdict: clean" "$sha" ;;
scripts/checks/landing_script.sh:116:  *) git notes --ref=$R add -f -m "verdict: ${2%@*}
scripts/checks/landing_script.sh:118:reviewer: codex
scripts/checks/landing_script.sh:134:bash "$(dirname "$0")/put-review" "$4" "$mode"
scripts/checks/landing_script.sh:1153:bash "$(dirname "$0")/put-review" "$sha" "findings@$rounds"
scripts/checks/landing_script.sh:1222:  && ok "check with no review command fails instead of skipping the leg" || { no "missing reviewer: check exit $rc"; echo "$out" | sed 's/^/      /'; }
scripts/checks/landing_script.sh:1233:bash "$TMP/put-review" "$HR" none
scripts/checks/landing_script.sh:1239:  bash "$TMP/put-review" "$HR" "$2"; bash "$TMP/put-review" "$R1" "$3"; bash "$TMP/put-review" "$R2" "$4"
scripts/checks/landing_script.sh:1257:bash "$TMP/put-review" "$HR" none; bash "$TMP/put-review" "$R1" clean; bash "$TMP/put-review" "$R2" clean
scripts/checks/landing_script.sh:1294:  bash "$TMP/put-review" "$s" findings@2
