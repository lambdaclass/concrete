                ('sext', [(0,0),(2147483648,18446744071562067968),(4294967295,18446744073709551615)]),
                ('trunc', [(4294967296,0),(81985529216486895,2309737967),(18446744073709551615,4294967295)])]:
            for value, expected in values:
                assert run([LCB,'--first-path-eval',src,name,str(value)]).stdout.strip() == str(expected)
        text = assembly.read_text()
        for instruction in ['uxtw x9, w9', 'sxtw x9, w9', 'mov w9, w9']:
            assert instruction in text, instruction
        high = high_multiply_assembly(work)
        # QBE can parse and emit Apple ARM64 assembly on Linux too. Keep this
        # oracle check outside the native gate so shared fixtures cannot acquire
        # syntax accepted only by LCB's more permissive parser.
        compiler = os.environ.get('LCB_CC', os.environ.get('CC','clang'))
        qbe=work/'qbe'
        shutil.copytree(ROOT/'third_party/qbe',qbe)
        run(['make','-j2',f'CC={compiler}'],cwd=qbe)
        oracle=work/'qbe.s'
        run([qbe/'qbe','-t','arm64_apple','-o',oracle,src])
        print('first-path: shared fixtures compiled by QBE for Apple ARM64')
        if platform.system() != 'Darwin' or platform.machine() != 'arm64':
            assert not args.require_native, 'Apple ARM64 native execution required'
            print('first-path native execution: not measured on this host')
            return
        driver, probe = work/'driver.c', work/'probes.s'
        driver.write_text(harness())
        probe.write_text(probes())
        def check(asm, name, success=True):
            exe=work/name
            run([compiler,'-std=c11','-O2',driver,probe,asm,'-o',exe])
            result=run([exe],success=success)
            if success: assert result.stdout.strip()=='first-path native checks passed'
            return result
        check(assembly,'typed')
        high_driver, high_exe = work/'high.c', work/'high'
        high_driver.write_text(high_multiply_harness())
        run([compiler,'-std=c11','-O2',high_driver,high,'-o',high_exe])
        assert run([high_exe]).stdout.strip() == 'first-path high multiply native checks passed'
        baseline=work/'baseline.s'
        run([LCB, '--target', 'aarch64-macos',src,'-o',baseline])
        check(baseline,'baseline')
        # The QBE integer return ABI only promises the low word. Its identity
        # function may preserve incoming high bits, unlike our stronger emitted
        # word-result-zeroing policy. Do not call that an upstream mismatch.
        driver.write_text(harness(strict_word_result=False))
        check(oracle,'oracle')
        driver.write_text(harness())
        # Qualify comparisons using a legal, in-frame wrong operand offset.
        corrupt=work/'corrupt.s'
        text=assembly.read_text()
        old='ldr w10, [sp, #8]'
        assert old in text
        corrupt.write_text(text.replace(old,'ldr w10, [sp, #0]',1))
#!/usr/bin/env python3
"""QBE word-class merging for mutable integer temporaries; long uses remain invalid."""
from pathlib import Path
import hashlib,json
SOURCE='''export function w $long_then_word(l %input, w %n) {
@s
 %v =l copy %input
 %v =w add %v, 1
 ret %v
}
export function w $word_then_long(l %input, w %n) {
@s
 %v =w copy %n
 %v =l add %input, 3
 ret %v
}
export function w $parameter_long(l %input, w %n) {
@s
 %input =w add %input, 17
 ret %input
}
export function w $parameter_word(l %input, w %n) {
@s
 %n =l add %input, 23
 ret %n
}
export function w $branch(l %input, w %n) {
@s
 %flag =w and %n, 1
 jnz %flag, @wide, @narrow
@wide
 %v =l add %input, 7
 jmp @join
@narrow
 %v =w add %input, 13
 jmp @join
@join
 %v =w xor %v, 305419896
 ret %v
}
export function w $loop(l %input, w %n) {
@s
 %v =l copy %input
 %i =w copy 0
 jnz %n, @body, @done
