    39	  ⟨"P_parse", .implementation, "the generic table-parser theorem",
    40	    "every tree the parser returns for a token list is one the grammar derives from it"⟩,
    41	  ⟨"P_print", .implementation, "an LLVM-IR semantics; not planned for slice 0",
    42	    "the printed LLVM text of a WF BIR means at most the BIR behaviour, encoded"⟩,
    43	  ⟨"P_adapter", .implementation,
    44	    "`adapter_correct` (proved for accepted programs), once `emit` represents adaptation failure (or the contract is restricted to accepted programs) and the theorem fills `NativePremises lcb`",
    45	    "the adapted LCB function of a WF BIR means at most the BIR behaviour, encoded"⟩,
    46	  ⟨"P_toolchain[llvm]", .toolchain, "not planned",
    47	    "every result the linked LLVM body produces is one its text means"⟩,
    48	  ⟨"P_toolchain[lcb]", .toolchain, "LCB's own proofs (C01–C03 and beyond)",
    49	    "every result the linked LCB body produces is one its function means (LCB's named trust boundaries)"⟩,
    50	  ⟨"P_rt", .implementation, "a proof of the decoding entry against a libc model; not planned for slice 0",
    51	    "every launch of an image built from a WF BIR that is not killed has the behaviour of some result its body produces (decode w for a returned word w, diverges for divergence)"⟩,
    52	  ⟨"P_trap_site", .implementation, "the same runtime-entry proof (owner, 2026-11-06: a premise now)",
    53	    "a launch whose body returns 256 + i writes exactly trapLine tbl[i] and a newline on fd 2"⟩,
    54	  ⟨"P_launch", .environment, "not planned",
    55	    "an admitted launch of a WF image within the frame bound is never killed, and fd 2 accepts the trap line"⟩,
    56	  ⟨"P_live", .environment, "not planned",
    57	    "an admitted launch happens and has a behaviour"⟩
    58	]
    59	
    60	/-- The headline theorems, whose axioms the golden records. -/
    61	def theorems : List Lean.Name := [
    62	  ``Concrete.BIR.decode_encode,
    63	  ``Concrete.BIR.run_progress,
    64	  ``Concrete.BIR.behaviour_diverges_iff,
    65	  ``Concrete.Backend.LCB.Proof.adapter_correct
    66	]
    67	
    68	/-- The premise's row in Concrete/README.md's open-premise table (a generated view). -/
    69	def Premise.tableRow (p : Premise) : String :=
    70	  s!"| {p.id} | {p.trust.name} | {p.retiredBy} |"
    71	
    72	def Premise.line (p : Premise) : String :=
    73	  s!"premise {p.id} [{p.trust.name}] retired-by: {p.retiredBy} :: {p.statement}"
    74	
    75	open Lean in
    76	/-- The trusted-base report: one line per premise, then for each theorem its sorted axioms, then
    77	    each axiom once with its type (so an axiom restated under the same name changes the report). -/
    78	def report (thms : List Name) : CoreM (List String) := do
    79	  let mut lines := all.map Premise.line
    80	  let mut seen : Array Name := #[]
    81	  for n in thms do
    82	    let axs := (← collectAxioms n).qsort Name.lt
    83	    lines := lines ++ [s!"theorem {n} axioms: {", ".intercalate (axs.map toString).toList}"]
    84	    for a in axs do
    85	      unless seen.contains a do seen := seen.push a
    86	  for a in seen.qsort Name.lt do
    87	    let ty ← Meta.MetaM.run' (PrettyPrinter.ppExpr (← getConstInfo a).type)
    88	    lines := lines ++ [s!"axiom {a} : {toString ty}"]
    89	  return lines
    90	
    91	end Concrete.Premises
