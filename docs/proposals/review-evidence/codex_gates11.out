 succeeded in 0ms:
/-
The slice-0 trusted base (PROVISIONAL): the open premises and the headline theorems whose axiom
closure the trusted-base golden records (Concrete/README.md gate 9).

This is the premise REGISTRY, the one list of the open premises: each entry has its trust class,
what retires it, and its statement. The statements are text until the structures that state them
as Lean propositions (`FrontendPremises`, `NativePremises`, whose design is in Concrete/README.md)
land with the front end; each entry then names its field instead. `scripts/checks/slice0_trusted_base.sh` prints
this registry and the axioms of `theorems` and compares them with `tests/golden/slice0_trusted_base.txt`,
so a premise added, removed or reworded fails until the golden is updated with it.
-/
import Lean.Meta.Basic
import Lean.PrettyPrinter
import Lean.Util.CollectAxioms
import Concrete.BIR.Progress
import Concrete.Backend.LCB

namespace Concrete.Premises

inductive Trust where
  | implementation | toolchain | environment
  deriving Repr, DecidableEq

def Trust.name : Trust → String
  | .implementation => "implementation"
  | .toolchain => "toolchain"
  | .environment => "environment"

structure Premise where
  id : String
  trust : Trust
  retiredBy : String
  statement : String

/-- The open premises for slice 0, in the README's order. -/
def all : List Premise := [
  ⟨"P_lex", .implementation, "`lex_correct`",
    "every token list the lexer returns for a source is one the source lexes to"⟩,
  ⟨"P_parse", .implementation, "the generic table-parser theorem",
    "every tree the parser returns for a token list is one the grammar derives from it"⟩,
  ⟨"P_print", .implementation, "an LLVM-IR semantics; not planned for slice 0",
    "the printed LLVM text of a WF BIR means at most the BIR behaviour, encoded"⟩,
  ⟨"P_adapter", .implementation,
    "`adapter_correct` (proved for accepted programs), once `emit` represents adaptation failure (or the contract is restricted to accepted programs) and the theorem fills `NativePremises lcb`",
    "the adapted LCB function of a WF BIR means at most the BIR behaviour, encoded"⟩,
  ⟨"P_toolchain[llvm]", .toolchain, "not planned",
    "every result the linked LLVM body produces is one its text means"⟩,
  ⟨"P_toolchain[lcb]", .toolchain, "LCB's own proofs (C01–C03 and beyond)",
    "every result the linked LCB body produces is one its function means (LCB's named trust boundaries)"⟩,
  ⟨"P_rt", .implementation, "a proof of the decoding entry against a libc model; not planned for slice 0",
    "every launch of an image built from a WF BIR that is not killed has the behaviour of some result its body produces (decode w for a returned word w, diverges for divergence)"⟩,
  ⟨"P_trap_site", .implementation, "the same runtime-entry proof (owner, 2026-11-06: a premise now)",
    "a launch whose body returns 256 + i writes exactly trapLine tbl[i] and a newline on fd 2"⟩,
  ⟨"P_launch", .environment, "not planned",
    "an admitted launch of a WF image within the frame bound is never killed, and fd 2 accepts the trap line"⟩,
  ⟨"P_live", .environment, "not planned",
    "an admitted launch happens and has a behaviour"⟩
]

/-- The headline theorems, whose axioms the golden records. -/
def theorems : List Lean.Name := [
  ``Concrete.BIR.decode_encode,
  ``Concrete.BIR.run_progress,
  ``Concrete.BIR.behaviour_diverges_iff,
  ``Concrete.Backend.LCB.Proof.adapter_correct
]

/-- The premise's row in Concrete/README.md's open-premise table (a generated view). -/
def Premise.tableRow (p : Premise) : String :=
  s!"| {p.id} | {p.trust.name} | {p.retiredBy} |"

def Premise.line (p : Premise) : String :=
  s!"premise {p.id} [{p.trust.name}] retired-by: {p.retiredBy} :: {p.statement}"

open Lean in
/-- The trusted-base report: one line per premise, then for each theorem its sorted axioms, then
    each axiom once with its type (so an axiom restated under the same name changes the report). -/
def report (thms : List Name) : CoreM (List String) := do
  let mut lines := all.map Premise.line
  let mut seen : Array Name := #[]
  for n in thms do
    let axs := (← collectAxioms n).qsort Name.lt
    lines := lines ++ [s!"theorem {n} axioms: {", ".intercalate (axs.map toString).toList}"]
    for a in axs do
      unless seen.contains a do seen := seen.push a
  for a in seen.qsort Name.lt do
    let ty ← Meta.MetaM.run' (PrettyPrinter.ppExpr (← getConstInfo a).type)
    lines := lines ++ [s!"axiom {a} : {toString ty}"]
  return lines

end Concrete.Premises
import Lean.Elab.Command
import Concrete

/-!
Printer for the slice-0 trusted-base golden (`scripts/checks/slice0_trusted_base.sh`, README gate
9). PROVISIONAL: it stands in for `concrete facts` until the compiler's command line exists.

`lake env lean scripts/checks/slice0_trusted_base.lean` prints `Concrete.Premises.report` of the
headline theorems: every open premise of the registry, each theorem's axioms, and each axiom's type.
-/

open Lean Elab Command Concrete.Premises in
#eval show CommandElabM Unit from do
  for l in ← liftCoreM (report theorems) do
    IO.println l
import Concrete

/-!
Prints the rows of Concrete/README.md's open-premise table from the registry
(`Concrete.Premises.all`, `Premise.tableRow`), for `scripts/checks/slice0_trusted_base.sh`. PROVISIONAL.
-/

#eval do
  for p in Concrete.Premises.all do
    IO.println p.tableRow
#!/usr/bin/env bash
# Slice-0 trusted-base golden (PROVISIONAL, Concrete/README.md gate 9). The trusted base, printed
# by scripts/checks/slice0_trusted_base.lean (until `concrete facts` exists): the premise registry
# Concrete/Premises.lean (the one list of open premises), each headline theorem's axioms and each
# axiom's type, followed by the Lean toolchain and every Lake pin, must equal
# tests/golden/slice0_trusted_base.txt byte for byte. A premise added, removed or reworded (id,
# trust class, what retires it, statement), a headline theorem gaining an axiom (sorryAx
# included), an axiom restated, or a toolchain or pin change fails until the golden is updated.
# The README's open-premise table is a generated view: it must equal the registry's rendering
# (scripts/checks/slice0_premise_table.lean).
#
# Controls: the comparison must reject the golden with a premise line removed, reworded, or with an
# extra axiom; the printer must fail on a Lean file that prints and then errors; the report must
# list a theorem's own axiom with its type (a control file declaring one); the table check must
# reject a drifted table.
#
# usage: slice0_trusted_base.sh [update]. Run inside the nix devshell, from the repository root;
# `update` rewrites the golden (review the diff before committing it).
set -euo pipefail
# shellcheck source=scripts/checks/lib/slice0_common.sh
source scripts/checks/lib/slice0_common.sh
golden=tests/golden/slice0_trusted_base.txt

# print_lean FILE OUT: elaborate FILE (bounded, capped) and write its stdout to OUT; fails (with
# the bounded diagnostics) when Lean fails, times out, or prints more than 1 MiB.
print_lean() {
  local rc=0
  bounded_run -i /dev/null 600 -- "${capped[@]}" lake env lean "$1" >"$2.raw" 2>"$2.err" || rc=$?
  if [ "$rc" != 0 ]; then
    bounded_is_incomplete "$rc" && echo "slice0_trusted_base: $1: INCOMPLETE (timed out)" >&2
    head -c 20000 "$2.raw" "$2.err" >&2
    return 1
  fi
  cap_out <"$2.raw" >"$2"
}

# current OUT: the whole trusted base into OUT; fails if any step fails.
current() {
  print_lean scripts/checks/slice0_trusted_base.lean "$1.lean" || return 1
  [ -s "$1.lean" ] || { echo "slice0_trusted_base: the printer printed nothing" >&2; return 1; }
  { cat "$1.lean"; printf 'lean-toolchain %s\n' "$(head -c 200 lean-toolchain)"; } >"$1" || return 1
  python3 -I -c 'import json,sys
for p in json.load(open(sys.argv[1]))["packages"]: print("pin", p["name"], p["rev"])' \
    lake-manifest.json | cap_out >>"$1" || return 1
}

if ! current "$work/current"; then
  echo "FAIL slice0_trusted_base: printing the trusted base failed"
  exit 1
fi
if [ "${1:-}" = update ]; then
  mkdir -p "$(dirname "$golden")"
  cp "$work/current" "$golden"
  echo "slice0_trusted_base: golden updated; review: git diff -- $golden"
  exit 0
fi

fail=0
if cmp -s "$golden" "$work/current"; then
  echo "ok   trusted base equals $golden"
else
  echo "FAIL trusted base differs from $golden (run with update after review):"
  diff "$golden" "$work/current" | head -c 20000 || true
  fail=1
fi

# The README's open-premise table: the rows after its header and separator, up to the first line
# that is not a row; fails when the table is missing.
readme_rows() {
  awk '/^\*\*The open premises for slice 0\*\*/{h=1; next}
       h==1 && /^\| Premise \| Trust class \| Retired by \|$/{h=2; next}
       h==2 && /^\|---\|---\|---\|$/{h=3; next}
       h==3 && /^\|/{print; n++; next}
       h==3{exit}
       END{if (n == 0) exit 1}' "$1"
}
if ! print_lean scripts/checks/slice0_premise_table.lean "$work/rows"; then
  echo "FAIL printing the registry's table rows"; fail=1
elif readme_rows Concrete/README.md >"$work/readme_rows" && cmp -s "$work/rows" "$work/readme_rows"; then
  echo "ok   README's open-premise table equals the registry"
else
  echo "FAIL README's open-premise table differs from the registry (Concrete/Premises.lean):"
  diff "$work/readme_rows" "$work/rows" | head -c 20000 || true
  fail=1
fi

# Controls.
differs() { # differs NAME FILE: FILE must not equal the current trusted base
  if cmp -s "$2" "$work/current"; then echo "FAIL control: comparison accepts $1"; fail=1
  else echo "ok   control: comparison rejects $1"; fi
}
sed '1d' "$work/current" >"$work/c1"; differs "a premise removed" "$work/c1"
sed '1s/$/ (reworded)/' "$work/current" >"$work/c2"; differs "a premise reworded" "$work/c2"
sed '0,/^theorem /s/^\(theorem .*\)$/\1, sorryAx/' "$work/current" >"$work/c3"
differs "an extra axiom" "$work/c3"
mkdir -p "$work/ctl"
printf '#eval IO.println "premise"\n#eval (throw (IO.userError "control") : IO Unit)\n' >"$work/ctl/fails.lean"
if print_lean "$work/ctl/fails.lean" "$work/ctl/fails.out" 2>/dev/null; then
  echo "FAIL control: the printer accepts a Lean file that errors"; fail=1
else echo "ok   control: the printer fails on a Lean file that errors"; fi
cat >"$work/ctl/axiom.lean" <<'EOF'
import Lean.Elab.Command
import Concrete
axiom slice0_control_axiom : 1 = 2
theorem slice0_control : 1 = 2 := slice0_control_axiom
open Lean Elab Command in
#eval show CommandElabM Unit from do
  for l in ← liftCoreM (Concrete.Premises.report [``slice0_control]) do IO.println l
EOF
if print_lean "$work/ctl/axiom.lean" "$work/ctl/axiom.out" &&
   grep -qx 'theorem slice0_control axioms: slice0_control_axiom' "$work/ctl/axiom.out" &&
   grep -qx 'axiom slice0_control_axiom : 1 = 2' "$work/ctl/axiom.out"; then
  echo "ok   control: the report lists a theorem's axiom with its type"
else echo "FAIL control: the report misses a theorem's axiom: $(head -c 2000 "$work/ctl/axiom.out" 2>/dev/null)"; fail=1; fi

sed 's/^| P_rt | implementation | /| P_rt | toolchain | /' Concrete/README.md >"$work/ctl/readme"
if readme_rows "$work/ctl/readme" >"$work/ctl/rows" && cmp -s "$work/rows" "$work/ctl/rows"; then
  echo "FAIL control: the table check accepts a drifted table"; fail=1
else echo "ok   control: the table check rejects a drifted table"; fi

bounded_summary
[ "$fail" = 0 ] && echo "PASS slice0_trusted_base" || { echo "FAIL slice0_trusted_base"; exit 1; }

