     2	# Slice-0 trusted-base golden (PROVISIONAL, Concrete/README.md gate 9). The trusted base, printed
     3	# by scripts/checks/slice0_trusted_base.lean (until `concrete facts` exists): the premise registry
     4	# Concrete/Premises.lean (the one list of open premises), each headline theorem's axioms and each
     5	# axiom's type, followed by the Lean toolchain and every Lake pin, must equal
     6	# tests/golden/slice0_trusted_base.txt byte for byte. A premise added, removed or reworded (id,
     7	# trust class, what retires it, statement), a headline theorem gaining an axiom (sorryAx
     8	# included), an axiom restated, or a toolchain or pin change fails until the golden is updated.
     9	# The README's open-premise table is a generated view: it must equal the registry's rendering
    10	# (scripts/checks/slice0_premise_table.lean).
    11	#
    12	# Controls: the comparison must reject the golden with a premise line removed, reworded, or with an
    13	# extra axiom; the printer must fail on a Lean file that prints and then errors; the report must
    14	# list a theorem's own axiom with its type (a control file declaring one); the table check must
    15	# reject a drifted table.
    16	#
    17	# usage: slice0_trusted_base.sh [update]. Run inside the nix devshell, from the repository root;
    18	# `update` rewrites the golden (review the diff before committing it).
    19	set -euo pipefail
    20	# shellcheck source=scripts/checks/lib/slice0_common.sh
    21	source scripts/checks/lib/slice0_common.sh
    22	golden=tests/golden/slice0_trusted_base.txt
    23	
    24	# print_lean FILE OUT: elaborate FILE (bounded, capped) and write its stdout to OUT; fails (with
    25	# the bounded diagnostics) when Lean fails, times out, or prints more than 1 MiB.
    26	print_lean() {
    27	  local rc=0
    28	  bounded_run -i /dev/null 600 -- "${capped[@]}" lake env lean "$1" >"$2.raw" 2>"$2.err" || rc=$?
    29	  if [ "$rc" != 0 ]; then
    30	    bounded_is_incomplete "$rc" && echo "slice0_trusted_base: $1: INCOMPLETE (timed out)" >&2
    31	    head -c 20000 "$2.raw" "$2.err" >&2
    32	    return 1
    33	  fi
    34	  cap_out <"$2.raw" >"$2"
    35	}
    36	
    37	# current OUT: the whole trusted base into OUT; fails if any step fails.
    38	current() {
    39	  print_lean scripts/checks/slice0_trusted_base.lean "$1.lean" || return 1
    40	  [ -s "$1.lean" ] || { echo "slice0_trusted_base: the printer printed nothing" >&2; return 1; }
    41	  { cat "$1.lean"; printf 'lean-toolchain %s\n' "$(head -c 200 lean-toolchain)"; } >"$1" || return 1
    42	  python3 -I -c 'import json,sys
    43	for p in json.load(open(sys.argv[1]))["packages"]: print("pin", p["name"], p["rev"])' \
    44	    lake-manifest.json | cap_out >>"$1" || return 1
    45	}
    46	
    47	if ! current "$work/current"; then
    48	  echo "FAIL slice0_trusted_base: printing the trusted base failed"
    49	  exit 1
    50	fi
    51	if [ "${1:-}" = update ]; then
    52	  mkdir -p "$(dirname "$golden")"
    53	  cp "$work/current" "$golden"
    54	  echo "slice0_trusted_base: golden updated; review: git diff -- $golden"
    55	  exit 0
    56	fi
    57	
    58	fail=0
    59	if cmp -s "$golden" "$work/current"; then
    60	  echo "ok   trusted base equals $golden"
    61	else
    62	  echo "FAIL trusted base differs from $golden (run with update after review):"
    63	  diff "$golden" "$work/current" | head -c 20000 || true
    64	  fail=1
    65	fi
    66	
    67	# The README's open-premise table: the rows after its header and separator, up to the first line
    68	# that is not a row; fails when the table is missing.
    69	readme_rows() {
    70	  awk '/^\*\*The open premises for slice 0\*\*/{h=1; next}
    71	       h==1 && /^\| Premise \| Trust class \| Retired by \|$/{h=2; next}
    72	       h==2 && /^\|---\|---\|---\|$/{h=3; next}
    73	       h==3 && /^\|/{print; n++; next}
    74	       h==3{exit}
    75	       END{if (n == 0) exit 1}' "$1"
    76	}
    77	if ! print_lean scripts/checks/slice0_premise_table.lean "$work/rows"; then
    78	  echo "FAIL printing the registry's table rows"; fail=1
    79	elif readme_rows Concrete/README.md >"$work/readme_rows" && cmp -s "$work/rows" "$work/readme_rows"; then
    80	  echo "ok   README's open-premise table equals the registry"
    81	else
    82	  echo "FAIL README's open-premise table differs from the registry (Concrete/Premises.lean):"
    83	  diff "$work/readme_rows" "$work/rows" | head -c 20000 || true
    84	  fail=1
    85	fi

