# The memory addresses one instruction accesses, for the run checks (stack_measure.py under gdb,
# stack_measure_lldb.py under LLDB; README gate 12). PROVISIONAL. Plain Python 3.9 (Apple's LLDB
# runs its own), no imports beyond re.
#
# The run check counts the lowest byte each stepped instruction of the Concrete-owned code
# addresses, not only the stack pointer: code may use the target's red zone, below the stack
# pointer, without moving it (stack_bound.py counts the same bytes). An access's lowest byte is its
# effective address, whatever its size, so only the address is computed. Fail closed: an operand
# this module cannot evaluate is an error, never "no access".
import re

MASK = (1 << 64) - 1
NUM = re.compile(r"(?:0x[0-9a-f]+|\d+)$")
# Register names an address may use. Anything else is refused before it reaches the debugger (gdb
# reads `$name` as a convenience variable when it is not a register).
X86_REG = re.compile(r"(?:r(?:[abcd]x|[sd]i|[sb]p|(?:[89]|1[0-5])[dwb]?)|e(?:[abcd]x|[sd]i|[sb]p)|r?ip)$")
A64_REG = re.compile(r"(?:[xw](?:[12]?\d|30)|sp|fp|lr)$")


def _reg(reg, name, pattern):
    if not pattern.match(name):
        raise ValueError(f"unmodelled register {name!r} in an address")
    return reg(name)


def _num(text):
    return int(text, 0)


def x86_addresses(asm, reg, next_pc):
    """Effective addresses of the memory operands of one instruction in gdb's Intel syntax
    (`mov QWORD PTR [rsp-0x80],0x0`). reg(name) reads a register. lea and nop compute an address
    without accessing it; fs:/gs: operands address the thread block, not the stack."""
    asm = asm.split("#", 1)[0].strip().lower()
    mn = asm.split(None, 1)[0] if asm else ""
    if mn == "lea" or mn.startswith("nop") or mn.startswith("prefetch"):
        return []
    out = []
    for m in re.finditer(r"(?:(\w\w):)?\[([^\]]*)\]", asm):
        if m.group(1) in ("fs", "gs"):
            continue
        inner = m.group(2).replace(" ", "")
        if not inner or inner[0] not in "+-":
            inner = "+" + inner
        terms = re.findall(r"([+-])([^+-]+)", inner)
        if "".join(s + t for s, t in terms) != inner:
            raise ValueError(f"unparsed memory operand [{m.group(2)}] in {asm}")
        addr = 0
        for sign, term in terms:
            if "*" in term:
                a, b = term.split("*", 1)
                r, scale = (b, a) if NUM.match(a) else (a, b)
                if not NUM.match(scale) or _num(scale) not in (1, 2, 4, 8):
                    raise ValueError(f"unparsed scaled index {term} in {asm}")
                v = _reg(reg, r, X86_REG) * _num(scale)
            elif NUM.match(term):
                v = _num(term)
            elif term == "rip":
                v = next_pc
            else:
                v = _reg(reg, term, X86_REG)
            addr += v if sign == "+" else -v
        out.append(addr & MASK)
    if not out and re.match(r"(?:rep\w*\s+)?(?:movs|stos|lods|cmps|scas)[bwdq]?(?:\s|$)", asm):
        raise ValueError(f"string instruction with implicit memory operands: {asm}")
    return out


def _a64_index(text, reg):
    """Value of an AArch64 index operand: `x9`, `x9, lsl #3`, `w9, sxtw #2`, `w9, uxtw`."""
    parts = [p.strip() for p in text.split(",")]
    r = parts[0]
    v = _reg(reg, "x" + r[1:], A64_REG) if r.startswith("w") else _reg(reg, r, A64_REG)
    if r.startswith("w"):
        v &= 0xFFFFFFFF
    shift = 0
    if len(parts) > 1:
        m = re.fullmatch(r"(lsl|sxtw|uxtw|sxtx|uxtx)(?:\s+#(\d+))?", parts[1])
        if not m:
            raise ValueError(f"unparsed index extension {parts[1]}")
        if m.group(1) == "sxtw" and v & 0x80000000:
            v -= 1 << 32
        shift = int(m.group(2) or 0)
    if len(parts) > 2:
        raise ValueError(f"unparsed index {text}")
    return v << shift


def a64_addresses(mnemonic, operands, reg):
    """Effective addresses of one AArch64 instruction in LLDB's syntax (`stp x29, x30, [sp,
    #-0x10]!`, `ldr x30, [sp], #0x10`, `ldr w8, [x9, x10, lsl #2]`). A post-indexed access is at the
    base; a pre-indexed or offset one at base plus offset. prfm/prfum only hint. Use
    a64_new_sp for the stack pointer a pre-indexed access is judged against."""
    mn, ops = mnemonic.lower(), operands.lower().split("//", 1)[0]
    if mn.startswith("prf"):
        return []
    m = re.search(r"\[([^\]]*)\](!?)", ops)
    if not m:
        return []
    parts = [p.strip() for p in m.group(1).split(",", 1)]
    base = _reg(reg, parts[0], A64_REG)
    post = ops[m.end():].strip()
    if post:
        if not re.fullmatch(r",\s*(#-?(0x[0-9a-f]+|\d+)|x\d+)", post) or len(parts) > 1:
            raise ValueError(f"unparsed post-index in {mn} {operands}")
        return [base & MASK]
    if len(parts) == 1:
        return [base & MASK]
    off = parts[1]
    if off.startswith("#"):
        return [(base + _num(off[1:])) & MASK]
    return [(base + _a64_index(off, reg)) & MASK]


def a64_new_sp(mnemonic, operands, reg, sp):
    """The stack pointer an access of this instruction is judged against: the written-back one for
    a pre-indexed sp access (`stp x29, x30, [sp, #-0x90]!` allocates the frame first, then stores
    at the new sp, as stack_bound.py treats it), else `sp`."""
    ops = operands.lower().split("//", 1)[0]
    m = re.search(r"\[\s*sp\s*(?:,\s*#(-?(?:0x[0-9a-f]+|\d+)))?\s*\]!", ops)
    if not m or mnemonic.lower().startswith("prf"):
        return sp
    return min(sp, (sp + _num(m.group(1) or "0")) & MASK)


def lowest_stack(addresses, sp, sp0, red_zone, span):
    """The lowest of `addresses` that lies on the stack below main's entry stack pointer sp0
    (within `span` bytes of it; the analysis' premise puts the image farther away), or None. An
    access deeper than the red zone below `sp` is an error: no bound holds for bytes a signal
    handler may overwrite. `sp` is the lower of the stack pointer before and after the access (a
    pre-indexed access is at the new one; a64_new_sp)."""
    low = None
    for a in addresses:
        if sp0 - span <= a < sp0:
            if a < sp - red_zone:
                raise ValueError(f"an access {sp - a} bytes below the stack pointer, beyond the "
                                 f"{red_zone}-byte red zone")
            low = a if low is None else min(low, a)
    return low
           valueWidths := Array.replicate (valueCount p) .word, blocks := blocks.toArray }

/-- The LCB backend's emit: the adapted body paired with the program's site table (the table that
decodes the body's result is part of the emitted artifact), or the adapter's refusal, in which case
no artifact exists (`artifact` and the emitter build only from `.ok`). `Proof.emit_correct` and
`Proof.artifact_correct` are the backend contract: no premise. -/
def emit (p : Program) : Except String (Source.Function × SiteTable) := do
  let f ← adapt p
  return (f, p.sites)

/-! ## Assembly, in process (inside `P_toolchain[lcb]`) -/

/-- The targets the gate runs LCB's output on. -/
inductive Target where
  | x86_64Linux | aarch64Linux | aarch64Macos
  deriving DecidableEq, Repr

def Target.ofName : String → Option Target
  | "x86_64-linux" => some .x86_64Linux
  | "aarch64-linux" => some .aarch64Linux
  | "aarch64-macos" => some .aarch64Macos
  | _ => none

/-- The body's symbol: the runtime entry calls `concrete_body`. -/
def bodySymbol : LeanCompilerBackend.Verified.Symbol := { namespaceName := "concrete", name := "concrete_body", exported := true }

/-- The adapted body as assembly text for `target`, computed in process from the value. -/
def assemble (target : Target) (f : Source.Function) : Except String String :=
  match target with
  | .aarch64Macos => do
    let job : LeanCompilerBackend.Verified.FunctionJob :=
      { code := { symbol := bodySymbol, body := f, abi := LeanCompilerBackend.Verified.planAbi f,
                  layout := LeanCompilerBackend.Verified.planFrame f } }
    let artifact ← (LeanCompilerBackend.Verified.compileFunction job).mapError (fun e => s!"LCB first path: {repr e}")
    return ".text\n" ++ artifact.code.fragment ++ ".subsections_via_symbols\n"
  | .x86_64Linux | .aarch64Linux => do
    let m : LeanCompilerBackend.Module :=
      { functions := #[LeanCompilerBackend.Verified.reify f bodySymbol.name bodySymbol.exported] }
    LeanCompilerBackend.validateModule m
    match target with
    | .x86_64Linux => LeanCompilerBackend.AMD64.emitModuleValidated m false false
    | _ => LeanCompilerBackend.AArch64.emitModuleValidated m false false

/-- The LCB body artifact for `target`: the assembly of a successful `emit`, or its refusal. -/
def artifact (target : Target) (p : Program) : Except String String := do
  let (f, _) ← emit p
  assemble target f

/-! ## `adapter_correct`, value level

The first layer of the adapter proof: each BIR instruction's expansion computes, in LCB's 32-bit
words, the encoding of the BIR result. `enc` is the value representation; `wrap_word` and
`flag_word` are the two facts the instruction expansions rest on. -/

/-- What the adapted body produces, from LCB's own source semantics with no arguments: `returns w`
iff `Source.HasBehavior f #[] (.returned (.word w))`, `diverges` iff
`Source.HasBehavior f #[] .diverges`, and `stuck` when neither holds (an `initial` fault, a `.long`
return, a stuck fault). LCB's behaviour is unique (`Proof.hasBehavior_unique`), so exactly one
holds. -/
def bodyResult (f : Source.Function) : BodyResult → Prop
  | .returns w => Source.HasBehavior f #[] (.returned (.word w))
  | .diverges => Source.HasBehavior f #[] .diverges
  | .stuck => (∀ w, ¬ Source.HasBehavior f #[] (.returned (.word w))) ∧
      ¬ Source.HasBehavior f #[] .diverges

namespace Proof

/-- How a BIR value is represented in LCB: an integer as its 32-bit word, a flag as 0 or 1. -/
def enc : Val → Source.Value
  | .int _ v => word v
  | .bool b => word (if b then 1 else 0)
#!/usr/bin/env bash
# TRUST BAN: no `sorry` and no `native_decide` anywhere in the specification (Q9.17), checked
# transitively in the kernel's terms and in the sources the environment does not keep.
#
#   E  no constant of ANY kind the ConcreteSpec library declares (definitions, instances and
#      generated helpers included, not only theorems) depends transitively on sorryAx, on
#      Lean.ofReduceBool or Lean.ofReduceNat (what native_decide and `decide +native` reduce through),
#      on Lean.trustCompiler, or on a generated `._native.` axiom;
#   D  the library declares no axiom of its own;
#   X  every `example`, which the kernel checks and Lean then discards (so E and D never see it),
#      depends only on the standard axioms: in a copy of the library each `example` becomes a
#      named declaration (scripts/proofs/lean_lex.py), the copy is built, and its axioms are
#      collected as E collects a theorem's;
#   S  defence in depth, lexical: the library builds with warningAsError and nothing in lakefile.toml
#      can change that or point the build at other sources; the sources, comments stripped and
#      string literals kept, never spell sorry, sorryAx, admit, native_decide, +native, an
#      option on `decide`, ofReduceBool, ofReduceNat, trustCompiler or skipKernelTC, and define no
#      syntax extension, run no meta code, set no option and import nothing outside the library
#      (the lexer reads what Lean reads only for syntax it knows).
#
# NEGATIVE CONTROLS: a theorem proved by sorry, a definition whose body is sorry (no theorem about
# it), a theorem proved by native_decide and a declared axiom each fail E or D naming the constant;
# a source with an `example` proved by native_decide or a sorry hidden in an interpolation fails S,
# the same words inside comments do not, and an unreadable or unlexable source fails S; examples
# proved by `decide +native` and by `stop` fail X, and one proved by rfl does not.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../checks/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"
CHECK_NAME=PROOF-TRUST-BAN
source scripts/proofs/lib.sh

BANNED_AXIOM_RE='^(sorryAx|Lean[.]ofReduceBool|Lean[.]ofReduceNat|Lean[.]trustCompiler)$|[.]_native[.]'
BANNED_WORD_RE='\b(sorry|sorryAx|admit|native_decide|ofReduceBool|ofReduceNat|trustCompiler|skipKernelTC)\b|\+native\b|\bnative»?\s*:=|\bdecide\s*\(\s*config\b|\bdecide\s*[+-]|\bDecide[.]Config\b'
# `decide` takes no options at all (`decide +native`, `decide (config := ⟨…⟩)` with a positional
# native flag): a term `decide (p)` is unaffected.
# The source scan is lexical, so it holds only for the syntax it lexes: Lean core's. A syntax
# extension could make Lean read a literal differently from the scan (a macro taking `s!` before a
# plain string), so the sources may define none and import nothing outside the library (only Init,
# implicitly, which is where s!, m! and f! live). They set no option either: the library builds with
# warningAsError (checked below in lakefile.toml), so a `sorry` that elaborates anywhere, whatever
# tactic produced it (`stop` is `repeat sorry`), fails the build; `set_option warningAsError false`
# would undo that. Nor do they run meta code (run_cmd, run_tac, #eval and the like).
EXTENSION_RE='#eval\b|\b(run_cmd|run_tac|run_elab|run_meta|set_option|macro|macro_rules|syntax|notation|infix|infixl|infixr|prefix|postfix|elab|elab_rules|declare_syntax_cat|initialize|builtin_initialize)\b'

# banned FILE → `<constant> (<axiom>)` for every constant of a PROOF_MODE=constants listing with a banned axiom
banned() {
  awk -F'\t' -v re="$BANNED_AXIOM_RE" '{ n = split($3, a, " ")
    for (i = 1; i <= n; i++) if (a[i] ~ re) { print $1 " (" a[i] ")"; break } }' "$1"
}
# declared FILE → the axioms a PROOF_MODE=constants listing declares
declared() { awk -F'\t' '$2 == "axiom" { print $1 }' "$1"; }
# scan FILE... → `file:line: text` for every banned word, syntax extension, option, meta command or
# outside import outside comments; exit 3 when a source cannot be lexed (lean_lex.py)
scan() { python3 "$PROOFS_DIR/lean_lex.py" scan "$BANNED_WORD_RE|$EXTENSION_RE" "$@"; }

echo "=== E/D: the environment ==="
population imported > "$TMP/imported.txt" 2> "$TMP/imported.err" || { no "PROOF_MODE=imported failed"; finish; }
GAP=$(closure_gap "$TMP/imported.txt")
[ -z "$GAP" ] && ok "all $(spec_modules | grep -c .) ConcreteSpec source modules are in the environment E and D read" \
  || no "source modules outside the root's import closure, unseen by E and D: $(echo $GAP)"
population constants > "$TMP/consts.tsv" 2> "$TMP/consts.err" \
  || { cat "$TMP/consts.err" >&2; echo "error: the enumerator failed" >&2; exit 2; }
NC=$(grep -c . "$TMP/consts.tsv")
B=$(banned "$TMP/consts.tsv")
[ "$NC" -ge 1000 ] && [ -z "$B" ] \
  && ok "none of the $NC ConcreteSpec constants depends on sorryAx, ofReduceBool/Nat, trustCompiler or a native axiom" \
  || no "$NC constants; banned dependencies: $(echo $B | cut -c1-400)"
A=$(declared "$TMP/consts.tsv")
[ -z "$A" ] && ok "ConcreteSpec declares no axiom" || no "ConcreteSpec declares axioms: $(echo $A)"

echo "=== S: the sources ==="
mapfile -t SRC < <({ echo ConcreteSpec.lean; find ConcreteSpec -name '*.lean'; } | sort)
W=$(scan "${SRC[@]}"); RC=$?
[ "$RC" = 0 ] && [ "${#SRC[@]}" -ge 10 ] && [ -z "$W" ] && ok "none of the ${#SRC[@]} source files spells a banned word outside comments" \
  || no "the source scan (rc=$RC) of ${#SRC[@]} files: $(printf '%s\n' "$W" | head -5 | tr '\n' '|')"

# lake_options LAKEFILE → empty when the specification library builds from ConcreteSpec.lean and
# ConcreteSpec/ (Lake's defaults: no srcDir, roots or globs) with warningAsError, and nothing can turn
# it off. The package holds exactly two libraries, ConcreteSpec and the compiler, Concrete (ROADMAP B0),
# under the same key allow-list. A dependency is a `require` of a git URL pinned to a full commit,
# which lake-manifest.json (beside the lakefile) records at the same URL and commit: the spec may
# import nothing outside itself (S), so a dependency reaches only the compiler. This ban's scope is
# the specification; the compiler's trust gate is Concrete/README.md gate 2.
lake_options() {
  python3 - "$1" <<'EOF'
import sys, tomllib
try:
    cfg = tomllib.load(open(sys.argv[1], "rb"))
except Exception as e:
    print(f"unreadable: {e}"); sys.exit(0)
bad = []
import os
if os.path.exists(os.path.join(os.path.dirname(sys.argv[1]) or ".", "lakefile.lean")):
    bad.append("a lakefile.lean, which Lake reads instead of lakefile.toml")
if cfg.get("leanOptions", {}).get("warningAsError") is not True:
    bad.append("[leanOptions] warningAsError is not true")
# Allow-lists, not deny-lists: a key not named here (srcDir, roots, globs, moreLeanArgs, …) could
# point the build at other sources or pass options, so it is refused.
extra = set(cfg) - {"name", "version", "defaultTargets", "leanOptions", "lean_lib", "require"}
