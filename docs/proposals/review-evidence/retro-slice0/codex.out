refuse a64-pc-relative-after-call '    1010:\tstp\tx29, x30, [sp, #-0x10]!\n    1014:\tadrp\tx8, 0x2000 <_main+0xff0>\n    1018:\tbl\t0x1040 <_concrete_body>\n    101c:\tldr\tw0, [x8, #0x10]\n    1020:\tldp\tx29, x30, [sp], #0x10\n    1024:\tret\n\n0000000000001040 <_concrete_body>:\n    1040:\tret\n' aarch64-macos _main
# PC-relative provenance through repeated adds (a loop walking toward the stack).
refuse a64-pc-relative-walk '    1010:\tadr\tx8, 0x1010 <_main>\n    1014:\tsub\tx2, x1, #0xfff\n    1018:\tadd\tx8, x8, #0x8\n    101c:\tcmp\tx8, x2\n    1020:\tb.lo\t0x1018 <_main+0x8>\n    1024:\tstrb\twzr, [x8]\n    1028:\tret\n' aarch64-macos _main
refuse a64-pc-relative-far '    1010:\tadrp\tx8, 0x7fff0000\n    1014:\tstrb\twzr, [x8]\n    1018:\tret\n' aarch64-macos _main
refuse absolute-address '    1010:\tmov\tbyte ptr [0x7fffffd0], 0x0\n    1018:\tret\n'
# The link register loaded from a slot that does not hold it, and a stub call with no stub entry.
refuse a64-lr-from-other-slot '    1010:\tsub\tsp, sp, #0x20\n    1014:\tstr\tx30, [sp, #0x10]\n    1018:\tstr\tx0, [sp, #0x8]\n    101c:\tldr\tx30, [sp, #0x8]\n    1020:\tadd\tsp, sp, #0x20\n    1024:\tret\n' aarch64-macos _main
refuse a64-unmapped-stub '    1010:\tstr\tx30, [sp, #-0x10]!\n    1014:\tbl\t0x1040 <_write+0x1040>\n    1018:\tldr\tx30, [sp], #0x10\n    101c:\tret\n' aarch64-macos _main
# A call into the middle of a Mach-O stub entry, and to the stub section with no entry mapped.
refuse a64-mid-stub-call '    1010:\tstr\tx30, [sp, #-0x10]!\n    1014:\tbl\t0x1044 <__stubs+0x4>\n    1018:\tldr\tx30, [sp], #0x10\n    101c:\tret\n\nDisassembly of section __TEXT,__stubs:\n\n0000000000001040 <__stubs>:\n    1040:\tadrp\tx16, 0x2000\n    1044:\tldr\tx16, [x16]\n    1048:\tbr\tx16\nstub 0x0000000000001040 _write\n' aarch64-macos _main
refuse a64-unmapped-stub-section '    1010:\tstr\tx30, [sp, #-0x10]!\n    1014:\tbl\t0x1040 <__stubs>\n    1018:\tldr\tx30, [sp], #0x10\n    101c:\tret\n\nDisassembly of section __TEXT,__stubs:\n\n0000000000001040 <__stubs>:\n    1040:\tadrp\tx16, 0x2000\n    1044:\tldr\tx16, [x16]\n    1048:\tbr\tx16\n' aarch64-macos _main
refuse a64-callee-residual-reread '    1010:\tstp\tx29, x30, [sp, #-0x10]!\n    1014:\tmov\tx29, sp\n    1018:\tbl\t0x1040 <_concrete_body>\n    101c:\tldr\tx0, [sp, #-0x10]\n    1020:\tstr\tx1, [x0, #-0x100]\n    1024:\tldp\tx29, x30, [sp], #0x10\n    1028:\tret\n\n0000000000001040 <_concrete_body>:\n    1040:\tstp\tx29, x30, [sp, #-0x10]!\n    1044:\tldp\tx29, x30, [sp], #0x10\n    1048:\tret\n' aarch64-macos _main
# A read of a byte written on only one path into it.
refuse one-path-write '    1010:\tpush\trbp\n    1011:\tmov\trbp, rsp\n    1014:\tje\t0x101e <main+0xe>\n    1016:\tmov\tqword ptr [rbp - 0x8], rax\n    101e:\tmov\trax, qword ptr [rbp - 0x8]\n    1022:\tpop\trbp\n    1023:\tret\n'
# A read never written (stale bytes of whatever ran before).
refuse unwritten-read '    1010:\tmov\trax, qword ptr [rsp - 0x40]\n    1015:\tret\n'
# A leaf's red-zone store, below the stack pointer, is inside the bound: 8 + 0x30.
redzone=$(ctl_dis redzone <<'D'

0000000000001010 <main>:
    1010:	push	rbp
    1011:	mov	rbp, rsp
    1014:	mov	dword ptr [rbp - 0x30], eax
    1017:	pop	rbp
    1018:	ret
D
)
if [ "$(stack_bound x86_64-linux "$redzone")" = "bound 56" ]; then
  echo "ok   control: a red-zone store is inside the bound"
else
  echo "FAIL control: red-zone bound: $(stack_bound x86_64-linux "$redzone")"
  fail=1
fi
# bound_is NAME ARCH EXPECTED BODY: the analysis of the synthetic function(s) BODY (printf format,
# headers included) gives exactly EXPECTED.
bound_is() {
  local f got
  f=$(ctl_dis "$1" <<<"$(printf "\n$4")")
  got=$(stack_bound "$2" "$f" | cap_out | tr '\n' ' ') || true
  if [ "$got" = "$3 " ]; then echo "ok   control: stack bound of $1"
  else echo "FAIL control: stack bound of $1: ${got:-refused}, expected $3"; fail=1; fi
}
bound_is a64-framed-main-and-leaf aarch64-macos 'bound 32' '0000000000001000 <_main>:\n    1000:\tstp\tx29, x30, [sp, #-0x10]!\n    1004:\tmov\tx29, sp\n    1008:\tbl\t0x1020 <_concrete_body>\n    100c:\tldp\tx29, x30, [sp], #0x10\n    1010:\tret\n\n0000000000001020 <_concrete_body>:\n    1020:\tsub\tsp, sp, #0x10\n    1024:\tstr\tw0, [sp, #0xc]\n    1028:\tadd\tsp, sp, #0x10\n    102c:\tret\n'
bound_is a64-offset-frame-record aarch64-macos 'bound 32' '0000000000001000 <_main>:\n    1000:\tsub\tsp, sp, #0x20\n    1004:\tstp\tx29, x30, [sp, #0x10]\n    1008:\tadd\tx29, sp, #0x10\n    100c:\tstur\twzr, [x29, #-0x4]\n    1010:\tldp\tx29, x30, [sp, #0x10]\n    1014:\tadd\tsp, sp, #0x20\n    1018:\tret\n'
# A load PC-relative through adrp + add is not a stack access.
bound_is a64-pc-relative-load aarch64-macos 'bound 0' '0000000000001000 <_main>:\n    1000:\tadrp\tx8, 0x2000 <_main+0x1000>\n    1004:\tadd\tx8, x8, #0x10\n    1008:\tldr\tw0, [x8, #0x4]\n    100c:\tret\n'
# LCB's frame: the link register saved and restored by a single str/ldr; a Mach-O stub entry named
# by the indirect symbol table (a `stub` line); a call made in a loop (the link register meets).
bound_is a64-single-lr-save-and-stub aarch64-macos 'bound 48 external write 48' '0000000000001000 <_main>:\n    1000:\tsub\tsp, sp, #0x30\n    1004:\tstr\tx30, [sp, #0x20]\n    1008:\tmov\tw0, #0x2\n    100c:\tbl\t0x1040 <_write+0x1040>\n    1010:\tcbnz\tw0, 0x1008 <_main+0x8>\n    1014:\tldr\tx30, [sp, #0x20]\n    1018:\tadd\tsp, sp, #0x30\n    101c:\tret\n\nDisassembly of section __TEXT,__stubs:\n\n0000000000001040 <__stubs>:\n    1040:\tadrp\tx16, 0x2000\n    1044:\tldr\tx16, [x16]\n    1048:\tbr\tx16\nstub 0x0000000000001040 _write\n'
# A read of bytes the function wrote on both paths into it is accepted.
bound_is both-path-write x86_64-linux 'bound 16' '0000000000001010 <main>:\n    1010:\tpush\trbp\n    1011:\tmov\trbp, rsp\n    1014:\tje\t0x101c <main+0xc>\n    1016:\tmov\tqword ptr [rbp - 0x8], rax\n    101a:\tjmp\t0x1020 <main+0x10>\n    101c:\tmov\tqword ptr [rbp - 0x8], rcx\n    1020:\tmov\trax, qword ptr [rbp - 0x8]\n    1024:\tpop\trbp\n    1025:\tret\n'
if [ -n "$measuring" ]; then
  # A run that does not end as expected gives no measurement.
  wrong=$(( ($(head -c 16 "$(dirname "$last_exe")/status") + 1) % 256 ))
  if grep -q '^measured' <<<"$(measure "$last_exe" "$last_analysis" "$wrong")"; then
    echo "FAIL control: a run with an unexpected exit status is measured"; fail=1
  else
    echo "ok   control: a run with an unexpected exit status gives no measurement"
  fi
fi
if within 73 72; then echo "FAIL control: a measurement above the bound is accepted"; fail=1
else echo "ok   control: a measurement above the bound is rejected"; fi

# The red zone (stack_bound.py TARGETS: 128 bytes on x86-64 System V and Apple arm64, none under
# AAPCS64 on Linux): a store at its edge is in the bound, one past it is refused.
refuse x86-beyond-red-zone '    1010:\tmov\tqword ptr [rsp - 0x88], 0x0\n    101c:\tret\n'
bound_is x86-red-zone-edge x86_64-linux 'bound 128' '0000000000001010 <main>:\n    1010:\tmov\tqword ptr [rsp - 0x80], 0x0\n    1019:\tret\n'
refuse a64-beyond-red-zone '    1010:\tstur\txzr, [sp, #-0x88]\n    1014:\tret\n' aarch64-macos _main
bound_is a64-red-zone-edge aarch64-macos 'bound 128' '0000000000001010 <_main>:\n    1010:\tstur\txzr, [sp, #-0x80]\n    1014:\tret\n'
refuse a64-linux-no-red-zone '    1010:\tstur\txzr, [sp, #-0x8]\n    1014:\tret\n' aarch64-linux main
if [ -n "$measuring" ]; then
  # The run check counts the bytes an instruction addresses below the stack pointer, not only the
  # stack pointer: a main that stores at the red zone's edge without moving the stack pointer
  # (built like the examples, slice0_native.sh control) is measured at 128 bytes, not 0. With a
  # smaller red zone the same run is an error, not a measurement. On AArch64 it first allocates and
  # frees a 144-byte frame with a pre-indexed store (judged against the new stack pointer, so not
  # beyond the red zone), so the expected depth there is 144.
  rz="$work/ctl/redzone"; mkdir -p "$rz"
  case "$target" in
    x86_64-linux) rzdepth=128; printf '\t.intel_syntax noprefix\n\t.text\n\t.globl\tmain\n\t.type\tmain,@function\nmain:\n\tmov\tqword ptr [rsp - 0x80], 0\n\tmov\teax, 7\n\tret\n\t.size\tmain, .-main\n\t.section\t.note.GNU-stack,"",@progbits\n' ;;
    aarch64-macos) rzdepth=144; printf '\t.text\n\t.globl\t_main\n\t.p2align\t2\n_main:\n\tstp\tx29, x30, [sp, #-0x90]!\n\tldp\tx29, x30, [sp], #0x90\n\tstur\txzr, [sp, #-0x80]\n\tmov\tw0, #7\n\tret\n' ;;
  esac >"$rz/control.s"
  if ! bounded "$native_secs" bash "$root/scripts/checks/lib/slice0_native.sh" control "$rz" >"$rz/build.log" 2>&1; then
    echo "FAIL control: the red-zone executable does not build: $(head -c 1000 "$rz/build.log")"; fail=1
  else
    "${objdump[@]}" "$rz/control.exe" >"$rz/control.exe.dis"
    rza=$(stack_bound "$target" "$rz/control.exe.dis" --ranges | cap_out) || true
    rzm=$(measure "$rz/control.exe" "$rza" 7)
    if [ "$(awk '$1 == "bound" {print $2}' <<<"$rza")" = "$rzdepth" ] && [ "$rzm" = "measured $rzdepth" ]; then
      echo "ok   control: a red-zone store is measured (bound $rzdepth, measured $rzdepth)"
    else
      echo "FAIL control: red-zone run: analysis ${rza:-none}; run ${rzm:-none} $(head -c 300 "$rz/control.exe.gdb.err")"; fail=1
    fi
    rzm=$(measure "$rz/control.exe" "$(sed 's/^redzone .*/redzone 120/' <<<"$rza")" 7)
    if grep -q '^error .*beyond the 120-byte red zone' <<<"$rzm"; then
      echo "ok   control: a run beyond the red zone gives no measurement"
    else
      echo "FAIL control: a run beyond the red zone: ${rzm:-none}"; fail=1
    fi
  fi
fi

[ "$examples" -gt 0 ] || { echo "slice0_artifacts: no examples ran" >&2; exit 1; }
echo "slice0_artifacts: $examples examples; sizes in $sizes, compile times in $times, stack bounds in $stack"
column -t -s "$(printf '\t')" "$sizes" 2>/dev/null || cat "$sizes"
column -t -s "$(printf '\t')" "$times" 2>/dev/null || cat "$times"
exit "$fail"
#!/usr/bin/env bash
# Slice-0 backend gate (PROVISIONAL, Concrete/README.md gates 4 and 6, hand-written BIR leg):
# every hand-written BIR example goes through the LLVM path (clang) and the LCB path: the adapted
# body assembled by LCB in process (no text on the proved path), linked with the runtime entry,
# which LCB's command line assembles from QBE text.
# Each executable runs under bounded_run; its observation is its exit status (or "incomplete"),
# the exact bytes on descriptor 2, and descriptor 1, which must be empty. All three must equal what
# the BIR semantics gives (the emitter writes the expected status and stderr bytes).
#
# Controls: a body that never returns must be observed as incomplete on both backends; a body
# returning a word that encodes nothing must reach the runtime's refusal; and the comparison
# itself must reject a missing or extra newline, a wrong status with the right stderr, and stray
# stdout. Run inside the nix devshell, from the repository root.
set -euo pipefail
# shellcheck source=scripts/checks/lib/slice0_common.sh
source scripts/checks/lib/slice0_common.sh

fail=0
count=0
examples=0
# check NAME DIR SECS RETRY: build both backends in DIR, run them and judge them.
check() {
  local name=$1 d=$2 backend
  build "$name" "$d/build.log" bounded "$native_secs" bash "$root/scripts/checks/lib/slice0_native.sh" "$d" "$lcb"
  for backend in llvm lcb; do
    observe "$d/$backend.exe" "$d/$backend" "$3" "$4"
    count=$((count + 1))
    if judge "$d" "$d/$backend"; then
      echo "ok   $name [$backend]: status $(cat "$d/$backend.status")"
    else
      echo "FAIL $name [$backend]: status $(cat "$d/$backend.status") (expected $(cat "$d/status"))," \
        "stderr $(od -An -c "$d/$backend.stderr" | tr -s ' ' | head -c 300)," \
        "stdout $(wc -c <"$d/$backend.stdout") bytes"
      fail=1
    fi
  done
}

names=$(emit_examples)
for name in $names; do
  d="$work/ex/$name"
  "${emitter[@]}" emit "$name" "$d" "$target"
  check "$name" "$d" 10 20
  examples=$((examples + 1))
done
"${emitter[@]}" loop "$work/ctl/loop" "$target"
expected_timeout check control-loop "$work/ctl/loop" 1 1
"${emitter[@]}" invalid "$work/ctl/invalid" "$target"
check control-invalid-word "$work/ctl/invalid" 10 20

# The comparison's own negative controls: each forged observation must be rejected.
e="$work/ctl/judge"; mkdir -p "$e"
echo 134 >"$e/status"; printf 'concrete: trap: x\n' >"$e/stderr"
forge() { # forge NAME STATUS STDERR-PRINTF STDOUT
  local o="$work/ctl/forged-$1"
  echo "$2" >"$o.status"; printf "$3" >"$o.stderr"; printf '%s' "$4" >"$o.stdout"
  echo "$o"
}
judge "$e" "$(forge same 134 'concrete: trap: x\n' '')" || { echo "FAIL judge rejects an exact match"; fail=1; }
for c in "no-newline|134|concrete: trap: x|" "extra-newline|134|concrete: trap: x\n\n|" \
         "wrong-status|1|concrete: trap: x\n|" "stray-stdout|134|concrete: trap: x\n|42" \
         "incomplete|incomplete||"; do
  IFS='|' read -r n s err out <<<"$c"
  if judge "$e" "$(forge "$n" "$s" "$err" "$out")"; then
    echo "FAIL judge accepts a forged observation: $n"; fail=1
  else
    echo "ok   judge rejects $n"
  fi
done

[ "$examples" -gt 0 ] || { echo "slice0_backends: no examples ran" >&2; exit 1; }
echo "slice0_backends: $examples examples, $count backend runs (controls included)"
exit "$fail"

exec
/bin/bash -lc 'cat Concrete/Premises.lean; cat scripts/checks/lib/repro_compare.py; cat scripts/checks/compiler/slice0_repro.sh; cat scripts/checks/compiler/build_identity.sh' in /tmp/claude-30035/-home-unbalancedparen-projects-concrete2/e2c54e65-31b5-4145-8101-c2d7b071b97e/scratchpad/retro-slice0/src
 succeeded in 0ms:
/-
The slice-0 trusted base (PROVISIONAL): the open premises and the headline theorems whose axiom
closure the trusted-base golden records (Concrete/README.md gate 9).

This is the premise REGISTRY, the one list of the open premises: each entry has its trust class,
what retires it, and its statement. The statements are text until the structures that state them
as Lean propositions (`FrontendPremises`, `NativePremises`, whose design is in Concrete/README.md)
land with the front end; each entry then names its field instead. `scripts/checks/compiler/slice0_trusted_base.sh` prints
this registry and the axioms of `theorems` and compares them with `tests/golden/slice0_trusted_base.txt`,
so a premise added, removed or reworded fails until the golden is updated with it.
-/
import Lean.Meta.Basic
import Lean.PrettyPrinter
import Lean.Util.CollectAxioms
import Concrete.BIR.Progress
import Concrete.Backend.LCB

namespace Concrete.Premises

inductive Trust where
  | implementation | toolchain | environment
  deriving Repr, DecidableEq

def Trust.name : Trust → String
  | .implementation => "implementation"
  | .toolchain => "toolchain"
  | .environment => "environment"

structure Premise where
  id : String
  trust : Trust
  retiredBy : String
  statement : String

/-- The open premises for slice 0, in the README's order. -/
def all : List Premise := [
  ⟨"P_lex", .implementation, "`lex_correct`",
    "every token list the lexer returns for a source is one the source lexes to"⟩,
  ⟨"P_parse", .implementation, "the generic table-parser theorem",
    "every tree the parser returns for a token list is one the grammar derives from it"⟩,
  ⟨"P_print", .implementation, "an LLVM-IR semantics; not planned for slice 0",
    "the printed LLVM text of a WF BIR means at most the BIR behaviour, encoded"⟩,
  ⟨"P_toolchain[llvm]", .toolchain, "not planned",
    "every result the linked LLVM body produces is one its text means"⟩,
  ⟨"P_toolchain[lcb]", .toolchain, "LCB's own proofs (C01–C03 and beyond)",
    "every result the linked LCB body produces is one its function means (LCB's named trust boundaries)"⟩,
  ⟨"P_rt", .implementation, "a proof of the decoding entry against a libc model; not planned for slice 0",
    "every launch of an image built from a WF BIR that is not killed has the behaviour of some result its body produces (decode w for a returned word w, diverges for divergence)"⟩,
  ⟨"P_trap_site", .implementation, "the same runtime-entry proof (owner, 2026-11-06: a premise now)",
    "a launch whose body returns 256 + i writes exactly trapLine tbl[i] and a newline on fd 2"⟩,
  ⟨"P_launch", .environment, "not planned",
    "an admitted launch of a WF image within the frame bound is never killed, and fd 2 accepts the trap line"⟩,
  ⟨"P_live", .environment, "not planned",
    "an admitted launch happens and has a behaviour"⟩
]

/-- The headline theorems, whose axioms the golden records. -/
def theorems : List Lean.Name := [
  ``Concrete.BIR.decode_encode,
  ``Concrete.BIR.run_progress,
  ``Concrete.BIR.behaviour_diverges_iff,
  ``Concrete.Backend.LCB.Proof.adapter_correct,
  ``Concrete.Backend.LCB.Proof.emit_correct,
  ``Concrete.Backend.LCB.Proof.artifact_of_emit_error,
  ``Concrete.Backend.LCB.Proof.artifact_correct
]

/-- The premise's row in Concrete/README.md's open-premise table (a generated view). -/
def Premise.tableRow (p : Premise) : String :=
  s!"| {p.id} | {p.trust.name} | {p.retiredBy} |"

def Premise.line (p : Premise) : String :=
  s!"premise {p.id} [{p.trust.name}] retired-by: {p.retiredBy} :: {p.statement}"

open Lean in
/-- The trusted-base report: one line per premise, then for each theorem its sorted axioms, then
    each axiom once with its type (so an axiom restated under the same name changes the report). -/
def report (thms : List Name) : CoreM (List String) := do
  let mut lines := all.map Premise.line
  let mut seen : Array Name := #[]
  for n in thms do
    let axs := (← collectAxioms n).qsort Name.lt
    lines := lines ++ [s!"theorem {n} axioms: {", ".intercalate (axs.map toString).toList}"]
    for a in axs do
      unless seen.contains a do seen := seen.push a
  for a in seen.qsort Name.lt do
    let ty ← Meta.MetaM.run' (PrettyPrinter.ppExpr (← getConstInfo a).type)
    lines := lines ++ [s!"axiom {a} : {toString ty}"]
  return lines

end Concrete.Premises
#!/usr/bin/env python3
"""Compare the stage outputs of two independent slice-0 builds, byte for byte.

usage: repro_compare.py SIDE_A SIDE_B IDENTITY [MANIFEST]

Each SIDE holds `names` (the example inventory) and `out/NAME/STAGE` for every stage. Every file
is read on both sides: a missing file, a differing inventory or one differing byte fails. With
MANIFEST, writes the identity lines followed by one `SHA256  NAME/STAGE` line per artifact.
"""
import hashlib
import sys
from pathlib import Path

STAGES = ['bir.txt', 'llvm.ll', 'lcb_job.txt', 'lcb_source.txt', 'lcb_body.ssa', 'lcb_body.s',
          'lcb_rt.ssa', 'lcb_rt.s', 'llvm.o', 'lcb_body.o', 'lcb_rt.o', 'llvm.exe', 'lcb.exe']


def main(argv):
    if len(argv) not in (4, 5):
        sys.exit(__doc__)
    a, b, identity = Path(argv[1]), Path(argv[2]), Path(argv[3])
    names = (a / 'names').read_bytes()
    if names != (b / 'names').read_bytes():
        sys.exit('FAIL slice0_repro: example inventory differs')
    if not names.strip():
        sys.exit('FAIL slice0_repro: no examples')
    lines = identity.read_text().splitlines()
    for name in names.decode().splitlines():
        for stage in STAGES:
            try:
                hashes = [hashlib.sha256((d / 'out' / name / stage).read_bytes()).hexdigest()
                          for d in (a, b)]
            except FileNotFoundError as e:
                sys.exit(f'FAIL slice0_repro: {name}: {stage}: missing ({e.filename})')
            if hashes[0] != hashes[1]:
                sys.exit(f'FAIL slice0_repro: {name}: {stage}: {hashes[0]} != {hashes[1]}')
            lines.append(f'{hashes[0]}  {name}/{stage}')
        print(f'ok slice0_repro: {name}: all stages byte-identical')
    if len(argv) == 5:
        Path(argv[4]).write_text('\n'.join(lines) + '\n')


if __name__ == '__main__':
    main(sys.argv)
#!/usr/bin/env bash
# Slice-0 reproducibility gate (Concrete/README.md, gate 8). Two independent builds of the compiler
# and of LCB, from two source copies with different paths and TMPDIRs, emit every hand-written BIR
# example and build it natively; every stage is compared byte for byte, with no normalization.
# The two sides share only the pinned Lean toolchain and the dependency SOURCES (each side compiles
# them itself, with no Lake artifact cache). The comparator is checked by negative controls: a flipped byte, a missing artifact
# and a differing inventory must each be refused.
#
#   slice0_repro.sh [MANIFEST]   (inside nix develop, from the repository root)
#
# MANIFEST gets the build identity and one hash per artifact; CI compares the manifests of two
# independent runners of the same target.
set -euo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
cd "$root"
# shellcheck source=scripts/checks/lib/limits.sh
source scripts/checks/lib/limits.sh
# shellcheck source=scripts/checks/lib/slice0_sources.sh
source scripts/checks/lib/slice0_sources.sh
gate_limits 64 40000
work=$(mktemp -d)
# On every exit, the bounded-run summary (recovered and INCOMPLETE runs) goes to stdout before the
# scratch directory is removed, and a gate that would pass with an INCOMPLETE run exits 3 instead.
trap 'rc=$?; bounded_summary || true
  if [ "$rc" = 0 ] && grep -Eqs "^(incomplete|runner-failed)" "${BOUNDED_LOG:-/nonexistent}"; then
    echo "INCOMPLETE: a bounded run timed out twice; not a pass"; rc=3
  fi
  rm -rf "${work:?}"; exit "$rc"' EXIT
BOUNDED_PARENT="$work"
# shellcheck source=scripts/checks/lib/bounded.sh
source scripts/checks/lib/bounded.sh
[ "$BOUNDED_HAVE_WATCHDOG" = 1 ] || { echo "slice0_repro: python3 is required for bounded runs" >&2; exit 2; }
# bounded SECS CMD...: CMD through bounded_run (stdin /dev/null, one re-run on a timeout; a second
# timeout returns 124 with no output and is reported INCOMPLETE, never a pass).
bounded() {
  local secs=$1 rc=0
  shift
  bounded_run -i /dev/null "$secs" -- "$@" || rc=$?
  if [ "$rc" != 0 ] && bounded_is_incomplete "$rc"; then
    echo "slice0_repro: INCOMPLETE (timed out twice): $*" >&2
  fi
  return "$rc"
}
manifest=${1:-}
[ -z "$manifest" ] || manifest=$(realpath -m "$manifest")
compare=(python3 "$root/scripts/checks/lib/repro_compare.py")
# Materialize the dependency checkouts (no build): they must be the manifest's clean revisions,
# which build_identity.sh checks before anything is built.
bounded 600 lake env true
bash scripts/checks/compiler/build_identity.sh > "$work/identity"
target=$(bash scripts/checks/lib/slice0_native.sh target)
# Working source edits are included (the identity records their digest); no build product is.
for side in first second; do
  d="$work/$side/checkout-with-$side-path"
  mkdir -p "$d/.lake/packages" "$work/$side/tmp"
  git ls-files -z -- "${slice0_sources[@]}" |
    tar --null -T - -cf - | tar -xf - -C "$d"
  # Dependency checkouts: tracked files and .git (which Lake checks against the manifest) only.
  for pkg in .lake/packages/*/; do
    pkg=$(basename "$pkg")
    mkdir -p "$d/.lake/packages/$pkg"
    (cd ".lake/packages/$pkg" && { git ls-files -z; printf '.git\0'; } | tar --null -T - -cf -) |
      tar -xf - -C "$d/.lake/packages/$pkg"
  done
  (
    cd "$d"
    export TMPDIR="$work/$side/tmp" LC_ALL=C TZ=UTC SOURCE_DATE_EPOCH=1 ZERO_AR_DATE=1
    # No Lake artifact cache: each side compiles everything it uses.
    export LAKE_ARTIFACT_CACHE=false LAKE_CACHE_DIR="$work/$side/lake-cache"
    bounded 3000 lake build Concrete lean-compiler-backend/lcb >"$work/$side/build.log" 2>&1 ||
      { tail -50 "$work/$side/build.log" >&2; echo "slice0_repro: $side: build failed" >&2; exit 1; }
    lcb="$d/.lake/packages/lean-compiler-backend/.lake/build/bin/lcb"
    bounded 120 lake env lean --run scripts/checks/compiler/slice0_bir.lean list > names
    [ -s names ] || { echo 'slice0_repro: no examples' >&2; exit 1; }
    while read -r name; do
      bounded 120 lake env lean --run scripts/checks/compiler/slice0_bir.lean emit "$name" "$d/out/$name" "$target"
      bounded 120 bash scripts/checks/lib/slice0_native.sh "$d/out/$name" "$lcb"
    done < names
  )
done
a="$work/first/checkout-with-first-path"
b="$work/second/checkout-with-second-path"
"${compare[@]}" "$a" "$b" "$work/identity" ${manifest:+"$manifest"}

# Negative controls: the comparator must refuse each perturbation of an identical pair.
control() { # control LABEL EXPECTED-MESSAGE SETUP...
  local label=$1 expect=$2 c="$work/ctl/$1" rc=0; shift 2
  mkdir -p "$c"
  cp -R "$a" "$c/a"; cp -R "$a" "$c/b"
  (cd "$c/b" && "$@")
  "${compare[@]}" "$c/a" "$c/b" "$work/identity" >"$c/log" 2>&1 || rc=$?
  if [ "$rc" = 0 ] || ! grep -qF -- "$expect" "$c/log"; then
    echo "FAIL slice0_repro control $label: not refused as '$expect'" >&2; cat "$c/log" >&2; exit 1
  fi
  echo "ok slice0_repro control $label: refused"
}
first=$(head -1 "$a/names")
flip() { python3 -c 'import sys;p=sys.argv[1];d=bytearray(open(p,"rb").read());d[len(d)//2]^=1;open(p,"wb").write(d)' "$1"; }
control flipped-byte "$first: lcb.exe:" flip "out/$first/lcb.exe"
control missing-artifact "$first: lcb_rt.o: missing" rm "out/$first/lcb_rt.o"
control inventory 'example inventory differs' sh -c 'echo extra >> names'
echo 'PASS slice0_repro'
#!/usr/bin/env bash
# Canonical build identity, with no timestamps, hostnames or checkout paths.
# The compiler sources are identified by commit AND by a digest of the working-tree content of
# every tracked input (lib/slice0_sources.sh), with `source_tree=dirty` when they differ from the
# commit, so a local edit never reports a committed identity. Every dependency checkout must be
# at the revision lake-manifest.json pins with no modified or untracked file (its ignored `.lake`
# build directory aside); otherwise this script fails. slice0_repro.sh copies only a dependency's
# tracked files and its `.git`, so ignored files never reach the compared builds.
set -euo pipefail
cd "$(dirname "$0")/../../.."
: "${CONCRETE_SLICE0_CLANG:?run inside nix develop}"
# shellcheck source=scripts/checks/lib/slice0_sources.sh
source scripts/checks/lib/slice0_sources.sh
printf 'compiler_commit=%s\n' "$(git rev-parse HEAD)"
if [ -z "$(git status --porcelain --untracked-files=no -- "${slice0_sources[@]}")" ]; then
  echo 'source_tree=clean'
else
  echo 'source_tree=dirty'
fi
git ls-files -z -- "${slice0_sources[@]}" | python3 -c '
import hashlib,sys
paths=sorted(p for p in sys.stdin.buffer.read().split(b"\0") if p)
h=hashlib.sha256()
for p in paths:
    h.update(hashlib.sha256(open(p,"rb").read()).hexdigest().encode()+b"  "+p+b"\n")
print("source_sha256="+h.hexdigest())'
printf 'target=%s\n' "$(bash scripts/checks/lib/slice0_native.sh target)"
printf 'lean_pin=%s\n' "$(cat lean-toolchain)"
printf 'lean_version=%s\n' "$(lean --version)"
printf 'clang_version=%s\n' "$("$CONCRETE_SLICE0_CLANG" --version | head -1)"
