    head=git('rev-parse','HEAD').strip()
    if head != p['rev'] or git('status','--porcelain','--untracked-files=all').strip():
        sys.exit(f"build_identity: {name}: checkout {head} is not the clean pinned {p['rev']}")
    print(name+'_rev='+p['rev'])
