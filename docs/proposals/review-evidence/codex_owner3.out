+      { echo "gate_limits: an unlimited address space is required, the hard limit is $(ulimit -H -v) KiB" >&2; exit 2; }
   fi
   cur=$(ulimit -u)
   if [ "$cur" = unlimited ] || [ "$cur" -gt "$nproc" ]; then ulimit -u "$nproc"; fi
