+# Per-command time bounds are separate: bounded_run (lib/bounded.sh).
 gate_limits() {
   local mem_kb=$(($1 * 1024 * 1024)) nproc=$2 cur
   if [ "$(uname -s)" = Linux ] && [ "$mem_kb" -gt 0 ]; then
     cur=$(ulimit -v)
     if [ "$cur" = unlimited ] || [ "$cur" -gt "$mem_kb" ]; then ulimit -v "$mem_kb"; fi
