e2e
RIATT="$(cd "$RI" && git rev-parse --git-path concrete-prepush-remote-record)"; case "$RIATT" in /*) ;; *) RIATT="$RI/$RIATT" ;; esac
[ "$rc" = 0 ] && has "$out" "sha=$RIH clone=" && has "$out" "stub gates passed" && grep -qx "head=$RIH" "$RIATT" 2>/dev/null \
  && ok "the real transport runs the head on the host and the pass is attested" || { no "e2e transport: exit $rc"; echo "$out" | sed 's/^/      /'; }
[ ! -e "$TMP/PWNED" ] && [ ! -e "$TMP/PWNED2" ] && ! grep -qz '^CONCRETE_Y' "$TMP/remote.env" && grep -qz '^CONCRETE_TEST_LIB=' "$TMP/remote.env" \
  && ok "a forwarded value with newlines, \$( ) and quotes runs nothing on the host" || no "forwarded env executed on the host"
python3 -I -c 'import sys; sys.exit(0 if ("CONCRETE_INJ=" + sys.argv[2]).encode() in open(sys.argv[1], "rb").read().split(b"\0") else 1)' "$TMP/remote.env" "$INJ" && ok "the forwarded value arrives byte for byte" || no "forwarded value altered"
! grep -qz '^CONCRETE_SKIP_GATES=' "$TMP/remote.env" && ok "the host's own CONCRETE_SKIP_GATES is cleared before the hook" || no "host-side bypass reached the hook"
[ -z "$(ls -A "$HH" | grep -v '^concrete2$\|^runs$')" ] && ok "the host keeps no bundle or script after the run" || no "host leftovers: $(ls -A "$HH")"
printf 'scripts/g2.sh\n' > "$TMP/ri.changed"; printf 'bash scripts/g.sh\n' > "$TMP/ri.plan"
dec="$( cd "$RI" && export CONCRETE_TEST_OUT="$TMP" CONCRETE_TEST_LIB="$ROOT_DIR/scripts/checks/lib/prepush_record.sh" CONCRETE_INJ="$INJ" \
  && source "$ROOT_DIR/scripts/checks/lib/prepush_record.sh" && ppr_remote_components "$RI" "$RIH" "$TMP/ri.changed" "$TMP/ri.plan" "$TMP/ri.comp" \
  && ppr_remote_check "$RI" "$TMP/ri.comp" && echo REUSE || echo "refused:$PPR_REASON" )"
[ "$dec" = REUSE ] && ok "the push's hook reuses the record the host's run produced" || no "e2e reuse: $dec"
dec="$( cd "$RI" && source "$ROOT_DIR/scripts/checks/lib/prepush_record.sh" && ppr_remote_components "$RI" "$RIH" "$TMP/ri.changed" "$TMP/ri.plan" "$TMP/ri.comp" \
  && ppr_remote_check "$RI" "$TMP/ri.comp" && echo REUSE || echo "refused:$PPR_REASON" )"
has "$dec" "refused:changed:env" && ok "a push in another CONCRETE_* environment than the host's run does not reuse it" || no "e2e env mismatch: $dec"
# A git shim on the "host" logs every fetch: the stale gate clone must log none.
mkdir -p "$TMP/hostgit"
printf '#!/bin/sh\nfor a in "$@"; do case "$a" in fetch|ls-remote) echo "$*" >> "%s"; break ;; esac; done\nexec "%s" "$@"\n' "$TMP/hostgit.log" "$(command -v git)" > "$TMP/hostgit/git"
chmod +x "$TMP/hostgit/git"; : > "$TMP/hostgit.log"
git -C "$HH/concrete2" remote set-url origin https://github.com/unbalancedparentheses/concrete2.git
PATH="$TMP/hostgit:$PATH" e2e
git -C "$HH/concrete2" remote set-url origin "$TMP/ri-origin.git"
[ "$rc" = 3 ] && has "$out" "INCOMPLETE" && has "$out" "the gate clone" && has "$out" "points at another repository" \
  && ! grep -q "$HH/concrete2" "$TMP/hostgit.log" \
  && ok "a gate clone whose origin is the archived repository is refused on the host before it fetches (INCOMPLETE)" || { no "stale gate clone: exit $rc"; echo "$out" | sed 's/^/      /'; }
touch "$HH/unreachable"; e2e; rm -f "$HH/unreachable"
[ "$rc" = 3 ] && has "$out" "INCOMPLETE" && [ ! -f "$RIATT" ] && ok "the real transport to an unreachable host is INCOMPLETE (exit 3), attests nothing" || { no "e2e unreachable: exit $rc"; echo "$out" | sed 's/^/      /'; }
hook="$ROOT_DIR/.githooks/pre-push"
# The root hook has no gate selection: every push that can reach main or ci/* builds the spec and
# runs the whole root set (scripts/checks/run.sh), so there is no per-push selection for a remote
# attestation to stand in for. It must therefore never consult one, and must run the full set.
#!/usr/bin/env bash
# Install the landing bot for user `dev` on the gate host. It does NOT enable the bot: it prints the
# enable command, because turning it on is the maintainers' decision.
#
#   install-bot.sh [--ssh dev@62.210.216.169] [--source-ref origin/main] [--clone ~/concrete-bot]
#
# --ssh runs this script on that host (key: CONCRETE_REMOTE_KEY, default ~/.ssh/concrete_ci).
# On the host it:
#   1. makes a DEDICATED clone (default ~/concrete-bot): the bot checks out trains there, so no human
#      or agent may work in it. Remote: origin = lambdaclass/concrete (the one repository since
#      2026-11-06; an existing clone is repointed); core.hooksPath=.githooks.
#   2. writes ~/.local/libexec/concrete-landing-bot, which fetches, extracts scripts/land from
#      <source-ref> into an immutable snapshot (keyed by commit) and runs the bot from there, so a
#      train checkout never rewrites the running script. Full gates run locally through
#      scripts/land/run-at-ref.sh, fetching the train SHA from the bot's clone.
#   3. writes ~/.config/concrete-landing-bot.env (kept if it exists) and the user units
#      concrete-landing-bot.{service,timer} from <source-ref>, then reloads systemd. Nothing is enabled.
set -euo pipefail
if [ "${1:-}" = --ssh ]; then
  host="${2:?--ssh needs user@host}"; shift 2
  exec ssh -i "${CONCRETE_REMOTE_KEY:-$HOME/.ssh/concrete_ci}" -o StrictHostKeyChecking=accept-new "$host" \
    bash -s -- "$@" < "$0"
fi
REF="origin/main"; CLONE="$HOME/concrete-bot"
while [ $# -gt 0 ]; do
  case "$1" in
    --source-ref) REF="$2"; shift ;;
    --clone) CLONE="$2"; shift ;;
    *) echo "install-bot: unknown argument $1" >&2; exit 2 ;;
  esac; shift
done
say() { echo "install-bot: $*"; }
# URLs on one line, with a scheme URL's userinfo (https://user:TOKEN@host) replaced by *** (as
# land_url_redact in lib.sh, which this script, run over ssh as a single file, cannot source).
redact() { sed -E 's#^([A-Za-z][A-Za-z0-9+.-]*://)[^/]*@#\1***@#' | tr '\n' ' '; }   # through the authority's last @
[ "$(id -un)" = dev ] || say "WARNING: running as $(id -un), not dev"
ORIGIN_URL="${INSTALL_ORIGIN_URL:-git@github.com:lambdaclass/concrete.git}"

# 1. the dedicated clone
if [ ! -d "$CLONE/.git" ]; then
  say "cloning $(echo "$ORIGIN_URL" | redact)into $CLONE"
  git clone -q "$ORIGIN_URL" "$CLONE"
fi
cd "$CLONE"
if [ "$(git config --get-all remote.origin.url)" != "$ORIGIN_URL" ]; then
  say "repointing origin from $(git config --get-all remote.origin.url | redact) to $(echo "$ORIGIN_URL" | redact)"
  git config --replace-all remote.origin.url "$ORIGIN_URL"
fi
# A push URL would send pushes somewhere other than the fetch URL (train.sh refuses one that names
# another repository); the bot pushes where it fetches, so it keeps none.
if git config --get-all remote.origin.pushurl >/dev/null 2>&1; then
  say "removing origin's push URL(s): $(git config --get-all remote.origin.pushurl | redact)"
  git config --unset-all remote.origin.pushurl
fi
if git remote get-url lambdaclass >/dev/null 2>&1; then say "removing the old mirror remote 'lambdaclass' (origin is that repository now)"; git remote remove lambdaclass; fi
if git remote get-url fork >/dev/null 2>&1; then say "the clone has a remote named 'fork'; the bot refuses it, removing it"; git remote remove fork; fi
git config core.hooksPath .githooks
git config user.name >/dev/null || git config user.name "Concrete landing bot"
git config user.email >/dev/null || git config user.email "landing-bot@concrete-ci-1.invalid"
git fetch -q origin
git rev-parse --verify -q "$REF:scripts/land/bot.sh" >/dev/null \
  || { say "$REF has no scripts/land/bot.sh; pass --source-ref origin/wip/landing-bot until it lands"; exit 1; }
SHA="$(git rev-parse "$REF^{commit}")"

# 2. the launcher
mkdir -p "$HOME/.local/libexec" "$HOME/.local/state/concrete-landing-bot" "$HOME/.config/systemd/user"
# The launcher fetches before it runs the snapshot's bot.sh, so it checks the remote itself first,
# with the lib.sh of the installed commit (the one-repository guard, land_remote_bad).
git show "$SHA:scripts/land/lib.sh" > "$HOME/.local/libexec/concrete-landing-bot.lib.sh"
cat > "$HOME/.local/libexec/concrete-landing-bot" <<EOF
#!/usr/bin/env bash
# Generated by scripts/land/install-bot.sh. Runs scripts/land/bot.sh from an immutable snapshot of
# \$BOT_SOURCE_REF, in the dedicated clone $CLONE.
set -euo pipefail
cd "$CLONE"
. "$HOME/.local/libexec/concrete-landing-bot.lib.sh"
if ! why="\$(land_remote_bad origin "\${LAND_REPO:-\$LAND_CANONICAL_REPO}")"; then
  echo "concrete-landing-bot: refusing to fetch: \$why" >&2; exit 1
fi
git fetch -q origin
sha="\$(git rev-parse --verify "\${BOT_SOURCE_REF:-$REF}^{commit}")"
snaps="\$HOME/.local/state/concrete-landing-bot/snap"
snap="\$snaps/\$sha"
if [ ! -f "\$snap/scripts/land/bot.sh" ]; then
  rm -rf "\$snap.tmp"; mkdir -p "\$snap.tmp"
  git archive "\$sha" scripts/land scripts/checks/lib/git_sandbox.sh | tar -x -C "\$snap.tmp"
  mv "\$snap.tmp" "\$snap"
  ls -1t "\$snaps" | tail -n +6 | while read -r old; do rm -rf "\${snaps:?}/\$old"; done
fi
export LAND_REMOTE_RUNNER="\${LAND_REMOTE_RUNNER-\$snap/scripts/land/run-at-ref.sh}"
export RUN_AT_REF_SOURCE="\${RUN_AT_REF_SOURCE:-$CLONE}"
export LAND_REMOTE_PUSH="\${LAND_REMOTE_PUSH:-0}"
exec bash "\$snap/scripts/land/bot.sh" "\$@"
EOF
chmod 755 "$HOME/.local/libexec/concrete-landing-bot"

# 3. environment and units
ENVF="$HOME/.config/concrete-landing-bot.env"
if [ ! -f "$ENVF" ]; then
  cat > "$ENVF" <<EOF
# Landing bot environment (systemd EnvironmentFile; plain KEY=value lines).
BOT_SOURCE_REF=$REF
PATH=$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/usr/local/bin:/usr/bin:/bin
LAND_REPO=lambdaclass/concrete
BOT_WATCH_INTERVAL=60
BOT_MAX_TRAINS=4
EOF
  say "wrote $ENVF"
else
  say "kept the existing $ENVF"
  # An older install set LAND_REPO=unbalancedparentheses/concrete2; train.sh and the bot refuse a
  # LAND_REPO that is not the one repository, so the installer migrates the line rather than warn.
  if grep -q '^LAND_REPO=' "$ENVF" && ! grep -qx 'LAND_REPO=lambdaclass/concrete' "$ENVF"; then
    say "migrating $ENVF: $(grep '^LAND_REPO=' "$ENVF" | tr '\n' ' ') -> LAND_REPO=lambdaclass/concrete"
    sed 's|^LAND_REPO=.*|LAND_REPO=lambdaclass/concrete|' "$ENVF" > "$ENVF.new" && mv "$ENVF.new" "$ENVF"
  fi
fi
for u in concrete-landing-bot.service concrete-landing-bot.timer; do
  git show "$SHA:scripts/land/systemd/$u" > "$HOME/.config/systemd/user/$u"
done
systemctl --user daemon-reload 2>/dev/null || say "systemctl --user daemon-reload failed (no user manager in this session); the enable command below reloads"

# Prerequisites the bot needs and this script does not create.
gh auth status >/dev/null 2>&1 && say "gh: authenticated" || say "MISSING: gh is not authenticated for $(id -un) (gh auth login); the bot dispatches and reads CI"
# ssh -T exits 1 even when it authenticates, so read its words, not its status.
gh_ssh="$(ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -T git@github.com 2>&1 || true)"
case "$gh_ssh" in
  *"successfully authenticated"*) say "github ssh: authenticated (it still needs WRITE access to lambdaclass/concrete)" ;;
  *) say "MISSING: no GitHub SSH identity for $(id -un); the bot pushes main, ci/* and notes to origin" ;;
esac

say "installed at $SHA ($REF); NOT enabled. To turn it on:"
echo "    sudo loginctl enable-linger dev        # once, as ubuntu: user timers run without a login"
echo "    systemctl --user daemon-reload && systemctl --user enable --now concrete-landing-bot.timer   # as dev"
echo "  pause: touch ~/.concrete-bot-paused   status: ~/.local/libexec/concrete-landing-bot status"
echo "  log:   ~/.local/state/concrete-landing-bot.log"

exec
/bin/bash -lc "cat scripts/checks/lib/gate_env.sh; sed -n '/diff --git a\\/scripts\\/land\\/gates_transport/,/diff --git a\\/scripts\\/land\\/lib.sh/p' REVIEW.diff; sed -n '/diff --git a\\/scripts\\/land\\/train.sh/,/diff --git a\\/scripts\\/push-both/p' REVIEW.diff" in /tmp/claude-30035/-home-unbalancedparen-projects-concrete2/e2c54e65-31b5-4145-8101-c2d7b071b97e/scratchpad/cx-final4/repo
 succeeded in 0ms:
#!/usr/bin/env bash
# The gate environment guard. Every gate sources this first:
#
#   source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
#
# Gates run in three places: the dev shell, Linux CI runners and the macOS CI runner. When each took
# coreutils, sed, grep, python and the rest from whatever host it landed on, a gate could pass on one
# and fail on another for reasons unrelated to what it tests: macOS has no `timeout`, and BSD `sed -i`,
# `stat`, `date` and `readlink` take other flags. flake.nix now defines that userland once (the
# `gates` shell), CI runs every step inside it, and the dev shells include it. Each of those shells
# exports CONCRETE_GATES_SHELL=1; a gate started anywhere else refuses here, before it can produce a
# verdict about the wrong environment.
#
# Use `nix develop .#gates` (no Lean; what CI uses, with elan's Lean on PATH) or `nix develop` (the
# dev shell, with its own Lean). An entry point that must start outside both, like the pre-push
# hook, re-executes itself inside `nix develop` before it runs a gate.
#
# check_gate_hygiene.sh proves every gate sources this file.

if [ "${CONCRETE_GATES_SHELL:-}" != 1 ]; then
  echo "error: ${0##*/} refuses to run outside the gate shell: run inside nix develop .#gates (CI) or nix develop" >&2
  exit 2
fi

# Every gate matches text with has_match, never a pipe into grep -q (bug 283).
source "$(dirname "${BASH_SOURCE[0]}")/has_match.sh" || exit 2
