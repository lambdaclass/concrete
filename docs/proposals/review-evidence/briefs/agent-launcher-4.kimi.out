 capture 10 bash "$LAUNCH" status "$JOBDIR"
 expect_rc 3 "status also returns exit 3"
 expect_out "JOB $UNIT ENDED status=3" "status of exit 3 is one line"
 
+echo "=== failure to record status makes the job itself fail ==="
