#!/usr/bin/env bash
# SANDBOXES NEVER TOUCH THE CALLER'S REPOSITORY (ISS-0015).
#
# A pre-push hook of a linked worktree runs with GIT_DIR=<repo>/.git/worktrees/<name> exported. On
# 2026-11-06 review_tool.sh, run that way, did its sandbox work in the caller's clone and pushed 28 +
# 12 test notes to GitHub. The owner of the fix is the sandbox helper, scripts/checks/lib/
# git_sandbox.sh, which unsets every variable `git rev-parse --local-env-vars` names.
#
# Legs:
#   structural  every script under scripts/ that makes a repository
#               (git init, git clone, git worktree add) sources the helper and calls git_sandbox.
#   live        a throwaway CALLER (bare upstream, full clone, linked worktree; no hook installed
#               anywhere) runs review_tool.sh and legacy_frozen.sh, at this checkout's version, from
#               the linked worktree with GIT_DIR exported exactly as a hook sees it. The caller's
#               refs (refs/notes/* included), core.bare, worktree HEAD and its upstream's refs must be
#               byte-for-byte unchanged.
#   control     the same harness around a script that writes through an inherited GIT_DIR (as the
#               unfixed review_tool.sh did) must report the change, so the live leg cannot pass by
#               not looking.
#
# Every run is bounded in time (120 s per attempt, bounded_run) and in aggregate: a systemd user
# scope with TasksMax=512 and MemoryMax=8G (fede-256gb, concrete-ci-2 logins), or, where there is
# none (a CI runner service), the cgroup the check already runs in when it has a finite memory.max
# (concrete-ci-2's runners: 28G per runner) plus `ulimit -u` of 512 more processes. With neither, the
# live probes do not run and the check fails as INCOMPLETE: never an unbounded run. macOS has
# neither (no unprivileged aggregate memory limit), so there the root checks are INCOMPLETE by design
# and a gated push from a macOS clone is refused: gated pushes (trains) are made from a Linux clone
# with a bound (fede-256gb or concrete-ci-2; no laptop builds), and CI runs on bounded runners. The 2026-11-06
# reproducer had no such bound, recursed through a test hook and exhausted the machine.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR" || exit 2
HELPER="scripts/checks/lib/git_sandbox.sh"
[ -f "$HELPER" ] || { echo "FATAL: $HELPER missing" >&2; exit 2; }
PASS=0; FAIL=0
ok(){ echo "  ok   $1"; PASS=$((PASS+1)); }
no(){ echo "  FAIL $1"; FAIL=$((FAIL+1)); }

echo "=== structural: every repository-making script sources the sandbox helper ==="
# Two exceptions, neither a sandbox: install-bot.sh runs on the gate host as `bash -s <
# install-bot.sh` (no sibling files to source) and makes the bot's persistent clone, and
# worktree-new.sh makes a worktree OF the caller's repository by design.
EXEMPT=" scripts/land/install-bot.sh scripts/worktree-new.sh "
makers=0
for f in scripts/*.sh scripts/*/*.sh; do
  [ "$f" = scripts/checks/sandbox_isolation.sh ] && continue
  grep -qE 'git( -C [^ ]+)? (init|clone)\b|worktree add' "$f" || continue
  case "$EXEMPT" in *" $f "*) continue ;; esac
  makers=$((makers+1))
  # The helper must be sourced and called, as statements, before the first repository is made.
  first_make="$(grep -nE 'git( -C [^ ]+)? (init|clone)\b|worktree add' "$f" | grep -vE '^[0-9]+:[[:space:]]*#' | head -n 1 | cut -d: -f1)"
  src_line="$(grep -nE '^[[:space:]]*(source|\.) .*checks/lib/git_sandbox\.sh' "$f" | head -n 1 | cut -d: -f1)"
  call_line="$(grep -nE '^[[:space:]]*git_sandbox( |$)' "$f" | head -n 1 | cut -d: -f1)"
  if [ -n "$src_line" ] && [ -n "$call_line" ] && [ -n "$first_make" ] \
     && [ "$src_line" -lt "$call_line" ] && [ "$call_line" -lt "$first_make" ]; then
    ok "$f sources git_sandbox.sh (line $src_line) and calls it (line $call_line) before its first repository (line $first_make)"
  else
    no "$f makes a repository (line ${first_make:-?}) without sourcing (line ${src_line:-none}) and calling git_sandbox (line ${call_line:-none}) before it"
  fi
done
[ "$makers" -ge 9 ] && ok "found $makers repository-making scripts (at least the 9 known)" \
  || no "found only $makers repository-making scripts; the scan is not seeing them"

# The harness itself is a sandbox: it must not be steered by whatever environment started it.
source "$HELPER" || exit 2
TMP="$(mktemp -d)" || exit 2
trap 'rm -rf "$TMP"' EXIT
git_sandbox "$TMP/gitconfig" || exit 2
printf '[user]\n\tname = isolation gate\n\temail = isolation@example.invalid\n[init]\n\tdefaultBranch = main\n[advice]\n\tdetachedHead = false\n' > "$GIT_CONFIG_GLOBAL"

BOUNDED_PARENT="$TMP"
source "$ROOT_DIR/scripts/checks/lib/bounded.sh" || exit 2
# bounded <cmd...>: at most 120 s per attempt (the portable bounded_run: its own watchdog kills the
# whole process group; one re-run), inside an aggregate task and memory bound (above). Without one
# the command does not run and the result is 125.
cgroup_memory_max() { # the finite memory.max of this process's cgroup v2 or an ancestor, else fails
  local cg f
  cg="$(sed -n 's/^0:://p' /proc/self/cgroup 2>/dev/null)"; [ -n "$cg" ] || return 1
  while :; do
    f="/sys/fs/cgroup$cg/memory.max"
    if [ -r "$f" ] && [ "$(cat "$f")" != max ]; then cat "$f"; return 0; fi
    [ "$cg" = / ] && return 1
    cg="$(dirname "$cg")"
  done
}
BOUND=none
if command -v systemd-run >/dev/null 2>&1 \
   && systemd-run --user --scope -q -p TasksMax=512 -p MemoryMax=8G true >/dev/null 2>&1; then BOUND=scope
elif CGMEM="$(cgroup_memory_max)"; then BOUND=cgroup; fi
case "$BOUND" in
  scope)  echo "bound: a systemd user scope, TasksMax=512, MemoryMax=8G" ;;
  cgroup) echo "bound: this cgroup's memory.max ($CGMEM bytes, aggregate) and ulimit -u (512 more processes)" ;;
  none)   echo "bound: none available (no systemd user scope, no finite cgroup memory.max; macOS has neither): the live probes will not run; run the root checks and gated pushes from a bounded Linux host (fede-256gb, concrete-ci-2) or in CI" ;;
esac
bounded() {
  case "$BOUND" in
    scope) bounded_run -i /dev/null -r 120 120 -- systemd-run --user --scope -q -p TasksMax=512 -p MemoryMax=8G "$@" ;;
    cgroup)
      local n; n="$(ps -o pid= -U "$(id -u)" 2>/dev/null | wc -l | tr -d ' ')"
      ( ulimit -u $(( ${n:-0} + 512 )) 2>/dev/null || { echo "sandbox_isolation: ulimit -u refused; not running $*"; exit 125; }
        bounded_run -i /dev/null -r 120 120 -- "$@" ) ;;
    *) echo "sandbox_isolation: no aggregate task and memory bound here; not running $*"; return 125 ;;
  esac
}

# A caller: bare upstream, a full clone of this checkout's HEAD, a linked worktree of it, with this
# checkout's scripts/ (the version under test) copied over the worktree's. No hook is installed:
# hooksPath points at an empty directory.
mk_caller() { # dir
  local d="$1"
  mkdir -p "$d/nohooks"
  git clone -q --bare "$ROOT_DIR" "$d/up.git" || return 1
  git clone -q "$d/up.git" "$d/caller" || return 1
  git -C "$d/caller" config core.hooksPath "$d/nohooks"
  git -C "$d/caller" worktree add -q -b isolation-probe "$d/linked" || return 1
  cp -R "$ROOT_DIR/scripts/." "$d/linked/scripts/" || return 1
  git -C "$d/linked" add -A scripts && git -C "$d/linked" commit -q --allow-empty -m "scripts under test" || return 1
}
snap() { # dir
  local d="$1"
  git -C "$d/caller" for-each-ref --format='caller %(refname) %(objectname)'
  echo "caller core.bare=$(git -C "$d/caller" config core.bare)"
  echo "linked HEAD=$(git -C "$d/linked" rev-parse HEAD) $(git -C "$d/linked" symbolic-ref -q HEAD)"
  git -C "$d/caller" worktree list --porcelain | grep '^worktree '
  git -C "$d/up.git" for-each-ref --format='upstream %(refname) %(objectname)'
}
# run_as_hook <dir> <script relative to the linked worktree>: GIT_DIR exported as a linked
# worktree's hook sees it; prints the script's exit code.
run_as_hook() {
  local d="$1" s="$2" gd
  gd="$(git -C "$d/linked" rev-parse --absolute-git-dir)"
  ( cd "$d/linked" && GIT_DIR="$gd" && export GIT_DIR && bounded bash "$s" ) > "$d/run.log" 2>&1
  echo $?
}
probe() { # label script expect-change [completion-marker]
  local label="$1" s="$2" want="$3" marker="${4:-}" d rc
  d="$(mktemp -d "$TMP/caller.XXXXXX")"
  mk_caller "$d" || { no "$label: could not build the caller"; return; }
  [ -z "$(ls "$d/nohooks")" ] || { no "$label: a hook is installed"; return; }
  snap "$d" | LC_ALL=C sort > "$d/before"
  rc="$(run_as_hook "$d" "$s")"
  snap "$d" | LC_ALL=C sort > "$d/after"
  if [ "$want" = 0 ]; then
    [ "$rc" = 125 ] && { no "$label: INCOMPLETE: no task and memory bound available, so it was not run"; return; }
    bounded_is_incomplete "$rc" && { no "$label: INCOMPLETE: timed out twice (120 s each)"; tail -n 5 "$d/run.log" | sed 's/^/      /'; return; }
    [ "$rc" = 0 ] || { no "$label: exit $rc (an early failure would make 'unchanged' vacuous)"; tail -n 8 "$d/run.log" | sed 's/^/      /'; }
    grep -q "$marker" "$d/run.log" || { no "$label: its final tally ('$marker') is missing: it stopped early, so 'unchanged' proves nothing"; return; }
    if cmp -s "$d/before" "$d/after"; then ok "$label: the caller's refs, notes, config and upstream are unchanged"
    else no "$label: the caller changed"; diff "$d/before" "$d/after" | sed 's/^/      /' | head -20; fi
  else
    [ "$rc" = 125 ] && { no "$label: INCOMPLETE: no task and memory bound available, so it was not run"; return; }
    bounded_is_incomplete "$rc" && { no "$label: INCOMPLETE: timed out twice"; return; }
    grep -q 'refs/notes/' "$d/after" && ! cmp -s "$d/before" "$d/after" \
      && ok "$label: the harness sees a write through the inherited GIT_DIR" \
      || no "$label: a leaking script left the caller unchanged; the harness is blind"
  fi
}

echo "=== control: the harness sees a leak ==="
mkdir -p "$TMP/ctl"
cat > "$TMP/ctl/leaky.sh" <<'EOF'
#!/usr/bin/env bash
# What the unfixed review_tool.sh did: build a sandbox without clearing GIT_DIR, then write to it.
T="$(mktemp -d)"; git init -q "$T/w"
git -C "$T/w" commit -q --allow-empty -m leaked
git -C "$T/w" notes --ref=refs/notes/concrete-review add -m "verdict: clean" HEAD
EOF
probe "control (leaky script)" "$TMP/ctl/leaky.sh" 1

echo "=== live: sandbox checks run from a linked worktree as its hook would run them ==="
probe "review_tool.sh" scripts/checks/review_tool.sh 0 "^check_review_tool: PASS=[0-9]* FAIL=0$"
probe "legacy_frozen.sh" scripts/checks/legacy_frozen.sh 0 "^legacy_frozen: PASS=[0-9]* FAIL=0$"

echo
bounded_summary
echo "check_sandbox_isolation: PASS=$PASS FAIL=$FAIL"
[ "$FAIL" -eq 0 ]
#!/usr/bin/env bash
# legacy/ IS FROZEN (ROADMAP R-0558, R-0562).
#
# legacy/ is a byte-for-byte copy of main's tree at the move's base commit, plus the files later
# sweeps moved into it byte for byte. scripts/checks/legacy.lock records that commit and its tree, and
# each sweep; its format, and its one reader, is lib/legacy_lock.py (no code here reads the lock's
# bytes itself). This check holds five things:
#   1. the recorded tree is the recorded commit's tree (legacy/ is that snapshot, nothing else);
#   2. HEAD:legacy differs from it only by deletions and by sweeps: a modified path is refused, and an
#      added path is refused unless a sweep moved it (below);
#   3. each deleted path is covered by at least one RETENTION.tsv row, and every row covering it
#      (its own path or an ancestor directory) has `status` = `resolved` (the row's deletion
#      criterion holds): a resolved parent never releases a child with its own unresolved row.
#      Until RETENTION.tsv has a status column, every deletion is refused.
#   4. SWEEPS (owner, 2026-11-08: "ok to 1"). Each `sweep <commit> <tree>` line of the lock records
#      one move into legacy/: the commit of HEAD's history it took files from, and the legacy/ tree
#      it produced. The trees form a chain, frozen tree -> sweep 1 -> ... -> HEAD:legacy. Each step
#      to a sweep tree may add a path P only if P has the same mode and blob at that sweep's commit
#      and P no longer exists at the root of HEAD; the last step, to HEAD:legacy, adds nothing. Every
#      step refuses an edit of a legacy/ file and admits only the deletions RETENTION.tsv allows, so
#      a swept file, once in a sweep tree, is protected like a frozen one.
#   5. TRUSTED HISTORY. The steps above judge the lock this commit carries, so on their own a rewritten
#      lock line, or a file deleted by one sweep and re-added with other bytes by the next, would pass.
#      History settles both. The trusted history is main's landed states: the first-parent chain of
#      the merge base of HEAD and LEGACY_TRUSTED_REF (default origin/main), each commit read against
#      its first parent, or HEAD's own first-parent chain when that ref is absent (on main and on a
#      train head, whose first parent is main, the same thing; on a bare branch tip it is stricter:
#      the branch's own commits count, so a branch that corrected its own lock fails there). A train's member commits are second parents: a line a branch wrote and then
#      corrected before it landed is not trusted history. (a) Every base, tree and sweep line of every trusted version of
#      the lock is still in the lock: lines are only ever added. (b) Every version a legacy/ path ever
#      had in trusted history is the version it has now, if it still exists: a frozen or swept file
#      is never rewritten, by an edit or by deletion and re-addition. A candidate's own commits are
#      not trusted history; they are what the review and this gate judge.
# Negative controls run the same judgment on synthetic trees first, so a judge that accepts
# everything fails here before the real check.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
SELF="$ROOT_DIR/scripts/checks/${BASH_SOURCE[0]##*/}"
cd "$ROOT_DIR"
LOCK=scripts/checks/legacy.lock
LOCKPY="$ROOT_DIR/scripts/checks/lib/legacy_lock.py"
PASS=0; FAIL=0
ok(){ echo "  ok   $1"; PASS=$((PASS+1)); }
no(){ echo "  FAIL $1"; FAIL=$((FAIL+1)); }

# checked STEP COMMAND...: preserve semantic diagnostics; execution failures always print a refusal.
# Helpers use stdout as the refusal channel, including when the failed command printed nothing.
checked() {
  local label="$1" output rc; shift
  output="$("$@")"; rc=$?
  [ -z "$output" ] || printf '%s\n' "$output"
  if [ "$rc" -ne 0 ] && { [ "$rc" -ne 1 ] || [ -z "$output" ]; }; then
    printf 'refused: %s failed (exit %s)\n' "$label" "$rc"
  fi
  return "$rc"
}

# judge FROZEN_TREE CURRENT_TREE RETENTION_FILE (in the current repository): prints one problem per line.
judge() { # FROZEN CUR RETENTION ROOT-TREE [SWEEP-COMMIT...]
  local frozen="$1" cur="$2" ret="$3" root="$4"; shift 4
  [ "$frozen" = "$cur" ] && return 0
  # -z: paths arrive raw, never C-quoted, so the ls-tree lookups below see the real path.
  git diff-tree -z -r --no-renames --name-status "$frozen" "$cur" | python3 -I -c '
import sys
ret = sys.argv[1]
rows = [l.rstrip("\n").split("\t") for l in open(ret) if l.strip() and not l.startswith("#")]
hdr, rows = rows[0], rows[1:]
# (path, resolved?) for every path a row names. With no status column, nothing is resolved.
named = []
if "path" in hdr:
    pi = hdr.index("path"); si = hdr.index("status") if "status" in hdr else None
    for r in rows:
        res = si is not None and len(r) > si and r[si].strip() == "resolved"
        named += [(p.rstrip("/"), res) for p in r[pi].split()]
def ok(p):
    # Every row covering p (its own path or an ancestor) must be resolved, and at least one must:
    # a resolved parent does not release a child that has its own unresolved row.
    cover = [res for n, res in named if p == n or p.startswith(n + "/")]
    return bool(cover) and all(cover)
f = sys.stdin.buffer.read().split(b"\0")
if f and f[-1] == b"": f.pop()
for st, raw in zip(f[0::2], f[1::2]):
    st, path = st.decode(), raw.decode("utf-8", "surrogateescape")
    if "\n" in path or "\t" in path or not path.isprintable():
        print(f"{st} legacy/{path!r}: legacy/ admits no path with control characters")
    elif st == "A":
        print(f"ADD\t{path}")
    elif st != "D":
        print(f"{st} legacy/{path}: legacy/ admits no modification")
    elif not ok(path):
        print(f"D legacy/{path}: no resolved RETENTION.tsv row allows this deletion")
' "$ret" | while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ADD$'\t'*) ;; *) printf '%s\n' "$line"; continue ;; esac
    local path="${line#ADD$'\t'}" want s entry found=""
    local -x GIT_LITERAL_PATHSPECS=1 # a path is a path: ":(literal)p/x" must not resolve to p/x
    want="$(git ls-tree "$cur" -- "$path" | cut -f1)" || { echo "refused: judge added-path lookup failed"; continue; }
    [ -n "$want" ] || { echo "A legacy/$path: cannot resolve the added path; refused"; continue; }
    entry="$(git ls-tree "$root" -- "$path")" || { echo "refused: judge root lookup failed"; continue; }
    if [ -n "$entry" ]; then
      echo "A legacy/$path: a swept file must no longer exist at the root, and $path does"; continue
    fi
    for s in "$@"; do
      entry="$(git ls-tree "$s" -- "$path" | cut -f1)" || { echo "refused: judge sweep lookup failed"; continue; }
      [ "$entry" = "$want" ] && { found=1; break; }
    done
    [ -n "$found" ] || echo "A legacy/$path: no sweep commit in the lock has $path with this content; legacy/ admits only byte-for-byte moves"
  done || echo "refused: judge diff/retention pipeline failed"
}

chain() { # LOCK FROZEN CUR RETENTION HEAD-COMMIT: judges frozen -> each sweep tree -> CUR; prints refusals
  local lock="$1" prev="$2" cur="$3" ret="$4" head="$5" root rows kind sw st n=0 step
  rows="$(lock_rows "$lock")" || { printf '%s\n' "$rows"; return 0; }
  root="$(git rev-parse "$head^{tree}")" || { echo "refused: chain HEAD tree lookup failed"; return; }
  while read -r kind sw st || [ -n "$kind" ]; do # rows are the parser's, one per line
    [ "$kind" = sweep ] || continue
    n=$((n+1))
    if ! git rev-parse -q --verify "$sw^{commit}" >/dev/null \
       || ! git merge-base --is-ancestor "$sw" "$head" || [ "$(git cat-file -t "$st" 2>/dev/null)" != tree ]; then
      echo "sweep line $n: needs a commit of HEAD's history and a tree: $sw $st"; continue
    fi
    step="$(judge "$prev" "$st" "$ret" "$root" "$sw" 2>&1)"
    [ -z "$step" ] || printf 'sweep %s (%s):\n%s\n' "$n" "${sw:0:10}" "$step"
    prev="$st"
  done <<<"$rows"
  step="$(judge "$prev" "$cur" "$ret" "$root" 2>&1)"
  [ -z "$step" ] || printf 'since the last sweep:\n%s\n' "$step"
}

# trusted_base HEAD-COMMIT: the newest commit whose history is trusted (see 5 above).
trusted_base() {
  local ref="${LEGACY_TRUSTED_REF:-origin/main}" rc
  git rev-parse -q --verify "$ref^{commit}" >/dev/null; rc=$?
  if [ "$rc" = 0 ]; then
    git merge-base "$1" "$ref" || echo "refused: trusted_base merge-base failed"
  elif [ "$rc" = 1 ]; then
    git rev-parse -q --verify "$1^{commit}" || echo "refused: trusted_base HEAD lookup failed"
  else
    echo "refused: trusted_base ref lookup failed"
  fi
}

# lock_rows LOCK-FILE: the lock's rows, from its one parser (lib/legacy_lock.py); exit 1 with one
# diagnostic per problem. No code here reads the lock's bytes itself.
lock_rows() { checked lock_rows python3 -I "$LOCKPY" rows "$1"; }
# lock_history LOCK-FILE LOCK-PATH TRUSTED: every row of every version of LOCK-PATH in TRUSTED's
# first-parent history is still a row of LOCK-FILE; a malformed trusted version is refused. Prints
# one refusal per problem, naming the newest trusted commit that has a missing row.
lock_history() { checked lock_history python3 -I "$LOCKPY" history "$1" "$2" "$3"; }

# history_identity PREFIX HEAD-COMMIT TRUSTED: every version PREFIX/<path> had in TRUSTED's history is
# the version it has at HEAD-COMMIT, for each path HEAD-COMMIT still has. Prints one refusal per path.
history_identity() {
  local prefix="$1" head="$2" trusted="$3"
  checked history_identity python3 -I - "$prefix" "$head" "$trusted" <<'PY'
import subprocess, sys
prefix = sys.argv[1] + "/"
def tokens(args):
    return subprocess.check_output(["git", *args]).split(b"\0")
seen = {}

exec
/bin/bash -lc "python3 - <<'PY'
p='scripts/checks/sandbox_isolation.sh'
s=open(p).read(); needle='printf \\'[user]'
pos=s.index(needle)
s=s[:pos]+'''# Resolve in the real caller: a bare clone need not carry its origin/main ref.
trusted_ref=\""'${LEGACY_TRUSTED_REF:-origin/main}"
git -C "$ROOT_DIR" rev-parse -q --verify "$trusted_ref''^{commit}" >/dev/null
trusted_rc=$?
case "$trusted_rc" in
