from pathlib import Path
p=Path('scripts/checks/legacy_frozen.sh');s=p.read_text()
# existing one-row malformed control now also missing header; don't duplicate errors for invalid base (parser condition does that)
s=s.replace('rows=\""'$(python3 -I "$LOCKPY" rows "$LOCK")" && lock_ok=1 || lock_ok=""'"','rows=\""'$(python3 -I "$LOCKPY" rows "$LOCK")" && lock_ok=1 || { lock_ok=""; rows="${rows}${rows:+$'"\\'\\\\n\\'}refused: main lock_rows failed\"; }')
# parser one-reader control permits raw parser invocation
s=s.replace('(lock_rows|lock_history|chain) \\\\\"', '(lock_rows|lock_history|chain) \\\\\"') if False else s
s=s.replace('(lock_rows|lock_history|chain) \"\\\\"'$(LOCK|lock)"'"', '(lock_rows|lock_history|chain) \"\\\\"'$(LOCK|lock)"|python3 -I "'"\\\\"'$LOCKPY" rows "'"\\\\"'$(LOCK|lock)"'"')
# add controls after trusted_base controls before read loops
pos=s.index('# Every shell read loop')
controls='''# Exact failure controls: command stubs affect only the subshell invoking the helper.
expect_refusal() {
  local name=\""'$1" want="$2" got; shift 2
  got="$("$@" 2>/dev/null)"
  [ "$got" = "$want" ] && ok "control: $name" || no "control: $name: '"'"'$got'"' (wanted '"'$want'"')\"
}
printf 'base %s\\\\n' \""'$S" > "$TMP/base_only"
expect_refusal "base-only chain" "$TMP/base_only:2: missing: line 2 must be '"'tree <tree>'\" chain \""'$TMP/base_only" "$F" "$F" "$TMP/r_ok.tsv" "$H"
MB0="$(commit_of "" "$F" r "base $S")"
expect_refusal "base-only trusted lock" "lock: a trusted version is malformed: ${MB0:0:10}:L:2: missing: line 2 must be '"'tree <tree>'\" lock_history \""'$TMP/lock_dropped" L "$MB0"
for rc in 1 2; do
  printf '"'import sys\\\\nprint(\"stub error\", file=sys.stderr)\\\\nsys.exit(%s)\\\\n' \""'$rc" > "$TMP/parser_stub.py"
  expect_refusal "silent parser exit $rc chain" "refused: lock_rows failed (exit $rc)" env_chain_stub "$TMP/parser_stub.py"
  expect_refusal "silent parser exit $rc history" "refused: lock_history failed (exit $rc)" env_history_stub "$TMP/parser_stub.py"
done
