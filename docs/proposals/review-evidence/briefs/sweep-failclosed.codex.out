s=s.replace('    local path=\""'${line#ADD'"', '    local path=\""'${line#ADD'"',1).replace('want s found=\"\"','want s entry found=\"\"',1)
s=s.replace('    want=\""'$(git ls-tree "$cur" -- "$path" | cut -f1)"'"','    want=\""'$(git ls-tree "$cur" -- "$path" | cut -f1)" || { echo "refused: judge added-path lookup failed"; continue; }'"')
s=s.replace('    if [ -n \""'$(git ls-tree "$root" -- "$path")" ]; then'"','    entry=\""'$(git ls-tree "$root" -- "$path")" || { echo "refused: judge root lookup failed"; continue; }'"\\n    if [ -n \""'$entry" ]; then'"')
s=s.replace('      [ \""'$(git ls-tree "$s" -- "$path" | cut -f1)" = "$want" ]'"', '      entry=\""'$(git ls-tree "$s" -- "$path" | cut -f1)" || { echo "refused: judge sweep lookup failed"; continue; }'"\\n      [ \""'$entry" = "$want" ]'"')
s=s.replace('  done\\n}\\n\\nchain()', '  done || echo \"refused: judge diff/retention pipeline failed\"\\n}\\n\\nchain()',1)
s=s.replace('  root=\""'$(git rev-parse "$head''^{tree}")"'"','  root=\""'$(git rev-parse "$head''^{tree}")" || { echo "refused: chain HEAD tree lookup failed"; return; }'"')
start=s.index('  local ref=',s.index('trusted_base()'));end=s.index('\\n}\\n',start)
s=s[:start]+'''  local ref=\""'${LEGACY_TRUSTED_REF:-origin/main}" mb rc
  git rev-parse -q --verify "$ref''^{commit}" >/dev/null; rc=$?
  if [ "$rc" = 0 ]; then
    git merge-base "$1" "$ref" || echo "refused: trusted_base merge-base failed"
  elif [ "$rc" = 1 ]; then
    git rev-parse "$1''^{commit}" || echo "refused: trusted_base HEAD lookup failed"
  else
    echo "refused: trusted_base ref lookup failed"
  fi'"'''+s[end:]
s=s.replace('lock_rows() { python3 -I \""'$LOCKPY" rows "$1"; }'"','lock_rows() { checked lock_rows python3 -I \""'$LOCKPY" rows "$1"; }'"')
# chain must stop if parser diagnostic (wrapper returns success); separate raw rows checked status
s=s.replace('  rows=\""'$(lock_rows "$lock")" || { printf '"\\'%s\\\\n\\' \""'$rows"; return 0; }'"','  rows=\""'$(python3 -I "$LOCKPY" rows "$lock")"; local rc=$?'"\\n  if [ \""'$rc" -ne 0 ]; then'"\\n    [ -z \""'$rows" ] || printf '"\\'%s\\\\n\\' \""'$rows"'"\\n    if [ -z \""'$rows" ] || [ "$rc" -ne 1 ]; then echo "refused: lock_rows failed (exit $rc)"; fi'"\\n    return 0\\n  fi')
s=s.replace('lock_history() { python3 -I \""'$LOCKPY" history "$1" "$2" "$3"; }'"','lock_history() { checked lock_history python3 -I \""'$LOCKPY" history "$1" "$2" "$3"; }'"')
