from pathlib import Path
p=Path('scripts/checks/lib/legacy_lock.py')
s=p.read_text().replace('    if problems:\\n', '    if len(lines) < 2 and lines[0].startswith(b\"base \"):\\n        problems.append(f\"{name}:2: missing: line 2 must be \\'tree <tree>\\'\")\\n    if problems:\\n',1)
