#!/usr/bin/env bash
# TRUST BAN: no `sorry` and no `native_decide` anywhere in the specification (Q9.17), checked
# transitively in the kernel's terms and in the sources the environment does not keep.
#
#   E  no constant of ANY kind the ConcreteSpec library declares (definitions, instances and
#      generated helpers included, not only theorems) depends transitively on sorryAx, on
#      Lean.ofReduceBool or Lean.ofReduceNat (what native_decide and `decide +native` reduce through),
#      on Lean.trustCompiler, or on a generated `._native.` axiom;
#   D  the library declares no axiom of its own;
#   X  every `example`, which the kernel checks and Lean then discards (so E and D never see it),
#      depends only on the standard axioms: in a copy of the library each `example` becomes a
#      named declaration (scripts/proofs/lean_lex.py), the copy is built, and its axioms are
#      collected as E collects a theorem's;
#   S  defence in depth, lexical: the library builds with warningAsError and nothing in lakefile.toml
#      can change that or point the build at other sources; the sources, comments stripped and
#      string literals kept, never spell sorry, sorryAx, admit, native_decide, +native, an
#      option on `decide`, ofReduceBool, ofReduceNat, trustCompiler or skipKernelTC, and define no
#      syntax extension, run no meta code, set no option and import nothing outside the library
#      (the lexer reads what Lean reads only for syntax it knows).
#
# NEGATIVE CONTROLS: a theorem proved by sorry, a definition whose body is sorry (no theorem about
# it), a theorem proved by native_decide and a declared axiom each fail E or D naming the constant;
# a source with an `example` proved by native_decide or a sorry hidden in an interpolation fails S,
# the same words inside comments do not, and an unreadable or unlexable source fails S; examples
# proved by `decide +native` and by `stop` fail X, and one proved by rfl does not.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../checks/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"
CHECK_NAME=PROOF-TRUST-BAN
source scripts/proofs/lib.sh

BANNED_AXIOM_RE='^(sorryAx|Lean[.]ofReduceBool|Lean[.]ofReduceNat|Lean[.]trustCompiler)$|[.]_native[.]'
BANNED_WORD_RE='\b(sorry|sorryAx|admit|native_decide|ofReduceBool|ofReduceNat|trustCompiler|skipKernelTC)\b|\+native\b|\bnative»?\s*:=|\bdecide\s*\(\s*config\b|\bdecide\s*[+-]|\bDecide[.]Config\b'
# `decide` takes no options at all (`decide +native`, `decide (config := ⟨…⟩)` with a positional
# native flag): a term `decide (p)` is unaffected.
# The source scan is lexical, so it holds only for the syntax it lexes: Lean core's. A syntax
# extension could make Lean read a literal differently from the scan (a macro taking `s!` before a
# plain string), so the sources may define none and import nothing outside the library (only Init,
# implicitly, which is where s!, m! and f! live). They set no option either: the library builds with
# warningAsError (checked below in lakefile.toml), so a `sorry` that elaborates anywhere, whatever
# tactic produced it (`stop` is `repeat sorry`), fails the build; `set_option warningAsError false`
# would undo that. Nor do they run meta code (run_cmd, run_tac, #eval and the like).
EXTENSION_RE='#eval\b|\b(run_cmd|run_tac|run_elab|run_meta|set_option|macro|macro_rules|syntax|notation|infix|infixl|infixr|prefix|postfix|elab|elab_rules|declare_syntax_cat|initialize|builtin_initialize)\b'

# banned FILE → `<constant> (<axiom>)` for every constant of a PROOF_MODE=constants listing with a banned axiom
banned() {
  awk -F'\t' -v re="$BANNED_AXIOM_RE" '{ n = split($3, a, " ")
    for (i = 1; i <= n; i++) if (a[i] ~ re) { print $1 " (" a[i] ")"; break } }' "$1"
}
# declared FILE → the axioms a PROOF_MODE=constants listing declares
declared() { awk -F'\t' '$2 == "axiom" { print $1 }' "$1"; }
# scan FILE... → `file:line: text` for every banned word, syntax extension, option, meta command or
# outside import outside comments; exit 3 when a source cannot be lexed (lean_lex.py)
scan() { python3 "$PROOFS_DIR/lean_lex.py" scan "$BANNED_WORD_RE|$EXTENSION_RE" "$@"; }

echo "=== E/D: the environment ==="
population imported > "$TMP/imported.txt" 2> "$TMP/imported.err" || { no "PROOF_MODE=imported failed"; finish; }
GAP=$(closure_gap "$TMP/imported.txt")
[ -z "$GAP" ] && ok "all $(spec_modules | grep -c .) ConcreteSpec source modules are in the environment E and D read" \
  || no "source modules outside the root's import closure, unseen by E and D: $(echo $GAP)"
population constants > "$TMP/consts.tsv" 2> "$TMP/consts.err" \
  || { cat "$TMP/consts.err" >&2; echo "error: the enumerator failed" >&2; exit 2; }
NC=$(grep -c . "$TMP/consts.tsv")
B=$(banned "$TMP/consts.tsv")
[ "$NC" -ge 1000 ] && [ -z "$B" ] \
  && ok "none of the $NC ConcreteSpec constants depends on sorryAx, ofReduceBool/Nat, trustCompiler or a native axiom" \
  || no "$NC constants; banned dependencies: $(echo $B | cut -c1-400)"
A=$(declared "$TMP/consts.tsv")
[ -z "$A" ] && ok "ConcreteSpec declares no axiom" || no "ConcreteSpec declares axioms: $(echo $A)"

echo "=== S: the sources ==="
mapfile -t SRC < <({ echo ConcreteSpec.lean; find ConcreteSpec -name '*.lean'; } | sort)
W=$(scan "${SRC[@]}"); RC=$?
[ "$RC" = 0 ] && [ "${#SRC[@]}" -ge 10 ] && [ -z "$W" ] && ok "none of the ${#SRC[@]} source files spells a banned word outside comments" \
  || no "the source scan (rc=$RC) of ${#SRC[@]} files: $(printf '%s\n' "$W" | head -5 | tr '\n' '|')"

# lake_options LAKEFILE → empty when the specification library builds from ConcreteSpec.lean and
# ConcreteSpec/ (Lake's defaults: no srcDir, roots or globs) with warningAsError, and nothing can turn
# it off. The package holds exactly two libraries, ConcreteSpec and the compiler, Concrete (ROADMAP B0),
# under the same key allow-list. A dependency is a `require` of a git URL pinned to a full commit,
# which lake-manifest.json (beside the lakefile) records at the same URL and commit: the spec may
# import nothing outside itself (S), so a dependency reaches only the compiler. This ban's scope is
# the specification; the compiler's trust gate is Concrete/README.md gate 2.
lake_options() {
  python3 - "$1" <<'EOF'
import sys, tomllib
try:
    cfg = tomllib.load(open(sys.argv[1], "rb"))
except Exception as e:
    print(f"unreadable: {e}"); sys.exit(0)
bad = []
import os
if os.path.exists(os.path.join(os.path.dirname(sys.argv[1]) or ".", "lakefile.lean")):
    bad.append("a lakefile.lean, which Lake reads instead of lakefile.toml")
if cfg.get("leanOptions", {}).get("warningAsError") is not True:
    bad.append("[leanOptions] warningAsError is not true")
# Allow-lists, not deny-lists: a key not named here (srcDir, roots, globs, moreLeanArgs, …) could
# point the build at other sources or pass options, so it is refused.
extra = set(cfg) - {"name", "version", "defaultTargets", "leanOptions", "lean_lib", "require"}
if extra: bad.append(f"the package sets {sorted(extra)}")
if set(cfg.get("leanOptions", {})) != {"warningAsError"}:
    bad.append(f"[leanOptions] sets {sorted(set(cfg.get('leanOptions', {})) - {'warningAsError'})}")
import json, re
reqs = cfg.get("require", [])
if reqs:
    try:
        man = json.load(open(os.path.join(os.path.dirname(sys.argv[1]) or ".", "lake-manifest.json")))
        pkgs = {p.get("name", "").strip("«»"): p for p in man.get("packages", [])}
    except Exception as e:
        bad.append(f"lake-manifest.json unreadable: {e}"); pkgs = {}
    for r in reqs:
        n = r.get("name")
        if set(r) != {"name", "git", "rev"}:
            bad.append(f"the require {n} sets {sorted(set(r) ^ {'name', 'git', 'rev'})}"); continue
        if not re.fullmatch(r"[0-9a-f]{40}", str(r["rev"])):
            bad.append(f"the require {n} is not pinned to a full commit ({r['rev']})")
        p = pkgs.get(n)
        if not p or p.get("type") != "git" or p.get("url") != r["git"] or p.get("rev") != r["rev"] or p.get("inputRev") != r["rev"]:
            bad.append(f"lake-manifest.json does not record the require {n} at {r['git']} {r['rev']}")
libs = cfg.get("lean_lib", [])
if [l.get("name") for l in libs] != ["ConcreteSpec", "Concrete"]: bad.append(f"libraries {[l.get('name') for l in libs]}")
for l in libs:
    extra = set(l) - {"name", "leanOptions"}
    if extra: bad.append(f"the library sets {sorted(extra)}")
    opts = set(l.get("leanOptions", {})) - {"autoImplicit"}
    if opts: bad.append(f"the library sets options {sorted(opts)}")
print("; ".join(bad))
EOF
}
L=$(lake_options lakefile.toml)
[ -z "$L" ] && ok "lakefile.toml builds the library with warningAsError, and nothing overrides it" || no "lakefile.toml: $L"

echo "=== X: the examples, in the kernel's terms ==="
# A copy of the library in which every `example` is a named declaration, built, and its axioms
# collected as E collects a theorem's. warningAsError is off in the copy only: a definition may draw
# a linter warning the example did not, and the copy is read for axioms, not judged for warnings.
EX="$TMP/ex"; mkdir -p "$EX"
cp lakefile.toml lean-toolchain lake-manifest.json "$EX"/ || { no "could not copy the Lake files"; finish; }
[ -d .lake/build ] && mkdir -p "$EX/.lake" && cp -r .lake/build "$EX/.lake/"
sed -i 's/^warningAsError = true$/warningAsError = false/' "$EX/lakefile.toml"
NEX=$(python3 "$PROOFS_DIR/lean_lex.py" examples . "$EX" "${SRC[@]}") \
  || { no "the examples could not be rewritten: $NEX"; finish; }
(cd "$EX" && "$LAKE" build ConcreteSpec) > "$TMP/ex-build.log" 2>&1 \
  || { no "the library with its examples as declarations does not build: $(grep -m3 error "$TMP/ex-build.log" | tr '\n' ' ')"; finish; }
(cd "$EX" && PROOF_MODE=examples "$LAKE" env lean "$ENUMERATOR") > "$TMP/examples.out" 2> "$TMP/examples.err" \
  || { no "PROOF_MODE=examples failed: $(head -2 "$TMP/examples.err" | tr '\n' ' ')"; finish; }
grep -P '\t' "$TMP/examples.out" > "$TMP/examples.tsv"
# nonstandard FILE → `<name> (<axiom>)` for every row whose axioms are not among the standard three
nonstandard() {
  awk -F'\t' -v std=" $STANDARD_AXIOMS " '{ n = split($2, a, " ")
    for (i = 1; i <= n; i++) if (index(std, " " a[i] " ") == 0) { print $1 " (" a[i] ")"; break } }' "$1"
}
NE=$(grep -c . "$TMP/examples.tsv"); X=$(nonstandard "$TMP/examples.tsv")
[ "$NEX" -ge 100 ] && [ "$NE" = "$NEX" ] && [ -z "$X" ] \
  && ok "all $NEX examples, kept as declarations, depend only on the standard axioms" \
  || no "examples: $NEX rewritten, $NE in the environment; on other axioms: $(echo $X | cut -c1-300)"

echo "=== negative controls ==="
# control NAME BODY AXIOM-ERE WHAT: the declarations in BODY must be refused at ConcreteSpecControl.NAME
control() {
  printf '%s\n' "$2" > "$TMP/c-$1.lean"
  population constants "$TMP/c-$1.lean" > "$TMP/c-$1.tsv" 2> "$TMP/c-$1.err"
  local got; got=$(banned "$TMP/c-$1.tsv" | grep -F "ConcreteSpecControl.$1 (")
  has_match -E "\(($3)\)\$" <<<"$got" \
    && ok "control: $4 is refused ($got)" || no "control: $4 was not refused with $3: '$got' $(head -2 "$TMP/c-$1.err" | tr '\n' ' ')"
}
control sorryThm 'theorem ConcreteSpecControl.sorryThm : 1 = 2 := sorry' 'sorryAx' "a theorem proved by sorry"
control sorryDef 'def ConcreteSpecControl.sorryDef : Nat := sorry' sorryAx "a definition with a sorry body and no theorem about it"
control nativeThm 'theorem ConcreteSpecControl.nativeThm : 2 + 2 = 4 := by native_decide' 'Lean\.ofReduceBool|.*\._native\..*' "a theorem proved by native_decide"
printf 'axiom ConcreteSpecControl.ax : 1 = 2\n' > "$TMP/c-ax.lean"
population constants "$TMP/c-ax.lean" > "$TMP/c-ax.tsv" 2>/dev/null
[ "$(declared "$TMP/c-ax.tsv")" = ConcreteSpecControl.ax ] \
  && ok "control: a declared axiom is reported" || no "control: a declared axiom was not reported: '$(declared "$TMP/c-ax.tsv")'"
# A quoted name holding a tab would shift its row's columns (the axiom kind out of column 2) and
# hide the axiom from `declared`; theorems.lean refuses every such name before writing a row.
printf 'axiom ConcreteSpecControl.«a\tb» : 1 = 2\n' > "$TMP/c-tab.lean"
if population constants "$TMP/c-tab.lean" > "$TMP/c-tab.tsv" 2> "$TMP/c-tab.err"; then
  no "control: an axiom whose name holds a tab did not fail the run: '$(declared "$TMP/c-tab.tsv")'"
else
  grep -q 'control character' "$TMP/c-tab.err" "$TMP/c-tab.tsv" \
    && ok "control: an axiom whose name holds a tab fails the run (no row can carry it)" \
    || no "control: the tab-name run failed for another reason: $(head -2 "$TMP/c-tab.err" "$TMP/c-tab.tsv" | tr '\n' ' ')"
fi
mkdir -p "$TMP/src"
cat > "$TMP/src/Bad.lean" <<'EOF'
/- a comment may say sorry and native_decide, /- nested -/ and still sorry -/
-- and so may a line comment: sorry
def quote : Char := '"'
example : 2 + 2 = 4 := by native_decide
def interp : String := s!"{(sorry : Nat)}"
def dashes : String := "-- /- not a comment" ++ toString (sorry : Nat)
example : String := s!"{("--")}{(sorry : Nat)}"
example : String := s!"{"/-"}" ++ toString (sorry : Nat)
def chars : List Char := ['{', '}', '\'', '\\', '"', '\x41']
def h' : Nat := 0 -- a prime in a name starts no character literal: sorry
def r' : String := r#"raw "-- /-" text"# ++ toString (sorry : Nat)
example : True := by have «--» : True := True.intro; sorry
example : False := sorryAx False true
macro "plain" "s!" s:str : term => pure s
import Lean
set_option warningAsError false in
example : False := by stop skip
run_cmd pure ()
#eval (pure () : IO Unit)
example : 2 + 2 = 4 := by decide (config := { native
  := true })
example : 2 + 2 = 4 := by decide (config := ⟨false, true, true, false⟩)
EOF
W=$(scan "$TMP/src/Bad.lean"); RC=$?
B="$TMP/src/Bad.lean"
EXPECT="$B:4: example : 2 + 2 = 4 := by native_decide
$B:5: def interp : String := s!\"{(sorry : Nat)}\"
$B:6: def dashes : String := \"-- /- not a comment\" ++ toString (sorry : Nat)
$B:7: example : String := s!\"{(\"--\")}{(sorry : Nat)}\"
$B:8: example : String := s!\"{\"/-\"}\" ++ toString (sorry : Nat)
$B:11: def r' : String := r#\"raw \"-- /-\" text\"# ++ toString (sorry : Nat)
$B:12: example : True := by have «--» : True := True.intro; sorry
$B:13: example : False := sorryAx False true
$B:14: macro \"plain\" \"s!\" s:str : term => pure s
$B:15: import Lean
$B:16: set_option warningAsError false in
$B:18: run_cmd pure ()
$B:19: #eval (pure () : IO Unit)
$B:20: example : 2 + 2 = 4 := by decide (config := { native
$B:22: example : 2 + 2 = 4 := by decide (config := ⟨false, true, true, false⟩)"
[ "$RC" = 0 ] && [ "$W" = "$EXPECT" ] \
  && ok "control: native_decide, and sorry inside an interpolation, after a string, raw string or quoted name holding comment delimiters, after an interpolation holding a string, a direct sorryAx, a syntax extension, an outside import, an option, meta code and decide options (native split across lines, positional) are found; the words in comments are not" \
  || no "control: source scan (rc=$RC) reported '$W'"
printf 'def s : String := s!"unterminated {\n' > "$TMP/src/Open.lean"
printf 'example : String × Nat := { fst := "{--", snd := sorry\n} -- "\n' > "$TMP/src/Brace.lean"
printf 'def q := `(command|\n/-! hidden -/\n)\n' > "$TMP/src/Quote.lean"
for imp in 'import ConcreteSpec.Spec Lean' 'import ConcreteSpec.Spec
  Lean' 'prelude
import ConcreteSpec.Spec'; do
  printf '%s\nnamespace X\nend X\n' "$imp" > "$TMP/src/Imp.lean"
  W=$(scan "$TMP/src/Imp.lean")
  [ -n "$W" ] && ok "control: the header $(printf '%s' "$imp" | tr '\n' ' ') is reported" \
    || no "control: the header $(printf '%s' "$imp" | tr '\n' ' ') passed the scan"
done
printf '[leanOptions]\nwarningAsError = true\n\n[[lean_lib]]\nname = "ConcreteSpec"\nleanOptions = { autoImplicit = false, warningAsError = false }\n' > "$TMP/lake-off.toml"
L=$(lake_options "$TMP/lake-off.toml")
has_match -F "the library sets options ['warningAsError']" <<<"$L" && ok "control: a library that turns warningAsError off is refused ($L)" \
  || no "control: a lakefile turning warningAsError off was accepted"
printf '[leanOptions]\nwarningAsError = true\n\n[[lean_lib]]\nname = "ConcreteSpec"\nsrcDir = "shadow"\n' > "$TMP/lake-src.toml"
L=$(lake_options "$TMP/lake-src.toml")
has_match -F "the library sets ['srcDir']" <<<"$L" && ok "control: a library built from another source directory is refused ($L)" \
  || no "control: a lakefile with srcDir was accepted"
# The dependency controls run on a copy of this lakefile, beside a manifest, so each varies one thing.
mkdir -p "$TMP/lk"
lake_variant() { # NAME PYTHON-EDIT: lakefile.toml and lake-manifest.json copied to $TMP/lk/NAME, then edited
  mkdir -p "$TMP/lk/$1"; cp lakefile.toml lake-manifest.json "$TMP/lk/$1/"
  (cd "$TMP/lk/$1" && python3 -I -c "$2")
}
lake_variant short 'import re; p="lakefile.toml"; s=open(p).read(); r=re.search("[0-9a-f]{40}", s).group(0); open(p,"w").write(s.replace(r, r[:12]))'
lake_variant branch 'import re; p="lakefile.toml"; s=open(p).read(); open(p,"w").write(re.sub(r"rev = \"[0-9a-f]+\"", "rev = \"main\"", s))'
lake_variant drift 'import json; p="lake-manifest.json"; m=json.load(open(p)); m["packages"][0]["rev"]="0"*40; json.dump(m, open(p,"w"))'
lake_variant subdir 'p="lakefile.toml"; s=open(p).read(); open(p,"w").write(s.replace("[[require]]\n", "[[require]]\nsubDir = \"x\"\n", 1))'
lake_variant thirdlib 'p="lakefile.toml"; s=open(p).read(); open(p,"w").write(s + "\n[[lean_lib]]\nname = \"Other\"\n")'
for v in short:"not pinned to a full commit" branch:"not pinned to a full commit" drift:"does not record the require" subdir:"sets ['subDir']" thirdlib:"libraries ['ConcreteSpec', 'Concrete', 'Other']"; do
  L=$(lake_options "$TMP/lk/${v%%:*}/lakefile.toml")
  case "$L" in *"${v#*:}"*) ok "control: a lakefile whose dependency or library set is changed (${v%%:*}) is refused ($L)" ;;
    *) no "control: the ${v%%:*} lakefile was not refused for '${v#*:}': '$L'" ;; esac
done
for f in missing Open Brace Quote; do
  scan "$TMP/src/$f.lean" > /dev/null 2>&1; RC=$?
  [ "$RC" != 0 ] && ok "control: a source the scan cannot read or lex ($f) fails it (rc=$RC)" \
    || no "control: the scan of $f exited 0"
done
head -n 3 "$TMP/imported.txt" > "$TMP/imp-short.txt"
[ -n "$(closure_gap "$TMP/imp-short.txt")" ] \
  && ok "control: source modules outside a (truncated) import closure are reported" || no "control: a truncated closure reported no gap"
# The example leg's own controls: examples rewritten as that leg rewrites them, then enumerated.
mkdir -p "$TMP/exc-src" "$TMP/exc"
printf 'example : 2 + 2 = 4 := by decide +native\nexample : 1 = 2 := by stop skip\nexample : 1 = 1 := rfl\ndef w : String := "example"\n' > "$TMP/exc-src/C.lean"
N=$(python3 "$PROOFS_DIR/lean_lex.py" examples "$TMP/exc-src" "$TMP/exc" C.lean)
# (Lean prints the warnings of the inserted declarations on stdout too; the rows are the tab lines.)
population examples "$TMP/exc/C.lean" 2>/dev/null | grep -P '\t' > "$TMP/exc.tsv"
X=$(nonstandard "$TMP/exc.tsv")
[ "$N" = 3 ] && [ "$(grep -c . "$TMP/exc.tsv")" = 3 ] && has_match -F "C.lean:1» (" <<<"$X" && has_match -F "C.lean:2» (sorryAx)" <<<"$X" \
  && ! has_match -F "C.lean:3»" <<<"$X" \
  && ok "control: an example proved by decide +native and one closed by stop are reported, rfl is not, and the word example in a string is no example ($(echo $X | tr '\n' ' '))" \
  || no "control: rewritten examples: $N, rows $(grep -c . "$TMP/exc.tsv"), reported '$X'"
finish
rec_refuses "a run at another SHA" "no completed CI dispatch" "$HEADR" --base "$BASE"
rruns "$(rrun 501 "$HEADR" "$WF" workflow_dispatch completed)"; rjobs 501 "$BASE" "$GREEN"
rec_refuses "a run the API lists at the head but whose own record names another SHA" "ran ${BASE:0:10}" "$HEADR" --base "$BASE"
reset_record; rruns "$(rrun 501 "$HEADR" .github/workflows/other.yml workflow_dispatch completed)"
rec_refuses "a run of another workflow" "no completed CI dispatch" "$HEADR" --base "$BASE"
rruns "$(rrun 501 "$HEADR" "$WF" pull_request completed)"
rec_refuses "a pull_request run" "no completed CI dispatch" "$HEADR" --base "$BASE"
rruns "$(rrun 501 "$HEADR" "$WF" push completed)"
rec_refuses "a push run (its checks' base is not the declared one)" "no completed CI dispatch" "$HEADR" --base "$BASE"
rruns "$(rrun 501 "$HEADR" "$WF" workflow_dispatch completed "ci/t1 at base $HEADR")"
rec_refuses "a dispatch whose checks ran at another base" "no completed CI dispatch" "$HEADR" --base "$BASE"
rruns "$(rrun 501 "$HEADR" "$WF" workflow_dispatch completed "CI")"
rec_refuses "a dispatch that names no base (a campaign or hand dispatch)" "no completed CI dispatch" "$HEADR" --base "$BASE"
rruns "$(rrun 501 "$HEADR" "$WF" workflow_dispatch in_progress)"
rec_refuses "an unfinished run" "no completed CI dispatch" "$HEADR" --base "$BASE"
rruns "$(rrun 501 "$HEADR" "$WF" workflow_dispatch completed)"
rec_refuses "the asking run itself" "no completed CI dispatch" "$HEADR" --base "$BASE" --exclude-run 501
reset_record
rjobs 501 "$HEADR" '[{"name":"Build","conclusion":"skipped","databaseId":31},{"name":"Other","conclusion":"success","databaseId":32}]'
rec_refuses "a skipped required job" "skipped: Build" "$HEADR" --base "$BASE"
rjobs 501 "$HEADR" '[{"name":"Build","conclusion":"cancelled","databaseId":31},{"name":"Other","conclusion":"success","databaseId":32}]'
rec_refuses "a cancelled required job" "cancelled: Build" "$HEADR" --base "$BASE"
rjobs 501 "$HEADR" '[{"name":"Build","conclusion":"success","databaseId":31},{"name":"Other","conclusion":"failure","databaseId":32}]'
rec_refuses "a failed landing-tier job" "failure: Other" "$HEADR" --base "$BASE"
rjobs 501 "$HEADR" '[{"name":"Other","conclusion":"success","databaseId":32}]'
rec_refuses "a run without a required job" "missing: Build" "$HEADR" --base "$BASE"
rjobs 501 "$HEADR" '[{"name":"Campaign: gate mutation shard 1","conclusion":"success","databaseId":33}]'
rec_refuses "a run with no landing-tier job" "no landing-tier jobs" "$HEADR" --base "$BASE"
reset_record
rruns "$(rrun 502 "$HEADR" "$WF" workflow_dispatch completed)" "$(rrun 501 "$HEADR" "$WF" workflow_dispatch completed)"
rjobs 502 "$HEADR" '[{"name":"Build","conclusion":"failure","databaseId":41}]'
rec_refuses "an older green run behind a newer red one at the same SHA" "run 502, the newest" "$HEADR" --base "$BASE"
reset_record; echo '{"status": "diverged"}' > "$RW/compare.json"
rec_refuses "a head not strictly ahead of the base" "compare: diverged" "$HEADR" --base "$BASE"
rm -f "$RW/compare.json"
rec_refuses "when the compare API cannot be read" "compare: -" "$HEADR" --base "$BASE"
reset_record
rec_refuses "a base this clone does not have" "not in this clone" "$HEADR" --base 0123456789abcdef0123456789abcdef01234567
rec_refuses "an all-zero base (a new branch, not a landing)" "--base must be" "$HEADR" --base 0000000000000000000000000000000000000000
rec_refuses "an abbreviated head" "full 40-hex SHA" "${HEADR:0:10}" --base "$BASE"
rm -f "$RW/runs.json"
rec_refuses "when the runs API cannot be read" "no completed CI dispatch" "$HEADR" --base "$BASE"
# A base requirement the head drops without a transition row is still owed (land's own rule).
git checkout -q -b rec-drop "$HEADR"; printf 'Other\n' > required-checks.txt; git commit -qam "drop Build"
HD="$(git rev-parse HEAD)"; git checkout -q train/t1
reset_record; rruns "$(rrun 503 "$HD" "$WF" workflow_dispatch completed)"
rjobs 503 "$HD" '[{"name":"Other","conclusion":"success","databaseId":51}]'
rec_refuses "a head that drops a base requirement silently" "missing: Build" "$HD" --base "$BASE"
reset_record

echo "=== the workflow: Landing record gates every landing-tier job; a dispatch's base binds its checks ==="
cat > "$TMP/record_gate.py" <<'PY2'
import re, sys, yaml
doc = yaml.safe_load(open(sys.argv[1]))
jobs = doc["jobs"]
rx = re.compile(sys.argv[2])
# The record trusts a dispatch's title for its base: the title must come from the base input, and
# every base-sensitive check must compare with that input as a push compares with event.before.
if "format('{0} at base {1}', github.ref_name, inputs.base)" not in str(doc.get("run-name", "")):
    print("run-name does not record a dispatch's base as '<ref> at base <sha>'")
bases = 0
for k, j in jobs.items():
    for st in j.get("steps", []):
        for var, val in (st.get("env") or {}).items():
            if var in ("LL1_BASE", "TOTALITY_BASE", "CONFORMANCE_BASE", "SPEC_BASE"):
                bases += 1
                if "github.event.before" not in str(val) or "inputs.base" not in str(val):
                    print(f"{var} in {k} does not take a push's event.before and a dispatch's inputs.base")
GATE = "needs.landing-record.outputs.recorded != 'true'"
rec = jobs.get("landing-record")
if not rec or rec.get("name") != "Landing record":
    print("no job landing-record named 'Landing record'")
else:
    if rec.get("needs") or rec.get("if"):
        print("landing-record must run on every event, first")
    if "steps.record.outputs.recorded" not in str(rec.get("outputs", {}).get("recorded", "")):
        print("landing-record does not export the record step's verdict")
def needs(j):
    n = j.get("needs", [])
    return [n] if isinstance(n, str) else list(n)
gated = {}
def is_gated(k, seen=()):
    if k in gated: return gated[k]
    j = jobs[k]; n = needs(j); cond = str(j.get("if", ""))
    if "landing-record" in n:
        r = GATE in cond and "!cancelled()" in cond
    elif n:
        # a job that needs others runs only when they ran; if: always()/!cancelled() would undo that
        r = all(m in jobs and m not in seen and is_gated(m, seen + (k,)) for m in n) \
            and not re.search(r"always\(\)|cancelled\(\)|failure\(\)", cond)
    else:
        r = False
    gated[k] = r; return r
for k, j in jobs.items():
    if k == "landing-record" or rx.search(str(j.get("name", k))):
        continue
    if not is_gated(k):
        print("landing-tier job not gated on the landing record: " + str(j.get("name", k)))
PY2
out="$(python3 -I "$TMP/record_gate.py" "$ROOT_DIR/.github/workflows/lean_action_ci.yml" "$re_default")"; rc=$?
[ "$rc" = 0 ] && [ -z "$out" ] && ok "every landing-tier job is skipped exactly when main's run holds a record" \
  || { no "the workflow's record gate is incomplete (rc=$rc)"; echo "$out" | sed 's/^/      /'; }
# Controls: an ungated root job, a dependent that re-runs on always(), and a gate without
# !cancelled() (a failed record job would then skip every job) are each found.
python3 -I - "$ROOT_DIR/.github/workflows/lean_action_ci.yml" "$TMP/rg" <<'PY3'
import sys, yaml, copy, os
w = yaml.safe_load(open(sys.argv[1])); os.makedirs(sys.argv[2], exist_ok=True)
a = copy.deepcopy(w); a["jobs"]["spec"].pop("needs"); a["jobs"]["spec"].pop("if")
b = copy.deepcopy(w); b["jobs"]["oracle-hosted"]["if"] = "always()"
c = copy.deepcopy(w); c["jobs"]["root-checks"]["if"] = "needs.landing-record.outputs.recorded != 'true'"
d = copy.deepcopy(w)
d["jobs"]["root-checks"]["steps"].append({"run": "true", "env": {"TOTALITY_BASE": "${{ github.event.before }}"}})
for j in d["jobs"].values():
    for st in j.get("steps", []):
        if "TOTALITY_BASE" in (st.get("env") or {}):
            st["env"]["TOTALITY_BASE"] = "${{ github.event_name == 'push' && github.event.before || '' }}"
for n, x in (("ungated", a), ("always", b), ("nocancel", c), ("unbased", d)):
    yaml.safe_dump(x, open(os.path.join(sys.argv[2], n + ".yml"), "w"))
PY3
o="$(python3 -I "$TMP/record_gate.py" "$TMP/rg/unbased.yml" "$re_default")"
has "$o" "TOTALITY_BASE in" && ok "CONTROL: the record-gate check finds a base-sensitive check that ignores the dispatch's base" \
  || no "CONTROL: the record-gate check missed an unbased check: '$o'"
for v in ungated always nocancel; do
  o="$(python3 -I "$TMP/record_gate.py" "$TMP/rg/$v.yml" "$re_default")"
  has "$o" "not gated" && ok "CONTROL: the record-gate check finds the $v job" || no "CONTROL: the record-gate check missed the $v job: '$o'"
done

echo "=== required-checks.txt names exactly the workflow's landing-tier jobs ==="
# A matrix job is one job per leg, each under the name GitHub shows: its name template with that
# leg's values (`include` rows only; any other matrix form is refused, since its legs are not listed).
cat > "$TMP/required_names.py" <<'PY'
import re, sys, yaml
jobs = yaml.safe_load(open(sys.argv[1]))["jobs"]
rx = re.compile(sys.argv[2])
def legs(k, j):
    name = str(j.get("name", k)); m = (j.get("strategy") or {}).get("matrix")
#!/usr/bin/env bash
# Slice-0 artifact gates (PROVISIONAL, Concrete/README.md gates 10, 11 and 12), over every
# hand-written BIR example, on the executables slice0_native.sh links:
#
# 10. Sanitizers: the LLVM example also built with ASan (slice0_native.sh sanitize: ASan
#     instruments the printed IR once every definition carries sanitize_address; no UBSan: its
#     checks are inserted by clang's C front end, so on IR input it checks nothing) must
#     give the same observation as the BIR semantics (status, exact fd-2 bytes, empty fd 1), so no
#     sanitizer report. Its memory is bounded by ASan's hard_rss_limit_mb (the shadow reservation
#     rules out an address-space cap; every other command is capped, see SLICE0_GATE_MEM_GB). Control: a body with an out-of-bounds load must be reported.
# 11. Binary size (report-only, never fails on a size): bytes and text size of each executable,
#     per backend and target, in REPORT/sizes.tsv. Compile time (report-only, owner 2026-11-08):
#     wall-clock milliseconds of each example's emit step (the Lean emitter: checks, LLVM print,
#     LCB adaptation and in-process assembly, Lean start-up included) and native step (clang and
#     LCB's command line, linking both executables), next to its budget (the step's time bound), in
#     REPORT/compile_times.tsv.
# 12. Stack bound: lib/stack_bound.py derives, from the linked executable's disassembly, a bound on
#     the Concrete-owned stack below main's entry, covering every byte addressed relative to the
#     stack or frame pointer (so the red zone), with external libc calls listed with their entry
#     depth (their own use, and that _exit and abort do not return, are premises). A run under
#     gdb (x86-64 Linux, lib/stack_measure.py) or LLDB (aarch64-macos, lib/stack_measure_lldb.py)
#     must stay within it (the run counts the stack pointer and every stack byte a stepped
#     instruction addresses, lib/stack_access.py, so the red zone). Each analysed disassembly is
#     kept in REPORT/disassembly/. REPORT/stack.tsv. Controls: the analysis must refuse an unmodelled
#     stack-pointer write, an indirect call, recursion, a call to an unknown function, two depths
#     meeting, a stack pointer used as a value or written through a partial register, a partial
#     frame-pointer write, an indexed stack address, a saved frame pointer popped into another
#     register, a stack address taken, an overwritten return address, an AArch64 frame pointer
#     stored, a register-directed return, a return after a call without the link register
#     restored, a freed or restored saved slot reread, a callee's leftover saved slot reread by
#     its caller (both architectures), a read of bytes written on one path only or never written,
#     a store through main's argv, a PC-relative base kept across a call, walked by repeated adds or
#     beyond the reach premise, an absolute address (memory only through sp/fp, PC-relative or fs/gs), a callee that does not restore the frame pointer, a frame record away from sp, an unmodelled
#     instruction (x86 `loop`) and frame- or link-register writeback (AArch64), and give the
#     expected bound on known functions (x86 frame, red-zone store, two AArch64 frame-record
#     shapes, a read of bytes written on both paths, an adrp-based load, LCB's single link-register
#     save with a Mach-O stub call in a loop); also refuse the link register loaded from another
#     slot, a stub call with no indirect-symbol entry, into a stub entry's middle or to the bare stub
#     section; the comparison must reject a
#     measurement above the bound; refuse an access beyond the target's red zone (x86-64, Apple
#     arm64) and any below the stack pointer on aarch64-linux; and a linked main storing at the red
#     zone's edge must be measured at 128 (bound 128), and with a 120-byte red zone not at all.
#
# usage: slice0_artifacts.sh [REPORT_DIR]. Run inside the nix devshell, from the repository root.
set -euo pipefail
report=${1:-}
# The sanitizer executions need an unbounded address-space reservation, so the gate sets no cap of
# its own and caps every other command it starts (`capped`, and limited_exec.sh for executables).
SLICE0_GATE_MEM_GB=0
# shellcheck source=scripts/checks/lib/slice0_common.sh
source scripts/checks/lib/slice0_common.sh
: "${CONCRETE_SLICE0_LLVM:?run inside nix develop}"
objdump=(bounded 60 "$CONCRETE_SLICE0_LLVM/llvm-objdump" -d --no-show-raw-insn)
indirect=(bounded 60 "$CONCRETE_SLICE0_LLVM/llvm-objdump" --macho --indirect-symbols)
case "$target" in
  x86_64-linux) arch=x86_64; objdump+=(--x86-asm-syntax=intel) ;;
  aarch64-*) arch=aarch64 ;;
esac
# The run check's debugger: gdb on x86-64 Linux, LLDB on aarch64-macos (none elsewhere).
gdb= lldb=
case "$target" in
  x86_64-linux) gdb=${CONCRETE_SLICE0_GDB:?the x86-64 Linux shell pins gdb} ;;
  aarch64-macos)
    lldb=${CONCRETE_SLICE0_LLDB:?the macOS shell names lldb}
    [ -x "$lldb" ] || { echo "slice0_artifacts: no LLDB at $lldb" >&2; exit 2; }
# Required CI jobs: a train lands only when every job named here ran at the candidate's exact SHA and
# succeeded (scripts/land/train.sh watch and land). One exact job name per line, as GitHub shows it.
# GitHub branch protection is not configured for main, so this file is the record. Every job of
# .github/workflows/lean_action_ci.yml is listed, each matrix leg under the name GitHub shows for it:
# the root has no campaign tier.
Root checks
Spec build
Oracle (GitHub-hosted fetch + smoke)
Landing record
Proof axioms
Proof trust ban (sorry, native_decide)
Kernel replay (leanchecker)
External re-check (con-leche, nanoda)
Slice 0 backends (x86-64)
Slice 0 backends (aarch64-macos)
Slice 0 artifacts (x86-64)
Slice 0 artifacts (aarch64-macos)
Slice 0 trusted base (gate 9, x86-64)
Slice 0 trusted base (gate 9, aarch64-macos)
Reproducibility (linux-first)
Reproducibility (linux-independent)
Reproducibility (macos)
Cross-machine reproducibility (x86-64 Linux)
524:    die "check: no review command (LAND_REVIEW_CMD is unset and scripts/review/review.sh is missing); the review leg is required and is never skipped silently. Restore the reviewer, or pass --no-review explicitly (land still requires review provenance)"
594:    [ "$skip_check" = 1 ] || die "ci: no passing check recorded at ${head:0:10}; run train.sh check $name (or --skip-check, recorded as skipped)"
595:    log_row "$name" check skipped "--skip-check"
648:# Prints "<tier>\t<conclusion>\t<job id>\t<name>" per job of the run.
656:    print("\t".join([tier, j.get("conclusion") or "pending", str(j.get("databaseId", "")), name]))' "$CAMPAIGN_RE"
664:# conclusion is not success, is no verdict. GitHub branch protection is not configured for main, so
703:    read -r status concl sha <<< "$(run_field "$id" status conclusion headSha)" \
714:  bad_campaign="$(printf '%s\n' "$jobs" | awk -F'\t' '$1=="campaign" && $2!="success" && $2!="skipped"')"
734:    echo "train: run $id does not satisfy $REQUIRED_FILE; a missing, skipped or cancelled required job is no verdict:" >&2
750:    log_row "$name" watch landing-green "only the campaign tier failed (run conclusion $concl)"
756:    log_row "$name" watch passed "run conclusion $concl"
760:  # failed only when a landing job failed; otherwise (cancelled, skipped, pending) it is no verdict.
763:  log_row "$name" watch "$res" "run conclusion $concl"
