773:# When it does not hold, nothing is skipped: main's run runs every job itself. So main is green
859:# corrupt record and refuses the land outright rather than being skipped.
869:# stripped and a blank line skipped. An entry with a `/` is nested (docs/..., scripts/...).

exec
/bin/bash -lc "cat lakefile.toml lake-manifest.json; cat scripts/checks/lib/slice0_common.sh | head -30; rg -n 'scripts/checks/(slice0_|build_identity)' --hidden -g '"'!legacy/**'"' .; sed -n '660,742p' scripts/land/train.sh; cat ../delta.diff | sed -n '/diff --git a\\/docs/,/diff --git a\\/scripts\\/checks\\/compiler/p'; ls -la .." in /tmp/claude-30035/-home-unbalancedparen-projects-concrete2/e2c54e65-31b5-4145-8101-c2d7b071b97e/scratchpad/cv/tree
 succeeded in 0ms:
name = "concrete"
version = "0.2.0"
defaultTargets = ["ConcreteSpec"]

# The Lean Compiler Backend (LCB), pinned: slice 0's second backend. Its verified source semantics
# (LeanCompilerBackend.Verified.Source) is imported, never restated; core Lean only, no Mathlib.
[[require]]
name = "lean-compiler-backend"
git = "https://github.com/unbalancedparentheses/lean-compiler-backend"
rev = "4bea4b3ffd8a43a73a0016012d865044067b3275"

[leanOptions]
warningAsError = true

# The specification (ROADMAP A2, B): readable Lean with doc comments and conformance examples.
# Core Lean only; root ConcreteSpec.lean.
[[lean_lib]]
name = "ConcreteSpec"
leanOptions = { autoImplicit = false }

# The compiler (ROADMAP B0, slice 0; provisional): Lean code importing ConcreteSpec. Root Concrete.lean;
# design in Concrete/README.md.
[[lean_lib]]
name = "Concrete"
leanOptions = { autoImplicit = false }
{"version": "1.2.0",
 "packagesDir": ".lake/packages",
 "packages":
 [{"url": "https://github.com/unbalancedparentheses/lean-compiler-backend",
   "type": "git",
   "subDir": null,
   "scope": "",
   "rev": "4bea4b3ffd8a43a73a0016012d865044067b3275",
   "name": "«lean-compiler-backend»",
   "manifestFile": "lake-manifest.json",
   "inputRev": "4bea4b3ffd8a43a73a0016012d865044067b3275",
   "inherited": false,
   "configFile": "lakefile.toml"}],
 "name": "concrete",
 "lakeDir": ".lake",
 "fixedToolchain": false}
# shellcheck shell=bash
# Shared machinery of the slice-0 example gates (PROVISIONAL): slice0_backends.sh (gates 4, 6, 6a)
# and slice0_artifacts.sh (gates 10, 11, 12). Source it from the repository root, inside the nix
# devshell, with `set -euo pipefail`. It builds the compiler and LCB's command line under the
# gate's limits (lib/limits.sh: an address-space cap of SLICE0_GATE_MEM_GB GiB, default 64; 0 for
# a gate whose executables under test need no cap, slice0_artifacts.sh) and defines:
#   capped (a command prefix, an array): run under a 64 GiB address-space cap of its own, so
#     every build and analysis command is capped whatever the gate's cap;
#   bounded SECS CMD...: CMD under capped and bounded_run (the gates' only time bound);
#   root, work (removed on exit), lcb, target, emitter (the Lean emitter command, an array);
#   expected_timeout CMD...: CMD with its bounded runs logged apart (a control expecting a timeout);
#   observe EXE OUT SECS RETRY [MEM_MB [ENV...]]: run EXE under bounded_run (and limited_exec.sh
#     MEM_MB, default 1024) with ENV assignments; OUT.status (status or "incomplete"),
#     OUT.stdout, OUT.stderr;
#   judge EXPECTED_DIR OBS: the observation OBS.* equals the expectation, byte for byte;
#   build NAME LOG CMD...: run CMD, or print LOG and fail the gate;
#   emit_examples: the example names, one per line, failing if there are none;
#   cap_out: copy stdin to stdout, failing above 1 MiB: every command output a gate captures
#     into a variable goes through it, so no producer can grow the gate's shell (which may run
#     with no address-space cap, see SLICE0_GATE_MEM_GB) without bound.
root=$(pwd)
work=$(mktemp -d)
# On every exit, the bounded-run summary (recovered and INCOMPLETE runs, whatever a caller did
# with a command's stderr) goes to the gate's stdout before the scratch directory is removed, and a
# gate that would pass with an INCOMPLETE run exits 3 instead (INCOMPLETE is never a pass).
trap 'rc=$?; bounded_summary || true
  if [ "$rc" = 0 ] && grep -Eqs "^(incomplete|runner-failed)" "${BOUNDED_LOG:-/nonexistent}"; then
    echo "INCOMPLETE: a bounded run timed out twice; not a pass"; rc=3
  fi
  rm -rf "${work:?}"; exit "$rc"' EXIT
# changes the set, required-checks-transition.tsv. scripts/land/required_checks.py is the one owner
# of the rule (its header): the candidate's list plus every base requirement, except one the
# candidate drops through an explicit transition row (replaced by jobs it requires, or retired with
# a reason, reported as retired and never as passed). A required job absent from the run, or whose
# conclusion is not success, is no verdict. GitHub branch protection is not configured for main, so
# these files are the record of what is required.
REQUIRED_FILE="${LAND_REQUIRED_CHECKS_FILE:-required-checks.txt}"
TRANSITION_FILE="${LAND_REQUIRED_TRANSITION_FILE:-required-checks-transition.tsv}"
# Prints required_checks.py's findings for base, head and the run's jobs.
required_report() { # base head jobs
  local d; d="$(mktemp -d)" || return 1
  git show "$1:$REQUIRED_FILE" > "$d/base" 2>/dev/null || : > "$d/base"
  git show "$2:$REQUIRED_FILE" > "$d/cand" 2>/dev/null || : > "$d/cand"
  git show "$2:$TRANSITION_FILE" > "$d/trans" 2>/dev/null || : > "$d/trans"
  printf '%s\n' "$3" > "$d/jobs"
  python3 -I "$SELF_DIR/required_checks.py" "$d/base" "$d/cand" "$d/trans" "$d/jobs"; local rc=$?
  rm -rf "$d"; return "$rc"
}
# Prints the unmet lines (anything but a note); empty when the requirements are met.
unmet_required() { # base head jobs
  local r; r="$(required_report "$@")" || { echo "invalid: required_checks.py failed"; return 0; }
  printf '%s\n' "$r" | awk '/./ && !/^(retired|replaced|stale): /'
}
required_notes() { # base head jobs
  required_report "$@" 2>/dev/null | awk '/^(retired|replaced|stale): /' | sed 's/^/train: requirement /' || true
}

cmd_watch() {
  local name="" interval=60 timeout=$((4*3600))
  while [ $# -gt 0 ]; do
    case "$1" in
      --interval) interval="$2"; shift ;;
      --timeout) timeout="$2"; shift ;;
      -*) die "watch: unknown option $1" ;;
      *) name="$1" ;;
    esac; shift
  done
  valid_name "$name"
  stage_start
  local id; id="$(state_get "$name" run_id)"
  [ -n "$id" ] || die "watch: no CI run recorded for $name (train.sh ci $name)"
  local status="" concl="" sha="" waited=0
  while :; do
    read -r status concl sha <<< "$(run_field "$id" status conclusion headSha)" \
      || die "watch: cannot read run $id"
    [ -n "$status" ] || die "watch: cannot read run $id"
    [ "$status" = completed ] && break
    [ "$waited" -ge "$timeout" ] && { log_row "$name" watch incomplete "timeout after ${waited}s, status $status"; die "watch: run $id still $status after ${waited}s (a timeout is not a result)"; }
    note "run $id: $status ($(run_jobs "$id" | cut -f2 | sort | uniq -c | tr -s ' \n' ' '))"
    sleep "$interval"; waited=$((waited + interval))
  done
  local jobs; jobs="$(run_jobs "$id")"
  local bad_landing bad_campaign
  bad_landing="$(printf '%s\n' "$jobs" | awk -F'\t' '$1=="landing" && $2!="success"')"
  bad_campaign="$(printf '%s\n' "$jobs" | awk -F'\t' '$1=="campaign" && $2!="success" && $2!="skipped"')"
  # The verdict must describe THIS train: its exact head, with a non-empty landing tier. Otherwise
  # it is no verdict (bisect --ci consumes this exit status).
  local head; head="$(state_get_soft "$name" head)"
  if [ "$sha" != "$head" ]; then
    log_row "$name" watch refused "run $id at $sha"
    echo "train: run $id ran ${sha:0:10}, not the train head ${head:0:10}; it says nothing about this train" >&2
    return 1
  fi
  # awk reads all of its input: `| grep -q` under pipefail can SIGPIPE the writer and flip the test.
  if [ "$(printf '%s\n' "$jobs" | awk -F'\t' '$1=="landing"{n++} END{print n+0}')" = 0 ]; then
    log_row "$name" watch refused "no landing-tier jobs"
    echo "train: run $id has no landing-tier jobs; an empty set is not green" >&2
    return 1
  fi
  local base unmet; base="$(state_get_soft "$name" base)"
  required_notes "$base" "$head" "$jobs"
  unmet="$(unmet_required "$base" "$head" "$jobs")"
  if [ -n "$unmet" ]; then
    log_row "$name" watch incomplete "required checks unmet"
    echo "train: run $id does not satisfy $REQUIRED_FILE; a missing, skipped or cancelled required job is no verdict:" >&2
    printf '    %s\n' "$unmet" >&2
    [ -z "$bad_landing" ] && return 1
  fi
  if [ -n "$bad_landing$bad_campaign" ]; then
    note "jobs that did not succeed:"
    printf '%s\n' "$bad_landing" "$bad_campaign" | sed '/^$/d' | awk -F'\t' '{printf "    [%s] %-10s %s\n", $1, $2, $4}'
    local line jid jname jc
    while IFS=$'\t' read -r _t jc jid jname; do
