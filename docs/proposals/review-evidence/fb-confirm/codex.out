    62	# path_class PATH → docs | scripts | compiler (anything unlisted is compiler: the highest class)
    63	path_class() {
    64	  case "$1" in
    65	    docs/*|changelog.d/*|ROADMAP.md|CHANGELOG.md|README.md|AGENTS.md|CLAUDE.md) echo docs ;;
    66	    scripts/*|.githooks/*|.github/*|.claude/*|required-checks.txt|required-checks-transition.tsv) echo scripts ;;
    67	    *) echo compiler ;;
