     1	#!/usr/bin/env bash
     2	# Pre-push gate for the restarted root.
     3	#
     4	# A push that can reach main or a ci/* candidate builds the specification and runs every root check
     5	# (scripts/checks/run.sh), the same set CI's "Root checks" and "Spec build" jobs run. The set is small
     6	# and fast, so there is no selection: everything runs on every such push. legacy/ is frozen and never
     7	# run; scripts/checks/legacy_frozen.sh is the only check that looks at it.
     8	#
     9	# Tiers decided from git's ref lines on stdin (`<local ref> <local sha> <remote ref> <remote sha>`):
    10	#   - only refs/heads/wip/* updates or deletions: a backup of unfinished work, which can never become
    11	#     main. Conflict markers are refused; nothing else runs.
    12	#   - only the review-note refs (refs/notes/concrete-review, refs/notes/concrete-review-findings,
    13	#     written by scripts/review/review.sh) and owner sign-off records (refs/owner-signoff/<sha>,
    14	#     written by scripts/land/signoff.sh): no source tree, nothing to check.
    15	#   - anything else, including a by-hand run with no stdin: the full root set, and only from a full
    16	#     clone (a linked worktree is refused; ISS-0015).
    17	#
    18	# Deliberate bypass:  CONCRETE_SKIP_GATES=1 git push   (you then own the CI result)
    19	set -uo pipefail
    20	HOOK_SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
    21	# train.sh asks the hook git would run which hook it is (ISS-0015): called with the single argument
    22	# --concrete-identify (git always passes a remote name and URL, never this), this one answers with
    23	# its real path and runs nothing. A wrapper that passes its arguments on to it (acceptance.sh's
    24	# guard) gets the same answer; a hook that never runs this one gives none. An argument, not an
    25	# environment variable, so nothing a push inherits can turn the gates off.
    26	if [ "$#" = 1 ] && [ "$1" = --concrete-identify ]; then
    27	  echo "concrete-pre-push $(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
    28	  exit 0
    29	fi
    30	ROOT_DIR="$(git rev-parse --show-toplevel)"
    31	cd "$ROOT_DIR"
    32	
    33	if [ "${CONCRETE_SKIP_GATES:-0}" = "1" ]; then
    34	  echo "pre-push: gates SKIPPED by CONCRETE_SKIP_GATES=1 — you own the CI result." >&2
    35	  exit 0
    36	fi
    37	
    38	wip_refs=0; wip_dels=0; note_refs=0; other_refs=0; wip_shas=""; full_shas=""
    39	# Kept whole so the hook can hand the same lines to itself when it re-enters the gate shell (below).
    40	HOOK_STDIN="$(cat)"
    41	while read -r _localref localsha remoteref _remotesha; do
    42	  [ -z "${localsha:-}" ] && continue
    43	  case "${remoteref:-}" in
    44	    refs/heads/wip/*)
    45	      case "$localsha" in
    46	        *[!0]*) wip_refs=$((wip_refs+1)); wip_shas="$wip_shas $localsha" ;;
    47	        *) wip_dels=$((wip_dels+1)) ;;
    48	      esac ;;
    49	    refs/owner-signoff/*)
    50	      # Only a record takes the notes tier: a parentless commit, under its subject's 40-hex name, whose
    51	      # tree is exactly the sign-off's seven plain files (record.txt plus each reviewer's request and
    52	      # output), no directory among them. Anything else pushed here, including the old four-file shape
    53	      # or a source commit, takes the full tier, as does a deletion.
    54	      if [[ "${remoteref#refs/owner-signoff/}" =~ ^[0-9a-f]{40}$ ]] && [ "$(git rev-list --parents -n 1 "$localsha" 2>/dev/null)" = "$localsha" ] \
    55	         && [ "$(git ls-tree --format='%(objectmode) %(objecttype) %(path)' "$localsha" 2>/dev/null | LC_ALL=C sort | tr '\n' ' ')" \
    56	              = "100644 blob agy-request.txt 100644 blob agy.txt 100644 blob codex-request.txt 100644 blob codex.txt 100644 blob kimi-request.txt 100644 blob kimi.txt 100644 blob record.txt " ]; then
    57	        note_refs=$((note_refs+1))
    58	      else
    59	        other_refs=$((other_refs+1))
    60	        case "$localsha" in *[!0]*) full_shas="$full_shas $localsha" ;; esac
    61	      fi ;;
    62	    refs/notes/concrete-review|refs/notes/concrete-review-findings)
    63	      case "$localsha" in
    64	        *[!0]*) note_refs=$((note_refs+1)) ;;
    65	        *) other_refs=$((other_refs+1)) ;;   # deleting a review note takes the full tier
    66	      esac ;;
    67	    *) other_refs=$((other_refs+1))
    68	       case "$localsha" in *[!0]*) full_shas="$full_shas $localsha" ;; esac ;;
    69	  esac
    70	done <<< "$HOOK_STDIN"
    71	
    72	if [ "$other_refs" -eq 0 ] && [ $((wip_refs + wip_dels)) -gt 0 ]; then
    73	  bad=""
    74	  for sha in $wip_shas; do
    75	    rc=0; git grep -qE '^(<{7}|>{7}|\|{7})( |$)|^={7}$' "$sha" -- . ':(exclude)legacy/' >/dev/null 2>&1 || rc=$?
    76	    case "$rc" in
    77	      0) bad="$bad $sha" ;;
    78	      1) ;;
    79	      *) echo "pre-push (wip tier): could not scan $sha (git grep exit $rc) — refusing"; exit 1 ;;
    80	    esac
    81	  done
    82	  [ -z "$bad" ] || { echo "pre-push (wip tier): conflict markers in$bad — refusing"; exit 1; }
    83	  echo "pre-push: wip/* backup push ($wip_refs update(s), $wip_dels deletion(s)) — conflict-marker check only; the full set runs on ci/* and main"
    84	  exit 0
    85	fi
    86	if [ "$other_refs" -eq 0 ] && [ "$note_refs" -gt 0 ]; then
    87	  echo "pre-push: review-notes push (review notes, owner sign-offs) — no source tree, no gates"
    88	  exit 0
    89	fi
    90	
    91	# The checks build sandbox repositories, and a linked worktree hands its hook
    92	# GIT_DIR=<repo>/.git/worktrees/<name>: on 2026-11-06 that turned a review-tool check into writes on a
    93	# real clone and on GitHub (ISS-0015). Every repository-making script now clears git's variables, and
    94	# as a second wall a push that runs the checks must come from a full clone. The wip and notes tiers
    95	# above run nothing, so a worktree may still back up its branch.
    96	if [ "$(cd "$(git rev-parse --git-dir)" && pwd -P)" != "$(cd "$(git rev-parse --git-common-dir)" && pwd -P)" ]; then
    97	  echo "pre-push: refusing: this push runs the root checks, and $ROOT_DIR is a linked worktree; push it from a full clone (git clone), never a worktree." >&2
    98	  exit 1
    99	fi
   100	
   101	# The checks run in the gate shell (scripts/checks/lib/gate_env.sh refuses anywhere else). From
   102	# outside it, the hook re-executes itself inside `nix develop` with the same arguments and stdin.
   103	if [ "${CONCRETE_GATES_SHELL:-}" != 1 ] || ! command -v lake >/dev/null 2>&1; then
   104	  if [ "${CONCRETE_PREPUSH_REENTERED:-0}" = 1 ]; then
   105	    echo "pre-push: nix develop did not provide the gate shell with Lean — refusing to push." >&2; exit 1
   106	  fi
   107	  command -v nix >/dev/null 2>&1 || {
   108	    echo "pre-push: the checks run inside nix develop, and nix is not on PATH — refusing to push." >&2; exit 1; }
   109	  echo "pre-push: entering nix develop for the checks"
   110	  CONCRETE_PREPUSH_REENTERED=1 exec nix develop "$ROOT_DIR" --command bash "$HOOK_SELF" "$@" <<< "$HOOK_STDIN"
   111	fi
   112	
   113	# The checks judge the work tree, so it must be the commit being pushed, unmodified.
   114	head="$(git rev-parse HEAD)"
   115	for sha in $full_shas; do
   116	  [ "$sha" = "$head" ] || {
   117	    echo "pre-push: pushing ${sha:0:10}, but the checkout is at ${head:0:10}; the checks would judge the wrong commit — check it out and push from there." >&2
   118	    exit 1; }
   119	done
   120	if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
   121	  echo "pre-push: the work tree has uncommitted changes to tracked files; the checks would not judge what is pushed — refusing." >&2
   122	  exit 1
   123	fi
   124	
   125	echo "pre-push: building the specification…"
   126	BUILD_LOG="$(mktemp "${TMPDIR:-/tmp}/prepush-build.XXXXXX")" || BUILD_LOG=/dev/null
   127	lake build >"$BUILD_LOG" 2>&1 || { echo "pre-push: BUILD FAILED — see $BUILD_LOG" >&2; exit 1; }
   128	
   129	echo "pre-push: root checks…"
   130	bash scripts/checks/run.sh || { echo "pre-push: ROOT CHECKS FAILED (above) — fix, or bypass deliberately." >&2; exit 1; }
   131	echo "pre-push: build and root checks pass"
   132	exit 0
   260	g checkout -q main && g checkout -qb refuse-always
   261	commit_file Concrete/Own.lean "$(printf 'line %s\n' $(seq 1 40))
   262	MARK_REFUSE_ALWAYS" "ownership change"
   263	review >"$T/out4" 2>&1; rc=$?
   264	check "refused twice: blocked, exit 5 (got $rc)" test "$rc" -eq 5
   265	check "note: verdict blocked" test "$(field verdict)" = blocked
   266	check "no loop: one standard call and one retry pass ($(calls) calls)" test "$(calls)" -ge 2 -a "$(calls)" -le 3
   267	check "blocked piece listed in the output" grep -q "blocked" "$T/out4"
   268	reset_fake
   269	review >/dev/null 2>&1; rc=$?
   270	check "a blocked HEAD may be re-run; it counts as round 2" test "$(field rounds)" = 2 -a "$rc" -eq 5
   271	check "the re-run reviews the whole branch again (blocked does not advance the delta)" \
   272	  grep -q "complete change of a branch" "$FAKE_LOG/prompt.1"
   273	
   274	echo "=== findings in one piece, another piece blocked ==="
   275	reset_fake
   276	g checkout -q main && g checkout -qb mixed
   277	commit_file a.txt "MARK_FINDING here" "a finding"
   278	commit_file Concrete/Own.lean "MARK_REFUSE_ALWAYS" "a refusal"
   279	review >"$T/out8" 2>&1; rc=$?
   280	check "blocked wins over findings: verdict blocked, exit 5 (got $rc, $(field verdict))" \
   281	  test "$rc" -eq 5 -a "$(field verdict)" = blocked
   282	check "the reviewed piece's findings are still recorded" \
   283	  bash -c "git -C '$W' notes --ref=refs/notes/concrete-review-findings show HEAD | has_match 'counter is never reset'"
   284	commit_file b.txt "more" "more work"
   285	reset_fake
   286	review >/dev/null 2>&1
   287	check "next round restarts from the base, not after the blocked round" grep -q "complete change of a branch" "$FAKE_LOG/prompt.1"
   288	check "and carries the blocked round's findings forward" grep -q "counter is never reset" "$FAKE_LOG/prompt.1"
   289	# A blocked round that finds nothing new must still hand the old finding on.
   290	commit_file a.txt "MARK_REFUSE_ALWAYS" "rewrite a.txt"
   291	review >/dev/null 2>&1
   292	check "a blocked round with no findings of its own records the carried ones" \
   293	  bash -c "git -C '$W' notes --ref=refs/notes/concrete-review-findings show HEAD | has_match 'counter is never reset'"
   294	commit_file c.txt "c" "c"
   295	reset_fake
   296	review >/dev/null 2>&1
   297	check "after two blocked rounds in a row the finding still reaches the prompt" \
   298	  grep -q "counter is never reset" "$FAKE_LOG/prompt.1"
   299	
   300	echo "=== pre-push hook: a review-notes push runs no gates ==="
   301	HOOK="$ROOT_DIR/.githooks/pre-push"
   302	Z=0000000000000000000000000000000000000000
   303	NOTES_SHA="$(g rev-parse refs/notes/concrete-review)"
   304	hook_out="$(cd "$W" && printf 'refs/notes/concrete-review %s refs/notes/concrete-review %s\nrefs/notes/concrete-review-findings %s refs/notes/concrete-review-findings %s\n' \
   305	  "$NOTES_SHA" "$Z" "$(g rev-parse refs/notes/concrete-review-findings)" "$Z" | bash "$HOOK" 2>&1)"; rc=$?
   306	check "notes-only push: hook exits 0 (got $rc)" test "$rc" -eq 0
   307	check "notes-only push: hook takes the review-notes tier" grep -q "review-notes push" <<<"$hook_out"
   308	# Owner sign-off refs: only a record (parentless, its subject's 40-hex name, exactly the seven files)
   309	# takes the notes tier. Anything else takes the full tier, which a linked worktree refuses before it
   310	# runs anything: that refusal is how these legs see the tier without running the gates.
   311	SO_BLOB="$(printf 'x\n' | g hash-object -w --stdin)"
   312	SO_TREE="$(printf '100644 blob %s\tagy-request.txt\n100644 blob %s\tagy.txt\n100644 blob %s\tcodex-request.txt\n100644 blob %s\tcodex.txt\n100644 blob %s\tkimi-request.txt\n100644 blob %s\tkimi.txt\n100644 blob %s\trecord.txt\n' "$SO_BLOB" "$SO_BLOB" "$SO_BLOB" "$SO_BLOB" "$SO_BLOB" "$SO_BLOB" "$SO_BLOB" | g mktree)"
   313	SO_REC="$(g commit-tree "$SO_TREE" -m record)"; SO_SUBJ="$(g rev-parse HEAD)"
   314	SO_OLD_TREE="$(printf '100644 blob %s\tagy.txt\n100644 blob %s\tcodex.txt\n100644 blob %s\tkimi.txt\n100644 blob %s\trecord.txt\n' "$SO_BLOB" "$SO_BLOB" "$SO_BLOB" "$SO_BLOB" | g mktree)"
   315	SO_OLD_REC="$(g commit-tree "$SO_OLD_TREE" -m old-record)"
   316	g worktree add -q --detach "$T/so-wt" HEAD
   317	so_hook(){ (cd "$T/so-wt" && printf '%s %s %s %s\n' "$1" "$2" "$1" "$Z" | CONCRETE_GATES_SHELL= bash "$HOOK" origin x 2>&1); }
   318	hook_out="$(so_hook "refs/owner-signoff/$SO_SUBJ" "$SO_REC")"; rc=$?
   319	check "a seven-file owner sign-off record takes the review-notes tier (exit $rc)" \
   320	  bash -c "[ $rc -eq 0 ] && grep -q 'review-notes push' <<<'$hook_out'"
   321	hook_out="$(so_hook "refs/owner-signoff/$SO_SUBJ" "$SO_OLD_REC")"; rc=$?
   322	check "the old four-file owner sign-off shape takes the full tier (exit $rc)" \
   323	  bash -c "[ $rc -eq 1 ] && grep -q 'is a linked worktree' <<<'$hook_out'"
   324	hook_out="$(so_hook "refs/owner-signoff/$SO_SUBJ" "$SO_SUBJ")"; rc=$?
   325	check "a source commit pushed as a sign-off takes the full tier (exit $rc)" \
   326	  bash -c "[ $rc -eq 1 ] && grep -q 'is a linked worktree' <<<'$hook_out'"
   327	SO_DTREE="$(printf '100644 blob %s\tsrc.lean\n' "$SO_BLOB" | g mktree)"
   328	SO_DIRS="$(g commit-tree "$(printf '040000 tree %s\tagy-request.txt\n040000 tree %s\tagy.txt\n040000 tree %s\tcodex-request.txt\n040000 tree %s\tcodex.txt\n040000 tree %s\tkimi-request.txt\n040000 tree %s\tkimi.txt\n040000 tree %s\trecord.txt\n' "$SO_DTREE" "$SO_DTREE" "$SO_DTREE" "$SO_DTREE" "$SO_DTREE" "$SO_DTREE" "$SO_DTREE" | g mktree)" -m dirs)"
   329	hook_out="$(so_hook "refs/owner-signoff/$SO_SUBJ" "$SO_DIRS")"; rc=$?
   330	check "seven directories named like a record's files take the full tier (exit $rc)" \
   331	  bash -c "[ $rc -eq 1 ] && grep -q 'is a linked worktree' <<<'$hook_out'"
   332	hook_out="$(so_hook "refs/owner-signoff/not-a-sha" "$SO_REC")"; rc=$?
   333	check "a record under a name that is no SHA takes the full tier (exit $rc)" \
   334	  bash -c "[ $rc -eq 1 ] && grep -q 'is a linked worktree' <<<'$hook_out'"
   335	g worktree remove --force "$T/so-wt"
   336	hook_out="$(cd "$W" && printf 'refs/heads/mixed %s refs/heads/wip/x %s\nrefs/notes/concrete-review %s refs/notes/concrete-review %s\n' \
   337	  "$(g rev-parse HEAD)" "$Z" "$NOTES_SHA" "$Z" | bash "$HOOK" 2>&1)"; rc=$?
   338	check "notes alongside a wip push take the wip tier (exit $rc)" \
   339	  bash -c "[ $rc -eq 0 ] && grep -q 'wip/\* backup push' <<<'$hook_out'"
   340	
   341	echo "=== splitting by file group and size ==="
   342	reset_fake
   343	g checkout -q main && g checkout -qb split
   344	mkdir -p "$W/Concrete" "$W/tests" "$W/docs" "$W/scripts"
   345	for i in 1 2 3; do printf 'def f%s := %s\n' "$i" "$i" >"$W/Concrete/M$i.lean"; done
   346	printf 'test\n' >"$W/tests/t.con"
   347	printf 'doc\n' >"$W/docs/d.md"
   348	printf 'echo hi\n' >"$W/scripts/s.sh"
   349	seq 1 400 | sed 's/^/big line /' >"$W/Concrete/Big.lean"
   350	g add -A && g commit -qm "spread change"
#!/usr/bin/env bash
# Bounded runs: a timeout is INCOMPLETE, never a failure and never a pass.
#
# The rule (docs/project/PROMOTION_PIPELINE.md, result vocabulary): a test that exceeds its time budget
# has produced no observation. Under machine load a freshly linked binary or a compile can overrun
# a budget sized for an idle machine (test_ssa.sh once reported hundreds of 5-second alarms as
# failures), so a timeout is re-run once, alone, with a larger budget:
#   - the re-run completes      -> its result is judged normally (pass or FAIL), recorded "recovered";
#   - the re-run times out too  -> INCOMPLETE: not a pass, not a failure. A gate with an incomplete
#                                  result exits nonzero, and a qualifying run contains none.
#
# Each attempt runs under lib/bounded_exec.py, which makes the command the leader of a new process
# group, reports its outcome through a status file (never through the command's own streams, so
# nothing the command prints can fake or hide a timeout) and, when the budget expires, sends SIGTERM
# and then SIGKILL to the whole group, so no descendant outlives the attempt into the retry.
#
# Sourcing (`BOUNDED_PARENT="$TMP"; source scripts/checks/lib/bounded.sh`) gives the gate PRIVATE
# state: a fresh directory (mktemp under BOUNDED_PARENT, else $TMPDIR) with an outcome file and a
# log. Every sourcing creates its own directory, so nested or parallel gates never share state.
# With BOUNDED_PARENT under the gate's own scratch directory, its cleanup removes the state too.
#
#   bounded_run [-i STDIN_FILE] [-r RETRY_SECS] SECS -- CMD [ARGS...]
#     Runs CMD (an executable, not a shell function). Its stdout and stderr are buffered per
#     attempt and only a COMPLETED attempt's output is written: an incomplete run writes nothing,
#     so output-matching checks never pass on the partial output of a run that hung. Without -i the
#     command inherits stdin, which a re-run cannot replay: callers that feed input pass -i.
#     Returns CMD's status, or 124 when it timed out on both attempts or the runner reported no
#     outcome. SECS and RETRY_SECS are positive decimal seconds. A command may itself exit
#     124, so test with `bounded_is_incomplete "$rc"`, which also reads the outcome bounded_run
#     recorded (this works across `( cd dir && bounded_run ... )` subshells; run one bounded_run
#     at a time per sourcing). RETRY_SECS defaults to BOUNDED_RETRY_FACTOR (2) times SECS.
#   bounded_summary
#     Lists this gate's recovered and incomplete runs; gates print it before their final tally.
#   bounded_watchdog SECS  -> sets the array TO for the watchdog form: "${TO[@]}" CMD [ARGS...]
#     runs CMD through `bash bounded.sh SECS` in a separate process with the same retry; on a second
#     timeout it writes no command output, prints "INCOMPLETE: ..." on stderr and exits 124. Its
#     recovered and incomplete lines go to this gate's log (handed over on its command line).
#   bounded_gate_status
#     The end-of-gate verdict for a gate using the watchdog form: lists recovered, incomplete and
#     runner-failed runs, removes the state directory, and returns 1 when any run was incomplete or
#     the runner failed, so the gate exits nonzero whatever its own checks concluded from a hung
#     command's empty output. Last line:
#       bounded_gate_status && [ "$FAIL" -eq 0 ]
#
# If the runner itself fails (no outcome reported), the command's output is discarded and the run
# is incomplete (status 124, a "runner-failed" log line): never a pass. If the runner is cancelled (the
# gate is interrupted or terminated), it kills the command's group first.
#
# Without python3 commands run directly with no watchdog: one warning when the gate sources this
# file, never inside a command's output, and the watchdog form then runs commands directly too.
# Such a run is never incomplete.

BOUNDED_RETRY_FACTOR="${BOUNDED_RETRY_FACTOR:-2}"
if [[ "$BOUNDED_RETRY_FACTOR" =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk -v f="$BOUNDED_RETRY_FACTOR" 'BEGIN { exit !(f + 0 >= 1) }'; then :
else echo "bounded.sh: BOUNDED_RETRY_FACTOR must be a number >= 1; using 2" >&2; BOUNDED_RETRY_FACTOR=2; fi
# _bounded_secs_ok S: S is a positive decimal number of seconds (fractions allowed).
_bounded_secs_ok() { [[ "$1" =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk -v s="$1" 'BEGIN { exit !(s + 0 > 0) }'; }
# Fixed-point, trailing zeros trimmed: never scientific notation, which _bounded_secs_ok rejects.
_bounded_mul() { awk -v s="$1" -v f="$2" 'BEGIN { r = sprintf("%.6f", s * f); sub(/0+$/, "", r); sub(/\.$/, "", r); print r }'; }
BOUNDED_SH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
BOUNDED_EXEC="$(dirname "$BOUNDED_SH")/bounded_exec.py"
BOUNDED_DIR="$(mktemp -d "${BOUNDED_PARENT:-${TMPDIR:-/tmp}}/bounded.XXXXXX")"
BOUNDED_OUTCOME_FILE="$BOUNDED_DIR/outcome"
BOUNDED_LOG="$BOUNDED_DIR/log"
# The watchdog form appends to its caller's log, handed over explicitly on its command line.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  # A standalone watchdog removes its state however it ends.
  trap 'rm -rf "$BOUNDED_DIR"' EXIT
  [ -z "${BOUNDED_WATCHDOG_LOG:-}" ] || BOUNDED_LOG="$BOUNDED_WATCHDOG_LOG"
fi
: >> "$BOUNDED_LOG"
BOUNDED_HAVE_WATCHDOG=1
if ! command -v python3 >/dev/null 2>&1; then
  BOUNDED_HAVE_WATCHDOG=0
  [ "${BASH_SOURCE[0]}" = "$0" ] || echo "  warn python3 not found — commands run without a hang watchdog" >&2
fi

bounded_is_incomplete() {
  [ "$1" = 124 ] && [ "$(cat "$BOUNDED_OUTCOME_FILE" 2>/dev/null)" = incomplete ]
}

bounded_run() {
  local stdin_file="" retry="" secs="" rc tries=0 budget tmp outcome
  while [ $# -gt 0 ]; do
    case "$1" in
      -i) stdin_file="$2"; shift 2 ;;
      -r) retry="$2"; shift 2 ;;
      --) shift; break ;;
      *) if [ -z "$secs" ]; then secs="$1"; shift; else break; fi ;;
    esac
  done
  [ -n "$secs" ] && [ $# -gt 0 ] || { echo "bounded_run: usage: bounded_run [-i FILE] [-r SECS] SECS -- CMD..." >&2; return 2; }
  [ -n "$retry" ] || retry="$(_bounded_mul "$secs" "$BOUNDED_RETRY_FACTOR")"
  if ! _bounded_secs_ok "$secs" || ! _bounded_secs_ok "$retry"; then
    echo "bounded_run: budgets must be positive numbers of seconds (got $secs, retry $retry)" >&2; return 2
  fi
  echo done > "$BOUNDED_OUTCOME_FILE"
  if [ "$BOUNDED_HAVE_WATCHDOG" != 1 ]; then
    if [ -n "$stdin_file" ]; then "$@" < "$stdin_file"; else "$@"; fi
    return $?
  fi
  tmp="$(mktemp -d "$BOUNDED_DIR/run.XXXXXX")"
  budget="$secs"
  while :; do
    tries=$((tries + 1))
    rm -f "$tmp/status"
    if [ -n "$stdin_file" ]; then
      python3 -I "$BOUNDED_EXEC" --timeout "$budget" --kill-after "${BOUNDED_KILL_AFTER:-10}" --status "$tmp/status" -- "$@" < "$stdin_file" > "$tmp/out" 2> "$tmp/err"
    else
      python3 -I "$BOUNDED_EXEC" --timeout "$budget" --kill-after "${BOUNDED_KILL_AFTER:-10}" --status "$tmp/status" -- "$@" > "$tmp/out" 2> "$tmp/err"
    fi
    outcome="$(cat "$tmp/status" 2>/dev/null)"
    case "$outcome" in
      "exit "*) break ;;
      timeout) [ "$tries" = 1 ] || break; budget="$retry" ;;
      *) outcome=runner-failed; break ;;
    esac
  done
  if [ "$outcome" = timeout ]; then
    echo incomplete > "$BOUNDED_OUTCOME_FILE"
    echo "incomplete ${secs}s+${retry}s $*" >> "$BOUNDED_LOG"
    rc=124
  elif [ "$outcome" = runner-failed ]; then
    # The runner reported nothing (it failed or was cancelled): no observation, so the run is
    # incomplete exactly as a double timeout is (status 124, bounded_is_incomplete true).
    echo "bounded_run: the runner reported no outcome for: $*" >&2
    echo incomplete > "$BOUNDED_OUTCOME_FILE"
    echo "runner-failed ${secs}s $*" >> "$BOUNDED_LOG"
    rc=124
  else
    cat "$tmp/out"; cat "$tmp/err" >&2
    rc="${outcome#exit }"
    [ "$tries" = 2 ] && echo "recovered ${secs}s $*" >> "$BOUNDED_LOG"
  fi
  rm -rf "$tmp"
  return "$rc"
}

bounded_summary() {
  local nrec ninc
  nrec=$(grep -c '^recovered' "$BOUNDED_LOG" 2>/dev/null || true); nrec=${nrec:-0}
  ninc=$(grep -c '^incomplete\|^runner-failed' "$BOUNDED_LOG" 2>/dev/null || true); ninc=${ninc:-0}
  [ "$nrec" -gt 0 ] || [ "$ninc" -gt 0 ] || return 0
  echo "Bounded runs: $nrec recovered (timed out, then completed alone), $ninc incomplete (timed out twice, or the runner failed):"
  sed 's/^/  /' "$BOUNDED_LOG"
}

bounded_watchdog() {
  if [ "$BOUNDED_HAVE_WATCHDOG" = 1 ]; then
    TO=(env "BOUNDED_WATCHDOG_LOG=$BOUNDED_LOG" "BOUNDED_PARENT=$BOUNDED_DIR" bash "$BOUNDED_SH" "$1")
  else
    TO=(env)  # no python3: run commands directly (the gate warned once when it sourced this file)
  fi
}

bounded_gate_status() {
  local ninc
  bounded_summary
  ninc=$(grep -c '^incomplete\|^runner-failed' "$BOUNDED_LOG" 2>/dev/null || true); ninc=${ninc:-0}
  [ "$ninc" -eq 0 ] || echo "INCOMPLETE: $ninc command(s) timed out twice or lost their runner: this run is incomplete, not passed"
  rm -rf "$BOUNDED_DIR"
  [ "$ninc" -eq 0 ]
}

# Watchdog form: `bash bounded.sh SECS CMD...` (through bounded_watchdog's TO array).
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  [ $# -ge 2 ] || { echo "usage: bash $0 SECS CMD [ARGS...]" >&2; exit 2; }
  secs="$1"; shift
  bounded_run "$secs" -- "$@"; rc=$?
  if bounded_is_incomplete "$rc"; then
    echo "INCOMPLETE: timed out twice (${secs}s, then $(_bounded_mul "$secs" "$BOUNDED_RETRY_FACTOR")s alone) or lost its runner: $*" >&2
  fi
  exit "$rc"
fi

