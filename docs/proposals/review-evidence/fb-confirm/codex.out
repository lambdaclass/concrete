    77	  return 1
    78	}
    79	class_cap() { case "$1" in docs) echo 2 ;; scripts) echo 3 ;; *) echo 5 ;; esac; }
    80	# diff_class SHA BASE → the highest class among the paths SHA changes against its merge base with BASE
    81	diff_class() {
    82	  local mb p c best=docs
    83	  mb="$(git merge-base "$2" "$1")" || return 1
    84	  while IFS= read -r p; do
