diff --git a/scripts/land/systemd/concrete-landing-bot.service b/scripts/land/systemd/concrete-landing-bot.service
deleted file mode 100644
index bbc5c0a10..000000000
--- a/scripts/land/systemd/concrete-landing-bot.service
+++ /dev/null
@@ -1,17 +0,0 @@
-# One landing-bot tick (scripts/land/bot.sh tick), installed for user `dev` by
-# scripts/land/install-bot.sh and started by concrete-landing-bot.timer. A tick that watches CI can
-# take hours. The timer never starts a second tick while this one is active, and the bot's own lock
-# refuses a second instance started by hand.
-[Unit]
-Description=Concrete landing bot (one tick)
-After=network-online.target
-Wants=network-online.target
-
-[Service]
-Type=oneshot
-EnvironmentFile=%h/.config/concrete-landing-bot.env
-ExecStart=%h/.local/libexec/concrete-landing-bot tick
-TimeoutStartSec=8h
-Nice=5
-StandardOutput=append:%h/.local/state/concrete-landing-bot.log
-StandardError=append:%h/.local/state/concrete-landing-bot.log
diff --git a/scripts/land/systemd/concrete-landing-bot.timer b/scripts/land/systemd/concrete-landing-bot.timer
deleted file mode 100644
index 822f742dd..000000000
--- a/scripts/land/systemd/concrete-landing-bot.timer
+++ /dev/null
@@ -1,12 +0,0 @@
-# Starts a landing-bot tick 10 minutes after the previous one finished (and 5 minutes after boot).
-[Unit]
-Description=Concrete landing bot timer
-
-[Timer]
-OnBootSec=5min
-OnActiveSec=2min
-OnUnitInactiveSec=10min
-Unit=concrete-landing-bot.service
-
-[Install]
-WantedBy=timers.target
