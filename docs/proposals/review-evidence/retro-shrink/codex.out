-echo "=== the bot's snapshot holds every path the landing scripts read ==="
-# install-bot.sh's SNAPSHOT is what the launcher extracts; train.sh, bot.sh and their helpers run
-# from that copy. Every `$SELF_DIR/../X` a landing script reads, and every sibling a snapshot library
-# sources, must be in it (2026-11-08: verify.sh was not, and review_provenance refused every train).
-# legacy_move.sh is excluded: its `$SELF_DIR/..` text is data it rewrites, not a path it reads.
-snapshot_misses() { # snapshot_misses "<paths>": prints each path the snapshot at HEAD lacks
-  local list="$1" d f ref
-  d="$(mktemp -d "$TMP/snap.XXXXXX")"
-  # The working tree, not HEAD: the gate judges the candidate being validated, uncommitted edits
-  # (and a mutation probe's) included. The launcher's git archive of the same list at a commit holds
-  # the same files.
-  for f in $list; do
-    [ -e "$ROOT_DIR/$f" ] || { echo "$f (in SNAPSHOT, but not in the tree)"; continue; }
-    mkdir -p "$d/$(dirname "$f")" && cp -R "$ROOT_DIR/$f" "$d/$(dirname "$f")/" || { echo "(copying $f failed)"; return; }
-  done
-  # Every landing script itself is in the snapshot (a list without scripts/land must not pass by
-  # leaving nothing to scan).
-  for f in "$ROOT_DIR"/scripts/land/*.sh; do
-    [ -f "$d/scripts/land/$(basename "$f")" ] || echo "scripts/land/$(basename "$f") (a landing script)"
-  done
-  for f in "$d"/scripts/land/*.sh; do
-    [ -f "$f" ] || continue
-    [ "$(basename "$f")" = legacy_move.sh ] && continue
-    grep -oE '\$SELF_DIR/\.\./[A-Za-z0-9_./-]+' "$f" | sed 's|^\$SELF_DIR/\.\./|scripts/|' | while read -r ref; do
-      [ -e "$d/$ref" ] || echo "$ref (read by scripts/land/$(basename "$f"))"
-    done
-  done
-  for f in "$d"/scripts/checks/lib/*.sh; do
-    [ -f "$f" ] || continue
-    grep -oE '^[[:space:]]*(source|\.) "\$[_A-Za-z]*dir/[A-Za-z0-9_.-]+"' "$f" | sed -E 's|.*dir/([^"]+)"$|\1|' | while read -r ref; do
-      [ -e "$d/scripts/checks/lib/$ref" ] || echo "scripts/checks/lib/$ref (sourced by scripts/checks/lib/$(basename "$f"))"
-    done
-  done
-  rm -rf "${d:?}"
-}
-SNAP_LIST="$(sed -n 's/^SNAPSHOT="\(.*\)"$/\1/p' "$ROOT_DIR/scripts/land/install-bot.sh")"
-if [ -z "$SNAP_LIST" ]; then no "install-bot.sh has no SNAPSHOT=\"...\" line"
-else
-  miss="$(snapshot_misses "$SNAP_LIST")"
-  [ -z "$miss" ] && ok "the snapshot ($SNAP_LIST) covers every path the landing scripts read" \
-    || { no "the bot's snapshot lacks paths its scripts read:"; echo "$miss" | sed 's/^/      /'; }
-  miss="$(snapshot_misses "scripts/review/verify.sh scripts/checks/lib")"
-  has "$miss" "scripts/land/train.sh (a landing script)" \
-    && ok "control: a snapshot without scripts/land is reported" \
-    || { no "control: a snapshot without scripts/land passed"; echo "$miss" | sed 's/^/      /'; }
-  # Control: the snapshot as it was before 2026-11-08 must be reported short of verify.sh.
-  miss="$(snapshot_misses "scripts/land scripts/checks/lib/git_sandbox.sh")"
-  has "$miss" "scripts/review/verify.sh (read by scripts/land/train.sh)" \
-    && ok "control: a snapshot without scripts/review/verify.sh is reported" \
-    || { no "control: the old snapshot was not reported short of verify.sh"; echo "$miss" | sed 's/^/      /'; }
-  grep -q 'git archive "\\$sha" \$SNAPSHOT' "$ROOT_DIR/scripts/land/install-bot.sh" \
-    && ok "the launcher extracts exactly \$SNAPSHOT" || no "the launcher does not extract \$SNAPSHOT"
-fi
-
-echo "=== the launcher rebuilds an incomplete cached snapshot ==="
-# The launcher's cache step (install-bot.sh, from `complete=1` to its `fi`), run as the launcher would
-# (install-time $SNAPSHOT expanded, \$ unescaped) against this checkout's HEAD: a cached snapshot that
-# lacks one file (scripts/land/bot.sh) is rebuilt, and a complete one is kept.
-step="$(awk '/^complete=1$/ {on=1} on {print} on && /^fi$/ {exit}' "$ROOT_DIR/scripts/land/install-bot.sh" \
-  | sed -e "s|\$SNAPSHOT|$SNAP_LIST|g" -e 's/\\\$/$/g')"
-if [ -z "$step" ] || ! grep -q 'git archive' <<<"$step"; then no "the launcher's cache step was not found in install-bot.sh"
-else
-  snaps="$TMP/snaps"; sha="$(git -C "$ROOT_DIR" rev-parse HEAD)"; snap="$snaps/$sha"
-  run_step() { (cd "$ROOT_DIR" && snaps="$snaps" sha="$sha" snap="$snap" bash -c "set -euo pipefail; $step") >/dev/null 2>&1; }
-  rm -rf "${snaps:?}"; mkdir -p "$snaps"
-  run_step && [ -f "$snap/scripts/land/bot.sh" ] && [ -f "$snap/scripts/review/verify.sh" ] \
-    && ok "a missing snapshot is built with every listed file" || no "the cache step did not build the snapshot"
-  rm -f "$snap/scripts/land/bot.sh"; touch "$snap/marker"
-  run_step && [ -f "$snap/scripts/land/bot.sh" ] && [ ! -e "$snap/marker" ] \
-    && ok "a cached snapshot without scripts/land/bot.sh is rebuilt" || no "an incomplete cached snapshot was kept"
-  touch "$snap/marker"
-  run_step && [ -e "$snap/marker" ] && ok "a complete cached snapshot is kept" || no "a complete snapshot was rebuilt"
-fi
-
-echo
-echo "check_landing_bot: PASS=$PASS FAIL=$FAIL"
-[ "$FAIL" -eq 0 ]
diff --git a/scripts/checks/landing_ready.sh b/scripts/checks/landing_ready.sh
new file mode 100644
index 000000000..ae9b93ef2
--- /dev/null
+++ b/scripts/checks/landing_ready.sh
@@ -0,0 +1,178 @@
+#!/usr/bin/env bash
+# READINESS AND THE TRAIN'S REMOTE LEG, AGAINST A THROWAWAY REPOSITORY.
+#
+# Each leg drives the real scripts/land/ready.sh and train.sh against bare-repo remotes, a fake `gh`
+# whose CI is red exactly when the candidate contains a file named CIRED, a fake remote runner, and a
+# fake pre-push hook that fails exactly when the checkout contains a file named BAD. Nothing here
+# touches this repository.
+#
+#   remote leg  train.sh check never adopts an existing ref at the candidate's SHA for its remote run
+#   bisect --ci a CI-red member is named, each probe dispatching its own run, and nothing lands
+#   ready.sh    its legs run; any failed leg, the review included, publishes `gates: fail` and revokes
+#               readiness over an older clean verdict; passing legs publish `gates: pass`
+#   main        no script under scripts/land force-pushes main
+set -uo pipefail
+source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+NOTES="$ROOT_DIR/scripts/land/notes.sh"
+[ -f "$NOTES" ] || { echo "FATAL: scripts/land/notes.sh missing" >&2; exit 2; }
+TMP="$(mktemp -d)" || { echo "FATAL: could not create a sandbox directory" >&2; exit 2; }
+[ -n "$TMP" ] && [ -d "$TMP" ] || { echo "FATAL: sandbox directory is not usable" >&2; exit 2; }
+trap 'rm -rf "$TMP"' EXIT
+PASS=0; FAIL=0
+ok(){ echo "  ok   $1"; PASS=$((PASS+1)); }
+no(){ echo "  FAIL $1"; FAIL=$((FAIL+1)); }
+has(){ case "$1" in *"$2"*) return 0 ;; esac; return 1; }
+
+source "$ROOT_DIR/scripts/checks/lib/git_sandbox.sh" || exit 2
+git_sandbox "$TMP/gitconfig" || exit 2
+cat > "$GIT_CONFIG_GLOBAL" <<EOF
+[user]
+	name = landing gate
+	email = gate@example.invalid
+[init]
+	defaultBranch = main
+[core]
+	hooksPath = $TMP/nohooks
+EOF
+mkdir -p "$TMP/nohooks" "$TMP/gh"
+# train.sh runs only with the repository's pre-push hook enabled (ISS-0015): it asks the hook git
+# would run who it is (its single argument --concrete-identify). The sandbox's global hooksPath holds this
+# stand-in, which runs no gate and answers as the repository's .githooks/pre-push would: a test
+# fixture impersonating the hook on purpose.
+IDENTIFY='[ "$#" = 1 ] && [ "$1" = --concrete-identify ] && { echo "concrete-pre-push $(cd "$(git rev-parse --show-toplevel)" && pwd -P)/.githooks/pre-push"; exit 0; }'
+standin_hook() {
+  printf '#!/usr/bin/env bash\n%s\nexit 0\n' "$IDENTIFY" > "$TMP/nohooks/pre-push"
+  chmod +x "$TMP/nohooks/pre-push"
+}
+standin_hook
+export LAND_PUSH_RETRY_SLEEP=0
+export LAND_NO_NIX=1 LAND_STATE_DIR="$TMP/landstate" LAND_GH="$TMP/fake-gh" LAND_REPO=test/repo
+export LAND_HOOK="$TMP/hook" LAND_REMOTE_RUNNER="$TMP/fake-runner" FAKE_GH_DIR="$TMP/gh" ORIGIN_GIT="$TMP/origin.git"
+# train.sh check never skips the review leg silently. Every member here is marked reviewed clean
+# (mark), so the leg passes on the members' provenance without calling the reviewer; a reviewer this
+# fails stands for one that is never needed.
+export LAND_REVIEW_CMD=false
+
+cat > "$TMP/fake-gh" <<'GH'
+#!/usr/bin/env bash
+# CI is red exactly when the dispatched commit contains a file named CIRED.
+echo "$*" >> "$FAKE_GH_DIR/calls.log"
+case "$1 $2" in
+  "workflow run")
+    ref=""; while [ $# -gt 0 ]; do [ "$1" = --ref ] && ref="$2"; shift; done
+    n=$(( $(cat "$FAKE_GH_DIR/counter" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$FAKE_GH_DIR/counter"
+    git --git-dir="$ORIGIN_GIT" rev-parse "refs/heads/$ref" > "$FAKE_GH_DIR/run.$n"
+    exit 0 ;;
+  "run list")
+    [ -f "$FAKE_GH_DIR/list-fails" ] && { echo "fake gh: network down" >&2; exit 1; }
+    [ -f "$FAKE_GH_DIR/list-empty" ] && { echo '[]'; exit 0; }
+    n="$(cat "$FAKE_GH_DIR/counter")"
+    printf '[{"databaseId": %s, "headSha": "%s", "createdAt": "9999-01-01T00:00:00Z"}]' "$n" "$(cat "$FAKE_GH_DIR/run.$n")" ;;
+  "run view")
+    sha="$(cat "$FAKE_GH_DIR/run.$3")"; c=success
+    git --git-dir="$ORIGIN_GIT" cat-file -e "$sha:CIRED" 2>/dev/null && c=failure
+    printf '{"status":"completed","conclusion":"%s","headSha":"%s","jobs":[{"name":"Build","conclusion":"%s","databaseId":%s}]}' "$c" "$sha" "$c" "$3" ;;
+  "api "*) echo "fake log tail" ;;
+  *) echo "fake gh: unexpected $*" >&2; exit 1 ;;
+esac
+GH
+cat > "$TMP/hook" <<'EOF'
+#!/usr/bin/env bash
+cat > /dev/null
+[ ! -e BAD ]
+EOF
+cat > "$TMP/fake-runner" <<'EOF'
+#!/usr/bin/env bash
+# A remote runner: fetches like concrete-remote (a ref on origin, or a SHA) and reports the SHA.
+echo "$1" >> "$FAKE_GH_DIR/runner.log"
+sha="$(git --git-dir="$ORIGIN_GIT" rev-parse --verify -q "refs/heads/$1" || git --git-dir="$ORIGIN_GIT" rev-parse --verify -q "$1^{commit}")" || { echo "no such ref $1"; exit 1; }
+echo "[concrete-remote] ref=$1 sha=$sha"
+EOF
+chmod +x "$TMP/fake-gh" "$TMP/hook" "$TMP/fake-runner"
+
+for r in origin lambdaclass fork; do git init -q --bare "$TMP/$r.git"; done
+A="$TMP/agent"; W="$TMP/lander"
+git init -q "$A"; cd "$A" || exit 2
+for r in origin lambdaclass fork; do git remote add "$r" "$TMP/$r.git"; done
+mkdir -p src
+printf 'Build\n' > required-checks.txt  # train.sh refuses a landing with no required-checks.txt
+git add -A && git commit -qm base
+for r in origin lambdaclass fork; do git push -q "$r" main; done
+BASE="$(git rev-parse HEAD)"
+git clone -q "$TMP/origin.git" "$W"
+( cd "$W" && git remote add lambdaclass "$TMP/lambdaclass.git" && git remote add fork "$TMP/fork.git" )
+
+# mk <branch> <commit-message> <file> <content> [from]: one commit on <from> (default main), pushed.
+mk(){ ( cd "$A" && git fetch -q origin && git checkout -q -B "$1" "${5:-origin/main}" && mkdir -p "$(dirname "$3")" \
+        && printf '%s\n' "$4" > "$3" && git add -A && git commit -qm "$2" && git push -q -f origin "HEAD:refs/heads/$1" ); }
+sha_of(){ git --git-dir="$TMP/origin.git" rev-parse "refs/heads/$1"; }
+mark(){ # branch [review-verdict] [gates] [extra review key=value]
+  local s; s="$(sha_of "$1")"
+  ( cd "$A" && git fetch -q origin \
+    && bash "$NOTES" put review "$s" verdict="${2:-clean}" rounds=1 reviewer=codex base="$s" pieces=1 ${4:+"$4"} >/dev/null \
+    && bash "$NOTES" put gates "$s" gates="${3:-pass}" selected=3 >/dev/null ) || no "mark $1"
+}
+land_refs(){ git --git-dir="$TMP/origin.git" for-each-ref --format='%(refname)' 'refs/heads/wip/land-*'; }
+
+echo "=== remote leg: a same-SHA ref of another run is never adopted ==="
+mk wip/cx cx src/cx.txt cx; mark wip/cx
+( cd "$W" && git fetch -q origin && bash "$ROOT_DIR/scripts/land/train.sh" build cx-t --no-fetch origin/wip/cx >/dev/null 2>&1 \
+  && git push -q origin "HEAD:refs/heads/wip/land-collide" )
+CXH="$(cd "$W" && git rev-parse HEAD)"
+: > "$TMP/gh/runner.log"
+out="$(cd "$W" && LAND_REMOTE_REF_FIRST=wip/land-collide bash "$ROOT_DIR/scripts/land/train.sh" check cx-t --no-review 2>&1)"; rc=$?
+rlog="$(cat "$LAND_STATE_DIR"/cx-t/check-*/remote.log 2>/dev/null)"
+[ "$rc" = 0 ] && has "$rlog" "wip/land-collide was not created by this run" && ! has "$(cat "$TMP/gh/runner.log")" "wip/land-collide" \
+  && [ "$(git --git-dir="$TMP/origin.git" rev-parse refs/heads/wip/land-collide)" = "$CXH" ] && [ "$(land_refs)" = "refs/heads/wip/land-collide" ] \
+  && ok "an existing ref at the same SHA is refused, a fresh name is used, and only the run's own ref is deleted" || { no "collision: exit $rc, refs '$(land_refs)'"; echo "$rlog" | sed 's/^/      /'; }
+# The run's own ref, positively: the runner ran exactly once, on a fresh wip/land-* ref (not the
+# planted one), and that ref is gone.
+rl="$(cat "$TMP/gh/runner.log")"
+case "$rl" in wip/land-collide) fresh="" ;; wip/land-*) fresh="$rl" ;; *) fresh="" ;; esac
+[ "$(printf '%s\n' "$rl" | grep -c .)" = 1 ] && [ -n "$fresh" ] \
+  && ! git --git-dir="$TMP/origin.git" rev-parse -q --verify "refs/heads/$fresh" >/dev/null \
+  && ok "the remote runner ran once, on the run's own fresh ref ($fresh), which is deleted afterwards" \
+  || no "remote runner invocations: '$rl'"
+git --git-dir="$TMP/origin.git" update-ref -d refs/heads/wip/land-collide
+( cd "$W" && git checkout -q --detach origin/main )
+
+echo "=== ready.sh: legs in parallel; any failed leg (the review included) publishes gates: fail ==="
+mk wip/rv rv src/rv.txt rv; mark wip/rv
+RV="$(sha_of wip/rv)"
+out="$(cd "$A" && LAND_REVIEW_CMD=false bash "$ROOT_DIR/scripts/land/ready.sh" wip/rv 2>&1)"; rc=$?
+g="$(cd "$A" && bash "$NOTES" get gates "$RV")"
+[ "$rc" != 0 ] && has "$g" "gates: fail" && has "$g" "reason: failed legs: review" && has "$out" "run one after another" \
+  && ok "a failed review leg revokes readiness even over an older clean verdict" || { no "ready.sh review failure: exit $rc, note '$g'"; echo "$out" | sed 's/^/      /'; }
+mk wip/rv2 rv2 src/rv2.txt rv2; mark wip/rv2 clean fail
+out="$(cd "$A" && LAND_REVIEW_CMD=true bash "$ROOT_DIR/scripts/land/ready.sh" wip/rv2 2>&1)"; rc=$?
+[ "$rc" = 0 ] && [ "$(cd "$A" && bash "$NOTES" get gates "$(sha_of wip/rv2)" gates)" = pass ] \
+  && ok "passing legs publish gates: pass and the head becomes ready" || { no "ready.sh pass: exit $rc"; echo "$out" | sed 's/^/      /'; }
+
+echo "=== bisect --ci: a red CI run names the culprit, each probe its own run ==="
+mk wip/cired cired CIRED red; mark wip/cired
+mk wip/g3 g3 src/g3.txt g3; mark wip/g3
+MAIN0="$(git --git-dir="$TMP/origin.git" rev-parse refs/heads/main)"
+( cd "$W" && git fetch -q origin && git checkout -q --detach origin/main \
+  && bash "$ROOT_DIR/scripts/land/train.sh" build bt --no-fetch origin/wip/cired origin/wip/g3 >/dev/null 2>&1 ) || no "build bt"
+n0="$(cat "$TMP/gh/counter" 2>/dev/null || echo 0)"
+out="$(cd "$W" && bash "$ROOT_DIR/scripts/land/train.sh" bisect bt --ci 2>&1)"; rc=$?
+n1="$(cat "$TMP/gh/counter" 2>/dev/null || echo 0)"
+runs=""; i=$((n0+1)); while [ "$i" -le "$n1" ]; do runs="$runs $(cat "$TMP/gh/run.$i")"; i=$((i+1)); done
+# cired is the first half: a CI that never reports red would send the halving to g3 instead, and
+# "alone it is red" is the culprit probe's own run.
+[ "$rc" = 0 ] && has "$out" "step 1: first half [origin/wip/cired ] -> red" && has "$out" "culprit: origin/wip/cired" \
+  && has "$out" "alone it is red" && has "$out" "build bt --force origin/wip/g3" \
+  && ok "bisect --ci attributes the CI-red member and prints the rebuild without it" || { no "bisect --ci: exit $rc"; echo "$out" | sed 's/^/      /'; }
+[ $((n1-n0)) -ge 2 ] && [ "$(printf '%s\n' $runs | sort -u | grep -c .)" = $((n1-n0)) ] \
+  && ok "each probe dispatched its own CI run at its own SHA ($((n1-n0)) runs)" || no "bisect --ci runs: '$runs'"
+[ "$(git --git-dir="$TMP/origin.git" rev-parse refs/heads/main)" = "$MAIN0" ] && ok "bisect --ci lands nothing" || no "bisect --ci moved main"
+( cd "$W" && git checkout -q --detach origin/main )
+
+echo "=== main is never force-pushed ==="
+bad="$(grep -nE 'git push[^#]*(--force|[[:space:]]-f[[:space:]])[^#]*refs/heads/main' "$ROOT_DIR"/scripts/land/*.sh || true)"
+[ -z "$bad" ] && ok "no forced push of refs/heads/main in scripts/land" || { no "forced push of main:"; echo "$bad" | sed 's/^/      /'; }
+
+echo
+echo "check_landing_ready: PASS=$PASS FAIL=$FAIL"
+[ "$FAIL" -eq 0 ]
diff --git a/scripts/checks/review_tool.sh b/scripts/checks/review_tool.sh
index e0b928300..0c40ea571 100755
--- a/scripts/checks/review_tool.sh
+++ b/scripts/checks/review_tool.sh
@@ -207,11 +207,17 @@ g notes --ref=refs/notes/concrete-review add -f -m "verdict: clean" HEAD
 (cd "$W" && bash "$VERIFY" HEAD >/dev/null 2>&1); rc=$?
 check "malformed note (verdict line alone): exit 2 (got $rc)" test "$rc" -eq 2
 B40="$(printf '%040d' 0 | tr 0 a)"
-# The landing bot's carried note (notes.sh put: keys in its own order, utc last) is well formed.
-g notes --ref=refs/notes/concrete-review add -f -m "$(printf 'verdict: clean\nrounds: 2\nreviewer: codex\nbase: %s\npieces: 1\ncarried-from: %s\nutc: 2026-10-22T00:00:00Z' "$B40" "$B40")" HEAD
+# A note notes.sh put wrote (keys in its own order, utc last) is well formed.
+g notes --ref=refs/notes/concrete-review add -f -m "$(printf 'verdict: clean\nrounds: 2\nreviewer: codex\nbase: %s\npieces: 1\nutc: 2026-10-22T00:00:00Z' "$B40")" HEAD
 (cd "$W" && bash "$VERIFY" HEAD >"$T/vc" 2>&1); rc=$?
-check "the landing bot's carried note verifies clean (exit 0, got $rc)" test "$rc" -eq 0
-check "a carried verdict says where it came from" grep -q "carried from $B40" "$T/vc"
+check "a note with utc last verifies clean (exit 0, got $rc)" test "$rc" -eq 0
+# The landing bot's keys went with it: a verdict carried across a rebase, or a landing order, is no
+# longer a key a review note may hold.
+for extra in "carried-from: $B40" "order: 1"; do
+  g notes --ref=refs/notes/concrete-review add -f -m "$(printf 'verdict: clean\nrounds: 2\nreviewer: codex\nbase: %s\npieces: 1\nutc: 2026-10-22T00:00:00Z\n%s' "$B40" "$extra")" HEAD
+  out="$(cd "$W" && bash "$VERIFY" HEAD 2>&1)"; rc=$?
+  check "a note with '${extra%%:*}' is malformed: exit 2, bad ${extra%%:*} (got $rc)" test "$rc" -eq 2 -a -n "$(printf '%s' "$out" | grep -F "malformed review note (bad ${extra%%:*})")"
+done
 g notes --ref=refs/notes/concrete-review add -f -m "$(printf 'verdict: clean\nrounds: 2\nreviewer: codex\nutc: 2026-10-22T00:00:00Z\nbase: %s\npieces: 1\nsurprise: 1' "$B40")" HEAD
 (cd "$W" && bash "$VERIFY" HEAD >/dev/null 2>&1); rc=$?
 check "an unknown key is malformed: exit 2 (got $rc)" test "$rc" -eq 2
diff --git a/scripts/checks/run.sh b/scripts/checks/run.sh
index b3971ecd3..856b9ad52 100755
--- a/scripts/checks/run.sh
+++ b/scripts/checks/run.sh
@@ -9,7 +9,7 @@ set -uo pipefail
 source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
 ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
 cd "$ROOT_DIR"
-REQUIRED="legacy_frozen root_inventory workflow_yaml doc_links landing_script landing_bot review_tool sandbox_isolation retention_manifest issues oracle_fetch"
+REQUIRED="legacy_frozen root_inventory workflow_yaml doc_links landing_script landing_ready review_tool sandbox_isolation retention_manifest issues oracle_fetch"
 missing=""
 for c in $REQUIRED; do [ -f "scripts/checks/$c.sh" ] || missing="$missing $c"; done
 [ -z "$missing" ] || { echo "run.sh: required check(s) missing:$missing" >&2; exit 1; }
diff --git a/scripts/checks/sandbox_isolation.sh b/scripts/checks/sandbox_isolation.sh
index 4abf23a56..f91afe577 100755
--- a/scripts/checks/sandbox_isolation.sh
+++ b/scripts/checks/sandbox_isolation.sh
@@ -38,10 +38,8 @@ ok(){ echo "  ok   $1"; PASS=$((PASS+1)); }
 no(){ echo "  FAIL $1"; FAIL=$((FAIL+1)); }
 
 echo "=== structural: every repository-making script sources the sandbox helper ==="
-# Two exceptions, neither a sandbox: install-bot.sh runs on the gate host as `bash -s <
-# install-bot.sh` (no sibling files to source) and makes the bot's persistent clone, and
-# worktree-new.sh makes a worktree OF the caller's repository by design.
-EXEMPT=" scripts/land/install-bot.sh scripts/worktree-new.sh "
+# One exception, not a sandbox: worktree-new.sh makes a worktree OF the caller's repository by design.
+EXEMPT=" scripts/worktree-new.sh "
 MAKES='git( -C [^ ]+)? (init|clone)\b|worktree add'
 # shell_scripts DIR: every shell script under DIR/scripts at ANY depth, as paths relative to DIR,
 # sorted: a `*.sh` file, or any other file whose first line is a sh/bash shebang. (Until 2026-11-08
@@ -79,7 +77,7 @@ while IFS=$'\t' read -r verdict f why; do
   makers=$((makers+1))
   if [ "$verdict" = ok ]; then ok "$f $why"; else no "$f $why"; fi
 done < <(scan_makers "$ROOT_DIR")
-[ "$makers" -ge 9 ] && ok "found $makers repository-making scripts (at least the 9 known)" \
+[ "$makers" -ge 8 ] && ok "found $makers repository-making scripts (at least the 8 known)" \
   || no "found only $makers repository-making scripts; the scan is not seeing them"
 
 echo "=== control: the structural scan sees scripts at any depth and without a .sh suffix ==="
diff --git a/scripts/land/bot.sh b/scripts/land/bot.sh
deleted file mode 100755
index e0bbece3c..000000000
--- a/scripts/land/bot.sh
+++ /dev/null
@@ -1,525 +0,0 @@
-#!/usr/bin/env bash
-# Landing bot (R-0539): lands ready branches without a human in the critical path.
-# docs/LANDING.md, "The landing bot", is the manual; this header is the contract.
-#
-#   bot.sh [--dry-run] [tick]   one pass: resume, auto-rebase, collect, train, land (the timer's job)
-#   bot.sh [--dry-run] rebase   the auto-rebase pass only
-#   bot.sh list                 the ready branches in landing order, with each one's order key
-#   bot.sh status               bot state and the last events
-#   bot.sh reset                clear a `blocked` state after a human has looked at it
-#
-# READY: a branch on the primary remote named <BOT_BRANCH_PREFIX>* (default wip/, never wip/land-*)
-# whose head commit is not in main, carries `verdict: clean` in refs/notes/concrete-review AND
-# `gates: pass` in refs/notes/concrete-gates (scripts/land/notes.sh), and was not ejected at that SHA.
-#
-# ORDER: every explicit `order: N` (either note) first, by N; then language-rule branches (they touch
-# Concrete/Check/ or Concrete/Elab/ AND add an E-code main does not have); then everything
-# else. Ties: smaller diff first, then name.
-#
-# SAFETY: one instance (a kernel flock, via flock(1) or Python fcntl); state in a file, so a restart resumes a
-# train that is in CI instead of dispatching again; `touch ~/.concrete-bot-paused` stops it before
-# the next stage; --dry-run changes nothing; main is pushed only by train.sh land (fast-forward,
-# never forced) to the primary and the mirror; a remote named `fork` is refused; every git
-# operation is followed by an in-progress check, and `git rebase` is never piped.
-#
-# ENV: BOT_STATE_DIR (default <git-common-dir>/concrete-landing/bot), BOT_PAUSE_FILE
-# (~/.concrete-bot-paused), BOT_BRANCH_PREFIX (wip/), BOT_ACTIVE_SECONDS (600: younger heads are
-# not rebased), BOT_MAX_TRAINS (4 per tick), BOT_WATCH_INTERVAL (60), BOT_CHECK_ARGS (extra
-# `train.sh check` arguments; the bot always passes --no-review, members were reviewed at their
-# heads, unless BOT_TRAIN_REVIEW=1), BOT_NO_REBASE=1, BOT_NOTIFY (default scripts/land/notify.sh,
-# called as `notify.sh <level> "landing bot: <event>" <message>` when present, the status page's
-# signature), BOT_NOW (test seam: epoch seconds).
-# LAND_* variables pass through to train.sh.
-set -euo pipefail
-SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
-# shellcheck source=scripts/land/lib.sh
-. "$SELF_DIR/lib.sh"
-# The bot's clone is found from the working directory, never from an inherited GIT_DIR (ISS-0015);
-# its scratch clones are sandboxes made from it.
-. "$SELF_DIR/../checks/lib/git_sandbox.sh"
-git_sandbox
-DRY=0
-if [ "${1:-}" = "--dry-run" ]; then DRY=1; shift; fi
-SUB="${1:-tick}"
-
-die() { echo "bot: $*" >&2; exit 1; }
-say() { echo "bot: $*"; }
-ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git work tree"
-cd "$ROOT"
-COMMON="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
-LAND_ROOT="${LAND_STATE_DIR:-$COMMON/concrete-landing}"
-LAND_LOGS="${LAND_LOG_DIR:-$LAND_ROOT/log}"
-STATE_DIR="${BOT_STATE_DIR:-$LAND_ROOT/bot}"
-STATE="$STATE_DIR/bot.env"
-EVENTS="$STATE_DIR/events.tsv"
-TRAIN="${BOT_TRAIN:-$SELF_DIR/train.sh}"
-NOTES="$SELF_DIR/notes.sh"
-IMPACT="$SELF_DIR/impact_gates.sh"
-NOTIFY="${BOT_NOTIFY:-$SELF_DIR/notify.sh}"
-REMOTE="${LAND_REMOTE:-origin}"
-MIRROR="${LAND_MIRROR-lambdaclass}"
-PREFIX="${BOT_BRANCH_PREFIX:-wip/}"; PREFIX="${PREFIX%/}/"
-PAUSE="${BOT_PAUSE_FILE:-$HOME/.concrete-bot-paused}"
-ACTIVE="${BOT_ACTIVE_SECONDS:-600}"
-MAX_TRAINS="${BOT_MAX_TRAINS:-4}"
-WATCH_INTERVAL="${BOT_WATCH_INTERVAL:-60}"
-CHECK_ARGS=()
-[ "${BOT_TRAIN_REVIEW:-0}" = 1 ] || CHECK_ARGS+=(--no-review)
-# shellcheck disable=SC2206
-[ -z "${BOT_CHECK_ARGS:-}" ] || CHECK_ARGS+=(${BOT_CHECK_ARGS})
-now() { echo "${BOT_NOW:-$(date +%s)}"; }
-TRAIN_SEQ=0
-
-[ "$REMOTE" != fork ] || die "refusing the remote named 'fork' as primary"
-[ "$MIRROR" != fork ] || die "refusing the remote named 'fork' as mirror"
-
-# --- state, events, notification -----------------------------------------------------------------
-
-st_get() { [ -f "$STATE" ] || return 0; sed -n "s/^$1=//p" "$STATE" | tail -n 1; }
-st_set() {
-  [ "$DRY" = 1 ] && return 0
-  mkdir -p "$STATE_DIR"; touch "$STATE"
-  grep -v "^$1=" "$STATE" > "$STATE.tmp" || true
-  printf '%s=%s\n' "$1" "$2" >> "$STATE.tmp"
-  mv "$STATE.tmp" "$STATE"
-}
-
-event() { # kind message — logged, printed, and handed to notify.sh when it exists
-  local kind="$1" msg="$2"
-  say "[$kind] $msg"
-  [ "$DRY" = 1 ] && return 0
-  mkdir -p "$STATE_DIR"
-  printf '%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$kind" "$(printf '%s' "$msg" | tr '\t\n' '  ')" >> "$EVENTS"
-  if [ -f "$NOTIFY" ]; then
-    # notify.sh <info|success|warn|error> <title> <body> (scripts/land/notify.sh, wip/status-page).
-    local level=info
-    case "$kind" in
-      landed) level=success ;;
-      blocked|blocked-still) level=error ;;
-      ejected|ci-failed|rebase-conflict|rebase-failed|dispatch-unknown|watch-incomplete) level=warn ;;
-    esac
-    if command -v timeout >/dev/null 2>&1; then timeout 60 bash "$NOTIFY" "$level" "landing bot: $kind" "$msg" || true
-    else bash "$NOTIFY" "$level" "landing bot: $kind" "$msg" || true; fi
-  fi
-}
-
-paused() { [ -e "$PAUSE" ]; }
-# The acknowledgment the operator waits for (LANDING.md, "Kill switch"): a `paused` event in the
-# log, written by the instance that holds the lock, once per pause file (keyed by its mtime).
-ack_pause() { # where
-  local id; id="$(stat -c %Y "$PAUSE" 2>/dev/null || stat -f %m "$PAUSE" 2>/dev/null || echo 0)"
-  if [ "$(st_get pause_acked)" != "$id" ]; then
-    event paused "kill switch seen ($1); the bot is idle until $PAUSE is removed"
-    st_set pause_acked "$id"
-  else
-    say "paused ($PAUSE exists; already acknowledged); doing nothing"
-  fi
-}
-
-# --- single instance -----------------------------------------------------------------------------
-# A KERNEL lock on both platforms: this shell opens $LOCK.flock on fd 9 and has flock(2) taken on
-# that open file description (by flock(1), or by Python's fcntl.flock where flock(1) is missing, as
-# on macOS). The lock belongs to the description, so it lasts while this process (or a child that
-# inherited fd 9) lives and is released by the kernel on any exit: nothing stale is ever left.
-# (Earlier drafts of this branch used pid files; none was ever deployed, so there is no format to
-# migrate from.)
-LOCK="$STATE_DIR/lock"
-acquire_lock() {
-  mkdir -p "$STATE_DIR"
-  exec 9>"$LOCK.flock"
-  local got=0
-  if command -v flock >/dev/null 2>&1; then flock -n 9 && got=1
-  else python3 -I -c 'import fcntl, sys
-try: fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
-except OSError: sys.exit(1)' && got=1; fi
-  [ "$got" = 1 ] || { say "another instance holds $LOCK.flock; nothing to do"; exit 0; }
-  echo "$$" > "$LOCK.pid"
-}
-
-# --- remote view ---------------------------------------------------------------------------------
-
-sync_remote() {
-  git fetch -q --prune "$REMOTE"
-  land_assert_no_op fetch
-  bash "$NOTES" fetch
-}
-
-# "branch sha" per ready branch.
-ready_branches() {
-  local main b sha
-  main="$(git rev-parse "$REMOTE/main")"
-  git for-each-ref --format='%(refname:lstrip=3) %(objectname)' "refs/remotes/$REMOTE/${PREFIX%/}" \
-  | while read -r b sha; do
-      case "$b" in "${PREFIX}land-"*|"$PREFIX") continue ;; esac
-      if git merge-base --is-ancestor "$sha" "$main"; then continue; fi
-      case " $(st_get ejected) " in *" $b@$sha "*) continue ;; esac
-      bash "$NOTES" ready "$sha" || continue
-      echo "$b $sha"
-    done
-}
-
-# "category<TAB>rank<TAB>reason" for one ready head. Categories sort first, so every explicit order
-# precedes every rule change, whatever its value: 0 explicit (rank = N), 1 language rule, 2 ordinary.
-order_key() { # branch sha
-  local sha="$2" o mb files codes c new=""
-  o="$(bash "$NOTES" get review "$sha" order)"; [ -n "$o" ] || o="$(bash "$NOTES" get gates "$sha" order)"
-  # Decimal, at most 9 digits; 10# keeps a leading zero ("08") from reading as octal.
-  case "$o" in ''|*[!0-9]*) ;; *)
-    if [ "${#o}" -le 9 ]; then printf '0\t%s\texplicit order: %s\n' "$((10#$o))" "$o"; return 0; fi ;;
-  esac
-  mb="$(git merge-base "$REMOTE/main" "$sha")"
-  files="$(git diff --name-only "$mb" "$sha" -- Concrete/Check Concrete/Elab | tr '\n' ' ')"
-  if [ -n "$files" ]; then
-    codes="$(git diff -U0 "$mb" "$sha" -- Concrete | awk '/^\+\+\+/{next} /^\+/{ s=$0; while (match(s, /E[0-9][0-9][0-9][0-9]/)) { print substr(s, RSTART, RLENGTH); s=substr(s, RSTART+RLENGTH) } }' | sort -u)"
-    for c in $codes; do
-      if ! git grep -q -w "$c" "$REMOTE/main" -- Concrete; then new="$new $c"; fi
-    done
-    if [ -n "$new" ]; then printf '1\t0\tlanguage rule: new%s in %s\n' "$new" "${files% }"; return 0; fi
-  fi
-  printf '2\t0\tordinary\n'
-}
-
-# "key size branch sha reason", sorted: the landing order. key = <category>.<rank, 9 digits>.
-ordered_ready() {
-  local b sha k cat rank reason size
-  ready_branches | while read -r b sha; do
-    k="$(order_key "$b" "$sha")"
-    IFS=$'\t' read -r cat rank reason <<< "$k"
-    size="$(git diff --numstat "$(git merge-base "$REMOTE/main" "$sha")" "$sha" | awk '{n+=$1+$2} END{print n+0}')"
-    printf '%s.%09d %08d %s %s %s\n' "$cat" "$rank" "$size" "$b" "$sha" "$reason"
-  done | sort -k1,1 -k2,2 -k3,3
-}
-
-# --- auto-rebase ---------------------------------------------------------------------------------
-
-to_epoch() { python3 -I -c 'import sys, datetime
-try: print(int(datetime.datetime.strptime(sys.argv[1], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc).timestamp()))
-except Exception: print(0)' "$1"; }
-
-# The latest sign of activity on a branch: its head's commit time, the time this clone saw the head
-# arrive (the remote-tracking reflog), and the notes' utc. An agent pushing, reviewing or gating
-# moves one of them.
-last_activity() { # branch sha
-  local t=0 x u
-  x="$(git log -1 --format=%ct "$2")"; [ "$x" -gt "$t" ] && t="$x"
-  x="$(git reflog show --date=unix -n 1 --format='%gd' "refs/remotes/$REMOTE/$1" 2>/dev/null | sed -n 's/.*@{\([0-9]*\)}.*/\1/p')"
-  [ -n "$x" ] && [ "$x" -gt "$t" ] && t="$x"
-  for u in "$(bash "$NOTES" get review "$2" utc)" "$(bash "$NOTES" get gates "$2" utc)"; do
-    [ -n "$u" ] || continue
-    x="$(to_epoch "$u")"; [ "$x" -gt "$t" ] && t="$x"
-  done
-  echo "$t"
-}
-
-rebase_in_scratch() { # branch sha main log — runs inside the scratch clone
-  local b="$1" sha="$2" main="$3" log="$4" rc=0 files new sel
-  git rebase "$main" > "$log" 2>&1 || rc=$?   # never piped: a piped rebase hides its stop
-  local stopped=0 p
-  for p in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD; do [ -e "$(git rev-parse --git-path "$p")" ] && stopped=1; done
-  if [ "$rc" != 0 ] || [ "$stopped" = 1 ]; then
-    files="$(git diff --name-only --diff-filter=U | tr '\n' ' ')"
-    git rebase --abort >> "$log" 2>&1 || true
-    land_assert_no_op "rebase --abort"
-    event rebase-conflict "$b (${sha:0:10}) does not rebase onto main ${main:0:10}; conflicts in: ${files:-(rebase exit $rc, see $log)}"
-    return 1
-  fi
-  land_assert_no_op rebase
-  if [ -f scripts/gen/refresh_generated.sh ]; then
-    land_in_nix bash scripts/gen/refresh_generated.sh >> "$log" 2>&1 \
-      || { event rebase-failed "$b: refresh_generated.sh refused after rebasing (log $log)"; return 1; }
-    if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
-      git add -u; git commit -q -m "regenerate generated views after rebasing onto main ${main:0:10}"
-      land_assert_no_op "regeneration commit"
-    fi
-  fi
-  new="$(git rev-parse HEAD)"
-  bash "$IMPACT" --base "$main" --head "$new" --src-ref "refs/heads/$b" --dst-ref "refs/heads/ci/rebase-check" \
-    --report "$log.selected" >> "$log" 2>&1 \
-    || { event rebase-failed "$b: impact gates failed on the rebased head ${new:0:10}; branch left as is (log $log)"; return 1; }
-  if paused; then event paused "$b: rebased and gated as ${new:0:10}, NOT pushed (kill switch)"; return 2; fi
-  # The lease: if the agent pushed in the meantime, the push is refused and the branch is left alone.
-  git push -q --force-with-lease="refs/heads/$b:$sha" "$REMOTE" "$new:refs/heads/$b" >> "$log" 2>&1 \
-    || { event rebase-skipped "$b moved while it was being rebased; left alone"; return 1; }
-  land_assert_no_op push
-  sel="$(sed -n 's/^selected: //p' "$log.selected" 2>/dev/null || true)"
-  # The carried note keeps every field the reviewed note had that scripts/review/verify.sh requires
-  # (review.sh writes six; notes.sh appends a fresh utc) and names the reviewed SHA.
-  local carry=(verdict=clean) ck cv
-  for ck in rounds reviewer base pieces; do
-    cv="$(bash "$NOTES" get review "$sha" "$ck")"
-    [ -z "$cv" ] || carry+=("$ck=$cv")
-  done
-  bash "$NOTES" put review "$new" "${carry[@]}" carried-from="$sha"
-  bash "$NOTES" put gates "$new" gates=pass selected="${sel:-unknown}" runner=landing-bot rebased-onto="$main"
-  event rebased "$b ${sha:0:10} -> ${new:0:10} onto main ${main:0:10}"
-}
-
-scratch_clone() { # dir sha: a local clone of this clone, detached at sha, with its remotes, hook
-  # and commit identity (what a worktree shared with it through the common config)
-  local d="$1" r k v
-  git clone -q --local --no-checkout "$ROOT" "$d"
-  git -C "$d" fetch -q "$ROOT" "+refs/remotes/*:refs/remotes/*" "+refs/notes/*:refs/notes/*"
-  for r in $(git remote); do
-    # every url of the remote, in order (a remote with several pushes to all of them)
-    git -C "$d" config --unset-all "remote.$r.url" 2>/dev/null || true
-    git -C "$d" config "remote.$r.fetch" >/dev/null 2>&1 || git -C "$d" config "remote.$r.fetch" "+refs/heads/*:refs/remotes/$r/*"
-    while IFS= read -r v; do
-      if [ -n "$v" ]; then git -C "$d" config --add "remote.$r.url" "$v"; fi
-    done <<< "$(git remote get-url --all "$r" 2>/dev/null || true)"   # insteadOf expanded, as git uses it
-  done
-  git -C "$d" config core.hooksPath "$(git config core.hooksPath || echo .githooks)"
-  for k in user.name user.email user.useConfigOnly; do
-    if v="$(git config --local "$k")"; then git -C "$d" config "$k" "$v"; fi
-  done
-  for r in $(git remote); do
-    # the push URLs exactly as git resolves them here (pushurl, insteadOf and pushInsteadOf applied),
-    # written explicitly, so the scratch clone pushes where this clone would
-    git -C "$d" config --unset-all "remote.$r.pushurl" 2>/dev/null || true
-    while IFS= read -r v; do
-      if [ -n "$v" ]; then git -C "$d" config --add "remote.$r.pushurl" "$v"; fi
-    done <<< "$(git remote get-url --push --all "$r" 2>/dev/null || true)"
-  done
-  git -C "$d" checkout -q --detach "$sha"
-  if [ -d "$ROOT/.lake" ] && [ ! -e "$d/.lake" ]; then cp -a "$ROOT/.lake" "$d/.lake"; fi
-}
-
-rebase_pass() {
-  local main b sha age key slug wt rrc
-  main="$(git rev-parse "$REMOTE/main")"
-  while read -r b sha; do
-    [ -n "$b" ] || continue
-    if paused; then ack_pause "rebase pass, before $b"; break; fi
-    case "$b" in "$PREFIX"*) ;; *) say "rebase: $b is outside $PREFIX; never rewritten"; continue ;; esac
-    if git merge-base --is-ancestor "$main" "$sha"; then continue; fi
-    slug="$(printf '%s' "$b" | tr -c 'A-Za-z0-9._-' '_')"
-    key="$sha@$main"
-    [ "$(st_get "rebased_$slug")" = "$key" ] && continue
-    age=$(( $(now) - $(last_activity "$b" "$sha") ))
-    if [ "$age" -lt "$ACTIVE" ]; then say "rebase: skip $b: last activity ${age}s ago (< ${ACTIVE}s; an agent may be pushing)"; continue; fi
-    if [ "$DRY" = 1 ]; then say "(dry-run) would rebase $b (${sha:0:10}) onto main ${main:0:10}"; continue; fi
-    wt="$STATE_DIR/scratch/$slug"
-    mkdir -p "$STATE_DIR/scratch"
-    rm -rf "$wt"
-    # A scratch CLONE, not a worktree: the pre-push hook (run by the impact gates) refuses a linked
-    # worktree (ISS-0015). It gets this clone's remotes and hook, so its pushes and notes go where a
-    # worktree's would.
-    scratch_clone "$wt" "$sha"
-    rrc=0; ( cd "$wt" && rebase_in_scratch "$b" "$sha" "$main" "$wt.log" ) || rrc=$?
-    rm -rf "$wt"
-    land_assert_no_op "scratch cleanup"
-    # A pass stopped by the kill switch (exit 2) is not a try: the pair is retried after a resume.
-    [ "$rrc" = 2 ] || st_set "rebased_$slug" "$key"
-  done <<< "$(ready_branches)"
-}
-
-# --- trains --------------------------------------------------------------------------------------
-
-train_get() { sed -n "s/^$2=//p" "$LAND_ROOT/$1/train.env" 2>/dev/null | tail -n 1; }
-train_set() { # train key value — the same file and format as train.sh's state_set
-  local f="$LAND_ROOT/$1/train.env"
-  grep -v "^$2=" "$f" > "$f.tmp" || true
-  printf '%s=%s\n' "$2" "$3" >> "$f.tmp"
-  mv "$f.tmp" "$f"
-}
-last_result() { awk -F'\t' -v s="$2" '$3==s{r=$8} END{print r}' "$LAND_LOGS/$1.tsv" 2>/dev/null; }
-
-eject() { # branch sha reason
-  st_set ejected "$(st_get ejected) $1@$2"
-  bash "$NOTES" put gates "$2" gates=fail reason="ejected by the landing bot: $3" runner=landing-bot || true
-  event ejected "$1 (${2:0:10}): $3"
-}
-
-# Exit 10: retry with the rest. 20: stop this tick, nothing lost. 30: blocked, a human must look.
-# Bisection checks the kill switch between its steps (LAND_PAUSE_FILE), so a pause stops it too.
-bisect_and_eject() { # train mode(--ci|test command) why
-  local name="$1" mode="$2" why="$3" members n out culprit ref sha verdict
-  members="$(train_get "$name" members)"
-  n="$(printf '%s\n' "${members//,/$'\n'}" | grep -c . || true)"
-  if [ "$n" -le 1 ]; then
-    ref="${members%@*}"; sha="${members##*@}"; verdict=red
-  else
-    if paused; then event paused "train $name is red ($why); bisection waits for the kill switch to clear"; return 20; fi
-    event bisecting "train $name is red ($why); bisecting $n members"
-    if [ "$mode" = --ci ]; then out="$(LAND_PAUSE_FILE="$PAUSE" bash "$TRAIN" bisect "$name" --ci 2>&1)" || true
-    else out="$(LAND_PAUSE_FILE="$PAUSE" bash "$TRAIN" bisect "$name" --test "$mode" 2>&1)" || true; fi
-    printf '%s\n' "$out" > "$STATE_DIR/bisect-$name.log"
-    culprit="$(printf '%s\n' "$out" | sed -n 's/^train: culprit: \([^ ]*\) (\([0-9a-f]*\)) — alone it is \(.*\)$/\1 \2 \3/p' | tail -n 1)"
-    if [ -z "$culprit" ] && paused; then event paused "bisection of $name stopped by the kill switch"; return 20; fi
-    [ -n "$culprit" ] || { st_set phase blocked; event blocked "bisect of $name gave no culprit (log $STATE_DIR/bisect-$name.log)"; return 30; }
-    read -r ref sha verdict <<< "$culprit"
-  fi
-  local b="${ref#refs/bot/}"
-  if [ "$verdict" = green ]; then eject "$b" "$sha" "train $name red ($why); green alone, so an interaction with another member"
-  else eject "$b" "$sha" "train $name red ($why); red in bisection"; fi
-  return 10
-}
-
-# A step that ended a train leaves the phase idle, except a block, which waits for `bot.sh reset`.
-settle() { [ "$1" = 30 ] || st_set phase idle; return "$1"; }
-
-watch_and_land() { # train
-  local name="$1" rc=0 res
-  bash "$TRAIN" watch "$name" --interval "$WATCH_INTERVAL" > "$STATE_DIR/watch-$name.log" 2>&1 || rc=$?
-  if [ "$rc" != 0 ]; then
-    res="$(last_result "$name" watch)"
-    if [ "$res" = failed ]; then
-      # A paused bisection keeps the train in CI: the next tick re-reads the red run and resumes.
-      rc=0; bisect_and_eject "$name" --ci "CI landing tier failed" || rc=$?
-      [ "$rc" = 20 ] && return 20
-      settle "$rc"; return "$rc"
-    fi
-    event watch-incomplete "train $name: no verdict yet (${res:-unknown}); will look again next tick"
-    return 20
-  fi
-  if paused; then event paused "train $name is green; landing waits for the kill switch to clear"; return 20; fi
-  git checkout -q "train/$name"; land_assert_no_op checkout
-  rc=0; bash "$TRAIN" land "$name" > "$STATE_DIR/land-$name.log" 2>&1 || rc=$?
-  cat "$STATE_DIR/land-$name.log"
-  case "$rc" in
-    0) st_set phase idle
-       event landed "train $name at $(train_get "$name" head | cut -c1-10): $(train_get "$name" members | sed 's,refs/bot/,,g; s/@\([0-9a-f]\{10\}\)[0-9a-f]*/@\1/g')"
-       return 0 ;;
-    4) st_set phase idle; event main-moved "train $name: main moved before landing; rebuilding"; return 10 ;;
-    *) st_set phase blocked; event blocked "train $name: land failed (exit $rc; log $STATE_DIR/land-$name.log)"; return 30 ;;
-  esac
-}
-
-# After a crash or a failure between dispatch and recording the run id, find the run for this exact
-# train head instead of dispatching a second one. Prints the run id (or nothing: GitHub answered and
-# has no such run). Exit 2 when the lookup itself failed (network, auth, bad JSON): that is no answer.
-reconcile_run() { # train
-  local name="$1" id head out
-  id="$(train_get "$name" run_id)"
-  if [ -n "$id" ]; then echo "$id"; return 0; fi
-  head="$(train_get "$name" head)"
-  [ -n "$head" ] || return 0
-  out="$("${LAND_GH:-gh}" run list -R "${LAND_REPO:-unbalancedparentheses/concrete2}" --workflow CI --branch "ci/$name" \
-      --event workflow_dispatch -L 20 --json databaseId,headSha 2>/dev/null)" || return 2
-  printf '%s' "$out" | python3 -I -c '
-import json, sys
-try: runs = json.load(sys.stdin)
-except Exception: sys.exit(2)
-if not isinstance(runs, list): sys.exit(2)
-m = [r for r in runs if r.get("headSha") == sys.argv[1]]
-print(m[0]["databaseId"] if m else "")' "$head" || return 2
-}
-
-run_train() { # "branch sha"... (landing order)
-  TRAIN_SEQ=$((TRAIN_SEQ+1))
-  local name; name="bot-$(date -u +%Y%m%d-%H%M%S)-$TRAIN_SEQ"
-  local refs=() b sha line rc out desc=""
-  for line in "$@"; do
-    read -r b sha <<< "$line"
-    git update-ref "refs/bot/$b" "$sha"
-    refs+=("refs/bot/$b"); desc="$desc $b@${sha:0:10}"
-  done
-  st_set train "$name"; st_set phase build
-  event train "building $name from$desc"
-  rc=0; out="$(bash "$TRAIN" build "$name" --force "${refs[@]}" 2>&1)" || rc=$?
-  printf '%s\n' "$out" > "$STATE_DIR/build-$name.log"
-  if [ "$rc" = 3 ]; then
-    local who; who="$(printf '%s\n' "$out" | sed -n 's/^train: STOPPED — \([^ ]*\) conflicts.*/\1/p' | head -n 1)"
-    sha="$(git rev-parse "$who" 2>/dev/null || true)"
-    [ -n "$who" ] && [ -n "$sha" ] || { st_set phase blocked; event blocked "build of $name stopped without naming a member"; return 30; }
-    eject "${who#refs/bot/}" "$sha" "conflicts with the members ordered before it: $(printf '%s\n' "$out" | sed -n 's/^    //p' | tr '\n' ' ')"
-    st_set phase idle; return 10
-  elif [ "$rc" != 0 ]; then
-    [ -n "$(train_get "$name" members)" ] || { st_set phase blocked; event blocked "build of $name failed before recording members (log $STATE_DIR/build-$name.log)"; return 30; }
-    rc=0; bisect_and_eject "$name" true "build failed" || rc=$?
-    settle "$rc"; return "$rc"
-  fi
-  if paused; then st_set phase idle; event paused "train $name built; not checked (kill switch)"; return 20; fi
-  st_set phase check
-  rc=0; bash "$TRAIN" check "$name" "${CHECK_ARGS[@]}" > "$STATE_DIR/check-$name.log" 2>&1 || rc=$?
-  if [ "$rc" != 0 ]; then
-    local t
-    t="bash $(printf '%q' "$TRAIN") check \"\$(git symbolic-ref --short HEAD | sed 's,^train/,,')\" ${CHECK_ARGS[*]}"
-    rc=0; bisect_and_eject "$name" "$t" "check failed" || rc=$?
-    settle "$rc"; return "$rc"
-  fi
-  if paused; then st_set phase idle; event paused "train $name checked; CI not dispatched (kill switch)"; return 20; fi
-  # `dispatching` is persisted BEFORE the dispatch: a restart (or a failure to find the run) then
-  # reconciles with GitHub instead of dispatching the same candidate twice.
-  st_set dispatch_epoch "$(now)"; st_set phase dispatching
-  rc=0; bash "$TRAIN" ci "$name" > "$STATE_DIR/ci-$name.log" 2>&1 || rc=$?
-  if [ "$rc" != 0 ]; then event ci-failed "train $name: push, dispatch or run lookup failed; next tick reconciles (log $STATE_DIR/ci-$name.log)"; return 20; fi
-  st_set phase ci
-  watch_and_land "$name"
-}
-
-# --- subcommands ---------------------------------------------------------------------------------
-
-cmd_tick() {
-  if [ "$DRY" = 1 ]; then
-    if paused; then say "(dry-run) paused ($PAUSE exists); a tick would do nothing"; return 0; fi
-  else
-    # The lock first: only the instance that owns the bot acknowledges a pause.
-    acquire_lock
-    if paused; then ack_pause "start of a tick"; return 0; fi
-  fi
-  land_assert_no_op start
-  [ -z "$(git status --porcelain --untracked-files=no)" ] || die "the bot's clone has uncommitted changes; it must be a dedicated clone"
-  sync_remote
-  local phase train rc
-  phase="$(st_get phase)"; train="$(st_get train)"
-  case "$phase" in
-    blocked) event blocked-still "train ${train:-?} needs a human (bot.sh status; then bot.sh reset)"; return 0 ;;
-    ci)
-      if [ "$DRY" = 1 ]; then say "(dry-run) would resume watching train $train"; else
-        event resume "train $train is in CI; watching it instead of dispatching again"
-        rc=0; watch_and_land "$train" || rc=$?
-        case "$rc" in 0|10) ;; *) return 0 ;; esac
-      fi ;;
-    dispatching)
-      local id="" lrc=0 since
-      [ "$DRY" = 1 ] || id="$(reconcile_run "$train")" || lrc=$?
-      since="$(st_get dispatch_epoch)"; since=$(( $(now) - ${since:-0} ))
-      if [ "$DRY" = 1 ]; then say "(dry-run) would reconcile the dispatch of train $train"
-      elif [ "$lrc" != 0 ]; then
-        event dispatch-unknown "train $train: the CI run lookup failed; keeping it as dispatching and asking again next tick"; return 0
-      elif [ -z "$id" ] && [ "$since" -lt "${BOT_DISPATCH_GRACE:-900}" ]; then
-        event dispatch-unknown "train $train: no run visible yet ${since}s after its dispatch; asking again next tick"; return 0
-      elif [ -n "$id" ]; then
-        train_set "$train" run_id "$id"; st_set phase ci
-        event resume "train $train was dispatched as run $id before the restart; watching it"
-        rc=0; watch_and_land "$train" || rc=$?
-        case "$rc" in 0|10) ;; *) return 0 ;; esac
-      else
-        event resume "train $train has no CI run at its head ${since}s after its dispatch; discarding it and starting over"; st_set phase idle
-      fi ;;
-    build|check) event resume "train $train was interrupted at $phase; discarding it and starting over"; st_set phase idle ;;
-  esac
-  if [ "${BOT_NO_REBASE:-0}" != 1 ]; then rebase_pass; sync_remote; fi
-  local n=0 ready lines
-  while [ "$n" -lt "$MAX_TRAINS" ]; do
-    if paused; then ack_pause "before the next train"; break; fi
-    ready="$(ordered_ready)"
-    [ -n "$ready" ] || { say "no ready branches"; break; }
-    lines=()
-    while read -r _k _s b sha _r; do lines+=("$b $sha"); done <<< "$ready"
-    if [ "$DRY" = 1 ]; then
-      say "(dry-run) would build one train, in this order:"; printf '%s\n' "$ready" | sed 's/^/    /'
-      bash "$TRAIN" --dry-run build bot-dry-run $(printf '%s\n' "$ready" | awk '{print $4}') || true
-      break
-    fi
-    n=$((n+1))
-    rc=0; run_train "${lines[@]}" || rc=$?
-    case "$rc" in 0|10) ;; *) break ;; esac
-  done
-  if [ "$DRY" = 0 ]; then git checkout -q --detach "$REMOTE/main"; land_assert_no_op "final checkout"; fi
-}
-
-case "$SUB" in
-  tick) cmd_tick ;;
-  rebase)
-    [ "$DRY" = 1 ] || acquire_lock
-    if paused; then [ "$DRY" = 1 ] && say "(dry-run) paused" || ack_pause "start of a rebase pass"; exit 0; fi
-    sync_remote; rebase_pass ;;
-  list) sync_remote; ordered_ready ;;
-  status)
-    echo "state ($STATE):"; sed 's/^/    /' "$STATE" 2>/dev/null || echo "    (none)"
-    paused && echo "PAUSED: $PAUSE exists"
-    echo "last events:"; tail -n 20 "$EVENTS" 2>/dev/null | sed 's/^/    /' || true ;;
-  reset) st_set phase idle; event reset "blocked state cleared by hand" ;;
-  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
-esac
diff --git a/scripts/land/impact_gates.sh b/scripts/land/impact_gates.sh
index d60fd42bb..b854862cd 100755
--- a/scripts/land/impact_gates.sh
+++ b/scripts/land/impact_gates.sh
@@ -1,6 +1,6 @@
 #!/usr/bin/env bash
 # The impact-selected gates for exactly the range base..head, run in the current checkout (which must
-# be at head). Shared by train.sh check, ready.sh and the landing bot's auto-rebase.
+# be at head). Shared by train.sh check and ready.sh.
 #
 #   impact_gates.sh --base <sha> --head <sha> [--src-ref R] [--dst-ref R] [--report FILE]
 #
diff --git a/scripts/land/install-bot.sh b/scripts/land/install-bot.sh
deleted file mode 100755
index c8a59469e..000000000
--- a/scripts/land/install-bot.sh
+++ /dev/null
@@ -1,123 +0,0 @@
-#!/usr/bin/env bash
-# Install the landing bot for user `dev` on the gate host. It does NOT enable the bot: it prints the
-# enable command, because turning it on is the maintainers' decision.
-#
-#   install-bot.sh [--ssh dev@62.210.216.169] [--source-ref origin/main] [--clone ~/concrete-bot]
-#
-# --ssh runs this script on that host (key: CONCRETE_REMOTE_KEY, default ~/.ssh/concrete_ci).
-# On the host it:
-#   1. makes a DEDICATED clone (default ~/concrete-bot): the bot checks out trains there, so no human
-#      or agent may work in it. Remotes: origin and lambdaclass; core.hooksPath=.githooks.
-#   2. writes ~/.local/libexec/concrete-landing-bot, which fetches, extracts $SNAPSHOT (scripts/land and
-#      the files it reads outside it) from
-#      <source-ref> into an immutable snapshot (keyed by commit) and runs the bot from there, so a
-#      train checkout never rewrites the running script. Full gates run locally through
-#      scripts/land/run-at-ref.sh, fetching the train SHA from the bot's clone.
-#   3. writes ~/.config/concrete-landing-bot.env (kept if it exists) and the user units
-#      concrete-landing-bot.{service,timer} from <source-ref>, then reloads systemd. Nothing is enabled.
-set -euo pipefail
-if [ "${1:-}" = --ssh ]; then
-  host="${2:?--ssh needs user@host}"; shift 2
-  exec ssh -i "${CONCRETE_REMOTE_KEY:-$HOME/.ssh/concrete_ci}" -o StrictHostKeyChecking=accept-new "$host" \
-    bash -s -- "$@" < "$0"
-fi
-REF="origin/main"; CLONE="$HOME/concrete-bot"
-while [ $# -gt 0 ]; do
-  case "$1" in
-    --source-ref) REF="$2"; shift ;;
-    --clone) CLONE="$2"; shift ;;
-    *) echo "install-bot: unknown argument $1" >&2; exit 2 ;;
-  esac; shift
-done
-say() { echo "install-bot: $*"; }
-# The snapshot: every path the landing scripts read outside scripts/land (each path above SELF_DIR in
-# scripts/land/*.sh, and what those files source), so a snapshot is the scripts' whole closure.
-# scripts/checks/landing_bot.sh fails when a landing script reads a path this list does not cover.
-# (Until 2026-11-08 it held only scripts/land and git_sandbox.sh: train.sh's review_provenance found
-# no scripts/review/verify.sh and refused every train run from a snapshot.)
-SNAPSHOT="scripts/land scripts/review/verify.sh scripts/checks/lib/git_sandbox.sh scripts/checks/lib/prepush_record.sh scripts/checks/lib/treestate.sh"
-[ "$(id -un)" = dev ] || say "WARNING: running as $(id -un), not dev"
-ORIGIN_URL="${INSTALL_ORIGIN_URL:-$(git -C "$HOME/concrete2" remote get-url origin 2>/dev/null || echo git@github.com:unbalancedparentheses/concrete2.git)}"
-MIRROR_URL="${INSTALL_MIRROR_URL:-git@github.com:lambdaclass/concrete.git}"
-
-# 1. the dedicated clone
-if [ ! -d "$CLONE/.git" ]; then
-  say "cloning $ORIGIN_URL into $CLONE"
-  git clone -q "$ORIGIN_URL" "$CLONE"
-fi
-cd "$CLONE"
-git remote get-url lambdaclass >/dev/null 2>&1 || git remote add lambdaclass "$MIRROR_URL"
-if git remote get-url fork >/dev/null 2>&1; then say "the clone has a remote named 'fork'; the bot refuses it, removing it"; git remote remove fork; fi
-git config core.hooksPath .githooks
-git config user.name >/dev/null || git config user.name "Concrete landing bot"
-git config user.email >/dev/null || git config user.email "landing-bot@concrete-ci-1.invalid"
-git fetch -q origin
-git rev-parse --verify -q "$REF:scripts/land/bot.sh" >/dev/null \
-  || { say "$REF has no scripts/land/bot.sh; pass --source-ref origin/wip/landing-bot until it lands"; exit 1; }
-SHA="$(git rev-parse "$REF^{commit}")"
-
-# 2. the launcher
-mkdir -p "$HOME/.local/libexec" "$HOME/.local/state/concrete-landing-bot" "$HOME/.config/systemd/user"
-cat > "$HOME/.local/libexec/concrete-landing-bot" <<EOF
-#!/usr/bin/env bash
-# Generated by scripts/land/install-bot.sh. Runs scripts/land/bot.sh from an immutable snapshot of
-# \$BOT_SOURCE_REF, in the dedicated clone $CLONE.
-set -euo pipefail
-cd "$CLONE"
-git fetch -q origin
-sha="\$(git rev-parse --verify "\${BOT_SOURCE_REF:-$REF}^{commit}")"
-snaps="\$HOME/.local/state/concrete-landing-bot/snap"
-snap="\$snaps/\$sha"
-# Complete means every FILE the commit has under the SNAPSHOT paths is there (not only the listed
-# directories): a snapshot missing scripts/land/bot.sh, say, is rebuilt, not run.
-complete=1
-files="\$(git ls-tree -r --name-only "\$sha" -- $SNAPSHOT)"
-[ -n "\$files" ] || { echo "concrete-landing-bot: \$sha has none of the snapshot paths" >&2; exit 1; }
-while IFS= read -r p; do [ -f "\$snap/\$p" ] || { complete=0; break; }; done <<< "\$files"
-if [ "\$complete" = 0 ]; then
-  rm -rf "\${snap:?}" "\$snap.tmp"; mkdir -p "\$snap.tmp"
-  git archive "\$sha" $SNAPSHOT | tar -x -C "\$snap.tmp"
-  mv "\$snap.tmp" "\$snap"
-  ls -1t "\$snaps" | tail -n +6 | while read -r old; do rm -rf "\${snaps:?}/\$old"; done
-fi
-export LAND_REMOTE_RUNNER="\${LAND_REMOTE_RUNNER-\$snap/scripts/land/run-at-ref.sh}"
-export RUN_AT_REF_SOURCE="\${RUN_AT_REF_SOURCE:-$CLONE}"
-export LAND_REMOTE_PUSH="\${LAND_REMOTE_PUSH:-0}"
-exec bash "\$snap/scripts/land/bot.sh" "\$@"
-EOF
-chmod 755 "$HOME/.local/libexec/concrete-landing-bot"
-
-# 3. environment and units
-ENVF="$HOME/.config/concrete-landing-bot.env"
-if [ ! -f "$ENVF" ]; then
-  cat > "$ENVF" <<EOF
-# Landing bot environment (systemd EnvironmentFile; plain KEY=value lines).
-BOT_SOURCE_REF=$REF
-PATH=$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/usr/local/bin:/usr/bin:/bin
-LAND_REPO=unbalancedparentheses/concrete2
-BOT_WATCH_INTERVAL=60
-BOT_MAX_TRAINS=4
-EOF
-  say "wrote $ENVF"
-else
-  say "kept the existing $ENVF"
-fi
-for u in concrete-landing-bot.service concrete-landing-bot.timer; do
-  git show "$SHA:scripts/land/systemd/$u" > "$HOME/.config/systemd/user/$u"
-done
-systemctl --user daemon-reload 2>/dev/null || say "systemctl --user daemon-reload failed (no user manager in this session); the enable command below reloads"
-
-# Prerequisites the bot needs and this script does not create.
-gh auth status >/dev/null 2>&1 && say "gh: authenticated" || say "MISSING: gh is not authenticated for $(id -un) (gh auth login); the bot dispatches and reads CI"
-# ssh -T exits 1 even when it authenticates, so read its words, not its status.
-gh_ssh="$(ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -T git@github.com 2>&1 || true)"
-case "$gh_ssh" in
-  *"successfully authenticated"*) say "github ssh: authenticated (it still needs WRITE access to both repositories)" ;;
-  *) say "MISSING: no GitHub SSH identity for $(id -un); the bot pushes main to origin and lambdaclass, ci/* and notes to origin" ;;
-esac
-
-say "installed at $SHA ($REF); NOT enabled. To turn it on:"
-echo "    sudo loginctl enable-linger dev        # once, as ubuntu: user timers run without a login"
-echo "    systemctl --user daemon-reload && systemctl --user enable --now concrete-landing-bot.timer   # as dev"
-echo "  pause: touch ~/.concrete-bot-paused   status: ~/.local/libexec/concrete-landing-bot status"
-echo "  log:   ~/.local/state/concrete-landing-bot.log"
diff --git a/scripts/land/notes.sh b/scripts/land/notes.sh
index 1ba57fdb2..dff54998e 100755
--- a/scripts/land/notes.sh
+++ b/scripts/land/notes.sh
@@ -7,9 +7,8 @@
 #                                checked by scripts/review/verify.sh)
 #   refs/notes/concrete-gates    gates: pass|fail          selected: N                   utc: ...
 #
-# One `key: value` per line; when a key repeats, the last line wins. Optional in either note:
-# `order: N` (explicit landing order, lower first). A note is attached to a commit, so a verdict
-# is bound to that exact SHA: a new commit starts with no notes, and no rule has to say so.
+# One `key: value` per line; when a key repeats, the last line wins. A note is attached to a
+# commit, so a verdict is bound to that exact SHA: a new commit starts with no notes, and no rule has to say so.
 #
 #   notes.sh fetch                          copy the remote notes to refs/notes/remote/concrete-*
 #   notes.sh get <kind> <sha> [<key>]       print the published note (or one key) of <sha>
@@ -18,7 +17,7 @@
 #   notes.sh ready <sha>                    exit 0 iff verdict is clean and gates is pass
 #
 # <kind> is review or gates. LAND_REMOTE (default origin) names the remote; `fork` is refused.
-# Writers: scripts/review/review.sh (review), scripts/land/ready.sh and the landing bot (gates).
+# Writers: scripts/review/review.sh (review) and scripts/land/ready.sh (gates).
 # `put` never force-pushes: it rewrites on top of the remote's notes tip and retries on a race.
 set -euo pipefail
 REMOTE="${LAND_REMOTE:-origin}"
diff --git a/scripts/land/notify.env.example b/scripts/land/notify.env.example
deleted file mode 100644
index 16c4f7b20..000000000
--- a/scripts/land/notify.env.example
+++ /dev/null
@@ -1,18 +0,0 @@
-# Copy to ~/.config/concrete/notify.env and `chmod 600` it. NEVER commit the real file.
-# scripts/land/notify.sh parses KEY=VALUE lines (it does not source this file).
-
-# ntfy (https://ntfy.sh): install the ntfy app on the phone and subscribe to this topic. No account.
-# An ntfy topic is a shared secret, not a name: anyone who knows it can read every notification and
-# post fake ones. Use a long random string, for example the output of
-#   python3 -c 'import secrets; print("concrete-" + secrets.token_urlsafe(24))'
-# notify.sh refuses a topic shorter than 24 characters.
-NTFY_TOPIC=
-# NTFY_SERVER=https://ntfy.sh
-# Only for a self-hosted server or a reserved topic (values never carry trailing comments):
-# NTFY_TOKEN=
-
-# Slack incoming webhook (optional). The URL is itself the credential.
-SLACK_WEBHOOK_URL=
-
-# An identical (level, title, body) inside this many seconds is sent once.
-NOTIFY_DEDUP_SECONDS=900
diff --git a/scripts/land/notify.sh b/scripts/land/notify.sh
deleted file mode 100755
index e881acb93..000000000
--- a/scripts/land/notify.sh
+++ /dev/null
@@ -1,145 +0,0 @@
-#!/usr/bin/env bash
-# Push a notification about landing work: scripts/land/notify.sh [--dry-run] <level> <title> <body>
-#
-#   level   info | success | warn | error   (sets the ntfy priority and tags, and the Slack emoji)
-#
-# Channels come from ~/.config/concrete/notify.env (CONCRETE_NOTIFY_ENV overrides the path); see
-# scripts/land/notify.env.example. The file is parsed as KEY=VALUE lines, never sourced:
-#
-#   NTFY_TOPIC         ntfy topic (https://ntfy.sh, no account). It MUST be a long random string:
-#                      an ntfy topic is public, so anyone who guesses it can read every message and
-#                      post fake ones. Topics shorter than 24 characters are refused.
-#   NTFY_SERVER        default https://ntfy.sh
-#   NTFY_TOKEN         optional access token (a self-hosted or reserved topic)
-#   SLACK_WEBHOOK_URL  optional Slack incoming webhook
-#   NOTIFY_DEDUP_SECONDS  an identical (level, title, body) inside this window is dropped; default 900
-#
-# With no channel configured, or when every channel fails, the message goes to stdout. Delivery
-# failures are reported on stderr but the exit status is still 0, so a notification can never fail
-# a landing. Exit 2 is a usage error only. --dry-run (or NOTIFY_DRY_RUN=1) prints what each channel
-# would receive, with the topic and webhook redacted, and sends nothing; it honours the dedup window
-# but records nothing in it.
-#
-# Test seams: NOTIFY_CURL (curl binary), NOTIFY_STATE_DIR (dedup state), NOTIFY_NOW (epoch).
-set -uo pipefail
-
-DRY="${NOTIFY_DRY_RUN:-0}"
-if [ "${1:-}" = "--dry-run" ]; then DRY=1; shift; fi
-usage() { echo "usage: notify.sh [--dry-run] <info|success|warn|error> <title> <body>" >&2; exit 2; }
-[ "$#" -eq 3 ] || usage
-LEVEL="$1" TITLE="$2" BODY="$3"
-case "$LEVEL" in info|success|warn|error) ;; *) usage ;; esac
-
-ENV_FILE="${CONCRETE_NOTIFY_ENV:-$HOME/.config/concrete/notify.env}"
-CURL="${NOTIFY_CURL:-curl}"
-STATE_DIR="${NOTIFY_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/concrete/notify}"
-NOW="${NOTIFY_NOW:-$(date +%s)}"
-
-NTFY_TOPIC="" NTFY_SERVER="https://ntfy.sh" NTFY_TOKEN="" SLACK_WEBHOOK_URL="" NOTIFY_DEDUP_SECONDS=900
-if [ -f "$ENV_FILE" ]; then
-  # A world- or group-readable file leaks the topic to other users on a shared host.
-  perm="$(stat -c %a "$ENV_FILE" 2>/dev/null || stat -f %Lp "$ENV_FILE" 2>/dev/null || echo 600)"
-  case "$perm" in *00) ;; *) echo "notify: warning: $ENV_FILE is mode $perm; chmod 600 it" >&2 ;; esac
-  while IFS= read -r line || [ -n "$line" ]; do
-    line="${line%$'\r'}"
-    case "$line" in ''|'#'*) continue ;; esac
-    key="${line%%=*}"; val="${line#*=}"
-    key="${key//[[:space:]]/}"
-    val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"
-    case "$val" in \"*\") val="${val:1:${#val}-2}" ;; \'*\') val="${val:1:${#val}-2}" ;; esac
-    case "$key" in
-      NTFY_TOPIC|NTFY_SERVER|NTFY_TOKEN|SLACK_WEBHOOK_URL|NOTIFY_DEDUP_SECONDS) printf -v "$key" '%s' "$val" ;;
-      *) echo "notify: ignoring unknown key '$key' in $ENV_FILE" >&2 ;;
-    esac
-  done < "$ENV_FILE"
-fi
-case "$NOTIFY_DEDUP_SECONDS" in ''|*[!0-9]*) NOTIFY_DEDUP_SECONDS=900 ;; esac
-
-# --- dedup: same level+title+body within the window is dropped ------------------------------------
-hash_of() { if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi | cut -c1-32; }
-KEY="$(printf '%s\0%s\0%s' "$LEVEL" "$TITLE" "$BODY" | hash_of)"
-mkdir -p "$STATE_DIR" 2>/dev/null && chmod 700 "$STATE_DIR" 2>/dev/null
-STAMP="$STATE_DIR/$KEY"
-if [ -f "$STAMP" ]; then
-  last="$(cat "$STAMP" 2>/dev/null)"; case "$last" in ''|*[!0-9]*) last=0 ;; esac
-  if [ $(( NOW - last )) -lt "$NOTIFY_DEDUP_SECONDS" ]; then
-    echo "notify: suppressed duplicate ($LEVEL) '$TITLE' (sent $(( NOW - last ))s ago, window ${NOTIFY_DEDUP_SECONDS}s)" >&2
-    exit 0
-  fi
-fi
-# Old stamps are pruned so the directory does not grow without bound.
-find "$STATE_DIR" -type f -mmin +1440 -delete 2>/dev/null || true
-
-case "$LEVEL" in
-  info)    PRIO=default; TAGS=information_source; EMOJI=":information_source:" ;;
-  success) PRIO=default; TAGS=white_check_mark;   EMOJI=":white_check_mark:" ;;
-  warn)    PRIO=high;    TAGS=warning;            EMOJI=":warning:" ;;
-  error)   PRIO=urgent;  TAGS=rotating_light;     EMOJI=":rotating_light:" ;;
-esac
-
-json_str() { python3 -I -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"; }
-sent=0 tried=0
-
-# post <secret-url> [header...]; body on stdin. The URL (it carries the topic or the webhook secret)
-# and any Authorization header go in a mode-600 curl config file, so no secret is on a command line
-# (visible in ps) and nothing is passed as `@file` text: the body is read from stdin (`@-`), so a body
-# that starts with `@` cannot make curl upload a local file.
-post() {
-  local url="$1" cfg rc; shift
-  cfg="$(umask 077; mktemp)" || return 1
-  printf 'url = "%s"\n' "$url" > "$cfg"
-  [ -n "$NTFY_TOKEN" ] && [ "$url" != "$SLACK_WEBHOOK_URL" ] && printf 'header = "Authorization: Bearer %s"\n' "$NTFY_TOKEN" >> "$cfg"
-  "$CURL" -fsS -m 15 "$@" --data-binary @- -K "$cfg" >/dev/null; rc=$?
-  rm -f "$cfg"; return "$rc"
-}
-# A value written into the curl config must not be able to close its quotes or add a line.
-safe_cfg() { [[ "$1" =~ ^[A-Za-z0-9_.:/?=\&%+~-]+$ ]]; }
-
-if [ -n "$NTFY_TOPIC" ]; then
-  if ! [[ "$NTFY_TOPIC" =~ ^[A-Za-z0-9_-]{24,64}$ ]]; then
-    echo "notify: NTFY_TOPIC refused: use 24-64 random characters [A-Za-z0-9_-] (a short topic is guessable, and anyone who guesses it can read and post)" >&2
-  elif ! safe_cfg "$NTFY_SERVER" || { [ -n "$NTFY_TOKEN" ] && ! safe_cfg "$NTFY_TOKEN"; }; then
-    echo "notify: NTFY_SERVER or NTFY_TOKEN contains characters notify.sh does not pass to curl" >&2
-  else
-    tried=$((tried+1))
-    # Header values cannot carry newlines; the body can.
-    t1="$(printf '%s' "$TITLE" | tr '\r\n' '  ')"
-    if [ "$DRY" = 1 ]; then
-      echo "dry-run ntfy: POST ${NTFY_SERVER%/}/<topic> priority=$PRIO tags=$TAGS title=$t1"
-      echo "dry-run ntfy body: $BODY"
-      sent=$((sent+1))
-    elif printf '%s' "$BODY" | post "${NTFY_SERVER%/}/$NTFY_TOPIC" -H "Title: $t1" -H "Priority: $PRIO" -H "Tags: $TAGS"; then
-      sent=$((sent+1))
-    else
-      echo "notify: ntfy delivery failed" >&2
-    fi
-  fi
-fi
-
-if [ -n "$SLACK_WEBHOOK_URL" ]; then
-  if ! safe_cfg "$SLACK_WEBHOOK_URL"; then
-    echo "notify: SLACK_WEBHOOK_URL contains characters notify.sh does not pass to curl" >&2
-  else
-    tried=$((tried+1))
-    payload="{\"text\": $(json_str "$EMOJI *$TITLE*"$'\n'"$BODY")}"
-    if [ "$DRY" = 1 ]; then
-      echo "dry-run slack: POST <webhook> $payload"
-      sent=$((sent+1))
-    elif printf '%s' "$payload" | post "$SLACK_WEBHOOK_URL" -H 'Content-Type: application/json'; then
-      sent=$((sent+1))
-    else
-      echo "notify: slack delivery failed" >&2
-    fi
-  fi
-fi
-
-if [ "$sent" -eq 0 ]; then
-  [ "$tried" -gt 0 ] && echo "notify: no channel delivered; falling back to stdout" >&2
-  printf '[%s] %s: %s\n' "$LEVEL" "$TITLE" "$BODY"
-fi
-# A dry run records nothing, so the real send that follows it is not suppressed; neither does a
-# message that every configured channel failed to deliver, so a retry is not swallowed as a duplicate.
-if [ "$DRY" != 1 ] && { [ "$sent" -gt 0 ] || [ "$tried" -eq 0 ]; }; then
-  printf '%s\n' "$NOW" > "$STAMP" 2>/dev/null || true
-fi
-exit 0
