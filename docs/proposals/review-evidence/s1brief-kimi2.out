• The gate audit found another concrete mismatch: R-0576 requires both a planted policy violation and a planted unknown fact, while the brief supplies only the unknown-fact control. Several other B1 rows are listed as dependencies but have no corresponding acceptance control in the definition of done.     1	import ConcreteSpec.Spec.Surface0
     2	
     3	/-!
     4	# Settled lexer components
     5	
     6	Total byte-list UTF-8 decoding and source checking, ASCII identifier tests and line comments.
     7	No tokens, literal rules, whitespace rules, shebang handling or block comments are introduced.
     8	Error constructors are internal data, not diagnostic wording. Offsets are zero-based byte offsets;
     9	truncation points at EOF. TODO: prove the first non-extendible-prefix property of error offsets.
    10	The success correspondence theorems below do not claim error-position correctness.
    11	-/
    12	
    13	set_option maxRecDepth 2048
    14	
    15	namespace Concrete.Lex
    16	open ConcreteSpec.Surface0
    17	
    18	/-- Internal refusal categories; no user-visible diagnostic spelling is fixed. -/
    19	inductive DecodeReason where
    20	  | truncated | overlong | surrogate | tooLarge | unexpectedContinuation | nul | bom
    21	  deriving DecidableEq, Repr
    22	
    23	/-- A refusal and its zero-based byte offset (EOF for missing bytes). -/
    24	structure DecodeError where
    25	  offset : Nat
    26	  reason : DecodeReason
    27	  deriving DecidableEq, Repr
    28	
    29	/-- Diagnose an invalid UTF-8 sequence from its leading byte, checking each byte in order.
    30	`unexpectedContinuation` also covers a non-continuation where a continuation was required. -/
    31	def badSequence (off : Nat) : List UInt8 → DecodeError
    32	  | [] => ⟨off, .truncated⟩
    33	  | a :: rest =>
    34	    if a.toNat < 0xC0 then ⟨off, .unexpectedContinuation⟩
    35	    else if a.toNat < 0xC2 then ⟨off, .overlong⟩
    36	    else if a.toNat > 0xF4 then ⟨off, .tooLarge⟩
    37	    else
    38	      let n := if a.toNat < 0xE0 then 1 else if a.toNat < 0xF0 then 2 else 3
    39	      let rec check (i : Nat) (left : Nat) (xs : List UInt8) : DecodeError :=
    40	        match left, xs with
    41	        | 0, _ => ⟨off, .unexpectedContinuation⟩
    42	        | _ + 1, [] => ⟨off + i, .truncated⟩
    43	        | k + 1, b :: bs =>
    44	          if b.toNat < 0x80 ∨ b.toNat > 0xBF then ⟨off + i, .unexpectedContinuation⟩
    45	          else if i = 1 ∧ ((a.toNat = 0xE0 ∧ b.toNat < 0xA0) ∨
    46	              (a.toNat = 0xF0 ∧ b.toNat < 0x90)) then ⟨off + i, .overlong⟩
    47	          else if i = 1 ∧ a.toNat = 0xED ∧ b.toNat > 0x9F then ⟨off + i, .surrogate⟩
    48	          else if i = 1 ∧ a.toNat = 0xF4 ∧ b.toNat > 0x8F then ⟨off + i, .tooLarge⟩
    49	          else check (i + 1) k bs
    50	      check 1 n rest
    51	
    52	/-- Prepend a decoded scalar, preserving a refusal unchanged. -/
    53	def prepend (c : Nat) : Except DecodeError (List Nat) → Except DecodeError (List Nat)
    54	  | .ok cs => .ok (c :: cs)
    55	  | .error e => .error e
    56	
    57	/-- Decode by structural recursion on the unconsumed byte list. -/
    58	def decodeAt (off : Nat) : List UInt8 → Except DecodeError (List Nat)
    59	  | [] => .ok []
    60	  | a :: bs =>
    61	    if Utf8.One a then prepend a.toNat (decodeAt (off + 1) bs)
    62	    else match bs with
    63	    | [] => .error (badSequence off [a])
    64	    | b :: bs =>
    65	      if Utf8.Two a b then
    66	        prepend ((a.toNat - 0xC0) * 64 + (b.toNat - 0x80)) (decodeAt (off + 2) bs)
    67	      else match bs with
    68	      | [] => .error (badSequence off [a, b])
    69	      | c :: bs =>
    70	        if Utf8.Three a b c then
    71	          prepend ((a.toNat - 0xE0) * 4096 + (b.toNat - 0x80) * 64 + (c.toNat - 0x80))
    72	            (decodeAt (off + 3) bs)
    73	        else match bs with
    74	        | [] => .error (badSequence off [a, b, c])
    75	        | d :: bs =>
    76	          if Utf8.Four a b c d then
    77	            prepend ((a.toNat - 0xF0) * 262144 + (b.toNat - 0x80) * 4096 +
    78	              (c.toNat - 0x80) * 64 + (d.toNat - 0x80)) (decodeAt (off + 4) bs)
    79	          else .error (badSequence off (a :: b :: c :: d :: bs))
    80	
    81	/-- Decode a source byte list, starting at byte zero. -/
    82	def decodeUtf8 (bs : List UInt8) : Except DecodeError (List Nat) := decodeAt 0 bs
    83	
    84	/-- Successful prepending exposes a successful tail and its scalar list. -/
    85	theorem prepend_ok {c : Nat} {r : Except DecodeError (List Nat)} {cs : List Nat} :
    86	    prepend c r = .ok cs → ∃ ds, r = .ok ds ∧ cs = c :: ds := by
    87	  cases r with
    88	  | error e => intro h; cases h
    89	  | ok ds => intro h; exact ⟨ds, rfl, (Except.ok.inj h).symm⟩
    90	
    91	/-- Every success of the offset-carrying decoder satisfies the independent judgment. -/
    92	theorem decodeAt_sound (bs : List UInt8) (off : Nat) (cs : List Nat)
    93	    (h : decodeAt off bs = .ok cs) : Utf8.Decodes bs cs := by
    94	  induction off, bs using decodeAt.induct generalizing cs with
    95	  | case1 off =>
    96	    simp only [decodeAt.eq_def, Except.ok.injEq] at h
    97	    subst cs
    98	    exact Utf8.Decodes.nil
    99	  | case2 off a bs ha ih =>
   100	    rw [decodeAt.eq_def] at h
   101	    simp only [ha, ↓reduceIte] at h
   102	    obtain ⟨ds, hd, rfl⟩ := prepend_ok h
   103	    exact Utf8.Decodes.cons (show Utf8.Encodes a.toNat [a] from ⟨ha, rfl⟩) (ih ds hd)
   104	  | case3 off a ha =>
   105	    rw [decodeAt.eq_def] at h
   106	    simp [ha] at h
   107	  | case4 off a ha b bs hb ih =>
   108	    rw [decodeAt.eq_def] at h
   109	    simp only [ha, hb, ↓reduceIte] at h
   110	    obtain ⟨ds, hd, rfl⟩ := prepend_ok h
   111	    exact Utf8.Decodes.cons (show Utf8.Encodes _ [a, b] from ⟨hb, rfl⟩) (ih ds hd)
   112	  | case5 off a ha b hb =>
   113	    rw [decodeAt.eq_def] at h
   114	    simp [ha, ↓reduceIte, hb] at h
   115	  | case6 off a ha b hb c bs hc ih =>
   116	    rw [decodeAt.eq_def] at h
   117	    simp only [ha, hb, hc, ↓reduceIte] at h
   118	    obtain ⟨ds, hd, rfl⟩ := prepend_ok h
   119	    exact Utf8.Decodes.cons (show Utf8.Encodes _ [a, b, c] from ⟨hc, rfl⟩) (ih ds hd)
   120	  | case7 off a ha b hb c hc =>
   121	    rw [decodeAt.eq_def] at h
   122	    simp [ha, ↓reduceIte, hb, hc] at h
   123	  | case8 off a ha b hb c hc d bs hd ih =>
   124	    rw [decodeAt.eq_def] at h
   125	    simp only [ha, hb, hc, hd, ↓reduceIte] at h
   126	    obtain ⟨ds, he, rfl⟩ := prepend_ok h
   127	    exact Utf8.Decodes.cons (show Utf8.Encodes _ [a, b, c, d] from ⟨hd, rfl⟩) (ih ds he)
   128	  | case9 off a ha b hb c hc d bs hd =>
   129	    rw [decodeAt.eq_def] at h
   130	    simp [ha, ↓reduceIte, hb, hc, hd] at h
   131	
   132	/-- Every well-formed concatenation is accepted, at every starting offset. -/
   133	theorem decodeAt_complete {bs : List UInt8} {cs : List Nat} (h : Utf8.Decodes bs cs)
   134	    (off : Nat) : decodeAt off bs = .ok cs := by
   135	  induction h generalizing off with
   136	  | nil => rfl
   137	  | @cons s chunk bs cs enc tail ih =>
   138	    match chunk with
   139	    | [] => simp [Utf8.Encodes] at enc
   140	    | [a] =>
   141	      obtain ⟨ha, rfl⟩ := enc
   142	      simp only [List.cons_append, List.nil_append]
   143	      rw [decodeAt.eq_def]
   144	      simp only [ha, ↓reduceIte, ih, prepend]
   145	    | [a, b] =>
   146	      obtain ⟨hab, rfl⟩ := enc
   147	      have ha : ¬ Utf8.One a := by unfold Utf8.One; unfold Utf8.Two at hab; omega
   148	      simp only [List.cons_append, List.nil_append]
   149	      rw [decodeAt.eq_def]
   150	      simp only [ha, ↓reduceIte, hab, ih, prepend]
   151	    | [a, b, c] =>
   152	      obtain ⟨habc, rfl⟩ := enc
   153	      have ha : ¬ Utf8.One a := by unfold Utf8.One; unfold Utf8.Three at habc; omega
   154	      have hb : ¬ Utf8.Two a b := by unfold Utf8.Two; unfold Utf8.Three at habc; omega
   155	      simp only [List.cons_append, List.nil_append]
   156	      rw [decodeAt.eq_def]
   157	      simp only [ha, ↓reduceIte, hb, habc, ih, prepend]
   158	    | [a, b, c, d] =>
   159	      obtain ⟨habcd, rfl⟩ := enc
   160	      have ha : ¬ Utf8.One a := by unfold Utf8.One; unfold Utf8.Four at habcd; omega
   161	      have hb : ¬ Utf8.Two a b := by unfold Utf8.Two; unfold Utf8.Four at habcd; omega
   162	      have hc : ¬ Utf8.Three a b c := by unfold Utf8.Three; unfold Utf8.Four at habcd; omega
   163	      simp only [List.cons_append, List.nil_append]
   164	      rw [decodeAt.eq_def]
   165	      simp only [ha, ↓reduceIte, hb, hc, habcd, ih, prepend]
   166	    | _ :: _ :: _ :: _ :: _ :: _ => simp [Utf8.Encodes] at enc
   167	
   168	/-- Successful decoding is sound. -/
   169	theorem decodeUtf8_sound {bs : List UInt8} {cs : List Nat}
   170	    (h : decodeUtf8 bs = .ok cs) : Utf8.Decodes bs cs := decodeAt_sound bs 0 cs h
   171	
   172	/-- Every declarative decoding is returned by the decoder. -/
   173	theorem decodeUtf8_complete {bs : List UInt8} {cs : List Nat}
   174	    (h : Utf8.Decodes bs cs) : decodeUtf8 bs = .ok cs := decodeAt_complete h 0
   175	
   176	/-- The independent decoding judgment is deterministic. -/
   177	theorem decodes_unique {bs : List UInt8} {cs ds : List Nat}
   178	    (hc : Utf8.Decodes bs cs) (hd : Utf8.Decodes bs ds) : cs = ds := by
   179	  have := (decodeUtf8_complete hc).symm.trans (decodeUtf8_complete hd)
   180	  exact Except.ok.inj this
   181	
   182	/-- Refuse NUL or BOM before inspecting the remaining source. -/
   183	def sourcePrepend (off c : Nat) (r : Except DecodeError (List Nat)) :
   184	    Except DecodeError (List Nat) :=
   185	  if c = 0 then .error ⟨off, .nul⟩
   186	  else if c = 0xFEFF then .error ⟨off, .bom⟩
   187	  else prepend c r
   188	
   189	/-- Decode and enforce the two source refusals in byte order. -/
   190	def sourceAt (off : Nat) : List UInt8 → Except DecodeError (List Nat)
   191	  | [] => .ok []
   192	  | a :: bs =>
   193	    if Utf8.One a then sourcePrepend off a.toNat (sourceAt (off + 1) bs)
   194	    else match bs with
   195	    | [] => .error (badSequence off [a])
   196	    | b :: bs =>
   197	      if Utf8.Two a b then
   198	        sourcePrepend off ((a.toNat - 0xC0) * 64 + (b.toNat - 0x80)) (sourceAt (off + 2) bs)
   199	      else match bs with
   200	      | [] => .error (badSequence off [a, b])
   201	      | c :: bs =>
   202	        if Utf8.Three a b c then
   203	          sourcePrepend off ((a.toNat - 0xE0) * 4096 + (b.toNat - 0x80) * 64 + (c.toNat - 0x80))
   204	            (sourceAt (off + 3) bs)
   205	        else match bs with
   206	        | [] => .error (badSequence off [a, b, c])
   207	        | d :: bs =>
   208	          if Utf8.Four a b c d then
   209	            sourcePrepend off ((a.toNat - 0xF0) * 262144 + (b.toNat - 0x80) * 4096 +
   210	              (c.toNat - 0x80) * 64 + (d.toNat - 0x80)) (sourceAt (off + 4) bs)
   211	          else .error (badSequence off (a :: b :: c :: d :: bs))
   212	
   213	/-- Source checking from byte zero. -/
   214	def checkSource (bs : List UInt8) : Except DecodeError (List Nat) := sourceAt 0 bs
   215	
   216	/-- Successful source prepending exposes both the scalar restrictions and the tail. -/
   217	theorem sourcePrepend_ok {off c : Nat} {r : Except DecodeError (List Nat)} {cs : List Nat}
   218	    (h : sourcePrepend off c r = .ok cs) :
   219	    c ≠ 0 ∧ c ≠ 0xFEFF ∧ ∃ ds, r = .ok ds ∧ cs = c :: ds := by
   220	  unfold sourcePrepend at h
   221	  split at h
   222	  · cases h
   223	  · rename_i hn
   224	    split at h
   225	    · cases h
   226	    · rename_i hb
   227	      exact ⟨hn, hb, prepend_ok h⟩
   228	
   229	/-- Source checking succeeds exactly for a decoding without NUL or BOM. -/
   230	theorem sourceAt_iff (off : Nat) (bs : List UInt8) (cs : List Nat) :
   231	    sourceAt off bs = .ok cs ↔
   232	      decodeAt off bs = .ok cs ∧ ∀ c ∈ cs, c ≠ 0 ∧ c ≠ 0xFEFF := by
   233	  induction off, bs using sourceAt.induct generalizing cs with
   234	  | case1 off =>
   235	    simp only [sourceAt, decodeAt]
   236	    constructor
   237	    · intro h
   238	      cases Except.ok.inj h
   239	      exact ⟨rfl, by simp⟩
   240	    · intro h; exact h.1
   241	  | case2 off a bs ha ih =>
   242	    rw [sourceAt.eq_def, decodeAt.eq_def]
   243	    simp only [ha, ↓reduceIte]
   244	    constructor
   245	    · intro h
   246	      obtain ⟨hn, hb, ds, hd, rfl⟩ := sourcePrepend_ok h
   247	      obtain ⟨ht, hs⟩ := (ih ds).mp hd
   248	      exact ⟨by rw [ht]; rfl, List.forall_mem_cons.mpr ⟨⟨hn, hb⟩, hs⟩⟩
   249	    · rintro ⟨h, hs⟩
   250	      obtain ⟨ds, hd, rfl⟩ := prepend_ok h
   251	      have hp := (List.forall_mem_cons.mp hs)
   252	      have ht := (ih ds).mpr ⟨hd, hp.2⟩
   253	      simp only [sourcePrepend, hp.1.1, hp.1.2, ↓reduceIte, ht, prepend]
   254	  | case3 off a ha =>
   255	    rw [sourceAt.eq_def, decodeAt.eq_def]
   256	    simp only [ha, ↓reduceIte]
   257	    simp
   258	  | case4 off a ha b bs hb ih =>
   259	    rw [sourceAt.eq_def, decodeAt.eq_def]
   260	    simp only [ha, hb, ↓reduceIte]


