     1	/-!
     2	# Settled pieces of the slice-0 surface
     3	
     4	Only UTF-8 source validity, NUL/BOM refusal, ASCII identifier characters and line comments
     5	are specified here. Tokens, keywords, punctuation, literals, other whitespace, grammar,
     6	diagnostics and CLI spellings are not defined. There is no shebang or block-comment rule.
     7	-/
     8	
     9	namespace ConcreteSpec.Surface0
    10	namespace Utf8
    11	
    12	/-- A Unicode scalar value: below U+110000 and outside the surrogate interval. -/
    13	def Scalar (c : Nat) : Prop := c < 0x110000 ∧ (c < 0xD800 ∨ 0xE000 ≤ c)
    14	
    15	/-- Table 3-7's one-byte row. -/
    16	def One (a : UInt8) : Prop := a.toNat ≤ 0x7F
    17	
    18	/-- Table 3-7's two-byte row (C2..DF, 80..BF). -/
    19	def Two (a b : UInt8) : Prop :=
    20	  0xC2 ≤ a.toNat ∧ a.toNat ≤ 0xDF ∧ 0x80 ≤ b.toNat ∧ b.toNat ≤ 0xBF
    21	
    22	/-- Table 3-7's three-byte rows, including the E0 and ED restrictions. -/
    23	def Three (a b c : UInt8) : Prop :=
    24	  0xE0 ≤ a.toNat ∧ a.toNat ≤ 0xEF ∧
    25	  0x80 ≤ b.toNat ∧ b.toNat ≤ 0xBF ∧ 0x80 ≤ c.toNat ∧ c.toNat ≤ 0xBF ∧
    26	  (a.toNat = 0xE0 → 0xA0 ≤ b.toNat) ∧ (a.toNat = 0xED → b.toNat ≤ 0x9F)
    27	
    28	/-- Table 3-7's four-byte rows, including the F0 and F4 restrictions. -/
    29	def Four (a b c d : UInt8) : Prop :=
    30	  0xF0 ≤ a.toNat ∧ a.toNat ≤ 0xF4 ∧
    31	  0x80 ≤ b.toNat ∧ b.toNat ≤ 0xBF ∧ 0x80 ≤ c.toNat ∧ c.toNat ≤ 0xBF ∧
    32	  0x80 ≤ d.toNat ∧ d.toNat ≤ 0xBF ∧
    33	  (a.toNat = 0xF0 → 0x90 ≤ b.toNat) ∧ (a.toNat = 0xF4 → b.toNat ≤ 0x8F)
    34	
    35	/-- A scalar's encoding, expressed as byte ranges and the positional value equation;
    36	this judgment does not run a decoder. All other lengths are excluded. -/
    37	def Encodes (s : Nat) (bs : List UInt8) : Prop :=
    38	  match bs with
    39	  | [a] => One a ∧ s = a.toNat
    40	  | [a, b] => Two a b ∧ s = (a.toNat - 0xC0) * 64 + (b.toNat - 0x80)
    41	  | [a, b, c] => Three a b c ∧
    42	      s = (a.toNat - 0xE0) * 4096 + (b.toNat - 0x80) * 64 + (c.toNat - 0x80)
    43	  | [a, b, c, d] => Four a b c d ∧
    44	      s = (a.toNat - 0xF0) * 262144 + (b.toNat - 0x80) * 4096 +
    45	        (c.toNat - 0x80) * 64 + (d.toNat - 0x80)
    46	  | _ => False
    47	
    48	/-- Bytes decode to scalars exactly when they concatenate their encodings in order. -/
    49	inductive Decodes : List UInt8 → List Nat → Prop
    50	  | nil : Decodes [] []
    51	  | cons {s : Nat} {chunk bs : List UInt8} {cs : List Nat} :
    52	      Encodes s chunk → Decodes bs cs → Decodes (chunk ++ bs) (s :: cs)
    53	
    54	end Utf8
    55	
    56	/-- A source has a decoding with neither NUL nor BOM anywhere. -/
    57	def SourceOk (bs : List UInt8) : Prop :=
    58	  ∃ cs, Utf8.Decodes bs cs ∧ ∀ c ∈ cs, c ≠ 0 ∧ c ≠ 0xFEFF
    59	
    60	/-- ASCII letters and underscore start identifiers. -/
    61	def IdentStart (c : Nat) : Prop :=
    62	  (65 ≤ c ∧ c ≤ 90) ∨ (97 ≤ c ∧ c ≤ 122) ∨ c = 95
    63	
    64	/-- Only ASCII letters, underscore and digits continue identifiers. -/
    65	def IdentContinue (c : Nat) : Prop := IdentStart c ∨ (48 ≤ c ∧ c ≤ 57)
    66	
    67	/-- A comment body ends before the first LF or CR, or at EOF. The terminating line
    68	break stays in the remainder; every body scalar differs from both terminators. -/
    69	inductive CommentBody : List Nat → List Nat → List Nat → Prop
    70	  | eof : CommentBody [] [] []
    71	  | lf (rest : List Nat) : CommentBody (10 :: rest) [] (10 :: rest)
    72	  | cr (rest : List Nat) : CommentBody (13 :: rest) [] (13 :: rest)
    73	  | cons {c : Nat} {input body rest : List Nat} : c ≠ 10 → c ≠ 13 →
    74	      CommentBody input body rest → CommentBody (c :: input) (c :: body) rest
    75	
    76	/-- A line comment starts with two slashes. The output pair is the whole comment
    77	(including its slashes) and the unconsumed remainder. No other opener is admitted. -/
    78	inductive LineComment : List Nat → (List Nat × List Nat) → Prop
    79	  | intro {input body rest : List Nat} : CommentBody input body rest →
    80	      LineComment (47 :: 47 :: input) (47 :: 47 :: body, rest)
    81	
    82	/-- Scalar membership is decidable by its interval bounds. -/
    83	instance (c : Nat) : Decidable (Utf8.Scalar c) := inferInstanceAs (Decidable (_ ∧ _))
    84	/-- Identifier-start membership is decidable by ASCII bounds. -/
    85	instance (c : Nat) : Decidable (IdentStart c) := inferInstanceAs (Decidable (_ ∨ _))
    86	/-- Identifier-continuation membership is decidable by ASCII bounds. -/
    87	instance (c : Nat) : Decidable (IdentContinue c) := inferInstanceAs (Decidable (_ ∨ _))
    88	/-- The one-byte range constraint is decidable. -/
    89	instance (a : UInt8) : Decidable (Utf8.One a) := inferInstanceAs (Decidable (_ ≤ _))
    90	/-- The two-byte range constraints are decidable. -/
    91	instance (a b : UInt8) : Decidable (Utf8.Two a b) := inferInstanceAs (Decidable (_ ∧ _))
    92	/-- The three-byte range constraints are decidable. -/
    93	instance (a b c : UInt8) : Decidable (Utf8.Three a b c) := inferInstanceAs (Decidable (_ ∧ _))
    94	/-- The four-byte range constraints are decidable. -/
    95	instance (a b c d : UInt8) : Decidable (Utf8.Four a b c d) :=
    96	  inferInstanceAs (Decidable (_ ∧ _))
    97	
    98	/-- Encoding membership is decidable directly from the range constraints. -/
    99	instance (c : Nat) (bs : List UInt8) : Decidable (Utf8.Encodes c bs) := by
   100	  unfold Utf8.Encodes
   101	  split <;> infer_instance
   102	
   103	example : Utf8.Encodes 65 [65] := by decide
   104	example : Utf8.Encodes 0xA2 [0xC2, 0xA2] := by decide
   105	example : Utf8.Encodes 0x20AC [0xE2, 0x82, 0xAC] := by decide
   106	example : Utf8.Encodes 0x1F600 [0xF0, 0x9F, 0x98, 0x80] := by decide
   107	example : ¬ Utf8.Encodes 0 [0xC0, 0x80] := by decide
   108	example : ¬ Utf8.Encodes 0xD800 [0xED, 0xA0, 0x80] := by decide
   109	example : ¬ Utf8.Encodes 0x110000 [0xF4, 0x90, 0x80, 0x80] := by decide
   110	example : ¬ Utf8.Encodes 0x20AC [0xE2, 0x82] := by decide
   111	example : ¬ Utf8.Encodes 0x80 [0x80] := by decide
   112	example : Utf8.Encodes 0 [0] := by decide
   113	example : Utf8.Encodes 0xFEFF [0xEF, 0xBB, 0xBF] := by decide
   114	
   115	example : Utf8.Scalar 0x10FFFF := by decide
   116	example : ¬ Utf8.Scalar 0xD800 := by decide
   117	example : IdentStart 95 ∧ IdentContinue 48 ∧ ¬ IdentStart 48 := by decide
   118	example : ¬ IdentContinue 0xE9 := by decide
   119	
   120	example : LineComment [47, 47, 32,120,10,114] ([47, 47, 32,120], [10,114]) :=
   121	  .intro (.cons (by decide) (by decide) (.cons (by decide) (by decide) (.lf _)))
   122	example : LineComment [47, 47, 32,120,13] ([47, 47, 32,120], [13]) :=
   123	  .intro (.cons (by decide) (by decide) (.cons (by decide) (by decide) (.cr _)))
   124	example : LineComment [47, 47, 32,120] ([47, 47, 32,120], []) :=
   125	  .intro (.cons (by decide) (by decide) (.cons (by decide) (by decide) .eof))
   126	example (out : List Nat × List Nat) : ¬ LineComment [47, 42, 32,120,32,42,47] out := by
   127	  intro h; cases h
   128	
   129	end ConcreteSpec.Surface0
     1	# The Concrete compiler: slice 0 design (provisional)
     2	
     3	PROVISIONAL. This is a design sketch, revision 8, written after eight Codex and agy review rounds. It folds in the Codex/agy/Kimi pipeline review and the owner's answers (2026-11-06). Build step 1 (BIR as the shared backend contract) is implemented: `Concrete/BIR.lean` and `Concrete/Backend/`, gate `scripts/checks/compiler/slice0_backends.sh`. Slice 0 is the first compiler slice. It is built before the owner freezes Core (A2c) and makes no normative claim before that freeze ([decision](../docs/decisions.md#decided-project-proof-infrastructure)). Branch `wip/slice0` depends on `wip/spec-root`, which puts `ConcreteSpec` on the new root, and is rebased onto main (under a new branch name) once that lands.
     4	
     5	## Scope
     6	
     7	This document describes **the compiler**: its stages, IRs, proof strategy, premises and gates. Language rules are not restated here. They live in `ConcreteSpec`, and this document links to them:
     8	- the one Core (syntax and semantics) and the slice fragments, each a pair of decidable predicates `Fragment.surface` and `Fragment.core` (planned `ConcreteSpec/Spec/Fragments.lean`, A2i item I3); until those land, the current slice-0 file [`ConcreteSpec/Spec/Slice0.lean`](../ConcreteSpec/Spec/Slice0.lean);
     9	- its behaviour theorems: [`ConcreteSpec/Proofs/Slice0.lean`](../ConcreteSpec/Proofs/Slice0.lean);
    10	- what the parent process observes, including the trap status and the trap line: [`ConcreteSpec/Spec/Observation.lean`](../ConcreteSpec/Spec/Observation.lean);
    11	- the slice-0 surface (token rules, grammar, elaboration): the new `ConcreteSpec/Spec/Surface0.lean` described below.
    12	
    13	The conformance corpus (`tests/slice0/`) instantiates those spec examples as source files.
    14	
    15	## The pipeline
    16	
    17	Each arrow is a total Lean function of the compiler. **Proved** means a kernel-checked theorem. **Premise** means a field of one of the two premise structures (frontend, native) in the one file `Concrete/Premises.lean`.
    18	
    19	```
    20	source bytes (ByteArray)
    21	  │ decode + lex        Lex.lean      proved against Surface0.Lexes (independent byte-level spec);
    22	  ▼                                   until done: premise P_lex (implementation)
    23	tokens (kind + payload + span)
    24	  │ parse (LL(1))       Parse.lean    generic table-driven parser over Surface0.grammar;
    25	  ▼                                   premise P_parse (implementation) until the generic theorem lands
    26	surface AST
    27	  │ resolve + elab      Elab.lean     resolve + elab: one stage edge, straight to the SPEC's Core
    28	  ▼                                   (no slice-0 Core syntax); proved to satisfy Surface0.Elab,
    29	                                      with freshness and naming-independence; a form outside
    30	                                      `Fragment.surface s0` is "not supported in slice 0"
    31	Core program + site map  (the spec's Core value, `out.p`, `out.sites`)
    32	  │ check = ADMIT       `Fragment.core s0 p` and the spec's own `check`; `check_iff` gives
    33	  ▼                     `Checked p`; the ONE admission point; emits discharged-evidence tokens
    34	CheckedCore
    35	  │ (mono: absent in slice 0; when it exists, admission re-runs after it, row Q6.3)
    36	  │ lower               MIR.lean      Place MIR: expands RESIDUAL checks only, never admits;
    37	  ▼                                   proved over ALL well-scoped programs with valid tokens
    38	Place MIR  (`out.mir`)
    39	  │ memory              Memory.lean   Memory CFG: the one Layout authority (sizes, alignment,
    40	  ▼                                   offsets, loads/stores over block-offset memory); identity-shaped
    41	                                      in slice 0 (u8 slots), proved: memory_correct
    42	Memory CFG  (`out.mem`)
    43	  │ ssa                 BIR.lean      BIR; slice 0: direct proof (constraint below)
    44	  ▼
    45	BIR  (`out.bir`)  ── designed for both backends from the start
    46	  ├───────────────────────────────────────────┐
    47	  │ print   Backend/LLVM.lean                  │ adapt   Backend/LCB.lean
    48	  ▼ (unverified: premise P_print)              ▼ (proved: emit_correct against LCB's imported
    49	.ll text  (`out.ll`)                           │  semantics; a refused adaptation emits nothing)
    50	  │ clang/llc, link                          LCB `Source.Function` value (`out.lcb`), handed
    51	  │ (premise P_toolchain[llvm])                │ to LCB IN PROCESS (no text on this path);
    52	  │                                            │ LCB lowering + assembler + link
    53	  ▼                                            ▼ (premise P_toolchain[lcb]: LCB's named trust boundaries)
    54	executable (x86-64)                          executable (x86-64, AArch64 macOS)
    55	  │ run: premises P_launch, P_live (environment), under the target profile
    56	  ▼
    57	observed behaviour  →  observation (exit status 0–255 / 125 startup refusal / 134 trap + fd-2 line)
    58	```
    59	
    60	**`compile` is defined as the composition of the stage functions listed in `Stages.lean`**, so a pass that isn't registered can't be in the pipeline. `Output` is pure data with `DecidableEq`: `{ toks, ast, p, sites, tokens, mir, mem, bir, ll, lcb }`. There are no proofs inside it, and every theorem is stated *about* `compile`.
    61	
    62	There's no Mono Core, since slice 0 has no generics. When Mono exists, the admission check runs again on its output: substitution can expose new constants and cycles (row Q6.3).
    63	
    64	**CheckedCore is the single admission point.** Trap admission, termination and fact derivation run there, and nowhere else. The checker also emits one **discharged-evidence token** per operation it proved safe; in slice 0 that is `known (v)` for a `+` whose value is statically known. Tokens are carried through MIR, Memory CFG and BIR. A token is validated (`token_valid`). Its soundness connects the checker's known value to the run-time operands through `knownExpr_sound`, because `knownExpr_u8` alone establishes only static knowledge. Only a validated token lets a pass omit a check. No pass removes a check without evidence (PASS-9).
    65	
    66	**Place MIR** is where later slices put evaluation order, cleanup edges and the expansion of residual checks. In slice 0, an add with no valid token becomes an explicit `add.ovf` plus a branch to a trap site, and an add with a valid token becomes a plain add. Every accepted slice-0 program has tokens on all its adds, so its generated IR (MIR through BIR and both backend inputs) contains no trap path. Whether the executable contains trap code is an artifact fact, not established yet. Unchecked well-scoped programs, such as `200 + 56` in gate 6, have no tokens, so the check-and-trap path is still proved and tested.
    67	
    68	**Memory CFG** is the one layout authority. It consumes the spec's byte encoding (`ConcreteSpec/Spec/Rep.lean`) and turns places into loads and stores over block-offset memory with provenance. In slice 0 every local is a `u8` slot (size 1, alignment 1), so the pass is identity-shaped. It exists from day one so that layout never leaks into SSA construction or the printers.
    69	
    70	**Typed source identity, end to end.** The lexer and parser mint typed `SiteId`s and spans. Elaboration records an origin edge for every generated temporary in `out.sites`. Every MIR, Memory CFG and BIR instruction carries its origin, and so does every trap site. Diagnostics, facts, JSON and certificates all read this one evidence graph. Core itself has no positions yet (spec open items O1/O4), so the site map sits beside `out.p` without changing the spec's Core.
    71	
    72	**Proof strategy per pass** (pipeline review, item 7):
    73	
    74	| Pass | Strategy |
    75	|---|---|
    76	| Lexer | direct correspondence against `Surface0.Lexes`, not merely "total and re-prints" |
    77	| Parser | one direct theorem for the generic table-driven LL(1) parser |
    78	| Resolve | direct proof; HIR is only the resolved surface tree, no second checker |
    79	| Elab | direct proof |
    80	| Lower, Memory CFG | direct proofs |
    81	| SSA | long-term, a proved validator. Slice 0 proves `ssa_correct` directly, on one condition: BIR's shape may not depend on that proof, so the validator can replace it without changing the IR. |
    82	| BIR → LCB-IR adapter | direct proof |
    83	| Mono, optimizations, register allocation, linking (later) | proved validators |
    84	
    85	**One Core, no slice-0 syntax.** The spec has one Core syntax; a slice is two decidable predicates, `Fragment.surface` (the grammar productions it supports) and `Fragment.core` (the Core constructors it supports) (A2i plan, item I3). Elaboration produces the spec's Core directly. Admission checks `Fragment.core s0 p` together with the spec's `check`, and the slice theorems (`slice0_exits`, `slice0_never_traps`) are stated over `Fragment.core s0 p ∧ Checked p`. The "not supported in slice 0" refusal comes from `Fragment.surface s0`. The compiler keeps no Core syntax of its own and no `toCore`.
    86	
    87	**Dependency.** If the integrated Core (A2i, R-0571) is not on main when elaboration is built, the compiler targets the current spec Core behind one thin interface file, `Concrete/Core.lean`: it re-exports the spec's Core type, `check`, `check_iff`, `run`, and the slice-0 fragment predicates, and defines nothing of its own. It is the only file that changes when the integrated Core lands.
    88	
    89	**BIR is a complete backend contract.** Each item below is fixed in `BIR.lean`. Its slice-0 instance is in parentheses.
    90	- **integer semantics** (`u8`/`w32`, wrapping arithmetic plus `add.ovf`);
    91	- **layout, endianness, alignment and zero-sized values**, all taken from Memory CFG's `Layout` (little-endian; no aggregates and no ZSTs in slice 0);
    92	- **internal and foreign calling conventions** (one parameterless body function returning a word; no foreign calls);
    93	- **external events** (none);
    94	- **trap realization**: the kind plus the typed site (an encoded result word; see the runtime below);
    95	- **frame-accounting handoff**: BIR reports its frame slots. **Stack bytes come only from the final artifact plus the launcher's reservation**, never from BIR.
    96	
    97	BIR is the one boundary that both backends read. It is designed for both from the start:
    98	- block-argument SSA;
    99	- `add.ovf` returns `(value, flag)`;
   100	- `br`/`condbr`;
   101	- a `trap k` terminator.
   102	
   103	Every BIR construct has a direct LLVM spelling (`@llvm.uadd.with.overflow.i8`) and a direct LCB-IR expansion: a widened add, a compare, and a branch to the trap block. No construct exists only for one backend.
   104	
   105	**Both backends run in slice 0.**
   106	
   107	The **LLVM printer** is unverified and stays a premise (`P_print`) until an LLVM-IR semantics exists.
   108	
   109	The **BIR → LCB-IR adapter** is the first backend proof target. `adapter_correct` states that the adapter's output, under **LCB's own semantics** (`LeanCompilerBackend.Verified.Source`, the `ssa-int-v2` profile, imported and never restated), has the BIR behaviour. It is proved (`Proof.adapter_correct`) for every WF program the adapter accepts (`adapt p = .ok f`). The backend contract is complete (owner, 2026-11-08): `LCB.emit : Program → Except String (Source.Function × SiteTable)` represents adaptation failure, `LCB.artifact` builds only from a successful `emit`, and `Proof.emit_correct` (success implies correctness), `Proof.artifact_of_emit_error` (a refusal produces no artifact, for every target) and `Proof.artifact_correct` (every artifact comes from a correct `emit`) state it. `P_adapter` is retired; the trusted-base golden (gate 9) records it.
   110	
   111	The adapter's output is handed to LCB **in process**, as the value: on `aarch64-m
acos` through LCB's verified first path (`Verified.compileFunction`), on the Linux targets through LCB's compatibility backends (`Verified.reify`, then `AMD64`/`AArch64.emitModuleValidated`). No printer or importer sits between the adapter and LCB. The QBE text of the body is a debug dump only. The gate also runs the first path's admission on every example on every host.
   112	
   113	**The `adapter_correct` proof, in layers** (in `Backend/LCB.lean`, namespace `Proof`):
   114	1. *Values* (proved): `enc` represents an integer as its 32-bit word and a flag as 0/1; `binaryBits_exact`, `wrap_word` (the mask-and-rebias expansion computes `wrap t`) and `flag_word` (the unsigned compare is exactly `inRange`), over the profile's types.
   115	2. *Instructions*: the invariant is: `env.size = f.valueWidths.size = valueCount p`, every width is `word`, and for every register `r` with BIR `lookup benv r = some v` (the newest binding: BIR's list shadows on loops where LCB overwrites a slot), `env[id r] = some (enc v)`, and every current integer binding `.int t x` is in range (`t.inRange x`: `Agrees` alone would let a `.u8` register hold `2^32`, whose word is 0, and then the overflow flags differ; immediates are in range by WF, results by `wrap_inRange`, and block arguments carry it). From the instruction's first position, the expansion's steps reach the next position with the invariant extended by the result (and flag); every operand read succeeds at width `word`, and BIR's operands stay in range (for `flag_word`). Needs: register ids injective, intermediate ids disjoint from register ids, every id below `valueCount`. Proved so far: the environment lemmas (`Agrees`, `read_operand`, `write_ok`, `agrees_set_other`, `agrees_define`) and the step lemmas for each expansion, from its first position with word-width slots: `bin_steps` (4 steps, `word (wrap t (x op y))` at `n + 3`), `binOvf_steps` (6 steps, also `enc (.bool (!t.inRange (x op y)))` at `n + 5`, for in-range operands) and `trunc_steps` (3 steps, `word (wrap to x)` at `n + 2`). With the numbering facts (`numberingOk`: intermediates are no register's id, every id is below `valueCount`), `inst_sim` carries the invariant (agreement, range, size) through any one instruction, with the result (and flag) bound, in `Inst.width ins` LCB steps (the adapter's `Inst.width`). Layer 3 so far: the adapted body's shape (`adapt_block`, `adapt_widths`, `block_insts`: instruction `i`'s expansion starts at `instPos b i`; `block_size`: the terminator follows the last one) and `body_sim`: the LCB steps of a block's instructions keep the invariant through BIR's `execInsts`. Terminators: `ret_sim` and `trap_sim` (LCB returns `enc v`, and the word `256 + s`), and `transfer_ok`: along an edge whose every phi has one arm from the predecessor (WF's `t ≠ e`), LCB reads every phi from the old environment and then writes them. `edge_sim`: along the only edge `j → t` (WF's `t ≠ e` makes a taken `condbr` arm the only one), LCB's `transfer` lands at `t`'s first position with the invariant for BIR's `enter`: each parameter's slot holds its new value, every other register keeps its slot. `runBlock_sim` composes them over BIR's `runBlock` (by fuel): an exit or a trap is matched by LCB returning its encoding, running out of fuel by at least `fuel` LCB steps (each block transition is at least one LCB step: the terminator's `transfer`). Layer 4: `initial_ok` (the entry block, no phis since WF's entry has no parameters, an empty environment of size `valueCount p`) and **`adapter_correct_run`**: for `WF p` and `adapt p = .ok f`, `run p fuel = exited c` gives `HasBehavior f #[] (.returned (word c))`, `trapped s` gives `.returned (word (256 + s))`, and running out of fuel at every fuel gives `.diverges` (`steps_prefix`). All under LCB's own `Source` semantics, with only `propext`, `Classical.choice` and `Quot.sound`. Then, closing the statement:
   116	   - *BIR progress* (`Concrete/BIR/Progress.lean`): `run_progress`: for `WF p`, every `run p fuel` is `outOfFuel` or `Outcome.Encodable` (an exit below 256, a trap at a site of a table of at most `maxSites`), so never `stuck`; the invariant `Typed` (every register in the block's scope is bound to a value of its type, in range) is block-local, extended by each instruction as `Block.wf` extends the scope and established at entry from the arguments (registers distinct, from WF's `eraseDups` check). `behaviour_diverges_iff` (any program): `behaviour p = .diverges` iff `run p fuel = .outOfFuel` at every fuel.
   117	   - *Uniqueness*: `hasBehavior_unique` (from LCB's `step_deterministic`): a function has at most one `Source.HasBehavior` on given arguments (two returns return the same value; a return excludes divergence).
   118	   - *Bridge*: `adapter_correct_behaviour`: the adapted body returns the word `w` with `behaviour p = decode p.sites w` (by `decode_encode`, which keeps the site lookup and the trap kind), or diverges exactly when BIR diverges.
   119	   - **`adapter_correct`**: `WF p → adapt p = .ok f → bodyResult f r → r.behaviour p.sites = behaviour p`, with `bodyResult` defined in `Backend/LCB.lean` as below. Axioms: `propext`, `Classical.choice`, `Quot.sound`.
   120	   - **`emit_correct`**: `WF p → emit p = .ok (f, tbl) → bodyResult f r → r.behaviour tbl = behaviour p`, with `artifact_of_emit_error` and `artifact_correct` for the artifact (no premise).
   121	   - *Adapter domain*: WF alone does not give `adapt p = .ok f` (WF admits `i32`/`u32`/64-bit instructions, which slice 0's adapter rejects); the statement takes the adapter's acceptance as a hypothesis, and widening the domain is LCB's 32↔64 work (wire version 3).
   122	3. *Blocks*: `execInsts` against those steps; `ret` and `trap` against LCB's `returned`; `br`/`condbr` against `transfer`: the target exists, each phi has exactly one arm from this predecessor (WF's `t ≠ e`), destinations are distinct (distinct registers), and all arms are read from the OLD environment before any destination is written, which is BIR's `enter` (all arguments evaluated before binding), including loop-carried swaps; the new state is at position 0.
   123	4. *Runs*: under `WF p` and `adapt p = .ok f`, `Source.initial f #[] = .ok s₀` (entry block exists with no phis, no parameters, an empty environment of size `valueCount p`); then `run p fuel = exited c` or `trapped s` gives `HasBehavior f #[] (.returned (word (encode o)))`. Divergence: each BIR block transition is at least one LCB `Step` (BIR fuel counts blocks, LCB counts instructions and terminators), so BIR running out of fuel at every fuel gives arbitrarily long LCB prefixes, i.e. `HasBehavior f #[] .diverges`. BIR progress (a WF program never gets stuck) is needed only to make exit, trap and divergence exhaustive.
   124	
   125	Two refactors make layers 2–4 tractable, and both are done: `runBlock` names blocks by index (as LCB's state does), and the numbering is a closed function of position (`blockBase`, `instBase`, `regId`), which LCB's canonical-form check accepts for every example.
   126	
   127	LCB's own lowering, assembler and linker are LCB's named trust boundaries, carried as `P_toolchain[lcb]` until LCB's preservation theorem covers the slice-0 domain.
   128	
   129	LCB is a pinned lake dependency (`require` with an exact rev, LCB's upstream lock recorded). It uses the same Lean toolchain (v4.34.1) and no Mathlib.
   130	
   131	**The encoded result, with one decoding runtime.** Neither backend's input contains a call or a trap.
   132	
   133	Each backend emits `main`'s body as a function `concrete_body() -> w`, a 32-bit word, whose return value **encodes** the behaviour:
   134	- `exited c` returns `c` (0–255);
   135	- a trap at site `s` returns `256 + s.idx`. The runtime's site table maps the index to the trap's kind, typed `SiteId` and span.
   136	
   137	This fits LCB's verified source profile (`ssa-int-v2`, `LeanCompilerBackend/Verified/Source.lean`), which has integer operations, compares, branches, phis, a return or divergence, and no calls, traps or memory. It is also what lets the adapter be proved against LCB's semantics as it stands.
   138	
   139	It also separates `return 134` from a trap: they return the words 134 and 256.
   140	
   141	A fixed runtime entry, `Backend/Runtime.lean`, is emitted per backend as LLVM text and as QBE text for LCB's command line (the runtime is not on the adapter's proof path; it is premise `P_rt`). It calls `concrete_body`, and then:
   142	- for a word below 256, it exits with that status;
   143	- otherwise, it writes the trap line for `k` to fd 2 and exits 134.
   144	
   145	The decoding lives in this one place for both backends. Its correctness is premise `P_rt` (implementation, over libc `write`/`_exit`): an image whose `concrete_body` returns word `w` has the behaviour `decode w`, and a body that diverges gives a run that diverges.
   146	
   147	Each IR has a total, fuel-indexed evaluator returning the spec's `Outcome` and a decidable well-formedness predicate.
   148	
   149	## Layout (lean root, few cohesive folders)
   150	
   151	**New root entries.** There are only three, each with a stated reason:
   152	
   153	| Entry | Purpose |
   154	|---|---|
   155	| `Concrete.lean` | The library root that lake requires; it imports every stage. It is the same pattern as `ConcreteSpec.lean`. |
   156	| `Concrete/` | The compiler: one flat folder, one file per pipeline stage or concern. |
   157	| `tests/` | The executable test corpus. Each slice gets one subfolder, which holds `.con` sources and their `.expect` outcomes. |
   158	
   159	**Changes to existing entries.** No new entry is created for any of these:
   160	- `lakefile.toml` gains the `Concrete` lib, the `concrete` exe, and a pinned `require` of `lean-compiler-backend`; `lake-manifest.json` records it.
   161	- `ConcreteSpec/Spec/Surface0.lean` and `ConcreteSpec/Proofs/Surface0.lean` go into the spec's existing folders.
   162	- The gates and runners (conformance, the two differentials, certificates, the premise registry, negative controls) are files in the existing `scripts/checks/`, in its subfolder `scripts/checks/compiler/`: they are CI jobs of their own (they need the compiler's devshell and a macOS runner), not root checks, which are exactly the `scripts/checks/*.sh` that `run.sh` runs. Their shared helpers are in `scripts/checks/lib/`. No `scripts/compiler/` is added.
   163	- `required-checks.txt` and the CI workflow gain entries.
   164	
   165	Generated outputs are never committed and get no new root entry. That covers certificates, `.ll` files, images and facts JSON, which all go under the git-ignored `.lake/concrete/`.
   166	
   167	**The folder tree:**
   168	
   169	```
   170	Concrete.lean          library root (imports only)
   171	Concrete/
   172	  README.md            this design
   173	  LL1.lean             generic LL(1) check `ll1` and `ll1_sound` (built; moves beside the spec's
   174	                       grammar when A2i places it)
   175	  Lex.lean             UTF-8 decode + lexer, and its theorem against Surface0.Lexes
   176	  Parse.lean           generic LL(1) table parser over Surface0.grammar
   177	  Core.lean            thin interface to the spec's Core and the slice fragment predicates (until
   178	                       the integrated Core lands; defines no Core of its own)
   179	  Elab.lean            resolve + elaborate to the spec's Core (one stage edge), and its theorems
   180	  MIR.lean             Place MIR: syntax, semantics, WF, lowering (residual checks only), lower_correct
   181	  Memory.lean          Memory CFG: the Layout authority, block-offset memory, memory_correct
   182	  BIR.lean             BIR: syntax, semantics, behaviour, WF, ssa, ssa_correct, addOvf_correct
   183	  Backend/             the backend stage: everything after BIR, one file per backend
   184	    LLVM.lean          BIR → LLVM text printer (unverified; P_print)
   185	    LCB.lean           BIR → LCB `Source.Function` adapter + adapter_correct; in-process assembly
   186	    Runtime.lean       the fixed entry that decodes the result word into exit status / trap line, per backend
   187	  Stages.lean          typed stage contracts
; `compile` is the fold of the stage list
   188	  Premises.lean        THE one file of premises, plus the execution-trust inventory
   189	  Theorem.lean         compile_correct, the non-vacuity witnesses, answer_correct
   190	  Facts.lean           per-function facts: judgments, derive, derive_sound, rendering (text/JSON)
   191	  Cert.lean            per-compilation certificate emitter
   192	  Main.lean            CLI driver (IO, toolchain invocation); placeholder spellings
   193	tests/
   194	  slice0/              *.con sources and *.expect outcomes (exit status, or refusal + rule)
   195	```
   196	
   197	**Rules:**
   198	- `Concrete/` has one subfolder, `Backend/`, because the backend stage has three files. No other subfolder exists until another stage outgrows one file, and a split never creates a one-file folder.
   199	- Each stage's definitions and theorems live in the same file, so each fact has one home.
   200	- `Resolve` merges into `Elab`, because it is one stage edge with one contract.
   201	- Every entry has exactly one home: tests are in `tests/`, gates in `scripts/checks/` (the compiler's in `scripts/checks/compiler/`), the spec in `ConcreteSpec/`. Conformance has one home, `tests/`.
   202	- The stage table, the premise table and the fact-kind table in this README become **generated views** of the Lean registries in `Stages.lean`, `Premises.lean` and `Facts.lean` once the code exists. A gate fails when a view drifts from its registry.
   203	
   204	The root inventory (`scripts/checks/root_inventory.txt`) lists each new root entry in the same change that creates it. An unlisted entry fails the check, and so does a listed entry that is missing.
   205	
   206	## Frontend specifications (new spec file `ConcreteSpec/Spec/Surface0.lean`)
   207	
   208	This file is spec work (open item O1, slice 0 only). It is a new file, and no existing spec file changes. The language content lives in the Lean file, not here: the token rules (SYN-5/SYN-6, plus the owner's decision that leading-zero literals are refused), the grammar and the elaboration relation. What the compiler needs from it:
   209	
   210	- **`Lexes : Bytes → List Token → Prop`**, an independent byte-level judgment. The lexer is proved sound and complete against it, which rules out splitting a token.
   211	- **The grammar as data**, which must be LL(1), plus **`ll1 : Grammar → Bool`**, which computes nullable, FIRST and FOLLOW sets. It comes with `ll1_sound : ll1 g = true → ∀ n t, at most one production of n is predicted on t`, where "predicted" is defined declaratively (inductive nullable, FIRST and FOLLOW relations). Both are built, generically, in `Concrete/LL1.lean`: the check verifies that the computed sets are closed under the rules (so they contain the declarative relations) and that each nonterminal's prediction sets are disjoint; the fixed-point iteration needs no proof. The fact `ll1 grammar0 = true` is proved by `decide`. The generic table parser is proved against `Derives`.
   212	- **`Derives : List Token → Surface.Program → Prop`**, which binds token payloads, not only token kinds.
   213	- **`Elab : Surface.Program → Core.Program → Prop`**, with the compiler's theorems `elab_fresh` (temporaries never collide with user names) and `elab_rename_invariant` (renaming temporaries changes neither acceptance nor outcome).
   214	- **Refusal classes**, as the spec defines them:
   215	  - a syntax error;
   216	  - "not supported in slice 0", for a decided form outside `Fragment.surface s0` (owner, 2026-11-06);
   217	  - a checker refusal.
   218	
   219	  The compiler reports exactly the class that the spec judgment gives.
   220	- **`Denotes src p := ∃ toks ast, Lexes src toks ∧ Derives toks ast ∧ Elab ast p`.** Its theorem is `denotes_behaviour_det` (see the theorem section).
