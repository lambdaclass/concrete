 c=[v.strip() for v in l.split('|')]
 if len(c)==6 and re.fullmatch(r'R-\\d{4}',c[1]):
  g[c[1]]=re.findall(r'R-\\d{4}',c[4])
active=[]; done=set(); cycles=[]
def visit(n):
 if n in active:
  cycles.append(active[active.index(n):]+[n]);return
 if n in done:return
 active.append(n)
 for d in g.get(n,[]):visit(d)
 active.pop();done.add(n)
for n in g:visit(n)
print('Task rows:',len(g),'Dependency edges:',sum(map(len,g.values())))
print('Cycles:',cycles)
seen=set()
def reach(n):
 if n in seen:return
 seen.add(n)
 for d in g.get(n,[]):reach(d)
reach('R-0584')
print('R-0584 transitive task prerequisites:', ', '.join(sorted(seen-{'R-0584'})))
print('R-0621 reachable from R-0584:', 'R-0621' in seen)
print('R-0621 direct dependencies:',g['R-0621'])
