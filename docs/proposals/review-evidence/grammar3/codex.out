from pathlib import Path
import re
for f in ['GRAMMAR_REVIEW.md','GRAMMAR_CHANGES.md','SIMPLIFY_MERGED.md']:
 p=Path('_review')/f;s=p.read_text(); bad=[]
 for label,url in re.findall(r'\\[(["'^'"\\]]*)\\]\\((["'^)]+)'"\\)',s):
  if '://' in url: continue
  path,_,anchor=url.partition('#'); q=p.parent/path
  if not q.exists(): bad.append(url);continue
  if anchor:
   t=q.read_text(); ids=re.findall(r'<a\\s+id=\"(["'^"]+)"'"',t)
   heads=[re.sub(r'["'^'"\\w\\- ]','',h.lower()).replace(' ','-') for h in re.findall(r'"'^#+'"\\s+(.+)',t,re.M)]
   if anchor not in ids+heads: bad.append(url)
 print(f, 'lines',len(s.splitlines()),'unresolved links', sorted(set(bad)))
