from pathlib import Path
p=Path('_review')
rows=[
('LF/CR/EOF comments','Agree; clarify CR','LF/CR/EOF','Agree LF/EOF','Changed to CR termination too: matches proposed whitespace without swallowing a CR-only line.'),
