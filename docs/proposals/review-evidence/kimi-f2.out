diff --git a/scripts/checks/workflow_yaml.sh b/scripts/checks/workflow_yaml.sh
index 85c977405..159e85d93 100755
--- a/scripts/checks/workflow_yaml.sh
+++ b/scripts/checks/workflow_yaml.sh
@@ -45,6 +45,113 @@ for f in "$WF_DIR"/*.yml "$WF_DIR"/*.yaml; do
   fi
 done
 
+echo "=== cross-machine reproducibility (ISS-0029) ==="
+if python3 -I - "$WF_DIR/lean_action_ci.yml" "$GATE_TMP/compare-linux.sh" <<'PY'
+import sys
+from pathlib import Path
+import yaml
+
+workflow, output = sys.argv[1:]
+jobs = yaml.safe_load(open(workflow))["jobs"]
+repro = jobs["reproducibility"]
+rows = repro["strategy"]["matrix"]["include"]
+by_id = {row["id"]: row for row in rows}
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+require(set(by_id) == {"linux-github", "linux-ci2", "macos"},
+        f"reproducibility legs are {sorted(by_id)}")
+require(by_id["linux-github"]["runner"] == "ubuntu-24.04",
+        "linux-github is not GitHub-hosted ubuntu-24.04")
+ci2_runner = by_id["linux-ci2"]["runner"]
+require(ci2_runner == '${{ fromJSON(\'["self-hosted","linux","x64","concrete"]\') }}',
+        f"linux-ci2 does not select only the concrete-ci-2 labels: {ci2_runner}")
+require("||" not in ci2_runner and "CONCRETE_SELF_HOSTED" not in ci2_runner,
+        "linux-ci2 has a runner fallback")
+require(by_id["linux-ci2"]["machine"] == "concrete-ci-2",
+        "linux-ci2 does not record its machine")
+require(by_id["macos"]["runner"] == "macos-15", "the macOS leg changed")
+require(repro["runs-on"] == "${{ matrix.runner }}", "reproducibility does not use matrix.runner")
+nix = [step for step in repro["steps"] if step.get("uses") == "cachix/install-nix-action@v31"]
+require(len(nix) == 1 and nix[0].get("if") == "runner.environment != 'self-hosted'",
+        "Nix installation is not GitHub-hosted-only")
+build = next(step for step in repro["steps"]
+             if "slice0_repro.sh" in step.get("run", ""))
+require(build["env"]["CONCRETE_REPRO_RUNNER_ENVIRONMENT"] == "${{ runner.environment }}",
+        "runner.environment is not recorded")
+require(build["env"]["CONCRETE_REPRO_RUNNER_HOST"] == "${{ matrix.machine }}",
+        "the matrix machine is not recorded")
+require(build["env"]["CONCRETE_REPRO_RUNNER_NAME"] == "${{ runner.name }}",
+        "runner.name is not recorded")
+compare = jobs["compare-linux"]
+require(compare["needs"] == "reproducibility", "compare-linux does not need both Linux legs")
+download = next(step for step in compare["steps"]
+                if step.get("uses") == "actions/download-artifact@v4")
+require(download["with"]["pattern"] == "reproducibility-linux-*",
+        "compare-linux does not download the Linux manifests")
+run = next(step["run"] for step in compare["steps"]
+           if "repro_manifest_compare.py" in step.get("run", ""))
+for text in ("reproducibility-linux-github/manifest.txt",
+             "reproducibility-linux-ci2/manifest.txt"):
+    require(text in run, f"compare-linux does not read {text}")
+Path(output).write_text(run)
+PY
+then
+  echo "  ok   workflow selects GitHub and concrete-ci-2, with no ci2 fallback"; PASS=$((PASS+1))
+else
+  echo "  FAIL workflow reproducibility structure"; FAIL=$((FAIL+1))
+fi
+
+write_manifest() { # PATH ENVIRONMENT HOST RUNNER_NAME HASH
+  mkdir -p "${1%/*}"
+  {
+    printf 'runner_environment=%s\n' "$2"
+    printf 'runner_host=%s\n' "$3"
+    printf 'runner_name=%s\n' "$4"
+    printf 'compiler_commit=0123456789abcdef\n'
+    printf 'target=x86_64-linux\n'
+    [ "$5" = none ] || printf '%s  example/lcb.exe\n' "$5"
+  } > "$1"
+}
+
+compare_control() { # LABEL SECOND_ENVIRONMENT SECOND_HOST SECOND_HASH SECOND_KIND EXPECTED_ERROR
+  local label=$1 env=$2 host=$3 hash=$4 kind=$5 expected=$6
+  local d="$GATE_TMP/repro-$label" rc=0
+  mkdir -p "$d/scripts/checks/lib"
+  cp scripts/checks/lib/repro_manifest_compare.py "$d/scripts/checks/lib/"
+  write_manifest "$d/manifests/reproducibility-linux-github/manifest.txt" \
+    github-hosted github github-actions aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
+  if [ "$kind" != missing ]; then
+    write_manifest "$d/manifests/reproducibility-linux-ci2/manifest.txt" \
+      "$env" "$host" concrete-ci-2-gha1 "$hash"
+  fi
+  (cd "$d" && bash "$GATE_TMP/compare-l
inux.sh") > "$d/output" 2>&1 || rc=$?
+  if [ -z "$expected" ]; then
+    if [ "$rc" = 0 ]; then
+      echo "  ok   comparison control $label passes"; PASS=$((PASS+1))
+    else
+      echo "  FAIL comparison control $label refused"; sed 's/^/         /' "$d/output"; FAIL=$((FAIL+1))
+    fi
+  elif [ "$rc" != 0 ] && has_match -F "$expected" < "$d/output"; then
+    echo "  ok   comparison control $label is refused"; PASS=$((PASS+1))
+  else
+    echo "  FAIL comparison control $label was not refused as '$expected' (rc=$rc)"
+    sed 's/^/         /' "$d/output"; FAIL=$((FAIL+1))
+  fi
+}
+
+if [ -s "$GATE_TMP/compare-linux.sh" ]; then
+  a=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
+  b=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
+  compare_control identical self-hosted concrete-ci-2 "$a" normal ""
+  compare_control differing-ci2 self-hosted concrete-ci-2 "$b" normal "manifests differ"
+  compare_control two-github github-hosted github "$a" normal "expected runner_environment=self-hosted"
+  compare_control missing-manifest self-hosted concrete-ci-2 "$a" missing "cannot read manifest"
+  compare_control missing-hashes self-hosted concrete-ci-2 none normal "missing lcb.exe SHA-256"
+fi
+
 echo ""
 echo "WORKFLOW-YAML: PASS=$PASS  FAIL=$FAIL"
 [ "$FAIL" -eq 0 ]
diff --git a/Concrete/README.md b/Concrete/README.md
index 9e99868c4..2191a438e 100644
--- a/Concrete/README.md
+++ b/Concrete/README.md
@@ -579,7 +579,7 @@ The CLI is `concrete facts FILE [FN]` and `concrete build FILE -o OUT` (owner, 2
    An in-process leg also compares `BIR.behaviour b` with LCB's own evaluator on the emitted body, an executable cross-check of `emit_correct`.
 6a. **AArch64:** a GitHub-hosted AArch64 macOS job (`macos-15`) builds the LCB output for `aarch64-macos`, runs gates 4 and 6 there natively, and compares against Lean. LLVM-native also runs there, as a third cross-check. Gates 4 and 6 for x86-64 run on concrete-ci-2.
 7. **Certificates:** the kernel checks every acceptance and refusal certificate, with measured budgets.
-8. **Reproducibility** (implemented, `scripts/checks/compiler/slice0_repro.sh`): two independent builds give byte-identical outputs at every stage, on each target, and two independent Linux runners give identical manifests. See [Reproducible builds](#reproducible-builds-owner-2026-11-07).
+8. **Reproducibility** (implemented, `scripts/checks/compiler/slice0_repro.sh`): two independent builds give byte-identical outputs at every stage, on each target, and GitHub-hosted `ubuntu-24.04` and concrete-ci-2 give identical Linux manifests after their runner provenance is verified. See [Reproducible builds](#reproducible-builds-owner-2026-11-07).
 9. **Trusted base** (owner, 2026-11-07): a golden test that `concrete facts` prints exactly the spec's premise list, so a premise added, removed or reworded anywhere fails until the golden is updated with it. Implemented provisionally in `scripts/checks/compiler/slice0_trusted_base.sh`: until `concrete facts` exists, `scripts/checks/compiler/slice0_trusted_base.lean` prints `Premises.report`: the premise registry `Concrete/Premises.lean`, the sorted axioms of each headline theorem (`Premises.theorems`) and each axiom's type; the gate appends the Lean toolchain and the Lake pins, and the result must equal `tests/golden/slice0_trusted_base.txt` byte for byte. The README's open-premise table must equal the registry's rendering (`Premises.tableRow`). Controls cover the comparison, a failing printer, the axiom collection and a drifted table. The statements are text until `FrontendPremises` and `NativePremises` land as Lean structures; each entry then names its field.
 10. **Sanitizers** (owner, 2026-11-07; UBSan dropped by the owner, 2026-11-08; implemented in `scripts/checks/compiler/slice0_artifacts.sh`): every LLVM example also runs built with ASan in CI, and must give the same observation with no sanitizer report. ASan instruments only functions marked `sanitize_address`, which clang's C front end adds and the printed IR lacks, so the sanitizer build adds it to every definition (`slice0_native.sh sanitize`); a control body with an out-of-bounds load must be reported. There is no UBSan leg: UBSan's checks are inserted by clang's C front end, so on LLVM IR input it checks nothing. No C is compiled in slice 0, and the LLVM-level undefined behaviour of the printed IR (poison, `unreachable`) stays P_print's.
 11. **Binary size** (owner, 2026-11-07; implemented, same script): the size of each example's executable (bytes and text size, pinned `llvm-size`), per backend and target, is recorded per run in `sizes.tsv`, uploaded with the job. Report-only: it never fails a run. **Compile time** (owner, 2026-11-08; same script, report-only): each example's emit step (the Lean emitter, Lean start-up included) and native step (clang and LCB's command line) in wall-clock milliseconds, next to its budget (the step's time bound), in `compile_times.tsv`.
@@ -712,9 +712,11 @@ shell's general `clang` is unchanged), an environment reduced to `PATH`, `HOME`
 debug information, path prefix maps, and no ELF build ID or Mach-O UUID (`ZERO_AR_DATE=1` on
 both paths). The printers traverse ordered lists/arrays (including stable first-occurrence
 intrinsic deduplication); site paths are project-relative source data. They emit no clock,
-hostname or temporary path. CI repea
ts this on x86-64 Linux and AArch64 macOS and compares the
-complete Linux manifests from two independent runners. Different targets are never compared.
-Changes to these pins change the build identity; no reproducibility claim spans different
+hostname or temporary path. CI repeats this on x86-64 Linux and AArch64 macOS. The Linux manifests
+record `runner_environment`, `runner_host` and `runner_name`; `compare-linux` requires one manifest
+from GitHub-hosted `ubuntu-24.04` and one from self-hosted concrete-ci-2, excludes only that runner
+provenance, and compares every build-identity and artifact-hash line. Different targets are never
+compared. Changes to these pins change the build identity; no reproducibility claim spans different
 toolchains or targets.
 
