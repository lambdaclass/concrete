p='Concrete/Lex.lean';s=open(p).read();import re
s=re.sub(r'obtain ⟨ds, (hd|he), rfl⟩ := prepend_ok \\(by simpa \\[decodeAt.eq_def, (["'^'"\\]]+)\\] using h\\)',lambda m:'rw [decodeAt.eq_def] at h\\n    simp only ['+m[2]+', ↓reduceIte] at h\\n    obtain ⟨ds, '+m[1]+', rfl⟩ := prepend_ok h',s)
s=s.replace('simp [decodeAt.eq_def,','rw [decodeAt.eq_def] at h\\n    simp [') # failing branches check
# replacement created simp [ha] at h okay
lines=s.splitlines();out=[]
for l in lines:
 if 'simp only [List.cons_append' in l:
  vals=l.split('decodeAt.eq_def, ')[1].split(', ih, prepend]')[0]
  out += ['      simp only [List.cons_append, List.nil_append]', '      rw [decodeAt.eq_def]', '      simp only ['+vals+', ih, prepend]']
 else:out.append(l)
open(p,'w').write('\\n'.join(out)+'\\n')
