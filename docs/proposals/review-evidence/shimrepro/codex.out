#!/usr/bin/env bash
# The impact-selected gates for exactly the range base..head, run in the current checkout (which must
# be at head). Shared by train.sh check, ready.sh and the landing bot's auto-rebase.
#
#   impact_gates.sh --base <sha> --head <sha> [--src-ref R] [--dst-ref R] [--report FILE]
#
# 1. The pre-push hook's own selection (R-0022 fast surface gates + touched areas), fed the line
#    `<src-ref> <head> <dst-ref> <base>`, so a later push presenting that range reuses its record.
#    The dst ref must not be wip/* (the hook's backup tier runs no gates); default refs/heads/ci/impact.
# 2. scripts/tests/select_gates.sh --base --head (R-0513), when it exists and the hook does not
#    already call it, run through run_ci_gates_local.sh --first.
# --report FILE receives `selected: N` (the select_gates count, or `hook` when only the hook ran).
# LAND_HOOK, LAND_REMOTE, LAND_NO_NIX as in train.sh.
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/land/lib.sh
. "$SELF_DIR/lib.sh"
die() { echo "impact: $*" >&2; exit 1; }
base="" head="" src="refs/heads/impact" dst="refs/heads/ci/impact" report=""
while [ $# -gt 0 ]; do
  case "$1" in
    --base) base="$2"; shift ;;
    --head) head="$2"; shift ;;
    --src-ref) src="$2"; shift ;;
    --dst-ref) dst="$2"; shift ;;
    --report) report="$2"; shift ;;
    *) die "unknown argument $1" ;;
  esac; shift
done
[ -n "$base" ] && [ -n "$head" ] || die "--base and --head are required"
case "$dst" in refs/heads/wip/*) die "--dst-ref $dst is in the hook's wip tier, which runs no gates" ;; esac
cd "$(git rev-parse --show-toplevel)"
HOOK="${LAND_HOOK:-.githooks/pre-push}"
REMOTE="${LAND_REMOTE:-origin}"
[ "$(git rev-parse HEAD)" = "$(git rev-parse "$head")" ] || die "the checkout is not at --head $head"
[ -f "$HOOK" ] || die "no pre-push hook at $HOOK"
url="$(git remote get-url "$REMOTE" 2>/dev/null || echo "$REMOTE")"
printf '%s %s %s %s\n' "$src" "$(git rev-parse "$head")" "$dst" "$(git rev-parse "$base")" \
  | land_in_nix bash "$HOOK" "$REMOTE" "$url"
selected=hook
if [ -f scripts/tests/select_gates.sh ] && ! grep -q select_gates "$HOOK" 2>/dev/null; then
  sel="$(land_in_nix bash scripts/tests/select_gates.sh --base "$base" --head "$head")"
  args=() c=""
  while IFS= read -r c; do [ -n "$c" ] && args+=(--first "$c"); done <<< "$sel"
  selected="$(( ${#args[@]} / 2 ))"
  if [ "${#args[@]}" -gt 0 ]; then land_in_nix bash scripts/checks/run.sh "${args[@]}"; fi
fi
[ -z "$report" ] || echo "selected: $selected" > "$report"
echo "impact: gates passed for ${base:0:10}..${head:0:10} (selected: $selected)"
#!/usr/bin/env bash
# Every root check, in order; the one entry point the pre-push hook, CI's "Root checks" job and the
# landing tools (scripts/land/train.sh, ready.sh: LAND_FULL_GATES_CMD) run.
#
# The set is every scripts/checks/*.sh except this file, so a new check cannot be written and then
# forgotten here. REQUIRED names the checks that must exist: deleting one fails the run instead of
# shrinking it. Each check runs to completion; the run fails if any check failed.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"
REQUIRED="legacy_frozen root_inventory workflow_yaml doc_links landing_script landing_bot review_tool sandbox_isolation retention_manifest issues oracle_fetch"
missing=""
for c in $REQUIRED; do [ -f "scripts/checks/$c.sh" ] || missing="$missing $c"; done
[ -z "$missing" ] || { echo "run.sh: required check(s) missing:$missing" >&2; exit 1; }
failed="" n=0
for f in scripts/checks/*.sh; do
  [ "$f" = scripts/checks/run.sh ] && continue
  n=$((n+1))
  echo "=== $f ==="
  s="$(date +%s)"
  if bash "$f"; then echo "--- $f: pass ($(( $(date +%s) - s ))s)"
  else echo "--- $f: FAIL ($(( $(date +%s) - s ))s)"; failed="$failed ${f##*/}"; fi
done
echo
if [ -n "$failed" ]; then echo "root checks: FAILED:$failed (of $n)"; exit 1; fi
echo "root checks: all $n pass"
#!/usr/bin/env bash
# A remote runner: fetches like concrete-remote (a ref on origin, or a SHA) and reports the SHA.
echo "$1" >> "$FAKE_GH_DIR/runner.log"
sha="$(git --git-dir="$ORIGIN_GIT" rev-parse --verify -q "refs/heads/$1" || git --git-dir="$ORIGIN_GIT" rev-parse --verify -q "$1^{commit}")" || { echo "no such ref $1"; exit 1; }
echo "[concrete-remote] ref=$1 sha=$sha"
EOF
chmod +x "$TMP/fake-gh" "$TMP/hook" "$TMP/notify.sh" "$TMP/train-nobisect.sh" "$TMP/fake-runner"

for r in origin lambdaclass fork; do git init -q --bare "$TMP/$r.git"; done
A="$TMP/agent"; W="$TMP/bot"
git init -q "$A"; cd "$A" || exit 2
for r in origin lambdaclass fork; do git remote add "$r" "$TMP/$r.git"; done
mkdir -p Concrete/Check Concrete/Elab src
printf 'def e := "E0001 existing"\n' > Concrete/Check/Check.lean
printf 'def x := 1\n' > Concrete/Elab/Elab.lean
printf 'x\n' > conflict.txt
printf 'Build\n' > required-checks.txt  # train.sh refuses a landing with no required-checks.txt
git add -A && git commit -qm base
for r in origin lambdaclass fork; do git push -q "$r" main; done
BASE="$(git rev-parse HEAD)"
git clone -q "$TMP/origin.git" "$W"
( cd "$W" && git remote add lambdaclass "$TMP/lambdaclass.git" && git remote add fork "$TMP/fork.git" )

reset_fake() { rm -f "$FAKE_LOG"/*; }

# ------------------------------------------------------------------ repos
git init -q --bare "$T/origin.git"
git clone -q "$T/origin.git" "$T/w" 2>/dev/null
W="$T/w"
g() { git -C "$W" "$@"; }
commit_file() { # commit_file <path> <content> <message>
  mkdir -p "$(dirname "$W/$1")"
  printf '%s\n' "$2" >"$W/$1"
  g add -A && g commit -qm "$3"
}
commit_file README.md "base" "base"
printf '.review/\n' >"$W/.gitignore"
g add .gitignore && g commit -qm "ignore .review"
g push -q origin main
review() { (cd "$W" && bash "$REVIEW" "$@"); }
note() { g notes --ref=refs/notes/concrete-review show "${1:-HEAD}" 2>/dev/null; }
field() { note "${2:-HEAD}" | sed -n "s/^$1: //p"; }

