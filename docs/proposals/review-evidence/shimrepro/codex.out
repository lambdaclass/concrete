rg -n 'pre-push|impact|run.sh|ISS-0015' scripts/land/train.sh .githooks/pre-push ISSUES.tsv" in /tmp/claude-30035/-home-unbalancedparen-projects-concrete2/e2c54e65-31b5-4145-8101-c2d7b071b97e/scratchpad/shimrepro/repo
