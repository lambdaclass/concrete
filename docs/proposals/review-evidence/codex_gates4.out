   389	        sys.exit(1)
   390	    print(f"bound {total}")
   391	    for name, depth in sorted(ext.items()):
   392	        print(f"external {name} {depth}")
   393	    if len(sys.argv) == 4 and sys.argv[3] == "--ranges":
   394	        for key, name in sorted(owned.items()):
   395	            code = funcs[name]
   396	            print(f"range {key} {code[0][0]:#x} {code[-1][0]:#x}")

