   111	  build "$name" "$d/build-san.log" \
   112	    "${capped[@]}" timeout -k 10 300 bash "$root/scripts/checks/slice0_native.sh" "$d" "$lcb" sanitize
   113	  observe "$d/llvm.san.exe" "$d/san" 30 30 0 "${san_env[@]}"
   114	  if judge "$d" "$d/san"; then
