   296	    def add_ext(ext, sub, base):
   297	        for name, depth in sub.items():
   298	            ext[name] = max(ext.get(name, 0), base + depth)
   299	
   300	    def fn_bound(key):
   301	        """(deepest, externals) of owned function `key`, relative to its own entry."""
