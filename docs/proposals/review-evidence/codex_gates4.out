     1	# gdb -batch -nx -x stack_measure.py EXE (README gate 12, x86-64 Linux). PROVISIONAL.
     2	#
     3	# Measures the stack depth one complete run of EXE reaches, below the stack pointer at `main`'s
     4	# entry, by single-stepping every instruction of the Concrete-owned functions (STACK_RANGES:
     5	# "LO:HI,..." in the executable's link-time addresses, from stack_bound.py --ranges; STACK_MAIN:
     6	# main's LO). An external function (entered through a call, so its return address is at the stack
     7	# pointer) runs at full speed to that return address; its own use is outside the bound, as in
     8	# stack_bound.py, but the depth at its entry is measured. Once main has returned, the rest runs
     9	# freely.
    10	#
    11	# Fail closed: the measurement counts only for a run that stopped first at main's runtime address,
    12	# stopped after each external call exactly at its return address (or exited inside it), received
    13	# no signal, and exited normally with status STACK_EXPECT. Prints `measured N` and `steps N`, or
    14	# `error ...` (the gate fails on anything but a measurement).
    15	import os
    16	
    17	import gdb
    18	
    19	LIMIT = 2_000_000
    20	ranges = [tuple(int(x, 16) for x in r.split(":")) for r in os.environ["STACK_RANGES"].split(",")]
    21	main_lo = int(os.environ["STACK_MAIN"], 16)
    22	expect = int(os.environ["STACK_EXPECT"])
    23	state = {"exit": None, "signal": None}
    24	
    25	
    26	def on_exit(event):
    27	    state["exit"] = event.exit_code if hasattr(event, "exit_code") else "unknown"
    28	
    29	
    30	def on_stop(event):
    31	    if isinstance(event, gdb.SignalEvent):
    32	        state["signal"] = event.stop_signal
    33	
    34	
    35	gdb.events.exited.connect(on_exit)
    36	gdb.events.stop.connect(on_stop)
    37	gdb.execute("set pagination off")
    38	gdb.execute("set confirm off")
    39	gdb.execute("set disable-randomization on")
    40	
    41	
    42	def reg(name):
    43	    return int(gdb.parse_and_eval(f"(unsigned long) ${name}"))
    44	
    45	
    46	def live():
    47	    if state["signal"] is not None:
    48	        raise RuntimeError(f"signal {state['signal']}")
    49	    return state["exit"] is None
    50	
    51	
    52	try:
    53	    gdb.execute("break *main", to_string=True)
    54	    gdb.execute("run </dev/null >/dev/null 2>/dev/null", to_string=True)
    55	    if not live():
    56	        raise RuntimeError("exited before main")
    57	    main_rt = int(gdb.parse_and_eval("(unsigned long) &main"))
    58	    if reg("pc") != main_rt:
    59	        raise RuntimeError(f"first stop at {reg('pc'):#x}, not main ({main_rt:#x})")
    60	    offset = main_rt - main_lo
    61	    sp0 = reg("sp")
    62	    low, steps = sp0, 0
    63	    inferior = gdb.selected_inferior()
    64	    gdb.execute("delete", to_string=True)
    65	    while live():
    66	        pc, sp = reg("pc"), reg("sp")
    67	        if sp > sp0:  # main has returned
    68	            gdb.execute("continue", to_string=True)
