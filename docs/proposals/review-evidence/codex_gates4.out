    85	        raise RuntimeError(f"exit status {state['exit']}, expected {expect}")
    86	    if steps == 0:
    87	        raise RuntimeError("no instruction stepped")
    88	    print(f"measured {sp0 - low}")
    89	    print(f"steps {steps}")
    90	except Exception as e:  # noqa: BLE001 - every failure is reported, the gate fails closed
    91	    print(f"error {e}")
     1	# shellcheck shell=bash
     2	# Shared machinery of the slice-0 example gates (PROVISIONAL): slice0_backends.sh (gates 4, 6, 6a)
     3	# and slice0_artifacts.sh (gates 10, 11, 12). Source it from the repository root, inside the nix
     4	# devshell, with `set -euo pipefail`. It builds the compiler and LCB's command line under the
     5	# gate's limits (lib/limits.sh: an address-space cap of SLICE0_GATE_MEM_GB GiB, default 64; 0 for
     6	# a gate whose executables under test need no cap, slice0_artifacts.sh) and defines:
     7	#   capped (a command prefix, an array): run under a 64 GiB address-space cap of its own, so
     8	#     every build and analysis command is capped whatever the gate's cap;
     9	#   root, work (removed on exit), lcb, target, emitter (the Lean emitter command, an array);
    10	#   observe EXE OUT SECS RETRY [MEM_MB [ENV...]]: run EXE under bounded_run (and limited_exec.sh
    11	#     MEM_MB, default 1024) with ENV assignments; OUT.status (status or "incomplete"),
    12	#     OUT.stdout, OUT.stderr;
    13	#   judge EXPECTED_DIR OBS: the observation OBS.* equals the expectation, byte for byte;
    14	#   build NAME LOG CMD...: run CMD, or print LOG and fail the gate;
    15	#   emit_examples: the example names, one per line, failing if there are none;
    16	#   cap_out: copy stdin to stdout, failing above 1 MiB: every command output a gate captures
    17	#     into a variable goes through it, so no producer can grow the gate's shell (which may run
    18	#     with no address-space cap, see SLICE0_GATE_MEM_GB) without bound.
    19	root=$(pwd)
    20	work=$(mktemp -d)
    21	trap 'rm -rf "${work:?}"' EXIT
    22	BOUNDED_PARENT="$work"
    23	# shellcheck source=scripts/checks/lib/bounded.sh
    24	source scripts/checks/lib/bounded.sh
    25	[ "$BOUNDED_HAVE_WATCHDOG" = 1 ] || { echo "slice0: python3 is required for bounded runs" >&2; exit 2; }
    26	# shellcheck source=scripts/checks/lib/limits.sh
    27	source scripts/checks/lib/limits.sh
    28	gate_limits "${SLICE0_GATE_MEM_GB:-64}" 40000
    29	capped=(bash "$root/scripts/checks/lib/limited_exec.sh" 65536)
    30	"${capped[@]}" timeout -k 30 1800 lake build Concrete lean-compiler-backend/lcb >/dev/null
    31	lcb="$root/.lake/packages/lean-compiler-backend/.lake/build/bin/lcb"
    32	case "$(uname -s)-$(uname -m)" in
    33	  Linux-x86_64) target=x86_64-linux ;;
    34	  Linux-aarch64) target=aarch64-linux ;;
    35	  Darwin-arm64) target=aarch64-macos ;;
    36	  *) echo "slice0: unsupported host $(uname -s)-$(uname -m)" >&2; exit 2 ;;
    37	esac
    38	emitter=("${capped[@]}" timeout -k 10 120 lake env lean --run scripts/checks/slice0_bir.lean)
    39	
    40	observe() {
    41	  local rc=0 mem=${5:-1024}
    42	  local envs=("${@:6}")
    43	  bounded_run -i /dev/null -r "$4" "$3" -- env ${envs[@]+"${envs[@]}"} \
    44	    bash "$root/scripts/checks/lib/limited_exec.sh" "$mem" "$1" \
    45	    >"$2.stdout" 2>"$2.stderr" || rc=$?
    46	  if bounded_is_incomplete "$rc"; then echo incomplete >"$2.status"; else echo "$rc" >"$2.status"; fi
    47	}
    48	
    49	judge() {
    50	  cmp -s "$1/status" "$2.status" && cmp -s "$1/stderr" "$2.stderr" && [ ! -s "$2.stdout" ]
    51	}
    52	
    53	build() {
    54	  local name=$1 log=$2; shift 2
    55	  "$@" >"$log" 2>&1 || { cat "$log" >&2; echo "slice0: $name: build failed: $*" >&2; exit 1; }
    56	}
    57	
    58	cap_out() {
    59	  local LC_ALL=C out
    60	  out=$(head -c 1048577; echo x)
    61	  out=${out%x}
    62	  [ "${#out}" -le 1048576 ] || { echo "slice0: captured output over 1 MiB" >&2; return 1; }
    63	  printf '%s' "$out"
    64	}
    65	
    66	emit_examples() {
    67	  local names
    68	  names=$("${emitter[@]}" list | cap_out) || { echo "slice0: listing the examples failed" >&2; exit 1; }
    69	  [ -n "$names" ] || { echo "slice0: no examples listed" >&2; exit 1; }
    70	  printf '%s\n' "$names"
    71	}
     1	#!/usr/bin/env bash
     2	# Slice-0 artifact gates (PROVISIONAL, Concrete/README.md gates 10, 11 and 12), over every
     3	# hand-written BIR example, on the executables slice0_native.sh links:
     4	#
     5	# 10. Sanitizers: the LLVM example also built with ASan and UBSan (slice0_native.sh sanitize: ASan
     6	#     instruments the printed IR once every definition carries sanitize_address; UBSan's checks
     7	#     come from clang's C front end, so on IR only its runtime is linked) must
     8	#     give the same observation as the BIR semantics (status, exact fd-2 bytes, empty fd 1), so no
     9	#     sanitizer report. Its memory is bounded by ASan's hard_rss_limit_mb (the shadow reservation
    10	#     rules out an address-space cap; every other command is capped, see SLICE0_GATE_MEM_GB). Control: a body with an out-of-bounds load must be reported.
    11	# 11. Binary size (report-only, never fails on a size): bytes and text size of each executable,
    12	#     per backend and target, in REPORT/sizes.tsv.
    13	# 12. Stack bound: lib/stack_bound.py derives, from the linked executable's disassembly, a bound on
    14	#     the Concrete-owned stack below main's entry, covering every byte addressed relative to the
    15	#     stack or frame pointer (so the red zone), with external libc calls listed with their entry
    16	#     depth (their own use, and that _exit and abort do not return, are premises). On x86-64
    17	#     Linux, a run under gdb (lib/stack_measure.py) must stay within it (the run measures the
    18	#     stack pointer only). REPORT/stack.tsv. Controls: the analysis must refuse an unmodelled
    19	#     stack-pointer write, an indirect call, recursion, a call to an unknown function, two depths
    20	#     meeting, a stack pointer used as a value or written through a partial register, a partial
    21	#     frame-pointer write, an indexed stack address, an unmodelled
    22	#     instruction (x86 `loop`) and frame-pointer writeback (AArch64), and give the
    23	#     expected bound on a known function and on a red-zone store; the comparison must reject a
    24	#     measurement above the bound.
    25	#
    26	# usage: slice0_artifacts.sh [REPORT_DIR]. Run inside the nix devshell, from the repository root.
    27	set -euo pipefail
    28	report=${1:-}
    29	# The sanitizer executions need an unbounded address-space reservation, so the gate sets no cap of
    30	# its own and caps every other command it starts (`capped`, and limited_exec.sh for executables).
    31	SLICE0_GATE_MEM_GB=0
    32	# shellcheck source=scripts/checks/lib/slice0_common.sh
    33	source scripts/checks/lib/slice0_common.sh
    34	: "${CONCRETE_SLICE0_LLVM:?run inside nix develop}"
    35	objdump=("${capped[@]}" "$CONCRETE_SLICE0_LLVM/llvm-objdump" -d --no-show-raw-insn)
    36	case "$target" in
    37	  x86_64-linux) arch=x86_64; objdump+=(--x86-asm-syntax=intel) ;;
    38	  aarch64-*) arch=aarch64 ;;
    39	esac
    40	gdb=
    41	if [ "$target" = x86_64-linux ]; then gdb=${CONCRETE_SLICE0_GDB:?the x86-64 Linux shell pins gdb}; fi
    42	[ -n "$report" ] || report="$work/report"
    43	mkdir -p "$report"
    44	sizes="$report/sizes.tsv"
    45	stack="$report/stack.tsv"
    46	printf 'example\tbackend\ttarget\tbytes\ttext\n' >"$sizes"
    47	printf 'example\tbackend\ttarget\tbound\tmeasured\texternals\n' >"$stack"
    48	# hard_rss_limit_mb and LeakSanitizer are Linux-only (ASan on Darwin refuses detect_leaks); on
    49	# macOS RLIMIT_AS is not enforced either, so there the job's memory is the bound, as for all runs.
    50	asan=abort_on_error=0:symbolize=0
    51	[ "$(uname -s)" != Linux ] || asan="$asan:hard_rss_limit_mb=1024:detect_leaks=1"
    52	san_env=("ASAN_OPTIONS=$asan" UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=0:symbolize=0)
    53	# stack_bound ARCH DISASM [--ranges]: the analysis, capped and bounded in time.
    54	stack_bound() { "${capped[@]}" timeout -k 10 60 python3 -I "$root/scripts/checks/lib/stack_bound.py" "$@"; }
    55	fail=0
    56	examples=0
    57	last_exe= last_analysis=
    58	
    59	# within MEASURED BOUND: the run stayed within the static bound (and actually ran).
    60	within() { [ "$1" -gt 0 ] && [ "$1" -le "$2" ]; }
    61	
    62	# measure EXE ANALYSIS EXPECT: the gdb run check's output (`measured N` or `error ...`), given the
    63	# analysis output (its `range` lines) and the expected exit status.
    64	measure() {
    65	  local ranges main
    66	  ranges=$(awk '$1 == "range" {printf "%s%s:%s", sep, $3, $4; sep=","}' <<<"$2")
    67	  main=$(awk '$1 == "range" && $2 == "main" {print $3}' <<<"$2")
