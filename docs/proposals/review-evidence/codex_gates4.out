   303	            return memo[key]
   304	        if key in active:
   305	            raise Refuse(f"recursion through {key}")
   306	        active.add(key)
   307	        code = funcs[owned[key]]
   308	        if not code:
   309	            raise Refuse(f"{key}: no instructions")
   310	        index = {a: i for i, (a, _, _) in enumerate(code)}
   311	        seen, work, deepest, ext = {}, [(0, 0, None)], 0, {}
   312	        while work:
   313	            i, d, fp = work.pop()
   314	            while True:
   315	                if i >= len(code):
   316	                    raise Refuse(f"{key}: runs off its end")
   317	                addr, mn, ops = code[i]
   318	                if addr in seen:
   319	                    if seen[addr] != (d, fp):
   320	                        raise Refuse(f"{key}+{addr:#x}: depths {seen[addr]} and {(d, fp)} meet")
   321	                    break
   322	                seen[addr] = (d, fp)
   323	                kind, arg = control(mn, ops)
   324	                if kind is None:
   325	                    if not plain.match(mn):
   326	                        raise Refuse(f"{key}+{addr:#x}: unmodelled instruction: {mn} {ops}")
   327	                    touched = access(mn, ops, d, fp)
   328	                    if touched is not None:
   329	                        deepest = max(deepest, touched)
   330	                    d, fp = step(mn, ops, d, fp)
   331	                    if d < 0:
   332	                        raise Refuse(f"{key}+{addr:#x}: stack above the entry")
   333	                    deepest = max(deepest, d)
   334	                    i += 1
   335	                    continue
   336	                if kind == "indirect":
   337	                    raise Refuse(f"{key}+{addr:#x}: indirect branch {mn} {ops}")
   338	                if kind == "ret":
   339	                    if d != 0:
   340	                        raise Refuse(f"{key}+{addr:#x}: return at depth {d}")
   341	                    break
   342	                if kind == "stop":
   343	                    break
   344	                tgt, sym = target_of(arg)
   345	                if tgt is None:
   346	                    raise Refuse(f"{key}+{addr:#x}: indirect {mn} {ops}")
   347	                if kind == "call":
   348	                    base = sym.split("+")[0]
   349	                    callee = owned_name(base)
   350	                    if callee and "+" not in sym:
   351	                        sub_deep, sub_ext = fn_bound(callee)
   352	                        deepest = max(deepest, d + ret_push + sub_deep)
   353	                        add_ext(ext, sub_ext, d + ret_push)
