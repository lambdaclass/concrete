   370	                work.append((index[tgt], d, fp))
   371	                i += 1
   372	        active.discard(key)
   373	        memo[key] = (deepest, ext)
   374	        return memo[key]
   375	
   376	    total, ext = fn_bound("main")
   377	    return total, ext, owned
   378	
   379	
   380	if __name__ == "__main__":
   381	    if len(sys.argv) not in (3, 4) or sys.argv[1] not in ("x86_64", "aarch64"):
   382	        sys.exit("usage: stack_bound.py x86_64|aarch64 DISASM [--ranges]")
   383	    ARCH = sys.argv[1]
   384	    try:
