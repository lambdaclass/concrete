    69	    "${capped[@]}" timeout -k 10 300 "$gdb" -batch -nx -x "$root/scripts/checks/lib/stack_measure.py" \
    70	    "$1" 2>"$1.gdb.err" | awk '$1 == "measured" || $1 == "error" {print}' | cap_out || true
    71	}
    72	
    73	# stack_check NAME BACKEND EXE: derive the bound, measure a run where supported, record both.
    74	stack_check() {
    75	  local name=$1 backend=$2 exe=$3 dis="$3.dis" out bound ext m measured=not-run
    76	  if ! timeout -k 10 60 "${objdump[@]}" "$exe" >"$dis" 2>"$dis.err"; then
    77	    echo "FAIL $name [$backend] stack: disassembly failed: $(head -c 300 "$dis.err")"; fail=1; return
    78	  fi
    79	  if ! out=$(stack_bound "$arch" "$dis" --ranges | cap_out); then
    80	    echo "FAIL $name [$backend] stack: $out"; fail=1; return
    81	  fi
    82	  bound=$(awk '$1 == "bound" {print $2}' <<<"$out")
    83	  ext=$(awk '$1 == "external" {printf "%s%s@%s", sep, $2, $3; sep=","}' <<<"$out")
    84	  if [ -n "$gdb" ]; then
    85	    m=$(measure "$exe" "$out" "$(head -c 16 "$(dirname "$exe")/status")")
    86	    measured=$(awk '$1 == "measured" {print $2}' <<<"$m")
    87	    if [ -z "$measured" ] || ! within "$measured" "$bound"; then
    88	      echo "FAIL $name [$backend] stack: bound $bound, run: ${m:-no measurement} $(head -c 300 "$exe.gdb.err")"
    89	      fail=1; return
    90	    fi
    91	    last_exe=$exe last_analysis=$out
    92	  fi
    93	  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$backend" "$target" "$bound" "$measured" "$ext" >>"$stack"
    94	  echo "ok   $name [$backend] stack: bound $bound, measured $measured, externals ${ext:-none}"
    95	}
    96	
    97	size_report() { # size_report NAME BACKEND EXE
    98	  local bytes text
    99	  bytes=$(wc -c <"$3" | tr -d ' ')
   100	  text=$("${capped[@]}" timeout -k 10 60 "$CONCRETE_SLICE0_LLVM/llvm-size" "$3" 2>/dev/null |
   101	    awk 'NR == 2 {print $1}' | cap_out) || true
   102	  printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$target" "$bytes" "${text:-unavailable}" >>"$sizes"
   103	}
   104	
   105	names=$(emit_examples)
   106	mkdir -p "$work/ctl"
   107	for name in $names; do
   108	  d="$work/ex/$name"
