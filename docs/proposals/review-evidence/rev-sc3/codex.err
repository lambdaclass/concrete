#!/usr/bin/env python3
"""A lexer for the Lean sources of ConcreteSpec, shared by the proof-integrity checks.

`lex(src)` returns `src` with every comment (nested `/- -/`, `--`) blanked to spaces, newlines kept,
so offsets and line numbers are the source's. Everything else is kept, string literals included.
It follows Lean's literal forms, so no comment delimiter inside a literal starts a comment: a
string with its escapes, raw strings r"…" and r#"…"#, character literals and quoted names «…».
Whether a string interpolates depends on the parser, not the lexer, so interpolation is admitted
only directly after `s!`, `m!` or `f!` (its `{ }` code, with its own strings and comments, is
lexed recursively), and any other string holding `{` is an error. An unterminated string,
comment, interpolation or name is an error too, and so is a syntax quotation `(…) (whose comments are
syntax data; the library runs no meta code): the lexer fails closed, never skips.
`comment_spans(src)` gives the top-level comments (the owner view, scripts/spec/lean_site.py, takes
its doc blocks from them, so a doc comment inside an ordinary comment or a string is not one).

Commands (exit 3 when a source cannot be read or lexed):

  scan RE FILE...          `file:line: text` for every match of RE (over the whole lexed text,
                           reported at the line where it starts) and for every `import` outside
                           the header, which must be lines `import ConcreteSpec[.M…]`, one
                           module each, ended by a command at column 0
  examples SRC DST FILE... copies each FILE (a path relative to SRC) to DST with every `example`
                           command turned into `noncomputable def «⟪example⟫FILE:LINE»` (no space,
                           so listings split on spaces stay sound), so the kernel's view of it
                           stays in the environment; prints the count. Every
                           `example` token must start a line.
"""
import os, re, sys

EXAMPLE_MARK = "⟪example⟫"


class LexError(Exception):
    pass


def lex(src, spans=None, literals=True):
    """`src` with its comments blanked; when `spans` is a list, each top-level comment's
    (start, end) offsets are appended to it (a comment nested in another is part of that one).
    With `literals=False`, string, character and name literals are blanked too (code tokens only)."""
    n, out = len(src), []

    def emit(text, literal=False):
        if literal and not literals:
            text = "".join("\n" if ch == "\n" else " " for ch in text)
        out.append(text)

    def ident(i):                                     # src[i] continues an identifier
        return i >= 0 and (src[i].isalnum() or src[i] in "_'!?." or ord(src[i]) > 127)

    def comment(i):                                   # at "/-": blank to the matching "-/"
        start, depth = i, 0
        while i < n:
            if src.startswith("/-", i): depth += 1; out.append("  "); i += 2
            elif src.startswith("-/", i):
                depth -= 1; out.append("  "); i += 2
                if depth == 0:
                    if spans is not None: spans.append((start, i))
                    return i
            else: out.append("\n" if src[i] == "\n" else " "); i += 1
        raise LexError("unterminated comment")

    def string(i):                                    # at '"'
        interp = src[i - 2:i] in ("s!", "m!", "f!") and not ident(i - 3)
        emit('"', True); i += 1
        while i < n:
            c = src[i]
            if c == "\\": emit(src[i:i + 2], True); i += 2
            elif c == '"': emit(c, True); return i + 1
            elif c == "{" and interp: emit(c, True); i = code(i + 1, True)
            elif c == "{":
                line = src.count("\n", 0, i) + 1
                raise LexError(f"line {line}: a string holding '{{' without s!, m! or f! before it")
            else: emit(c, True); i += 1
        raise LexError("unterminated string")

    def raw(i):                                       # at 'r' of r#*"
        j = i + 1
        while j < n and src[j] == "#": j += 1
        close = '"' + "#" * (j - i - 1)
        k = src.find(close, j + 1)
        if k < 0: raise LexError("unterminated raw string")
        emit(src[i:k + len(close)], True); return k + len(close)

    def code(i, inner):                               # inner: inside an interpolation, stop at its '}'
        depth = 0
        while i < n:
            c = src[i]
            if src.startswith("/-", i): i = comment(i)
            elif src.startswith("--", i):
                j = src.find("\n", i); j = n if j < 0 else j; out.append(" " * (j - i)); i = j
            elif c == '"': i = string(i)
            elif c == "«":                            # a quoted name part: no comment inside it
                k = src.find("»", i + 1)
                if k < 0: raise LexError("unterminated «name»")
                emit(src[i:k + 1], True); i = k + 1
            elif src.startswith("`(", i) or src.startswith("``(", i):
                # A syntax quotation: its comments are syntax data, not comments of the source,
                # and the library runs no meta code, so the lexer refuses it.
                raise LexError(f"line {src.count(chr(10), 0, i) + 1}: a syntax quotation")
            elif c == "r" and not ident(i - 1) and re.match(r'r#*"', src[i:]): i = raw(i)
            elif c == "'" and not ident(i - 1):
                m = re.match(r"'(\\(x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|.)|[^\\'\n])'", src[i:])
                k = len(m.group(0)) if m else 1
                emit(src[i:i + k], m is not None); i += k
            elif inner and c == "{": depth += 1; out.append(c); i += 1
            elif inner and c == "}":
                out.append(c); i += 1
                if depth == 0: return i
                depth -= 1
            else: out.append(c); i += 1
        if inner: raise LexError("unterminated interpolation")
        return i

    code(0, False)
    return "".join(out)


def comment_spans(src):
    """The (start, end) offsets of every top-level comment of `src`, in order."""
    spans = []
    lex(src, spans)
    return spans


HEADER = re.compile(r"import ConcreteSpec(\.[A-Za-z0-9_]+)*\s*$")
FIRST_COMMAND = re.compile(r"(namespace|open|section|def|theorem|structure|inductive|abbrev)\b")


def scan(pattern, paths):
    word, rc = re.compile(pattern, re.M), 0
    for path in paths:
        try:
            text = lex(open(path, encoding="utf-8").read())
        except (OSError, UnicodeDecodeError, LexError) as e:
            print(f"error: {path}: {e}", file=sys.stderr); rc = 3; continue
        lines = text.split("\n")
        # Lean lets an import list continue (`import A B`, or B on the next line), so the first
        # line after the header must be a command at column 0.
        k = 0
        while k < len(lines) and (not lines[k].strip() or HEADER.match(lines[k])): k += 1
        if k < len(lines) and not FIRST_COMMAND.match(lines[k]):
            print(f"{path}:{k + 1}: {lines[k].strip()} (the import header must end in a command at column 0)")
        hits = {text.count("\n", 0, m.start()) + 1 for m in word.finditer(text)}
        hits |= {j for j, line in enumerate(lines, 1)
                 if re.search(r"\bimport\b", line) and not (j <= k and HEADER.match(line))}
        for j in sorted(hits):
            print(f"{path}:{j}: {lines[j - 1].strip()}")
    return rc


# `example` as a command token: not part of a longer identifier (`example'`, `my.example`, `examples`)
EXAMPLE = re.compile(r"(?<![\w.'!?])example(?![\w'!?])")


def count_examples(src):
    """The number of `example` commands in a source (code tokens only, not literal contents)."""
    return len(EXAMPLE.findall(lex(src, literals=False)))


def examples(src_dir, dst_dir, paths):
    count = 0
    for rel in paths:
        src = open(os.path.join(src_dir, rel), encoding="utf-8").read()
        text = lex(src, literals=False)          # an `example` inside a literal is not a command
        out, last = [], 0
        for m in EXAMPLE.finditer(text):
            line = text.count("\n", 0, m.start()) + 1
            if m.start() > 0 and text[m.start() - 1] != "\n":
                raise LexError(f"{rel}:{line}: an `example` that does not start its line")
            out.append(src[last:m.start()])
            out.append(f"noncomputable def «{EXAMPLE_MARK}{rel}:{line}»")
            last = m.end(); count += 1
        out.append(src[last:])
        dst = os.path.join(dst_dir, rel)
        os.makedirs(os.path.dirname(dst) or ".", exist_ok=True)
        open(dst, "w", encoding="utf-8").write("".join(out))
    print(count)


if __name__ == "__main__":
    try:
        if sys.argv[1] == "scan":
            sys.exit(scan(sys.argv[2], sys.argv[3:]))
        if sys.argv[1] == "examples":
            examples(sys.argv[2], sys.argv[3], sys.argv[4:]); sys.exit(0)
    except (OSError, UnicodeDecodeError, LexError) as e:
        print(f"error: {e}", file=sys.stderr); sys.exit(3)
    print(f"usage: {sys.argv[0]} scan RE FILE... | examples SRC DST FILE...", file=sys.stderr)
    sys.exit(2)
#!/usr/bin/env bash
# THE RULE GATE: every registered rule (ConcreteSpec/Spec/Rules.lean) is documented, cites the
# decision row it implements, and has an example it accepts and one it refuses; every rule citation
# in the specification names a registered rule. The checks are scripts/spec/rules.py; the
# registry is read from the built environment by scripts/spec/rules.lean.
#
# NEGATIVE CONTROLS run the same checker on small fixtures and require each failure: a rule with no
# refused or no accepted example, no doc comment, a doc citing no decision row or one no inventory
# holds, one registered twice, one naming no declaration, revision 0, a citation of an unregistered
# rule (a quoted name too), a verdict outside an example's doc comment or in a nested comment, one
# example claiming both verdicts, a truncated listing, an unlexable source, a missing or empty
# source directory, and a checker that hangs through both bounded attempts. Fixtures that satisfy
# every check must pass (the positive controls, attributed and modified examples included).
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../checks/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"
CHECK_NAME=SPEC-RULES
PASS=0; FAIL=0
ok(){ echo "  ok   $1"; PASS=$((PASS+1)); }
no(){ echo "  FAIL $1"; FAIL=$((FAIL+1)); }
finish(){ echo "$CHECK_NAME: PASS=$PASS FAIL=$FAIL"; [ "$FAIL" = 0 ] && exit 0 || exit 1; }
TMP="$(mktemp -d)" || { echo "FATAL: mktemp failed" >&2; exit 2; }
trap 'rm -rf "$TMP"' EXIT
export LC_ALL=C
BOUNDED_PARENT="$TMP"; source scripts/checks/lib/bounded.sh || exit 2
# run_bounded BUDGET CMD... → CMD's output and status, bounded: a second timeout is INCOMPLETE,
# status 2, which no check below accepts
run_bounded() {
  local out rc budget="$1"; shift
  out="$(bounded_run -i /dev/null -r "$budget" "$budget" -- "$@" 2>&1)"; rc=$?
  if bounded_is_incomplete "$rc"; then echo "error: $CHECK_NAME: timed out twice (INCOMPLETE)" >&2; return 2; fi
  printf '%s\n' "$out"; return "$rc"
}
# check BUDGET RULES-JSONL SRC-DIR ROWS... → the checker
check() { local b="$1"; shift; run_bounded "$b" python3 -I scripts/spec/rules.py "$@"; }

command -v lake >/dev/null || { echo "error: $CHECK_NAME needs Lean's lake on PATH (elan)" >&2; exit 2; }
bounded_run -i /dev/null -r 3600 3600 -- lake build ConcreteSpec > "$TMP/build.log" 2>&1 \
  || { tail -20 "$TMP/build.log" >&2; bounded_summary >&2; echo "error: $CHECK_NAME: lake build ConcreteSpec failed or timed out" >&2; exit 2; }

echo "=== the specification ==="
bounded_run -i /dev/null 600 -- lake env lean scripts/spec/rules.lean > "$TMP/rules.jsonl" 2> "$TMP/rules.err" \
  || { cat "$TMP/rules.err" >&2; bounded_summary >&2; echo "error: scripts/spec/rules.lean failed or timed out" >&2; exit 2; }
OUT=$(check 120 "$TMP/rules.jsonl" ConcreteSpec docs/decisions.md ROADMAP.md); RC=$?
echo "$OUT"
[ "$RC" = 0 ] && ok "the registry and every rule citation of ConcreteSpec" || no "the specification (rc=$RC)"

echo "=== negative controls ==="
# fixture NAME RULES-JSONL SOURCE → runs the checker on them, sets OUT and RC
fixture() {
  mkdir -p "$TMP/$1"; printf '%s\n' "$2" > "$TMP/$1.jsonl"; printf '%s\n' "$3" > "$TMP/$1/A.lean"
  OUT=$(check 60 "$TMP/$1.jsonl" "$TMP/$1" "$TMP/rows.md"); RC=$?
}
printf -- '- **Q9.1** A decided row.\nR-0001 is only mentioned here.\n' > "$TMP/rows.md"
END='{"end":true}'
GOOD='{"name":"R.ok","rev":1,"exists":true,"doc":"The rule (Q9.1)."}'
EXA='/-- Accepted (rule `R.ok`). -/
example : True := trivial

/-- Refused (rule `R.ok`). -/
example : True := trivial'
fixture good "$GOOD
$END" "$EXA"
[ "$RC" = 0 ] && ok "control: a documented rule with both examples passes" || no "control: the good fixture failed: $OUT"
192:- **Q1.1** What is an allocator brand? — Separate erased `Brand` kind.
193:- **Q1.2** How are fresh brands introduced, including loop resets? — Generative binders; existential loop state.
194:- **Q1.3** How are packages formed and opened? — Explicit pack; lexical unpack; repackage escapes.
195:- **Q1.4** How are brands compared and supplied? — Nominal brand equality; explicit brand arguments.
196:- **Q1.5** How are allocator dependencies tracked across calls? — Structural dependencies; checked interface summaries.
197:- **Q1.6** Who owns a child allocator’s backing? — Child owns backing; parent brand exposed in type. *Revises or adds: Clarify/extend allocator interface.*
198:- **Q1.7** Where does release information live? — Stable release state and raw context; no safe references.
199:- **Q1.8** What if creating allocator state fails? — Fallible allocator construction conserving surviving inputs.
200:- **Q1.9** What do allocation failures contain? — `AllocFailure<T>` returns rejected `T`; operation-specific recovery.
201:- **Q1.10** Are capacity and addresses observable? — Observable capacity; explicit raw-address exposure.
202:- **Q1.11** What does “unchanged” require of allocator state? — Availability predicate plus four laws: progress, unchanged state on failure, release never reduces availability, a concrete success witness.
203:- **Q1.12** What rolls back around callbacks? — No rollback of callback effects; every element accounted for in a typed result.
204:- **Q1.13** Can resetting the system allocator return `Allocator<Sys>` again? — Fresh brand after any supported system reset.
205:- **Q2.1** Are storage release, destruction and resource cleanup separate? — Separate storage release, destruction and resource cleanup.
206:- **Q2.2** Which containers implement `Destroy`? — Exactly sixteen named Destroy impls: Array (T: Destroy); Heap, HeapArray and Vec (two each: T: Copy; T: Destroy); String (unconditional); Option (T: Destroy); Result (three: T: Destroy/E: Copy, T: Destroy/E: Destroy, T: Copy/E: Destroy); OrderedMap (four: each of K and V Copy or Destroy). HashMap excluded. <a id="q2-2-revision"></a>Revised 2026-11-06 by [information flow](#decided-project-infoflow-2026-11-06): `Secret<T>` is `Copy` only for scalar `T`; secret arrays and heap secrets are linear and their destruction wipes them.
207:- **Q2.3** In what order are contents destroyed? — Index order 0..len−1, then the backing; OrderedMap in ascending key order, key then value, then the nodes.
208:- **Q2.4** How does a container of non-`Destroy` resources release its storage? — `drain(v, ctx, f)` with `f: fn(&mut C, T) with(K) -> Step<T, E>`; the only way to empty a container of non-Destroy elements.
209:- **Q2.5** What happens when drain processing fails? — On Stop, `Drained { at, survivor, rest, err }`; `map_into` returns `Stopped { done, survivor, rest, err }`.
210:- **Q2.6** Must `destroy` terminate and avoid traps? — Ordinary partial correctness; prove stronger guarantees separately.
211:- **Q2.7** Does user destruction have special execution semantics? — Ordinary consuming checked `destroy`; at most `Alloc`.
212:- **Q2.8** How is 'Copy or Destroy' written for container impls? — (a) separate impls for every admitted combination of Copy/Destroy payload bounds, no disjunctive-bound syntax: two each for Heap, HeapArray and Vec, three for Result, four for OrderedMap; coherence may use Copy/Destroy disjointness. *Revises or adds: TRAIT-1@1 (under OD6): equal generic impl heads allowed only when Copy/Destroy disjointness makes their domains disjoint; all other coherence and orphan rules unchanged. Option (b) would also add new bound syntax.*
213:- **Q3.1** What does opening a heap array produce? — Second-class shared/mutable array views; no element references.
214:- **Q3.2** How are views passed and lent? — Downward parameters; mutable lending freezes origin.
215:- **Q3.3** What is a view’s root identity? — Original owner identity plus projection path.
216:- **Q3.4** Which view accesses conflict? — Existing whole-root conflict rules.
217:- **Q3.5** What is the index type? — `u64` lengths/indices across profiles; checked target limits.
218:- **Q3.6** How are nested linear elements traversed without substitutes? — `drain` / `map_into` for consuming traversal; `swap_at(v, i, x) -> T` for in-place replacement.
219:- **Q3.7** What is the raw-memory model and validity taxonomy? — Blocks with provenance; pointer = (prov: Option<BlockId>, addr: u64); integers carry no provenance; every access needs explicit validity premises.
220:- **Q3.8** How do zero-sized elements behave? — Zero-sized slots own their obligations; they occupy no bytes and may share addresses.
221:- **Q3.9** What do pointer equality and integer round trips mean? — `expose` records the block; `from_exposed` picks in-bounds, then one-past, else no provenance.
222:- **Q3.10** What happens when address space runs out? — A collision means overlapping occupied bytes; address exhaustion is part of Avail.
223:- **Q3.11** How are typed values related to raw bytes? — Structured values and raw store joined by `Rep`.
224:- **Q3.12** How are extern pointer parameters marked, and how does C keep memory past the call? — (a) `kept` parameter marker; `Kept<H>` receipt ended only by the paired extern. *Revises or adds: New design + spelling: owner decision.*
225:- **Q4.1** What is a literal’s type? — Copy `StaticStr`; explicit fallible dynamic conversion.
226:- **Q4.2** Which encoding and NUL policy apply? — UTF-8 including embedded NUL.

