7:#   train.sh [--dry-run] check  <name> [--no-remote] [--no-review] [--local-gates]
25:#   * (2026-11-06) review fails closed: `check` with no review command fails rather than skipping the
26:#     leg, and a train lands only with review provenance (review_provenance: a verified clean review
458:# The review command: LAND_REVIEW_CMD, else scripts/review/review.sh, called with --base --head.
460:review_cmd() {
462:  elif [ -f scripts/review/review.sh ]; then echo "bash scripts/review/review.sh"; fi
466:# REVIEW PROVENANCE (fail closed; docs/LANDING.md, "check" and "land"). A train is reviewed when its
467:# head carries a clean review note, or when its head carries no review note and every member carries
468:# one at its exact recorded SHA (each member was reviewed at its own head: a train
469:# built or rebuilt from reviewed branches). Every note is judged by scripts/review/verify.sh, on
476:# refs/owner-signoff/*, fetched first): the member reached the review cap of its diff's class and all
477:# three reviewers accepted that commit.
482:VERIFY="$SELF_DIR/../review/verify.sh"
507:review_provenance() { # name head
509:  [ -f "$VERIFY" ] || { echo "no review verifier ($VERIFY is missing)"; return 1; }
510:  git fetch -q "$REMOTE" "+refs/notes/concrete-review:refs/notes/concrete-review" 2>/dev/null \
511:    || { echo "could not fetch refs/notes/concrete-review from $REMOTE"; return 1; }
512:  if out="$(bash "$VERIFY" "$head" 2>&1)"; then echo "the head ${head:0:10} carries a clean review note"; return 0; fi
513:  if git notes --ref=refs/notes/concrete-review show "$head" >/dev/null 2>&1; then
514:    echo "the head's review note does not qualify: ${out//$'\n'/ }"; return 1
525:  [ "$n" -gt 0 ] || { echo "the head ${head:0:10} has no review note and the train records no members"; return 1; }
526:  [ -z "$bad" ] || { echo "the head ${head:0:10} has no review note, and not every member has a clean one or an owner sign-off$bad"; return 1; }
530:    echo "the head has no review note; every member ($n) carries a clean one or an owner sign-off ($signed) at its exact SHA, and the head is their clean merge"
533:  echo "the head has no review note; every member ($n) carries a clean one at its exact SHA"
536:# Codex review leg. It passes without running the reviewer when the train already has review
537:# provenance. Otherwise it runs the review command; a non-zero exit fails, and so does a zero exit
538:# that leaves no provenance (no note, or a malformed, blocked or findings note at the head).
539:review_leg() { # name base head
541:  if why="$(review_provenance "$1" "$3")"; then echo "review: $why; not reviewed again"; return 0; fi
542:  echo "review: $why; running the reviewer"
543:  bash -c "$(review_cmd) --base $2 --head $3" || return $?
544:  why="$(review_provenance "$1" "$3")" || { echo "review: the reviewer exited 0, but $why"; return 1; }
545:  echo "review: $why"
549:  local name="" remote=1 review=1 local_gates=0
553:      --no-review) review=0 ;;
566:  if [ "$review" = 1 ] && [ -z "$(review_cmd)" ]; then
567:    log_row "$name" check failed "no review command"
568:    die "check: no review command (LAND_REVIEW_CMD is unset and scripts/review/review.sh is missing); the review leg is required and is never skipped silently. Restore the reviewer, or pass --no-review explicitly (land still requires review provenance)"
581:  # Codex review. Any failing leg fails the check.
585:    if [ "$review" = 1 ]; then note "(dry-run)   + review: the train's review provenance, else $(review_cmd) --base $base --head $head"; fi
593:  if [ "$review" = 1 ]; then legs_start review "$dir/review.log" review_leg "$name" "$base" "$head"; fi
605:  local verdict; verdict="$([ -z "$LEGS_FAILED" ] && echo passed || echo failed)"
606:  if [ -n "$ghost" ] && [ "$impact_rc" = 3 ]; then verdict=incomplete; fi
607:  log_row "$name" check-legs "$verdict" "$LEGS_REPORT wall=${wall}s sum=${LEGS_SUM}s"
610:    log_row "$name" check passed "impact $impact_where$([ "$remote" = 1 ] && echo ' + remote')$([ "$review" = 1 ] && echo ' + review')"
612:  elif [ "$verdict" = incomplete ]; then
708:# conclusion is not success, is no verdict. GitHub branch protection is not configured for main, so
759:  # The verdict must describe THIS train: its exact head, with a non-empty landing tier. Otherwise
760:  # it is no verdict (bisect --ci consumes this exit status).
778:    echo "train: run $id does not satisfy $REQUIRED_FILE; a missing, skipped or cancelled required job is no verdict:" >&2
804:  # failed only when a landing job failed; otherwise (cancelled, skipped, pending) it is no verdict.
899:# tree, and a tree is exactly what lands. A different tree, a different base or any other verdict is
901:#   utc  verdict  train_head  train_head_tree  base  ref  name
902:# A row that is not exactly that (7 fields, verdict accepted|failed|incomplete, 40-hex ids) is a
908:# land has it. A candidate that edits train.sh changes the land path for every later land; review
909:# must keep require_rehearsal on it. Nothing here defends against a reviewed change that removes it.
935:    [ -z "$bad" ] || die "land: $REHEARSALS line $bad is not a rehearsal row (utc verdict head tree base ref name); fix or remove the record"
1030:  # Review provenance, read now and not trusted from `check`: a check run with --no-review, or a
1031:  # reviewer that wrote no clean note, leaves none, and nothing lands without it.
1033:  if ! prov="$(review_provenance "$name" "$head")"; then
1034:    log_row "$name" land refused "no review provenance"
1035:    die "land: ${head:0:10} has no review provenance: $prov. Review the train head (scripts/review/review.sh --head ${head:0:10}) or its members, then land."
1037:  note "review provenance: $prov"
1125:  local step=0 half verdict
1129:    verdict="$(subset_red "$name-b$step" "$test" "${first[@]}")"
1130:    note "step $step: first half [$(printf '%s ' "${first[@]%@*}")] -> $verdict"
1131:    case "$verdict" in
1137:  verdict="$(subset_red "$name-bc" "$test" "$culprit")"
1141:  log_row "$name" bisect "$([ "$verdict" = green ] && echo inconclusive || echo attributed)" "culprit $culprit alone: $verdict"
1143:  note "culprit: ${culprit%@*} (${culprit##*@}) — alone it is $verdict"
1144:  [ "$verdict" = green ] && note "it is green ALONE: the failure is an interaction between members; check it by hand"

exec
