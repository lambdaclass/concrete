     1	#!/usr/bin/env bash
     2	# R-0544 — does a commit carry a clean review verdict? See docs/REVIEW.md.
     3	#
     4	#   scripts/review/verify.sh [--fetch] <commit>
     5	#
     6	# Reads the git note that scripts/review/review.sh wrote on <commit> under
     7	# refs/notes/concrete-review. The verdict counts only for that exact commit: a
     8	# clean note on an ancestor says nothing about the commits after it.
     9	#
    10	#   --fetch  first fetch refs/notes/concrete-review from $REVIEW_REMOTE (default
    11	#            origin), replacing the local copy (a reader, not a writer).
    12	#
    13	# Exit codes: 0 clean; 1 reviewed, not clean (findings or blocked);
    14	#             2 no note, a malformed note, or a usage error.
    15	
    16	set -euo pipefail
    17	
    18	NOTES_REF="refs/notes/concrete-review"
    19	REMOTE="${REVIEW_REMOTE:-origin}"
    20	FETCH=0
    21	if [ "${1:-}" = --fetch ]; then FETCH=1; shift; fi
    22	[ $# -eq 1 ] || { echo "usage: verify.sh [--fetch] <commit>" >&2; exit 2; }
    23	
    24	if [ "$FETCH" = 1 ]; then
    25	  git fetch -q "$REMOTE" "+$NOTES_REF:$NOTES_REF" \
    26	    || { echo "verify: could not fetch $NOTES_REF from $REMOTE" >&2; exit 2; }
    27	fi
    28	
    29	SHA="$(git rev-parse -q --verify "$1^{commit}")" || { echo "verify: not a commit: $1" >&2; exit 2; }
    30	NOTE="$(git notes --ref="$NOTES_REF" show "$SHA" 2>/dev/null)" || {
    31	  echo "$SHA unreviewed: no note under $NOTES_REF"
    32	  exit 2
    33	}
    34	
    35	# The note must carry each of the six fields review.sh writes exactly once, each well formed. Any
    36	# other key, a repeated key, or a line that is not `key: value` makes the note malformed. Keys are
    37	# matched by name, not position, because notes.sh `put` appends `utc` last.
    38	malformed() {
    39	  echo "$SHA malformed review note${1:+ ($1)}:"
    40	  printf '%s\n' "$NOTE" | sed 's/^/  /'
    41	  exit 2
    42	}
    43	# Plain variables F_<key>, not an associative array: macOS /bin/bash is 3.2.
    44	SEEN=" "
    45	while IFS= read -r line; do
    46	  [[ "$line" =~ ^([a-z-]+):\ (.*)$ ]] || malformed "not key: value: '$line'"
    47	  k="${BASH_REMATCH[1]}" v="${BASH_REMATCH[2]}"
    48	  case "$SEEN" in *" $k "*) malformed "repeated key $k" ;; esac
    49	  SEEN="$SEEN$k "
    50	  printf -v "F_${k//-/_}" '%s' "$v"
    51	  case "$k" in
    52	    verdict)      [[ "$v" =~ ^(clean|findings|blocked)$ ]] ;;
    53	    rounds)       [[ "$v" =~ ^[1-9][0-9]*$ ]] ;;
    54	    reviewer)     [[ "$v" =~ ^[^[:space:]]+$ ]] ;;
    55	    utc)          [[ "$v" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] ;;
    56	    base)         [[ "$v" =~ ^[0-9a-f]{40}$ ]] ;;
    57	    pieces)       [[ "$v" =~ ^[0-9]+$ ]] ;;
    58	    *)            false ;;
    59	  esac || malformed "bad $k"
    60	done <<< "$NOTE"
    61	for k in verdict rounds reviewer utc base pieces; do
    62	  case "$SEEN" in *" $k "*) ;; *) malformed "missing $k" ;; esac
    63	done
    64	
    65	field() { local n="F_${1//-/_}"; printf '%s' "${!n:-}"; }
    66	VERDICT="$(field verdict)"
    67	echo "$SHA $VERDICT (round $(field rounds), reviewer $(field reviewer), $(field utc), base $(field base), $(field pieces) piece(s))"
    68	[ "$VERDICT" = clean ] && exit 0
    69	exit 1
