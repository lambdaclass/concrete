   286	run_one() {
   287	  local kind="$1" piece="$2" label="$3" group="$4" paths="$5" rc=0 msg last
   288	  RUN_N=$((RUN_N + 1))
   289	  local out="$WORK/out.$RUN_N.txt" log="$WORK/log.$RUN_N.txt"
   290	  : >"$out"
   291	  # GIT_OPTIONAL_LOCKS=0 (bug 209): the reviewer runs git in the caller's worktree, and its sandbox
   292	  # does not stop `git status` from taking .git's index.lock to refresh the index. A command it
   293	  # stops mid-refresh left that lock behind, 0 bytes, and the next commit in the worktree failed.
   294	  # Without optional locks a status reads the index and writes nothing.
   295	  GIT_OPTIONAL_LOCKS=0 "$CODEX_BIN" exec --sandbox read-only --ephemeral --color never -C "$ROOT" -o "$out" \
   296	    "$(prompt_for "$kind" "$label" "$group" "$paths")" <"$piece" >"$log" 2>&1 || rc=$?
   297	  msg="$(cat "$out")"
   298	  [ -n "$msg" ] || [ "$rc" -ne 0 ] || msg="$(cat "$log")"
   299	  LAST_BODY="$msg"
   300	  last="$(printf '%s\n' "$msg" | sed -e 's/[`*]//g' -e 's/[[:space:]]*$//' | awk 'NF { l = $0 } END { print l }')"
   301	  if [ "$rc" -eq 0 ] && [ "$last" = "VERDICT: clean" ]; then LAST_RESULT=clean
   302	  elif [ "$rc" -eq 0 ] && [ "$last" = "VERDICT: findings" ]; then LAST_RESULT=findings
   303	  elif { printf '%s\n' "$msg"; cat "$log"; } | has_match -iE "$REFUSAL_RE"; then LAST_RESULT=refused
   304	  elif [ "$rc" -ne 0 ]; then
