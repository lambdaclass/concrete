   306	    LAST_BODY="$msg
   307	(reviewer exited $rc; last lines of its log:)
   308	$(tail -n 20 "$log")"
   309	  else LAST_RESULT=noverdict
   310	  fi
   311	}
   312	
   313	RAW_DIR="$ROOT/.review"
   314	mkdir -p "$RAW_DIR"
   315	RAW="$RAW_DIR/$HEAD_SHA-$ROUND.md"
   316	UTC="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
   317	{
   318	  echo "# review of $HEAD_SHA, round $ROUND"
   319	  echo
   320	  echo "reviewer: $REVIEWER; utc: $UTC; base: $BASE_SHA; diff from: $FROM; pieces: $K; diff bytes: $TOTAL"
   321	} >"$RAW"
   322	
   323	N_FINDINGS=0 N_BLOCKED=0
   324	FINDINGS_TEXT=""
   325	i=0
   326	while IFS=$'\t' read -r name group bytes paths; do
   327	  i=$((i + 1))
   328	  label="piece $i of $K"
   329	  echo "review: round $ROUND, $label ($group, $bytes bytes)" >&2
   330	  run_one standard "$WORK/pieces/$name" "$label" "$group" "$paths"
   331	  result="$LAST_RESULT" body="$LAST_BODY"
   332	  {
   333	    echo; echo "## $label: $group ($bytes bytes): $result"; echo; echo "files: $paths"; echo
   334	    echo "$body"
   335	  } >>"$RAW"
   336	  if [ "$result" = refused ] || [ "$result" = noverdict ] || [ "$result" = error ]; then
   337	    # Retry once: smaller pieces (the piece halved) and a more neutral prompt.
   338	    half_dir="$WORK/half-$i"
   339	    half_limit=$(( (bytes + 1) / 2 ))
   340	    python3 "$SCRIPT_DIR/split_diff.py" "$WORK/pieces/$name" "$half_dir" "$half_limit" --no-groups >/dev/null
   341	    result=clean body=""
   342	    j=0
   343	    while IFS=$'\t' read -r hname _hgroup hbytes hpaths; do
   344	      j=$((j + 1))
   345	      hlabel="part $j of piece $i of $K"
   346	      echo "review: retrying $hlabel with a neutral prompt ($hbytes bytes)" >&2
   347	      run_one neutral "$half_dir/$hname" "$hlabel" "$group" "$hpaths"
   348	      { echo; echo "### retry, $hlabel ($hbytes bytes): $LAST_RESULT"; echo; echo "$LAST_BODY"; } >>"$RAW"
   349	      case "$LAST_RESULT" in
   350	        clean) ;;
   351	        findings) [ "$result" = blocked ] || result=findings; body="$body
   352	$LAST_BODY" ;;
   353	        *) result=blocked ;;
   354	      esac
   355	    done <"$half_dir/manifest.tsv"
   356	  fi
   357	  stripped="$(printf '%s\n' "$body" | grep -vE '^[`*[:space:]]*VERDICT:' || true)"
   358	  case "$result" in
   359	    findings)
   360	      N_FINDINGS=$((N_FINDINGS + 1))
   361	      FINDINGS_TEXT="$FINDINGS_TEXT
   362	[$label: $group]
   363	$stripped"
   364	      ;;
   365	    blocked)
   366	      N_BLOCKED=$((N_BLOCKED + 1))
   367	      FINDINGS_TEXT="$FINDINGS_TEXT
   368	[$label: $group] blocked: the reviewer refused or gave no verdict, also after one neutral retry. Files: $paths
   369	$stripped"
   370	      ;;
   371	  esac
   372	done <"$WORK/pieces/manifest.tsv"
   373	
   374	# `blocked` wins over `findings`: a round with a blocked piece did not review all
   375	# of its diff, and only a `blocked` verdict keeps the next round's delta from
   376	# starting after it. The findings of the pieces that were reviewed are still
   377	# recorded and carried forward.
   378	if [ "$N_BLOCKED" -gt 0 ]; then VERDICT=blocked
   379	elif [ "$N_FINDINGS" -gt 0 ]; then VERDICT=findings
   380	else VERDICT=clean
   381	fi
   382	{ echo; echo "## verdict: $VERDICT ($N_FINDINGS piece(s) with findings, $N_BLOCKED blocked)"; } >>"$RAW"
   383	
   384	# ---------------------------------------------------------------- record
   385	# THE NOTE FORMAT IS AN INTERFACE: scripts/review/verify.sh parses it (train.sh's review leg reads
   386	# it through verify.sh). Change it only together with verify.sh.
   387	cat >"$WORK/note" <<EOF
   388	verdict: $VERDICT
   389	rounds: $ROUND
   390	reviewer: $REVIEWER
   391	utc: $UTC
   392	base: $BASE_SHA
   393	pieces: $K
   394	EOF
   395	git notes --ref="$NOTES_REF" add -f -F "$WORK/note" "$HEAD_SHA"
   396	if [ "$VERDICT" = blocked ] && [ -n "$PREV_FINDINGS" ]; then
   397	  # A blocked round cannot resolve the findings it was given: some code went
   398	  # unreviewed. Record them with this round's own, so a later round (even after
   399	  # several blocked rounds in a row, or a re-run on the same HEAD) still gets them.
   400	  FINDINGS_TEXT="$FINDINGS_TEXT
   401	[carried from earlier rounds; not confirmed resolved, because this round was blocked]
   402	$PREV_FINDINGS"
   403	fi
   404	if [ "$VERDICT" != clean ]; then
   405	  printf '%s\n' "${FINDINGS_TEXT#$'\n'}" >"$WORK/findings"
   406	  git notes --ref="$FINDINGS_REF" add -f -F "$WORK/findings" "$HEAD_SHA"
   407	fi
   408	
   409	echo "review: round $ROUND verdict $VERDICT ($K piece(s)); raw output: ${RAW#$ROOT/}"
   410	[ "$VERDICT" = clean ] || printf '%s\n' "${FINDINGS_TEXT#$'\n'}"
   411	
   412	if ! push_notes; then
   413	  echo "review: the result is recorded locally but $NOTES_REF could not be pushed to $REMOTE." >&2
   414	  echo "review: push it by hand: git push $REMOTE $NOTES_REF" >&2
   415	  exit 6
   416	fi
   417	
   418	case "$VERDICT" in
   419	  clean) exit 0 ;;
   420	  findings|blocked)
   421	    if [ "$ROUND" -ge "$MAX_ROUNDS" ]; then
   422	      cap_message "$ROUND" "${FINDINGS_TEXT#$'\n'}"
   423	      exit 3
   424	    fi
   425	    [ "$VERDICT" = findings ] && exit 1
   426	    exit 5
   427	    ;;
   428	esac

exec
