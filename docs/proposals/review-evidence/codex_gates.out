   319	                        deepest = max(deepest, d + ret_push + sub_deep)
   320	                        add_ext(ext, sub_ext, d + ret_push)
   321	                    elif base in stubs or base.endswith("@plt"):
   322	                        # ELF `write@plt`; Mach-O stubs carry one extra leading underscore.
   323	                        name = base.removesuffix("@plt") if base.endswith("@plt") else base[1:]
   324	                        add_ext(ext, {name: 0}, d + ret_push)
   325	                        deepest = max(deepest, d + ret_push)
