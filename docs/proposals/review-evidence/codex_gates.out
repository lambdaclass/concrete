   292	                kind, arg = control(mn, ops)
   293	                if kind is None:
   294	                    touched = access(mn, ops, d, fp)
   295	                    if touched is not None:
   296	                        deepest = max(deepest, touched)
   297	                    d, fp = step(mn, ops, d, fp)
   298	                    if d < 0:
   299	                        raise Refuse(f"{key}+{addr:#x}: stack above the entry")
   300	                    deepest = max(deepest, d)
   301	                    i += 1
   302	                    continue
   303	                if kind == "indirect":
   304	                    raise Refuse(f"{key}+{addr:#x}: indirect branch {mn} {ops}")
   305	                if kind == "ret":
   306	                    if d != 0:
