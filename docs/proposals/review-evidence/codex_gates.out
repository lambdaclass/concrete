   261	    ret_push = 8 if ARCH == "x86_64" else 0
   262	    step = x86_step if ARCH == "x86_64" else a64_step
   263	    access = x86_access if ARCH == "x86_64" else a64_access
   264	
   265	    def add_ext(ext, sub, base):
   266	        for name, depth in sub.items():
   267	            ext[name] = max(ext.get(name, 0), base + depth)
   268	
   269	    def fn_bound(key):
   270	        """(deepest, externals) of owned function `key`, relative to its own entry."""
   271	        if key in memo:
   272	            return memo[key]
