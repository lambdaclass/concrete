   327	                            break
   328	                    else:
   329	                        raise Refuse(f"{key}+{addr:#x}: call to {sym}, neither owned nor a stub")
   330	                    i += 1
   331	                    continue
   332	                if tgt not in index:
   333	                    raise Refuse(f"{key}+{addr:#x}: branch leaves the function: {mn} {ops}")
   334	                if kind == "jmp":
   335	                    i = index[tgt]
   336	                    continue
   337	                work.append((index[tgt], d, fp))
   338	                i += 1
   339	        active.discard(key)
   340	        memo[key] = (deepest, ext)
   341	        return memo[key]
   342	
   343	    total, ext = fn_bound("main")
   344	    return total, ext, owned
   345	
   346	
   347	if __name__ == "__main__":
   348	    if len(sys.argv) not in (3, 4) or sys.argv[1] not in ("x86_64", "aarch64"):
   349	        sys.exit("usage: stack_bound.py x86_64|aarch64 DISASM [--ranges]")
