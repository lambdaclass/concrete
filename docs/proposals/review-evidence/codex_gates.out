   182	
   183	
   184	def a64_step(mn, ops, d, fp):
   185	    """New (d, fp) after a non-control AArch64 instruction."""
   186	    args = [a.strip() for a in re.split(r",(?![^\[]*\])", ops)] if ops else []
   187	    dst = args[0] if args else ""
   188	    m = SPWB_PRE.search(ops)
   189	    if m:
   190	        d = d - (imm(m.group(1)) if m.group(1) else 0)
   191	    m = SPWB_POST.search(ops)
   192	    if m:
   193	        d = d - imm(m.group(1))
   194	    if SPWB_PRE.search(ops) or SPWB_POST.search(ops):
   195	        return d, (None if "x29" in args[:2] and mn.startswith("ld") else fp)
   196	    if dst in ("sp", "wsp"):
   197	        if mn in ("sub", "add") and len(args) == 3 and args[1] == "sp":
   198	            n = imm(args[2])
   199	            return (d + n if mn == "sub" else d - n), fp
   200	        if mn == "mov" and args[1:] == ["x29"]:
   201	            if fp is None:
   202	                raise Refuse("mov sp, x29 with an unknown frame pointer")
   203	            return fp, fp
   204	        if mn in ("sub", "add") and len(args) == 3 and args[1] == "x29":
   205	            if fp is None:
   206	                raise Refuse("sp from an unknown frame pointer")
   207	            n = imm(args[2])
   208	            return (fp + n if mn == "sub" else fp - n), fp
   209	        raise Refuse(f"unmodelled stack-pointer write: {mn} {ops}")
   210	    if dst in ("x29", "w29"):
   211	        if mn == "mov" and args[1:] == ["sp"]:
   212	            return d, d
   213	        if mn == "add" and len(args) == 3 and args[1] == "sp":
   214	            return d, d - imm(args[2])
   215	        return d, None
   216	    if mn.startswith("ldp") and "x29" in args[:2]:
