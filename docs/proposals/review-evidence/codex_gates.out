diff --git a/scripts/checks/lib/slice0_common.sh b/scripts/checks/lib/slice0_common.sh
new file mode 100644
index 000000000..a8b7337fd
--- /dev/null
+++ b/scripts/checks/lib/slice0_common.sh
@@ -0,0 +1,56 @@
+# shellcheck shell=bash
+# Shared machinery of the slice-0 example gates (PROVISIONAL): slice0_backends.sh (gates 4, 6, 6a)
+# and slice0_artifacts.sh (gates 10, 11, 12). Source it from the repository root, inside the nix
+# devshell, with `set -euo pipefail`. It builds the compiler and LCB's command line under the
+# gate's limits and defines:
+#   root, work (removed on exit), lcb, target, emitter (the Lean emitter command, an array);
+#   observe EXE OUT SECS RETRY [MEM_MB [ENV...]]: run EXE under bounded_run (and limited_exec.sh
+#     MEM_MB, default 1024) with ENV assignments; OUT.status (status or "incomplete"),
+#     OUT.stdout, OUT.stderr;
+#   judge EXPECTED_DIR OBS: the observation OBS.* equals the expectation, byte for byte;
+#   build NAME LOG CMD...: run CMD, or print LOG and fail the gate;
+#   emit_examples: the example names, one per line, failing if there are none.
+root=$(pwd)
+work=$(mktemp -d)
+trap 'rm -rf "${work:?}"' EXIT
+BOUNDED_PARENT="$work"
+# shellcheck source=scripts/checks/lib/bounded.sh
+source scripts/checks/lib/bounded.sh
+[ "$BOUNDED_HAVE_WATCHDOG" = 1 ] || { echo "slice0: python3 is required for bounded runs" >&2; exit 2; }
+# shellcheck source=scripts/checks/lib/limits.sh
+source scripts/checks/lib/limits.sh
+gate_limits 64 40000
+timeout -k 30 1800 lake build Concrete lean-compiler-backend/lcb >/dev/null
+lcb="$root/.lake/packages/lean-compiler-backend/.lake/build/bin/lcb"
+case "$(uname -s)-$(uname -m)" in
+  Linux-x86_64) target=x86_64-linux ;;
+  Linux-aarch64) target=aarch64-linux ;;
+  Darwin-arm64) target=aarch64-macos ;;
+  *) echo "slice0: unsupported host $(uname -s)-$(uname -m)" >&2; exit 2 ;;
+esac
+emitter=(timeout -k 10 120 lake env lean --run scripts/checks/slice0_bir.lean)
+
+observe() {
+  local rc=0 mem=${5:-1024}
+  local envs=("${@:6}")
+  bounded_run -i /dev/null -r "$4" "$3" -- env ${envs[@]+"${envs[@]}"} \
+    bash "$root/scripts/checks/lib/limited_exec.sh" "$mem" "$1" \
+    >"$2.stdout" 2>"$2.stderr" || rc=$?
+  if bounded_is_incomplete "$rc"; then echo incomplete >"$2.status"; else echo "$rc" >"$2.status"; fi
+}
+
+judge() {
+  cmp -s "$1/status" "$2.status" && cmp -s "$1/stderr" "$2.stderr" && [ ! -s "$2.stdout" ]
+}
+
+build() {
+  local name=$1 log=$2; shift 2
+  "$@" >"$log" 2>&1 || { cat "$log" >&2; echo "slice0: $name: build failed: $*" >&2; exit 1; }
+}
+
+emit_examples() {
+  local names
+  names=$("${emitter[@]}" list) || { echo "slice0: listing the examples failed" >&2; exit 1; }
+  [ -n "$names" ] || { echo "slice0: no examples listed" >&2; exit 1; }
+  printf '%s\n' "$names"
+}
diff --git a/scripts/checks/lib/stack_bound.py b/scripts/checks/lib/stack_bound.py
new file mode 100644
index 000000000..d6ea64d45
--- /dev/null
+++ b/scripts/checks/lib/stack_bound.py
@@ -0,0 +1,363 @@
+#!/usr/bin/env python3
+"""Stack bound of a slice-0 executable, from its disassembly (README gate 12). PROVISIONAL.
+
+usage: stack_bound.py ARCH DISASM             -> prints `bound N` and one `external SYM DEPTH` per call
+       stack_bound.py ARCH DISASM --ranges    -> also prints `range SYM LO HI` per Concrete function
+ARCH is x86_64 or aarch64; DISASM is `llvm-objdump -d --no-show-raw-insn` output of the LINKED
+executable (x86-64 in Intel syntax).
+
+The Concrete-owned code is `main` (the runtime entry), `concrete_rt_write_all` and the body
+(`concrete_body`), with or without the Mach-O underscore. From `main`'s entry, every path through
+them is followed over the control-flow graph, tracking the stack pointer's depth below its value
+at `main`'s entry (and the frame pointer's). The bound is the deepest point reached, by the stack
+pointer or by any byte addressed relative to it or the frame pointer (the red zone below the
+stack pointer is used without moving it), counting each
+internal callee's own bound and the depth at which each external function (libc's `write`,
+`_exit`, `abort`) is entered; the external functions' own use is outside it (a premise, listed),
+and so is that `_exit` and `abort` do not return (a path ends at a call to one).
+
+Fail closed: any instruction that writes the stack pointer in a way not modelled here, an indirect
+branch or call, a branch leaving its function, two different depths at one address, a return at a
+nonzero depth, recursion, or a call to a function that is neither Concrete-owned nor a PLT/stub
+symbol is an error (exit 1), never a bound.
+"""
+import re
+import sys
+
+OWNED = ("main", "concrete_body", "concrete_rt_write_all")
+# External functions that do not return (part of the libc premise): a path ends at a call to one.
+NORETURN = ("exit", "_exit", "_Exit", "abort")
+
+
+class Refuse(Exception):
+    pass
+
+
+def owned_name(sym):
+    s = sym[1:] if sym.startswith("_") and sym[1:] in OWNED else sym
+    return s if s in OWNED else None
+
+
+def parse(path):
+    """Functions: name -> list of (addr, mnemonic, operands). Also the set of stub symbols."""
+    funcs, cur, stubs, section = {}, None, set(), ""
+    head = re.compile(r"^([0-9a-f]+) <([^>]+)>:$")
+    inst = re.compile(r"^\s*([0-9a-f]+):\s*(\S+)\s*(.*)$")
+    for line in open(path, encoding="utf-8", errors="replace"):
+        line = line.rstrip("\n")
+        if line.startswith("Disassembly of section"):
+            section = line.split()[-1].rstrip(":")
+            cur = None
+            continue
+        m = head.match(line)
+        if m:
+            name = m.group(2)
+            if section in (".plt", ".plt.sec", ".plt.got", "__stubs") or name.endswith("@plt"):
+                stubs.add(name)
+                cur = None
+            else:
+                cur = name
+                funcs.setdefault(name, [])
+            continue
+        m = inst.match(line)
+        if m and cur is not None:
+            ops = m.group(3).split("#", 1)[0] if ARCH == "x86_64" else m.group(3).split("//")[0]
+            funcs[cur].append((int(m.group(1), 16), m.group(2).lower(), ops.strip()))
+    return funcs, stubs
+
+
+def target_of(ops):
+    m = re.search(r"0x([0-9a-f]+)\s*<([^>]+)>", ops)
+    if not m:
+        m2 = re.search(r"\b([0-9a-f]+)\s*<([^>]+)>", ops)
+        if not m2:
+            return None, None
+        m = m2
+    return int(m.group(1), 16), m.group(2)
+
+
+def imm(s):
+    t = s.strip().lstrip("#")
+    try:
+        return int(t, 16) if t.lower().startswith(("0x", "-0x")) else int(t)
+    except ValueError:
+        raise Refuse(f"not an immediate: {s}") from None
+
+
+def x86_step(mn, ops, d, fp):
+    """New (d, fp) after a non-control x86 instruction."""
+    args = [a.strip() for a in ops.split(",")] if ops else []
+    dst = args[0] if args else ""
+    if mn == "push":
+        return d + 8, fp
+    if mn == "pop":
+        return d - 8, (None if dst == "rbp" else fp)
+    if mn == "leave":
+        if fp is None:
+            raise Refuse("leave with an unknown frame pointer")
+        return fp - 8, None
+    if mn in ("sub", "add") and dst == "rsp":
+        n = imm(args[1])
+        return (d + n if mn == "sub" else d - n), fp
+    if mn == "mov" and dst == "rbp" and args[1:] == ["rsp"]:
+        return d, d
+    if mn == "mov" and dst == "rsp" and args[1:] == ["rbp"]:
+        if fp is None:
+            raise Refuse("mov rsp, rbp with an unknown frame pointer")
+        return fp, fp
+    if mn in ("enter", "pushf", "pushfq", "popf", "popfq") or dst in ("rsp", "esp", "sp", "spl"):
+        raise Refuse(f"unmodelled stack-pointer write: {mn} {ops}")
+    if dst in ("rbp", "ebp"):
+        return d, None
+    return d, fp
+
+
+MEM = re.compile(r"\[([^\]]*)\]")
+X86_STACK = ("rsp", "rbp", "esp", "ebp")
+# x86 instructions whose stack-register operands the depth tracking itself models.
+X86_MODELLED = {("push", "rbp"), ("pop", "rbp"), ("mov", "rbp, rsp"), ("mov", "rsp, rbp"),
+                ("leave", "")}
+
+
+def x86_access(mn, ops, d, fp):
+    """The deepest byte an x86 instruction touches or addresses through the stack or frame
+    pointer (a memory operand or `lea`), or None. The red zone below the stack pointer is used
+    without moving it, so this, not only the stack pointer, is what the bound must cover.
+    Refuses an indexed stack address and a stack or frame pointer copied out as a value."""
+    deepest = None
+    for inner in MEM.findall(ops):
+        terms = re.findall(r"[+-]?\s*[^+\-\s]+", inner)
+        regs = [t.strip(" +-") for t in terms if not re.fullmatch(r"[+-]?\s*(0x[0-9a-f]+|\d+)", t)]
+        base = [r for r in regs if r in X86_STACK]
+        if not base:
+            continue
+        if len(regs) != 1:
+            raise Refuse(f"indexed stack address: {mn} {ops}")
+        k = sum(int(t.replace(" ", ""), 0) for t in terms if t.strip(" +-") not in regs)
+        if base[0] in ("rbp", "ebp"):
+            if fp is None:
+                raise Refuse(f"frame-relative address with an unknown frame pointer: {mn} {ops}")
+            depth = fp - k
+        else:
+            depth = d - k
+        deepest = depth if deepest is None else max(deepest, depth)
+    outside = MEM.sub("", ops)
+    if (mn, ops) not in X86_MODELLED and not (mn in ("sub", "add") and ops.startswith("rsp,")):
+        if any(re.search(rf"\b{r}\b", outside) for r in X86_STACK):
+            raise Refuse(f"stack or frame pointer used as a value: {mn} {ops}")
+    return deepest
+
+
+def a64_access(mn, ops, d, fp):
+    """As x86_access, for AArch64: `[sp, #k]` and `[x29, #k]` operands (writeback on sp is the
+    depth tracking's); refuses a register offset from sp or x29, writeback on x29, and sp or x29
+    copied out as a value (other than the frame setup the depth tracking models)."""
+    deepest = None
+    for inner in MEM.findall(ops):
+        parts = [p.strip() for p in inner.split(",")]
+        if parts[0] not in ("sp", "x29"):
+            continue
+        if len(parts) > 2 or (len(parts) == 2 and not parts[1].startswith("#")):
+            raise Refuse(f"register-offset stack address: {mn} {ops}")
+        k = imm(parts[1]) if len(parts) == 2 else 0
+        if parts[0] == "x29":
+            if fp is None:
+                raise Refuse(f"frame-relative address with an unknown frame pointer: {mn} {ops}")
+            if re.search(r"\[x29[^\]]*\]!", ops):
+                raise Refuse(f"writeback on the frame pointer: {mn} {ops}")
+            depth = fp - k
+        else:
+            depth = d - k
+        deepest = depth if deepest is None else max(deepest, depth)
+    args = [a.strip() for a in re.split(r",(?![^\[]*\])", MEM.sub("[]", ops))] if ops else []
+    modelled = (args[:1] in (["sp"], ["x29"]) or (mn.startswith(("stp", "ldp")) and "x29" in args[:2])
+                or (mn.startswith(("str", "ldr")) and args[:1] == ["x29"]))
+    if not modelled and any(a in ("sp", "x29", "wsp", "w29") for a in args[1:]):
+        raise Refuse(f"stack or frame pointer used as a value: {mn} {ops}")
+    return deepest
+
+
+SPWB_PRE = re.compile(r"\[sp(?:,\s*#(-?(?:0x)?[0-9a-f]+))?\]!")
+SPWB_POST = re.compile(r"\[sp\],\s*#(-?(?:0x)?[0-9a-f]+)")
+
+
+def a64_step(mn, ops, d, fp):
+    """New (d, fp) after a non-control AArch64 instruction."""
+    args = [a.strip() for a in re.split(r",(?![^\[]*\])", ops)] if ops else []
+    dst = args[0] if args else ""
+    m = SPWB_PRE.search(ops)
+    if m:
+        d = d - (imm(m.group(1)) if m.group(1) else 0)
+    m = SPWB_POST.search(ops)
+    if m:
+        d = d - imm(m.group(1))
+    if SPWB_PRE.search(ops) or SPWB_POST.search(ops):
+        return d, (None if "x29" in args[:2] and mn.startswith("ld") else fp)
+    if dst in ("sp", "wsp"):
+        if mn in ("sub", "add") and len(args) == 3 and args[1] == "sp":
+            n = imm(args[2])
+            return (d + n if mn == "sub" else d - n), fp
+        if mn == "mov" and args[1:] == ["x29"]:
+            if fp is None:
+                raise Refuse("mov sp, x29 with an unknown frame pointer")
+            return fp, fp
+        if mn in ("sub", "add") and len(args) == 3 and args[1] == "x29":
+            if fp is None:
+                raise Refuse("sp from an unknown frame pointer")
+            n = imm(args[2])
+            return (fp + n if mn == "sub" else fp - n), fp
+        raise Refuse(f"unmodelled stack-pointer write: {mn} {ops}")
+    if dst in ("x29", "w29"):
+        if mn == "mov" and args[1:] == ["sp"]:
+            return d, d
+        if mn == "add" and len(args) == 3 and args[1] == "sp":
+            return d, d - imm(args[2])
+        return d, None
+    if mn.startswith("ldp") and "x29" in args[:2]:
+        return d, None
+    return d, fp
+
+
+X86_JCC = re.compile(r"^j(?!mp$)[a-z]+$")
+A64_COND = re.compile(r"^b\.[a-z]+$")
+
+
+def control(mn, ops):
+    """(kind, target) for a control instruction, or (None, None)."""
+    if ARCH == "x86_64":
+        if mn == "call":
+            return "call", ops
+        if mn == "jmp":
+            return "jmp", ops
+        if X86_JCC.match(mn):
+            return "jcc", ops
+        if mn == "ret":
+            return "ret", None
+        if mn in ("ud2", "hlt", "int3"):
+            return "stop", None
+        return None, None
+    if mn == "bl":
+        return "call", ops
+    if mn == "b":
+        return "jmp", ops
+    if A64_COND.match(mn) or mn in ("cbz", "cbnz", "tbz", "tbnz"):
+        return "jcc", ops
+    if mn in ("blr", "br", "braa", "blraa", "braaz", "blraaz"):
+        return "indirect", ops
+    if mn in ("ret", "retaa", "retab"):
+        return "ret", None
+    if mn in ("brk", "udf", "hlt"):
+        return "stop", None
+    return None, None
+
+
+def analyse(funcs, stubs):
+    """(bound, externals, owned): main's bound, each external's deepest entry depth, both from
+    main's entry, and the owned functions' names."""
+    owned = {owned_name(n): n for n in funcs if owned_name(n)}
+    if "main" not in owned:
+        raise Refuse("no main")
+    memo, active = {}, set()
+    ret_push = 8 if ARCH == "x86_64" else 0
+    step = x86_step if ARCH == "x86_64" else a64_step
+    access = x86_access if ARCH == "x86_64" else a64_access
+
+    def add_ext(ext, sub, base):
+        for name, depth in sub.items():
+            ext[name] = max(ext.get(name, 0), base + depth)
+
+    def fn_bound(key):
+        """(deepest, externals) of owned function `key`, relative to its own entry."""
+        if key in memo:
+            return memo[key]
+        if key in active:
+            raise Refuse(f"recursion through {key}")
+        active.add(key)
+        code = funcs[owned[key]]
+        if not code:
+            raise Refuse(f"{key}: no instructions")
+        index = {a: i for i, (a, _, _) in enumerate(code)}
+        seen, work, deepest, ext = {}, [(0, 0, None)], 0, {}
+        while work:
+            i, d, fp = work.pop()
+            while True:
+                if i >= len(code):
+                    raise Refuse(f"{key}: runs off its end")
+                addr, mn, ops = code[i]
+                if addr in seen:
+                    if seen[addr] != (d, fp):
+                        raise Refuse(f"{key}+{addr:#x}: depths {seen[addr]} and {(d, fp)} meet")
+                    break
+                seen[addr] = (d, fp)
+                kind, arg = control(mn, ops)
+                if kind is None:
+                    touched = access(mn, ops, d, fp)
+                    if touched is not None:
+                        deepest = max(deepest, touched)
+                    d, fp = step(mn, ops, d, fp)
+                    if d < 0:
+                        raise Refuse(f"{key}+{addr:#x}: stack above the entry")
+                    deepest = max(deepest, d)
+                    i += 1
+                    continue
+                if kind == "indirect":
+                    raise Refuse(f"{key}+{addr:#x}: indirect branch {mn} {ops}")
+                if kind == "ret":
+                    if d != 0:
+                        raise Refuse(f"{key}+{addr:#x}: return at depth {d}")
+                    break
+                if kind == "stop":
+                    break
+                tgt, sym = target_of(arg)
+                if tgt is None:
+                    raise Refuse(f"{key}+{addr:#x}: indirect {mn} {ops}")
+                if kind == "call":
+                    base = sym.split("+")[0]
+                    callee = owned_name(base)
+                    if callee and "+" not in sym:
+                        sub_deep, sub_ext = fn_bound(callee)
+                        deepest = max(deepest, d + ret_push + sub_deep)
+                        add_ext(ext, sub_ext, d + ret_push)
+                    elif base in stubs or base.endswith("@plt"):
+                        # ELF `write@plt`; Mach-O stubs carry one extra leading underscore.
+                        name = base.removesuffix("@plt") if base.endswith("@plt") else base[1:]
+                        add_ext(ext, {name: 0}, d + ret_push)
+                        deepest = max(deepest, d + ret_push)
+                        if name in NORETURN:
+                            break
+                    else:
+                        raise Refuse(f"{key}+{addr:#x}: call to {sym}, neither owned nor a stub")
+                    i += 1
+                    continue
+                if tgt not in index:
+                    raise Refuse(f"{key}+{addr:#x}: branch leaves the function: {mn} {ops}")
+                if kind == "jmp":
+                    i = index[tgt]
+                    continue
+                work.append((index[tgt], d, fp))
+                i += 1
+        active.discard(key)
+        memo[key] = (deepest, ext)
+        return memo[key]
+
+    total, ext = fn_bound("main")
+    return total, ext, owned
+
+
+if __name__ == "__main__":
+    if len(sys.argv) not in (3, 4) or sys.argv[1] not in ("x86_64", "aarch64"):
+        sys.exit("usage: stack_bound.py x86_64|aarch64 DISASM [--ranges]")
+    ARCH = sys.argv[1]
+    try:
+        funcs, stubs = parse(sys.argv[2])
+        total, ext, owned = analyse(funcs, stubs)
+    except Refuse as e:
+        print(f"refused: {e}")
+        sys.exit(1)
+    print(f"bound {total}")
+    for name, depth in sorted(ext.items()):
+        print(f"external {name} {depth}")
+    if len(sys.argv) == 4 and sys.argv[3] == "--ranges":
+        for key, name in sorted(owned.items()):
+            code = funcs[name]
+            print(f"range {key} {code[0][0]:#x} {code[-1][0]:#x}")
diff --git a/scripts/checks/lib/stack_measure.py b/scripts/checks/lib/stack_measure.py
new file mode 100644
index 000000000..37d623bfe
--- /dev/null
+++ b/scripts/checks/lib/stack_measure.py
@@ -0,0 +1,56 @@
+# gdb -batch -nx -x stack_measure.py EXE (README gate 12, x86-64 Linux). PROVISIONAL.
+#
+# Measures the stack depth one run of EXE reaches, below the stack pointer at `main`'s entry, by
+# single-stepping every instruction of the Concrete-owned functions (STACK_RANGES: "LO:HI,..." in
+# the executable's link-time addresses, from stack_bound.py --ranges; STACK_MAIN: main's LO).
+# An external function (entered through a call, so its return address is at the stack pointer)
+# runs at full speed to its return; its own use is outside the bound, as in stack_bound.py, but
+# the depth at its entry is measured. Once main has returned, the rest runs freely. Prints
+# `measured N` and `steps N`, or `error ...` (the gate fails on it).
+import os
+
+import gdb
+
+LIMIT = 2_000_000
+ranges = [tuple(int(x, 16) for x in r.split(":")) for r in os.environ["STACK_RANGES"].split(",")]
+main_lo = int(os.environ["STACK_MAIN"], 16)
+exited = [False]
+gdb.events.exited.connect(lambda _e: exited.__setitem__(0, True))
+gdb.execute("set pagination off")
+gdb.execute("set confirm off")
+gdb.execute("set disable-randomization on")
+
+
+def reg(name):
+    return int(gdb.parse_and_eval(f"(unsigned long) ${name}"))
+
+
+try:
+    gdb.execute("break *main", to_string=True)
+    gdb.execute("run </dev/null >/dev/null 2>/dev/null", to_string=True)
+    if exited[0]:
+        raise RuntimeError("exited before main")
+    offset = reg("pc") - main_lo
+    sp0 = reg("sp")
+    low, steps = sp0, 0
+    inferior = gdb.selected_inferior()
+    while not exited[0]:
+        pc, sp = reg("pc"), reg("sp")
+        if sp > sp0:  # main has returned
+            gdb.execute("continue", to_string=True)
+            continue
+        low = min(low, sp)
+        if any(lo + offset <= pc <= hi + offset for lo, hi in ranges):
+            gdb.execute("stepi", to_string=True)
+            steps += 1
+            if steps > LIMIT:
+                raise RuntimeError(f"more than {LIMIT} steps")
+        else:
+            ret = int.from_bytes(inferior.read_memory(sp, 8).tobytes(), "little")
+            gdb.execute("delete", to_string=True)
+            gdb.execute(f"tbreak *{ret:#x}", to_string=True)
+            gdb.execute("continue", to_string=True)
+    print(f"measured {sp0 - low}")
+    print(f"steps {steps}")
+except Exception as e:  # noqa: BLE001 - every failure is reported, the gate fails closed
+    print(f"error {e}")
diff --git a/scripts/checks/slice0_artifacts.sh b/scripts/checks/slice0_artifacts.sh
new file mode 100644
index 000000000..3bfde315f
--- /dev/null
+++ b/scripts/checks/slice0_artifacts.sh
@@ -0,0 +1,210 @@
+#!/usr/bin/env bash
+# Slice-0 artifact gates (PROVISIONAL, Concrete/README.md gates 10, 11 and 12), over every
+# hand-written BIR example, on the executables slice0_native.sh links:
+#
+# 10. Sanitizers: the LLVM example also built with ASan and UBSan (slice0_native.sh sanitize: ASan
+#     instruments the printed IR once every definition carries sanitize_address; UBSan's checks
+#     come from clang's C front end, so on IR only its runtime is linked) must
+#     give the same observation as the BIR semantics (status, exact fd-2 bytes, empty fd 1), so no
+#     sanitizer report. Its memory is bounded by ASan's hard_rss_limit_mb (the shadow reservation
+#     rules out an address-space cap). Control: a body with an out-of-bounds load must be reported.
+# 11. Binary size (report-only, never fails on a size): bytes and text size of each executable,
+#     per backend and target, in REPORT/sizes.tsv.
+# 12. Stack bound: lib/stack_bound.py derives, from the linked executable's disassembly, a bound on
+#     the Concrete-owned stack below main's entry, covering every byte addressed relative to the
+#     stack or frame pointer (so the red zone), with external libc calls listed with their entry
+#     depth (their own use, and that _exit and abort do not return, are premises). On x86-64
+#     Linux, a run under gdb (lib/stack_measure.py) must stay within it (the run measures the
+#     stack pointer only). REPORT/stack.tsv. Controls: the analysis must refuse an unmodelled
+#     stack-pointer write, an indirect call, recursion, a call to an unknown function, two depths
+#     meeting, a stack pointer used as a value and an indexed stack address, and give the
+#     expected bound on a known function and on a red-zone store; the comparison must reject a
+#     measurement above the bound.
+#
+# usage: slice0_artifacts.sh [REPORT_DIR]. Run inside the nix devshell, from the repository root.
+set -euo pipefail
+report=${1:-}
+# shellcheck source=scripts/checks/lib/slice0_common.sh
+source scripts/checks/lib/slice0_common.sh
+: "${CONCRETE_SLICE0_LLVM:?run inside nix develop}"
+objdump=("$CONCRETE_SLICE0_LLVM/llvm-objdump" -d --no-show-raw-insn)
+case "$target" in
+  x86_64-linux) arch=x86_64; objdump+=(--x86-asm-syntax=intel) ;;
+  aarch64-*) arch=aarch64 ;;
+esac
+gdb=
+if [ "$target" = x86_64-linux ]; then gdb=${CONCRETE_SLICE0_GDB:?the x86-64 Linux shell pins gdb}; fi
+[ -n "$report" ] || report="$work/report"
+mkdir -p "$report"
+sizes="$report/sizes.tsv"
+stack="$report/stack.tsv"
+printf 'example\tbackend\ttarget\tbytes\ttext\n' >"$sizes"
+printf 'example\tbackend\ttarget\tbound\tmeasured\texternals\n' >"$stack"
+# hard_rss_limit_mb and LeakSanitizer are Linux-only (ASan on Darwin refuses detect_leaks); on
+# macOS RLIMIT_AS is not enforced either, so there the job's memory is the bound, as for all runs.
+asan=abort_on_error=0:symbolize=0
+[ "$(uname -s)" != Linux ] || asan="$asan:hard_rss_limit_mb=1024:detect_leaks=1"
+san_env=("ASAN_OPTIONS=$asan" UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=0:symbolize=0)
+analyse=(timeout -k 10 60 python3 -I "$root/scripts/checks/lib/stack_bound.py" "$arch")
+fail=0
+examples=0
+
+# within MEASURED BOUND: the run stayed within the static bound (and actually ran).
+within() { [ "$1" -gt 0 ] && [ "$1" -le "$2" ]; }
+
+# stack_check NAME BACKEND EXE: derive the bound, measure a run where supported, record both.
+stack_check() {
+  local name=$1 backend=$2 exe=$3 dis="$3.dis" out bound ext measured=not-run
+  if ! timeout -k 10 60 "${objdump[@]}" "$exe" >"$dis" 2>"$dis.err"; then
+    echo "FAIL $name [$backend] stack: disassembly failed: $(head -c 300 "$dis.err")"; fail=1; return
+  fi
+  if ! out=$("${analyse[@]}" "$dis" --ranges); then
+    echo "FAIL $name [$backend] stack: $out"; fail=1; return
+  fi
+  bound=$(awk '$1 == "bound" {print $2}' <<<"$out")
+  ext=$(awk '$1 == "external" {printf "%s%s@%s", sep, $2, $3; sep=","}' <<<"$out")
+  if [ -n "$gdb" ]; then
+    local ranges main m
+    ranges=$(awk '$1 == "range" {printf "%s%s:%s", sep, $3, $4; sep=","}' <<<"$out")
+    main=$(awk '$1 == "range" && $2 == "main" {print $3}' <<<"$out")
+    m=$(STACK_RANGES=$ranges STACK_MAIN=$main timeout -k 10 300 \
+      "$gdb" -batch -nx -x "$root/scripts/checks/lib/stack_measure.py" "$exe" 2>"$exe.gdb.err" |
+      awk '$1 == "measured" || $1 == "error" {print}') || true
+    measured=$(awk '$1 == "measured" {print $2}' <<<"$m")
+    if [ -z "$measured" ] || ! within "$measured" "$bound"; then
+      echo "FAIL $name [$backend] stack: bound $bound, run: ${m:-no measurement} $(head -c 300 "$exe.gdb.err")"
+      fail=1
+    fi
+  fi
+  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$backend" "$target" "$bound" "$measured" "$ext" >>"$stack"
+  echo "ok   $name [$backend] stack: bound $bound, measured $measured, externals ${ext:-none}"
+}
+
+size_report() { # size_report NAME BACKEND EXE
+  local bytes text
+  bytes=$(wc -c <"$3" | tr -d ' ')
+  text=$(timeout -k 10 60 "$CONCRETE_SLICE0_LLVM/llvm-size" "$3" 2>/dev/null | awk 'NR == 2 {print $1}') || true
+  printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$target" "$bytes" "${text:-unavailable}" >>"$sizes"
+}
+
+names=$(emit_examples)
+mkdir -p "$work/ctl"
+for name in $names; do
+  d="$work/ex/$name"
+  "${emitter[@]}" emit "$name" "$d" "$target"
+  build "$name" "$d/build.log" timeout -k 10 300 bash "$root/scripts/checks/slice0_native.sh" "$d" "$lcb"
+  build "$name" "$d/build-san.log" \
+    timeout -k 10 300 bash "$root/scripts/checks/slice0_native.sh" "$d" "$lcb" sanitize
+  observe "$d/llvm.san.exe" "$d/san" 30 30 0 "${san_env[@]}"
+  if judge "$d" "$d/san"; then
+    echo "ok   $name [llvm+asan+ubsan]: status $(cat "$d/san.status")"
+  else
+    echo "FAIL $name [llvm+asan+ubsan]: status $(cat "$d/san.status") (expected $(cat "$d/status")), stderr" \
+      "$(head -c 600 "$d/san.stderr")"
+    fail=1
+  fi
+  for backend in llvm lcb; do
+    size_report "$name" "$backend" "$d/$backend.exe"
+    stack_check "$name" "$backend" "$d/$backend.exe"
+  done
+  examples=$((examples + 1))
+done
+
+# Control (gate 10): an out-of-bounds load in the body must be reported by ASan.
+c="$work/ctl/asan"
+"${emitter[@]}" emit "${names%%$'\n'*}" "$c" "$target"
+sed -i.orig 's/^define i32 @concrete_body() {$/define i32 @concrete_body_orig() {/' "$c/llvm.ll"
+cat >>"$c/llvm.ll" <<'LL'
+
+@concrete_ctl = global [4 x i8] zeroinitializer
+define i32 @concrete_body() {
+entry:
+  %p = getelementptr i8, ptr @concrete_ctl, i64 4
+  %v = load volatile i8, ptr %p
+  %r = call i32 @concrete_body_orig()
+  ret i32 %r
+}
+LL
+build control-asan "$c/build.log" timeout -k 10 300 bash "$root/scripts/checks/slice0_native.sh" "$c" "$lcb"
+build control-asan "$c/build-san.log" \
+  timeout -k 10 300 bash "$root/scripts/checks/slice0_native.sh" "$c" "$lcb" sanitize
+observe "$c/llvm.san.exe" "$c/san" 30 30 0 "${san_env[@]}"
+if ! judge "$c" "$c/san" && grep -q 'AddressSanitizer' "$c/san.stderr"; then
+  echo "ok   control: ASan reports an out-of-bounds load"
+else
+  echo "FAIL control: ASan did not report an out-of-bounds load (status $(cat "$c/san.status"))"; fail=1
+fi
+
+# Controls (gate 12): the analysis on synthetic disassembly.
+ctl_dis() { # ctl_dis NAME: write a synthetic x86-64 disassembly from stdin
+  { echo "Disassembly of section .text:"; cat; } >"$work/ctl/$1.dis"
+  echo "$work/ctl/$1.dis"
+}
+known=$(ctl_dis known <<'D'
+
+0000000000001000 <concrete_body>:
+    1000:	push	rbp
+    1001:	mov	rbp, rsp
+    1004:	sub	rsp, 0x10
+    1008:	add	rsp, 0x10
+    100c:	pop	rbp
+    100d:	ret
+
+0000000000001010 <main>:
+    1010:	push	rbp
+    1011:	mov	rbp, rsp
+    1014:	sub	rsp, 0x20
+    1018:	call	0x1000 <concrete_body>
+    101d:	je	0x1024 <main+0x14>
+    101f:	call	0x2000 <write@plt>
+    1024:	leave
+    1025:	ret
+D
+)
+# main: 8 + 0x20 = 40 deep; the call pushes 8; the body goes 8 + 0x10 = 24 deeper: 72.
+if [ "$(python3 -I scripts/checks/lib/stack_bound.py x86_64 "$known")" = "$(printf 'bound 72\nexternal write 48')" ]; then
+  echo "ok   control: stack bound of a known function"
+else
+  echo "FAIL control: stack bound of a known function: $(python3 -I scripts/checks/lib/stack_bound.py x86_64 "$known")"
+  fail=1
+fi
+refuse() { # refuse NAME: stdin is the main function's body after its header
+  local f
+  f=$(ctl_dis "$1" <<<"$(printf '\n0000000000001010 <main>:\n'; cat)")
+  if python3 -I scripts/checks/lib/stack_bound.py x86_64 "$f" >"$f.out"; then
+    echo "FAIL control: stack analysis accepts $1: $(cat "$f.out")"; fail=1
+  else
+    echo "ok   control: stack analysis refuses $1"
+  fi
+}
+printf '    1010:\tsub\trsp, rax\n    1013:\tret\n' | refuse dynamic-sp
+printf '    1010:\tcall\trax\n    1012:\tret\n' | refuse indirect-call
+printf '    1010:\tpush\trbp\n    1011:\tcall\t0x1010 <main>\n    1016:\tpop\trbp\n    1017:\tret\n' | refuse recursion
+printf '    1010:\tcall\t0x3000 <helper>\n    1015:\tret\n' | refuse unknown-call
+printf '    1010:\tje\t0x1014 <main+0x4>\n    1012:\tpush\trax\n    1013:\tnop\n    1014:\tret\n' | refuse depths-meet
+printf '    1010:\tmov\trax, rsp\n    1013:\tret\n' | refuse stack-pointer-escape
+printf '    1010:\tmov\teax, dword ptr [rsp + 4*rcx - 0x8]\n    1014:\tret\n' | refuse indexed-stack-address
+# A leaf's red-zone store, below the stack pointer, is inside the bound: 8 + 0x30.
+redzone=$(ctl_dis redzone <<'D'
+
+0000000000001010 <main>:
+    1010:	push	rbp
+    1011:	mov	rbp, rsp
+    1014:	mov	dword ptr [rbp - 0x30], eax
+    1017:	pop	rbp
+    1018:	ret
+D
+)
+if [ "$(python3 -I scripts/checks/lib/stack_bound.py x86_64 "$redzone")" = "bound 56" ]; then
+  echo "ok   control: a red-zone store is inside the bound"
+else
+  echo "FAIL control: red-zone bound: $(python3 -I scripts/checks/lib/stack_bound.py x86_64 "$redzone")"
+  fail=1
+fi
+if within 73 72; then echo "FAIL control: a measurement above the bound is accepted"; fail=1
+else echo "ok   control: a measurement above the bound is rejected"; fi
+
+[ "$examples" -gt 0 ] || { echo "slice0_artifacts: no examples ran" >&2; exit 1; }
+echo "slice0_artifacts: $examples examples; sizes in $sizes, stack bounds in $stack"
