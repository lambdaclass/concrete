   219	
   220	
   221	X86_JCC = re.compile(r"^j(?!mp$)[a-z]+$")
   222	A64_COND = re.compile(r"^b\.[a-z]+$")
   223	
   224	
   225	def control(mn, ops):
   226	    """(kind, target) for a control instruction, or (None, None)."""
   227	    if ARCH == "x86_64":
   228	        if mn == "call":
   229	            return "call", ops
   230	        if mn == "jmp":
   231	            return "jmp", ops
   232	        if X86_JCC.match(mn):
   233	            return "jcc", ops
   234	        if mn == "ret":
   235	            return "ret", None
   236	        if mn in ("ud2", "hlt", "int3"):
   237	            return "stop", None
   238	        return None, None
   239	    if mn == "bl":
   240	        return "call", ops
   241	    if mn == "b":
   242	        return "jmp", ops
   243	    if A64_COND.match(mn) or mn in ("cbz", "cbnz", "tbz", "tbnz"):
   244	        return "jcc", ops
   245	    if mn in ("blr", "br", "braa", "blraa", "braaz", "blraaz"):
   246	        return "indirect", ops
   247	    if mn in ("ret", "retaa", "retab"):
   248	        return "ret", None
   249	    if mn in ("brk", "udf", "hlt"):
   250	        return "stop", None
   251	    return None, None
