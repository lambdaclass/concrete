   253	
   254	def analyse(funcs, stubs):
   255	    """(bound, externals, owned): main's bound, each external's deepest entry depth, both from
   256	    main's entry, and the owned functions' names."""
   257	    owned = {owned_name(n): n for n in funcs if owned_name(n)}
   258	    if "main" not in owned:
   259	        raise Refuse("no main")
