  ls[i]=x.replace('operator/punctuation set (L1), second escape list (L2), raw control characters in strings (L3), and integer suffixes and base prefixes (L4)','exact small ASCII-byte escape list; items 2–5 now decide the token set, quoted ASCII u8 literals and label distinction, refusal of raw controls, suffixes and 0x/0b/0o prefixes without separators or malformed suffix splitting').replace(' | R-0622 |',note+' | R-0622 |')
 # Add durable decision links to new rows.
 if re.match(r'\\| R-065[01] \\|',x): ls[i]=ls[i].rsplit(' |',1)[0]+' ([decision](docs/decisions.md#decided-2026-11-08-twenty-nine)) |'
 if re.match(r'\\| R-064[789] \\|',x) or x.startswith('| R-0652 |'): ls[i]=ls[i].rsplit(' |',1)[0]+' ([decision](docs/decisions.md#decided-2026-11-08-gate-tiers)) |'
r='\\n'.join(ls)+'\\n'; p.write_text(r)
p=Path('docs/decisions.md'); d=p.read_text()
s=d.index('    16. *No "'`char`:'"'); e=d.index('    17.',s)
d=d[:s]+'''    16. *No "'`char`:* text is `u8` plus explicit UTF-8 operations. Revised 2026-11-08 by [item 3](#decided-2026-11-08-twenty-nine): `'"'a'"'` is an ASCII byte literal of type u8 (97u8), with a small escape list. Non-ASCII is refused. The closing quote distinguishes it from `'"'label"'`; tests cover both. This replaces the earlier quoted-literal migration wording.
'"'''+d[e:]
d=d.replace('Q6.4, TYPE-22 (item 26): compile-time "'`Copy` constants. The rows are revised once the'"','Q6.4, TYPE-22 (item 26): compile-time "'`Copy` constants. Revised 2026-11-08 by [item 18](#decided-2026-11-08-twenty-nine): fallible primitives in a closed no-call, no-loop, no-effect grammar; every initializer needs kernel-checked compile-time success, failure or fuel exhaustion refuses it. This supersedes the earlier condition that the rows are revised once the'"')
# Put blank lines around the grouped decision lists.
d=re.sub(r'(  \\*\\*[A-I]\\. ["'^'"\\n]+\\*\\*)\\n(  \\d)',r'\\1\\n\\n\\2',d)
d=d.replace('The wording below records those picks. Exact spellings otherwise remain subject to R-0625.\\n','The wording below records those picks. Exact spellings otherwise remain subject to R-0625.\\n\\n')
d='\\n'.join(x.rstrip() for x in d.splitlines())+'\\n'
p.write_text(d)
# Mark each changed pre-existing table row with a dated linked revision if absent.
for name in ['ROADMAP.md','docs/decisions.md']:
 p=Path(name); s=p.read_text(); old=subprocess.check_output(['git','show','HEAD:'+name],text=True)
 oldrows={x.split('|')[1].strip():x for x in old.splitlines() if x.startswith('| ') and len(x.split('|'))>3}
 ls=s.splitlines()
 for i,x in enumerate(ls):
  if not x.startswith('| '): continue
  key=x.split('|')[1].strip()
  if key in oldrows and x"'!=oldrows[key] and '"'Revised 2026-11-08' not in x and 'revised 2026-11-08' not in x:
   target='docs/decisions.md#decided-2026-11-08-twenty-nine' if name=='ROADMAP.md' else '#decided-2026-11-08-twenty-nine'
