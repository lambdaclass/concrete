1379:of 2026-11-01 "one allocator form per target", and the terminal out-of-memory failure of STMT-2):
1381:- **One allocation form on every target**: an allocator value plus `with(Alloc)`. A hosted target hands
1382:  `main` the system allocator; a freestanding target hands it its arenas. There is no allocation by
1385:  allocator domain (`Sys` for the system allocator); an arena is one kind of allocator.
1386:- **Allocations carry their allocator's identity in their type**: `Heap<T, A>`, `Vec<T, A>`, `String<A>`.
1387:  Each records how to release its storage (never a reference to the allocator), so `*h` and
1388:  `destroy(h)` (OD59) need no allocator argument and `Destroy` still requires at most `Alloc`.
1389:  Moving a value to another allocator allocates there explicitly.
// tcpserve — WORKLOAD 8 (P7: server side of the socket).
// Usage: tcpserve <port>
// Binds 127.0.0.1:<port> (IPv4 only — std.net sockaddr is AF_INET; IPv6
// is explicitly OUT OF SCOPE, not accidentally tested), prints "READY"
// only after listen succeeds, accepts EXACTLY ONE connection, reads the
// request with a tiny buffer (forcing partial reads) until the "\r\n\r\n"
// terminator, responds with a fixed 256-byte binary body (every byte
// value once) behind minimal HTTP headers, closes both sockets, prints
// "DONE", exits 0. First compiled consumer of TcpListener::accept.
// 13t exit codes: 0 = served one request; 1 = bind/accept/protocol
// failure (each with its own stderr line, no DONE); 2 = usage.
mod tcpserve {
    import std.bytes.{Bytes};
    import std.cli.{Cli, CliResult};
    import std.vec.{Vec};
    import std.parse.{parse_uint};
    import std.net.{TcpListener, TcpStream, NetError};
    import std.io.{println, eprintln};

    fn fail(msg: String) with(Console, Alloc) -> u8 {
        eprintln(&msg);
        msg.drop();
        return 1;
    }

    // Find "\r\n\r\n" in the accumulated buffer. FRICTION (recorded
    // precisely): this is a BUFFERED SUBSEQUENCE SEARCH over Bytes — the
    // same reusable shape as httpget's header_end (2nd independent ask
    // for Bytes::find). It is NOT a streaming state machine (that would
    // be workload-specific and would not count toward the pull), and it
    // is NOT tar_list's fixed-offset equality check (separate `eq_at`
    // candidate, one ask).
    fn find_terminator(resp: &Bytes, start: u64) -> Option<u64> {
        let mut from: u64 = start;
        while true {
            match resp.index_of(13, from) {
                Option::None => { return Option::<u64>::None; },
                Option::Some { value } => {
                    let at: u64 = value;
                    if at + 3 >= resp.len() { return Option::<u64>::None; }
                    if resp.get_unchecked(at + 1) == 10
                        && resp.get_unchecked(at + 2) == 13
                        && resp.get_unchecked(at + 3) == 10 {
                        return Option::<u64>::Some { value: at + 4 };
                    }
                    from = at + 1;
                },
            }
        }
        return Option::<u64>::None;
    }

    // Read with a TINY buffer until the terminator arrives (partial reads
    // by construction: an 8-byte buffer cannot hold a curl request).
    // Returns true when the terminator was seen; false = peer EOF first.
    trusted fn read_request(stream: &TcpStream) with(Network, Alloc) -> bool {
        let mut req: Bytes = Bytes::new();
        let tmp: [u8; 8] = [0; 8];
        // Rescan bound (reviewer note): resume the terminator scan from
        // old_len - (needle_len - 1), never rescanning settled bytes —
        // linear total work without prematurely introducing Bytes::find.
        let mut scan_from: u64 = 0;
        while true {
            match find_terminator(&req, scan_from) {
                Option::Some { value } => {
                    discard(value);
                    req.drop();
                    return true;
                },
                Option::None => { },
            }
            let len: u64 = req.len();
            if len >= 3 { scan_from = len - 3; }
            let n: i64 = stream.read(&tmp as *mut u8, 8);
            if n <= 0 {
                req.drop();
                return false;               // orderly peer close / error: EOF before terminator
            }
            let mut i: i64 = 0;
            while i < n {
                let p: *const u8 = (&tmp as *const u8) + (i as u64);
                req.push(*(p as *mut u8));
                i = i + 1;
            }
        }
        req.drop();
        return false;
    }

    // Response: minimal HTTP/1.0 headers + a 256-byte binary body holding
    // every byte value exactly once (zero bytes and invalid UTF-8
    // included — the body is bytes, never text).
    trusted fn send_response(stream: &TcpStream) with(Network, Alloc) -> bool {
        let mut out: Bytes = Bytes::new();
        let hdr: String = "HTTP/1.0 200 OK\r\nContent-Type: application/octet-stream\r\nContent-Length: 256\r\nConnection: close\r\n\r\n";
        let hb: Bytes = Bytes::from_string(&hdr);
        hdr.drop();
        out.append_bytes(&hb);
        hb.drop();
        let mut b: u64 = 0;
        while b < 256 {
            out.push(b as u8);
            b = b + 1;
        }
        let sent: bool = stream.write_all(out.raw_ptr() as *const u8, out.len());
        out.drop();
        return sent;
    }

    trusted fn serve(port: u16) with(Network, Alloc, Console, Env) -> u8 {
        let addr: String = "127.0.0.1";
        match TcpListener::bind(&addr, port) {
            Result::Err { error } => {
                discard(error);
                addr.drop();
                let m: String = "tcpserve: bind failed";
                return fail(m);
            },
            Result::Ok { value } => {
                addr.drop();
                let listener: TcpListener = value;
                // READY strictly AFTER listen succeeded (bind() runs
                // socket+bind+listen; Ok here means listening).
                let r: String = "READY";
                println(&r);
                r.drop();
                match listener.accept() {
                    Result::Err { error } => {
                        discard(error);
                        discard(listener.close());
                        let m: String = "tcpserve: accept failed";
                        return fail(m);
                    },
                    Result::Ok { value: inner } => {
                        let stream: TcpStream = inner;
                        if !read_request(&stream) {
                            discard(stream.close());
                            discard(listener.close());
                            let m: String = "tcpserve: peer closed before request terminator";
                            return fail(m);
                        }
                        if !send_response(&stream) {
                            discard(stream.close());
                            discard(listener.close());
                            let m: String = "tcpserve: send failed";
                            return fail(m);
                        }
                        // Success path: a failed close is reported, not ignored
                        // (the handle is consumed either way; std.net closes
                        // are consume-on-failure).
                        let sc: Result<u64, NetError> = stream.close();
                        let lc: Result<u64, NetError> = listener.close();
                        if sc.is_err() || lc.is_err() {
                            let m: String = "tcpserve: close failed";
                            return fail(m);
                        }
                        let d: String = "DONE";
                        println(&d);
                        d.drop();
                        return 0;
                    },
                }
            },
        }
    }

    fn main() with(Std) -> u8 {
        let mut cli: Cli = Cli::new();
        match cli.parse(1, 1) {
            CliResult::Err { error } => {
                discard(error);
                let u: String = "usage: tcpserve <port>";
                eprintln(&u);
                u.drop();
                return 2;
            },
            CliResult::Ok { flags, positionals } => {
                flags.drop();
                let mut ps: Vec<String> = positionals;
                let port_s: String = match ps.pop() {
                    Option::None => { ps.drop(); return 2; },
                    Option::Some { value } => { value },
                };
                ps.drop();
                let port_n: Option<u64> = parse_uint(&port_s);
                port_s.drop();
                match port_n {
                    Option::None => {
                        let u: String = "usage: tcpserve <port>";
                        eprintln(&u);
                        u.drop();
                        return 2;
                    },
                    Option::Some { value } => {
                        if value == 0 || value > 65535 { return 2; }
                        return serve(value as u16);
                    },
                }
            },
        }
    }
}
// httpget — WORKLOAD 7 (P7: the Network boundary at workload scale).
// Usage: httpget <host> <port> <path>
// HTTP/1.0 GET; on a 200 response the body bytes go to stdout verbatim
// (binary-safe), so the gate can byte-diff against the served file and
// against curl. First compiled consumer of TcpStream's write_all/read_all
// loops (the coverage fixture only proved bind/connect setup). 13t exit
// codes: 0 = 200 with body printed, 1 = connect/protocol/non-200 error,
// 2 = usage.
mod httpget {
    import std.bytes.{Bytes};
    import std.cli.{Cli, CliResult};
    import std.vec.{Vec};
    import std.parse.{parse_uint};
    import std.net.{TcpStream, NetError};
    import std.io.{eprintln};

    fn fail(msg: String) with(Console, Alloc) -> u8 {
        eprintln(&msg);
        msg.drop();
        return 1;
    }

    // find "\r\n\r\n"; FRICTION: Bytes::index_of is single-byte, so the
    // multi-byte needle is a manual resume loop (2nd ask for a
    // sequence-find after workload 5's single-byte pull).
    fn header_end(resp: &Bytes) -> Option<u64> {
        let mut from: u64 = 0;
        while true {
            match resp.index_of(13, from) {
                Option::None => { return Option::<u64>::None; },
                Option::Some { value } => {
                    let at: u64 = value;
                    if at + 3 >= resp.len() { return Option::<u64>::None; }
                    if resp.get_unchecked(at + 1) == 10
                        && resp.get_unchecked(at + 2) == 13
                        && resp.get_unchecked(at + 3) == 10 {
                        return Option::<u64>::Some { value: at + 4 };
                    }
                    from = at + 1;
                },
            }
        }
        return Option::<u64>::None;
    }

    // status code from "HTTP/1.x NNN ..." — bytes 9..12
    fn status_code(resp: &Bytes) -> u64 {
        if resp.len() < 12 { return 0; }
        let h: u64 = resp.get_unchecked(9) as u64;
        let t: u64 = resp.get_unchecked(10) as u64;
        let o: u64 = resp.get_unchecked(11) as u64;
        if h < 48 || h > 57 || t < 48 || t > 57 || o < 48 || o > 57 { return 0; }
        return (h - 48) * 100 + (t - 48) * 10 + (o - 48);
    }

    trusted fn fetch(host: &String, port: u16, path: &String) with(Network, Alloc, Console, Env) -> u8 {
        let mut req: String = "GET ";
        req.append(path);
        let mid: String = " HTTP/1.0\r\nHost: ";
        req.append(&mid);
        mid.drop();
        req.append(host);
        let tail: String = "\r\nConnection: close\r\n\r\n";
        req.append(&tail);
        tail.drop();

        match TcpStream::connect(host, port) {
            Result::Err { error } => {
                discard(error);
                req.drop();
                let m: String = "httpget: connect failed";
                return fail(m);
            },
            Result::Ok { value } => {
                let raw: Bytes = Bytes::from_string(&req);
                req.drop();
                let sent: bool = value.write_all(raw.raw_ptr() as *const u8, raw.len());
                raw.drop();
                if !sent {
                    discard(value.close());
                    let m: String = "httpget: send failed";
                    return fail(m);
                }
                let mut resp: Bytes = Bytes::new();
                discard(value.read_all(&mut resp));
                // The whole response is already in `resp`: a failed close of the
                // read side loses nothing, so it is discarded explicitly.
                discard(value.close());
                let code: u64 = status_code(&resp);
                if code != 200 {
// envcfg — WORKLOAD 5 (P7: env boundary + line-oriented text parsing).
// Usage: envcfg <file.conf>
// Reads KEY=VALUE lines (# comments and blank lines skipped), resolves
// each key against the process ENVIRONMENT (env wins over file), prints
// "KEY=VALUE" per entry in file order. First workload touching std.env
// (the Env-capability boundary) and the first to parse line-oriented
// text from bytes. 13t exit codes: 0 clean, 1 bad file/malformed line,
// 2 usage.
mod envcfg {
    import std.bytes.{Bytes};
    import std.cli.{Cli, CliResult};
    import std.vec.{Vec};
    import std.env.{get};
    import std.io.{Reader, TextFile, reader_from_file, read_all, IoError,
                   println, eprintln};

    // Byte-region -> String via the pulled std pair: Bytes::slice (owned
    // copy) + the CHECKED to_string crossing. Invalid UTF-8 in a config
    // region is a domain outcome (None -> malformed), which the old
    // hand-rolled push_char loop silently mangled.
    fn region_string(data: &Bytes, start: u64, end: u64) with(Alloc) -> Option<String> {
        match data.slice(start, end) {
            Option::None => { return Option::<String>::None; },
            Option::Some { value } => { return value.to_string(); },
        }
    }

    fn is_space(b: u8) -> bool {
        return b == 32 || b == 9 || b == 13;
    }

    // Trim a [start,end) byte region in place (indices, no allocation).
    fn trim_region(data: &Bytes, start: u64, end: u64) -> u64 {
        let mut s: u64 = start;
        let mut e: u64 = end;
        while s < e && is_space(data.get_unchecked(s)) { s = s + 1; }
        while e > s && is_space(data.get_unchecked(e - 1)) { e = e - 1; }
        // pack both into one u64: start in high 32, end in low 32
        // FRICTION: no tuples — multi-return needs packing or a struct.
        return s * 4294967296 + e;
    }

    // Process one [start,end) line. Returns 0 ok, 1 malformed.
    fn handle_line(data: &Bytes, start: u64, end: u64) with(Std) -> u64 {
        let packed: u64 = trim_region(data, start, end);
        let s: u64 = packed / 4294967296;
        let e: u64 = packed % 4294967296;
