        let eq: u64 = match data.index_of(61, s) {
            Option::Some { value } => { value },
            Option::None => { return 1; },                       // malformed
        };
        if eq >= e { return 1; }                                 // '=' past this line
        if eq == s { return 1; }                                 // empty key
        let kpacked: u64 = trim_region(data, s, eq);
        let ks: u64 = kpacked / 4294967296;
        let ke: u64 = kpacked % 4294967296;
        if ks >= ke { return 1; }
        let vpacked: u64 = trim_region(data, eq + 1, e);
        let vs: u64 = vpacked / 4294967296;
        let ve: u64 = vpacked % 4294967296;
        let key: String = match region_string(data, ks, ke) {
            Option::Some { value } => { value },
            Option::None => { return 1; },                       // invalid UTF-8 key
        };
        // env override wins; fall back to the file value
        let mut out: String = key.clone();
        out.push_char('=');
        match get(&key) {
            Option::Some { value } => {
                out.append(&value);
                value.drop();
            },
            Option::None => {
                match region_string(data, vs, ve) {
                    Option::Some { value } => {
                        out.append(&value);
                        value.drop();
