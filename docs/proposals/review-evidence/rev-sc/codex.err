     1	#!/usr/bin/env python3
     2	"""A lexer for the Lean sources of ConcreteSpec, shared by the proof-integrity checks.
     3	
     4	`lex(src)` returns `src` with every comment (nested `/- -/`, `--`) blanked to spaces, newlines kept,
     5	so offsets and line numbers are the source's. Everything else is kept, string literals included.
     6	It follows Lean's literal forms, so no comment delimiter inside a literal starts a comment: a
     7	string with its escapes, raw strings r"…" and r#"…"#, character literals and quoted names «…».
     8	Whether a string interpolates depends on the parser, not the lexer, so interpolation is admitted
     9	only directly after `s!`, `m!` or `f!` (its `{ }` code, with its own strings and comments, is
    10	lexed recursively), and any other string holding `{` is an error. An unterminated string,
    11	comment, interpolation or name is an error too, and so is a syntax quotation `(…) (whose comments are
    12	syntax data; the library runs no meta code): the lexer fails closed, never skips.
    13	`comment_spans(src)` gives the top-level comments (the owner view, scripts/spec/lean_site.py, takes
    14	its doc blocks from them, so a doc comment inside an ordinary comment or a string is not one).
    15	
    16	Commands (exit 3 when a source cannot be read or lexed):
    17	
    18	  scan RE FILE...          `file:line: text` for every match of RE (over the whole lexed text,
    19	                           reported at the line where it starts) and for every `import` outside
    20	                           the header, which must be lines `import ConcreteSpec[.M…]`, one
    21	                           module each, ended by a command at column 0
    22	  examples SRC DST FILE... copies each FILE (a path relative to SRC) to DST with every `example`
    23	                           command turned into `noncomputable def «⟪example⟫FILE:LINE»` (no space,
    24	                           so listings split on spaces stay sound), so the kernel's view of it
    25	                           stays in the environment; prints the count. Every
    26	                           `example` token must start a line.
    27	"""
    28	import os, re, sys
    29	
    30	EXAMPLE_MARK = "⟪example⟫"
    31	
    32	
    33	class LexError(Exception):
    34	    pass
    35	
    36	
    37	def lex(src, spans=None, literals=True):
    38	    """`src` with its comments blanked; when `spans` is a list, each top-level comment's
    39	    (start, end) offsets are appended to it (a comment nested in another is part of that one).
    40	    With `literals=False`, string, character and name literals are blanked too (code tokens only)."""
    41	    n, out = len(src), []
    42	
    43	    def emit(text, literal=False):
    44	        if literal and not literals:
    45	            text = "".join("\n" if ch == "\n" else " " for ch in text)
    46	        out.append(text)
    47	
    48	    def ident(i):                                     # src[i] continues an identifier
    49	        return i >= 0 and (src[i].isalnum() or src[i] in "_'!?." or ord(src[i]) > 127)
    50	
    51	    def comment(i):                                   # at "/-": blank to the matching "-/"
    52	        start, depth = i, 0
    53	        while i < n:
    54	            if src.startswith("/-", i): depth += 1; out.append("  "); i += 2
    55	            elif src.startswith("-/", i):
    56	                depth -= 1; out.append("  "); i += 2
    57	                if depth == 0:
    58	                    if spans is not None: spans.append((start, i))
    59	                    return i
    60	            else: out.append("\n" if src[i] == "\n" else " "); i += 1
    61	        raise LexError("unterminated comment")
    62	
    63	    def string(i):                                    # at '"'
    64	        interp = src[i - 2:i] in ("s!", "m!", "f!") and not ident(i - 3)
    65	        emit('"', True); i += 1
    66	        while i < n:
    67	            c = src[i]
    68	            if c == "\\": emit(src[i:i + 2], True); i += 2
    69	            elif c == '"': emit(c, True); return i + 1
    70	            elif c == "{" and interp: emit(c, True); i = code(i + 1, True)
    71	            elif c == "{":
    72	                line = src.count("\n", 0, i) + 1
    73	                raise LexError(f"line {line}: a string holding '{{' without s!, m! or f! before it")
    74	            else: emit(c, True); i += 1
    75	        raise LexError("unterminated string")
    76	
    77	    def raw(i):                                       # at 'r' of r#*"
    78	        j = i + 1
    79	        while j < n and src[j] == "#": j += 1
    80	        close = '"' + "#" * (j - i - 1)
    81	        k = src.find(close, j + 1)
    82	        if k < 0: raise LexError("unterminated raw string")
    83	        emit(src[i:k + len(close)], True); return k + len(close)
    84	
    85	    def code(i, inner):                               # inner: inside an interpolation, stop at its '}'
    86	        depth = 0
    87	        while i < n:
    88	            c = src[i]
    89	            if src.startswith("/-", i): i = comment(i)
    90	            elif src.startswith("--", i):
    91	                j = src.find("\n", i); j = n if j < 0 else j; out.append(" " * (j - i)); i = j
    92	            elif c == '"': i = string(i)
    93	            elif c == "«":                            # a quoted name part: no comment inside it
    94	                k = src.find("»", i + 1)
    95	                if k < 0: raise LexError("unterminated «name»")
    96	                emit(src[i:k + 1], True); i = k + 1
    97	            elif src.startswith("`(", i) or src.startswith("``(", i):
    98	                # A syntax quotation: its comments are syntax data, not comments of the source,
    99	                # and the library runs no meta code, so the lexer refuses it.
   100	                raise LexError(f"line {src.count(chr(10), 0, i) + 1}: a syntax quotation")
   101	            elif c == "r" and not ident(i - 1) and re.match(r'r#*"', src[i:]): i = raw(i)
   102	            elif c == "'" and not ident(i - 1):
   103	                m = re.match(r"'(\\(x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|.)|[^\\'\n])'", src[i:])
   104	                k = len(m.group(0)) if m else 1
   105	                emit(src[i:i + k], m is not None); i += k
   106	            elif inner and c == "{": depth += 1; out.append(c); i += 1
   107	            elif inner and c == "}":
   108	                out.append(c); i += 1
   109	                if depth == 0: return i
   110	                depth -= 1
   111	            else: out.append(c); i += 1
   112	        if inner: raise LexError("unterminated interpolation")
   113	        return i
   114	
   115	    code(0, False)
   116	    return "".join(out)
