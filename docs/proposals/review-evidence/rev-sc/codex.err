   118	
   119	def comment_spans(src):
   120	    """The (start, end) offsets of every top-level comment of `src`, in order."""
   121	    spans = []
   122	    lex(src, spans)
   123	    return spans
   124	
   125	
   126	HEADER = re.compile(r"import ConcreteSpec(\.[A-Za-z0-9_]+)*\s*$")
   127	FIRST_COMMAND = re.compile(r"(namespace|open|section|def|theorem|structure|inductive|abbrev)\b")
   128	
   129	
   130	def scan(pattern, paths):
   131	    word, rc = re.compile(pattern, re.M), 0
   132	    for path in paths:
   133	        try:
   134	            text = lex(open(path, encoding="utf-8").read())
   135	        except (OSError, UnicodeDecodeError, LexError) as e:
   136	            print(f"error: {path}: {e}", file=sys.stderr); rc = 3; continue
   137	        lines = text.split("\n")
   138	        # Lean lets an import list continue (`import A B`, or B on the next line), so the first
   139	        # line after the header must be a command at column 0.
   140	        k = 0
   141	        while k < len(lines) and (not lines[k].strip() or HEADER.match(lines[k])): k += 1
   142	        if k < len(lines) and not FIRST_COMMAND.match(lines[k]):
   143	            print(f"{path}:{k + 1}: {lines[k].strip()} (the import header must end in a command at column 0)")
   144	        hits = {text.count("\n", 0, m.start()) + 1 for m in word.finditer(text)}
   145	        hits |= {j for j, line in enumerate(lines, 1)
   146	                 if re.search(r"\bimport\b", line) and not (j <= k and HEADER.match(line))}
   147	        for j in sorted(hits):
   148	            print(f"{path}:{j}: {lines[j - 1].strip()}")
   149	    return rc
   150	
   151	
   152	# `example` as a command token: not part of a longer identifier (`example'`, `my.example`, `examples`)
   153	EXAMPLE = re.compile(r"(?<![\w.'!?])example(?![\w'!?])")
   154	
   155	
   156	def count_examples(src):
   157	    """The number of `example` commands in a source (code tokens only, not literal contents)."""
   158	    return len(EXAMPLE.findall(lex(src, literals=False)))
   159	
   160	
   161	def examples(src_dir, dst_dir, paths):
   162	    count = 0
   163	    for rel in paths:
   164	        src = open(os.path.join(src_dir, rel), encoding="utf-8").read()
   165	        text = lex(src, literals=False)          # an `example` inside a literal is not a command
   166	        out, last = [], 0
   167	        for m in EXAMPLE.finditer(text):
   168	            line = text.count("\n", 0, m.start()) + 1
   169	            if m.start() > 0 and text[m.start() - 1] != "\n":
   170	                raise LexError(f"{rel}:{line}: an `example` that does not start its line")
   171	            out.append(src[last:m.start()])
   172	            out.append(f"noncomputable def «{EXAMPLE_MARK}{rel}:{line}»")
   173	            last = m.end(); count += 1
   174	        out.append(src[last:])
   175	        dst = os.path.join(dst_dir, rel)
   176	        os.makedirs(os.path.dirname(dst) or ".", exist_ok=True)
   177	        open(dst, "w", encoding="utf-8").write("".join(out))
   178	    print(count)
   179	
   180	
   181	if __name__ == "__main__":
   182	    try:
   183	        if sys.argv[1] == "scan":
   184	            sys.exit(scan(sys.argv[2], sys.argv[3:]))
   185	        if sys.argv[1] == "examples":
   186	            examples(sys.argv[2], sys.argv[3], sys.argv[4:]); sys.exit(0)
   187	    except (OSError, UnicodeDecodeError, LexError) as e:
   188	        print(f"error: {e}", file=sys.stderr); sys.exit(3)
   189	    print(f"usage: {sys.argv[0]} scan RE FILE... | examples SRC DST FILE...", file=sys.stderr)
   190	    sys.exit(2)
     1	#!/usr/bin/env bash
     2	# Bounded runs: a timeout is INCOMPLETE, never a failure and never a pass.
     3	#
     4	# The rule (docs/project/PROMOTION_PIPELINE.md, result vocabulary): a test that exceeds its time budget
     5	# has produced no observation. Under machine load a freshly linked binary or a compile can overrun
     6	# a budget sized for an idle machine (test_ssa.sh once reported hundreds of 5-second alarms as
     7	# failures), so a timeout is re-run once, alone, with a larger budget:
     8	#   - the re-run completes      -> its result is judged normally (pass or FAIL), recorded "recovered";
     9	#   - the re-run times out too  -> INCOMPLETE: not a pass, not a failure. A gate with an incomplete
    10	#                                  result exits nonzero, and a qualifying run contains none.
    11	#
    12	# Each attempt runs under lib/bounded_exec.py, which makes the command the leader of a new process
    13	# group, reports its outcome through a status file (never through the command's own streams, so
    14	# nothing the command prints can fake or hide a timeout) and, when the budget expires, sends SIGTERM
    15	# and then SIGKILL to the whole group, so no descendant outlives the attempt into the retry.
    16	#
    17	# Sourcing (`BOUNDED_PARENT="$TMP"; source scripts/checks/lib/bounded.sh`) gives the gate PRIVATE
    18	# state: a fresh directory (mktemp under BOUNDED_PARENT, else $TMPDIR) with an outcome file and a
    19	# log. Every sourcing creates its own directory, so nested or parallel gates never share state.
    20	# With BOUNDED_PARENT under the gate's own scratch directory, its cleanup removes the state too.
    21	#
    22	#   bounded_run [-i STDIN_FILE] [-r RETRY_SECS] SECS -- CMD [ARGS...]
    23	#     Runs CMD (an executable, not a shell function). Its stdout and stderr are buffered per
    24	#     attempt and only a COMPLETED attempt's output is written: an incomplete run writes nothing,
    25	#     so output-matching checks never pass on the partial output of a run that hung. Without -i the
    26	#     command inherits stdin, which a re-run cannot replay: callers that feed input pass -i.
    27	#     Returns CMD's status, or 124 when it timed out on both attempts or the runner reported no
    28	#     outcome. SECS and RETRY_SECS are positive decimal seconds. A command may itself exit
    29	#     124, so test with `bounded_is_incomplete "$rc"`, which also reads the outcome bounded_run
    30	#     recorded (this works across `( cd dir && bounded_run ... )` subshells; run one bounded_run
    31	#     at a time per sourcing). RETRY_SECS defaults to BOUNDED_RETRY_FACTOR (2) times SECS.
    32	#   bounded_summary
    33	#     Lists this gate's recovered and incomplete runs; gates print it before their final tally.
    34	#   bounded_watchdog SECS  -> sets the array TO for the watchdog form: "${TO[@]}" CMD [ARGS...]
    35	#     runs CMD through `bash bounded.sh SECS` in a separate process with the same retry; on a second
    36	#     timeout it writes no command output, prints "INCOMPLETE: ..." on stderr and exits 124. Its
    37	#     recovered and incomplete lines go to this gate's log (handed over on its command line).
    38	#   bounded_gate_status
    39	#     The end-of-gate verdict for a gate using the watchdog form: lists recovered, incomplete and
    40	#     runner-failed runs, removes the state directory, and returns 1 when any run was incomplete or
    41	#     the runner failed, so the gate exits nonzero whatever its own checks concluded from a hung
    42	#     command's empty output. Last line:
    43	#       bounded_gate_status && [ "$FAIL" -eq 0 ]
    44	#
    45	# If the runner itself fails (no outcome reported), the command's output is discarded and the run
    46	# is incomplete (status 124, a "runner-failed" log line): never a pass. If the runner is cancelled (the
    47	# gate is interrupted or terminated), it kills the command's group first.
    48	#
    49	# Without python3 commands run directly with no watchdog: one warning when the gate sources this
    50	# file, never inside a command's output, and the watchdog form then runs commands directly too.
    51	# Such a run is never incomplete.
    52	
    53	BOUNDED_RETRY_FACTOR="${BOUNDED_RETRY_FACTOR:-2}"
    54	if [[ "$BOUNDED_RETRY_FACTOR" =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk -v f="$BOUNDED_RETRY_FACTOR" 'BEGIN { exit !(f + 0 >= 1) }'; then :
    55	else echo "bounded.sh: BOUNDED_RETRY_FACTOR must be a number >= 1; using 2" >&2; BOUNDED_RETRY_FACTOR=2; fi
    56	# _bounded_secs_ok S: S is a positive decimal number of seconds (fractions allowed).
    57	_bounded_secs_ok() { [[ "$1" =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk -v s="$1" 'BEGIN { exit !(s + 0 > 0) }'; }
    58	# Fixed-point, trailing zeros trimmed: never scientific notation, which _bounded_secs_ok rejects.
    59	_bounded_mul() { awk -v s="$1" -v f="$2" 'BEGIN { r = sprintf("%.6f", s * f); sub(/0+$/, "", r); sub(/\.$/, "", r); print r }'; }
    60	BOUNDED_SH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
    61	BOUNDED_EXEC="$(dirname "$BOUNDED_SH")/bounded_exec.py"
    62	BOUNDED_DIR="$(mktemp -d "${BOUNDED_PARENT:-${TMPDIR:-/tmp}}/bounded.XXXXXX")"
    63	BOUNDED_OUTCOME_FILE="$BOUNDED_DIR/outcome"
    64	BOUNDED_LOG="$BOUNDED_DIR/log"
    65	# The watchdog form appends to its caller's log, handed over explicitly on its command line.
    66	if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    67	  # A standalone watchdog removes its state however it ends.
    68	  trap 'rm -rf "$BOUNDED_DIR"' EXIT
    69	  [ -z "${BOUNDED_WATCHDOG_LOG:-}" ] || BOUNDED_LOG="$BOUNDED_WATCHDOG_LOG"
    70	fi
    71	: >> "$BOUNDED_LOG"
    72	BOUNDED_HAVE_WATCHDOG=1
    73	if ! command -v python3 >/dev/null 2>&1; then
    74	  BOUNDED_HAVE_WATCHDOG=0
    75	  [ "${BASH_SOURCE[0]}" = "$0" ] || echo "  warn python3 not found — commands run without a hang watchdog" >&2
    76	fi
    77	
    78	bounded_is_incomplete() {
    79	  [ "$1" = 124 ] && [ "$(cat "$BOUNDED_OUTCOME_FILE" 2>/dev/null)" = incomplete ]
    80	}
    81	
    82	bounded_run() {
    83	  local stdin_file="" retry="" secs="" rc tries=0 budget tmp outcome
    84	  while [ $# -gt 0 ]; do
    85	    case "$1" in
    86	      -i) stdin_file="$2"; shift 2 ;;
    87	      -r) retry="$2"; shift 2 ;;
    88	      --) shift; break ;;
    89	      *) if [ -z "$secs" ]; then secs="$1"; shift; else break; fi ;;
    90	    esac
    91	  done
    92	  [ -n "$secs" ] && [ $# -gt 0 ] || { echo "bounded_run: usage: bounded_run [-i FILE] [-r SECS] SECS -- CMD..." >&2; return 2; }
    93	  [ -n "$retry" ] || retry="$(_bounded_mul "$secs" "$BOUNDED_RETRY_FACTOR")"
    94	  if ! _bounded_secs_ok "$secs" || ! _bounded_secs_ok "$retry"; then
    95	    echo "bounded_run: budgets must be positive numbers of seconds (got $secs, retry $retry)" >&2; return 2
    96	  fi
    97	  echo done > "$BOUNDED_OUTCOME_FILE"
    98	  if [ "$BOUNDED_HAVE_WATCHDOG" != 1 ]; then
    99	    if [ -n "$stdin_file" ]; then "$@" < "$stdin_file"; else "$@"; fi
   100	    return $?
   101	  fi
   102	  tmp="$(mktemp -d "$BOUNDED_DIR/run.XXXXXX")"
   103	  budget="$secs"
   104	  while :; do
   105	    tries=$((tries + 1))
   106	    rm -f "$tmp/status"
   107	    if [ -n "$stdin_file" ]; then
   108	      python3 -I "$BOUNDED_EXEC" --timeout "$budget" --kill-after "${BOUNDED_KILL_AFTER:-10}" --status "$tmp/status" -- "$@" < "$stdin_file" > "$tmp/out" 2> "$tmp/err"
   109	    else
   110	      python3 -I "$BOUNDED_EXEC" --timeout "$budget" --kill-after "${BOUNDED_KILL_AFTER:-10}" --status "$tmp/status" -- "$@" > "$tmp/out" 2> "$tmp/err"
   111	    fi
   112	    outcome="$(cat "$tmp/status" 2>/dev/null)"
   113	    case "$outcome" in
   114	      "exit "*) break ;;
   115	      timeout) [ "$tries" = 1 ] || break; budget="$retry" ;;
   116	      *) outcome=runner-failed; break ;;
   117	    esac
   118	  done
   119	  if [ "$outcome" = timeout ]; then
   120	    echo incomplete > "$BOUNDED_OUTCOME_FILE"
   121	    echo "incomplete ${secs}s+${retry}s $*" >> "$BOUNDED_LOG"
   122	    rc=124
   123	  elif [ "$outcome" = runner-failed ]; then
   124	    # The runner reported nothing (it failed or was cancelled): no observation, so the run is
   125	    # incomplete exactly as a double timeout is (status 124, bounded_is_incomplete true).
   126	    echo "bounded_run: the runner reported no outcome for: $*" >&2
   127	    echo incomplete > "$BOUNDED_OUTCOME_FILE"
   128	    echo "runner-failed ${secs}s $*" >> "$BOUNDED_LOG"
   129	    rc=124
   130	  else
   131	    cat "$tmp/out"; cat "$tmp/err" >&2
   132	    rc="${outcome#exit }"
   133	    [ "$tries" = 2 ] && echo "recovered ${secs}s $*" >> "$BOUNDED_LOG"
   134	  fi
   135	  rm -rf "$tmp"
   136	  return "$rc"
   137	}
   138	
   139	bounded_summary() {
   140	  local nrec ninc
   141	  nrec=$(grep -c '^recovered' "$BOUNDED_LOG" 2>/dev/null || true); nrec=${nrec:-0}
   142	  ninc=$(grep -c '^incomplete\|^runner-failed' "$BOUNDED_LOG" 2>/dev/null || true); ninc=${ninc:-0}
   143	  [ "$nrec" -gt 0 ] || [ "$ninc" -gt 0 ] || return 0
   144	  echo "Bounded runs: $nrec recovered (timed out, then completed alone), $ninc incomplete (timed out twice, or the runner failed):"
   145	  sed 's/^/  /' "$BOUNDED_LOG"
   146	}
   147	
   148	bounded_watchdog() {
   149	  if [ "$BOUNDED_HAVE_WATCHDOG" = 1 ]; then
   150	    TO=(env "BOUNDED_WATCHDOG_LOG=$BOUNDED_LOG" "BOUNDED_PARENT=$BOUNDED_DIR" bash "$BOUNDED_SH" "$1")
   151	  else
   152	    TO=(env)  # no python3: run commands directly (the gate warned once when it sourced this file)
   153	  fi
   154	}
   155	
   156	bounded_gate_status() {
   157	  local ninc
   158	  bounded_summary
   159	  ninc=$(grep -c '^incomplete\|^runner-failed' "$BOUNDED_LOG" 2>/dev/null || true); ninc=${ninc:-0}
   160	  [ "$ninc" -eq 0 ] || echo "INCOMPLETE: $ninc command(s) timed out twice or lost their runner: this run is incomplete, not passed"
   161	  rm -rf "$BOUNDED_DIR"
   162	  [ "$ninc" -eq 0 ]
   163	}
   164	
   165	# Watchdog form: `bash bounded.sh SECS CMD...` (through bounded_watchdog's TO array).
   166	if [ "${BASH_SOURCE[0]}" = "$0" ]; then
   167	  [ $# -ge 2 ] || { echo "usage: bash $0 SECS CMD [ARGS...]" >&2; exit 2; }
   168	  secs="$1"; shift
   169	  bounded_run "$secs" -- "$@"; rc=$?
   170	  if bounded_is_incomplete "$rc"; then
   171	    echo "INCOMPLETE: timed out twice (${secs}s, then $(_bounded_mul "$secs" "$BOUNDED_RETRY_FACTOR")s alone) or lost its runner: $*" >&2
   172	  fi
   173	  exit "$rc"
   174	fi
     1	#!/usr/bin/env python3
     2	"""The rule gate's checks (scripts/spec/rules.sh): the registered rules against the sources.
     3	
     4	  rules.py RULES.jsonl SRC_DIR   RULES.jsonl is scripts/spec/rules.lean's output; SRC_DIR holds the
     5	                                 specification's .lean sources (searched recursively).
     6	
     7	Prints `ok`/`FAIL` lines; exits 1 on any failure, 3 when an input cannot be read or lexed.
     8	A rule's doc comment must cite a decision row; each rule needs an example whose doc comment says
     9	``Accepted (rule `Name`)`` and one that says ``Refused (rule `Name`)``; every ``(rule `Name`)``
    10	anywhere in a source (either kind of comment, or a literal) must name a registered rule; no rule is registered twice; revisions are >= 1.
    11	"""
    12	import json, os, re, sys
    13	
    14	sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "proofs"))
    15	import lean_lex  # noqa: E402
    16	
    17	ROW = re.compile(r"\b(Q\d+(\.\d+)+|OD\d+|P\d+|R-\d{4})\b")
    18	CITE = re.compile(r"\(rule `([^`\s]+)`\)")
    19	VERDICT = re.compile(r"\b(Accepted|Refused) \(rule `([^`\s]+)`\)")
    20	EXAMPLE_AFTER = re.compile(r"\s*example(?![\w'!?])")
    21	
    22	
    23	def main(rules_path, src_dir):
    24	    fails = []
    25	    rules = [json.loads(l) for l in open(rules_path, encoding="utf-8") if l.strip()]
    26	    if not rules or rules[-1] != {"end": True}:
    27	        print("error: the rule listing is truncated (no end record)", file=sys.stderr); return 3
    28	    rules = rules[:-1]
    29	    names = [r["name"] for r in rules]
    30	    for n in sorted({n for n in names if names.count(n) > 1}):
    31	        fails.append(f"rule {n} is registered more than once")
    32	    for r in rules:
    33	        if not r["exists"]: fails.append(f"rule {r['name']} names no declaration")
    34	        if r["rev"] < 1: fails.append(f"rule {r['name']} has revision {r['rev']} (revisions start at 1)")
    35	        if not r["doc"].strip(): fails.append(f"rule {r['name']} has no doc comment")
    36	        elif not ROW.search(r["doc"]): fails.append(f"rule {r['name']}'s doc comment cites no decision row")
    37	    seen = {n: set() for n in names}
    38	    for dirpath, _, files in os.walk(src_dir):
    39	        for f in sorted(files):
    40	            if not f.endswith(".lean"): continue
    41	            path = os.path.join(dirpath, f)
    42	            try:
    43	                src = open(path, encoding="utf-8").read(); spans = []
    44	                lean_lex.lex(src, spans)
    45	            except (OSError, UnicodeDecodeError, lean_lex.LexError) as e:
    46	                print(f"error: {path}: {e}", file=sys.stderr); return 3
    47	            # citations anywhere in the file (comments of both kinds, and literals: fail closed)
    48	            for m in CITE.finditer(src):
    49	                if m.group(1) not in seen:
    50	                    line = src.count("\n", 0, m.start()) + 1
    51	                    fails.append(f"{path}:{line}: cites unregistered rule {m.group(1)}")
    52	            for a, b in spans:
    53	                text, line = src[a:b], src.count("\n", 0, a) + 1
    54	                verdicts = VERDICT.findall(text)
    55	                if not verdicts: continue
    56	                if not (text.startswith("/--") and EXAMPLE_AFTER.match(src, b)):
    57	                    fails.append(f"{path}:{line}: a verdict citation outside an example's doc comment")
    58	                    continue
    59	                for v, n in verdicts:
    60	                    if n in seen: seen[n].add(v)
    61	    for n in names:
    62	        for v in ("Accepted", "Refused"):
    63	            if v not in seen[n]: fails.append(f"rule {n} has no example marked {v} (rule `{n}`)")
    64	    for f in fails: print(f"  FAIL {f}")
    65	    if not fails: print(f"  ok   {len(rules)} registered rules, each documented with a decision row and"
    66	                        " an accepted and a refused example; every citation names a registered rule")
    67	    return 1 if fails else 0
    68	
    69	
    70	if __name__ == "__main__":
    71	    if len(sys.argv) != 3:
    72	        print(f"usage: {sys.argv[0]} RULES.jsonl SRC_DIR", file=sys.stderr); sys.exit(2)
    73	    sys.exit(main(sys.argv[1], sys.argv[2]))
   120	        run: bash scripts/checks/run.sh
   121	
   122	  spec:
   123	    name: Spec build
   124	    needs: landing-record
   125	    if: ${{ !cancelled() && needs.landing-record.outputs.recorded != 'true' }}
   126	    runs-on: ${{ (github.event_name != 'pull_request' && vars.CONCRETE_SELF_HOSTED == 'true') && fromJSON('["self-hosted","linux","x64","concrete"]') || 'ubuntu-latest' }}
   127	    steps:
   128	      - uses: actions/checkout@v4
   129	
   130	      - name: Install Nix (GitHub-hosted only)
   131	        if: runner.environment != 'self-hosted'
   132	        uses: cachix/install-nix-action@v31
   133	        with:
   134	          extra_nix_config: |
   135	            experimental-features = nix-command flakes
   136	
   137	      - name: Install Lean (via lean-action)
   138	        id: lean_install
   139	        # A toolchain download can fail on a dropped connection; one paused retry keeps a network
   140	        # blip from failing (and hiding) the whole run.
   141	        continue-on-error: true
   142	        uses: leanprover/lean-action@v1
   143	        with:
   144	          build-args: "--log-level=warning"
   145	
   146	      - name: Wait before retrying the Lean install
   147	        if: steps.lean_install.outcome == 'failure'
   148	        run: sleep 60
   149	
   150	      - name: Install Lean (via lean-action) (retry)
   151	        if: steps.lean_install.outcome == 'failure'
   152	        uses: leanprover/lean-action@v1
   153	        with:
   154	          build-args: "--log-level=warning"
   155	
   156	      - name: Build the specification, warnings refused
   157	        run: |
   158	          OUTPUT=$(lake build 2>&1) || { echo "$OUTPUT"; exit 1; }
   159	          if printf '%s\n' "$OUTPUT" | grep -i "warning"; then
   160	            echo "::error::Build produced warnings"
   161	            printf '%s\n' "$OUTPUT"
   162	            exit 1
   163	          fi
   164	
   165	      - name: Rule gate (scripts/spec/rules.sh)
   166	        run: bash scripts/spec/rules.sh
   167	
   168	  # PROOF INTEGRITY (scripts/proofs). Four jobs, each required, each with its own negative controls:
   169	  # the per-theorem axiom inventory against its golden list, the transitive sorry/native_decide ban,
   170	  # the fresh kernel replay (leanchecker) and the independent re-check (con-leche, nanoda). The spec
   171	  # is built in each (lean-action); a failed build fails the job before the check runs.
   172	  proof-axioms:
   173	    name: Proof axioms
   174	    needs: landing-record
   175	    if: ${{ !cancelled() && needs.landing-record.outputs.recorded != 'true' }}
