#!/usr/bin/env bash
# The gate environment guard. Every gate sources this first:
#
#   source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
#
# Gates run in three places: the dev shell, Linux CI runners and the macOS CI runner. When each took
# coreutils, sed, grep, python and the rest from whatever host it landed on, a gate could pass on one
# and fail on another for reasons unrelated to what it tests: macOS has no `timeout`, and BSD `sed -i`,
# `stat`, `date` and `readlink` take other flags. flake.nix now defines that userland once (the
# `gates` shell), CI runs every step inside it, and the dev shells include it. Each of those shells
# exports CONCRETE_GATES_SHELL=1; a gate started anywhere else refuses here, before it can produce a
# verdict about the wrong environment.
#
# Use `nix develop .#gates` (no Lean; what CI uses, with elan's Lean on PATH) or `nix develop` (the
# dev shell, with its own Lean). An entry point that must start outside both, like the pre-push
# hook, re-executes itself inside `nix develop` before it runs a gate.
#
# check_gate_hygiene.sh proves every gate sources this file.

if [ "${CONCRETE_GATES_SHELL:-}" != 1 ]; then
  echo "error: ${0##*/} refuses to run outside the gate shell: run inside nix develop .#gates (CI) or nix develop" >&2
  exit 2
fi

# Every gate matches text with has_match, never a pipe into grep -q (bug 283).
source "$(dirname "${BASH_SOURCE[0]}")/has_match.sh" || exit 2
     1	import ConcreteSpec.Spec.Basics
     2	
     3	/-!
     4	# Identities, sites and versions
     5	
     6	PROPOSED: not normative until the owner freezes Core (ROADMAP A2c). Part of `ConcreteSpec.Spec`;
     7	see `ConcreteSpec/README.md`.
     8	
     9	Core names everything by a typed identity, never by a bare string or number: a local, a
    10	declaration, a field, a function, a module, an instance, a loop label, a brand, an allocator
    11	lineage, a loan, a grant, a block, a capability variable and a theorem each have their own type,
    12	so one can never stand for another, and two declarations with the same source name in different
    13	modules are different declarations (the facts decision: no bare-name collisions). A declaration,
    14	field, variant or function is named by its module (or owner) and its source name, and both are
    15	part of its identity. A local is numbered by elaboration and keeps its source name as a hint for
    16	diagnostics. Equality of identities is what the rules use.
    17	
    18	A *site* (`SiteId`) is one per operation and per refusable statement. Diagnostics, facts, traps
    19	and discharge tokens are keyed by site; a program's site table maps each site to its source
    20	`Span`, which elaboration produces (README obligation O1).
    21	
    22	A rule is cited by `RuleId`: the Lean name of the declaration that states it and that rule's own
    23	revision. Every output carries one `specVersion`. Which rules exist is the registry in `Rules`;
    24	this module depends on nothing downstream.
    25	
    26	These types are part of the diagnostics and facts interface: the Lean types are the source of its
    27	JSON schema (owner decision 2026-11-07), so a field's name is part of the interface and renaming
    28	one is an interface change.
    29	-/
    30	
    31	namespace ConcreteSpec.Core
    32	
    33	/-- A local variable: a source-name hint and a number. Both fields are part of the identity.
    34	Elaboration gives every local of a function its own number (a local is bound at most once, Q9.1)
    35	and its source name as the hint, so two locals of one function never share a number; the hint is
    36	for diagnostics. -/
    37	structure Var where
    38	  hint : String
    39	  id : Nat
    40	  deriving DecidableEq, Repr
    41	
    42	/-- A module, by its path from the package root (`["std", "bytes"]`). -/
    43	structure ModuleId where
    44	  path : List String
    45	  deriving DecidableEq, Repr
    46	
    47	/-- A type declaration (a struct or an enum): its module and its name there. Declaration names are
    48	nominal (Q9.2): two declarations are the same exactly when their identities are equal. -/
    49	structure DeclId where
    50	  module : ModuleId
    51	  name : String
    52	  deriving DecidableEq, Repr
    53	
    54	/-- A variant of an enum declaration, by its declaration and name. -/
    55	structure VariantId where
    56	  decl : DeclId
    57	  name : String
    58	  deriving DecidableEq, Repr
    59	
    60	/-- What a field belongs to: a struct declaration, or one variant of an enum. -/
    61	inductive FieldOwner where
    62	  | struct (d : DeclId)
    63	  | variant (v : VariantId)
    64	  deriving DecidableEq, Repr
    65	
    66	/-- A field, by its owner and name: two variants of one enum may each have a field `value`, and
    67	they are different fields. -/
    68	structure FieldId where
    69	  owner : FieldOwner
    70	  name : String
    71	  deriving DecidableEq, Repr
    72	
    73	/-- A function: its module and its name there. -/
    74	structure FnId where
    75	  module : ModuleId
    76	  name : String
    77	  deriving DecidableEq, Repr
    78	
    79	/-- A trait instance, numbered by elaboration. -/
    80	structure InstanceId where
    81	  id : Nat
    82	  deriving DecidableEq, Repr
    83	
    84	/-- A loop label (Q9.3): `break L` and `continue L` name the loop they leave. -/
    85	structure LoopId where
    86	  id : Nat
    87	  deriving DecidableEq, Repr
    88	
    89	/-- An allocator brand (Q1.1): a compile-time name for one allocator, erased at run time. -/
    90	structure BrandId where
    91	  id : Nat
    92	  deriving DecidableEq, Repr
    93	
    94	/-- An allocator lineage: an allocator and every allocator a reset of it produces. Sized
    95	allocation is accounted per lineage (the memory decision of 2026-11-06). -/
    96	structure LineageId where
    97	  id : Nat
    98	  deriving DecidableEq, Repr
    99	
   100	/-- A loan: one open borrow, from its opening to the end of its block. -/
   101	structure LoanId where
   102	  id : Nat
   103	  deriving DecidableEq, Repr
   104	
   105	/-- A grant parameter of `main` (the authority rules, Q5.1–Q5.4). -/
   106	structure GrantId where
   107	  id : Nat
   108	  deriving DecidableEq, Repr
   109	
   110	/-- A block, the scope of a `defer` and of a borrow (Q3.7). -/
   111	structure BlockId where
   112	  id : Nat
   113	  deriving DecidableEq, Repr
   114	
   115	/-- A capability variable, a parameter of a function's `with(...)` (Q5.1–Q5.4). -/
   116	structure CapVarId where
   117	  id : Nat
   118	  deriving DecidableEq, Repr
   119	
   120	/-- A theorem a `#[proof(...)]` attribute names. It is resolved to the theorem's Lean declaration
   121	(rule 13), never matched as text. -/
   122	structure TheoremId where
   123	  name : Lean.Name
   124	  deriving DecidableEq, Repr
   125	
   126	/-- A site: one operation or one refusable statement. -/
   127	structure SiteId where
   128	  id : Nat
   129	  deriving DecidableEq, Repr
   130	
   131	/-- A position in source text (the trap-line decision, R-0496): the file's path relative to the
   132	project root, with forward slashes, and a line and a column, both counted from 1. The type keeps
   133	line and column positive; that the path is relative with forward slashes is `Span.PathOk`, which
   134	the program's site table must satisfy (elaboration, README obligation O1). The unit a column
   135	counts (bytes, Unicode scalar values) is not yet decided; it is an owner question. -/
   136	structure Span where
   137	  path : String
   138	  line : Nat
   139	  col : Nat
   140	  line_pos : 0 < line
   141	  col_pos : 0 < col
   142	  deriving DecidableEq, Repr
   143	
   144	/-- A span's path is relative to the project root and uses forward slashes: it is not empty,
   145	does not start with `/`, and holds no `\`. -/
   146	def Span.PathOk (sp : Span) : Prop :=
   147	  sp.path.toList ≠ [] ∧ sp.path.toList.head? ≠ some '/' ∧ '\\' ∉ sp.path.toList
   148	
   149	instance (sp : Span) : Decidable sp.PathOk := by unfold Span.PathOk; infer_instance
   150	
   151	/-- A slice of the language, in the agreed slice order: 0 to 28, concurrency last (2026-11-07). -/
   152	structure SliceId where
   153	  n : Fin 29
   154	  deriving DecidableEq, Repr
   155	
   156	/-- A rule's identity: the Lean name of the declaration that states it and the rule's own
   157	revision, bumped whenever its meaning changes, including through a definition it depends on
   158	(R-0593, R-0603). -/
   159	structure RuleId where
   160	  name : Lean.Name
   161	  rev : Nat
   162	  deriving DecidableEq, Repr
   163	
   164	/-- A version of this specification: `0.x` before the freeze, `1.0` at the freeze (A2c), bumped
   165	by every normative change (R-0603). -/
   166	structure SpecVersion where
   167	  major : Nat
   168	  minor : Nat
   169	  deriving DecidableEq, Repr
   170	
   171	/-- The version every output carries, in one header covering all its records. -/
   172	def specVersion : SpecVersion := ⟨0, 1⟩
   173	
   174	/-! ### Examples -/
   175	
   176	/-- Two declarations named `Pair` in different modules are different declarations. -/
   177	example : DeclId.mk ⟨["a"]⟩ "Pair" ≠ DeclId.mk ⟨["b"]⟩ "Pair" := by decide
   178	
   179	/-- A field belongs to its owner: `a` of `Pair` is not `a` of `Point`, and `value` of variant
   180	`Some` is not `value` of variant `Ok`. -/
   181	example : FieldId.mk (.struct ⟨⟨[]⟩, "Pair"⟩) "a" ≠ FieldId.mk (.struct ⟨⟨[]⟩, "Point"⟩) "a" := by
   182	  decide
   183	
   184	example : FieldId.mk (.variant ⟨⟨⟨[]⟩, "E"⟩, "A"⟩) "value" ≠
   185	    FieldId.mk (.variant ⟨⟨⟨[]⟩, "E"⟩, "B"⟩) "value" := by decide
   186	
   187	/-- The first and the last slice. -/
   188	example : (SliceId.mk 0).n.val = 0 ∧ (SliceId.mk 28).n.val = 28 := ⟨rfl, rfl⟩
   189	
   190	/-- A span path is relative, with forward slashes. -/
   191	example : (Span.mk "src/main.con" 3 5 (by decide) (by decide)).PathOk := by decide
   192	
   193	example : ¬ (Span.mk "/abs/main.con" 3 5 (by decide) (by decide)).PathOk := by decide
   194	
   195	example : ¬ (Span.mk "src\\main.con" 3 5 (by decide) (by decide)).PathOk := by decide
   196	
   197	/-- Two locals named `x` that elaboration numbered differently (in two separate blocks, say) are
   198	different locals. -/
   199	example : Var.mk "x" 0 ≠ Var.mk "x" 1 := by decide
   200	
   201	/-- The hint is part of the identity too; elaboration never gives two locals one number, so this
   202	pair never arises from a program. -/
   203	example : Var.mk "x" 0 ≠ Var.mk "y" 0 := by decide
   204	
   205	/-- A revised rule is a different rule identity. -/
   206	example : RuleId.mk `ConcreteSpec.Core.example 1 ≠ RuleId.mk `ConcreteSpec.Core.example 2 := by
   207	  decide
   208	
   209	/-- Before the freeze the version is `0.x`. -/
   210	example : specVersion.major = 0 := rfl
   211	
   212	end ConcreteSpec.Core
     1	# Reading the Concrete specification
     2	
     3	**Status: PROPOSED.** This is the specification of the new compiler, written in Lean (decision
     4	rows Q9.15, P3: Lean is the specification). It is not normative until the owner freezes Core at
     5	stage A2c (row Q9.19). Before that, the owner approved the Core design provisionally (A2a,
     6	2026-11-05), and A2b formalized it here and checked the four design theorems (row Q9.14).
     7	
     8	## How to read it
     9	
    10	[`Spec.lean`](Spec.lean) is the specification library (row Q9.15; split into modules by owner
    11	decision 2026-11-06). It imports the modules under [`Spec/`](Spec/) in reading order, and each
    12	module's header says what it covers. Every rule is a Lean definition with a plain-English doc
    13	comment, followed by example programs: the surface program in a doc comment, its Core form, and
    14	what the rules say about it: accepted (`check p = true`) with its outcome (`run p 10 = .exit 42`),
    15	or refused (`check p = false`). You can read it without reading any proof.
    16	
    17	[`Proofs/`](Proofs/) says why the rules hang together. Read it only to check a claim.
    18	
    19	**The owner view.** `scripts/spec/lean_site.sh [OUT]` (after `lake build ConcreteSpec`) generates
    20	a static HTML view into `_build/spec-site/`: every module rendered from its source (doc comments as
    21	prose, rules and examples as code with linked names), each declaration with what it uses and which
    22	proofs are about it, and a page of all theorems with their statements. It is generated from the
    23	sources and the elaborated environment only, and fails on a broken link.
    24	
    25	The decisions are cited by row id (Q1.1 … Q9.19, P1 … P23, in
    26	[docs/decisions.md](../docs/decisions.md)) and by rule id (ODnn, TYPE-n, OWN-n, …, in the
    27	archived prose specification [legacy/docs/spec](../legacy/docs/spec)).
    28	
    29	## Rules of the file
    30	
    31	- Only Lean core is imported, no Mathlib (Q9.16). No `sorry`, no `native_decide` (Q9.17), and
    32	  `autoImplicit` is off, so a misspelled name is an error, never a silently bound variable.
    33	- Axioms: only Lean's standard `propext`, `Quot.sound` and `Classical.choice`. The evaluator
    34	  `run`, the checker `check` and the other executable definitions use `propext` alone, so they
    35	  stay executable and the examples are decided by running them; `Classical.choice` appears only
    36	  in proofs (`rep_roundtrip` through the core lemma `Nat.mod_mul`, and the range proofs).
    37	- These rules are checked in CI by [scripts/proofs](../scripts/proofs): the per-theorem axiom
    38	  inventory against its golden list, the transitive ban on `sorry` and `native_decide`, a fresh
    39	  kernel replay with `leanchecker`, and an independent re-check of the exported theorems by
    40	  con-leche and nanoda.
    41	- Every rule a diagnostic can name is registered in [`Spec/Rules.lean`](Spec/Rules.lean) by its
    42	  Lean name and revision. The rule gate ([scripts/spec/rules.sh](../scripts/spec/rules.sh), run by
    43	  CI's Spec build) requires each registered rule to cite its decision row and to have an example
    44	  it accepts and one it refuses, and every rule citation to name a registered rule.
    45	- The judgments (inductive relations) are the normative form; the checker is proved to agree with
    46	  them (`check_iff`).
    47	- Build: `lake build ConcreteSpec`. The external checker re-checks every theorem.
    48	
    49	## What remains open
    50	
    51	The parts are separate Core fragments, each defined only as far as its theorems need (R4 F8);
    52	unifying them into one Core is A2i work (R-0571).
    53	
    54	Open obligations, by name:
    55	
    56	- **O1 Elaboration** from surface syntax to Core: how literals get a type, how names become
    57	  identities, how nested expressions and grouping become A-normal form, source positions, and that
    58	  acceptance of a source program does not depend on how the elaborator names temporaries.
    59	- **O2 The lexer, model-translation and native-image obligations.**
    60	- **O3 Instrumentation erasure** (Q9.10): the ownership instrumentation (`Slot.moved`, the
    61	  `used`, `live`, `known` and `kfields` fields of `Entry`) is stated as intent, with no erasure
    62	  definition or theorem yet. (Brand erasure, part 5, is done.)
    63	- **O4 Trap diagnostics** (Q7.10, OD101): the bytes of the trap line, including the trap's source
    64	  location (needs O1's positions), and of the startup refusal.
    65	- **O5 Target observations** (the launcher contract): every result here is about the model's
    66	  outcomes; a claim about an executable needs a transport to the approved launcher contract.
    67	- **O6 Launch validation** (part 6): `ProgOk` assumes a valid launch: instance limits, the target
    68	  offering each parameter type, and the launcher's grant minting are not modelled; nor are
    69	  authority rule 11, foreign calls, trait dispatch, generic methods and generated cleanup.
    70	- **O7 Capabilities in the other parts**: the cleanup calls of part 3 and the allocator
    71	  operations of part 5 need capabilities; part 6 checks capabilities in its own fragment only
    72	  (unification, A2i).
    73	- **O8 Part 3** abstracts each deferred call to its identity, dependencies, loans and whether it
    74	  traps; it does not model the statements between registrations or evaluating a `return` value
    75	  before cleanup.
    76	- **O9 Part 4**: the run-time fragment (`vrun`) and the access rules (`Ok`) are separate
    77	  fragments, not yet joined in one soundness theorem (A2i); the run covers array sources (text
    78	  views share the index arithmetic, and their validity is `text_view_utf8`); views of views,
    79	  writes through text views, and text whose length is known while its bytes are not (treated as
    80	  unknown) are not modelled; the frame theorem covers bodies that access only their view. That
    81	  compiled code performs the same range check is a compiler-slice obligation (O5).
    82	- **O10 Part 5** abstracts the condition of `while`: loop test number `k` takes the outcome
    83	  `σ k`, and the results hold for every `σ`.

