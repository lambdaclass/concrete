    28	            runner: ubuntu-latest
    29	          - arch: aarch64-macos
    30	            runner: macos-15
    31	    runs-on: ${{ matrix.runner }}
    32	    timeout-minutes: 60
    33	    permissions:
    34	      contents: read
    35	    steps:
    36	      - uses: actions/checkout@v4
    37	      - name: Install Nix
    38	        uses: cachix/install-nix-action@v31
    39	      - name: Backend gate (LLVM and LCB, native)
    40	        run: nix develop --command bash scripts/checks/slice0_backends.sh
    41	
    42	  artifacts:
    43	    name: Slice 0 artifacts (${{ matrix.arch }})
    44	    strategy:
    45	      fail-fast: false
    46	      matrix:
    47	        include:
    48	          - arch: x86-64
    49	            runner: ubuntu-latest
    50	          - arch: aarch64-macos
    51	            runner: macos-15
    52	    runs-on: ${{ matrix.runner }}
    53	    timeout-minutes: 60
    54	    permissions:
    55	      contents: read
    56	    steps:
    57	      - uses: actions/checkout@v4
    58	      - name: Install Nix
    59	        uses: cachix/install-nix-action@v31
    60	      - name: Sanitizers, binary size (report-only) and stack bound (gates 10, 11, 12)
    61	        run: nix develop --command timeout 3000 bash scripts/checks/slice0_artifacts.sh report
    62	      - uses: actions/upload-artifact@v4
    63	        if: always()
    64	        with:
    65	          name: artifacts-${{ matrix.arch }}
    66	          path: report
    67	          if-no-files-found: error
    68	
    69	  trusted-base:
    70	    name: Slice 0 trusted base (gate 9)
    71	    runs-on: ubuntu-latest
    72	    timeout-minutes: 60
    73	    permissions:
    74	      contents: read
    75	    steps:
    76	      - uses: actions/checkout@v4
    77	      - name: Install Nix
    78	        uses: cachix/install-nix-action@v31
    79	      - name: Trusted-base golden (premises, axioms, toolchain and LCB pin)
    80	        run: nix develop --command timeout 3000 bash scripts/checks/slice0_trusted_base.sh
    81	
    82	  reproducibility:
    83	    name: Reproducibility (${{ matrix.id }})
    84	    strategy:
    85	      fail-fast: false
    86	      matrix:
    87	        include:
    88	          - id: linux-first
    89	            runner: ubuntu-24.04
    90	          - id: linux-independent
    91	            runner: ubuntu-24.04
    92	          - id: macos
    93	            runner: macos-15
    94	    runs-on: ${{ matrix.runner }}
    95	    timeout-minutes: 60
    96	    permissions:
    97	      contents: read
    98	    steps:
    99	      - uses: actions/checkout@v4
   100	      - uses: cachix/install-nix-action@v31
