  2050	
  2051	/-- The result word LCB's semantics gives the adapted body, with `fuel` steps. -/
  2052	def evalBody (f : Source.Function) (fuel : Nat) : Option Nat :=
  2053	  match Source.evaluateFunction f #[] fuel with
  2054	  | .returned (.word w) => some w.toNat
  2055	  | _ => none
