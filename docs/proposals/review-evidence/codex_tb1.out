     1	/-
     2	The slice-0 trusted base (PROVISIONAL): the open premises and the headline theorems whose axiom
     3	closure the trusted-base golden records (Concrete/README.md gate 9).
     4	
     5	This is the premise REGISTRY: one entry per open premise, with its trust class, what retires it,
     6	and its statement. The statements are text until the structures that state them as Lean
     7	propositions (`FrontendPremises`, `NativePremises`, designed in Concrete/README.md) land with the
     8	front end; each entry then names its field instead. `scripts/checks/slice0_trusted_base.sh` prints
     9	this registry and the axioms of `theorems` and compares them with `tests/golden/slice0_trusted_base.txt`,
    10	so a premise added, removed or reworded fails until the golden is updated with it.
    11	-/
    12	import Concrete.BIR.Progress
    13	import Concrete.Backend.LCB
    14	
    15	namespace Concrete.Premises
    16	
    17	inductive Trust where
    18	  | implementation | toolchain | environment
    19	  deriving Repr, DecidableEq
    20	
    21	def Trust.name : Trust → String
    22	  | .implementation => "implementation"
    23	  | .toolchain => "toolchain"
    24	  | .environment => "environment"
    25	
    26	structure Premise where
    27	  id : String
    28	  trust : Trust
    29	  retiredBy : String
    30	  statement : String
    31	
    32	/-- The open premises for slice 0, in the README's order. -/
    33	def all : List Premise := [
    34	  ⟨"P_lex", .implementation, "lex_correct",
    35	    "every token list the lexer returns for a source is one the source lexes to"⟩,
    36	  ⟨"P_parse", .implementation, "the generic table-parser theorem",
    37	    "every tree the parser returns for a token list is one the grammar derives from it"⟩,
    38	  ⟨"P_print", .implementation, "an LLVM-IR semantics; not planned for slice 0",
    39	    "the printed LLVM text of a WF BIR means at most the BIR behaviour, encoded"⟩,
    40	  ⟨"P_adapter", .implementation,
    41	    "adapter_correct (proved for accepted programs); retired once emit carries the adapter's Except result",
    42	    "the adapted LCB function of a WF BIR means at most the BIR behaviour, encoded"⟩,
    43	  ⟨"P_toolchain[llvm]", .toolchain, "not planned",
    44	    "every result the linked LLVM body produces is one its text means"⟩,
    45	  ⟨"P_toolchain[lcb]", .toolchain, "LCB's own proofs (C01-C03 and beyond)",
    46	    "every result the linked LCB body produces is one its function means (LCB's named trust boundaries)"⟩,
    47	  ⟨"P_rt", .implementation, "a proof of the decoding entry against a libc model; not planned for slice 0",
    48	    "a launch whose body returns w has behaviour decode w; a diverging body gives a diverging launch"⟩,
    49	  ⟨"P_trap_site", .implementation, "the same runtime-entry proof",
    50	    "a launch whose body returns 256 + i writes exactly trapLine tbl[i] and a newline on fd 2"⟩,
    51	  ⟨"P_launch", .environment, "not planned",
    52	    "an admitted launch of a WF image within the frame bound is never killed, and fd 2 accepts the trap line"⟩,
    53	  ⟨"P_live", .environment, "not planned",
    54	    "an admitted launch happens and has a behaviour"⟩
    55	]
    56	
    57	/-- The headline theorems, whose axioms the golden records. -/
    58	def theorems : List Lean.Name := [
    59	  ``Concrete.BIR.decode_encode,
    60	  ``Concrete.BIR.run_progress,
    61	  ``Concrete.BIR.behaviour_diverges_iff,
    62	  ``Concrete.Backend.LCB.Proof.adapter_correct
    63	]
    64	
    65	def Premise.line (p : Premise) : String :=
    66	  s!"premise {p.id} [{p.trust.name}] retired-by: {p.retiredBy} :: {p.statement}"
    67	
    68	end Concrete.Premises
     1	import Lean.Elab.Command
     2	import Concrete
     3	
     4	/-!
     5	Printer for the slice-0 trusted-base golden (`scripts/checks/slice0_trusted_base.sh`, README gate
     6	9). PROVISIONAL: it stands in for `concrete facts` until the compiler's command line exists.
     7	
     8	`lake env lean scripts/checks/slice0_trusted_base.lean` prints, one per line, every open premise
     9	of `Concrete.Premises.all` (id, trust class, what retires it, statement) and, for each theorem of
    10	`Concrete.Premises.theorems`, the axioms it depends on (sorted).
    11	-/
    12	
    13	open Lean Elab Command Concrete.Premises in
    14	#eval show CommandElabM Unit from do
    15	  for p in all do
    16	    IO.println p.line
    17	  for n in theorems do
    18	    let axs ← liftCoreM (collectAxioms n)
    19	    let names := (axs.map toString).qsort (· < ·)
    20	    IO.println s!"theorem {n} axioms: {", ".intercalate names.toList}"
     1	#!/usr/bin/env bash
     2	# Slice-0 trusted-base golden (PROVISIONAL, Concrete/README.md gate 9). The trusted base, printed
     3	# by scripts/checks/slice0_trusted_base.lean (until `concrete facts` exists), followed by the Lean
     4	# toolchain and the LCB pin, must equal tests/golden/slice0_trusted_base.txt byte for byte: a
     5	# premise added, removed or reworded, a headline theorem gaining an axiom (sorryAx included), or a
     6	# toolchain or pin change fails until the golden is updated with it. The premise ids must also be
     7	# exactly the README's open-premise table, in order.
     8	#
     9	# Controls: the comparison must reject the golden with a premise line removed, with a premise
    10	# reworded and with an extra axiom; the table check must reject a table missing a premise.
    11	#
    12	# usage: slice0_trusted_base.sh [update]. Run inside the nix devshell, from the repository root;
    13	# `update` rewrites the golden (review the diff before committing it).
    14	set -euo pipefail
    15	# shellcheck source=scripts/checks/lib/slice0_common.sh
    16	source scripts/checks/lib/slice0_common.sh
    17	golden=tests/golden/slice0_trusted_base.txt
    18	
    19	current() {
    20	  "${capped[@]}" timeout -k 10 300 lake env lean scripts/checks/slice0_trusted_base.lean | cap_out
    21	  printf 'lean-toolchain %s\n' "$(head -c 200 lean-toolchain)"
    22	  python3 -I -c 'import json,sys
    23	for p in json.load(open(sys.argv[1]))["packages"]: print("pin", p["name"], p["rev"])' lake-manifest.json
    24	}
    25	
    26	# The premise ids of the README's open-premise table, in order.
    27	readme_ids() {
    28	  awk '/^\*\*The open premises for slice 0:\*\*/{t=1; next} t && /^\| P_/{print $2} t && /^$/ && n++{exit}' "$1"
    29	}
    30	
    31	current >"$work/current" || { head -c 20000 "$work/current"; echo "slice0_trusted_base: printing the trusted base failed" >&2; exit 1; }
    32	if [ "${1:-}" = update ]; then
    33	  mkdir -p "$(dirname "$golden")"
    34	  cp "$work/current" "$golden"
    35	  echo "slice0_trusted_base: golden updated; review: git diff -- $golden"
    36	  exit 0
    37	fi
    38	
    39	fail=0
    40	if cmp -s "$golden" "$work/current"; then
    41	  echo "ok   trusted base equals $golden"
    42	else
    43	  echo "FAIL trusted base differs from $golden (run with update after review):"
    44	  diff "$golden" "$work/current" | head -c 20000 || true
    45	  fail=1
    46	fi
    47	grep '^premise ' "$work/current" | sed 's/^premise \([^ ]*\) .*/\1/' >"$work/lean_ids"
    48	readme_ids Concrete/README.md >"$work/readme_ids"
    49	if [ -s "$work/lean_ids" ] && cmp -s "$work/lean_ids" "$work/readme_ids"; then
    50	  echo "ok   premise ids equal the README's open-premise table"
    51	else
    52	  echo "FAIL premise ids differ from the README's open-premise table:"
    53	  diff "$work/readme_ids" "$work/lean_ids" | head -c 20000 || true
    54	  fail=1
    55	fi
    56	
    57	# Controls.
    58	differs() { # differs NAME FILE: FILE must not equal the current trusted base
    59	  if cmp -s "$2" "$work/current"; then echo "FAIL control: comparison accepts $1"; fail=1
    60	  else echo "ok   control: comparison rejects $1"; fi
    61	}
    62	sed '1d' "$work/current" >"$work/c1"; differs "a premise removed" "$work/c1"
    63	sed '1s/$/ (reworded)/' "$work/current" >"$work/c2"; differs "a premise reworded" "$work/c2"
    64	sed '/^theorem /{s/$/, sorryAx/;q}' "$work/current" >"$work/c3"
    65	sed -n '/^theorem /,$p' "$work/current" | sed '1d' >>"$work/c3"
    66	differs "an extra axiom" "$work/c3"
    67	grep -v '^| P_live ' Concrete/README.md >"$work/readme_short"
    68	if cmp -s "$work/lean_ids" <(readme_ids "$work/readme_short"); then
    69	  echo "FAIL control: table check accepts a table missing a premise"; fail=1
    70	else echo "ok   control: table check rejects a table missing a premise"; fi
    71	
    72	[ "$fail" = 0 ] && echo "PASS slice0_trusted_base" || { echo "FAIL slice0_trusted_base"; exit 1; }
     1	# shellcheck shell=bash
     2	# Shared machinery of the slice-0 example gates (PROVISIONAL): slice0_backends.sh (gates 4, 6, 6a)
     3	# and slice0_artifacts.sh (gates 10, 11, 12). Source it from the repository root, inside the nix
     4	# devshell, with `set -euo pipefail`. It builds the compiler and LCB's command line under the
     5	# gate's limits (lib/limits.sh: an address-space cap of SLICE0_GATE_MEM_GB GiB, default 64; 0 for
     6	# a gate whose executables under test need no cap, slice0_artifacts.sh) and defines:
     7	#   capped (a command prefix, an array): run under a 64 GiB address-space cap of its own, so
     8	#     every build and analysis command is capped whatever the gate's cap;
     9	#   root, work (removed on exit), lcb, target, emitter (the Lean emitter command, an array);
    10	#   observe EXE OUT SECS RETRY [MEM_MB [ENV...]]: run EXE under bounded_run (and limited_exec.sh
    11	#     MEM_MB, default 1024) with ENV assignments; OUT.status (status or "incomplete"),
    12	#     OUT.stdout, OUT.stderr;
    13	#   judge EXPECTED_DIR OBS: the observation OBS.* equals the expectation, byte for byte;
    14	#   build NAME LOG CMD...: run CMD, or print LOG and fail the gate;
    15	#   emit_examples: the example names, one per line, failing if there are none;
    16	#   cap_out: copy stdin to stdout, failing above 1 MiB: every command output a gate captures
    17	#     into a variable goes through it, so no producer can grow the gate's shell (which may run
    18	#     with no address-space cap, see SLICE0_GATE_MEM_GB) without bound.
    19	root=$(pwd)
    20	work=$(mktemp -d)
    21	trap 'rm -rf "${work:?}"' EXIT
    22	BOUNDED_PARENT="$work"
    23	# shellcheck source=scripts/checks/lib/bounded.sh
    24	source scripts/checks/lib/bounded.sh
    25	[ "$BOUNDED_HAVE_WATCHDOG" = 1 ] || { echo "slice0: python3 is required for bounded runs" >&2; exit 2; }
    26	# shellcheck source=scripts/checks/lib/limits.sh
    27	source scripts/checks/lib/limits.sh
    28	gate_limits "${SLICE0_GATE_MEM_GB:-64}" 40000
    29	capped=(bash "$root/scripts/checks/lib/limited_exec.sh" 65536)
    30	"${capped[@]}" timeout -k 30 1800 lake build Concrete lean-compiler-backend/lcb >/dev/null
    31	lcb="$root/.lake/packages/lean-compiler-backend/.lake/build/bin/lcb"
    32	case "$(uname -s)-$(uname -m)" in
    33	  Linux-x86_64) target=x86_64-linux ;;
    34	  Linux-aarch64) target=aarch64-linux ;;
    35	  Darwin-arm64) target=aarch64-macos ;;
    36	  *) echo "slice0: unsupported host $(uname -s)-$(uname -m)" >&2; exit 2 ;;
    37	esac
    38	emitter=("${capped[@]}" timeout -k 10 120 lake env lean --run scripts/checks/slice0_bir.lean)
    39	
    40	observe() {
    41	  local rc=0 mem=${5:-1024}
    42	  local envs=("${@:6}")
    43	  bounded_run -i /dev/null -r "$4" "$3" -- env ${envs[@]+"${envs[@]}"} \
    44	    bash "$root/scripts/checks/lib/limited_exec.sh" "$mem" "$1" \
    45	    >"$2.stdout" 2>"$2.stderr" || rc=$?
    46	  if bounded_is_incomplete "$rc"; then echo incomplete >"$2.status"; else echo "$rc" >"$2.status"; fi
    47	}
    48	
    49	judge() {
    50	  cmp -s "$1/status" "$2.status" && cmp -s "$1/stderr" "$2.stderr" && [ ! -s "$2.stdout" ]
    51	}
    52	
    53	build() {
    54	  local name=$1 log=$2; shift 2
    55	  "$@" >"$log" 2>&1 || { cat "$log" >&2; echo "slice0: $name: build failed: $*" >&2; exit 1; }
    56	}
    57	
    58	cap_out() {
    59	  local LC_ALL=C out
    60	  out=$(head -c 1048577; echo x)
    61	  out=${out%x}
    62	  [ "${#out}" -le 1048576 ] || { echo "slice0: captured output over 1 MiB" >&2; return 1; }
    63	  printf '%s' "$out"
    64	}
    65	
    66	emit_examples() {
    67	  local names
    68	  names=$("${emitter[@]}" list | cap_out) || { echo "slice0: listing the examples failed" >&2; exit 1; }
    69	  [ -n "$names" ] || { echo "slice0: no examples listed" >&2; exit 1; }
    70	  printf '%s\n' "$names"
    71	}
     1	name: Slice 0 backends
     2	
     3	# PROVISIONAL (ROADMAP B0, Concrete/README.md gates 4, 6, 6a, 8, 9, 10, 11 and 12). The slice-0 backend gate,
     4	# scripts/checks/slice0_backends.sh: every hand-written BIR example through the LLVM path and the
     5	# LCB path, each executable's observation (exit status plus the fd-2 trap line) compared with the
     6	# BIR semantics, plus LCB's own evaluator on the adapted body. It runs natively on x86-64 Linux and
     7	# on AArch64 macOS (GitHub-hosted; LCB's first native proof profile is Apple AArch64), so the LCB
     8	# output is executed on both targets. It joins
     9	# required-checks.txt when the compiler lands on main; until then it runs on the slice-0 branches.
    10	
    11	on:
    12	  push:
    13	    branches: ['wip/slice0', 'wip/slice0-*']
    14	  workflow_dispatch:
    15	
    16	concurrency:
    17	  group: slice0-${{ github.ref }}
    18	  cancel-in-progress: true
    19	
    20	jobs:
    21	  backends:
