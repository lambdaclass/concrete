  2032	def renderTerminator : Source.Terminator → String
  2033	  | .ret a => s!"    ret {renderOperand a}\n"
  2034	  | .jump t => s!"    jmp @b{t}\n"
  2035	  | .branch c y n => s!"    jnz {renderOperand c}, @b{y}, @b{n}\n"
