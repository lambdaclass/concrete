  2037	/-- The body as QBE text for `lcb`. -/
  2038	def render (f : Source.Function) : String :=
  2039	  let blocks := (indexed f.blocks.toList).map fun (j, b) =>
  2040	    s!"@b{j}\n" ++
  2041	    String.join (b.phis.toList.map fun ph =>
  2042	      let arms := ph.incoming.toList.map fun (pred, a) => s!"@b{pred} {renderOperand a}"
  2043	      s!"    %v{ph.destination} ={renderWidth ph.width} phi {", ".intercalate arms}\n") ++
  2044	    String.join (b.instructions.toList.map fun i =>
  2045	      s!"    %v{i.destination} ={renderWidth i.width} {renderOperation i.operation}\n") ++
  2046	    renderTerminator b.terminator
  2047	  "export function w $concrete_body() {\n" ++ String.join blocks ++ "}\n"
