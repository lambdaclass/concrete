from pathlib import Path
import re
p=Path('_review/FOUNDATION_PROPOSAL.md')
s=p.read_text()
for target in re.findall(r'\\]\\((["'^)]+)'"\\)',s):
 file,_,anchor=target.partition('#'); q=p.parent/file
 if not q.exists(): print('MISSING FILE',target); continue
 if anchor:
  t=q.read_text(); headings=[re.sub(r'["'^'"\\w\\- ]','',h.lower()).replace(' ','-') for h in re.findall(r'"'^#+ (.*)'"',t,re.M)]
  if f'id=\"{anchor}\"' not in t and anchor not in headings: print('CHECK ANCHOR',target)
assert 'question 12' not in s.lower() and 'question 13' not in s.lower()
assert not re.search(r'"'^1[23]'"\\. ',s,re.M)
