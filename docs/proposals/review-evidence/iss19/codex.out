   483	  for m in $(state_get_soft "$name" members | tr ',' ' '); do
   484	    n=$((n + 1))
   485	    out="$(bash "$VERIFY" "${m##*@}" 2>&1)" || bad="$bad; member ${m%@*}: ${out//$'\n'/ }"
   486	  done
   487	  [ "$n" -gt 0 ] || { echo "the head ${head:0:10} has no review note and the train records no members"; return 1; }
   488	  [ -z "$bad" ] || { echo "the head ${head:0:10} has no review note, and not every member has a clean one$bad"; return 1; }
   489	  echo "the head has no review note; every member ($n) carries a clean one at its exact SHA"
   490	}
   491	
   492	# Codex review leg. It passes without running the reviewer when the train already has review
   493	# provenance. Otherwise it runs the review command; a non-zero exit fails, and so does a zero exit
    55	    verdict)      [[ "$v" =~ ^(clean|findings|blocked)$ ]] ;;
    56	    rounds)       [[ "$v" =~ ^[1-9][0-9]*$ ]] ;;
    57	    reviewer)     [[ "$v" =~ ^[^[:space:]]+$ ]] ;;
    58	    utc)          [[ "$v" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] ;;
    59	    base)         [[ "$v" =~ ^[0-9a-f]{40}$ ]] ;;
    60	    pieces)       [[ "$v" =~ ^[0-9]+$ ]] ;;
    61	    carried-from) [[ "$v" =~ ^[0-9a-f]{40}$ ]] ;;
    62	    order)        [[ "$v" =~ ^[0-9]+$ ]] ;;
    63	    *)            false ;;
    64	  esac || malformed "bad $k"
    65	done <<< "$NOTE"
    66	for k in verdict rounds reviewer utc base pieces; do
    67	  case "$SEEN" in *" $k "*) ;; *) malformed "missing $k" ;; esac
    68	done
    69	
    70	field() { local n="F_${1//-/_}"; printf '%s' "${!n:-}"; }
    71	VERDICT="$(field verdict)"
    72	CARRIED=""; [ -z "$(field carried-from)" ] || CARRIED=", carried from $(field carried-from)"
    73	echo "$SHA $VERDICT (round $(field rounds), reviewer $(field reviewer), $(field utc), base $(field base), $(field pieces) piece(s)$CARRIED)"
    74	[ "$VERDICT" = clean ] && exit 0
    75	exit 1

