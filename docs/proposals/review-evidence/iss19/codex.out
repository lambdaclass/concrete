}
printf '"'A (origin/main, train base) = %s\\nB (note base) = %s\\nC (train head) = %s\\n' \""'$A" "$B" "$C"
[ "$A" = "$(git rev-parse origin/main)" ]
[ "$A" != "$B" ]
git merge-base --is-ancestor "$A" "$B"
git merge-base --is-ancestor "$B" "$C"
