# AAPCS64 on Linux): a store at its edge is in the bound, one past it is refused.
refuse x86-beyond-red-zone '    1010:\tmov\tqword ptr [rsp - 0x88], 0x0\n    101c:\tret\n'
bound_is x86-red-zone-edge x86_64-linux 'bound 128' '0000000000001010 <main>:\n    1010:\tmov\tqword ptr [rsp - 0x80], 0x0\n    1019:\tret\n'
refuse a64-beyond-red-zone '    1010:\tstur\txzr, [sp, #-0x88]\n    1014:\tret\n' aarch64-macos _main
bound_is a64-red-zone-edge aarch64-macos 'bound 128' '0000000000001010 <_main>:\n    1010:\tstur\txzr, [sp, #-0x80]\n    1014:\tret\n'
refuse a64-linux-no-red-zone '    1010:\tstur\txzr, [sp, #-0x8]\n    1014:\tret\n' aarch64-linux main
if [ -n "$measuring" ]; then
  # The run check counts the bytes an instruction addresses below the stack pointer, not only the
  # stack pointer: a main that stores at the red zone's edge without moving the stack pointer
  # (built like the examples, slice0_native.sh control) is measured at 128 bytes, not 0. With a
  # smaller red zone the same run is an error, not a measurement. On AArch64 it first allocates and
  # frees a 144-byte frame with a pre-indexed store (judged against the new stack pointer, so not
  # beyond the red zone), so the expected depth there is 144.
  rz="$work/ctl/redzone"; mkdir -p "$rz"
  case "$target" in
    x86_64-linux) rzdepth=128; printf '\t.intel_syntax noprefix\n\t.text\n\t.globl\tmain\n\t.type\tmain,@function\nmain:\n\tmov\tqword ptr [rsp - 0x80], 0\n\tmov\teax, 7\n\tret\n\t.size\tmain, .-main\n\t.section\t.note.GNU-stack,"",@progbits\n' ;;
    aarch64-macos) rzdepth=144; printf '\t.text\n\t.globl\t_main\n\t.p2align\t2\n_main:\n\tstp\tx29, x30, [sp, #-0x90]!\n\tldp\tx29, x30, [sp], #0x90\n\tstur\txzr, [sp, #-0x80]\n\tmov\tw0, #7\n\tret\n' ;;
  esac >"$rz/control.s"
  if ! bounded "$native_secs" bash "$root/scripts/checks/lib/slice0_native.sh" control "$rz" >"$rz/build.log" 2>&1; then
    echo "FAIL control: the red-zone executable does not build: $(head -c 1000 "$rz/build.log")"; fail=1
  else
    "${objdump[@]}" "$rz/control.exe" >"$rz/control.exe.dis"
    rza=$(stack_bound "$target" "$rz/control.exe.dis" --ranges | cap_out) || true
    rzm=$(measure "$rz/control.exe" "$rza" 7)
    if [ "$(awk '$1 == "bound" {print $2}' <<<"$rza")" = "$rzdepth" ] && [ "$rzm" = "measured $rzdepth" ]; then
      echo "ok   control: a red-zone store is measured (bound $rzdepth, measured $rzdepth)"
    else
      echo "FAIL control: red-zone run: analysis ${rza:-none}; run ${rzm:-none} $(head -c 300 "$rz/control.exe.gdb.err")"; fail=1
    fi
    rzm=$(measure "$rz/control.exe" "$(sed 's/^redzone .*/redzone 120/' <<<"$rza")" 7)
    if grep -q '^error .*beyond the 120-byte red zone' <<<"$rzm"; then
      echo "ok   control: a run beyond the red zone gives no measurement"
    else
      echo "FAIL control: a run beyond the red zone: ${rzm:-none}"; fail=1
    fi
  fi
fi

[ "$examples" -gt 0 ] || { echo "slice0_artifacts: no examples ran" >&2; exit 1; }
echo "slice0_artifacts: $examples examples; sizes in $sizes, compile times in $times, stack bounds in $stack"
column -t -s "$(printf '\t')" "$sizes" 2>/dev/null || cat "$sizes"
column -t -s "$(printf '\t')" "$times" 2>/dev/null || cat "$times"
exit "$fail"
#!/usr/bin/env bash
# Slice-0 trusted-base golden (PROVISIONAL, Concrete/README.md gate 9). The trusted base, printed
# by scripts/checks/compiler/slice0_trusted_base.lean (until `concrete facts` exists): the premise registry
# Concrete/Premises.lean (the one list of open premises), each headline theorem's axioms and each
# axiom's type, followed by the Lean toolchain and every Lake pin, must equal
# tests/golden/slice0_trusted_base.txt byte for byte. A premise added, removed or reworded (id,
# trust class, what retires it, statement), a headline theorem gaining an axiom (sorryAx
# included), an axiom restated, or a toolchain or pin change fails until the golden is updated.
# The README's open-premise table is a generated view: it must equal the registry's rendering
# (scripts/checks/compiler/slice0_premise_table.lean).
#
# Controls: the comparison must reject the golden with a premise line removed, reworded, or with an
# extra axiom; the printer must fail on a Lean file that prints and then errors; the report must
# list a theorem's own axiom with its type (a control file declaring one); the table check must
# reject a drifted table.
#
# usage: slice0_trusted_base.sh [update]. Run inside the nix devshell, from the repository root;
# `update` rewrites the golden (review the diff before committing it).
set -euo pipefail
# shellcheck source=scripts/checks/lib/slice0_common.sh
source scripts/checks/lib/slice0_common.sh
golden=tests/golden/slice0_trusted_base.txt

# print_lean FILE OUT: elaborate FILE (bounded, capped) and write its stdout to OUT; fails (with
# the bounded diagnostics) when Lean fails, times out, or prints more than 1 MiB.
print_lean() {
  local rc=0
  bounded_run -i /dev/null 600 -- "${capped[@]}" lake env lean "$1" >"$2.raw" 2>"$2.err" || rc=$?
  if [ "$rc" != 0 ]; then
    bounded_is_incomplete "$rc" && echo "slice0_trusted_base: $1: INCOMPLETE (timed out)" >&2
    head -c 20000 "$2.raw" "$2.err" >&2
    return 1
  fi
  cap_out <"$2.raw" >"$2"
}

# current OUT: the whole trusted base into OUT; fails if any step fails.
current() {
  print_lean scripts/checks/compiler/slice0_trusted_base.lean "$1.lean" || return 1
  [ -s "$1.lean" ] || { echo "slice0_trusted_base: the printer printed nothing" >&2; return 1; }
  { cat "$1.lean"; printf 'lean-toolchain %s\n' "$(head -c 200 lean-toolchain)"; } >"$1" || return 1
  python3 -I -c 'import json,sys
for p in json.load(open(sys.argv[1]))["packages"]: print("pin", p["name"], p["rev"])' \
    lake-manifest.json | cap_out >>"$1" || return 1
}

if ! current "$work/current"; then
  echo "FAIL slice0_trusted_base: printing the trusted base failed"
  exit 1
fi
if [ "${1:-}" = update ]; then
  mkdir -p "$(dirname "$golden")"
  cp "$work/current" "$golden"
  echo "slice0_trusted_base: golden updated; review: git diff -- $golden"
  exit 0
fi

fail=0
if cmp -s "$golden" "$work/current"; then
  echo "ok   trusted base equals $golden"
else
  echo "FAIL trusted base differs from $golden (run with update after review):"
  diff "$golden" "$work/current" | head -c 20000 || true
  fail=1
fi

# The README's open-premise table: the rows after its header and separator, up to the first line
# that is not a row; fails when the table is missing.
readme_rows() {
  awk '/^\*\*The open premises for slice 0\*\*/{h=1; next}
       h==1 && /^\| Premise \| Trust class \| Retired by \|$/{h=2; next}
       h==2 && /^\|---\|---\|---\|$/{h=3; next}
       h==3 && /^\|/{print; n++; next}
       h==3{exit}
       END{if (n == 0) exit 1}' "$1"
}
if ! print_lean scripts/checks/compiler/slice0_premise_table.lean "$work/rows"; then
  echo "FAIL printing the registry's table rows"; fail=1
elif readme_rows Concrete/README.md >"$work/readme_rows" && cmp -s "$work/rows" "$work/readme_rows"; then
  echo "ok   README's open-premise table equals the registry"
else
  echo "FAIL README's open-premise table differs from the registry (Concrete/Premises.lean):"
  diff "$work/readme_rows" "$work/rows" | head -c 20000 || true
  fail=1
fi

# Controls.
differs() { # differs NAME FILE: FILE must not equal the current trusted base
  if cmp -s "$2" "$work/current"; then echo "FAIL control: comparison accepts $1"; fail=1
  else echo "ok   control: comparison rejects $1"; fi
}
sed '1d' "$work/current" >"$work/c1"; differs "a premise removed" "$work/c1"
sed '1s/$/ (reworded)/' "$work/current" >"$work/c2"; differs "a premise reworded" "$work/c2"
# POSIX awk, not GNU sed's `0,/re/` range (BSD sed has none): the first theorem line gains an axiom.
awk '!done && /^theorem / { $0 = $0 ", sorryAx"; done = 1 } { print }' "$work/current" >"$work/c3"
differs "an extra axiom" "$work/c3"
mkdir -p "$work/ctl"
printf '#eval IO.println "premise"\n#eval (throw (IO.userError "control") : IO Unit)\n' >"$work/ctl/fails.lean"
if print_lean "$work/ctl/fails.lean" "$work/ctl/fails.out" 2>/dev/null; then
  echo "FAIL control: the printer accepts a Lean file that errors"; fail=1
else echo "ok   control: the printer fails on a Lean file that errors"; fi
cat >"$work/ctl/axiom.lean" <<'EOF'
import Lean.Elab.Command
import Concrete
axiom slice0_control_axiom : 1 = 2
theorem slice0_control : 1 = 2 := slice0_control_axiom
open Lean Elab Command in
#eval show CommandElabM Unit from do
  for l in ← liftCoreM (Concrete.Premises.report [``slice0_control]) do IO.println l
EOF
if print_lean "$work/ctl/axiom.lean" "$work/ctl/axiom.out" &&
   grep -qx 'theorem slice0_control axioms: slice0_control_axiom' "$work/ctl/axiom.out" &&
   grep -qx 'axiom slice0_control_axiom : 1 = 2' "$work/ctl/axiom.out"; then
  echo "ok   control: the report lists a theorem's axiom with its type"
else echo "FAIL control: the report misses a theorem's axiom: $(head -c 2000 "$work/ctl/axiom.out" 2>/dev/null)"; fail=1; fi

sed 's/^| P_rt | implementation | /| P_rt | toolchain | /' Concrete/README.md >"$work/ctl/readme"
if readme_rows "$work/ctl/readme" >"$work/ctl/rows" && cmp -s "$work/rows" "$work/ctl/rows"; then
  echo "FAIL control: the table check accepts a drifted table"; fail=1
else echo "ok   control: the table check rejects a drifted table"; fi

[ "$fail" = 0 ] && echo "PASS slice0_trusted_base" || { echo "FAIL slice0_trusted_base"; exit 1; }
#!/usr/bin/env bash
# Slice-0 reproducibility gate (Concrete/README.md, gate 8). Two independent builds of the compiler
# and of LCB, from two source copies with different paths and TMPDIRs, emit every hand-written BIR
# example and build it natively; every stage is compared byte for byte, with no normalization.
# The two sides share only the pinned Lean toolchain and the dependency SOURCES (each side compiles
# them itself, with no Lake artifact cache). The comparator is checked by negative controls: a flipped byte, a missing artifact
# and a differing inventory must each be refused.
#
#   slice0_repro.sh [MANIFEST]   (inside nix develop, from the repository root)
#
# MANIFEST gets the build identity and one hash per artifact; CI compares the manifests of two
# independent runners of the same target.
set -euo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
cd "$root"
# shellcheck source=scripts/checks/lib/limits.sh
source scripts/checks/lib/limits.sh
# shellcheck source=scripts/checks/lib/slice0_sources.sh
source scripts/checks/lib/slice0_sources.sh
gate_limits 64 40000
work=$(mktemp -d)
# On every exit, the bounded-run summary (recovered and INCOMPLETE runs) goes to stdout before the
# scratch directory is removed, and a gate that would pass with an INCOMPLETE run exits 3 instead.
trap 'rc=$?; bounded_summary || true
  if [ "$rc" = 0 ] && grep -Eqs "^(incomplete|runner-failed)" "${BOUNDED_LOG:-/nonexistent}"; then
    echo "INCOMPLETE: a bounded run timed out twice; not a pass"; rc=3
  fi
  rm -rf "${work:?}"; exit "$rc"' EXIT
BOUNDED_PARENT="$work"
# shellcheck source=scripts/checks/lib/bounded.sh
source scripts/checks/lib/bounded.sh
[ "$BOUNDED_HAVE_WATCHDOG" = 1 ] || { echo "slice0_repro: python3 is required for bounded runs" >&2; exit 2; }
# bounded SECS CMD...: CMD through bounded_run (stdin /dev/null, one re-run on a timeout; a second
# timeout returns 124 with no output and is reported INCOMPLETE, never a pass).
bounded() {
  local secs=$1 rc=0
  shift
  bounded_run -i /dev/null "$secs" -- "$@" || rc=$?
  if [ "$rc" != 0 ] && bounded_is_incomplete "$rc"; then
    echo "slice0_repro: INCOMPLETE (timed out twice): $*" >&2
  fi
  return "$rc"
}
manifest=${1:-}
[ -z "$manifest" ] || manifest=$(realpath -m "$manifest")
compare=(python3 "$root/scripts/checks/lib/repro_compare.py")
# Materialize the dependency checkouts (no build): they must be the manifest's clean revisions,
# which build_identity.sh checks before anything is built.
bounded 600 lake env true
bash scripts/checks/compiler/build_identity.sh > "$work/identity"
target=$(bash scripts/checks/lib/slice0_native.sh target)
# Working source edits are included (the identity records their digest); no build product is.
for side in first second; do
  d="$work/$side/checkout-with-$side-path"
  mkdir -p "$d/.lake/packages" "$work/$side/tmp"
  git ls-files -z -- "${slice0_sources[@]}" |
    tar --null -T - -cf - | tar -xf - -C "$d"
  # Dependency checkouts: tracked files and .git (which Lake checks against the manifest) only.
  for pkg in .lake/packages/*/; do
    pkg=$(basename "$pkg")
    mkdir -p "$d/.lake/packages/$pkg"
    (cd ".lake/packages/$pkg" && { git ls-files -z; printf '.git\0'; } | tar --null -T - -cf -) |
      tar -xf - -C "$d/.lake/packages/$pkg"
  done
  (
    cd "$d"
    export TMPDIR="$work/$side/tmp" LC_ALL=C TZ=UTC SOURCE_DATE_EPOCH=1 ZERO_AR_DATE=1
    # No Lake artifact cache: each side compiles everything it uses.
    export LAKE_ARTIFACT_CACHE=false LAKE_CACHE_DIR="$work/$side/lake-cache"
    bounded 3000 lake build Concrete lean-compiler-backend/lcb >"$work/$side/build.log" 2>&1 ||
      { tail -50 "$work/$side/build.log" >&2; echo "slice0_repro: $side: build failed" >&2; exit 1; }
    lcb="$d/.lake/packages/lean-compiler-backend/.lake/build/bin/lcb"
    bounded 120 lake env lean --run scripts/checks/compiler/slice0_bir.lean list > names
    [ -s names ] || { echo 'slice0_repro: no examples' >&2; exit 1; }
    while read -r name; do
      bounded 120 lake env lean --run scripts/checks/compiler/slice0_bir.lean emit "$name" "$d/out/$name" "$target"
      bounded 120 bash scripts/checks/lib/slice0_native.sh "$d/out/$name" "$lcb"
    done < names
  )
done
a="$work/first/checkout-with-first-path"
b="$work/second/checkout-with-second-path"
"${compare[@]}" "$a" "$b" "$work/identity" ${manifest:+"$manifest"}

# Negative controls: the comparator must refuse each perturbation of an identical pair.
control() { # control LABEL EXPECTED-MESSAGE SETUP...
  local label=$1 expect=$2 c="$work/ctl/$1" rc=0; shift 2
  mkdir -p "$c"
  cp -R "$a" "$c/a"; cp -R "$a" "$c/b"
  (cd "$c/b" && "$@")
  "${compare[@]}" "$c/a" "$c/b" "$work/identity" >"$c/log" 2>&1 || rc=$?
  if [ "$rc" = 0 ] || ! grep -qF -- "$expect" "$c/log"; then
    echo "FAIL slice0_repro control $label: not refused as '$expect'" >&2; cat "$c/log" >&2; exit 1
  fi
  echo "ok slice0_repro control $label: refused"
}
first=$(head -1 "$a/names")
flip() { python3 -c 'import sys;p=sys.argv[1];d=bytearray(open(p,"rb").read());d[len(d)//2]^=1;open(p,"wb").write(d)' "$1"; }
control flipped-byte "$first: lcb.exe:" flip "out/$first/lcb.exe"
control missing-artifact "$first: lcb_rt.o: missing" rm "out/$first/lcb_rt.o"
control inventory 'example inventory differs' sh -c 'echo extra >> names'
echo 'PASS slice0_repro'
#!/usr/bin/env python3
"""Compare the stage outputs of two independent slice-0 builds, byte for byte.

usage: repro_compare.py SIDE_A SIDE_B IDENTITY [MANIFEST]

Each SIDE holds `names` (the example inventory) and `out/NAME/STAGE` for every stage. Every file
is read on both sides: a missing file, a differing inventory or one differing byte fails. With
MANIFEST, writes the identity lines followed by one `SHA256  NAME/STAGE` line per artifact.
"""
import hashlib
import sys
from pathlib import Path

STAGES = ['bir.txt', 'llvm.ll', 'lcb_job.txt', 'lcb_source.txt', 'lcb_body.ssa', 'lcb_body.s',
          'lcb_rt.ssa', 'lcb_rt.s', 'llvm.o', 'lcb_body.o', 'lcb_rt.o', 'llvm.exe', 'lcb.exe']


def main(argv):
    if len(argv) not in (4, 5):
        sys.exit(__doc__)
    a, b, identity = Path(argv[1]), Path(argv[2]), Path(argv[3])
    names = (a / 'names').read_bytes()
    if names != (b / 'names').read_bytes():
        sys.exit('FAIL slice0_repro: example inventory differs')
    if not names.strip():
        sys.exit('FAIL slice0_repro: no examples')
    lines = identity.read_text().splitlines()
    for name in names.decode().splitlines():
        for stage in STAGES:
            try:
                hashes = [hashlib.sha256((d / 'out' / name / stage).read_bytes()).hexdigest()
                          for d in (a, b)]
            except FileNotFoundError as e:
                sys.exit(f'FAIL slice0_repro: {name}: {stage}: missing ({e.filename})')
            if hashes[0] != hashes[1]:
                sys.exit(f'FAIL slice0_repro: {name}: {stage}: {hashes[0]} != {hashes[1]}')
            lines.append(f'{hashes[0]}  {name}/{stage}')
        print(f'ok slice0_repro: {name}: all stages byte-identical')
    if len(argv) == 5:
        Path(argv[4]).write_text('\n'.join(lines) + '\n')


if __name__ == '__main__':
    main(sys.argv)
#!/usr/bin/env bash
# AXIOM INVENTORY: every theorem of the specification depends, transitively, on no axiom beyond
# propext, Quot.sound and Classical.choice (Q9.17), and the per-theorem inventory equals the golden
# list scripts/proofs/axioms.golden.
#
#   P  population: every module the ConcreteSpec sources declare is in the root's import closure (a
#      module outside it is neither built by default nor read here), and every module whose file
#      declares a theorem contributes one, so the population cannot shrink unnoticed;
#   A  every theorem's transitive axioms (Lean.collectAxioms) are among the standard three;
#   G  the inventory (`<theorem>\t<axioms>`) equals axioms.golden byte for byte. A theorem added,
#      removed or renamed, or one that starts or stops using an axiom, changes the golden in the same
#      commit, where review sees it. `--update` rewrites it from the build.
#
# NEGATIVE CONTROLS run the same code on bad inputs and require the failure: an axiom declared and
# used by a control theorem fails A naming it; new theorems, a private one included, differ from the
# golden; a golden missing a theorem, carrying an extra one, or
# recording other axioms fails G; a control module outside the import closure fails P.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../checks/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"
CHECK_NAME=PROOF-AXIOMS
source scripts/proofs/lib.sh
GOLDEN=scripts/proofs/axioms.golden

population theorems > "$TMP/inv.tsv" 2> "$TMP/inv.err" \
  || { cat "$TMP/inv.err" >&2; echo "error: the enumerator failed" >&2; exit 2; }
if [ "${1:-}" = --update ]; then
  { echo "# Per-theorem transitive axioms of ConcreteSpec (scripts/proofs/axioms.sh). Regenerate with"
    echo "# bash scripts/proofs/axioms.sh --update; review every changed line."
    cat "$TMP/inv.tsv"; } > "$GOLDEN"
  echo "wrote $GOLDEN ($(grep -c . "$TMP/inv.tsv") theorems)"; exit 0
fi

# nonstandard FILE → the theorems of an inventory with an axiom outside the standard three
nonstandard() {
  awk -F'\t' -v std=" $STANDARD_AXIOMS " '{ n = split($2, a, " ")
    for (i = 1; i <= n; i++) if (index(std, " " a[i] " ") == 0) { print $1 " (" a[i] ")"; break } }' "$1"
}
# golden_diff INVENTORY GOLDEN → the differing lines, empty when equal
golden_diff() { diff <(grep -v '^#' "$2") "$1" | grep '^[<>]'; }

echo "=== P: population ==="
population imported > "$TMP/imported.txt" || { no "PROOF_MODE=imported failed"; finish; }
GAP=$(closure_gap "$TMP/imported.txt")
[ -z "$GAP" ] && ok "all $(spec_modules | grep -c .) ConcreteSpec source modules are in the root's import closure" \
  || no "source modules outside the import closure of ConcreteSpec: $(echo $GAP)"
population modules > "$TMP/env-modules.txt" || { no "PROOF_MODE=modules failed"; finish; }
grep -rlE '^\s*(@\[[^]]*\]\s*)?(private |protected )*theorem ' ConcreteSpec ConcreteSpec.lean --include='*.lean' \
  | sed -E 's#\.lean$##; s#/#.#g' | sort -u > "$TMP/src-modules.txt"
UNSEEN=$(comm -13 <(sort -u "$TMP/env-modules.txt") "$TMP/src-modules.txt")
NTHM=$(grep -c . "$TMP/inv.tsv")
[ -s "$TMP/src-modules.txt" ] && [ -z "$UNSEEN" ] && [ "$NTHM" -ge 100 ] \
  && ok "$NTHM theorems from all $(grep -c . "$TMP/src-modules.txt") source modules that declare one" \
  || no "population: $NTHM theorems; modules declaring theorems but absent: $(echo $UNSEEN)"

echo "=== A: standard axioms only ==="
BAD=$(nonstandard "$TMP/inv.tsv")
[ -z "$BAD" ] && ok "every theorem's transitive axioms are among $STANDARD_AXIOMS ($(cut -f2 "$TMP/inv.tsv" | tr ' ' '\n' | grep . | sort | uniq -c | awk '{printf "%s%s %s", s, $2, $1; s=", "}'))" \
  || no "theorems using a non-standard axiom: $(echo $BAD | cut -c1-400)"

echo "=== G: golden list ==="
[ -f "$GOLDEN" ] || { no "$GOLDEN is missing (bash scripts/proofs/axioms.sh --update)"; finish; }
D=$(golden_diff "$TMP/inv.tsv" "$GOLDEN")
[ -z "$D" ] && ok "the inventory equals $GOLDEN ($NTHM theorems)" \
  || no "the inventory differs from $GOLDEN (< golden, > build; regenerate with --update and review): $(printf '%s\n' "$D" | head -10 | tr '\t\n' ' |')"

echo "=== negative controls ==="
cat > "$TMP/c-axiom.lean" <<'EOF'
axiom ConcreteSpecControl.extra : 1 = 2
theorem ConcreteSpecControl.usesExtra : 2 = 1 := ConcreteSpecControl.extra.symm
EOF
population theorems "$TMP/c-axiom.lean" > "$TMP/c-axiom.tsv" 2>"$TMP/c-axiom.err"
CB=$(nonstandard "$TMP/c-axiom.tsv")
[ "$CB" = "ConcreteSpecControl.usesExtra (ConcreteSpecControl.extra)" ] \
  && ok "control: a theorem using a declared axiom is refused, and only it ($CB)" \
  || no "control: the extra-axiom theorem was not refused alone: '$CB' $(head -2 "$TMP/c-axiom.err")"
cat > "$TMP/c-clean.lean" <<'EOF'
theorem ConcreteSpecControl.clean : 1 = 1 := rfl
private theorem ConcreteSpecControl.hidden : 2 = 2 := rfl
EOF
population theorems "$TMP/c-clean.lean" > "$TMP/c-clean.tsv" 2>/dev/null
# A private name carries the file it was declared in (`_private.<file>.0.…`); the temporary copy's
# name is random, so it is normalized before the comparison.
D=$(golden_diff "$TMP/c-clean.tsv" "$GOLDEN" | sed -E 's/^> _private\..*\.0\.ConcreteSpecControl\./> _private.0.ConcreteSpecControl./')
[ "$D" = "$(printf '> ConcreteSpecControl.clean\t\n> _private.0.ConcreteSpecControl.hidden\t')" ] \
  && ok "control: a new theorem, even axiom-free and even private, is a golden difference" \
  || no "control: new public and private theorems gave the diff '$D'"
FIRST=$(head -1 "$TMP/inv.tsv" | cut -f1)
grep -vF -- "$FIRST	" "$GOLDEN" > "$TMP/g-missing"
[ -n "$(golden_diff "$TMP/inv.tsv" "$TMP/g-missing")" ] \
  && ok "control: a golden missing a theorem ($FIRST) differs" || no "control: a golden missing $FIRST compared equal"
awk -F'\t' 'BEGIN{OFS="\t"} !/^#/ && !done && $2 == "" { $2 = "propext"; done = 1 } { print }' "$GOLDEN" > "$TMP/g-axiom"
! cmp -s "$GOLDEN" "$TMP/g-axiom" && [ -n "$(golden_diff "$TMP/inv.tsv" "$TMP/g-axiom")" ] \
  && ok "control: a golden recording other axioms for a theorem differs" || no "control: a changed axiom set compared equal"
printf '%s\n' ConcreteSpec ConcreteSpec.Spec > "$TMP/imp-short.txt"
[ -n "$(closure_gap "$TMP/imp-short.txt")" ] \
  && ok "control: source modules outside a (truncated) import closure are reported" || no "control: a truncated closure reported no gap"
finish
#!/usr/bin/env bash
# FRESH KERNEL RE-CHECK: the built specification replayed through Lean's kernel from nothing, with
# leanchecker (the lean4checker that ships in the toolchain; no Mathlib).
#
# lake build checks each declaration once, as it is elaborated; what lands in the .olean files is
# whatever the elaborator added. A declaration added without checking (`debug.skipKernelTC`, or a
# metaprogram calling the kernel's unchecked add) is in the environment unchecked, and it can carry
# no axiom at all, so scripts/proofs/axioms.sh cannot see it. Replaying the stored declarations
# through the kernel can.
#
#   P  every module the ConcreteSpec sources declare is in the root's import closure, so replaying
#      the root replays all of them (the closure itself is listed from the environment);
#   F  `leanchecker --fresh ConcreteSpec`: every constant of the root's closure, Lean core included,
#      re-added to an EMPTY kernel environment, in dependency order;
#   M  `leanchecker ConcreteSpec`: every ConcreteSpec module's own declarations replayed on top of its
#      imports, module by module (the mode that names the module at fault).
#
# THE MODULE LIST COMES FROM THE SOURCES (ISS-0016). Given a prefix, leanchecker replays every .olean
# on its search path under that prefix. The build directory also holds .olean files of modules whose
# source was deleted or renamed (the CI lake cache restores an older build through a restore-key
# prefix), so trusting it replays modules that no longer exist: CI run 42424028055 failed on
# ConcreteSpec.Spec.Ownership after its rename to Slice1Ownership. Both legs therefore run on a staged
# library holding the .olean files of exactly the modules the sources declare (spec_modules), with the
# package's build directory replaced by the stage in LEAN_PATH, and M checks that the replayed set is
# exactly that list. scripts/proofs/lib.sh also prunes orphaned build files before building.
#
# NEGATIVE CONTROL: a throwaway package of this toolchain with two modules. ReplayGood proves a true
# statement honestly; ReplayBad adds `ReplayBad.forged : False` with `debug.skipKernelTC` and proves
# a theorem from it. Both build, and the forged theorem uses no axiom (so the axiom inventory would
# pass it). leanchecker must accept ReplayGood and reject ReplayBad at the forged declaration, in
# both modes. ORPHAN CONTROL: that forged module planted as an orphan under ConcreteSpec/ in a copy of
# the build directory fails an unfiltered replay of the copy, and the staged replay of the same copy
# ignores it and passes; a stage missing a source module is refused.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../checks/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"
CHECK_NAME=PROOF-KERNEL-REPLAY
source scripts/proofs/lib.sh

echo "=== P: population ==="
population imported > "$TMP/imported.txt" || { no "PROOF_MODE=imported failed"; finish; }
GAP=$(closure_gap "$TMP/imported.txt")
[ -z "$GAP" ] && ok "all $(spec_modules | grep -c .) ConcreteSpec source modules are in the closure the replay reads" \
  || no "source modules outside the import closure of ConcreteSpec: $(echo $GAP)"

echo "=== F/M: replay ==="
spec_modules > "$TMP/modules.txt"
PKG_LIB="$ROOT_DIR/.lake/build/lib/lean"
TOOL_PATH="$("$LAKE" env printenv LEAN_PATH)" || { no "lake env printenv LEAN_PATH failed"; finish; }
# stage_lib FROM DEST < MODULES: copy each listed module's .olean files (FROM/A/B.olean*, no .hash)
# into DEST. A listed module with no .olean is a problem line; nothing unlisted is copied.
stage_lib() {
  local from="$1" dest="$2" m p f n
  mkdir -p "$dest"
  while read -r m; do
    p="${m//.//}"; n=0
    for f in "$from/$p".olean "$from/$p".olean.*; do
      case "$f" in *.hash) continue ;; esac
      [ -f "$f" ] || continue
      mkdir -p "$dest/$(dirname "$p")"; cp "$f" "$dest/$(dirname "$p")/" && n=$((n+1))
    done
    [ "$n" -gt 0 ] || echo "no .olean for source module $m under $from"
  done
}
# staged_path STAGE: LEAN_PATH with the package's build directory replaced by STAGE (exactly once).
staged_path() {
  printf '%s' "$TOOL_PATH" | tr ':' '\n' | awk -v pkg="$PKG_LIB" -v st="$1" \
    '$0 == pkg { print st; n++; next } { print } END { if (n != 1) exit 1 }' | paste -sd: -
}
# replay_problems EXPECTED REPLAYED-OUTPUT: the module sets differ, as one line per difference.
replay_problems() {
  sed -n 's/^replaying \(ConcreteSpec[^ ]*\).*/\1/p' "$2" | sort -u > "$2.set"
  comm -23 "$1" "$2.set" | sed 's/^/not replayed: /'
  comm -13 "$1" "$2.set" | sed 's/^/replayed but not a source module: /'
}
leancheck() { # LEAN_PATH args...
  local lp="$1"; shift; "$LAKE" env env LEAN_PATH="$lp" leanchecker "$@"; }
STAGE="$TMP/stage"
out="$(stage_lib "$PKG_LIB" "$STAGE" < "$TMP/modules.txt")"
[ -z "$out" ] || { no "staging the source modules: $(echo $out)"; finish; }
SPATH="$(staged_path "$STAGE")" || { no "LEAN_PATH ($TOOL_PATH) does not name $PKG_LIB exactly once"; finish; }
ok "staged the $(grep -c . "$TMP/modules.txt") source modules' .olean files; LEAN_PATH reads the stage, not the build directory"
t0=$SECONDS
leancheck "$SPATH" --fresh ConcreteSpec > "$TMP/f.out" 2>&1; rc=$?
[ "$rc" = 0 ] && ok "leanchecker --fresh ConcreteSpec: the whole closure re-checked from an empty kernel environment ($((SECONDS-t0))s)" \
  || no "leanchecker --fresh ConcreteSpec failed (rc=$rc): $(tail -5 "$TMP/f.out" | tr '\n' ' ')"
t0=$SECONDS
leancheck "$SPATH" --verbose ConcreteSpec > "$TMP/m.out" 2>&1; rc=$?
diff_m="$(replay_problems "$TMP/modules.txt" "$TMP/m.out")"
NREP=$(grep -c . "$TMP/m.out.set")
[ "$rc" = 0 ] && [ -z "$diff_m" ] \
  && ok "leanchecker ConcreteSpec: exactly the $NREP source modules replayed on their imports ($((SECONDS-t0))s)" \
  || no "leanchecker ConcreteSpec: rc=$rc, $NREP modules replayed; $(echo $diff_m) $(grep -v '^replaying' "$TMP/m.out" | tail -5 | tr '\n' ' ')"

echo "=== negative control: a declaration added without kernel checking ==="
C="$TMP/control"; mkdir -p "$C"
cp lean-toolchain "$C/"
cat > "$C/lakefile.toml" <<'EOF'
name = "replay-control"
[[lean_lib]]
name = "ReplayGood"
[[lean_lib]]
name = "ReplayBad"
EOF
cat > "$C/ReplayGood.lean" <<'EOF'
theorem ReplayGood.honest : 2 + 2 = 4 := rfl
EOF
cat > "$C/ReplayBad.lean" <<'EOF'
import Lean
open Lean Elab Command
set_option debug.skipKernelTC true in
run_cmd liftCoreM <| addDecl <| .thmDecl {
  name := `ReplayBad.forged, levelParams := [], type := mkConst ``False, value := mkConst ``True.intro }
theorem ReplayBad.anything : 1 = 2 := False.elim ReplayBad.forged
#print axioms ReplayBad.anything
EOF
if (cd "$C" && "$LAKE" build ReplayGood ReplayBad > build.out 2>&1); then
  has_match -F "'ReplayBad.anything' does not depend on any axioms" < "$C/build.out" \
    && ok "control: the forged theorem builds and depends on no axiom (the axiom inventory cannot see it)" \
    || no "control: unexpected axiom report for the forged theorem: $(grep -i axiom "$C/build.out" | head -2 | tr '\n' ' ')"
  for mode in --fresh ""; do
    (cd "$C" && "$LAKE" env leanchecker $mode ReplayGood) > "$TMP/g.out" 2>&1; rg=$?
    (cd "$C" && "$LAKE" env leanchecker $mode ReplayBad) > "$TMP/b.out" 2>&1; rb=$?
    [ "$rg" = 0 ] && ok "control: leanchecker ${mode:-(per module)} accepts the honest module" \
      || no "control: leanchecker ${mode:-(per module)} rejected the honest module (rc=$rg): $(tail -3 "$TMP/g.out" | tr '\n' ' ')"
    [ "$rb" != 0 ] && has_match -F "(kernel) declaration type mismatch, 'ReplayBad.forged'" < "$TMP/b.out" \
      && ok "control: leanchecker ${mode:-(per module)} rejects the forged declaration (rc=$rb)" \
      || no "control: leanchecker ${mode:-(per module)} on the forged module: rc=$rb: $(tail -3 "$TMP/b.out" | tr '\n' ' ')"
  done
  echo "=== orphan control: a build-directory module with no source ==="
  O="$TMP/orphan-lib"; cp -a "$PKG_LIB" "$O"
  cp "$C/.lake/build/lib/lean/ReplayBad.olean" "$O/ConcreteSpec/Spec/OrphanControl.olean"
  leancheck "$(staged_path "$O")" --verbose ConcreteSpec > "$TMP/o1.out" 2>&1; r1=$?
  [ "$r1" != 0 ] && has_match -F "(kernel) declaration type mismatch, 'ReplayBad.forged'" < "$TMP/o1.out" \
    && ok "control: an unfiltered replay of the build directory replays the planted orphan and fails (rc=$r1)" \
    || no "control: the planted orphan did not fail an unfiltered replay (rc=$r1): $(tail -3 "$TMP/o1.out" | tr '\n' ' ')"
  OS="$TMP/orphan-stage"; out="$(stage_lib "$O" "$OS" < "$TMP/modules.txt")"
  leancheck "$(staged_path "$OS")" --verbose ConcreteSpec > "$TMP/o2.out" 2>&1; r2=$?
  [ -z "$out" ] && [ "$r2" = 0 ] && [ -z "$(replay_problems "$TMP/modules.txt" "$TMP/o2.out")" ] \
    && [ ! -e "$OS/ConcreteSpec/Spec/OrphanControl.olean" ] \
    && ok "control: the staged replay of the same directory ignores the orphan and replays exactly the source modules" \
    || no "control: staged replay with a planted orphan: rc=$r2 $out $(replay_problems "$TMP/modules.txt" "$TMP/o2.out" | tr '\n' ' ')"
  PB="$TMP/prune-build"; mkdir -p "$PB/lib" "$PB/ir/ConcreteSpec/Spec"; cp -a "$PKG_LIB" "$PB/lib/lean"
  for x in olean ilean trace olean.hash; do echo x > "$PB/lib/lean/ConcreteSpec/Spec/OrphanControl.$x"; done
  echo x > "$PB/ir/ConcreteSpec/Spec/OrphanControl.c"
  pout="$(prune_orphans "$PB")"
  left="$(find "$PB" -name '*Orphan*' | tr '\n' ' ')"
  kept="$(stage_lib "$PB/lib/lean" "$TMP/prune-kept" < "$TMP/modules.txt")"
  [ -z "$left" ] && [ -z "$kept" ] && [ "$(grep -c '^pruned orphan' <<< "$pout")" = 5 ] \
    && ok "control: prune_orphans removes the 5 planted orphan files and keeps every source module's .olean" \
    || no "control: prune_orphans left '$left', lost '$kept', said: $(echo $pout)"
  PF="$TMP/prune-failclosed"; mkdir -p "$PF/lib"; cp -a "$PKG_LIB" "$PF/lib/lean"
  before="$(find "$PF" -type f | wc -l)"
  for bad in 'echo ConcreteSpec.Spec.Basics' 'printf "ConcreteSpec\nConcreteSpec.Spec.NoSource\n"' 'false'; do
    ( spec_modules() { eval "$bad"; }; prune_orphans "$PF" ) > /dev/null 2>&1; rp=$?
    [ "$rp" != 0 ] && [ "$(find "$PF" -type f | wc -l)" = "$before" ] \
      && ok "control: prune_orphans refuses a bad source list ($bad) and deletes nothing" \
      || no "control: prune_orphans with a bad source list ($bad): rc=$rp, files $before -> $(find "$PF" -type f | wc -l)"
  done
  { cat "$TMP/modules.txt"; echo ConcreteSpec.Spec.NoSuchModule; } | sort > "$TMP/modules-plus.txt"
  out="$(stage_lib "$PKG_LIB" "$TMP/missing-stage" < "$TMP/modules-plus.txt")"
  has_match -F "no .olean for source module ConcreteSpec.Spec.NoSuchModule" <<< "$out" \
    && ok "control: a source module with no built .olean is refused, not skipped" || no "control: missing module staged silently: $out"
  printf 'replaying ConcreteSpec.Spec.Basics\n' > "$TMP/short.out"
  [ -n "$(replay_problems "$TMP/modules.txt" "$TMP/short.out")" ] \
    && ok "control: a replay that skips source modules is refused by the set comparison" || no "control: short replay accepted"
else
  no "control: the control package did not build: $(tail -5 "$C/build.out" | tr '\n' ' ')"
fi
finish
#!/usr/bin/env bash
# Every root check, in order; the one entry point the pre-push hook, CI's "Root checks" job and the
# landing tools (scripts/land/train.sh, ready.sh: LAND_FULL_GATES_CMD) run.
#
# The set is every scripts/checks/*.sh except this file, so a new check cannot be written and then
# forgotten here. REQUIRED names the checks that must exist: deleting one fails the run instead of
# shrinking it. Each check runs to completion; the run fails if any check failed.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"
REQUIRED="legacy_frozen root_inventory workflow_yaml doc_links landing_script landing_ready review_tool sandbox_isolation retention_manifest issues oracle_fetch"
missing=""
for c in $REQUIRED; do [ -f "scripts/checks/$c.sh" ] || missing="$missing $c"; done
[ -z "$missing" ] || { echo "run.sh: required check(s) missing:$missing" >&2; exit 1; }
failed="" n=0
for f in scripts/checks/*.sh; do
  [ "$f" = scripts/checks/run.sh ] && continue
  n=$((n+1))
  echo "=== $f ==="
  s="$(date +%s)"
  if bash "$f"; then echo "--- $f: pass ($(( $(date +%s) - s ))s)"
  else echo "--- $f: FAIL ($(( $(date +%s) - s ))s)"; failed="$failed ${f##*/}"; fi
done
echo
if [ -n "$failed" ]; then echo "root checks: FAILED:$failed (of $n)"; exit 1; fi
echo "root checks: all $n pass"

exec
/bin/bash -lc "cat ConcreteSpec/README.md ISSUES.tsv; rg -n 'saniti|trap|axiom|theorem|budget|termination|may_not_terminate|OD120|repr.C|ABI' scripts/proofs scripts/checks/compiler docs/decisions.md Concrete/README.md; cat branches/C-gate-scaling-determinism.diff" in /home/unbalancedparen/projects/gates-briefs/prop-codex2
