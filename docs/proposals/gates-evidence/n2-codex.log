import ConcreteSpec.Spec.Exec

/-!
# The laws of execution, calls and cleanup (`Spec/Exec.lean`, foundation contract C1)

PROPOSED: not normative until the owner freezes Core (ROADMAP A2c). See `ConcreteSpec/README.md`.

What these prove, for every operand language:

- **Sequencing**: `seq s t` runs `s` with `t` as its continuation; `t` runs when `s` completes, and
  an exit from `s` skips it (`step_seq`, `step_done_seq`, `step_exit_seq`).
- **Scope restoration**: leaving a scope keeps exactly the locals visible when it was entered,
  with their current values (`lookup_restrict`); the shared state is not restored: a call's
  return keeps the state the callee left (`step_return_caller`).
- **Registration**: `defer` adds a call as the newest of the innermost scope (`register_scope`),
  so `defer d₁; defer d₂` leaves `d₂` before `d₁` (`two_defers_register`).
- **Cleanup order**, in two forms. *Every* run: the only step an exit or the end of a block can
  take at a scope with registered calls starts its newest one (`exit_scope_next`,
  `done_scope_next`). *A run whose calls complete*: an exit through a scope runs its calls newest
  first, threading the state, and then restores the scope (`exit_scope_runs_defers`,
  `done_scope_runs_defers`); an exit through several frames runs the calls of `plan`, innermost
  scope first, and arrives unchanged (`unwind_runs_plan`); the cleanup runs exactly the calls of
  `plan`, in order (`cleans_iff_runs_plan`, `planWith_calls`); a `return` then reaches its caller with
  the value bound (`return_reaches_caller`), and a `break` or `continue` its loop
  (`break_reaches_loop`, `continue_reaches_loop`).
- **Exit values**: a `return` evaluates its value before any cleanup (`step_ret`).
- **Traps are terminal**: a trapped configuration has no step and no later event
  (`steps_from_trapped`); `abort()` runs no cleanup (`abort_runs_no_cleanup`), and so neither does a
  cleanup call that traps.
- **Evaluation order**: the first argument that traps decides the trap (`evalArgs_first_trap`).
- Steps of the machine itself are deterministic (`step_silent_deterministic`): only the answers of
  primitive operations, each allowed by its contract, can make two runs differ
  (`step_deterministic`).
- **Destruction order** (Q2.3): a sequence's element `i` is visited `i`-th and the backing last; a
  map's `i`-th entry has its key at `2i` and its value at `2i+1`, and the nodes come last.
-/

namespace ConcreteSpec.Core.Exec
open ConcreteSpec.Core

variable {O : Operands} {V : Type}

/-! ### Many steps -/

theorem Steps.single {P : Program O} {c c' : Config O} {l : Label O} (h : Step P c l c') :
    Steps P c l.events c' := by
  have := Steps.step h (Steps.refl c')
  simpa using this

theorem Steps.trans {P : Program O} {c c' c'' : Config O} {tr tr' : List O.Event}
    (h : Steps P c tr c') (h' : Steps P c' tr' c'') : Steps P c (tr ++ tr') c'' := by
  induction h with
  | refl => simpa using h'
  | step hs _ ih => simpa [List.append_assoc] using Steps.step hs (ih h')

/-- A silent step followed by more steps. -/
theorem steps_next {P : Program O} {c c' c'' : Config O} {tr : List O.Event}
    (h : step P c = some (.next c')) (h' : Steps P c' tr c'') : Steps P c tr c'' := by
  simpa [Label.events] using Steps.step (Step.silent h) h'

/-- A primitive operation answered within its contract, followed by more steps. -/
theorem steps_request {P : Program O} {c c'' : Config O} {p : O.Prim} {vs : List O.Val}
    {site : SiteId} {st : O.Store} {k : Answer O.Val O.Event O.Store → Option (Config O)}
    {a : Answer O.Val O.Event O.Store} {tr : List O.Event}
    (h : step P c = some (.request p vs site st k)) (ha : O.allows p vs st a = true)
    {c' : Config O} (hk : k a = some c') (h' : Steps P c' tr c'') : Steps P c (a.label.events ++ tr) c'' :=
  Steps.step (Step.prim h ha hk) h'

/-! ### Sequencing -/

theorem step_seq (P : Program O) (s t : Stmt O) (L : AList Var O.Val) (st : O.Store)
    (k : List (Frame O)) :
    step P ⟨.exec (.seq s t), L, st, k⟩ = some (.next ⟨.exec s, L, st, .seq t :: k⟩) := rfl

theorem step_done_seq (P : Program O) (t : Stmt O) (L : AList Var O.Val) (st : O.Store)
    (k : List (Frame O)) :
    step P ⟨.done, L, st, .seq t :: k⟩ = some (.next ⟨.exec t, L, st, k⟩) := rfl

theorem step_exit_seq (P : Program O) (e : Exit O.Val) (t : Stmt O) (L : AList Var O.Val)
    (st : O.Store) (k : List (Frame O)) :
    step P ⟨.exiting e, L, st, .seq t :: k⟩ = some (.next ⟨.exiting e, L, st, k⟩) := rfl

/-- Entering a block records the locals visible at its start. -/
theorem step_block (P : Program O) (b : BlockId) (s : Stmt O) (L : AList Var O.Val)
    (st : O.Store) (k : List (Frame O)) :
    step P ⟨.exec (.block b s), L, st, k⟩ =
      some (.next ⟨.exec s, L, st, .scope b (dom L) [] :: k⟩) := rfl

/-! ### Scope restoration -/

theorem lookup_restrict (dm : List Var) : ∀ (L : AList Var V) (x : Var),
    AList.lookup (restrict dm L) x = if x ∈ dm then AList.lookup L x else none
  | [], x => by by_cases h : x ∈ dm <;> simp [restrict, AList.lookup, h]
  | (y, v) :: L, x => by
    have ih := lookup_restrict dm L x
    by_cases hy : y ∈ dm
    · have hr : restrict dm ((y, v) :: L) = (y, v) :: restrict dm L := by
        simp [restrict, hy]
      rw [hr]
      by_cases hyx : y = x
      · subst hyx; simp [AList.lookup, hy]
      · simp only [AList.lookup, ite_eq_right hyx]; exact ih
    · have hr : restrict dm ((y, v) :: L) = restrict dm L := by
        simp [restrict, hy]
      rw [hr, ih]
      by_cases hyx : y = x
      · subst hyx; simp [hy]
      · simp [AList.lookup, hyx]

/-- Leaving a scope entered with locals `L₀` keeps no local bound inside it. -/
theorem restrict_dom_drops (L₀ L : AList Var V) (x : Var) (hx : x ∉ dom L₀) :
    AList.lookup (restrict (dom L₀) L) x = none := by
  rw [lookup_restrict]; simp [hx]

/-! ### Registration -/

/-- A deferred call is registered as the newest call of the innermost scope. -/
theorem register_scope (d : Deferred O) (b : BlockId) (dm : List Var) (ds : List (Deferred O))
    (k : List (Frame O)) : register d (.scope b dm ds :: k) = some (.scope b dm (d :: ds) :: k) :=
  rfl

theorem register_seq (d : Deferred O) (t : Stmt O) (k : List (Frame O)) :
    register d (.seq t :: k) = (register d k).map (.seq t :: ·) := rfl

/-- **Reverse registration order.** A block running `defer d₁; defer d₂; s` reaches `s` with its
scope holding `d₂` before `d₁`, so `d₂` runs first; nothing is emitted. -/
theorem two_defers_register (P : Program O) (b : BlockId) (d₁ d₂ : Deferred O) (s : Stmt O)
    (L : AList Var O.Val) (st : O.Store) (k : List (Frame O)) :
    Steps P ⟨.exec (.block b (.seq (.defer d₁.f d₁.args d₁.site)
        (.seq (.defer d₂.f d₂.args d₂.site) s))), L, st, k⟩ []
      ⟨.exec s, L, st, .scope b (dom L) [d₂, d₁] :: k⟩ :=
  steps_next rfl (steps_next rfl (steps_next rfl (steps_next rfl (steps_next rfl
    (steps_next rfl (steps_next rfl (Steps.refl _)))))))

/-! ### Exits -/

/-- `return` evaluates its value first: the next configuration carries the value and the same
frames, so no cleanup has run. -/
theorem step_ret (P : Program O) (e : O.Expr) (site : SiteId) (L : AList Var O.Val)
    (st st' : O.Store) (k : List (Frame O)) (v : O.Val) (hv : O.eval L st e = .ok (v, st')) :
    step P ⟨.exec (.ret e site), L, st, k⟩ = some (.next ⟨.exiting (.ret v), L, st', k⟩) := by
  simp [step, onRes, hv]

/-- A `break` reaching its loop's body frame continues after the loop. -/
theorem step_break_loop (P : Program O) (l : LoopId) (cr b : Stmt O) (t : O.Expr) (site : SiteId)
    (L : AList Var O.Val) (st : O.Store) (k : List (Frame O)) :
    step P ⟨.exiting (.brk l), L, st, .body l cr t b site :: k⟩ =
      some (.next ⟨.done, L, st, k⟩) := by
  simp [step, stepExit]

/-- A `continue` reaching its loop's body frame starts the loop again from its condition region. -/
theorem step_continue_loop (P : Program O) (l : LoopId) (cr b : Stmt O) (t : O.Expr)
    (site : SiteId) (L : AList Var O.Val) (st : O.Store) (k : List (Frame O)) :
    step P ⟨.exiting (.cont l), L, st, .body l cr t b site :: k⟩ =
      some (.next ⟨.exec (.loop l cr t b site), L, st, k⟩) := by
  simp [step, stepExit]

/-- A `return` reaching the call frame restores the caller's locals and binds the value; the state
is the one the callee left, with the instrumentation told the activation ended and the result
bound. -/
theorem step_return_caller (P : Program O) (v : O.Val) (dst : Option Var)
    (caller L : AList Var O.Val) (st : O.Store) (k : List (Frame O))
    (stLeave stBind : O.Store) (hl : O.life .leave st = some stLeave)
    (hb : bindLife O dst stLeave = some stBind) :
    step P ⟨.exiting (.ret v), L, st, .ret dst caller :: k⟩ =
      some (.next ⟨.done, bindDst dst v caller, stBind, k⟩) := by
  simp [step, stepExit, hl, hb]

/-! ### Cleanup -/

/-- **Every run.** At a scope with registered calls, the only step an exit can take starts the
newest call, remembering the exit. -/
theorem exit_scope_next {P : Program O} {e : Exit O.Val} {b : BlockId} {dm : List Var}
    {d : Deferred O} {ds : List (Deferred O)} {L : AList Var O.Val} {st : O.Store}
    {k : List (Frame O)} {l : Label O} {c : Config O}
    (h : Step P ⟨.exiting e, L, st, .scope b dm (d :: ds) :: k⟩ l c) :
    l = .silent ∧ c = ⟨.exec d.stmt, L, st, .resume (.exit e) :: .scope b dm ds :: k⟩ := by
  cases h with
  | silent h =>
    simp only [step, stepExit, startCleanup, Option.some.injEq, Out.next.injEq] at h
    exact ⟨rfl, h.symm⟩
  | prim h _ _ => simp [step, stepExit, startCleanup] at h

/-- The same at the normal end of a block. -/
theorem done_scope_next {P : Program O} {b : BlockId} {dm : List Var} {d : Deferred O}
    {ds : List (Deferred O)} {L : AList Var O.Val} {st : O.Store} {k : List (Frame O)}
    {l : Label O} {c : Config O} (h : Step P ⟨.done, L, st, .scope b dm (d :: ds) :: k⟩ l c) :
    l = .silent ∧ c = ⟨.exec d.stmt, L, st, .resume .fall :: .scope b dm ds :: k⟩ := by
  cases h with
  | silent h =>
    simp only [step, startCleanup, Option.some.injEq, Out.next.injEq] at h
    exact ⟨rfl, h.symm⟩
  | prim h _ _ => simp [step, startCleanup] at h

/-- An exit leaving a scope whose calls complete runs them newest first, each with its events and
its effect on the state, and leaves the scope with its locals restored; the exit, and a returned
value, are unchanged. -/
theorem exit_scope_runs_defers (P : Program O) (e : Exit O.Val) (b : BlockId) (dm : List Var)
    (L : AList Var O.Val) (k : List (Frame O)) {ds : List (Deferred O)} {st st' : O.Store}
    {tr : List O.Event} (h : RunsAll P L ds st tr st') {stDrop : O.Store}
    (hd : dropOut O dm L st' = some stDrop) :
    Steps P ⟨.exiting e, L, st, .scope b dm ds :: k⟩ tr
      ⟨.exiting e, restrict dm L, stDrop, k⟩ := by
  induction h with
  | nil st => exact steps_next (by simp [step, stepExit, hd]) (Steps.refl _)
  | @cons d ds st tr₁ st₁ tr₂ st₂ hcall _ ih =>
    exact steps_next (c := ⟨.exiting e, L, st, .scope b dm (d :: ds) :: k⟩) rfl
      (Steps.trans (hcall _) (steps_next rfl (ih hd)))

/-- The normal end of a block runs its calls the same way. -/
theorem done_scope_runs_defers (P : Program O) (b : BlockId) (dm : List Var)
    (L : AList Var O.Val) (k : List (Frame O)) {ds : List (Deferred O)} {st st' : O.Store}
    {tr : List O.Event} (h : RunsAll P L ds st tr st') {stDrop : O.Store}
    (hd : dropOut O dm L st' = some stDrop) :
    Steps P ⟨.done, L, st, .scope b dm ds :: k⟩ tr ⟨.done, restrict dm L, stDrop, k⟩ := by
  induction h with
  | nil st => exact steps_next (by simp [step, hd]) (Steps.refl _)
  | @cons d ds st tr₁ st₁ tr₂ st₂ hcall _ ih =>
    exact steps_next (c := ⟨.done, L, st, .scope b dm (d :: ds) :: k⟩) rfl
      (Steps.trans (hcall _) (steps_next rfl (ih hd)))

/-- **Cleanup order.** When the cleanup calls complete (`Cleans`, which runs the calls of
`plan pre` in that order: the innermost scope first, each scope's newest registration first), an
exit passing frames `pre` arrives at the frames below with the same exit, the locals the scopes
restored and the state the calls left. -/
theorem unwind_runs_plan (P : Program O) (e : Exit O.Val) (k : List (Frame O))
    {pre : List (Frame O)} {L : AList Var O.Val} {st st' : O.Store} {tr : List O.Event}
    (h : Cleans P pre L st tr st') (hp : ∀ f ∈ pre, Passes e f) :
    Steps P ⟨.exiting e, L, st, pre ++ k⟩ tr ⟨.exiting e, unwindLocals pre L, st', k⟩ := by
  induction h with
  | nil L st => exact Steps.refl _
  | @scope b dm ds pre L st tr₁ st₁ stDrop tr₂ st₂ hr hd _ ih =>
    have h1 := exit_scope_runs_defers P e b dm L (pre ++ k) hr hd
    have h2 := ih (fun f hf => hp f (List.mem_cons_of_mem _ hf))
    simpa [unwindLocals] using Steps.trans h1 h2
  | seq _ ih => exact steps_next rfl (ih (fun f hf => hp f (List.mem_cons_of_mem _ hf)))
  | test hd _ ih =>
    exact steps_next (by simp [step, stepExit, hd]) (ih (fun f hf => hp f (List.mem_cons_of_mem _ hf)))
  | @body l cr t b site pre L st tr st' _ ih =>
    have ih' := ih (fun f hf => hp f (List.mem_cons_of_mem _ hf))
    have hf : Passes e (.body l cr t b site) := hp _ List.mem_cons_self
    cases e with
    | brk l' =>
      have hne : l' ≠ l := hf
      exact steps_next (by simp [step, stepExit, hne]) ih'
    | cont l' =>
      have hne : l' ≠ l := hf
      exact steps_next (by simp [step, stepExit, hne]) ih'
    | ret v => exact steps_next rfl ih'

/-- The plan of nested scopes lists the inner scope's calls first. -/
theorem plan_scopes (b₁ b₂ : BlockId) (d₁ d₂ : List Var) (ds₁ ds₂ : List (Deferred O))
    (k : List (Frame O)) :
    plan (.scope b₁ d₁ ds₁ :: .scope b₂ d₂ ds₂ :: k) = ds₁ ++ (ds₂ ++ plan k) := rfl

/-- **A `return` reaches its caller** after the cleanup of every scope it leaves: the caller's
locals come back with the value bound, in the state the cleanup left. -/
theorem return_reaches_caller (P : Program O) (v : O.Val) (dst : Option Var)
    (caller : AList Var O.Val) (k : List (Frame O)) {pre : List (Frame O)}
    {L : AList Var O.Val} {st st' : O.Store} {tr : List O.Event}
    (h : Cleans P pre L st tr st') (hp : ∀ f ∈ pre, Passes (.ret v) f)
    (stLeave stBind : O.Store) (hl : O.life .leave st' = some stLeave)
    (hb : bindLife O dst stLeave = some stBind) :
    Steps P ⟨.exiting (.ret v), L, st, pre ++ .ret dst caller :: k⟩ tr
      ⟨.done, bindDst dst v caller, stBind, k⟩ := by
  have := Steps.trans (unwind_runs_plan P (.ret v) (.ret dst caller :: k) h hp)
    (steps_next (step_return_caller P v dst caller _ st' k stLeave stBind hl hb) (Steps.refl _))
  simpa using this

/-- **A `break` reaches its loop** after the cleanup of the scopes inside the loop body, and the
loop is done. -/
theorem break_reaches_loop (P : Program O) (l : LoopId) (cr b : Stmt O) (t : O.Expr)
    (site : SiteId) (k : List (Frame O)) {pre : List (Frame O)} {L : AList Var O.Val}
    {st st' : O.Store} {tr : List O.Event}
    (h : Cleans P pre L st tr st') (hp : ∀ f ∈ pre, Passes (.brk l) f) :
    Steps P ⟨.exiting (.brk l), L, st, pre ++ .body l cr t b site :: k⟩ tr
      ⟨.done, unwindLocals pre L, st', k⟩ := by
  have := Steps.trans (unwind_runs_plan P (.brk l) (.body l cr t b site :: k) h hp)
    (steps_next (step_break_loop P l cr b t site _ st' k) (Steps.refl _))
  simpa using this

/-- **A `continue` reaches its loop** after the same cleanup, and the loop starts again from its
condition region. -/
theorem continue_reaches_loop (P : Program O) (l : LoopId) (cr b : Stmt O) (t : O.Expr)
    (site : SiteId) (k : List (Frame O)) {pre : List (Frame O)} {L : AList Var O.Val}
    {st st' : O.Store} {tr : List O.Event}
    (h : Cleans P pre L st tr st') (hp : ∀ f ∈ pre, Passes (.cont l) f) :
    Steps P ⟨.exiting (.cont l), L, st, pre ++ .body l cr t b site :: k⟩ tr
      ⟨.exec (.loop l cr t b site), unwindLocals pre L, st', k⟩ := by
  have := Steps.trans (unwind_runs_plan P (.cont l) (.body l cr t b site :: k) h hp)
    (steps_next (step_continue_loop P l cr b t site _ st' k) (Steps.refl _))
  simpa using this

/-! ### What the cleanup runs

`Cleans` runs the calls of `plan`, each with the locals of its scope's point in the unwinding, and
tells the instrumentation which locals each scope it leaves drops: `planWith` lists those actions in
order, its calls are `plan`'s (`planWith_calls`), and a cleanup is a run of exactly those actions
(`cleans_iff_runs_plan`). -/

/-- One action of a cleanup: a call, with the locals it runs with, or leaving a scope entered with
`dm`, from locals `L`. -/
inductive CleanAct (O : Operands) where
  | call (L : AList Var O.Val) (d : Deferred O)
  | drop (dm : List Var) (L : AList Var O.Val)

/-- The call of an action, if it is one. -/
def CleanAct.call? : CleanAct O → Option (Deferred O)
  | .call _ d => some d
  | .drop .. => none

/-- The actions an exit through frames `pre` performs, from locals `L`, in order. -/
def planWith : List (Frame O) → AList Var O.Val → List (CleanAct O)
  | [], _ => []
  | .scope _ dm ds :: k, L => ds.map (.call L) ++ .drop dm L :: planWith k (restrict dm L)
  | .test _ _ _ _ _ dm :: k, L => .drop dm L :: planWith k (restrict dm L)
  | _ :: k, L => planWith k L

theorem planWith_calls : ∀ (pre : List (Frame O)) (L : AList Var O.Val),
    (planWith pre L).filterMap CleanAct.call? = plan pre
  | [], _ => rfl
  | .scope _ dm ds :: k, L => by
    have hds : (ds.map (CleanAct.call L)).filterMap CleanAct.call? = ds := by
      induction ds with
      | nil => rfl
      | cons d ds ih => simp [CleanAct.call?] at ih ⊢; exact ih
    simp only [planWith, plan, List.filterMap_append, hds, List.filterMap_cons, CleanAct.call?,
      planWith_calls k (restrict dm L)]
  | .test _ _ _ _ _ dm :: k, L => by
    simp only [planWith, plan, List.filterMap_cons, CleanAct.call?]
    exact planWith_calls k (restrict dm L)
  | .seq _ :: k, L => planWith_calls k L
  | .body .. :: k, L => planWith_calls k L
  | .resume _ :: k, L => planWith_calls k L
  | .ret .. :: k, L => planWith_calls k L

/-- A list of cleanup actions run one after another, the state threaded: each call completes, and
each scope left tells the instrumentation what it drops. -/
inductive RunsEach (P : Program O) : List (CleanAct O) → O.Store → List O.Event → O.Store → Prop where
  | nil (st : O.Store) : RunsEach P [] st [] st
  | call {L d rest st tr₁ st₁ tr₂ st₂} : Completes P L d st tr₁ st₁ →
      RunsEach P rest st₁ tr₂ st₂ → RunsEach P (.call L d :: rest) st (tr₁ ++ tr₂) st₂
  | drop {dm L rest st stDrop tr st'} : dropOut O dm L st = some stDrop →
      RunsEach P rest stDrop tr st' →
      RunsEach P (.drop dm L :: rest) st tr st'

theorem RunsAll.each {P : Program O} {L : AList Var O.Val} {ds : List (Deferred O)}
    {st st₁ st₂ : O.Store} {tr₁ tr₂ : List O.Event} {rest : List (CleanAct O)}
    (h : RunsAll P L ds st tr₁ st₁) (h' : RunsEach P rest st₁ tr₂ st₂) :
    RunsEach P (ds.map (.call L) ++ rest) st (tr₁ ++ tr₂) st₂ := by
  induction h with
  | nil => simpa using h'
  | cons hd _ ih => simpa [List.append_assoc] using RunsEach.call hd (ih h')

theorem RunsEach.split_calls {P : Program O} {L : AList Var O.Val} :
    ∀ {ds : List (Deferred O)} {rest : List (CleanAct O)} {st st₂ : O.Store} {tr : List O.Event},
    RunsEach P (ds.map (.call L) ++ rest) st tr st₂ →
    ∃ tr₁ st₁ tr₂, tr = tr₁ ++ tr₂ ∧ RunsAll P L ds st tr₁ st₁ ∧ RunsEach P rest st₁ tr₂ st₂
  | [], _, _, _, _, h => ⟨[], _, _, rfl, .nil _, by simpa using h⟩
  | d :: ds, rest, st, st₂, tr, h => by
    cases h with
    | call hd hr =>
      obtain ⟨tr₁, st₁, tr₂, rfl, ha, hb⟩ := RunsEach.split_calls hr
      exact ⟨_, st₁, tr₂, by simp [List.append_assoc], .cons hd ha, hb⟩

/-- The frames an exit can pass: every frame but a running cleanup call's and a call's (`Passes`
for some exit). -/
def Frame.passable : Frame O → Bool
  | .resume _ | .ret .. => false
  | _ => true

/-- **A cleanup runs exactly the plan**: through frames an exit can pass, the calls of `plan pre`,
in order, each with its scope's locals, with each scope's drop between them, and nothing else. -/
theorem cleans_iff_runs_plan {P : Program O} :
    ∀ {pre : List (Frame O)} {L : AList Var O.Val} {st st' : O.Store} {tr : List O.Event},
    (∀ f ∈ pre, f.passable = true) →
    (Cleans P pre L st tr st' ↔ RunsEach P (planWith pre L) st tr st')
  | [], L, st, st', tr, _ => by
    constructor
    · intro h; cases h; exact .nil _
    · intro h; cases h; exact .nil _ _
  | .scope b dm ds :: pre, L, st, st', tr, hp => by
    have hp' := fun f hf => hp f (List.mem_cons_of_mem _ hf)
    constructor
    · intro h
      cases h with
      | scope hr hd hc => exact RunsAll.each hr (.drop hd ((cleans_iff_runs_plan hp').1 hc))
    · intro h
      obtain ⟨tr₁, st₁, tr₂, rfl, ha, hb⟩ := RunsEach.split_calls h
      cases hb with
      | drop hd hb => exact .scope ha hd ((cleans_iff_runs_plan hp').2 hb)
  | .test l cr t b site dm :: pre, L, st, st', tr, hp => by
    have hp' := fun f hf => hp f (List.mem_cons_of_mem _ hf)
    constructor
    · intro h; cases h with
      | test hd hc => exact .drop hd ((cleans_iff_runs_plan hp').1 hc)
    · intro h; cases h with
      | drop hd hb => exact .test hd ((cleans_iff_runs_plan hp').2 hb)
  | .seq _ :: pre, L, st, st', tr, hp => by
    have hp' := fun f hf => hp f (List.mem_cons_of_mem _ hf)
    constructor
    · intro h; cases h with
      | seq hc => exact (cleans_iff_runs_plan hp').1 hc
    · intro h; exact .seq ((cleans_iff_runs_plan hp').2 h)
  | .body .. :: pre, L, st, st', tr, hp => by
    have hp' := fun f hf => hp f (List.mem_cons_of_mem _ hf)
    constructor
    · intro h; cases h with
      | body hc => exact (cleans_iff_runs_plan hp').1 hc
    · intro h; exact .body ((cleans_iff_runs_plan hp').2 h)
  | .resume _ :: _, _, _, _, _, hp => absurd (hp _ List.mem_cons_self) (by simp [Frame.passable])
  | .ret .. :: _, _, _, _, _, hp => absurd (hp _ List.mem_cons_self) (by simp [Frame.passable])

/-- Every frame an exit passes is passable. -/
theorem Passes.passable {e : Exit O.Val} : ∀ {f : Frame O}, Passes e f → f.passable = true
  | .seq _, _ | .scope .., _ | .test .., _ | .body .., _ => rfl
  | .resume _, h => h.elim
  | .ret .., h => h.elim

/-! ### Traps are terminal -/

theorem step_trapped (P : Program O) (kd : TrapKind) (site : SiteId) (L : AList Var O.Val)
    (st : O.Store) (k : List (Frame O)) : step P ⟨.trapped kd site, L, st, k⟩ = none := rfl

/-- After a trap nothing runs: no step, no event, and the frames are not unwound. -/
theorem steps_from_trapped {P : Program O} {kd : TrapKind} {site : SiteId} {L : AList Var O.Val}
    {st : O.Store} {k : List (Frame O)} {tr : List O.Event} {c : Config O}
    (h : Steps P ⟨.trapped kd site, L, st, k⟩ tr c) :
    tr = [] ∧ c = ⟨.trapped kd site, L, st, k⟩ := by
  cases h with
  | refl => exact ⟨rfl, rfl⟩
  | step hs _ =>
    cases hs with
    | silent h => simp [step_trapped] at h
    | prim h _ _ => simp [step_trapped] at h

/-- **`abort()` runs no cleanup.** From `abort()` the only step is to the trap, with the same
frames and state, and nothing follows: no deferred call runs and no event is emitted. -/
theorem abort_runs_no_cleanup {P : Program O} {site : SiteId} {L : AList Var O.Val}
    {st : O.Store} {k : List (Frame O)} {tr : List O.Event} {c : Config O}
    (h : Steps P ⟨.exec (.abort site), L, st, k⟩ tr c) :
    tr = [] ∧ (c = ⟨.exec (.abort site), L, st, k⟩ ∨ c = ⟨.trapped .abort site, L, st, k⟩) := by
  cases h with
  | refl => exact ⟨rfl, .inl rfl⟩
  | step hs hrest =>
    cases hs with
    | silent h =>
      simp only [step, Option.some.injEq, Out.next.injEq] at h
      subst h
      have := steps_from_trapped hrest
      exact ⟨by simpa [Label.events] using this.1, .inr this.2⟩
    | prim h _ _ => simp [step] at h

/-! ### Evaluation order and determinism -/

/-- The first argument that traps decides the trap, whatever follows it: once the arguments
before it evaluate, in whatever state they leave. -/
theorem evalArgs_first_trap (L : AList Var O.Val) (e : O.Expr) (kd : TrapKind)
    (es₂ : List O.Expr) :
    ∀ (es₁ : List O.Expr) (st st₁ : O.Store) (vs : List O.Val),
      evalArgs O L st es₁ = .ok (vs, st₁) → O.eval L st₁ e = .trap kd →
      evalArgs O L st (es₁ ++ e :: es₂) = .trap kd
  | [], st, st₁, _, h, he => by
    simp only [evalArgs, Res.ok.injEq, Prod.mk.injEq] at h
    obtain ⟨_, rfl⟩ := h
    simp [evalArgs, he, Res.bind]
  | e₁ :: es₁, st, st₁, vs, h, he => by
    show evalArgs O L st (e₁ :: (es₁ ++ e :: es₂)) = _
    cases h₁ : O.eval L st e₁ with
    | ok p =>
      obtain ⟨v₁, st₀⟩ := p
      cases h₂ : evalArgs O L st₀ es₁ with
      | ok q =>
        obtain ⟨vs₁, st₂⟩ := q
        have hst : st₂ = st₁ := by
          simp [evalArgs, h₁, h₂, Res.bind, Res.map] at h; exact h.2
        subst hst
        have := evalArgs_first_trap L e kd es₂ es₁ st₀ st₂ vs₁ h₂ he
        simp [evalArgs, h₁, this, Res.bind, Res.map]
      | trap _ => simp [evalArgs, h₁, h₂, Res.bind, Res.map] at h
      | stuck => simp [evalArgs, h₁, h₂, Res.bind, Res.map] at h
    | trap _ => simp [evalArgs, h₁, Res.bind] at h
    | stuck => simp [evalArgs, h₁, Res.bind] at h

/-- Steps of the machine itself are deterministic. -/
theorem step_silent_deterministic {P : Program O} {c c₁ c₂ : Config O}
    (h₁ : step P c = some (.next c₁)) (h₂ : step P c = some (.next c₂)) : c₁ = c₂ := by
  rw [h₁] at h₂; cases h₂; rfl

/-- **Determinism up to the environment.** Two steps from one configuration reach the same
configuration with the same label, unless the configuration requests a primitive operation: then
each step takes an answer the contract allows, is labeled by it and continues with it, so only the
environment's answers can differ, and equal answers give equal steps. -/
theorem step_deterministic {P : Program O} {c c₁ c₂ : Config O} {l₁ l₂ : Label O}
    (h₁ : Step P c l₁ c₁) (h₂ : Step P c l₂ c₂) :
    (l₁ = l₂ ∧ c₁ = c₂) ∨ ∃ p vs site st k a₁ a₂, step P c = some (.request p vs site st k) ∧
      O.allows p vs st a₁ = true ∧ O.allows p vs st a₂ = true ∧
      l₁ = a₁.label ∧ l₂ = a₂.label ∧ k a₁ = some c₁ ∧ k a₂ = some c₂ := by
  cases h₁ with
  | silent h =>
    cases h₂ with
    | silent h' => exact .inl ⟨rfl, step_silent_deterministic h h'⟩
    | prim h' _ _ => rw [h] at h'; cases h'
  | prim h ha hk =>
    cases h₂ with
    | silent h' => rw [h] at h'; cases h'
    | prim h' ha' hk' =>
      rw [h] at h'; cases h'
      exact .inr ⟨_, _, _, _, _, _, _, h, ha, ha', rfl, rfl, hk, hk'⟩

/-! ### Lifecycle refusal

No law assumes that `life` is total. `step_return_caller` and `return_reaches_caller`
now require successful leave and result binding; `exit_scope_runs_defers` and
`done_scope_runs_defers` require a successful drop. `Cleans` and `RunsEach` carry
successful drops, so their existing plan and unwinding laws keep the same meaning.
`steps_request` requires successful continuation, and `step_deterministic` records
those successful continuations explicitly. All other laws retain their premises.
-/

/-- A refused machine step has no transition, silent or primitive. -/
theorem no_step_of_none {P : Program O} {c : Config O} (h : step P c = none)
    (l : Label O) (c' : Config O) : ¬ Step P c l c' := by
  intro hs
  cases hs with
  | silent hs => rw [h] at hs; cases hs
  | prim hs _ _ => rw [h] at hs; cases hs

/-- Refusing initialization makes a binding stuck after its operand succeeds. -/
theorem bind_refused (P : Program O) (x : Var) (e : O.Expr) (site : SiteId)
    (L : AList Var O.Val) (st st' : O.Store) (v : O.Val) (k : List (Frame O))
    (he : O.eval L st e = .ok (v, st')) (hl : O.life (.bind x) st' = none) :
    step P ⟨.exec (.bind x e site), L, st, k⟩ = none := by
  simp [step, onRes, he, hl]

/-- Assignment also propagates refused initialization, even for an existing local. -/
theorem assign_refused (P : Program O) (x : Var) (e : O.Expr) (site : SiteId)
    (L : AList Var O.Val) (st st' : O.Store) (v : O.Val) (k : List (Frame O))
    (he : O.eval L st e = .ok (v, st')) (hl : O.life (.bind x) st' = none) :
    step P ⟨.exec (.assign x e site), L, st, k⟩ = none := by
  simp only [step, onRes, he]
  cases AList.lookup L x <;> simp [hl]

/-- Initial entry, including main, cannot produce a configuration if activation is refused. -/
theorem enter_refused (fn : Fn O) (vs : List O.Val) (st : O.Store)
    (hl : O.life (.enter (fn.params.map Prod.fst)) st = none) :
    enter fn vs st = none := by
  simp [enter, hl]

/-- Internal call entry refuses the step after evaluating all arguments. -/
theorem call_refused (P : Program O) (dst : Option Var) (f : FnId) (args : List O.Expr)
    (site : SiteId) (L : AList Var O.Val) (st st' : O.Store) (vs : List O.Val)
    (fn : Fn O) (k : List (Frame O)) (he : evalArgs O L st args = .ok (vs, st'))
    (hf : AList.lookup P.fns f = some fn)
    (hl : O.life (.enter (fn.params.map Prod.fst)) st' = none) :
    step P ⟨.exec (.call dst f args site), L, st, k⟩ = none := by
  simp [step, onRes, he, hf, hl]

/-- A normal scope exit cannot drop locals when instrumentation refuses. -/
theorem scope_drop_refused (P : Program O) (b : BlockId) (dm : List Var)
    (L : AList Var O.Val) (st : O.Store) (k : List (Frame O))
    (hl : O.life (.drop (dead dm L)) st = none) :
    step P ⟨.done, L, st, .scope b dm [] :: k⟩ = none := by
  simp [step, dropOut, hl]

/-- The same refusal stops a structured exit through a scope or a test frame. -/
theorem exit_drop_refused (P : Program O) (e : Exit O.Val) (b : BlockId) (dm : List Var)
    (l : LoopId) (cr body : Stmt O) (t : O.Expr) (site : SiteId)
    (L : AList Var O.Val) (st : O.Store) (k : List (Frame O))
    (hl : O.life (.drop (dead dm L)) st = none) :
    step P ⟨.exiting e, L, st, .scope b dm [] :: k⟩ = none ∧
    step P ⟨.exiting e, L, st, .test l cr t body site dm :: k⟩ = none := by
  simp [step, stepExit, dropOut, hl]

/-- After a successful loop test evaluation, refusal to drop its temporaries stops either branch. -/
theorem test_drop_refused (P : Program O) (l : LoopId) (cr body : Stmt O) (t : O.Expr)
    (site : SiteId) (dm : List Var) (L : AList Var O.Val) (st st' : O.Store)
    (v : O.Val) (k : List (Frame O)) (he : O.eval L st t = .ok (v, st'))
    (hl : O.life (.drop (dead dm L)) st' = none) :
    step P ⟨.done, L, st, .test l cr t body site dm :: k⟩ = none := by
  simp only [step, onRes, he]
  cases O.test v <;> simp [dropOut, hl]

/-- Refusing either activation end or result binding stops both explicit and Unit returns. -/
theorem return_refused (P : Program O) (dst : Option Var) (v : O.Val)
    (caller L : AList Var O.Val) (st : O.Store) (k : List (Frame O))
    (hl : (O.life .leave st).bind (bindLife O dst) = none) :
    step P ⟨.exiting (.ret v), L, st, .ret dst caller :: k⟩ = none ∧
    step P ⟨.done, L, st, .ret dst caller :: k⟩ = none := by
  cases he : O.life .leave st with
  | none => simp [step, stepExit, he]
  | some st' =>
    have hb : bindLife O dst st' = none := by simpa [he] using hl
    simp [step, stepExit, he, hb]

/-- Refusing a primitive result binding refuses its request continuation. Error answers bypass
binding and remain traps. The oracle's answer kind is unchanged. -/
theorem prim_bind_refused (P : Program O) (x : Var) (p : O.Prim) (args : List O.Expr)
    (site : SiteId) (L : AList Var O.Val) (st st' : O.Store) (vs : List O.Val)
    (k : List (Frame O)) (a : Answer O.Val O.Event O.Store) (v : O.Val)
    (he : evalArgs O L st args = .ok (vs, st')) (ha : a.result = .ok v)
    (hl : O.life (.bind x) a.store = none) :
    ∃ cont, step P ⟨.exec (.prim (some x) p args site), L, st, k⟩ =
      some (.request p vs site st' cont) ∧ cont a = none := by
  refine ⟨(fun ans => match ans.result with
    | .ok w => (bindLife O (some x) ans.store).map fun st'' =>
        ⟨.done, bindDst (some x) w L, st'', k⟩
    | .error kd => some ⟨.trapped kd site, L, ans.store, k⟩), ?_, ?_⟩
  · simp [step, onRes, he]
    rfl
  · simp [ha, bindLife, hl]

/-- A refused continuation admits no successful response transition for that answer. -/
theorem continuation_refused (cont : Answer O.Val O.Event O.Store → Option (Config O))
    (a : Answer O.Val O.Event O.Store) (h : cont a = none) :
    ¬ ∃ c', cont a = some c' := by
  simp [h]

/-! ### Destruction -/

/-- The cleanup call that destroys a value calls the type's one `Destroy` function, which takes the
value as its only, ordinary parameter and returns `Unit`. -/
theorem destroyCall_sig {P : Program O} (D : DestroyProtocol P) (T : O.Ty) (arg : O.Expr)
    (site : SiteId) (d : Deferred O) (h : D.destroyCall T arg site = some d) :
    d.args = [arg] ∧ ∃ fn x, AList.lookup P.fns d.f = some fn ∧ fn.params = [(x, T)] ∧
      fn.result = O.unitTy := by
  unfold DestroyProtocol.destroyCall at h
  cases hi : D.impl T with
  | none => rw [hi] at h; cases h
  | some f =>
    rw [hi] at h; cases h
    exact ⟨rfl, D.sig T f hi⟩

/-- A type with a `Destroy` function is not `Copy`. -/
theorem destroy_not_copy {P : Program O} (D : DestroyProtocol P) (T : O.Ty) (f : FnId)
    (h : D.impl T = some f) : O.isCopy T = false := D.notCopy T f h

/-- A sequence's element `i` is visited at position `i`: in increasing index order. -/
theorem seqDestroyOrder_elem (n i : Nat) (h : i < n) : (seqDestroyOrder n)[i]? = some (.elem i) := by
  rw [seqDestroyOrder, List.getElem?_append_left (by simpa using h)]
  simp [h]

/-- A sequence's backing is released last, after all `n` elements. -/
theorem seqDestroyOrder_storage (n : Nat) :
    (seqDestroyOrder n).length = n + 1 ∧ (seqDestroyOrder n)[n]? = some .storage := by
  simp [seqDestroyOrder]

/-- The entries of a map, in visiting order. -/
private def entryParts (n : Nat) : List Part := (List.range n).flatMap fun i => [.key i, .value i]

private theorem entryParts_succ (n : Nat) :
    entryParts (n + 1) = entryParts n ++ [.key n, .value n] := by
  simp [entryParts, List.range_succ, List.flatMap_append]

private theorem entryParts_length : ∀ n, (entryParts n).length = 2 * n
  | 0 => rfl
  | n + 1 => by rw [entryParts_succ]; simp [entryParts_length n]; omega

private theorem entryParts_get : ∀ (n i : Nat), i < n →
    (entryParts n)[2 * i]? = some (.key i) ∧ (entryParts n)[2 * i + 1]? = some (.value i)
  | 0, _, h => absurd h (Nat.not_lt_zero _)
  | n + 1, i, h => by
    rw [entryParts_succ]
    by_cases hi : i < n
    · have hl := entryParts_length n
      rw [List.getElem?_append_left (by omega), List.getElem?_append_left (by omega)]
      exact entryParts_get n i hi
    · have hin : i = n := by omega
      subst hin
      have hl := entryParts_length i
      rw [List.getElem?_append_right (by omega), List.getElem?_append_right (by omega), hl]
      simp

/-- A map's `i`-th entry (in ascending key order) is visited key first, at position `2i`, then
value, at `2i+1`. -/
theorem mapDestroyOrder_entry (n i : Nat) (h : i < n) :
    (mapDestroyOrder n)[2 * i]? = some (.key i) ∧
      (mapDestroyOrder n)[2 * i + 1]? = some (.value i) := by
  have hl := entryParts_length n
  have := entryParts_get n i h
  show (entryParts n ++ [Part.storage])[2 * i]? = _ ∧
    (entryParts n ++ [Part.storage])[2 * i + 1]? = _
  rw [List.getElem?_append_left (by omega), List.getElem?_append_left (by omega)]
  exact this

/-- A map's nodes are released last, after all `n` entries. -/
theorem mapDestroyOrder_storage (n : Nat) :
    (mapDestroyOrder n).length = 2 * n + 1 ∧ (mapDestroyOrder n)[2 * n]? = some .storage := by
  have hl := entryParts_length n
  show (entryParts n ++ [Part.storage]).length = _ ∧ (entryParts n ++ [Part.storage])[2 * n]? = _
  rw [List.getElem?_append_right (by omega), hl]
  simp [hl]

/-! ### Non-vacuity

The cleanup laws assume that each deferred call completes (`Completes`). Real calls meet it: in the
demo language of `Spec/Exec.lean`, a deferred `log(1)` completes from any locals, in any state and
on any frames, emitting `1` (its parameter is a fresh local of a new activation); a deferred
`bump()` completes silently and adds one to the counter. -/

theorem demo_log_completes (L : AList Var Demo.ops.Val) (st : Demo.ops.Store) :
    Completes Demo.prog L ⟨Demo.logF, [.lit 1], Demo.s⟩ st [1] st := by
  intro k
  refine steps_next rfl (steps_request (O := Demo.ops) (P := Demo.prog)
    (a := ⟨some (1 : Int), .ok (0 : Int), Demo.DState.life (.enter [Demo.x]) st⟩) (tr := []) rfl
    (by simp [Demo.ops, Demo.logFn]) rfl ?_)
  exact steps_next rfl (steps_next rfl (Steps.refl _))

theorem demo_bump_completes (L : AList Var Demo.ops.Val) (st : Demo.ops.Store) :
    Completes Demo.prog L ⟨Demo.bumpF, [], Demo.s⟩ st [] { st with counter := st.counter + 1 } := by
  intro k
  refine steps_next rfl (steps_request (O := Demo.ops) (P := Demo.prog)
    (a := ⟨none, .ok (0 : Int),
      { Demo.DState.life (.enter []) st with counter := st.counter + 1 }⟩) (tr := []) rfl
    (by simp [Demo.ops, Demo.DState.life]) rfl ?_)
  exact steps_next rfl (steps_next rfl (Steps.refl _))

/-- So the cleanup law applies to a real scope: the end of a block that registered `log(1)` and
then `bump()` runs `bump` (silently, adding one) and then `log`, from any state. -/
example (L : AList Var Demo.ops.Val) (st : Demo.DState) (k : List (Frame Demo.ops))
    (dm : List Var) :
    Steps Demo.prog ⟨.done, L, st, .scope ⟨1⟩ dm [⟨Demo.bumpF, [], Demo.s⟩,
      ⟨Demo.logF, [.lit 1], Demo.s⟩] :: k⟩ [1]
      ⟨.done, restrict dm L, Demo.DState.life (.drop (dead dm L)) { st with counter := st.counter + 1 }, k⟩ :=
  done_scope_runs_defers Demo.prog ⟨1⟩ dm L k
    (.cons (demo_bump_completes L st) (.cons (demo_log_completes L _) (.nil _))) rfl

end ConcreteSpec.Core.Exec
import ConcreteSpec.Spec.Scalar

/-!
# The laws of scalars and arithmetic (`Spec/Scalar.lean`, foundation contract C2)

PROPOSED: not normative until the owner freezes Core (ROADMAP A2c). See `ConcreteSpec/README.md`.

- **Representation**: a bit pattern is below `2^bits` (`toBits_lt`), every pattern denotes a value
  in range (`ofBits_inRange`), and a value's pattern denotes it again (`ofBits_toBits`).
- **Results stay in range**: wrapping, saturating and bitwise results (`wrap_inRange`,
  `saturate_inRange`), and every successful checked operation on values in range
  (`checked_inRange`).
- **One meaning, three failure policies**: a plain operation succeeds exactly when the checked one
  does, with the same result, and traps exactly with the kind of the checked error
  (`plain_ok_iff`, `plain_trap_iff`); wrapping and saturating agree with it where it succeeds
  (`wrapping_of_checked`, `saturating_of_checked`).
- **Conversions**: `Lossless` is exactly the value-domain rule (`lossless_iff`); `tryConvert`
  succeeds exactly in range and keeps the value (`tryConvert_ok_iff`).
- **Machine and exact arithmetic**: an exact term is defined whenever its operands are
  (`exact_defined`); a defined machine term has operands of its width (`machine_operands`); where a
  plain machine term is defined, it equals the exact one (`machine_plain_eq_exact`), and so does a
  whole term read in exact arithmetic (`eval_toExact`).
- **Bits**: wrapping keeps the bit pattern (`toBits_wrap`, `toBits_wrapping`), a valid left shift
  drops the bits shifted out (`toBits_shl`), and an unsigned right shift is the logical shift of
  the pattern (`toBits_shr_unsigned`); a `bool` pattern is `0` or `1` (`boolOfBits_some_iff`).
- **Negation and lossy conversion**: plain negation traps exactly when checked negation fails
  (`plainNeg_ok_iff`, `plainNeg_trap_iff`; there is no wrapping negation, ARITH-4); a lossy
  conversion lands in range and keeps a value that fits (`lossyConvert_inRange`,
  `lossyConvert_of_inRange`); saturation keeps a value in range and clamps one outside to the
  nearer end (`saturate_of_inRange`, `saturate_below`, `saturate_above`); bitwise operations act on
  the patterns (`toBits_bitwise`, `toBits_bitNot`).
- The trap kinds have distinct names, and the arithmetic errors map to distinct kinds.
-/

namespace ConcreteSpec.Core

theorem TrapKind.name_injective {a b : TrapKind} (h : a.name = b.name) : a = b := by
  cases a <;> cases b <;> first | rfl | (simp [TrapKind.name] at h)

theorem ArithmeticError.trapKind_injective {a b : ArithmeticError} (h : a.trapKind = b.trapKind) :
    a = b := by
  cases a <;> cases b <;> first | rfl | cases h

/-! ### Representation -/

theorem toBits_lt (t : IntTy) (n : Int) : toBits t n < 2 ^ t.bits := by
  cases t <;> simp only [toBits, IntTy.bits] <;> omega

theorem ofBits_inRange (t : IntTy) (m : Nat) (h : m < 2 ^ t.bits) : t.InRange (ofBits t m) := by
  cases t <;> simp only [IntTy.bits] at h <;>
    simp [ofBits, IntTy.InRange, IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] <;>
    (try split) <;> omega

theorem ofBits_toBits (t : IntTy) (n : Int) (h : t.InRange n) : ofBits t (toBits t n) = n := by
  cases t <;> simp [IntTy.InRange, IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at h <;>
    simp [ofBits, toBits, IntTy.signed, IntTy.bits] <;> (try split) <;> omega

theorem wrap_inRange (t : IntTy) (n : Int) : t.InRange (wrap t n) :=
  ofBits_inRange t _ (toBits_lt t n)

theorem wrap_of_inRange (t : IntTy) (n : Int) (h : t.InRange n) : wrap t n = n :=
  ofBits_toBits t n h

theorem IntTy.min_le_max (t : IntTy) : t.min ≤ t.max := by
  cases t <;> decide

theorem saturate_inRange (t : IntTy) (n : Int) : t.InRange (saturate t n) := by
  have := t.min_le_max
  unfold saturate IntTy.InRange
  split
  · omega
  · split <;> omega

/-- Saturation keeps a value in range. -/
theorem saturate_of_inRange (t : IntTy) (n : Int) (h : t.InRange n) : saturate t n = n := by
  obtain ⟨h1, h2⟩ := h
  unfold saturate
  split
  · omega
  · split
    · omega
    · rfl

theorem bitwise_inRange (t : IntTy) (op : BitOp) (a b : Int) : t.InRange (bitwise t op a b) := by
  have ha := toBits_lt t a
  have hb := toBits_lt t b
  cases op
  · exact ofBits_inRange t _ (Nat.lt_of_le_of_lt Nat.and_le_left ha)
  · exact ofBits_inRange t _ (Nat.or_lt_two_pow ha hb)
  · exact ofBits_inRange t _ (Nat.xor_lt_two_pow ha hb)

theorem bitNot_inRange (t : IntTy) (a : Int) : t.InRange (bitNot t a) := by
  have := toBits_lt t a
  have hp : 0 < 2 ^ t.bits := Nat.two_pow_pos _
  exact ofBits_inRange t _ (by omega)

/-! ### Checked operations stay in range -/

theorem inRangeOr_inRange {t : IntTy} {r s : Int} (h : inRangeOr t r = .ok s) : t.InRange s := by
  unfold inRangeOr at h
  split at h
  · cases h; assumption
  · cases h

/-- A right shift of a value in range is in range: it moves the value toward the sign's end. -/
theorem shr_inRange (t : IntTy) (a : Int) (d : Nat) (ha : t.InRange a) :
    t.InRange (a / (2 : Int) ^ d) := by
  have hd : (0 : Int) < 2 ^ d := Int.pow_pos (by decide)
  have hmin : t.min ≤ 0 := by cases t <;> decide
  have hmax : 0 ≤ t.max := by cases t <;> decide
  obtain ⟨h1, h2⟩ := ha
  constructor
  · by_cases ha0 : 0 ≤ a
    · exact Int.le_trans hmin (Int.ediv_nonneg ha0 (Int.le_of_lt hd))
    · exact Int.le_trans h1 (Int.le_ediv_of_mul_le hd (by
        have : 1 ≤ (2 : Int) ^ d := hd
        have hneg : a < 0 := Int.lt_of_not_ge ha0
        calc a * 2 ^ d ≤ a * 1 := Int.mul_le_mul_of_nonpos_left (Int.le_of_lt hneg) this
          _ = a := Int.mul_one a))
  · by_cases ha0 : 0 ≤ a
    · exact Int.le_trans (Int.ediv_le_self _ ha0) h2
    · exact Int.le_trans (Int.le_of_lt (Int.ediv_neg_of_neg_of_pos (Int.lt_of_not_ge ha0) hd)) hmax

/-- A remainder of a value in range is in range: it lies between `0` and the dividend. This holds
for every divisor (Lean's `tmod` by `0` is the dividend), so `checked` needs no extra case. -/
theorem tmod_inRange (t : IntTy) (a b : Int) (ha : t.InRange a) : t.InRange (a.tmod b) := by
  have hmin : t.min ≤ 0 := by cases t <;> decide
  have hmax : 0 ≤ t.max := by cases t <;> decide
  obtain ⟨h1, h2⟩ := ha
  have hab : (a.tmod b).natAbs ≤ a.natAbs := by rw [Int.natAbs_tmod]; exact Nat.mod_le _ _
  by_cases ha0 : 0 ≤ a
  · have hnn : 0 ≤ a.tmod b := Int.tmod_nonneg b ha0
    constructor <;> omega
  · have hnp : 0 ≤ (-a).tmod b := Int.tmod_nonneg b (by omega)
    rw [Int.neg_tmod] at hnp
    constructor <;> omega

/-- Every successful checked operation on operands in range gives a value in range. -/
theorem checked_inRange (t : IntTy) (op : ArithOp) (a b r : Int) (ha : t.InRange a)
    (h : checked t op a b = .ok r) : t.InRange r := by
  cases op <;> simp only [checked] at h
  · exact inRangeOr_inRange h
  · exact inRangeOr_inRange h
  · exact inRangeOr_inRange h
  · split at h
    · cases h
    · exact inRangeOr_inRange h
  · split at h
    · cases h
    · split at h
      · cases h
      · cases h; exact tmod_inRange t a b ha
  · split at h
    · cases h; exact wrap_inRange t _
    · cases h
  · split at h
    · cases h; exact shr_inRange t a _ ha
    · cases h

/-! ### Plain, wrapping and saturating -/

theorem plain_ok_iff (t : IntTy) (op : ArithOp) (a b r : Int) :
    plain t op a b = .ok r ↔ checked t op a b = .ok r := by
  unfold plain
  cases checked t op a b <;> simp

theorem plain_trap_iff (t : IntTy) (op : ArithOp) (a b : Int) (k : TrapKind) :
    plain t op a b = .trap k ↔ ∃ e, checked t op a b = .error e ∧ e.trapKind = k := by
  unfold plain
  cases checked t op a b <;> simp

/-- A plain operation is never stuck: it has a result or a trap. -/
theorem plain_not_stuck (t : IntTy) (op : ArithOp) (a b : Int) : plain t op a b ≠ .stuck := by
  unfold plain
  cases checked t op a b <;> simp

/-- The arithmetic operation of a wrapping-capable operation. -/
def WrapOp.arith : WrapOp → ArithOp
  | .add => .add
  | .sub => .sub
  | .mul => .mul

theorem checked_wrapOp (t : IntTy) (op : WrapOp) (a b : Int) :
    checked t op.arith a b = inRangeOr t (op.exact a b) := by
  cases op <;> rfl

theorem wrapping_of_checked (t : IntTy) (op : WrapOp) (a b r : Int)
    (h : checked t op.arith a b = .ok r) : wrapping t op a b = r := by
  rw [checked_wrapOp] at h
  unfold inRangeOr at h
  split at h
  · cases h; exact wrap_of_inRange t _ (by assumption)
  · cases h

theorem saturating_of_checked (t : IntTy) (op : WrapOp) (a b r : Int)
    (h : checked t op.arith a b = .ok r) : saturating t op a b = r := by
  rw [checked_wrapOp] at h
  unfold inRangeOr at h
  split at h
  · cases h
    exact saturate_of_inRange t _ (by assumption)
  · cases h

/-! ### Conversions -/

theorem lossless_iff (s t : IntTy) : Lossless s t ↔ ∀ n, s.InRange n → t.InRange n := by
  constructor
  · intro ⟨h1, h2⟩ n ⟨hn1, hn2⟩
    exact ⟨Int.le_trans h1 hn1, Int.le_trans hn2 h2⟩
  · intro h
    have hm := s.min_le_max
    exact ⟨(h s.min ⟨Int.le_refl _, hm⟩).1, (h s.max ⟨hm, Int.le_refl _⟩).2⟩

/-- `bool` converts losslessly to every integer type. -/
theorem boolToInt_inRange (t : IntTy) (b : Bool) : t.InRange (boolToInt b) := by
  cases t <;> cases b <;> decide

theorem tryConvert_ok_iff (t : IntTy) (n r : Int) :
    tryConvert t n = .ok r ↔ t.InRange n ∧ r = n := by
  unfold tryConvert
  split
  · simp_all [eq_comm]
  · simp_all

/-! ### Machine and exact arithmetic in contracts -/

theorem exact_defined (ρ : Var → Option Int) (op : WrapOp) (a b : CTerm) (x y : Int)
    (ha : a.eval ρ = some x) (hb : b.eval ρ = some y) :
    (CTerm.exact op a b).eval ρ = some (op.exact x y) := by
  simp [CTerm.eval, ha, hb]

/-- Where a plain machine term is defined, it means the exact operation: the two differ only in
where the machine one is undefined. -/
theorem machine_plain_eq_exact (ρ : Var → Option Int) (t : IntTy) (op : WrapOp) (a b : CTerm)
    (r : Int) (h : (CTerm.machine t (.plain op.arith) a b).eval ρ = some r) :
    (CTerm.exact op a b).eval ρ = some r := by
  simp only [CTerm.eval] at h ⊢
  cases ha : a.eval ρ with
  | none => rw [ha] at h; cases h
  | some x =>
    cases hb : b.eval ρ with
    | none => rw [ha, hb] at h; simp at h
    | some y =>
      rw [ha, hb] at h
      simp only [Option.bind_some] at h
      split at h
      · cases h
      · rw [checked_wrapOp] at h
        unfold inRangeOr at h
        by_cases hr : t.InRange (op.exact x y)
        · simp [hr] at h; subst h; rfl
        · simp [hr] at h

/-- A defined machine term has operands that are values of its width (a shift count excepted). -/
theorem machine_operands (ρ : Var → Option Int) (t : IntTy) (op : MachineOp) (a b : CTerm)
    (r : Int) (h : (CTerm.machine t op a b).eval ρ = some r) :
    ∃ x y, a.eval ρ = some x ∧ b.eval ρ = some y ∧ t.InRange x ∧
      (op.countOperand = true ∨ t.InRange y) := by
  simp only [CTerm.eval] at h
  cases ha : a.eval ρ with
  | none => rw [ha] at h; cases h
  | some x =>
    cases hb : b.eval ρ with
    | none => rw [ha, hb] at h; simp at h
    | some y =>
      rw [ha, hb] at h
      simp only [Option.bind_some] at h
      split at h
      · cases h
      · rename_i hok
        simp only [MachineOp.operandsOk, Bool.not_eq_false, Bool.and_eq_true, decide_eq_true_eq,
          Bool.or_eq_true] at hok
        exact ⟨x, y, rfl, rfl, hok.1, hok.2⟩

/-- A defined machine term's value is a value of its width. -/
theorem machine_inRange (ρ : Var → Option Int) (t : IntTy) (op : MachineOp) (a b : CTerm)
    (r : Int) (h : (CTerm.machine t op a b).eval ρ = some r) : t.InRange r := by
  obtain ⟨x, y, ha, hb, hx, _⟩ := machine_operands ρ t op a b r h
  simp only [CTerm.eval, ha, hb, Option.bind_some] at h
  split at h
  · cases h
  · cases op with
    | plain o =>
      simp only at h
      split at h
      · cases h; rename_i hc; exact checked_inRange t o x y r hx hc
      · cases h
    | wrapping o => cases h; exact wrap_inRange t _
    | saturating o => cases h; exact saturate_inRange t _

theorem exactOf?_some {op : MachineOp} {w : WrapOp} (h : op.exactOf? = some w) :
    op = .plain w.arith := by
  cases op with
  | plain o => cases o <;> cases h <;> rfl
  | wrapping _ => cases h
  | saturating _ => cases h

/-- **Reading in exact arithmetic.** Where a contract term is defined, its exact reading is
defined and has the same value. -/
theorem eval_toExact (ρ : Var → Option Int) : ∀ (e : CTerm) (r : Int),
    e.eval ρ = some r → e.toExact.eval ρ = some r
  | .lit _, _, h => h
  | .var _, _, h => h
  | .machine t op a b, r, h => by
    obtain ⟨x, y, ha, hb, _, _⟩ := machine_operands ρ t op a b r h
    have ha' := eval_toExact ρ a x ha
    have hb' := eval_toExact ρ b y hb
    simp only [CTerm.toExact]
    split
    · rename_i w hw
      rw [exactOf?_some hw] at h
      have := machine_plain_eq_exact ρ t w a b r h
      simp only [CTerm.eval, ha, hb, Option.bind_some, Option.map_some, Option.some.injEq] at this
      simp [CTerm.eval, ha', hb', this]
    · simp only [CTerm.eval, ha, hb, Option.bind_some] at h
      simpa only [CTerm.eval, ha', hb', Option.bind_some] using h
  | .exact op a b, r, h => by
    simp only [CTerm.eval] at h
    cases ha : a.eval ρ with
    | none => rw [ha] at h; cases h
    | some x =>
      cases hb : b.eval ρ with
      | none => rw [ha, hb] at h; simp at h
      | some y =>
        rw [ha, hb] at h
        simp only [CTerm.toExact, CTerm.eval, eval_toExact ρ a x ha, eval_toExact ρ b y hb]
        simpa using h

/-! ### Negation, `bool` patterns, lossy conversion -/

theorem plainNeg_ok_iff (t : IntTy) (a r : Int) : plainNeg t a = .ok r ↔ checkedNeg t a = .ok r := by
  unfold plainNeg
  cases checkedNeg t a <;> simp

theorem plainNeg_trap_iff (t : IntTy) (a : Int) (k : TrapKind) :
    plainNeg t a = .trap k ↔ ∃ e, checkedNeg t a = .error e ∧ e.trapKind = k := by
  unfold plainNeg
  cases checkedNeg t a <;> simp

theorem checkedNeg_inRange {t : IntTy} {a r : Int} (h : checkedNeg t a = .ok r) : t.InRange r :=
  inRangeOr_inRange h

theorem boolOfBits_boolToBits (b : Bool) : boolOfBits (boolToBits b) = some b := by
  cases b <;> rfl

theorem boolOfBits_some_iff (m : Nat) (b : Bool) : boolOfBits m = some b ↔ m = boolToBits b := by
  match m with
  | 0 => cases b <;> simp [boolOfBits, boolToBits]
  | 1 => cases b <;> simp [boolOfBits, boolToBits]
  | m + 2 => cases b <;> simp [boolOfBits, boolToBits]

theorem lossyConvert_inRange (t : IntTy) (n : Int) : t.InRange (lossyConvert t n) := wrap_inRange t n

/-- A lossy conversion of a value of the target type keeps it. -/
theorem lossyConvert_of_inRange (t : IntTy) (n : Int) (h : t.InRange n) : lossyConvert t n = n :=
  wrap_of_inRange t n h

/-! ### Bit-level correspondence -/

theorem toBits_ofBits (t : IntTy) (m : Nat) (h : m < 2 ^ t.bits) : toBits t (ofBits t m) = m := by
  cases t <;> simp only [IntTy.bits] at h <;>
    simp [toBits, ofBits, IntTy.signed, IntTy.bits] <;> (try split) <;> omega

/-- Wrapping keeps the bit pattern: `wrap` only reads the low `bits` bits. -/
theorem toBits_wrap (t : IntTy) (n : Int) : toBits t (wrap t n) = toBits t n :=
  toBits_ofBits t _ (toBits_lt t n)

/-- A wrapping operation's pattern is the exact result's pattern, modulo `2^bits`. -/
theorem toBits_wrapping (t : IntTy) (op : WrapOp) (a b : Int) :
    toBits t (wrapping t op a b) = toBits t (op.exact a b) := toBits_wrap t _

/-- A valid left shift's pattern is the pattern of `a · 2^c`: the bits shifted out are gone. -/
theorem toBits_shl (t : IntTy) (a c r : Int) (h : checked t .shl a c = .ok r) :
    toBits t r = toBits t (a * (2 : Int) ^ c.toNat) := by
  simp only [checked] at h
  split at h
  · cases h; exact toBits_wrap t _
  · cases h

/-- An unsigned right shift is the logical shift of the pattern. -/
theorem toBits_shr_unsigned (t : IntTy) (hs : t.signed = false) (a c r : Int) (ha : t.InRange a)
    (h : checked t .shr a c = .ok r) : toBits t r = toBits t a >>> c.toNat := by
  simp only [checked] at h
  split at h
  · cases h
    have ha0 : 0 ≤ a := by
      have := ha.1; simp [IntTy.min, hs] at this; exact this
    have hr := shr_inRange t a c.toNat ha
    have hr0 : 0 ≤ a / (2 : Int) ^ c.toNat := Int.ediv_nonneg ha0 (Int.le_of_lt (Int.pow_pos (by decide)))
    have hmax : ∀ n : Int, 0 ≤ n → t.InRange n → toBits t n = n.toNat := by
      intro n hn hin
      have := toBits_lt t n
      have hofb := ofBits_toBits t n hin
      simp only [ofBits, hs, Bool.false_eq_true, false_and, ↓reduceIte] at hofb
      omega
    rw [hmax _ hr0 hr, hmax a ha0 ha, Nat.shiftRight_eq_div_pow]
    obtain ⟨m, rfl⟩ := Int.eq_ofNat_of_zero_le ha0
    have hq : ((m : Int) / (2 : Int) ^ c.toNat) = ((m / 2 ^ c.toNat : Nat) : Int) := by
      rw [Int.natCast_ediv, Int.natCast_pow]; rfl
    rw [hq, Int.toNat_natCast, Int.toNat_natCast]
  · cases h

/-- Bitwise operations act on the patterns, bit by bit. -/
theorem toBits_bitwise (t : IntTy) (op : BitOp) (a b : Int) :
    toBits t (bitwise t op a b) = match op with
      | .and => toBits t a &&& toBits t b
      | .or => toBits t a ||| toBits t b
      | .xor => toBits t a ^^^ toBits t b := by
  have ha := toBits_lt t a
  have hb := toBits_lt t b
  cases op
  · exact toBits_ofBits t _ (Nat.lt_of_le_of_lt Nat.and_le_left ha)
  · exact toBits_ofBits t _ (Nat.or_lt_two_pow ha hb)
  · exact toBits_ofBits t _ (Nat.xor_lt_two_pow ha hb)

/-- Bitwise not flips every bit of the pattern. -/
theorem toBits_bitNot (t : IntTy) (a : Int) :
    toBits t (bitNot t a) = 2 ^ t.bits - 1 - toBits t a := by
  have := toBits_lt t a
  have hp : 0 < 2 ^ t.bits := Nat.two_pow_pos _
  exact toBits_ofBits t _ (by omega)

/-- Saturation clamps: below the range it gives the minimum, above it the maximum. -/
theorem saturate_below (t : IntTy) (n : Int) (h : n < t.min) : saturate t n = t.min := by
  simp [saturate, h]

theorem saturate_above (t : IntTy) (n : Int) (h : t.max < n) : saturate t n = t.max := by
  have := t.min_le_max
  have : ¬ n < t.min := by omega
  simp [saturate, h, this]

end ConcreteSpec.Core
import ConcreteSpec.Spec.Const
import ConcreteSpec.Proofs.Scalar

/-!
# The laws of constants (`Spec/Const.lean`, foundation contract C2)

PROPOSED: not normative until the owner freezes Core (ROADMAP A2c). See `ConcreteSpec/README.md`.

- **Totality** (`eval_total`): a well-typed initializer has a value, of its type and valid, when
  the earlier constants' values agree with their types. No operation of the subset can fail.
- **Validity** (`eval_valid`): every value an initializer computes is valid (an integer in range).
- **Copy only** (`admitted_copy`): every constant of admitted declarations has a `Copy` type, and
  so does every value it can hold (`ofC_copy`).
- **Static admission** (`typed_admitted`, `admitted_iff_typed`): declarations are admitted exactly
  when they type (`typeConsts`), so the compiler decides admission without evaluating, and the
  evaluation of admitted declarations at compile time cannot fail.
- **Declaration soundness** (`evalConsts_sound`): after admitted declarations, every declared
  constant has a valid value whose type is its declared type.
-/

namespace ConcreteSpec.Core

/-- The earlier constants' values agree with their types, and are valid. -/
def Agree (env : AList ConstId CVal) (Γ : AList ConstId CTy) : Prop :=
  ∀ c T, AList.lookup Γ c = some T → ∃ v, AList.lookup env c = some v ∧ v.ty = T ∧ v.Valid

theorem CVal.int_of_ty {v : CVal} {t : IntTy} (h : v.ty = .int t) : ∃ n, v = .int t n := by
  cases v with
  | int t' n => cases h; exact ⟨n, rfl⟩
  | bool _ => cases h
  | unit => cases h

theorem CVal.bool_of_ty {v : CVal} (h : v.ty = .bool) : ∃ b, v = .bool b := by
  cases v with
  | int _ _ => cases h
  | bool b => exact ⟨b, rfl⟩
  | unit => cases h

theorem sameIntTy_some {x y : Option CTy} {t : IntTy} (h : sameIntTy x y = some t) :
    x = some (.int t) ∧ y = some (.int t) := by
  match x, y, h with
  | some (.int a), some (.int b), h =>
    simp only [sameIntTy] at h
    split at h
    · cases h; rename_i hab; subst hab; exact ⟨rfl, rfl⟩
    · cases h

theorem bothBool_true {x y : Option CTy} (h : bothBool x y = true) :
    x = some .bool ∧ y = some .bool := by
  match x, y, h with
  | some .bool, some .bool, _ => exact ⟨rfl, rfl⟩

/-- **Totality.** A well-typed initializer has a value of its type, and the value is valid. -/
theorem eval_total (env : AList ConstId CVal) (Γ : AList ConstId CTy) (hag : Agree env Γ) :
    ∀ (e : CExpr) (T : CTy), e.ty? Γ = some T → ∃ v, e.eval env = some v ∧ v.ty = T ∧ v.Valid
  | .int t n, T, h => by
    simp only [CExpr.ty?] at h
    split at h
    · cases h
      exact ⟨.int t n, by simp [CExpr.eval, *], rfl, by assumption⟩
    · cases h
  | .bool b, T, h => by cases h; exact ⟨.bool b, rfl, rfl, trivial⟩
  | .unit, T, h => by cases h; exact ⟨.unit, rfl, rfl, trivial⟩
  | .ref c, T, h => hag c T h
  | .wrapping op a b, T, h => by
    simp only [CExpr.ty?, Option.map_eq_some_iff] at h
    obtain ⟨t, ht, rfl⟩ := h
    obtain ⟨ha, hb⟩ := sameIntTy_some ht
    obtain ⟨va, hea, hta, _⟩ := eval_total env Γ hag a _ ha
    obtain ⟨vb, heb, htb, _⟩ := eval_total env Γ hag b _ hb
    obtain ⟨x, rfl⟩ := CVal.int_of_ty hta
    obtain ⟨y, rfl⟩ := CVal.int_of_ty htb
    exact ⟨.int t (Core.wrapping t op x y), by simp [CExpr.eval, hea, heb, sameInt], rfl,
      wrap_inRange t _⟩
  | .saturating op a b, T, h => by
    simp only [CExpr.ty?, Option.map_eq_some_iff] at h
    obtain ⟨t, ht, rfl⟩ := h
    obtain ⟨ha, hb⟩ := sameIntTy_some ht
    obtain ⟨va, hea, hta, _⟩ := eval_total env Γ hag a _ ha
    obtain ⟨vb, heb, htb, _⟩ := eval_total env Γ hag b _ hb
    obtain ⟨x, rfl⟩ := CVal.int_of_ty hta
    obtain ⟨y, rfl⟩ := CVal.int_of_ty htb
    exact ⟨.int t (Core.saturating t op x y), by simp [CExpr.eval, hea, heb, sameInt], rfl,
      saturate_inRange t _⟩
  | .bit op a b, T, h => by
    simp only [CExpr.ty?, Option.map_eq_some_iff] at h
    obtain ⟨t, ht, rfl⟩ := h
    obtain ⟨ha, hb⟩ := sameIntTy_some ht
    obtain ⟨va, hea, hta, _⟩ := eval_total env Γ hag a _ ha
    obtain ⟨vb, heb, htb, _⟩ := eval_total env Γ hag b _ hb
    obtain ⟨x, rfl⟩ := CVal.int_of_ty hta
    obtain ⟨y, rfl⟩ := CVal.int_of_ty htb
    exact ⟨.int t (Core.bitwise t op x y), by simp [CExpr.eval, hea, heb, sameInt], rfl,
      bitwise_inRange t op x y⟩
  | .bitNot a, T, h => by
    simp only [CExpr.ty?] at h
    split at h
    · rename_i t ha
      cases h
      obtain ⟨va, hea, hta, _⟩ := eval_total env Γ hag a _ ha
      obtain ⟨x, rfl⟩ := CVal.int_of_ty hta
      exact ⟨.int t (Core.bitNot t x), by simp [CExpr.eval, hea], rfl, bitNot_inRange t x⟩
    · cases h
  | .cmp op a b, T, h => by
    simp only [CExpr.ty?, Option.map_eq_some_iff] at h
    obtain ⟨t, ht, rfl⟩ := h
    obtain ⟨ha, hb⟩ := sameIntTy_some ht
    obtain ⟨va, hea, hta, _⟩ := eval_total env Γ hag a _ ha
    obtain ⟨vb, heb, htb, _⟩ := eval_total env Γ hag b _ hb
    obtain ⟨x, rfl⟩ := CVal.int_of_ty hta
    obtain ⟨y, rfl⟩ := CVal.int_of_ty htb
    exact ⟨.bool (op.eval x y), by simp [CExpr.eval, hea, heb, sameInt], rfl, trivial⟩
  | .not a, T, h => by
    simp only [CExpr.ty?] at h
    split at h
    · rename_i ha
      cases h
      obtain ⟨va, hea, hta, _⟩ := eval_total env Γ hag a _ ha
      obtain ⟨x, rfl⟩ := CVal.bool_of_ty hta
      exact ⟨.bool (!x), by simp [CExpr.eval, hea], rfl, trivial⟩
    · cases h
  | .and a b, T, h => by
    simp only [CExpr.ty?] at h
    split at h
    · rename_i hbb
      cases h
      obtain ⟨ha, hb⟩ := bothBool_true hbb
      obtain ⟨va, hea, hta, _⟩ := eval_total env Γ hag a _ ha
      obtain ⟨vb, heb, htb, _⟩ := eval_total env Γ hag b _ hb
      obtain ⟨x, rfl⟩ := CVal.bool_of_ty hta
      obtain ⟨y, rfl⟩ := CVal.bool_of_ty htb
      exact ⟨.bool (x && y), by simp [CExpr.eval, hea, heb, twoBools], rfl, trivial⟩
    · cases h
  | .or a b, T, h => by
    simp only [CExpr.ty?] at h
    split at h
    · rename_i hbb
      cases h
      obtain ⟨ha, hb⟩ := bothBool_true hbb
      obtain ⟨va, hea, hta, _⟩ := eval_total env Γ hag a _ ha
      obtain ⟨vb, heb, htb, _⟩ := eval_total env Γ hag b _ hb
      obtain ⟨x, rfl⟩ := CVal.bool_of_ty hta
      obtain ⟨y, rfl⟩ := CVal.bool_of_ty htb
      exact ⟨.bool (x || y), by simp [CExpr.eval, hea, heb, twoBools], rfl, trivial⟩
    · cases h
  | .convert t a, T, h => by
    simp only [CExpr.ty?] at h
    split at h
    · rename_i s ha
      split at h
      · rename_i hl
        cases h
        obtain ⟨va, hea, hta, hva⟩ := eval_total env Γ hag a _ ha
        obtain ⟨x, rfl⟩ := CVal.int_of_ty hta
        exact ⟨.int t x, by simp [CExpr.eval, hea, hl], rfl, (lossless_iff s t).1 hl x hva⟩
      · cases h
    · rename_i ha
      cases h
      obtain ⟨va, hea, hta, _⟩ := eval_total env Γ hag a _ ha
      obtain ⟨x, rfl⟩ := CVal.bool_of_ty hta
      exact ⟨.int t (boolToInt x), by simp [CExpr.eval, hea], rfl, boolToInt_inRange t x⟩
    · cases h

/-- **Validity.** Every value an initializer computes from valid constants is valid. -/
theorem eval_valid (env : AList ConstId CVal)
    (henv : ∀ c v, AList.lookup env c = some v → v.Valid) :
    ∀ (e : CExpr) (v : CVal), e.eval env = some v → v.Valid := by
  intro e
  induction e with
  | int t n =>
    intro v h; simp only [CExpr.eval] at h; split at h
    · cases h; assumption
    · cases h
  | bool b => intro v h; cases h; trivial
  | unit => intro v h; cases h; trivial
  | ref c => exact henv c
  | wrapping op a b => intro v h; simp only [CExpr.eval, Option.map_eq_some_iff] at h
                       obtain ⟨⟨t, x, y⟩, _, rfl⟩ := h; exact wrap_inRange t _
  | saturating op a b => intro v h; simp only [CExpr.eval, Option.map_eq_some_iff] at h
                         obtain ⟨⟨t, x, y⟩, _, rfl⟩ := h; exact saturate_inRange t _
  | bit op a b => intro v h; simp only [CExpr.eval, Option.map_eq_some_iff] at h
                  obtain ⟨⟨t, x, y⟩, _, rfl⟩ := h; exact bitwise_inRange t op x y
  | bitNot a => intro v h; simp only [CExpr.eval] at h; split at h
                · cases h; exact bitNot_inRange _ _
                · cases h
  | cmp op a b => intro v h; simp only [CExpr.eval, Option.map_eq_some_iff] at h
                  obtain ⟨_, _, rfl⟩ := h; trivial
  | not a => intro v h; simp only [CExpr.eval] at h; split at h
             · cases h; trivial
             · cases h
  | and a b => intro v h; simp only [CExpr.eval, Option.map_eq_some_iff] at h
               obtain ⟨_, _, rfl⟩ := h; trivial
  | or a b => intro v h; simp only [CExpr.eval, Option.map_eq_some_iff] at h
              obtain ⟨_, _, rfl⟩ := h; trivial
  | convert t a ih =>
    intro v h; simp only [CExpr.eval] at h; split at h
    · rename_i s x hx
      split at h
      · rename_i hl; cases h; exact (lossless_iff s t).1 hl x (ih _ hx)
      · cases h
    · cases h; exact boolToInt_inRange _ _
    · cases h

/-- **Copy only.** Every constant of admitted declarations has a `Copy` declared type. -/
theorem admitted_copy (U : ConstTypes) : ∀ (ds : List (ConstDecl U)) (env : AList ConstId CVal),
    (evalConsts U ds env).isSome = true → ∀ d ∈ ds, U.isCopy d.ty = true
  | [], _, _, d, hd => nomatch hd
  | d :: ds, env, h, d', hd' => by
    simp only [evalConsts] at h
    split at h
    · split at h
      · rename_i v _ hc
        cases hd' with
        | head => exact hc.1
        | tail _ hm => exact admitted_copy U ds _ h d' hm
      · simp at h
    · simp at h

/-- A value of the subset always has a `Copy` type. -/
theorem ofC_copy (U : ConstTypes) (v : CVal) : U.isCopy (U.ofC v.ty) = true := U.ofC_copy _

/-- The constants' values and types correspond: they agree, and a name with no type has no value. -/
def Matches (env : AList ConstId CVal) (Γ : AList ConstId CTy) : Prop :=
  Agree env Γ ∧ ∀ c, AList.lookup Γ c = none → AList.lookup env c = none

theorem Matches.cons {env : AList ConstId CVal} {Γ : AList ConstId CTy} (h : Matches env Γ)
    (c : ConstId) (v : CVal) (hv : v.Valid) : Matches ((c, v) :: env) ((c, v.ty) :: Γ) := by
  refine ⟨fun c' T hT => ?_, fun c' hc' => ?_⟩
  · simp only [AList.lookup] at hT ⊢
    by_cases hc : c = c'
    · simp only [hc, ↓reduceIte, Option.some.injEq] at hT ⊢
      exact ⟨v, rfl, hT, hv⟩
    · simp only [hc, ↓reduceIte] at hT ⊢
      exact h.1 c' T hT
  · simp only [AList.lookup] at hc' ⊢
    by_cases hc : c = c'
    · simp [hc] at hc'
    · simp only [hc, ↓reduceIte] at hc' ⊢
      exact h.2 c' hc'

/-- **Static admission.** Declarations that type, from constants whose values match their types,
evaluate. -/
theorem typed_evaluates (U : ConstTypes) : ∀ (ds : List (ConstDecl U)) (env : AList ConstId CVal)
    (Γ Γ' : AList ConstId CTy), Matches env Γ → typeConsts U ds Γ = some Γ' →
    (evalConsts U ds env).isSome = true
  | [], _, _, _, _, _ => rfl
  | d :: ds, env, Γ, Γ', hm, h => by
    simp only [typeConsts] at h
    split at h
    · rename_i T hT
      split at h
      · rename_i hc
        obtain ⟨hcopy, hty, hfresh⟩ := hc
        obtain ⟨v, hv, hvt, hvv⟩ := eval_total env Γ hm.1 d.init T hT
        have hm' := hm.cons d.id v hvv
        rw [hvt] at hm'
        simp only [evalConsts, hv, hvt, hcopy, hty, hm.2 _ hfresh, and_self, ↓reduceIte]
        exact typed_evaluates U ds _ _ Γ' hm' h
      · cases h
    · cases h

/-- Declarations that type are admitted. -/
theorem typed_admitted (U : ConstTypes) (ds : List (ConstDecl U)) (Γ : AList ConstId CTy)
    (h : typeConsts U ds [] = some Γ) : ConstsAdmitted U ds :=
  typed_evaluates U ds [] [] Γ ⟨fun _ _ h => (by cases h), fun _ _ => rfl⟩ h

/-- Evaluation only adds constants: what was known stays, with its value. -/
theorem evalConsts_mono (U : ConstTypes) : ∀ (ds : List (ConstDecl U)) (env env' : AList ConstId CVal),
    evalConsts U ds env = some env' → ∀ c v, AList.lookup env c = some v → AList.lookup env' c = some v
  | [], _, _, h, c, v, hc => by cases h; exact hc
  | d :: ds, env, env', h, c, v, hc => by
    simp only [evalConsts] at h
    split at h
    · split at h
      · rename_i hcond
        refine evalConsts_mono U ds _ env' h c v ?_
        have hne : d.id ≠ c := by
          intro he; rw [he, hc] at hcond; exact absurd hcond.2.2 (by simp)
        simp [AList.lookup, hne, hc]
      · cases h
    · cases h

/-- **Declaration soundness.** After admitted declarations, from valid constants, every declared
constant has a valid value of its declared type, and every value is valid. -/
theorem evalConsts_sound (U : ConstTypes) : ∀ (ds : List (ConstDecl U)) (env env' : AList ConstId CVal),
    (∀ c v, AList.lookup env c = some v → v.Valid) → evalConsts U ds env = some env' →
    (∀ d ∈ ds, ∃ v, AList.lookup env' d.id = some v ∧ U.ofC v.ty = d.ty ∧ v.Valid) ∧
      (∀ c v, AList.lookup env' c = some v → v.Valid)
  | [], _, _, hv, h => by cases h; exact ⟨fun _ hd => (nomatch hd), hv⟩
  | d :: ds, env, env', hv, h => by
    simp only [evalConsts] at h
    split at h
    · rename_i v hev
      split at h
      · rename_i hcond
        have hvv : v.Valid := eval_valid env hv d.init v hev
        have hv' : ∀ c w, AList.lookup ((d.id, v) :: env) c = some w → w.Valid := by
          intro c w hw
          simp only [AList.lookup] at hw
          split at hw
          · cases hw; exact hvv
          · exact hv c w hw
        obtain ⟨hrest, hall⟩ := evalConsts_sound U ds _ env' hv' h
        refine ⟨fun d' hd' => ?_, hall⟩
        cases hd' with
        | head =>
          refine ⟨v, evalConsts_mono U ds _ env' h d.id v (by simp [AList.lookup]), hcond.2.1, hvv⟩
        | tail _ hm => exact hrest d' hm
      · cases h
    · cases h

/-! ### Static admission is exact -/

theorem sameInt_some {x y : Option CVal} {t : IntTy} {a b : Int}
    (h : sameInt x y = some (t, a, b)) : x = some (.int t a) ∧ y = some (.int t b) := by
  match x, y, h with
  | some (.int t₁ a₁), some (.int t₂ b₂), h =>
    simp only [sameInt] at h
    split at h
    · rename_i he; subst he; cases h; exact ⟨rfl, rfl⟩
    · cases h

theorem twoBools_some {x y : Option CVal} {a b : Bool} (h : twoBools x y = some (a, b)) :
    x = some (.bool a) ∧ y = some (.bool b) := by
  match x, y, h with
  | some (.bool _), some (.bool _), h => cases h; exact ⟨rfl, rfl⟩

/-- The value of an initializer has the type `ty?` gives it, when each known constant's value has
its recorded type. -/
theorem eval_ty (env : AList ConstId CVal) (Γ : AList ConstId CTy)
    (hm : ∀ c v, AList.lookup env c = some v → AList.lookup Γ c = some v.ty) :
    ∀ (e : CExpr) (v : CVal), e.eval env = some v → e.ty? Γ = some v.ty := by
  intro e
  induction e with
  | int t n =>
    intro v h; simp only [CExpr.eval] at h; split at h
    · cases h; simp [CExpr.ty?, *, CVal.ty]
    · cases h
  | bool b => intro v h; cases h; rfl
  | unit => intro v h; cases h; rfl
  | ref c => exact hm c
  | wrapping op a b iha ihb | saturating op a b iha ihb | bit op a b iha ihb =>
    intro v h
    simp only [CExpr.eval, Option.map_eq_some_iff] at h
    obtain ⟨⟨t, x, y⟩, hs, rfl⟩ := h
    obtain ⟨ha, hb⟩ := sameInt_some hs
    simp [CExpr.ty?, iha _ ha, ihb _ hb, sameIntTy, CVal.ty]
  | cmp op a b iha ihb =>
    intro v h
    simp only [CExpr.eval, Option.map_eq_some_iff] at h
    obtain ⟨⟨t, x, y⟩, hs, rfl⟩ := h
    obtain ⟨ha, hb⟩ := sameInt_some hs
    simp [CExpr.ty?, iha _ ha, ihb _ hb, sameIntTy, CVal.ty]
  | bitNot a ih =>
    intro v h; simp only [CExpr.eval] at h; split at h
    · rename_i t x hx; cases h; simp [CExpr.ty?, ih _ hx, CVal.ty]
    · cases h
  | not a ih =>
    intro v h; simp only [CExpr.eval] at h; split at h
    · rename_i x hx; cases h; simp [CExpr.ty?, ih _ hx, CVal.ty]
    · cases h
  | and a b iha ihb | or a b iha ihb =>
    intro v h
    simp only [CExpr.eval, Option.map_eq_some_iff] at h
    obtain ⟨⟨x, y⟩, hs, rfl⟩ := h
    obtain ⟨ha, hb⟩ := twoBools_some hs
    simp [CExpr.ty?, iha _ ha, ihb _ hb, bothBool, CVal.ty]
  | convert t a ih =>
    intro v h; simp only [CExpr.eval] at h; split at h
    · rename_i s x hx
      split at h
      · rename_i hl; cases h; simp [CExpr.ty?, ih _ hx, CVal.ty, hl]
      · cases h
    · rename_i b hx; cases h; simp [CExpr.ty?, ih _ hx, CVal.ty]
    · cases h

theorem Matches.lookup {env : AList ConstId CVal} {Γ : AList ConstId CTy} (h : Matches env Γ) :
    ∀ c v, AList.lookup env c = some v → AList.lookup Γ c = some v.ty := by
  intro c v hv
  cases hc : AList.lookup Γ c with
  | none => rw [h.2 c hc] at hv; cases hv
  | some T =>
    obtain ⟨v', hv', hty, _⟩ := h.1 c T hc
    rw [hv] at hv'; cases hv'; rw [hty]

/-- Values that match their types are valid. -/
theorem Matches.valid {env : AList ConstId CVal} {Γ : AList ConstId CTy} (h : Matches env Γ) :
    ∀ c v, AList.lookup env c = some v → v.Valid := by
  intro c v hv
  obtain ⟨v', hv', _, hval⟩ := h.1 c _ (h.lookup c v hv)
  rw [hv] at hv'; cases hv'; exact hval

/-- Declarations that evaluate also type. -/
theorem evaluates_typed (U : ConstTypes) : ∀ (ds : List (ConstDecl U)) (env env' : AList ConstId CVal)
    (Γ : AList ConstId CTy), Matches env Γ → (∀ c v, AList.lookup env c = some v → v.Valid) →
    evalConsts U ds env = some env' → (typeConsts U ds Γ).isSome = true
  | [], _, _, _, _, _, _ => rfl
  | d :: ds, env, env', Γ, hm, hv, h => by
    simp only [evalConsts] at h
    split at h
    · rename_i v hev
      split at h
      · rename_i hc
        obtain ⟨hcopy, hty, hfresh⟩ := hc
        have hT := eval_ty env Γ hm.lookup d.init v hev
        have hvv := eval_valid env hv d.init v hev
        have hΓ : AList.lookup Γ d.id = none := by
          cases hg : AList.lookup Γ d.id with
          | none => rfl
          | some T =>
            obtain ⟨w, hw, _, _⟩ := hm.1 d.id T hg
            rw [hfresh] at hw; cases hw
        have hv' : ∀ c w, AList.lookup ((d.id, v) :: env) c = some w → w.Valid := by
          intro c w hw
          simp only [AList.lookup] at hw
          split at hw
          · cases hw; exact hvv
          · exact hv c w hw
        simp only [typeConsts, hT, hcopy, hty, hΓ, and_self, ↓reduceIte]
        exact evaluates_typed U ds _ env' _ (hm.cons d.id v hvv) hv' h
      · cases h
    · cases h

/-- **Static admission is exact**: declarations are admitted exactly when they type. -/
theorem admitted_iff_typed (U : ConstTypes) (ds : List (ConstDecl U)) :
    ConstsAdmitted U ds ↔ (typeConsts U ds []).isSome = true := by
  have hm : Matches [] [] := ⟨fun _ _ h => (by cases h), fun _ _ => rfl⟩
  constructor
  · intro h
    obtain ⟨env', he⟩ := Option.isSome_iff_exists.1 h
    exact evaluates_typed U ds [] env' [] hm (fun _ _ h => (by cases h)) he
  · intro h
    obtain ⟨Γ, hΓ⟩ := Option.isSome_iff_exists.1 h
    exact typed_admitted U ds Γ hΓ

end ConcreteSpec.Core
import ConcreteSpec.Spec.Memory
import ConcreteSpec.Proofs.Scalar
import ConcreteSpec.Proofs.Basics

/-!
# Laws of byte memory (foundation C4)

Representation round trips, range and bool validity; allocation freshness and initialization;
retained identities on release; access failure without provenance or after release; store/load
and frame laws; exposed reconstruction soundness and uniqueness; address equality ignores
provenance. Empty memory is well-formed; geometry-preserving updates, store, free and exposure
preserve well-formedness. Exposure preserves byte reads. Reconstruction is complete at both
priorities, with no containing or one-past ties. Pointer round trips require a well-formed
target and a target-valid pointer.
-/
namespace ConcreteSpec.Core.Mem
open ConcreteSpec

@[simp] theorem ordered_ordered (o : ByteOrder) (bs : List (Fin 256)) :
    ordered o (ordered o bs) = bs := by cases o <;> simp [ordered]

@[simp] theorem leBytes_length (k n : Nat) : (leBytes k n).length = k := by
  induction k generalizing n with
  | zero => rfl
  | succ k ih => simp [leBytes, ih]

@[simp] theorem ordered_length (o : ByteOrder) (bs : List (Fin 256)) :
    (ordered o bs).length = bs.length := by cases o <;> simp [ordered]

@[simp] theorem octets_init (bs : List (Fin 256)) :
    octets (bs.map (.init · none)) = some bs := by
  induction bs with
  | nil => rfl
  | cons b bs ih => simp [octets, ih]

theorem leValue_leBytes (k n : Nat) (h : n < 256 ^ k) : leValue (leBytes k n) = n := by
  induction k generalizing n with
  | zero => simp at h; subst n; rfl
  | succ k ih =>
    have hd : n / 256 < 256 ^ k := by
      apply (Nat.div_lt_iff_lt_mul (by decide)).2
      simpa [Nat.pow_succ, Nat.mul_comm] using h
    simp only [leBytes, leValue, ih _ hd]
    omega

theorem leValue_lt (bs : List (Fin 256)) : leValue bs < 256 ^ bs.length := by
  induction bs with
  | nil => simp [leValue]
  | cons b bs ih =>
    simp only [leValue, List.length_cons, Nat.pow_succ]
    have := b.isLt
    omega

theorem intByte_power (t : IntTy) : 256 ^ intBytes t = 2 ^ t.bits := by cases t <;> decide

@[simp] theorem encodeInt_length (tgt : Target) (t : IntTy) (n : Int) :
    (encodeInt tgt t n).length = intBytes t := by simp [encodeInt]

theorem decodeInt_encodeInt (tgt : Target) (t : IntTy) (n : Int) (h : t.InRange n) :
    decodeInt tgt t (encodeInt tgt t n) = some n := by
  unfold decodeInt
  rw [encodeInt_length, ite_eq_left rfl]
  simp only [encodeInt, octets_init, Option.map_some, ordered_ordered]
  rw [leValue_leBytes _ _ (by rw [intByte_power]; exact toBits_lt t n), ofBits_toBits t n h]

theorem octets_length {bs : List MByte} {os : List (Fin 256)}
    (h : octets bs = some os) : os.length = bs.length := by
  induction bs generalizing os with
  | nil => cases h; rfl
  | cons b bs ih =>
    cases b with
    | uninit => cases h
    | init v f =>
      cases ho : octets bs with
      | none => simp [octets, ho] at h
      | some xs => simp [octets, ho] at h; subst os; simp [ih ho]

theorem decodeInt_inRange (tgt : Target) (t : IntTy) (bs : List MByte) (n : Int)
    (h : decodeInt tgt t bs = some n) : t.InRange n := by
  unfold decodeInt at h
  split at h
  next hl =>
    cases ho : octets bs with
    | none => simp [ho] at h
    | some os =>
      simp [ho] at h
      subst n
      apply ofBits_inRange
      have hb := leValue_lt (ordered tgt.byteOrder os)
      rw [ordered_length, octets_length ho, hl, intByte_power] at hb
      exact hb
  next => cases h

@[simp] theorem decodeBool_encodeBool (b : Bool) : decodeBool (encodeBool b) = some b := by
  cases b <;> rfl

theorem decodeBool_valid (bs : List MByte) (b : Bool) (h : decodeBool bs = some b) :
    ∃ v f, bs = [.init v f] ∧ v.val = boolToBits b := by
  match bs with
  | [.init v f] => exact ⟨v, f, rfl, (boolOfBits_some_iff _ _).1 h⟩
  | [] | .uninit :: _ | .init _ _ :: _ :: _ => cases h

theorem decodePtr_encodePtr (tgt : Target) (ht : tgt.WellFormed) (p : Ptr) (hpv : p.Valid tgt) :
    decodePtr tgt (encodePtr tgt p hpv) = some p := by
  have hp : 0 < tgt.ptrSize := by have := ht.1; have := ht.2.1; omega
  have hl : (ordered tgt.byteOrder (leBytes tgt.ptrSize p.addr)).length > 0 := by simpa using hp
  cases hs : ordered tgt.byteOrder (leBytes tgt.ptrSize p.addr) with
  | nil => simp [hs] at hl
  | cons v vs =>
    have he : encodePtr tgt p hpv = .init v (some (p, 0)) ::
        (vs.zipIdx 1).map (fun (v, i) => .init v (some (p, i))) := by
      simp [encodePtr, hs, List.zipIdx_cons]
    rw [he]
    simp only [decodePtr]
    rw [← he]
    simp [hpv]

@[simp] theorem block_modify (m : Memory) (b c : MemBlockId) (f : Block → Block) :
    (m.modify b f).block c = if c = b then (m.block b).map f else m.block c := by
  exact AList.lookup_update b f m.blocks c

/-- Empty memory satisfies every target's memory invariant. -/
theorem empty_wellFormed (tgt : Target) : Memory.empty.WellFormed tgt := by
  constructor <;> simp [Memory.empty, Memory.block, AList.lookup]

private theorem keys_update (xs : AList MemBlockId Block) (b : MemBlockId) (f : Block → Block) :
    List.map Prod.fst (AList.update xs b f) = List.map Prod.fst xs := by
  induction xs with
  | nil => rfl
  | cons e xs ih =>
    simp only [AList.update]
    split <;> simp_all

private theorem canonical_of_unique (xs : AList MemBlockId Block)
    (hu : (List.map Prod.fst xs).Nodup) :
    ∀ e ∈ xs, AList.lookup xs e.1 = some e.2 := by
  induction xs with
  | nil => simp
  | cons a xs ih =>
    simp only [List.map_cons, List.nodup_cons] at hu
    intro e he
    rcases List.mem_cons.mp he with he | he
    · subst e; simp [AList.lookup]
    · have hn : a.1 ≠ e.1 := by
        intro hh
        exact hu.1 (hh ▸ List.mem_map.mpr ⟨e, he, rfl⟩)
      simp [AList.lookup, hn, ih hu.2 e he]

/-- A block update preserving geometry and byte count, and never reviving a dead block,
preserves the whole memory invariant. Exposure and byte contents are otherwise unrestricted. -/
theorem modify_wellFormed (tgt : Target) (m : Memory) (hw : m.WellFormed tgt)
    (b : MemBlockId) (f : Block → Block)
    (hg : ∀ x, (f x).space = x.space ∧ (f x).base = x.base ∧
      (f x).size = x.size ∧ (f x).align = x.align)
    (hs : ∀ x, m.block b = some x → (f x).bytes.length = x.size)
    (hl : ∀ x, (f x).live = true → x.live = true) :
    (m.modify b f).WellFormed tgt := by
  have hu : (List.map Prod.fst (m.modify b f).blocks).Nodup := by
    simpa only [Memory.modify, keys_update] using hw.unique
  have origin : ∀ c y, (m.modify b f).block c = some y →
      ∃ x, m.block c = some x ∧ y.space = x.space ∧ y.base = x.base ∧
        y.size = x.size ∧ y.align = x.align ∧ y.bytes.length = x.size ∧
        (y.live = true → x.live = true) := by
    intro c y hy
    rw [block_modify] at hy
    split at hy
    next he =>
      subst c
      cases hx : m.block b with
      | none => simp [hx] at hy
      | some x =>
        simp only [hx, Option.map_some, Option.some.injEq] at hy
        subst y
        exact ⟨x, rfl, (hg x).1, (hg x).2.1, (hg x).2.2.1,
          (hg x).2.2.2, hs x hx, hl x⟩
    next => exact ⟨y, hy, rfl, rfl, rfl, rfl, hw.sized c y hy, id⟩
  constructor
  · exact canonical_of_unique _ hu
  · exact hu
  · intro c y hy
    obtain ⟨x, hx, _⟩ := origin c y hy
    exact hw.fresh c x hx
  · intro c y hy
    obtain ⟨x, _, _, _, hsize, _, hlen, _⟩ := origin c y hy
    omega
  · intro c y hy
    obtain ⟨x, hx, _, hbase, hsize, _⟩ := origin c y hy
    rw [hbase, hsize]; exact hw.fits c x hx
  · intro c y hy
    obtain ⟨x, hx, hspace, _⟩ := origin c y hy
    rw [hspace]; exact hw.spaces c x hx
  · intro c y hy
    obtain ⟨x, hx, _, hbase, _, halign, _⟩ := origin c y hy
    rw [hbase, halign]; exact hw.aligned c x hx
  · intro c y d z hy hz hne hyl hzl
    obtain ⟨x, hx, hspace, hbase, hsize, _, _, hlive⟩ := origin c y hy
    obtain ⟨w, hw', hspace', hbase', hsize', _, _, hlive'⟩ := origin d z hz
    simpa only [Block.Overlaps, hspace, hbase, hsize, hspace', hbase', hsize'] using
      hw.disjoint c x d w hx hw' hne (hlive hyl) (hlive' hzl)

theorem alloc_result (tgt : Target) (m : Memory) (s : AddrSpace) (base size align : Nat)
    (b : MemBlockId) (m' : Memory) (h : m.alloc tgt s base size align = .ok (b, m')) :
    b = ⟨m.next⟩ ∧ m' = ⟨(b, candidate s base size align) :: m.blocks, m.next + 1⟩ ∧
    m.Fits tgt (candidate s base size align) := by
  simp only [Memory.alloc] at h
  split at h
  next hf => cases h; exact ⟨rfl, rfl, hf⟩
  next => cases h

theorem alloc_fresh (tgt : Target) (m : Memory) (hw : m.WellFormed tgt)
    (s : AddrSpace) (base size align : Nat) (b : MemBlockId) (m' : Memory)
    (h : m.alloc tgt s base size align = .ok (b, m')) : b.id = m.next ∧ m.block b = none := by
  obtain ⟨rfl, _, _⟩ := alloc_result tgt m s base size align b m' h
  refine ⟨rfl, ?_⟩
  cases hb : m.block ⟨m.next⟩ with
  | none => rfl
  | some x => have := hw.fresh _ _ hb; simp at this

theorem alloc_block (tgt : Target) (m : Memory) (s : AddrSpace) (base size align : Nat)
    (b : MemBlockId) (m' : Memory) (h : m.alloc tgt s base size align = .ok (b, m')) :
    m'.block b = some (candidate s base size align) := by
  obtain ⟨_, rfl, _⟩ := alloc_result tgt m s base size align b m' h
  simp [Memory.block, AList.lookup]

/-- The failure constructor contains only an error: no replacement memory. -/
theorem alloc_failure (tgt : Target) (m : Memory) (s : AddrSpace) (base size align : Nat)
    (h : ¬ m.Fits tgt (candidate s base size align)) :
    m.alloc tgt s base size align = .error .unavailable := by simp [Memory.alloc, h]

theorem access_zero (tgt : Target) (m : Memory) (p : Ptr) (a : Nat) :
    m.access tgt p 0 a = if p.addr % a = 0 ∧ p.addr ≠ tgt.null ∧ p.Valid tgt then some none else none := by
  simp [Memory.access]

theorem access_no_provenance (tgt : Target) (m : Memory) (p : Ptr) (n a : Nat)
    (hn : n ≠ 0) (hp : p.prov = none) : m.access tgt p n a = none := by
  simp [Memory.access, hn, hp]

theorem free_retains (m : Memory) (b : MemBlockId) (m' : Memory) (h : m.free b = some m') :
    ∃ x, m.block b = some x ∧
      m'.block b = some { x with live := false, exposed := false } ∧ m'.next = m.next := by
  unfold Memory.free at h
  cases hb : m.block b with
  | none => simp [hb] at h
  | some x =>
    rw [hb] at h
    by_cases hl : x.live = true
    · simp only [hl, ↓reduceIte, Option.some.injEq] at h
      subst m'
      exact ⟨x, rfl, by simp [hb], rfl⟩
    · simp [hl] at h

theorem access_after_free (tgt : Target) (m m' : Memory) (b : MemBlockId)
    (p : Ptr) (n a : Nat) (hf : m.free b = some m') (hp : p.prov = some b)
    (hn : n ≠ 0) : m'.access tgt p n a = none := by
  obtain ⟨x, _, hx, _⟩ := free_retains m b m' hf
  simp [Memory.access, hn, hp, hx]

theorem eqAddr_provenance (s : AddrSpace) (a : Nat) (b c : Option MemBlockId) :
    Ptr.eqAddr ⟨s, a, b⟩ ⟨s, a, c⟩ = true := by simp [Ptr.eqAddr]

/-- Any later allocation differs from every identity still present, including released blocks. -/
theorem alloc_ne_existing (tgt : Target) (m : Memory) (hw : m.WellFormed tgt)
    (s : AddrSpace) (base size align : Nat) (b c : MemBlockId) (m' : Memory) (x : Block)
    (h : m.alloc tgt s base size align = .ok (b, m')) (hc : m.block c = some x) : b ≠ c := by
  obtain ⟨hb, _⟩ := alloc_fresh tgt m hw s base size align b m' h
  have := hw.fresh c x hc
  intro he; subst c; omega

private theorem overlaps_symm (x y : Block) (h : x.Overlaps y) : y.Overlaps x :=
  ⟨h.1.symm, h.2.2.1, h.2.1, h.2.2.2.2, h.2.2.2.1⟩

theorem alloc_wellFormed (tgt : Target) (m : Memory) (hw : m.WellFormed tgt)
    (s : AddrSpace) (base size align : Nat) (b : MemBlockId) (m' : Memory)
    (h : m.alloc tgt s base size align = .ok (b, m')) : m'.WellFormed tgt := by
  obtain ⟨rfl, rfl, hf⟩ := alloc_result tgt m s base size align b m' h
  let z : MemBlockId := ⟨m.next⟩
  let x := candidate s base size align
  have lookup (c : MemBlockId) :
      (Memory.mk ((z, x) :: m.blocks) (m.next + 1)).block c =
        if z = c then some x else m.block c := rfl
  constructor
  · intro e he
    cases he with
    | head => simp [Memory.block, AList.lookup]
    | tail _ he =>
      rw [lookup]
      have hh := hw.canonical e he
      have hfresh := hw.fresh e.1 e.2 hh
      have hn : z ≠ e.1 := by intro hz; rw [← hz] at hfresh; simp [z] at hfresh
      simp [hn, hh]
  · simp only [List.map_cons, List.nodup_cons]
    refine ⟨?_, hw.unique⟩
    intro hm
    obtain ⟨e, he, hz⟩ := List.mem_map.mp hm
    have hh := hw.fresh e.1 e.2 (hw.canonical e he)
    rw [hz] at hh
    exact Nat.lt_irrefl _ hh
  · intro c y hy
    rw [lookup] at hy
    split at hy
    next he => subst c; simp [z]
    next => have hh := hw.fresh c y hy; exact Nat.lt_trans hh (Nat.lt_succ_self _)
  · intro c y hy
    rw [lookup] at hy
    split at hy
    next => cases hy; simp [x, candidate]
    next => exact hw.sized c y hy
  · intro c y hy
    rw [lookup] at hy
    split at hy
    next => cases hy; exact hf.2.2.1
    next => exact hw.fits c y hy
  · intro c y hy
    rw [lookup] at hy
    split at hy
    next => cases hy; exact hf.2.2.2.2.2.2
    next => exact hw.spaces c y hy
  · intro c y hy
    rw [lookup] at hy
    split at hy
    next => cases hy; exact ⟨hf.1, hf.2.1⟩
    next => exact hw.aligned c y hy
  · intro c y d w hy hw' hne hyl hwl
    rw [lookup] at hy hw'
    split at hy
    next hc =>
      cases hy
      split at hw'
      next hd => exact False.elim (hne (hc.symm.trans hd))
      next =>
        intro hov
        exact hf.2.2.2.2.2.1 _ (AList.lookup_mem hw') hwl (overlaps_symm _ _ hov)
    next =>
      split at hw'
      next => cases hw'; exact hf.2.2.2.2.2.1 _ (AList.lookup_mem hy) hyl
      next => exact hw.disjoint c y d w hy hw' hne hyl hwl

/-- Non-overlap makes the in-bounds provenance unique; no order on identities is used. -/
theorem candidate_contains_unique (tgt : Target) (m : Memory) (hw : m.WellFormed tgt)
    (s : AddrSpace) (addr : Nat) (b c : MemBlockId) (x y : Block)
    (hx : m.block b = some x) (hy : m.block c = some y)
    (hxc : x.Candidate s = true) (hyc : y.Candidate s = true)
    (hxi : x.base ≤ addr ∧ addr < x.base + x.size)
    (hyi : y.base ≤ addr ∧ addr < y.base + y.size) : b = c := by
  by_cases hn : b = c
  · exact hn
  apply False.elim
  simp only [Block.Candidate, Bool.and_eq_true, decide_eq_true_eq] at hxc hyc
  apply hw.disjoint b x c y hx hy hn hxc.1.1.1 hyc.1.1.1
  refine ⟨hxc.2.trans hyc.2.symm, hxc.1.2, hyc.1.2, ?_, ?_⟩ <;> omega

/-- Reconstruction chooses an eligible containing block, or a one-past block only when no
eligible block contains the address. -/
theorem fromExposed_sound (tgt : Target) (m : Memory) (hw : m.WellFormed tgt)
    (s : AddrSpace) (addr : Nat) (b : MemBlockId)
    (h : (m.fromExposed s addr).prov = some b) :
    ∃ x, m.block b = some x ∧ x.Candidate s = true ∧
      ((x.base ≤ addr ∧ addr < x.base + x.size) ∨
       (addr = x.base + x.size ∧ ∀ e ∈ m.blocks, e.2.Candidate s = true →
         ¬ (e.2.base ≤ addr ∧ addr < e.2.base + e.2.size))) := by
  unfold Memory.fromExposed at h
  dsimp only at h
  split at h
  next e he =>
    cases h
    have hm := List.mem_of_find?_eq_some he
    have hc := List.mem_filter.mp hm
    exact ⟨e.2, hw.canonical e hc.1, hc.2,
      .inl (by have hh := List.find?_some he; simpa using hh)⟩
  next he =>
    split at h
    next e hp =>
      cases h
      have hc := List.mem_filter.mp (List.mem_of_find?_eq_some hp)
      refine ⟨e.2, hw.canonical e hc.1, hc.2, .inr ⟨?_, ?_⟩⟩
      · have hh := List.find?_some hp
        simpa using hh
      · intro e hm hc'
        have hh := List.find?_eq_none.mp he e (List.mem_filter.mpr ⟨hm, hc'⟩)
        simpa using hh
    next => cases h

/-- An eligible containing or one-past candidate suffices to recover some provenance. -/
theorem fromExposed_exists (m : Memory) (s : AddrSpace) (addr : Nat)
    (e : MemBlockId × Block) (he : e ∈ m.blocks) (hc : e.2.Candidate s = true)
    (ha : (e.2.base ≤ addr ∧ addr < e.2.base + e.2.size) ∨
      addr = e.2.base + e.2.size) :
    ∃ b, (m.fromExposed s addr).prov = some b := by
  have hm : e ∈ m.blocks.filter (fun e => e.2.Candidate s) := List.mem_filter.mpr ⟨he, hc⟩
  unfold Memory.fromExposed
  dsimp only
  split
  next e' _ => exact ⟨e'.1, rfl⟩
  next hn =>
    split
    next e' _ => exact ⟨e'.1, rfl⟩
    next hp =>
      rcases ha with ha | ha
      · have hh := List.find?_eq_none.mp hn e hm
        simp [ha] at hh
      · have hh := List.find?_eq_none.mp hp e hm
        simp [ha] at hh

/-- Completeness at the containing-block priority; no list-order tie-break enters the result. -/
theorem fromExposed_contains (tgt : Target) (m : Memory) (hw : m.WellFormed tgt)
    (s : AddrSpace) (addr : Nat) (b : MemBlockId) (x : Block)
    (hx : m.block b = some x) (hc : x.Candidate s = true)
    (hi : x.base ≤ addr ∧ addr < x.base + x.size) :
    (m.fromExposed s addr).prov = some b := by
  obtain ⟨c, hp⟩ := fromExposed_exists m s addr (b, x) (AList.lookup_mem hx) hc (.inl hi)
  obtain ⟨y, hy, hcy, hiy⟩ := fromExposed_sound tgt m hw s addr c hp
  rcases hiy with hiy | ⟨_, hn⟩
  · have := candidate_contains_unique tgt m hw s addr b c x y hx hy hc hcy hi hiy
    simpa only [← this] using hp
  · exact False.elim (hn (b, x) (AList.lookup_mem hx) hc hi)

/-- Nonempty disjoint blocks in one space cannot share their one-past endpoint either. -/
theorem candidate_onePast_unique (tgt : Target) (m : Memory) (hw : m.WellFormed tgt)
    (s : AddrSpace) (addr : Nat) (b c : MemBlockId) (x y : Block)
    (hx : m.block b = some x) (hy : m.block c = some y)
    (hxc : x.Candidate s = true) (hyc : y.Candidate s = true)
    (hxi : addr = x.base + x.size) (hyi : addr = y.base + y.size) : b = c := by
  by_cases hn : b = c
  · exact hn
  apply False.elim
  simp only [Block.Candidate, Bool.and_eq_true, decide_eq_true_eq] at hxc hyc
  apply hw.disjoint b x c y hx hy hn hxc.1.1.1 hyc.1.1.1
  refine ⟨hxc.2.trans hyc.2.symm, hxc.1.2, hyc.1.2, ?_, ?_⟩ <;> omega

/-- In the absence of any containing candidate, a one-past candidate is recovered exactly. -/
theorem fromExposed_onePast (tgt : Target) (m : Memory) (hw : m.WellFormed tgt)
    (s : AddrSpace) (addr : Nat) (b : MemBlockId) (x : Block)
    (hx : m.block b = some x) (hc : x.Candidate s = true) (hi : addr = x.base + x.size)
    (hn : ∀ e ∈ m.blocks, e.2.Candidate s = true →
      ¬ (e.2.base ≤ addr ∧ addr < e.2.base + e.2.size)) :
    (m.fromExposed s addr).prov = some b := by
  obtain ⟨c, hp⟩ := fromExposed_exists m s addr (b, x) (AList.lookup_mem hx) hc (.inr hi)
  obtain ⟨y, hy, hcy, hiy⟩ := fromExposed_sound tgt m hw s addr c hp
  rcases hiy with hiy | ⟨hiy, _⟩
  · exact False.elim (hn (c, y) (AList.lookup_mem hy) hcy hiy)
  · have := candidate_onePast_unique tgt m hw s addr b c x y hx hy hc hcy hi hiy
    simpa only [← this] using hp

/-- If neither priority has a candidate, reconstruction supplies no provenance. -/
theorem fromExposed_none (tgt : Target) (m : Memory) (hw : m.WellFormed tgt)
    (s : AddrSpace) (addr : Nat)
    (hn : ∀ e ∈ m.blocks, e.2.Candidate s = true →
      ¬ (e.2.base ≤ addr ∧ addr < e.2.base + e.2.size) ∧ addr ≠ e.2.base + e.2.size) :
    (m.fromExposed s addr).prov = none := by
  cases hp : (m.fromExposed s addr).prov with
  | none => rfl
  | some b =>
    obtain ⟨x, hx, hc, hi⟩ := fromExposed_sound tgt m hw s addr b hp
    have hh := hn (b, x) (AList.lookup_mem hx) hc
    rcases hi with hi | ⟨hi, _⟩
    · exact False.elim (hh.1 hi)
    · exact False.elim (hh.2 hi)

/-- A valid nonempty access identifies a live block and an in-bounds offset. -/
theorem access_some (tgt : Target) (m : Memory) (p : Ptr) (n a : Nat) (b : MemBlockId)
    (off : Nat) (h : m.access tgt p n a = some (some (b, off))) :
    ∃ x, p.prov = some b ∧ m.block b = some x ∧ n ≠ 0 ∧ x.live = true ∧
      x.space = p.space ∧ x.base ≤ p.addr ∧ p.addr + n ≤ x.base + x.size ∧
      p.addr % a = 0 ∧ off = p.addr - x.base ∧ p.Valid tgt := by
  unfold Memory.access at h
  split at h
  next => split at h <;> cases h
  next hn =>
    cases hp : p.prov with
    | none => simp [hp] at h
    | some c =>
      simp only [hp] at h
      cases hx : m.block c with
      | none => simp [hx] at h
      | some x =>
        simp only [hx] at h
        split at h
        next hv => cases h; exact ⟨x, rfl, hx, hn, hv.1, hv.2.1, hv.2.2.1,
          hv.2.2.2.1, hv.2.2.2.2.1, rfl, hv.2.2.2.2.2⟩
        next => cases h

/-- Every successful access, including a zero-byte one, uses a target-valid pointer. -/
theorem access_valid (tgt : Target) (m : Memory) (p : Ptr) (n a : Nat)
    (r : Option (MemBlockId × Nat)) (h : m.access tgt p n a = some r) : p.Valid tgt := by
  unfold Memory.access at h
  split at h
  · split at h
    next hv => exact hv.2.2
    next => cases h
  · split at h
    next => cases h
    next =>
      split at h
      next => cases h
      next =>
        split at h
        next hv => exact hv.2.2.2.2.2
        next => cases h

/-- Every decoded whole stored pointer is target-valid. Other fragment patterns remain
without pointer meaning in this draft. -/
theorem decodePtr_valid (tgt : Target) (bs : List MByte) (p : Ptr)
    (h : decodePtr tgt bs = some p) : p.Valid tgt := by
  match bs with
  | .init _ (some (q, 0)) :: _ =>
    simp only [decodePtr] at h
    split at h
    next hp =>
      split at h
      next => cases h; exact hp
      next => cases h
    next => cases h
  | [] | .uninit :: _ | .init _ none :: _ | .init _ (some (_, Nat.succ _)) :: _ => cases h

/-- Replacing a range reads back exactly that range. -/
theorem splice_read (xs bs : List MByte) (off : Nat) (h : off ≤ xs.length) :
    ((xs.take off ++ bs ++ xs.drop (off + bs.length)).drop off).take bs.length = bs := by
  rw [List.append_assoc, List.drop_append_of_le_length (by simp [List.length_take, Nat.min_eq_left h])]
  simp

/-- The bytes before and after a splice are unchanged, including uninitialized bytes and fragments. -/
theorem splice_frame (xs bs : List MByte) (off i : Nat)
    (hb : off + bs.length ≤ xs.length) (hi : i < off ∨ off + bs.length ≤ i) :
    (xs.take off ++ bs ++ xs.drop (off + bs.length))[i]? = xs[i]? := by
  have ho : off ≤ xs.length := by omega
  have hl : (xs.take off).length = off := by simp [List.length_take, Nat.min_eq_left ho]
  rcases hi with hi | hi
  · rw [List.getElem?_append_left (by simp [hl]; omega)]
    rw [List.getElem?_append_left (by omega)]
    exact List.getElem?_take_of_lt hi
  · rw [List.getElem?_append_right (by simp [hl]; omega)]
    simp only [List.length_append, hl, List.getElem?_drop]
    congr 1
    omega

theorem store_load (tgt : Target) (m m' : Memory) (hw : m.WellFormed tgt)
    (p : Ptr) (bs : List MByte) (a : Nat) (h : m.store tgt p bs a = some m') :
    m'.load tgt p bs.length a = some bs := by
  unfold Memory.store at h
  cases ha : m.access tgt p bs.length a with
  | none => simp [ha] at h
  | some v =>
    rw [ha] at h
    cases v with
    | none =>
      cases h
      have hz : bs.length = 0 := by
        unfold Memory.access at ha
        split at ha
        next hn => exact hn
        next => split at ha <;> (try split at ha) <;> (try split at ha) <;> cases ha
      have he : bs = [] := List.eq_nil_of_length_eq_zero hz
      subst bs
      simp only [Memory.load, ha]
    | some v =>
      obtain ⟨b, off⟩ := v
      cases h
      obtain ⟨x, hp, hx, hn, hv, hs, hlo, hhi, hal, hoff, hpv⟩ := access_some tgt m p bs.length a b off ha
      have hsize := hw.sized b x hx
      have hbound : off + bs.length ≤ x.bytes.length := by omega
      have ha' : (m.modify b (fun x => { x with bytes := x.bytes.take off ++ bs ++ x.bytes.drop (off + bs.length) })).access tgt p bs.length a = some (some (b, off)) := by
        simp [Memory.access, hn, hp, hx, hv, hs, hlo, hhi, hal, hoff, hpv]
      simp only [Memory.load, ha', block_modify, ↓reduceIte, hx, Option.map_some]
      congr 1
      exact splice_read _ _ _ (by omega)

/-- A store frames every block except its access block. -/
theorem store_other_block (tgt : Target) (m m' : Memory) (p : Ptr) (bs : List MByte)
    (a : Nat) (b : MemBlockId) (off : Nat) (c : MemBlockId)
    (ha : m.access tgt p bs.length a = some (some (b, off)))
    (h : m.store tgt p bs a = some m') (hc : c ≠ b) : m'.block c = m.block c := by
  simp only [Memory.store, ha, Option.some.injEq] at h
  subst m'
  simp [hc]

/-- A store also frames each byte outside its range in the accessed block. -/
theorem store_same_block_frame (tgt : Target) (m m' : Memory) (hw : m.WellFormed tgt)
    (p : Ptr) (bs : List MByte) (a : Nat) (b : MemBlockId) (off i : Nat) (x : Block)
    (ha : m.access tgt p bs.length a = some (some (b, off)))
    (hx : m.block b = some x) (h : m.store tgt p bs a = some m')
    (hi : i < off ∨ off + bs.length ≤ i) :
    (m'.block b).map (fun y => y.bytes[i]?) = some (x.bytes[i]?) := by
  simp only [Memory.store, ha, Option.some.injEq] at h
  subst m'
  simp only [block_modify, ↓reduceIte, hx, Option.map_some]
  congr 1
  obtain ⟨y, _, hy, _, _, _, hlo, hhi, _, hoff, _⟩ := access_some tgt m p bs.length a b off ha
  rw [hx] at hy
  cases hy
  apply splice_frame _ _ _ _ _ hi
  have := hw.sized b x hx
  omega

/-- The allocated block is live and unexposed and every byte is uninitialized. -/
theorem alloc_initialized (tgt : Target) (m : Memory) (s : AddrSpace) (base size align : Nat)
    (b : MemBlockId) (m' : Memory) (h : m.alloc tgt s base size align = .ok (b, m')) :
    ∃ x, m'.block b = some x ∧ x.live = true ∧ x.exposed = false ∧
      x.bytes = List.replicate size .uninit :=
  ⟨candidate s base size align, alloc_block tgt m s base size align b m' h, rfl, rfl, rfl⟩

/-- Successful byte stores preserve block geometry, liveness and well-formedness. -/
theorem store_wellFormed (tgt : Target) (m m' : Memory) (hw : m.WellFormed tgt)
    (p : Ptr) (bs : List MByte) (a : Nat) (h : m.store tgt p bs a = some m') :
    m'.WellFormed tgt := by
  unfold Memory.store at h
  cases ha : m.access tgt p bs.length a with
  | none => simp [ha] at h
  | some v =>
    rw [ha] at h
    cases v with
    | none => cases h; exact hw
    | some pair =>
      obtain ⟨b, off⟩ := pair
      cases h
      obtain ⟨x, _, hx, _, _, _, hlo, hhi, _, hoff, _⟩ :=
        access_some tgt m p bs.length a b off ha
      apply modify_wellFormed tgt m hw b
      · intro y; exact ⟨rfl, rfl, rfl, rfl⟩
      · intro y hy
        rw [hx] at hy; cases hy
        have := hw.sized b x hx
        simp only [List.length_append, List.length_take, List.length_drop]
        omega
      · intro y hy; exact hy

/-- Successful release preserves the invariant without deleting the identity. -/
theorem free_wellFormed (tgt : Target) (m m' : Memory) (hw : m.WellFormed tgt)
    (b : MemBlockId) (h : m.free b = some m') : m'.WellFormed tgt := by
  unfold Memory.free at h
  split at h
  next x hx =>
    split at h
    next =>
      cases h
      apply modify_wellFormed tgt m hw b
      · intro y; exact ⟨rfl, rfl, rfl, rfl⟩
      · intro y hy; exact hw.sized b y hy
      · intro y hy; cases hy
    next => cases h
  next => cases h

/-- Exposure changes exactly the exposed flag of a live provenance block. -/
theorem expose_result (m m' : Memory) (p : Ptr) (h : m.expose p = some m') :
    ∃ b x, p.prov = some b ∧ m.block b = some x ∧ x.live = true ∧
      m' = m.modify b (fun y => { y with exposed := true }) := by
  unfold Memory.expose at h
  split at h
  next => cases h
  next b hp =>
    split at h
    next x hx =>
      split at h
      next hl => cases h; exact ⟨b, x, hp, hx, hl, rfl⟩
      next => cases h
    next => cases h

/-- Conversely every live provenance block can be exposed, preserving all other fields. -/
theorem expose_success (m : Memory) (p : Ptr) (b : MemBlockId) (x : Block)
    (hp : p.prov = some b) (hx : m.block b = some x) (hl : x.live = true) :
    m.expose p = some (m.modify b (fun y => { y with exposed := true })) := by
  simp [Memory.expose, hp, hx, hl]

/-- The exposed block has exactly its old fields except the exposed flag; other blocks and
freshness counter are unchanged. -/
theorem expose_frame (m m' : Memory) (p : Ptr) (h : m.expose p = some m') :
    ∃ b x, p.prov = some b ∧ m.block b = some x ∧
      m'.block b = some { x with exposed := true } ∧ m'.next = m.next ∧
      ∀ c, c ≠ b → m'.block c = m.block c := by
  obtain ⟨b, x, hp, hx, _, rfl⟩ := expose_result m m' p h
  exact ⟨b, x, hp, hx, by simp [hx], rfl, by intro c hc; simp [hc]⟩

/-- Marking a block exposed preserves well-formedness. -/
theorem expose_wellFormed (tgt : Target) (m m' : Memory) (hw : m.WellFormed tgt)
    (p : Ptr) (h : m.expose p = some m') : m'.WellFormed tgt := by
  obtain ⟨b, _, _, _, _, rfl⟩ := expose_result m m' p h
  apply modify_wellFormed tgt m hw b
  · intro y; exact ⟨rfl, rfl, rfl, rfl⟩
  · intro y hy; exact hw.sized b y hy
  · intro y hy; exact hy

/-- Geometry relevant to hybrid projections; neither byte contents nor exposure is cached. -/
def Block.geometry (x : Block) : AddrSpace × Nat × Nat × Nat :=
  (x.space, x.base, x.size, x.align)

/-- Store does not change any block's projection geometry. -/
theorem store_geometry (tgt : Target) (m m' : Memory) (p : Ptr) (bs : List MByte)
    (a : Nat) (h : m.store tgt p bs a = some m') (b : MemBlockId) :
    (m'.block b).map Block.geometry = (m.block b).map Block.geometry := by
  unfold Memory.store at h
  split at h
  next => cases h; rfl
  next c off =>
    cases h
    simp only [block_modify]
    split
    · next he =>
      subst b
      cases m.block _ <;> rfl
    · rfl
  next => cases h

/-- Exposure also preserves every projection's geometry. -/
theorem expose_geometry (m m' : Memory) (p : Ptr) (h : m.expose p = some m')
    (b : MemBlockId) :
    (m'.block b).map Block.geometry = (m.block b).map Block.geometry := by
  obtain ⟨c, _, _, _, _, rfl⟩ := expose_result m m' p h
  simp only [block_modify]
  split
  · next he =>
      subst b
      cases m.block _ <;> rfl
  · rfl

/-- Reads depend only on their provenance block, independently of every other block. -/
theorem load_congr (tgt : Target) (m m' : Memory) (p : Ptr) (n a : Nat)
    (h : ∀ b, p.prov = some b → m'.block b = m.block b) :
    m'.load tgt p n a = m.load tgt p n a := by
  by_cases hz : n = 0
  · by_cases hv : p.addr % a = 0 ∧ p.addr ≠ tgt.null ∧ p.Valid tgt
    all_goals simp [Memory.load, Memory.access, hz, hv]
  · cases hp : p.prov with
    | none => simp [Memory.load, Memory.access, hz, hp]
    | some b =>
      cases hx : m.block b with
      | none => simp [Memory.load, Memory.access, hz, hp, h b hp, hx]
      | some x =>
        simp only [Memory.load, Memory.access, hz, ↓reduceIte, hp, h b hp, hx]
        split <;> simp_all

/-- A store frames reads using a different allocation identity. -/
theorem store_load_other (tgt : Target) (m m' : Memory) (p q : Ptr) (bs : List MByte)
    (a n align : Nat) (h : m.store tgt p bs a = some m') (hn : q.prov ≠ p.prov) :
    m'.load tgt q n align = m.load tgt q n align := by
  unfold Memory.store at h
  cases ha : m.access tgt p bs.length a with
  | none => simp [ha] at h
  | some v =>
    rw [ha] at h
    cases v with
    | none => cases h; rfl
    | some pair =>
      obtain ⟨b, off⟩ := pair
      cases h
      obtain ⟨_, hp, _⟩ := access_some tgt m p bs.length a b off ha
      apply load_congr
      intro c hc
      have hcb : c ≠ b := by intro he; subst c; exact hn (hc.trans hp.symm)
      simp [hcb]

/-- Exposure affects provenance reconstruction, but no byte read or access check. -/
theorem expose_load (tgt : Target) (m m' : Memory) (p q : Ptr) (n a : Nat)
    (h : m.expose p = some m') : m'.load tgt q n a = m.load tgt q n a := by
  obtain ⟨b, _, _, _, _, rfl⟩ := expose_result m m' p h
  by_cases hz : n = 0
  · by_cases hv : q.addr % a = 0 ∧ q.addr ≠ tgt.null ∧ q.Valid tgt
    all_goals simp [Memory.load, Memory.access, hz, hv]
  · cases hp : q.prov with
    | none => simp [Memory.load, Memory.access, hp, hz]
    | some c =>
      by_cases hc : c = b
      · subst c
        cases hx : m.block b with
        | none => simp [Memory.load, Memory.access, hp, hz, hx]
        | some x =>
          simp only [Memory.load, Memory.access, hz, ↓reduceIte, hp, block_modify, hx,
            Option.map_some]
          split <;> simp_all
      · apply load_congr
        intro d hd
        have hd' : d = c := by rw [hp] at hd; exact (Option.some.inj hd).symm
        subst d
        simp [hc]

/-- A successful nonempty read can be shortened to any nonempty prefix. -/
theorem load_prefix (tgt : Target) (m : Memory) (p : Ptr) (n k a : Nat) (bs : List MByte)
    (hn : n ≠ 0) (hk : k ≠ 0) (hkn : k ≤ n) (h : m.load tgt p n a = some bs) :
    m.load tgt p k a = some (bs.take k) := by
  unfold Memory.load at h
  cases ha : m.access tgt p n a with
  | none => simp [ha] at h
  | some v =>
    rw [ha] at h
    cases v with
    | none => simp [Memory.access, hn] at ha; split at ha <;> (try split at ha) <;>
        (try split at ha) <;> cases ha
    | some pair =>
      obtain ⟨b, off⟩ := pair
      obtain ⟨x, hp, hx, _, hl, hs, hlo, hhi, hal, hoff, hpv⟩ :=
        access_some tgt m p n a b off ha
      simp only [hx, Option.map_some, Option.some.injEq] at h
      subst bs
      have hb : p.addr + k ≤ x.base + x.size := by omega
      simp [Memory.load, Memory.access, hk, hp, hx, hl, hs, hlo, hb, hal, hpv, hoff,
        List.take_take, Nat.min_eq_left hkn]

/-- Releasing a block cannot permit any existing identity to be reused by the next allocation,
even when the allocator reuses the released address. -/
theorem free_alloc_ne_existing (tgt : Target) (m freed allocated : Memory)
    (hw : m.WellFormed tgt) (b c new : MemBlockId) (x : Block)
    (hf : m.free b = some freed) (hc : m.block c = some x)
    (s : AddrSpace) (base size align : Nat)
    (ha : freed.alloc tgt s base size align = .ok (new, allocated)) : new ≠ c := by
  obtain ⟨_, _, _, hn⟩ := free_retains m b freed hf
  obtain ⟨he, _, _⟩ := alloc_result tgt freed s base size align new allocated ha
  have hlt := hw.fresh c x hc
  intro heq
  rw [heq] at he
  have hid := congrArg MemBlockId.id he
  dsimp at hid
  omega

end ConcreteSpec.Core.Mem
import ConcreteSpec.Spec.Hybrid
import ConcreteSpec.Proofs.Memory

/-!
# Hybrid storage laws (C4)

Scalar representation round trip and decode validity; structured reads; materialization reuses
its stable projection; typed writes read back the value and frame inactive bytes. No theorem
assumes a materialized typed cache, and no write selects padding again. The memory and
projection invariants survive every state operation. First materialization preserves the
read value. Typed writes frame disjoint byte intervals; materialization and exposure frame
every other place without an extra separation premise.
-/
namespace ConcreteSpec.Core.Hybrid
open ConcreteSpec.Core.Mem

@[simp] theorem encode_length (tgt : Target) (v : Value) :
    (encode tgt v).length = sizeof v.ty := by
  cases v <;> simp [encode, Value.ty, CVal.ty, sizeof, encodeBool]

theorem rep_roundtrip (tgt : Target) (v : Value) (hv : v.Storable) :
    Rep tgt v.ty (encode tgt v) v := by
  cases v with
  | int t n => simp [Rep, Value.ty, CVal.ty, encode, decode, decodeInt_encodeInt tgt t n hv.1]
  | bool b => simp [Rep, Value.ty, CVal.ty, encode, decode]
  | unit => exact False.elim (hv.2 rfl)

theorem decode_valid (tgt : Target) (t : Ty) (bs : List MByte) (v : Value)
    (h : decode tgt t bs = some v) : v.ty = t ∧ v.Storable := by
  cases t with
  | int t =>
    cases hd : decodeInt tgt t bs with
    | none => simp [decode, hd] at h
    | some n =>
      simp [decode, hd] at h
      subst v
      exact ⟨rfl, decodeInt_inRange tgt t bs n hd, by simp [Value.ty, CVal.ty]⟩
  | bool =>
    cases hd : decodeBool bs with
    | none => simp [decode, hd] at h
    | some b => simp [decode, hd] at h; subst v; exact ⟨rfl, trivial, by simp [Value.ty, CVal.ty]⟩
  | unit => cases h

theorem read_structured (tgt : Target) (st : State) (p : Place) (t : Ty) (v : Value)
    (hc : st.places p = some ⟨t, .structured v⟩) (ht : v.ty = t) (hv : v.Storable) :
    st.read tgt p = some v := by simp [State.read, hc, ht, hv]

/-- Once materialized, repeated address-taking returns the same range and the same whole state. -/
theorem materialize_reuse (tgt : Target) (st : State) (p : Place) (t : Ty) (r : Range)
    (hc : st.places p = some ⟨t, .materialized r⟩) (s : AddrSpace) (base align : Nat)
    (padding : List MByte) : st.materialize tgt p s base align padding = some (r, st) := by
  simp [State.materialize, hc]

theorem write_read (tgt : Target) (st st' : State) (hw : st.memory.WellFormed tgt)
    (p : Place) (v : Value) (h : st.write tgt p v = some st') :
    st'.read tgt p = some v := by
  unfold State.write at h
  cases hc : st.places p with
  | none => simp [hc] at h
  | some c =>
    simp only [hc] at h
    dsimp at h
    split at h
    next hv =>
      cases hs : c.storage with
      | structured old =>
        simp only [hs, Option.some.injEq] at h
        subst st'
        simp [State.read, hv]
      | materialized r =>
        simp only [hs] at h
        cases hm : st.memory.store tgt r.ptr (encode tgt v) r.align with
        | none => simp [hm] at h
        | some m =>
          simp [hm] at h
          subst st'
          have hl := store_load tgt st.memory m hw r.ptr (encode tgt v) r.align hm
          rw [encode_length, hv.1] at hl
          simp only [State.read, State.places_memory, hc]
          dsimp
          rw [hs]
          dsimp
          rw [hl]
          dsimp
          rw [← hv.1]
          exact rep_roundtrip tgt v hv.2
    next => simp at h

/-- The low-level store frame theorem applies verbatim to a typed write's active encoding.
In particular every padding byte, including initialization and fragments, is preserved. -/
theorem typed_store_frame (tgt : Target) (m m' : Memory) (hw : m.WellFormed tgt)
    (r : Range) (v : Value) (b : MemBlockId) (off i : Nat) (x : Block)
    (ha : m.access tgt r.ptr (encode tgt v).length r.align = some (some (b, off)))
    (hx : m.block b = some x) (h : m.store tgt r.ptr (encode tgt v) r.align = some m')
    (hi : i < off ∨ off + sizeof v.ty ≤ i) :
    (m'.block b).map (fun y => y.bytes[i]?) = some (x.bytes[i]?) := by
  exact store_same_block_frame tgt m m' hw r.ptr (encode tgt v) r.align b off i x ha hx h
    (by simpa using hi)

/-- Every successful materialization leaves the returned range as the place's sole projection. -/
theorem materialize_projection (tgt : Target) (st st' : State) (p : Place) (s : AddrSpace)
    (base align : Nat) (padding : List MByte) (r : Range)
    (h : st.materialize tgt p s base align padding = some (r, st')) :
    ∃ t, st'.places p = some ⟨t, .materialized r⟩ := by
  unfold State.materialize at h
  cases hc : st.places p with
  | none => simp [hc] at h
  | some c =>
    simp only [hc] at h
    dsimp at h
    cases hs : c.storage with
    | materialized old =>
      simp only [hs, Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      exact ⟨c.ty, by cases c; simp_all⟩
    | structured v =>
      simp only [hs] at h
      split at h
      next =>
        cases ha : (st.memory.alloc tgt s base (encode tgt v ++ padding).length align).toOption with
        | none => simp only [ha] at h; cases h
        | some pair =>
          obtain ⟨b, m⟩ := pair
          simp only [ha] at h
          cases hm : m.store tgt ⟨s, base, some b⟩ (encode tgt v ++ padding) align with
          | none => simp [hm] at h
          | some m' =>
            simp [hm] at h
            obtain ⟨rfl, rfl⟩ := h
            exact ⟨c.ty, by simp⟩
      next => simp at h

/-- Materialization is idempotent after the first success, independently of later address,
alignment or padding inputs. In particular it never asks for another padding selection. -/
theorem materialize_idempotent (tgt : Target) (st st' : State) (p : Place) (s s' : AddrSpace)
    (base align base' align' : Nat) (padding padding' : List MByte) (r : Range)
    (h : st.materialize tgt p s base align padding = some (r, st')) :
    st'.materialize tgt p s' base' align' padding' = some (r, st') := by
  obtain ⟨t, ht⟩ := materialize_projection tgt st st' p s base align padding r h
  exact materialize_reuse tgt st' p t r ht s' base' align' padding'

/-- Projection validity depends only on block geometry, not on bytes or exposure. -/
theorem projected_transport (m m' : Memory) (c : Cell) (hc : c.Projected m)
    (hg : ∀ b, (m'.block b).map Block.geometry = (m.block b).map Block.geometry) :
    c.Projected m' := by
  cases hs : c.storage with
  | structured v => simp [Cell.Projected, hs]
  | materialized r =>
    simp only [Cell.Projected, hs] at hc ⊢
    obtain ⟨b, x, hp, hx, hspace, hbase, hsize, halign, hfit⟩ := hc
    have hh := hg b
    rw [hx] at hh
    cases hy : m'.block b with
    | none => simp [hy] at hh
    | some y =>
      simp only [hy, Option.map_some, Option.some.injEq, Block.geometry,
        Prod.mk.injEq] at hh
      exact ⟨b, y, hp, hy, hspace.trans hh.1.symm, hbase.trans hh.2.1.symm,
        hsize.trans hh.2.2.1.symm, halign.trans hh.2.2.2.symm, hfit⟩

/-- Replacing bytes or exposure while preserving geometry preserves every cell projection. -/
theorem memory_wellFormed (tgt : Target) (st : State) (m : Memory)
    (hw : st.WellFormed tgt) (hm : m.WellFormed tgt)
    (hg : ∀ b, (m.block b).map Block.geometry = (st.memory.block b).map Block.geometry) :
    ({ st with memory := m } : State).WellFormed tgt := by
  refine ⟨hm, ?_⟩
  intro p c hc
  exact projected_transport _ _ c (hw.projected p c hc) hg

/-- Updating one structured cell preserves the hybrid invariant. -/
theorem set_wellFormed (tgt : Target) (st : State) (p : Place) (c : Cell)
    (hw : st.WellFormed tgt) (hc : c.Projected st.memory) :
    (st.set p c).WellFormed tgt := by
  refine ⟨hw.memory, ?_⟩
  intro q d hd
  simp only [State.places_set] at hd
  split at hd
  · cases hd; exact hc
  · exact hw.projected q d hd

/-- Typed writes preserve the byte-memory invariant and every projection's extent. -/
theorem write_wellFormed (tgt : Target) (st st' : State) (hw : st.WellFormed tgt)
    (p : Place) (v : Value) (h : st.write tgt p v = some st') : st'.WellFormed tgt := by
  unfold State.write at h
  cases hc : st.places p with
  | none => simp [hc] at h
  | some c =>
    simp only [hc] at h
    dsimp at h
    split at h
    next =>
      cases hs : c.storage with
      | structured old =>
        simp only [hs, Option.some.injEq] at h
        subst st'
        exact set_wellFormed tgt st p _ hw trivial
      | materialized r =>
        simp only [hs] at h
        cases hm : st.memory.store tgt r.ptr (encode tgt v) r.align with
        | none => simp [hm] at h
        | some m =>
          simp [hm] at h
          subst st'
          exact memory_wellFormed tgt st m hw
            (store_wellFormed tgt _ _ hw.memory _ _ _ hm)
            (store_geometry tgt _ _ _ _ _ hm)
    next => simp at h

/-- Raw writes likewise preserve geometry without maintaining a second typed copy. -/
theorem rawWrite_wellFormed (tgt : Target) (st st' : State) (hw : st.WellFormed tgt)
    (p : Ptr) (bs : List MByte) (align : Nat)
    (h : st.rawWrite tgt p bs align = some st') : st'.WellFormed tgt := by
  unfold State.rawWrite at h
  cases hm : st.memory.store tgt p bs align with
  | none => simp [hm] at h
  | some m =>
    simp [hm] at h
    subst st'
    exact memory_wellFormed tgt st m hw
      (store_wellFormed tgt _ _ hw.memory _ _ _ hm) (store_geometry tgt _ _ _ _ _ hm)

/-- Successful materialization either reuses the existing cell or allocates and fills one
fresh block. This decomposition keeps the later laws independent of monadic elaboration. -/
theorem materialize_cases (tgt : Target) (st st' : State) (p : Place) (s : AddrSpace)
    (base align : Nat) (padding : List MByte) (r : Range)
    (h : st.materialize tgt p s base align padding = some (r, st')) :
    (∃ c, st.places p = some c ∧ c.storage = .materialized r ∧ st' = st) ∨
    ∃ c v b m m', st.places p = some c ∧ c.storage = .structured v ∧
      v.ty = c.ty ∧ v.Storable ∧
      st.memory.alloc tgt s base (encode tgt v ++ padding).length align = .ok (b, m) ∧
      m.store tgt ⟨s, base, some b⟩ (encode tgt v ++ padding) align = some m' ∧
      r = ⟨⟨s, base, some b⟩, (encode tgt v ++ padding).length, align⟩ ∧
      st' = ({ st with memory := m' }).set p { c with storage := .materialized r } := by
  unfold State.materialize at h
  cases hc : st.places p with
  | none => simp [hc] at h
  | some c =>
    simp only [hc] at h
    dsimp at h
    cases hs : c.storage with
    | materialized old =>
      simp only [hs, Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      exact .inl ⟨c, rfl, hs, rfl⟩
    | structured v =>
      simp only [hs] at h
      split at h
      next hv =>
        cases ha : st.memory.alloc tgt s base (encode tgt v ++ padding).length align with
        | error e => simp only [ha, Except.toOption, Option.bind_none] at h; cases h
        | ok pair =>
          obtain ⟨b, m⟩ := pair
          simp only [ha, Except.toOption, Option.bind_some] at h
          cases hm : m.store tgt ⟨s, base, some b⟩ (encode tgt v ++ padding) align with
          | none => simp [hm] at h
          | some m' =>
            simp only [hm, Option.bind_some, Option.some.injEq, Prod.mk.injEq] at h
            obtain ⟨rfl, rfl⟩ := h
            exact .inr ⟨c, v, b, m, m', rfl, hs, hv.1, hv.2, ha, hm, rfl, rfl⟩
      next => simp at h

/-- Allocation preserves the geometry of every preexisting projected block. -/
theorem alloc_projected (tgt : Target) (m m' : Memory) (hw : m.WellFormed tgt)
    (c : Cell) (hc : c.Projected m) (s : AddrSpace) (base size align : Nat)
    (b : MemBlockId) (ha : m.alloc tgt s base size align = .ok (b, m')) :
    c.Projected m' := by
  cases hs : c.storage with
  | structured v => simp [Cell.Projected, hs]
  | materialized r =>
    simp only [Cell.Projected, hs] at hc ⊢
    obtain ⟨d, x, hp, hx, rest⟩ := hc
    have hn := alloc_ne_existing tgt m hw s base size align b d m' x ha hx
    obtain ⟨_, rfl, _⟩ := alloc_result tgt m s base size align b m' ha
    refine ⟨d, x, hp, ?_, rest⟩
    simp [Memory.block, AList.lookup, hn, ← hx]

/-- Materialization preserves memory well-formedness and all cell-to-block projections. -/
theorem materialize_wellFormed (tgt : Target) (st st' : State) (hw : st.WellFormed tgt)
    (p : Place) (s : AddrSpace) (base align : Nat) (padding : List MByte) (r : Range)
    (h : st.materialize tgt p s base align padding = some (r, st')) : st'.WellFormed tgt := by
  rcases materialize_cases tgt st st' p s base align padding r h with reused | fresh
  · obtain ⟨_, _, _, rfl⟩ := reused; exact hw
  · obtain ⟨c, v, b, m, m', _, _, ht, _, ha, hm, rfl, rfl⟩ := fresh
    have ham := alloc_wellFormed tgt _ hw.memory s base _ align b m ha
    have halloc : ({ st with memory := m } : State).WellFormed tgt := by
      refine ⟨ham, ?_⟩
      intro q d hd
      exact alloc_projected tgt _ _ hw.memory d (hw.projected q d hd) s base _ align b ha
    have hwritten := memory_wellFormed tgt _ m' halloc
      (store_wellFormed tgt m m' ham _ _ _ hm) (store_geometry tgt _ _ _ _ _ hm)
    apply set_wellFormed tgt _ p _ hwritten
    apply projected_transport m m' _ _ (store_geometry tgt _ _ _ _ _ hm)
    simp only [Cell.Projected]
    refine ⟨b, candidate s base (encode tgt v ++ padding).length align, rfl,
      alloc_block tgt _ s base _ align b m ha, rfl, rfl, rfl, rfl, ?_⟩
    simp [List.length_append, encode_length, ht]

/-- Exposing a typed place preserves both layers of the invariant. -/
theorem expose_wellFormed (tgt : Target) (st st' : State) (hw : st.WellFormed tgt)
    (p : Place) (s : AddrSpace) (base align : Nat) (padding : List MByte) (r : Range)
    (h : st.expose tgt p s base align padding = some (r, st')) : st'.WellFormed tgt := by
  unfold State.expose at h
  cases hm : st.materialize tgt p s base align padding with
  | none => simp [hm] at h
  | some pair =>
    obtain ⟨r', mid⟩ := pair
    simp only [hm] at h
    dsimp at h
    cases he : mid.memory.expose r'.ptr with
    | none => simp [he] at h
    | some m =>
      simp [he] at h
      obtain ⟨rfl, rfl⟩ := h
      have hmid := materialize_wellFormed tgt st mid hw p s base align padding r' hm
      exact memory_wellFormed tgt mid m hmid
        (Mem.expose_wellFormed tgt _ _ hmid.memory _ he) (expose_geometry _ _ _ he)

/-- Typed writes frame every other place with a distinct materialized allocation identity. -/
theorem write_frame (tgt : Target) (st st' : State) (p q : Place) (v : Value)
    (hne : q ≠ p) (hsep : st.Separated p q) (h : st.write tgt p v = some st') :
    st'.read tgt q = st.read tgt q := by
  unfold State.write at h
  cases hc : st.places p with
  | none => simp [hc] at h
  | some c =>
    simp only [hc] at h
    dsimp at h
    split at h
    next =>
      cases hs : c.storage with
      | structured old =>
        simp only [hs, Option.some.injEq] at h
        subst st'
        simp [State.read, Ne.symm hne]
      | materialized r =>
        simp only [hs] at h
        cases hm : st.memory.store tgt r.ptr (encode tgt v) r.align with
        | none => simp [hm] at h
        | some m =>
          simp [hm] at h
          subst st'
          cases hq : st.places q with
          | none => simp [State.read, hq]
          | some d =>
            cases hd : d.storage with
            | structured w => simp [State.read, hq, hd]
            | materialized s =>
              have hh := store_load_other tgt st.memory m r.ptr s.ptr (encode tgt v)
                r.align (sizeof d.ty) s.align hm (Ne.symm (hsep c d r s hc hq hs hd))
              simp [State.read, hq, hd, hh]
    next => simp at h

/-- In the whole-cell model, disjoint byte ranges cannot share an allocation identity when
the written cell has a supported (therefore nonempty) scalar representation. -/
theorem rangesDisjoint_separated (tgt : Target) (st : State) (hw : st.WellFormed tgt)
    (p q : Place) (hd : st.RangesDisjoint p q)
    (ht : ∀ c, st.places p = some c → c.ty ≠ .unit) : st.Separated p q := by
  intro c d r s hc hq hcr hds he
  have hr := hw.projected p c hc
  have hs := hw.projected q d hq
  simp only [Cell.Projected, hcr] at hr
  simp only [Cell.Projected, hds] at hs
  obtain ⟨b, x, hpb, hbx, hrspace, hrbase, hrsize, _, hrfit⟩ := hr
  obtain ⟨b', y, hpb', hby, hsspace, hsbase, hssize, _⟩ := hs
  have hbb : b = b' := by rw [hpb, hpb'] at he; exact Option.some.inj he
  subst b'
  rw [hbx] at hby
  cases hby
  have hpos : 0 < sizeof c.ty := by
    have hct := ht c hc
    cases hc' : c.ty with
    | int t => cases t <;> decide
    | bool => decide
    | unit => exact False.elim (hct hc')
  rcases hd c d r s hc hq hcr hds with hempty | hempty | hspace | hbefore | hafter
  · omega
  · omega
  · exact hspace (hrspace.trans hsspace.symm)
  · omega
  · omega

/-- The requested byte-range frame law: a successful typed write leaves every other place's
read unchanged when its materialized interval is disjoint from the written place's interval. -/
theorem write_frame_disjoint (tgt : Target) (st st' : State) (hw : st.WellFormed tgt)
    (p q : Place) (v : Value) (hne : q ≠ p) (hd : st.RangesDisjoint p q)
    (h : st.write tgt p v = some st') : st'.read tgt q = st.read tgt q := by
  have ht : ∀ c, st.places p = some c → c.ty ≠ .unit := by
    intro c hc
    have hh := h
    simp only [State.write, hc] at hh
    dsimp at hh
    split at hh
    next hv => rw [← hv.1]; exact hv.2.2
    next => simp at hh
  exact write_frame tgt st st' p q v hne (rangesDisjoint_separated tgt st hw p q hd ht) h

/-- First materialization frames all other places; freshness supplies block separation, so no
additional separation premise is necessary. -/
theorem materialize_frame (tgt : Target) (st st' : State) (hw : st.WellFormed tgt)
    (p q : Place) (hne : q ≠ p) (space : AddrSpace) (base align : Nat)
    (padding : List MByte) (r : Range)
    (h : st.materialize tgt p space base align padding = some (r, st')) :
    st'.read tgt q = st.read tgt q := by
  rcases materialize_cases tgt st st' p space base align padding r h with reused | fresh
  · obtain ⟨_, _, _, rfl⟩ := reused; rfl
  · obtain ⟨c, v, b, m, m', _, _, _, _, ha, hm, rfl, rfl⟩ := fresh
    cases hq : st.places q with
    | none => simp [State.read, Ne.symm hne, hq]
    | some d =>
      cases hd : d.storage with
      | structured w => simp [State.read, Ne.symm hne, hq, hd]
      | materialized s =>
        have hproj := hw.projected q d hq
        simp only [Cell.Projected, hd] at hproj
        obtain ⟨old, x, hp, hx, _⟩ := hproj
        have hbo := alloc_ne_existing tgt _ hw.memory space base _ align b old m x ha hx
        have hload : m.load tgt s.ptr (sizeof d.ty) s.align =
            st.memory.load tgt s.ptr (sizeof d.ty) s.align := by
          apply load_congr
          intro old' hp'
          have he : old' = old := by rw [hp] at hp'; exact (Option.some.inj hp').symm
          subst old'
          obtain ⟨_, rfl, _⟩ := alloc_result tgt _ space base _ align b m ha
          simp [Memory.block, AList.lookup, hbo]
        have hstore := store_load_other tgt m m' ⟨space, base, some b⟩ s.ptr
          (encode tgt v ++ padding) align (sizeof d.ty) s.align hm
          (by simpa only [hp, ne_eq, Option.some.injEq] using Ne.symm hbo)
        simp [State.read, Ne.symm hne, hq, hd, hstore, hload]

/-- Exposure frames other places, including all byte decodes; it changes only reconstruction. -/
theorem expose_frame (tgt : Target) (st st' : State) (hw : st.WellFormed tgt)
    (p q : Place) (hne : q ≠ p) (space : AddrSpace) (base align : Nat)
    (padding : List MByte) (r : Range)
    (h : st.expose tgt p space base align padding = some (r, st')) :
    st'.read tgt q = st.read tgt q := by
  unfold State.expose at h
  cases hm : st.materialize tgt p space base align padding with
  | none => simp [hm] at h
  | some pair =>
    obtain ⟨r', mid⟩ := pair
    simp only [hm] at h
    dsimp at h
    cases he : mid.memory.expose r'.ptr with
    | none => simp [he] at h
    | some m =>
      simp [he] at h
      obtain ⟨rfl, rfl⟩ := h
      rw [← materialize_frame tgt st mid hw p q hne space base align padding r' hm]
      cases hq : mid.places q with
      | none => simp [State.read, hq]
      | some d =>
        cases hd : d.storage with
        | structured v => simp [State.read, hq, hd]
        | materialized s =>
          simp [State.read, hq, hd, expose_load tgt _ _ r'.ptr s.ptr (sizeof d.ty) s.align he]

/-- Materialization preserves the value read from a place, including its first allocation. -/
theorem materialize_read (tgt : Target) (st st' : State) (hw : st.memory.WellFormed tgt)
    (p : Place) (v : Value) (space : AddrSpace) (base align : Nat)
    (padding : List MByte) (r : Range) (hr : st.read tgt p = some v)
    (h : st.materialize tgt p space base align padding = some (r, st')) :
    st'.read tgt p = some v := by
  rcases materialize_cases tgt st st' p space base align padding r h with reused | fresh
  · obtain ⟨_, _, _, rfl⟩ := reused; exact hr
  · obtain ⟨c, w, b, m, m', hc, hs, ht, hv, ha, hm, rfl, rfl⟩ := fresh
    have hvw : w = v := by
      simpa [State.read, hc, hs, ht, hv] using hr
    subst w
    have ham := alloc_wellFormed tgt _ hw space base _ align b m ha
    have hl := store_load tgt m m' ham ⟨space, base, some b⟩ (encode tgt v ++ padding) align hm
    have hpos : 0 < sizeof v.ty := by
      cases v with
      | int t n => cases t <;> simp [Value.ty, CVal.ty, sizeof, intBytes, IntTy.bits]
      | bool b => simp [Value.ty, CVal.ty, sizeof]
      | unit => exact False.elim (hv.2 rfl)
    have hshort := load_prefix tgt m' ⟨space, base, some b⟩
      (encode tgt v ++ padding).length (sizeof v.ty) align (encode tgt v ++ padding)
      (by simp [encode_length]; omega) (by omega) (by simp) hl
    have htake : (encode tgt v ++ padding).take (sizeof v.ty) = encode tgt v := by
      rw [← encode_length tgt v]; simp
    rw [htake] at hshort
    simpa [State.read, hshort, ← ht, Rep] using (rep_roundtrip tgt v hv)

end ConcreteSpec.Core.Hybrid
import ConcreteSpec.Proofs.Slice1

/-!
# Part 7: `checked_observation`

PROPOSED: not normative until the owner freezes Core (ROADMAP A2c). See `ConcreteSpec/README.md`.
-/

namespace ConcreteSpec

/-- From a described environment, a checked body that exits exits with a `u8` code. -/
theorem runBody_exit_u8 {Δ : Decls} {Γ : Ctx} {ss : List Stmt} {r : Atom} (hb : BodyOk Δ Γ ss r) :
    ∀ {env : Env}, Corr Δ Γ env → ∀ n c, runBody Δ n env ss r = .exit c → c < 256 := by
  induction hb with
  | ret ht hu _ =>
    intro env hc n c h
    cases n with
    | zero => simp [runBody] at h
    | succ n =>
      simp only [runBody, retOutcome] at h
      cases hu with
      | atom hu =>
        obtain ⟨v, env', he, hv, _⟩ := evalAtom_safe hc (hasType_atom_scalar ht) hu
        cases hv with
        | int hr =>
          simp [he] at h
          subst h
          simp [IntTy.inRange, IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at hr
          omega
  | cons hs _ ih =>
    intro env hc n c h
    cases n with
    | zero => simp [runBody] at h
    | succ n =>
      simp only [runBody] at h
      rcases execStmt_safe hc hs with ⟨k, hk⟩ | ⟨env', he, hc'⟩
      · simp [hk] at h
      · simp only [he] at h; exact ih hc' n c h

end ConcreteSpec

namespace ConcreteSpec.Observe
open ConcreteSpec

/-- **What a checked program shows its parent.** With any fuel, the run of a checked slice-1
program either has not ended yet, or the parent observes an exit with the `u8` code `main`
returned, or a trap (status 134 and the trap's message). It is never stuck. -/
theorem checked_observation {p : Program} (h : Checked p) (n : Nat) :
    run p n = .outOfFuel ∨ (∃ c, c < 256 ∧ observe true (run p n) = some (.exited c)) ∨
      ∃ k, observe true (run p n) = some (.trapped k) := by
  cases ho : run p n with
  | outOfFuel => exact .inl rfl
  | exit c =>
    have hc : c < 256 := runBody_exit_u8 h.2 .nil n c ho
    exact .inr (.inl ⟨c, hc, by simp [observe]⟩)
  | trap k => exact .inr (.inr ⟨k, by simp [observe]⟩)
  | stuck w => exact absurd ho (checked_never_stuck h n w)

/-- With enough fuel (one unit per statement and one for `return`), a checked program's run ends,
and the parent observes a status below 256 that is the returned code, or 134 for a trap. -/
theorem checked_observable {p : Program} (h : Checked p) :
    ∃ obs, observe true (run p (p.body.length + 1)) = some obs ∧ obs.status < 256 := by
  rcases checked_observation h (p.body.length + 1) with hf | ⟨c, hc, ho⟩ | ⟨k, ho⟩
  · exact absurd hf (runBody_enough p.body [])
  · exact ⟨_, ho, hc⟩
  · exact ⟨_, ho, by simp [Observation.status]⟩

/-- A refused start never runs `main`: the observation does not depend on the run. -/
theorem refused_start (o : Outcome) : observe false o = some .startupRefused := rfl

end ConcreteSpec.Observe

