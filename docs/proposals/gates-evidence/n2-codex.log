+    ¬ ExternResult.Valid (⟨0, 1, 7⟩ : KeptPair Nat Nat) 0 (.receipt 8) := by
+  constructor <;> intro h
+  · have hr := h.2.2.1
+    cases hr
+  · have hh := h.2
+    cases hh
