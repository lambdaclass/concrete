+  Expr := Nat
+  Ty := Unit
+  Store := Unit
+  Prim := Unit
+  Event := Unit
+  unitVal := 0
+  unitTy := ()
+  isCopy := fun _ => true
+  eval := fun _ _ n => .ok (n, ())
+  life := fun _ st => some st
+  test := fun n => some (n != 0)
+  allows := fun _ _ _ _ => false
