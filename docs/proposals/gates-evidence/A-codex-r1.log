diff --git a/scripts/checks/compiler/spec_diff.lean b/scripts/checks/compiler/spec_diff.lean
new file mode 100644
index 00000000..d6aaca4b
--- /dev/null
+++ b/scripts/checks/compiler/spec_diff.lean
@@ -0,0 +1,374 @@
+import Concrete
+
+/-!
+Seeded spec/compiler differential driver (`scripts/checks/compiler/spec_diff.sh`). Generators live
+in the existing Concrete library as flat `Concrete/SpecDiff*.lean` modules; no lake library, new
+folder, or root entry is added.
+Normal commands accept no mutation option. Planted defects require the explicit `control-emit`
+command, `--mutate`, and `--control SPEC_DIFF_PLANTED_CONTROL`.
+-/
+
+open Concrete.BIR Concrete.Backend
+open ConcreteSpec (Trap)
+open LeanCompilerBackend (Width)
+open LeanCompilerBackend.Verified
+
+namespace ConcreteSpecDiff
+
+/-- Same expectation bytes and backend artifacts as slice0_bir.lean; the script module itself is
+not on Lake's import path, so its small IO adapter is mirrored here over the same backend calls. -/
+def writeExpected (dir : System.FilePath) (status : String) (stderr : String) : IO Unit := do
+  IO.FS.writeFile (dir / "status") (status ++ "\n")
+  IO.FS.writeFile (dir / "stderr") stderr
+
+def writeLcb (dir : System.FilePath) (target : LCB.Target)
+    (emitted : Source.Function × SiteTable) : IO Bool := do
+  let (f, sites) := emitted
+  IO.FS.createDirAll dir
+  IO.FS.writeFile (dir / "lcb_source.txt") (reprStr f ++ "\n")
+  let job : FunctionJob :=
+    { code := { symbol := LCB.bodySymbol, body := f, abi := planAbi f, layout := planFrame f } }
+  IO.FS.writeFile (dir / "lcb_job.txt") (reprStr job ++ "\n")
+  if let .error msg := LCB.assemble .aarch64Macos f then
+    IO.eprintln s!"{dir}: LCB first path: {msg}"; return false
+  match LCB.assemble target f with
+  | .error msg => IO.eprintln s!"{dir}: LCB: {msg}"; return false
+  | .ok asm =>
+    IO.FS.writeFile (dir / "lcb_body.s") asm
+    IO.FS.writeFile (dir / "lcb_rt.ssa") (Runtime.qbe sites)
+    IO.FS.writeFile (dir / "lcb_body.ssa") (LCB.render f)
+    return true
+
+def writeBackends (dir : System.FilePath) (target : LCB.Target) (p : Program)
+    (emitted : Source.Function × SiteTable) : IO Bool := do
+  IO.FS.createDirAll dir
+  IO.FS.writeFile (dir / "bir.txt") (reprStr p ++ "\n")
+  IO.FS.writeFile (dir / "llvm.ll") (LLVM.module p)
+  writeLcb dir target emitted
+
+def unwiredMessage := "no Core→BIR lowering yet (slice 1)"
+
+/-- THE integration point for the lowering branch. Its implementation must lower the spec's Core
+program to BIR; until that branch lands, the spec leg runs its generator/oracle invariants but has
+no compiled programs and never claims a spec/native comparison. -/
+def compileCore (_ : ConcreteSpec.Program) : Except String Program :=
+  .error unwiredMessage
+
+inductive Mutation where
+  | none | dropOverflowLLVM | lcbOffByOne
+  deriving DecidableEq, Repr
+
+def mutationOfName : String → Option Mutation
+  | "drop-overflow-llvm" => some .dropOverflowLLVM
+  | "lcb-off-by-one" => some .lcbOffByOne
+  | _ => none
+
+/-- Replace every overflow-flag extraction by constant false. The wrapped value and control-flow
+shape remain, so a trapping generated program exits through its non-trap arm instead. -/
+def dropOverflowLLVM (text : String) : String :=
+  let lines := text.splitOn "\n"
+  String.intercalate "\n" <| lines.map fun line =>
+    match line.splitOn " = extractvalue " with
+    | [lhs, _] => if line.endsWith ", 1" then lhs ++ " = xor i1 0, 0" else line
+    | _ => line
+
+/-- Add one to every adapted body return. This is used only by the explicit off-by-one control,
+whose generated program exits; both assembly and the in-process evaluator consume this same value. -/
+def lcbOffByOne (f : Source.Function) : Source.Function :=
+  let (blocks, _, widths) := f.blocks.foldl
+    (fun (acc : Array Source.Block × Nat × Array Width) b =>
+      let (blocks, next, widths) := acc
+      match b.terminator with
+      | .ret a =>
+        let ins := LCB.ins next (.binary .add a (.literal (LCB.word 1)))
+        (blocks.push { b with instructions := b.instructions.push ins,
+                              terminator := .ret (.local next) },
+         next + 1, widths.push .word)
+      | _ => (blocks.push b, next, widths))
+    (#[], f.valueWidths.size, f.valueWidths)
+  { f with blocks := blocks, valueWidths := widths }
+
+def safeSeed (seed : String) : String :=
+  let cleaned := seed.toList.map fun c => if c.isAlphanum || c = '_' then c else '_'
+  let result := String.ofList cleaned
+  if result.isEmpty then "seed" else result
+
+def regressionName (seed : String) (index : Nat) : String :=
+  s!"regression_{safeSeed seed}_{index}"
+
+def trapKindName : Trap → String
+  | .arithmeticOverflow => "arithmeticOverflow"
+
+def outcomeName : Outcome → String
+  | .exited _ => "exit"
+  | .trapped _ => "trap"
+  | .stuck => "stuck"
+  | .outOfFuel => "out_of_fuel"
+
+def writeObservation (dir : System.FilePath) (status : String) (stderr : String) : IO Unit := do
+  IO.FS.createDirAll dir
+  writeExpected dir status stderr
+  IO.FS.writeFile (dir / "stdout") ""
+
+def writeOutcome (dir : System.FilePath) (outcome : Outcome) (sites : SiteTable) : IO Bool := do
+  match outcome with
+  | .exited c => writeObservation dir (toString c) ""; return true
+  | .trapped s => match sites[s]? with
+    | some e => writeObservation dir "134" (Runtime.trapLine e ++ "\n"); return true
+    | none => IO.eprintln s!"{dir}: no trap site {s}"; return false
+  | _ => IO.eprintln s!"{dir}: outcome {repr outcome} has no final observation"; return false
+
+def evaluatorObservation (f : Source.Function) (sites : SiteTable) : String × String :=
+  match LCB.evalBody f 100000 with
+  | none => ("incomplete", "")
+  | some w =>
+    if w < 256 then (toString w, "") else
+      match sites[w - 256]? with
+      | some e => ("134", Runtime.trapLine e ++ "\n")
+      | none => ("134", Runtime.invalidLine ++ "\n")
+
+def writeEvaluator (dir : System.FilePath) (f : Source.Function) (sites : SiteTable) : IO Unit := do
+  let (status, stderr) := evaluatorObservation f sites
+  IO.FS.writeFile (dir / "lcb_eval.status") (status ++ "\n")
+  IO.FS.writeFile (dir / "lcb_eval.stderr") stderr
+  IO.FS.writeFile (dir / "lcb_eval.stdout") ""
+
+def writeRegressionMetadata (dir : System.FilePath) (name : String) (outcome : Outcome)
+    (sites : SiteTable) : IO Unit := do
+  let expectation ← match outcome with
+    | .exited c => pure s!"exit {c}"
+    | .trapped s => match sites[s]? with
+      | some e => pure s!"trap {trapKindName e.kind} site {s}"
+      | none => pure "INVALID"
+    | _ => pure "INVALID"
+  IO.FS.writeFile (dir / "manifest-row.txt")
+    s!"{name}\tbir:{name}\t{expectation}\tslice0\n"
+  IO.FS.writeFile (dir / "regression-name.txt") (name ++ "\n")
+
+/-- Emit exactly the files consumed by slice0_native.sh, plus the evaluator's observation and the
+same judge inputs as the manifest runner. The expectation is supplied separately for the spec leg. -/
+def emitArtifacts (dir : System.FilePath) (target : LCB.Target) (p : Program) (mutation : Mutation) :
+    IO Bool := do
+  unless wf p do IO.eprintln s!"{dir}: generated BIR is not well formed"; return false
+  match LCB.emit p with
+  | .error msg => IO.eprintln s!"{dir}: adapter: {msg}"; return false
+  | .ok (f, sites) =>
+    let f := if mutation = .lcbOffByOne then lcbOffByOne f else f
+    unless ← writeBackends dir target p (f, sites) do return false
+    if mutation = .dropOverflowLLVM then
+      let original ← IO.FS.readFile (dir / "llvm.ll")
+      let changed := dropOverflowLLVM original
+      if changed = original then IO.eprintln s!"{dir}: drop-overflow-llvm changed nothing"; return false
+      IO.FS.writeFile (dir / "llvm.ll") changed
+    writeEvaluator dir f sites
+    return true
+
+def emitBirCandidate (seed : String) (index : Nat) (dir : System.FilePath) (target : LCB.Target)
+    (mutation : Mutation) : IO UInt32 := do
+  let g := BirGen.generate seed index
+  unless wf g.program do
+    IO.eprintln s!"seed {seed} index {index}: rejected: generated BIR is not well formed"
+    return 4
+  match LCB.emit g.program with
+  | .error msg => IO.eprintln s!"seed {seed} index {index}: rejected: {msg}"; return 4
+  | .ok _ =>
+    let outcome := run g.program 1000
+    unless outcome.final && outcome != .stuck do
+      IO.eprintln s!"seed {seed} index {index}: non-final/stuck outcome {repr outcome}"
+      return 1
+    unless ← emitArtifacts dir target g.program mutation do return 1
+    unless ← writeOutcome dir outcome g.program.sites do return 1
+    IO.FS.writeFile (dir / "program.lean.txt") (reprStr g.program ++ "\n")
+    IO.FS.writeFile (dir / "constructs.txt") (String.intercalate "," g.constructs ++ "\n")
+    writeRegressionMetadata dir (regressionName seed index) outcome g.program.sites
+    IO.println s!"seed {seed} index {index}: {outcomeName outcome} {BirGen.Production.name g.production}"
+    return 0
+
+abbrev Counts := List (String × Nat)
+
+def bump (key : String) : Counts → Counts
+  | [] => [(key, 1)]
+  | (k, n) :: rest => if k = key then (k, n + 1) :: rest else (k, n) :: bump key rest
+
+def addConstructs (counts : Counts) (xs : List String) : Counts :=
+  xs.foldl (fun acc x => bump x acc) counts
+
+def countsLines (kind : String) (counts : Counts) : String :=
+  String.join <| counts.map fun (name, n) => s!"{kind}\t{name}\t{n}\n"
+
+/-- Generate and filter N independent BIR candidates. Rejections are data and are counted; the
+shell gate imposes its stated yield floor and coverage/vacuity requirements. -/
+def genBir (seed : String) (n : Nat) (dir : System.FilePath) (target : LCB.Target) : IO UInt32 := do
+  IO.FS.createDirAll dir
+  let mut programs := ""
+  let mut rejects := ""
+  let mut constructs : Counts := []
+  let mut accepted := 0
+  let mut rejected := 0
+  let mut exits := 0
+  let mut traps := 0
+  for index in List.range n do
+    let g := BirGen.generate seed index
+    if !wf g.program then
+      rejected := rejected + 1
+      rejects := rejects ++ s!"reject\t{index}\tnot well formed\n"
+    else match LCB.emit g.program with
+      | .error msg =>
+        rejected := rejected + 1
+        rejects := rejects ++ s!"reject\t{index}\t{msg}\n"
+      | .ok _ =>
+        let outcome := run g.program 1000
+        if !outcome.final || outcome == .stuck then
+          IO.eprintln s!"seed {seed} index {index}: generated outcome {repr outcome}"
+          return 1
+        let child := dir / s!"p{index}"
+        unless ← emitArtifacts child target g.program .none do return 1
+        unless ← writeOutcome child outcome g.program.sites do return 1
+        IO.FS.writeFile (child / "program.lean.txt") (reprStr g.program ++ "\n")
+        IO.FS.writeFile (child / "constructs.txt") (String.intercalate "," g.constructs ++ "\n")
+        writeRegressionMetadata child (regressionName seed index) outcome g.program.sites
+        accepted := accepted + 1
+        constructs := addConstructs constructs g.constructs
+        if outcomeName outcome = "exit" then exits := exits + 1 else traps := traps + 1
+        programs := programs ++
+          s!"program\t{index}\t{outcomeName outcome}\t{BirGen.Production.name g.production}\n"
+    IO.FS.writeFile (dir / "summary.tsv")
+      (s!"seed\t{seed}\naccepted\t{accepted}\nrejected\t{rejected}\nattempted\t{n}\n" ++
+       s!"outcome\texit\t{exits}\noutcome\ttrap\t{traps}\n" ++
+       countsLines "construct" constructs ++ programs ++ rejects)
+  IO.println s!"bir leg: {accepted} accepted, {rejected} rejected, exits {exits}, traps {traps}"
+  IO.print <| countsLines "construct" constructs
+  return 0
+
+def specOutcome (q : ConcreteSpec.Slice0.Program) : ConcreteSpec.Outcome :=
+  ConcreteSpec.run (ConcreteSpec.Slice0.toCore q) (q.body.length + 1)
+
+/-- The spec outcome alone supplies the status and trap kind. Slice 0 is exit-only. For a future
+trapping fragment, the lowering's site table supplies the line at its first site of that kind. -/
+def writeSpecOutcome (dir : System.FilePath) (p : Program) (o : ConcreteSpec.Outcome) : IO Bool := do
+  match o with
+  | .exit c => writeObservation dir (toString c) ""; return true
+  | .trap k => match p.sites.find? (fun e => e.kind = k) with
+    | some e => writeObservation dir "134" (Runtime.trapLine e ++ "\n"); return true
+    | none => IO.eprintln s!"{dir}: spec trap {repr k} has no lowered site"; return false
+  | _ => IO.eprintln s!"{dir}: spec outcome {repr o} has no observation"; return false
+
+def specOutcomeName : ConcreteSpec.Outcome → String
+  | .exit _ => "exit" | .trap _ => "trap" | .stuck _ => "stuck" | .outOfFuel => "out_of_fuel"
+
+/-- Generate accepted slice-0 Core programs, run the spec oracle, and offer each to compileCore.
+While the fixed hook is unwired, only its exact refusal is non-fatal and no native-ready directory
+is produced. -/
+def genSpec (seed : String) (n : Nat) (dir : System.FilePath) (target : LCB.Target) : IO UInt32 := do
+  IO.FS.createDirAll dir
+  let mut programs := ""
+  let mut rejects := ""
+  let mut constructs : Counts := []
+  let mut accepted := 0
+  let mut rejected := 0
+  let mut compiled := 0
+  let mut exits := 0
+  let mut traps := 0
+  for index in List.range n do
+    let g := SpecGen.generate seed index
+    let core := ConcreteSpec.Slice0.toCore g.program
+    if !ConcreteSpec.check core then
+      rejected := rejected + 1
+      rejects := rejects ++ s!"reject\t{index}\tspec check\n"
+    else
+      let outcome := specOutcome g.program
+      match outcome with
+      | .exit c =>
+        unless c < 256 do IO.eprintln s!"seed {seed} index {index}: invalid spec exit {c}"; return 1
+        accepted := accepted + 1
+        exits := exits + 1
+        constructs := addConstructs constructs g.constructs
+        let child := dir / s!"p{index}"
+        IO.FS.createDirAll child
+        IO.FS.writeFile (child / "program.lean.txt") (reprStr g.program ++ "\n")
+        IO.FS.writeFile (child / "constructs.txt") (String.intercalate "," g.constructs ++ "\n")
+        IO.FS.writeFile (child / "oracle.txt") s!"exit {c}\n"
+        let mut didCompile := false
+        match compileCore core with
+        | .error msg =>
+          if msg != unwiredMessage then
+            IO.eprintln s!"seed {seed} index {index}: compileCore: {msg}"
+            return 1
+        | .ok bir =>
+          unless ← emitArtifacts child target bir .none do return 1
+          unless ← writeSpecOutcome child bir outcome do return 1
+          IO.FS.writeFile (child / "native-ready") ""
+          writeRegressionMetadata child (regressionName seed index) (.exited c) bir.sites
+          compiled := compiled + 1
+          didCompile := true
+        programs := programs ++
+          s!"program\t{index}\texit\t{if didCompile then "true" else "false"}\n"
+      | .trap _ =>
+        accepted := accepted + 1
+        traps := traps + 1
+        IO.eprintln s!"seed {seed} index {index}: accepted slice-0 program trapped"
+        return 1
+      | _ =>
+        IO.eprintln s!"seed {seed} index {index}: spec oracle gives {repr outcome}"
+        return 1
+    IO.FS.writeFile (dir / "summary.tsv")
+      (s!"seed\t{seed}\naccepted\t{accepted}\nrejected\t{rejected}\nattempted\t{n}\ncompiled\t{compiled}\n" ++
+       s!"outcome\texit\t{exits}\noutcome\ttrap\t{traps}\n" ++
+       countsLines "construct" constructs ++ programs ++ rejects)
+  IO.FS.writeFile (dir / "summary.tsv")
+    (s!"seed\t{seed}\naccepted\t{accepted}\nrejected\t{rejected}\nattempted\t{n}\ncompiled\t{compiled}\n" ++
+     s!"outcome\texit\t{exits}\noutcome\ttrap\t{traps}\n" ++
+     countsLines "construct" constructs ++ programs ++ rejects)
+  IO.println s!"spec leg: {accepted} accepted, {rejected} rejected, exits {exits}, traps {traps}"
+  IO.print <| countsLines "construct" constructs
+  if compiled = 0 then
+    IO.println "spec leg: 0 programs compiled (no Core→BIR lowering; becomes required in the lowering branch)"
+  else
+    IO.println s!"spec leg: {compiled} programs compiled for native comparison"
+  return 0
+
+/-- Stand-in compiled output for the spec-oracle control: Slice0.answer and BIR answer both exit 42,
+but the judge receives a planted expected 43. -/
+def controlSpecOracle (dir : System.FilePath) (target : LCB.Target) : IO UInt32 := do
+  let q := ConcreteSpec.Slice0.answer
+  let p := Concrete.BIR.Examples.answer
+  unless ← emitArtifacts dir target p .none do return 1
+  unless ← writeSpecOutcome (dir / "spec-expected") p (specOutcome q) do return 1
+  writeObservation (dir / "wrong-expected") "43" ""
+  IO.println "control spec-oracle: spec exits 42; planted expectation exits 43"
+  return 0
+
+def withTarget (name : String) (k : LCB.Target → IO UInt32) : IO UInt32 :=
+  match LCB.Target.ofName name with
+  | some t => k t
+  | none => do IO.eprintln s!"unknown target {name}"; return 2
+
+def parseNat (value : String) : Option Nat := value.toNat?
+
+end ConcreteSpecDiff
+
+open ConcreteSpecDiff
+
+def main (args : List String) : IO UInt32 := do
+  match args with
+  | ["gen-spec", seed, n, dir] => match parseNat n with
+    | some n => do
+      let target := (← IO.getEnv "SPEC_DIFF_TARGET").getD "x86_64-linux"
+      withTarget target (genSpec seed n dir)
+    | none => return 2
+  | ["gen-bir", seed, n, dir, target] => match parseNat n with
+    | some n => withTarget target (genBir seed n dir)
+    | none => return 2
+  | ["replay", seed, index, dir, target] => match parseNat index with
+    | some index => withTarget target (fun t => emitBirCandidate seed index dir t .none)
+    | none => return 2
+  | ["control-emit", "--mutate", mutation, seed, index, dir, target,
+      "--control", "SPEC_DIFF_PLANTED_CONTROL"] => match mutationOfName mutation, parseNat index with
+    | some mutation, some index =>
+      withTarget target (fun t => emitBirCandidate seed index dir t mutation)
+    | _, _ => return 2
+  | ["control-spec-oracle", dir, target, "--control", "SPEC_DIFF_PLANTED_CONTROL"] =>
+    withTarget target (controlSpecOracle dir)
+  | _ =>
+    IO.eprintln "usage: spec_diff.lean gen-spec SEED N DIR | gen-bir SEED N DIR TARGET | replay SEED INDEX DIR TARGET | control-emit --mutate NAME SEED INDEX DIR TARGET --control SPEC_DIFF_PLANTED_CONTROL | control-spec-oracle DIR TARGET --control SPEC_DIFF_PLANTED_CONTROL"
+    return 2
diff --git a/scripts/checks/compiler/spec_diff.sh b/scripts/checks/compiler/spec_diff.sh
new file mode 100755
index 00000000..557eecd5
--- /dev/null
+++ b/scripts/checks/compiler/spec_diff.sh
@@ -0,0 +1,300 @@
+#!/usr/bin/env bash
+# Seeded spec/compiler differential (Concrete/README.md gates 5 and 6). Run from the repo root in
+# nix develop. The seed is SPEC_DIFF_SEED or the commit SHA. SPEC_DIFF_SECS (default 600) bounds
+# the shared build, generation, controls and native comparisons; SPEC_DIFF_N (default
+# 300) is the candidate count per leg, and SPEC_DIFF_MIN_JUDGED (default 8) is the minimum number of
+# BIR programs compared on all three legs. Too few comparisons by the deadline is INCOMPLETE (3),
+# never a pass. Both generators require at least 50% accepted candidates. All native executables
+# use the shared build/observe/judge functions; the in-process LCB observation uses the same judge.
+#
+# Replay one BIR candidate, without coverage or minimum-count checks:
+#   SPEC_DIFF_REPLAY='SEED:INDEX' bash scripts/checks/compiler/spec_diff.sh
+# On a mismatch the gate prints the seed/index, generated term, exact manifest row, Examples
+# definition/list entry, and this replay command. To save the regression: put the printed definition
+# in Concrete.BIR.Examples, put its tuple in Examples.all, add the row to tests/manifest.tsv, then
+# replay the seed:index and run the manifest Tests job. No generated output is committed directly.
+#
+# Planted controls must fail for their stated reason. Mutations exist only in the Lean driver's
+# explicit control-emit command and require --control SPEC_DIFF_PLANTED_CONTROL; normal commands
+# reject them. A control that builds incorrectly or fails without its expected FAIL line is a gate
+# failure. Determinism controls compare program.lean.txt fingerprints, not native artifacts.
+set -euo pipefail
+
+seed=${SPEC_DIFF_SEED:-$(git rev-parse HEAD)}
+candidate_count=${SPEC_DIFF_N:-300}
+budget=${SPEC_DIFF_SECS:-600}
+minimum_judged=${SPEC_DIFF_MIN_JUDGED:-8}
+replay=${SPEC_DIFF_REPLAY:-}
+for value in "$candidate_count" "$budget" "$minimum_judged"; do
+  [[ "$value" =~ ^[0-9]+$ ]] && [ "$value" -gt 0 ] ||
+    { echo "spec_diff: N, SECS and MIN_JUDGED must be positive integers" >&2; exit 2; }
+done
+printf 'spec_diff seed: %s\n' "$seed"
+printf 'replay: SPEC_DIFF_REPLAY=%s:INDEX bash scripts/checks/compiler/spec_diff.sh\n' "$seed"
+start=$(date +%s)
+deadline=$((start + budget))
+remaining() { echo $((deadline - $(date +%s))); }
+export SLICE0_BUILD_SECS=$budget
+
+# shellcheck source=scripts/checks/lib/slice0_common.sh
+source scripts/checks/lib/slice0_common.sh
+driver=(env "SPEC_DIFF_TARGET=$target" lake env lean --run scripts/checks/compiler/spec_diff.lean)
+fail=0
+bir_judged=0
+spec_judged=0
+
+summary_value() { # summary_value FILE KEY [FIELD]
+  awk -F '\t' -v key="$2" -v field="${3:-2}" '$1 == key {print $field; exit}' "$1"
+}
+
+print_counts() { # print_counts LABEL SUMMARY
+  echo "$1 outcome/construct counts:"
+  awk -F '\t' '$1 == "outcome" || $1 == "construct" {printf "  %s %s %s\n", $1, $2, $3}' "$2"
+  printf '  accepted %s, rejected %s, attempted %s\n' \
+    "$(summary_value "$2" accepted)" "$(summary_value "$2" rejected)" "$(summary_value "$2" attempted)"
+}
+
+check_generation() { # check_generation LABEL SUMMARY REQUIRED-CONSTRUCTS...
+  local label=$1 summary=$2 accepted rejected attempted
+  shift 2
+  accepted=$(summary_value "$summary" accepted)
+  rejected=$(summary_value "$summary" rejected)
+  attempted=$(summary_value "$summary" attempted)
+  [ -n "$accepted" ] && [ -n "$rejected" ] && [ -n "$attempted" ] ||
+    { echo "FAIL $label: missing generation counts" >&2; fail=1; return; }
+  if [ "$accepted" -eq 0 ] || [ $((accepted * 2)) -lt "$attempted" ]; then
+    echo "FAIL $label: yield $accepted/$attempted is below the 50% floor" >&2
+    fail=1
+  fi
+  local construct count
+  for construct in "$@"; do
+    count=$(awk -F '\t' -v c="$construct" '$1 == "construct" && $2 == c {print $3}' "$summary")
+    if [ -z "$count" ] || [ "$count" -eq 0 ]; then
+      echo "FAIL $label: construct $construct has zero coverage" >&2
+      fail=1
+    fi
+  done
+}
+
+report_mismatch() { # report_mismatch LEG INDEX DIR BACKEND
+  local leg=$1 index=$2 d=$3 backend=$4 name term
+  echo "FAIL $leg seed $seed index $index [$backend]: observation mismatch" >&2
+  echo "  expected status $(cat "$d/status"), observed $(cat "$d/$backend.status")" >&2
+  echo "  expected stderr bytes $(wc -c <"$d/stderr"), observed $(wc -c <"$d/$backend.stderr"), stdout $(wc -c <"$d/$backend.stdout")" >&2
+  echo "  generated program (program.lean.txt):" >&2
+  cat "$d/program.lean.txt" >&2
+  if [ "$leg" = spec ]; then term="$d/bir.txt"; else term="$d/program.lean.txt"; fi
+  if [ -f "$d/regression-name.txt" ]; then
+    name=$(cat "$d/regression-name.txt")
+    echo "  add exactly this tests/manifest.tsv row (tab-separated):" >&2
+    cat "$d/manifest-row.txt" >&2
+    echo "  add to Concrete.BIR.Examples:" >&2
+    printf 'def %s : Concrete.BIR.Program :=\n' "$name" >&2
+    cat "$term" >&2
+    printf '\n-- and add to Examples.all:\n("%s", %s),\n' "$name" "$name" >&2
+  fi
+  echo "  replay: SPEC_DIFF_REPLAY='$seed:$index' bash scripts/checks/compiler/spec_diff.sh" >&2
+}
+
+native_one() { # native_one LEG INDEX DIR: return 1 after reporting any observation mismatch
+  local leg=$1 index=$2 d=$3 name=$1-$2 backend bad=0 secs
+  build "$name" "$d/build.log" bounded "$(remaining)" bash "$root/scripts/checks/lib/slice0_native.sh" "$d" "$lcb"
+  for backend in llvm lcb; do
+    secs=$(remaining); [ "$secs" -gt 10 ] && secs=10
+    [ "$secs" -gt 0 ] || { echo "spec_diff: deadline before $name [$backend]" >&2; return 2; }
+    observe "$d/$backend.exe" "$d/$backend" "$secs" "$secs"
+    if judge "$d" "$d/$backend"; then
+      echo "ok   $name [$backend]: status $(cat "$d/$backend.status")"
+    else
+      report_mismatch "$leg" "$index" "$d" "$backend"
+      bad=1
+    fi
+  done
+  if judge "$d" "$d/lcb_eval"; then
+    echo "ok   $name [lcb-eval]: status $(cat "$d/lcb_eval.status")"
+  else
+    report_mismatch "$leg" "$index" "$d" lcb_eval
+    bad=1
+  fi
+  return "$bad"
+}
+
+run_control() { # run_control LABEL EXPECTED-FAIL-LINE FUNCTION: an expected failure is a pass
+  local label=$1 expected=$2 fn=$3 log="$work/ctl-$label.log" rc=0
+  ( "$fn" ) >"$log" 2>&1 || rc=$?
+  if [ "$rc" -ne 0 ] && grep -qF "$expected" "$log"; then
+    echo "ok   control $label: failed for the planted reason"
+  else
+    echo "FAIL control $label: did not fail as '$expected' (rc $rc)" >&2
+    cat "$log" >&2
+    fail=1
+  fi
+}
+
+first_outcome_index() { # first_outcome_index SUMMARY exit|trap
+  awk -F '\t' -v outcome="$2" '$1 == "program" && $3 == outcome {print $2; exit}' "$1"
+}
+
+control_drop_overflow() {
+  local index d="$work/control-drop-overflow"
+  index=$(first_outcome_index "$work/bir/summary.tsv" trap)
+  [ -n "$index" ] || { echo "control setup: no generated trap" >&2; return 0; }
+  bounded 120 "${driver[@]}" control-emit --mutate drop-overflow-llvm "$seed" "$index" "$d" "$target" \
+    --control SPEC_DIFF_PLANTED_CONTROL
+  build control-drop-overflow "$d/build.log" bounded 300 bash "$root/scripts/checks/lib/slice0_native.sh" "$d" "$lcb"
+  observe "$d/llvm.exe" "$d/llvm" 10 20
+  if judge "$d" "$d/llvm"; then
+    echo "control setup: drop-overflow-llvm did not change the observation" >&2
+    return 0
+  fi
+  echo "FAIL drop-overflow-llvm: planted LLVM overflow removal changed status/stderr"
+  return 1
+}
+
+control_lcb_off_by_one() {
+  local index d="$work/control-lcb-off-by-one" native_bad=1 eval_bad=1
+  index=$(first_outcome_index "$work/bir/summary.tsv" exit)
+  [ -n "$index" ] || { echo "control setup: no generated exit" >&2; return 0; }
+  bounded 120 "${driver[@]}" control-emit --mutate lcb-off-by-one "$seed" "$index" "$d" "$target" \
+    --control SPEC_DIFF_PLANTED_CONTROL
+  build control-lcb-off-by-one "$d/build.log" bounded 300 bash "$root/scripts/checks/lib/slice0_native.sh" "$d" "$lcb"
+  observe "$d/lcb.exe" "$d/lcb" 10 20
+  judge "$d" "$d/lcb" && native_bad=0
+  judge "$d" "$d/lcb_eval" && eval_bad=0
+  if [ "$native_bad" -eq 1 ] && [ "$eval_bad" -eq 1 ]; then
+    echo "FAIL lcb-off-by-one: native LCB and in-process evaluator both changed exit status"
+    return 1
+  fi
+  echo "control setup: off-by-one escaped native=$native_bad evaluator=$eval_bad (1 means caught)" >&2
+  return 0
+}
+
+control_spec_oracle() {
+  local d="$work/control-spec-oracle"
+  bounded 120 "${driver[@]}" control-spec-oracle "$d" "$target" --control SPEC_DIFF_PLANTED_CONTROL
+  build control-spec-oracle "$d/build.log" bounded 300 bash "$root/scripts/checks/lib/slice0_native.sh" "$d" "$lcb"
+  observe "$d/llvm.exe" "$d/llvm" 10 20
+  if ! judge "$d/spec-expected" "$d/llvm"; then
+    echo "control setup: stand-in does not match the spec's actual outcome" >&2
+    return 0
+  fi
+  if judge "$d/wrong-expected" "$d/llvm"; then
+    echo "control setup: judge accepted planted expected exit 43" >&2
+    return 0
+  fi
+  echo "FAIL spec-oracle: judge rejected planted exit 43 against spec exit 42"
+  return 1
+}
+
+term_fingerprint() { # term_fingerprint DIRECTORY OUTPUT: paths and exact bytes of every Lean term
+  local d=$1 out=$2 list="$work/fingerprint-list"
+  (cd "$d" && find . -type f -name program.lean.txt -print | LC_ALL=C sort) >"$list"
+  : >"$out"
+  while IFS= read -r path; do
+    printf '%s\n' "$path" >>"$out"
+    cat "$d/$path" >>"$out"
+  done <"$list"
+}
+
+control_determinism() {
+  local leg seed_a="$work/determinism-a" seed_b="$work/determinism-b" seed_c="$work/determinism-c"
+  for leg in spec bir; do
+    rm -rf "$seed_a" "$seed_b" "$seed_c"
+    if [ "$leg" = spec ]; then
+      bounded 120 "${driver[@]}" gen-spec determinism-seed 16 "$seed_a"
+      bounded 120 "${driver[@]}" gen-spec determinism-seed 16 "$seed_b"
+      bounded 120 "${driver[@]}" gen-spec determinism-other 16 "$seed_c"
+    else
+      bounded 120 "${driver[@]}" gen-bir determinism-seed 16 "$seed_a" "$target"
+      bounded 120 "${driver[@]}" gen-bir determinism-seed 16 "$seed_b" "$target"
+      bounded 120 "${driver[@]}" gen-bir determinism-other 16 "$seed_c" "$target"
+    fi
+    term_fingerprint "$seed_a" "$work/$leg-a.terms"
+    term_fingerprint "$seed_b" "$work/$leg-b.terms"
+    term_fingerprint "$seed_c" "$work/$leg-c.terms"
+    if ! cmp -s "$work/$leg-a.terms" "$work/$leg-b.terms"; then
+      echo "FAIL determinism $leg: identical seeds produced different terms" >&2; fail=1
+    elif cmp -s "$work/$leg-a.terms" "$work/$leg-c.terms"; then
+      echo "FAIL determinism $leg: different seeds produced identical terms" >&2; fail=1
+    else
+      echo "ok   control determinism $leg: same seed identical, different seed distinct"
+    fi
+  done
+}
+
+if [ -n "$replay" ]; then
+  case "$replay" in
+    *:*) replay_seed=${replay%%:*}; replay_index=${replay#*:} ;;
+    *) echo "spec_diff: SPEC_DIFF_REPLAY must be SEED:INDEX" >&2; exit 2 ;;
+  esac
+  [[ "$replay_index" =~ ^[0-9]+$ ]] || { echo "spec_diff: replay index is not a natural" >&2; exit 2; }
+  d="$work/replay"
+  bounded "$(remaining)" "${driver[@]}" replay "$replay_seed" "$replay_index" "$d" "$target"
+  native_one bir "$replay_index" "$d" || fail=1
+  bir_judged=1
+  echo "spec_diff replay: $replay_seed:$replay_index judged on LLVM, LCB and LCB evaluator"
+  exit "$fail"
+fi
+
+left=$(remaining)
+[ "$left" -gt 0 ] || { echo "INCOMPLETE: no time for spec generation" >&2; exit 3; }
+bounded "$left" "${driver[@]}" gen-spec "$seed" "$candidate_count" "$work/spec"
+left=$(remaining)
+[ "$left" -gt 0 ] || { echo "INCOMPLETE: no time for BIR generation" >&2; exit 3; }
+bounded "$left" "${driver[@]}" gen-bir "$seed" "$candidate_count" "$work/bir" "$target"
+print_counts "spec leg" "$work/spec/summary.tsv"
+print_counts "BIR leg" "$work/bir/summary.tsv"
+check_generation "spec leg" "$work/spec/summary.tsv" \
+  let_literal let_copy add_literal add_variable return_literal return_variable
+check_generation "BIR leg" "$work/bir/summary.tsv" checked wrapped widening two_sites chain
+for outcome in exit trap; do
+  count=$(awk -F '\t' -v o="$outcome" '$1 == "outcome" && $2 == o {print $3}' "$work/bir/summary.tsv")
+  if [ -z "$count" ] || [ "$count" -eq 0 ]; then
+    echo "FAIL BIR leg: vacuity guard: zero ${outcome}s" >&2
+    fail=1
+  fi
+done
+
+control_determinism
+run_control drop-overflow-llvm \
+  "FAIL drop-overflow-llvm: planted LLVM overflow removal changed status/stderr" control_drop_overflow
+run_control lcb-off-by-one \
+  "FAIL lcb-off-by-one: native LCB and in-process evaluator both changed exit status" control_lcb_off_by_one
+run_control spec-oracle \
+  "FAIL spec-oracle: judge rejected planted exit 43 against spec exit 42" control_spec_oracle
+
+while IFS=$'\t' read -r tag index outcome production; do
+  [ "$tag" = program ] || continue
+  [ "$(remaining)" -gt 0 ] || break
+  d="$work/bir/p$index"
+  rc=0
+  native_one bir "$index" "$d" || rc=$?
+  [ "$rc" -ne 2 ] || { echo "INCOMPLETE: deadline during BIR comparison $index" >&2; exit 3; }
+  [ "$rc" -eq 0 ] || fail=1
+  bir_judged=$((bir_judged + 1))
+done < <(awk -F '\t' '$1 == "program"' "$work/bir/summary.tsv")
+
+spec_compiled=$(summary_value "$work/spec/summary.tsv" compiled)
+while IFS=$'\t' read -r tag index outcome compiled; do
+  [ "$tag" = program ] || continue
+  [ "$compiled" = true ] || continue
+  [ "$(remaining)" -gt 0 ] || break
+  d="$work/spec/p$index"
+  [ -f "$d/native-ready" ] || { echo "FAIL spec leg: compiled program lacks native-ready marker" >&2; fail=1; continue; }
+  rc=0
+  native_one spec "$index" "$d" || rc=$?
+  [ "$rc" -ne 2 ] || { echo "INCOMPLETE: deadline during spec comparison $index" >&2; exit 3; }
+  [ "$rc" -eq 0 ] || fail=1
+  spec_judged=$((spec_judged + 1))
+done < <(awk -F '\t' '$1 == "program"' "$work/spec/summary.tsv")
+
+if [ "$bir_judged" -lt "$minimum_judged" ]; then
+  echo "INCOMPLETE: judged $bir_judged BIR programs, minimum $minimum_judged, before the deadline" >&2
+  exit 3
+fi
+if [ "$spec_compiled" -gt 0 ] && [ "$spec_judged" -eq 0 ]; then
+  echo "INCOMPLETE: $spec_compiled spec programs compiled but none was judged" >&2
+  exit 3
+fi
+echo "spec_diff: $bir_judged BIR programs judged on 3 legs; $spec_judged spec programs judged; seed $seed"
+exit "$fail"
diff --git a/scripts/checks/lib/slice0_common.sh b/scripts/checks/lib/slice0_common.sh
index e0e2799b..095c9698 100644
--- a/scripts/checks/lib/slice0_common.sh
+++ b/scripts/checks/lib/slice0_common.sh
@@ -49,7 +49,8 @@ bounded() {
   return "$rc"
 }
 # The build's output is kept and shown on failure: lake prints only "error: build failed" last.
-bounded 1800 lake build Concrete lean-compiler-backend/lcb >"$work/lake-build.log" 2>&1 \
+# SLICE0_BUILD_SECS lets a gate with a total deadline include this build in that deadline.
+bounded "${SLICE0_BUILD_SECS:-1800}" lake build Concrete lean-compiler-backend/lcb >"$work/lake-build.log" 2>&1 \
   || { tail -n 200 "$work/lake-build.log" >&2; echo "slice0: lake build Concrete failed" >&2; exit 1; }
 lcb="$root/.lake/packages/lean-compiler-backend/.lake/build/bin/lcb"
 case "$(uname -s)-$(uname -m)" in

exec
/bin/bash -lc 'nl -ba scripts/checks/compiler/spec_diff.lean' in /home/unbalancedparen/projects/gates-briefs/cx-A1
 succeeded in 0ms:
     1	import Concrete
     2	
     3	/-!
     4	Seeded spec/compiler differential driver (`scripts/checks/compiler/spec_diff.sh`). Generators live
     5	in the existing Concrete library as flat `Concrete/SpecDiff*.lean` modules; no lake library, new
     6	folder, or root entry is added.
     7	Normal commands accept no mutation option. Planted defects require the explicit `control-emit`
     8	command, `--mutate`, and `--control SPEC_DIFF_PLANTED_CONTROL`.
     9	-/
    10	
    11	open Concrete.BIR Concrete.Backend
    12	open ConcreteSpec (Trap)
    13	open LeanCompilerBackend (Width)
    14	open LeanCompilerBackend.Verified
    15	
    16	namespace ConcreteSpecDiff
    17	
    18	/-- Same expectation bytes and backend artifacts as slice0_bir.lean; the script module itself is
    19	not on Lake's import path, so its small IO adapter is mirrored here over the same backend calls. -/
    20	def writeExpected (dir : System.FilePath) (status : String) (stderr : String) : IO Unit := do
    21	  IO.FS.writeFile (dir / "status") (status ++ "\n")
    22	  IO.FS.writeFile (dir / "stderr") stderr
    23	
    24	def writeLcb (dir : System.FilePath) (target : LCB.Target)
    25	    (emitted : Source.Function × SiteTable) : IO Bool := do
    26	  let (f, sites) := emitted
    27	  IO.FS.createDirAll dir
    28	  IO.FS.writeFile (dir / "lcb_source.txt") (reprStr f ++ "\n")
    29	  let job : FunctionJob :=
    30	    { code := { symbol := LCB.bodySymbol, body := f, abi := planAbi f, layout := planFrame f } }
    31	  IO.FS.writeFile (dir / "lcb_job.txt") (reprStr job ++ "\n")
    32	  if let .error msg := LCB.assemble .aarch64Macos f then
    33	    IO.eprintln s!"{dir}: LCB first path: {msg}"; return false
    34	  match LCB.assemble target f with
    35	  | .error msg => IO.eprintln s!"{dir}: LCB: {msg}"; return false
    36	  | .ok asm =>
    37	    IO.FS.writeFile (dir / "lcb_body.s") asm
    38	    IO.FS.writeFile (dir / "lcb_rt.ssa") (Runtime.qbe sites)
    39	    IO.FS.writeFile (dir / "lcb_body.ssa") (LCB.render f)
    40	    return true
    41	
    42	def writeBackends (dir : System.FilePath) (target : LCB.Target) (p : Program)
    43	    (emitted : Source.Function × SiteTable) : IO Bool := do
    44	  IO.FS.createDirAll dir
    45	  IO.FS.writeFile (dir / "bir.txt") (reprStr p ++ "\n")
    46	  IO.FS.writeFile (dir / "llvm.ll") (LLVM.module p)
    47	  writeLcb dir target emitted
    48	
    49	def unwiredMessage := "no Core→BIR lowering yet (slice 1)"
    50	
    51	/-- THE integration point for the lowering branch. Its implementation must lower the spec's Core
    52	program to BIR; until that branch lands, the spec leg runs its generator/oracle invariants but has
    53	no compiled programs and never claims a spec/native comparison. -/
    54	def compileCore (_ : ConcreteSpec.Program) : Except String Program :=
    55	  .error unwiredMessage
    56	
    57	inductive Mutation where
    58	  | none | dropOverflowLLVM | lcbOffByOne
    59	  deriving DecidableEq, Repr
    60	
    61	def mutationOfName : String → Option Mutation
    62	  | "drop-overflow-llvm" => some .dropOverflowLLVM
    63	  | "lcb-off-by-one" => some .lcbOffByOne
    64	  | _ => none
    65	
    66	/-- Replace every overflow-flag extraction by constant false. The wrapped value and control-flow
    67	shape remain, so a trapping generated program exits through its non-trap arm instead. -/
    68	def dropOverflowLLVM (text : String) : String :=
    69	  let lines := text.splitOn "\n"
    70	  String.intercalate "\n" <| lines.map fun line =>
    71	    match line.splitOn " = extractvalue " with
    72	    | [lhs, _] => if line.endsWith ", 1" then lhs ++ " = xor i1 0, 0" else line
    73	    | _ => line
    74	
    75	/-- Add one to every adapted body return. This is used only by the explicit off-by-one control,
    76	whose generated program exits; both assembly and the in-process evaluator consume this same value. -/
    77	def lcbOffByOne (f : Source.Function) : Source.Function :=
    78	  let (blocks, _, widths) := f.blocks.foldl
    79	    (fun (acc : Array Source.Block × Nat × Array Width) b =>
    80	      let (blocks, next, widths) := acc
    81	      match b.terminator with
    82	      | .ret a =>
    83	        let ins := LCB.ins next (.binary .add a (.literal (LCB.word 1)))
    84	        (blocks.push { b with instructions := b.instructions.push ins,
    85	                              terminator := .ret (.local next) },
    86	         next + 1, widths.push .word)
    87	      | _ => (blocks.push b, next, widths))
    88	    (#[], f.valueWidths.size, f.valueWidths)
    89	  { f with blocks := blocks, valueWidths := widths }
    90	
    91	def safeSeed (seed : String) : String :=
    92	  let cleaned := seed.toList.map fun c => if c.isAlphanum || c = '_' then c else '_'
    93	  let result := String.ofList cleaned
    94	  if result.isEmpty then "seed" else result
    95	
    96	def regressionName (seed : String) (index : Nat) : String :=
    97	  s!"regression_{safeSeed seed}_{index}"
    98	
    99	def trapKindName : Trap → String
   100	  | .arithmeticOverflow => "arithmeticOverflow"
   101	
   102	def outcomeName : Outcome → String
   103	  | .exited _ => "exit"
   104	  | .trapped _ => "trap"
   105	  | .stuck => "stuck"
   106	  | .outOfFuel => "out_of_fuel"
   107	
   108	def writeObservation (dir : System.FilePath) (status : String) (stderr : String) : IO Unit := do
   109	  IO.FS.createDirAll dir
   110	  writeExpected dir status stderr
   111	  IO.FS.writeFile (dir / "stdout") ""
   112	
   113	def writeOutcome (dir : System.FilePath) (outcome : Outcome) (sites : SiteTable) : IO Bool := do
   114	  match outcome with
   115	  | .exited c => writeObservation dir (toString c) ""; return true
   116	  | .trapped s => match sites[s]? with
   117	    | some e => writeObservation dir "134" (Runtime.trapLine e ++ "\n"); return true
   118	    | none => IO.eprintln s!"{dir}: no trap site {s}"; return false
   119	  | _ => IO.eprintln s!"{dir}: outcome {repr outcome} has no final observation"; return false
   120	
   121	def evaluatorObservation (f : Source.Function) (sites : SiteTable) : String × String :=
   122	  match LCB.evalBody f 100000 with
   123	  | none => ("incomplete", "")
   124	  | some w =>
   125	    if w < 256 then (toString w, "") else
   126	      match sites[w - 256]? with
   127	      | some e => ("134", Runtime.trapLine e ++ "\n")
   128	      | none => ("134", Runtime.invalidLine ++ "\n")
   129	
   130	def writeEvaluator (dir : System.FilePath) (f : Source.Function) (sites : SiteTable) : IO Unit := do
   131	  let (status, stderr) := evaluatorObservation f sites
   132	  IO.FS.writeFile (dir / "lcb_eval.status") (status ++ "\n")
   133	  IO.FS.writeFile (dir / "lcb_eval.stderr") stderr
   134	  IO.FS.writeFile (dir / "lcb_eval.stdout") ""
   135	
   136	def writeRegressionMetadata (dir : System.FilePath) (name : String) (outcome : Outcome)
   137	    (sites : SiteTable) : IO Unit := do
   138	  let expectation ← match outcome with
   139	    | .exited c => pure s!"exit {c}"
   140	    | .trapped s => match sites[s]? with
   141	      | some e => pure s!"trap {trapKindName e.kind} site {s}"
   142	      | none => pure "INVALID"
   143	    | _ => pure "INVALID"
   144	  IO.FS.writeFile (dir / "manifest-row.txt")
   145	    s!"{name}\tbir:{name}\t{expectation}\tslice0\n"
   146	  IO.FS.writeFile (dir / "regression-name.txt") (name ++ "\n")
   147	
   148	/-- Emit exactly the files consumed by slice0_native.sh, plus the evaluator's observation and the
   149	same judge inputs as the manifest runner. The expectation is supplied separately for the spec leg. -/
   150	def emitArtifacts (dir : System.FilePath) (target : LCB.Target) (p : Program) (mutation : Mutation) :
   151	    IO Bool := do
   152	  unless wf p do IO.eprintln s!"{dir}: generated BIR is not well formed"; return false
   153	  match LCB.emit p with
   154	  | .error msg => IO.eprintln s!"{dir}: adapter: {msg}"; return false
   155	  | .ok (f, sites) =>
   156	    let f := if mutation = .lcbOffByOne then lcbOffByOne f else f
   157	    unless ← writeBackends dir target p (f, sites) do return false
   158	    if mutation = .dropOverflowLLVM then
   159	      let original ← IO.FS.readFile (dir / "llvm.ll")
   160	      let changed := dropOverflowLLVM original
   161	      if changed = original then IO.eprintln s!"{dir}: drop-overflow-llvm changed nothing"; return false
   162	      IO.FS.writeFile (dir / "llvm.ll") changed
   163	    writeEvaluator dir f sites
   164	    return true
   165	
   166	def emitBirCandidate (seed : String) (index : Nat) (dir : System.FilePath) (target : LCB.Target)
   167	    (mutation : Mutation) : IO UInt32 := do
   168	  let g := BirGen.generate seed index
   169	  unless wf g.program do
   170	    IO.eprintln s!"seed {seed} index {index}: rejected: generated BIR is not well formed"
   171	    return 4
