import ConcreteSpec.Spec.Slice0
import Concrete.SpecDiffRandom

/-!
Seeded slice-0 Core generation for the spec leg. Each slice brief must extend
`weightedProductions` here with its newly accepted constructs; this is the one production table
for this leg. Generated candidates remain `Slice0.Program`s whether or not `check` accepts them.
-/

namespace ConcreteSpecDiff.SpecGen
open ConcreteSpec ConcreteSpec.Slice0
open ConcreteSpecDiff.Random

inductive Production where
  | letLiteral | letCopy | addLiteral | addVariable | returnLiteral | returnVariable
  deriving DecidableEq, Repr

def Production.name : Production → String
  | .letLiteral => "let_literal"
  | .letCopy => "let_copy"
  | .addLiteral => "add_literal"
  | .addVariable => "add_variable"
  | .returnLiteral => "return_literal"
  | .returnVariable => "return_variable"

def weightedProductions : List (Nat × Production) :=
  [(4, .letLiteral), (2, .letCopy), (4, .addLiteral), (3, .addVariable),
   (1, .returnLiteral), (5, .returnVariable)]

structure Generated where
  program : Slice0.Program
  constructs : List String

def literal (r : Rng) : Slice0.Atom × Rng :=
  let (n, r') := below 32 r
  (.lit n, r')

def statementProductions : List (Nat × Production) :=
  weightedProductions.filter fun (_, p) => p != .returnLiteral && p != .returnVariable

def go (fuel : Nat) (previous : Var) (vars : List Var) (r : Rng) :
    List Slice0.Stmt × List Production × Rng :=
  match fuel with
  | 0 => ([], [], r)
  | fuel + 1 =>
    let (choice, r₁) := pick statementProductions r
    let production := choice.getD .addLiteral
    let (rhs, r₂) :=
      match production with
      | .letCopy => (Slice0.Expr.atom (.var previous), r₁)
      | .addVariable =>
        let (which, r') := below vars.length r₁
        (.add (.var previous) (.var (vars.getD which previous)), r')
      | _ =>
        let (a, r') := literal r₁
        (.add (.var previous) a, r')
    let x : Var := ⟨"v", vars.length⟩
    let (rest, productions, r₃) := go fuel x (vars ++ [x]) r₂
    (⟨x, rhs⟩ :: rest, production :: productions, r₃)

/-- One candidate, with no hidden retry: `seed` and `index` alone determine it. -/
def generate (seed : String) (index : Nat) : Generated :=
  let r := forSeed seed index
  let (count, r₁) := below 6 r
  if count = 0 then
    let (a, _) := literal r₁
    ⟨{ body := [], ret := a }, [Production.name .returnLiteral]⟩
  else
    let (a, r₂) := literal r₁
    let x : Var := ⟨"v", 0⟩
    let first : Slice0.Stmt := ⟨x, .atom a⟩
    let (rest, productions, _) := go (count - 1) x [x] r₂
    ⟨{ body := first :: rest, ret := .var (if rest.isEmpty then x else ⟨"v", count - 1⟩) },
      (Production.name .letLiteral) ::
        (productions.map Production.name ++ [Production.name .returnVariable])⟩

end ConcreteSpecDiff.SpecGen
# shellcheck shell=bash
# Shared machinery of the slice-0 example gates (PROVISIONAL): tests.sh (gates 4, 6, 6a)
# and slice0_artifacts.sh (gates 10, 11, 12). Source it from the repository root, inside the nix
# devshell, with `set -euo pipefail`. It builds the compiler and LCB's command line under the
# gate's limits (lib/limits.sh: an address-space cap of SLICE0_GATE_MEM_GB GiB, default 64; 0 for
# a gate whose executables under test need no cap, slice0_artifacts.sh) and defines:
#   capped (a command prefix, an array): run under a 64 GiB address-space cap of its own, so
#     every build and analysis command is capped whatever the gate's cap;
#   bounded SECS CMD...: CMD under capped and bounded_run (the gates' only time bound);
#   root, work (removed on exit), lcb, target, emitter (the Lean emitter command, an array);
#   expected_timeout CMD...: CMD with its bounded runs logged apart (a control expecting a timeout);
#   observe EXE OUT SECS RETRY [MEM_MB [ENV...]]: run EXE under bounded_run (and limited_exec.sh
#     MEM_MB, default 1024) with ENV assignments; OUT.status (status or "incomplete"),
#     OUT.stdout, OUT.stderr;
#   judge EXPECTED_DIR OBS: the observation OBS.* equals the expectation, byte for byte;
#   build NAME LOG CMD...: run CMD, or print LOG and fail the gate;
#   manifest_rows KIND: validated rows, with the bir: inventory checked against the emitter;
#   cap_out: copy stdin to stdout, failing above 1 MiB: every command output a gate captures
#     into a variable goes through it, so no producer can grow the gate's shell (which may run
#     with no address-space cap, see SLICE0_GATE_MEM_GB) without bound.
root=$(pwd)
work=$(mktemp -d)
# On every exit, the bounded-run summary (recovered and INCOMPLETE runs, whatever a caller did
# with a command's stderr) goes to the gate's stdout before the scratch directory is removed, and a
# gate that would pass with an INCOMPLETE run exits 3 instead (INCOMPLETE is never a pass).
trap 'rc=$?; bounded_summary || true
  if [ "$rc" = 0 ] && grep -Eqs "^(incomplete|runner-failed)" "${BOUNDED_LOG:-/nonexistent}"; then
    echo "INCOMPLETE: a bounded run timed out twice; not a pass"; rc=3
  fi
  rm -rf "${work:?}"; exit "$rc"' EXIT
BOUNDED_PARENT="$work"
# shellcheck source=scripts/checks/lib/bounded.sh
source scripts/checks/lib/bounded.sh
[ "$BOUNDED_HAVE_WATCHDOG" = 1 ] || { echo "slice0: python3 is required for bounded runs" >&2; exit 2; }
# shellcheck source=scripts/checks/lib/limits.sh
source scripts/checks/lib/limits.sh
gate_limits "${SLICE0_GATE_MEM_GB:-64}" 40000
capped=(bash "$root/scripts/checks/lib/limited_exec.sh" 65536)
# bounded SECS CMD...: CMD under `capped`, through bounded_run (stdin /dev/null; a timeout is
# re-run once with a larger budget; a second timeout writes no output, returns 124 and is reported
# INCOMPLETE, never a pass).
bounded() {
  local secs=$1 rc=0
  shift
  bounded_run -i /dev/null "$secs" -- "${capped[@]}" "$@" || rc=$?
  if [ "$rc" != 0 ] && bounded_is_incomplete "$rc"; then
    echo "slice0: INCOMPLETE (timed out twice): $*" >&2
  fi
  return "$rc"
}
# The build's output is kept and shown on failure: lake prints only "error: build failed" last.
# SLICE0_BUILD_SECS lets a gate with a total deadline include this build in that deadline.
bounded "${SLICE0_BUILD_SECS:-1800}" lake build Concrete lean-compiler-backend/lcb >"$work/lake-build.log" 2>&1 \
  || { tail -n 200 "$work/lake-build.log" >&2; echo "slice0: lake build Concrete failed" >&2; exit 1; }
lcb="$root/.lake/packages/lean-compiler-backend/.lake/build/bin/lcb"
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) target=x86_64-linux ;;
  Linux-aarch64) target=aarch64-linux ;;
  Darwin-arm64) target=aarch64-macos ;;
  *) echo "slice0: unsupported host $(uname -s)-$(uname -m)" >&2; exit 2 ;;
esac
# The time bounds of the emit step (the Lean emitter) and the native step (slice0_native.sh).
emit_secs=120
native_secs=300
emitter=(bounded "$emit_secs" lake env lean --run scripts/checks/compiler/slice0_bir.lean)

# expected_timeout CMD...: run CMD (a function or command) with its bounded runs logged apart, for
# a control whose expected observation IS a timeout (the diverging body): its INCOMPLETE runs are
# the observation that CMD checks, not an incomplete gate, so the exit trap does not count them.
expected_timeout() {
  local BOUNDED_LOG="$work/expected-timeouts.log"
  "$@"
}

observe() {
  local rc=0 mem=${5:-1024}
  local envs=("${@:6}")
  bounded_run -i /dev/null -r "$4" "$3" -- env ${envs[@]+"${envs[@]}"} \
    bash "$root/scripts/checks/lib/limited_exec.sh" "$mem" "$1" \
    >"$2.stdout" 2>"$2.stderr" || rc=$?
  if bounded_is_incomplete "$rc"; then echo incomplete >"$2.status"; else echo "$rc" >"$2.status"; fi
}

judge() {
  cmp -s "$1/status" "$2.status" && cmp -s "$1/stderr" "$2.stderr" && [ ! -s "$2.stdout" ]
}

build() {
  local name=$1 log=$2; shift 2
  "$@" >"$log" 2>&1 || { cat "$log" >&2; echo "slice0: $name: build failed: $*" >&2; exit 1; }
}

cap_out() {
  local LC_ALL=C out
  out=$(head -c 1048577; echo x)
  out=${out%x}
  [ "${#out}" -le 1048576 ] || { echo "slice0: captured output over 1 MiB" >&2; return 1; }
  printf '%s' "$out"
}

test_manifest=${CONCRETE_TEST_MANIFEST:-tests/manifest.tsv}
manifest_rows() {
  local kind=$1 rows emitter_names name
  rows=$(bounded 30 python3 -I "$root/scripts/checks/lib/test_manifest.py" rows --kind "$kind" "$test_manifest" | cap_out) ||
    { echo "slice0: reading $test_manifest failed" >&2; exit 1; }
  [ -n "$rows" ] || { echo "slice0: no $kind tests listed in $test_manifest" >&2; exit 1; }
  if [ "$kind" = bir ]; then
    printf '%s\n' "$rows" | awk -F '\t' '{sub(/^bir:/, "", $2); print $2}' |
      LC_ALL=C sort >"$work/manifest-programs"
    emitter_names=$("${emitter[@]}" list | cap_out) ||
      { echo "slice0: listing emitter programs failed" >&2; exit 1; }
    printf '%s\n' "$emitter_names" | LC_ALL=C sort >"$work/emitter-programs"
    comm -13 "$work/manifest-programs" "$work/emitter-programs" >"$work/programs-without-rows"
    comm -23 "$work/manifest-programs" "$work/emitter-programs" >"$work/rows-without-programs"
    if [ -s "$work/programs-without-rows" ] || [ -s "$work/rows-without-programs" ]; then
      while IFS= read -r name; do
        echo "slice0: program without a manifest row: $name" >&2
      done <"$work/programs-without-rows"
      while IFS= read -r name; do
        echo "slice0: manifest row names no program: $name" >&2
      done <"$work/rows-without-programs"
      exit 1
    fi
  fi
  printf '%s\n' "$rows"
}
#!/usr/bin/env bash
# Shared native build policy. Input/output names and link order are fixed, relative to cwd.
# Use the pinned Nix compiler; discard ambient compiler/linker flags and wrapper injections.
set -euo pipefail
: "${CONCRETE_SLICE0_CLANG:?run inside nix develop}"
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) target=x86_64-linux; link=(-Wl,--build-id=none) ;;
  Linux-aarch64) target=aarch64-linux; link=(-Wl,--build-id=none) ;;
  Darwin-arm64) target=aarch64-macos; link=(-Wl,-no_uuid) ;;
  *) echo 'slice0_native: unsupported target' >&2; exit 2 ;;
esac
if [ "${1:-}" = target ]; then echo "$target"; exit; fi
# `control DIRECTORY` links DIRECTORY/control.s alone into control.exe, under the same policy: the run
# checks' controls (slice0_artifacts.sh) are hand-written assembly built exactly like the examples.
control=0
if [ "${1:-}" = control ] && [ "$#" = 2 ]; then control=1; set -- "$2" -; fi
# `sanitize` builds only llvm.san.exe: the LLVM example with ASan (README gate 10; no UBSan, see there).
[ "$#" = 2 ] || { [ "$#" = 3 ] && [ "$3" = sanitize ]; } ||
  { echo 'usage: slice0_native.sh DIRECTORY LCB [sanitize] | control DIRECTORY | target' >&2; exit 2; }
lcb=$2
cd "$1"
# Fixed epoch rather than wall clock or caller environment. No debug data is requested, and
# prefix maps also cover future debug additions. Separate objects avoid random linker temp names.
clean=(env -i "PATH=$PATH" "HOME=$HOME" "TMPDIR=${TMPDIR:-/tmp}"
  LC_ALL=C TZ=UTC SOURCE_DATE_EPOCH=1 ZERO_AR_DATE=1)
cc=("${clean[@]}" "$CONCRETE_SLICE0_CLANG" --no-default-config
  -O0 -g0 -w "-ffile-prefix-map=$PWD=." "-fdebug-prefix-map=$PWD=."
  -fdebug-compilation-dir=.)
# Do not derive the deployment target from the macOS version on the build host.
[ "$target" != aarch64-macos ] || cc+=(--target=arm64-apple-macosx15.0 -mmacosx-version-min=15.0)
if [ "${3:-}" = sanitize ]; then
  # ASan instruments only functions carrying `sanitize_address`, which clang's C front end adds and
  # the printed IR does not; the sanitizer build adds it to every definition (llvm.san.ll).
  sed -E 's/^(define .*\)) \{$/\1 sanitize_address {/' llvm.ll >llvm.san.ll
  [ "$(grep -c '^define ' llvm.san.ll)" = "$(grep -c '^define .* sanitize_address {$' llvm.san.ll)" ] ||
    { echo 'slice0_native: a definition lacks sanitize_address' >&2; exit 1; }
  san=(-fsanitize=address -fno-sanitize-recover=all)
  "${cc[@]}" "${san[@]}" -c llvm.san.ll -o llvm.san.o
  "${cc[@]}" "${san[@]}" "${link[@]}" llvm.san.o -o llvm.san.exe
  exit
fi
if [ "$control" = 1 ]; then
  "${cc[@]}" -c control.s -o control.o
  "${cc[@]}" "${link[@]}" control.o -o control.exe
  exit
fi
"${cc[@]}" -c llvm.ll -o llvm.o
"${cc[@]}" -c lcb_body.s -o lcb_body.o
"${clean[@]}" "$lcb" -t "$target" lcb_rt.ssa -o lcb_rt.s
"${cc[@]}" -c lcb_rt.s -o lcb_rt.o
"${cc[@]}" "${link[@]}" llvm.o -o llvm.exe
"${cc[@]}" "${link[@]}" lcb_body.o lcb_rt.o -o lcb.exe

