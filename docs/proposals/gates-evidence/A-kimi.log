+w_u16_sub	bir:w_u16_sub	exit 126	slice0
+w_u16_mul	bir:w_u16_mul	exit 129	slice0
+w_u16_mul_ok	bir:w_u16_mul_ok	exit 255	slice0
+widen_u	bir:widen_u	exit 160	slice0
+widen_s	bir:widen_s	exit 90	slice0
+site1	bir:site1	trap arithmeticOverflow site 1	slice0
+site0	bir:site0	trap arithmeticOverflow site 0	slice0
