+w_i8_add_ok	bir:w_i8_add_ok	exit 206	slice0
+w_i8_sub	bir:w_i8_sub	exit 184	slice0
+w_i8_mul	bir:w_i8_mul	exit 240	slice0
+w_u8_add	bir:w_u8_add	exit 172	slice0
+w_u8_sub	bir:w_u8_sub	exit 126	slice0
+w_u8_mul	bir:w_u8_mul	exit 16	slice0
+w_i16_add	bir:w_i16_add	exit 128	slice0
+w_i16_sub	bir:w_i16_sub	exit 127	slice0
