import Concrete

/-!
Emitter for the manifest-driven test gate (`scripts/checks/compiler/tests.sh`). PROVISIONAL.

`lake env lean --run scripts/checks/compiler/slice0_bir.lean list` prints the hand-written BIR examples;
`... emit NAME DIR TARGET EXPECT...` takes the expectation from `tests/manifest.tsv` and checks the
example in Lean (well formed; its BIR run gives that outcome; LCB's own evaluator on the adapted
body returns the same result word; a trap site's kind is the expected kind) and writes
`DIR/llvm.ll` (body + runtime entry), `DIR/lcb_body.s` (the adapted body, assembled by LCB in
process for TARGET: `x86_64-linux`, `aarch64-linux` or `aarch64-macos`), `DIR/lcb_rt.ssa` (the
runtime entry as QBE text, for LCB's command line), `DIR/lcb_body.ssa` (a debug dump only), and the
observation the executables must show: `DIR/status` (the exit status) and `DIR/stderr` (the exact
bytes on descriptor 2; descriptor 1 must stay empty).

Two controls exercise the gate itself: `... loop DIR TARGET` emits a well-formed BIR body that
never returns (`DIR/status` is `incomplete`), and `... invalid DIR TARGET` emits a body returning a
word that encodes nothing, which the runtime must refuse (`Runtime.invalidLine`, then abort).
-/

open Concrete.BIR Concrete.Backend
open ConcreteSpec (Trap)

structure Expectation where
  outcome : Outcome
  trapKind : Option Trap

def trapOfName : String → Option Trap
  | "arithmeticOverflow" => some .arithmeticOverflow
  | _ => none

def parseExpectation : List String → Option Expectation
  | ["exit", c] => match c.toNat? with
    | some n => if n ≤ 255 then some ⟨.exited n, none⟩ else none
    | none => none
  | ["trap", kind, "site", s] => match trapOfName kind, s.toNat? with
    | some k, some n => some ⟨.trapped n, some k⟩
    | _, _ => none
  | _ => none

def writeExpected (dir : System.FilePath) (status : String) (stderr : String) : IO Unit := do
  IO.FS.writeFile (dir / "status") (status ++ "\n")
  IO.FS.writeFile (dir / "stderr") stderr

/-- Write the LCB leg: the body assembled in process, the runtime entry as QBE text. -/
def writeLcb (dir : System.FilePath) (target : LCB.Target)
    (emitted : LeanCompilerBackend.Verified.Source.Function × SiteTable) : IO Bool := do
  let (f, sites) := emitted
  IO.FS.createDirAll dir
  IO.FS.writeFile (dir / "lcb_source.txt") (reprStr f ++ "\n")
  let job : LeanCompilerBackend.Verified.FunctionJob :=
    { code := { symbol := LCB.bodySymbol, body := f,
                abi := LeanCompilerBackend.Verified.planAbi f,
                layout := LeanCompilerBackend.Verified.planFrame f } }
  IO.FS.writeFile (dir / "lcb_job.txt") (reprStr job ++ "\n")
  -- On every host, LCB's verified first path (the `aarch64-macos` target) must admit the body.
  if let .error msg := LCB.assemble .aarch64Macos f then
    IO.eprintln s!"{dir}: LCB first path: {msg}"; return false
  match LCB.assemble target f with
  | .error msg => IO.eprintln s!"{dir}: LCB: {msg}"; return false
  | .ok asm =>
    IO.FS.writeFile (dir / "lcb_body.s") asm
    IO.FS.writeFile (dir / "lcb_rt.ssa") (Runtime.qbe sites)
    IO.FS.writeFile (dir / "lcb_body.ssa") (LCB.render f)
    return true

def writeBackends (dir : System.FilePath) (target : LCB.Target) (p : Program)
    (emitted : LeanCompilerBackend.Verified.Source.Function × SiteTable) : IO Bool := do
  IO.FS.createDirAll dir
  IO.FS.writeFile (dir / "bir.txt") (reprStr p ++ "\n")
  IO.FS.writeFile (dir / "llvm.ll") (LLVM.module p)
  writeLcb dir target emitted

def emit (name : String) (dir : System.FilePath) (expectation : List String)
    (target : LCB.Target) : IO UInt32 := do
  let some (_, p) := Examples.all.find? (·.1 == name)
    | IO.eprintln s!"unknown example {name}"; return 2
  let some expected := parseExpectation expectation
    | IO.eprintln s!"{name}: invalid BIR expectation; use exit N or trap KIND site N"; return 2
  unless wf p do IO.eprintln s!"{name}: not well formed"; return 1
  let got := run p 1000
  unless got == expected.outcome do
    IO.eprintln s!"{name}: expectation mismatch: BIR run gives {repr got}, expected {repr expected.outcome}"; return 1
  let some word := encode expected.outcome | IO.eprintln s!"{name}: no result word"; return 1
  match LCB.emit p with
  | .error msg => IO.eprintln s!"{name}: adapter: {msg}"; return 1
  | .ok (f, tbl) =>
    match LCB.evalBody f 100000 with
    | some w =>
      unless w == word do
        IO.eprintln s!"{name}: LCB's evaluator returns {w}, BIR's result word is {word}"; return 1
    | none => IO.eprintln s!"{name}: LCB's evaluator does not return"; return 1
    unless ← writeBackends dir target p (f, tbl) do return 1
    match expected.outcome with
    | .exited c => writeExpected dir (toString c) ""
    | .trapped s => match tbl[s]? with
      | some e =>
        unless expected.trapKind == some e.kind do
          IO.eprintln s!"{name}: expectation mismatch: trap site {s} has kind {repr e.kind}, expected {repr expected.trapKind}"; return 1
        writeExpected dir "134" (Runtime.trapLine e ++ "\n")
      | none => IO.eprintln s!"{name}: no site {s}"; return 1
    | _ => IO.eprintln s!"{name}: no observation"; return 1
    return 0

/-- A body that branches back to itself forever. -/
def loopBody : Program :=
  { blocks := [{ params := [], insts := [], term := .br 1 [] },
               { params := [], insts := [], term := .br 1 [] }], sites := [] }

def emitLoop (dir : System.FilePath) (target : LCB.Target) : IO UInt32 := do
  unless wf loopBody && run loopBody 1000 == .outOfFuel do
    IO.eprintln "loop: not a well-formed diverging body"; return 1
  match LCB.emit loopBody with
  | .error msg => IO.eprintln s!"loop: adapter: {msg}"; return 1
  | .ok (f, tbl) =>
    if (LCB.evalBody f 10000).isSome then IO.eprintln "loop: LCB's evaluator returns"; return 1
    unless ← writeBackends dir target loopBody (f, tbl) do return 1
    writeExpected dir "incomplete" ""
    return 0

/-- One site, and a body returning `256 + 1`: past the table, so the word encodes nothing. -/
def emitInvalid (dir : System.FilePath) (target : LCB.Target) : IO UInt32 := do
  let tbl : SiteTable := [Examples.plusSite]
  IO.FS.createDirAll dir
  IO.FS.writeFile (dir / "llvm.ll")
    ("define i32 @concrete_body() {\nentry:\n  ret i32 257\n}\n\n" ++ Runtime.llvm tbl)
  let f : LeanCompilerBackend.Verified.Source.Function :=
    { resultWidth := .word, parameters := #[], valueWidths := #[],
      blocks := #[{ phis := #[], instructions := #[], terminator := .ret (.literal (LCB.word 257)) }] }
  unless ← writeLcb dir target (f, tbl) do return 1
  writeExpected dir "134" (Runtime.invalidLine ++ "\n")
  return 0

def withTarget (name : String) (k : LCB.Target → IO UInt32) : IO UInt32 :=
  match LCB.Target.ofName name with
  | some t => k t
  | none => do IO.eprintln s!"unknown target {name}"; return 2

def main (args : List String) : IO UInt32 := do
  match args with
  | ["list"] => do
    for (n, _) in Examples.all do IO.println n
    return 0
  | "emit" :: name :: dir :: t :: expectation => withTarget t (emit name dir expectation)
  | ["loop", dir, t] => withTarget t (emitLoop dir)
  | ["invalid", dir, t] => withTarget t (emitInvalid dir)
  | _ => IO.eprintln "usage: slice0_bir.lean list | emit NAME DIR TARGET EXPECT... | (loop | invalid) DIR TARGET"; return 2
#!/usr/bin/env python3
"""THE REQUIRED-CHECK VERDICT FOR ONE CANDIDATE (train.sh watch and land).

Usage: required_checks.py BASE_FILE CAND_FILE TRANSITION_FILE JOBS_FILE
  BASE_FILE        required-checks.txt as the base (main) has it; empty file if absent
  CAND_FILE        required-checks.txt as the candidate has it; empty file if absent
  TRANSITION_FILE  required-checks-transition.tsv as the candidate has it; empty file if absent
  JOBS_FILE        the run's jobs, "<tier>\\t<conclusion>\\t<id>\\t<name>" per line (train.sh run_jobs)
  (a missing file and an empty file are the same: "the commit has no such file")

Prints one line per finding and exits 0; train.sh refuses when any line starts with an unmet kind:
  missing: <job>            a required job is absent from the run
  <conclusion>: <job>       a required job did not succeed (skipped, cancelled, failure, pending...)
  invalid: <reason>         the files themselves are unusable (nothing required, a bad transition row)
and prints notes that never refuse and never count as a pass:
  retired: <job> (<reason>) a base requirement the candidate retires with no replacement; NOT RUN
  replaced: <job> by <jobs> a base requirement whose replacements are required (and checked) instead
  stale: <job>              a transition row for a job the base no longer requires (delete the row)

THE RULE. The required set is the candidate's list plus every job the base requires, except a base
job the candidate drops through an explicit transition row. Without a row, a dropped base job stays
required, so a candidate cannot weaken main's requirements by editing its own list. A row is
`old_job<TAB>replacements<TAB>reason`: replacements is a comma-separated list of jobs that must
each be in the candidate's list (so they are required and checked at this exact SHA), or `-` to
retire the old job outright, which needs a reason and is reported as retired, never as passed.
A row for a job the candidate still requires is contradictory and refused. Files are read
separately and newline-terminated, so names from two files never fuse.
"""
import sys

UNMET = ("missing:", "invalid:")


def names(path):
    try:
        text = open(path).read()
    except OSError:
        return set()
    out = set()
    for line in text.splitlines():
        line = line.split("#", 1)[0].strip()
        if line:
            out.add(line)
    return out


def transition(path):
    rows, bad = {}, []
    try:
        text = open(path).read()
    except OSError:
        return rows, bad
    for n, line in enumerate(text.splitlines(), 1):
        if not line.strip() or line.startswith("#"):
            continue
        f = line.split("\t")
        if f[0] == "old_job":
            continue  # header
        if len(f) != 3 or not all(x.strip() for x in f):
            bad.append(f"transition row {n} needs old_job, replacements, reason (tab-separated, non-empty)")
            continue
        old, repl, why = (x.strip() for x in f)
        if old in rows:
            bad.append(f"transition row {n} repeats {old}")
            continue
        if repl == "-":
            rows[old] = ([], why)
            continue
        parts = [r.strip() for r in repl.split(",")]
        if not all(parts):
            # "a,,b" or "," must not degrade into a retirement: only a literal "-" retires
            bad.append(f"transition row {n} has an empty replacement name in {repl!r} (use '-' to retire)")
            continue
        rows[old] = (parts, why)
    return rows, bad


def plan(base, cand, rows, bad):
    """-> (required set, findings list)"""
    out = [f"invalid: {b}" for b in bad]
    if not base and not cand:
        out.append("invalid: required-checks.txt (neither the base nor the candidate has one)")
        return set(), out
    req = set(cand)
    for old in sorted(base):
        if old in cand:
            continue
        if old not in rows:
            req.add(old)  # dropped without a transition row: still required
            continue
        repl, why = rows[old]
        if not repl:
            out.append(f"retired: {old} ({why}); not run, not passed")
            continue
        missing = [r for r in repl if r not in cand]
        if missing:
            out.append(f"invalid: replacement {', '.join(missing)} for {old} is not in the candidate's required-checks.txt")
            req.add(old)
            continue
        out.append(f"replaced: {old} by {', '.join(repl)}")
    for old in sorted(rows):
        if old in cand:
            out.append(f"invalid: transition row for {old}, which the candidate still requires")
        elif old not in base:
            out.append(f"stale: {old} (the base does not require it; delete the row)")
    return req, out


def verdict(req, jobs_path):
    seen = {}
    for line in open(jobs_path):
        f = line.rstrip("\n").split("\t")
        if len(f) >= 4:
            seen.setdefault(f[3], []).append(f[1])
    out = []
    for name in sorted(req):
        c = seen.get(name)
        if not c:
            out.append("missing: " + name)
        elif any(x != "success" for x in c):
            out.append(",".join(sorted(set(c))) + ": " + name)
    return out


def main():
    if len(sys.argv) != 5:
        sys.exit(__doc__)
    base, cand = names(sys.argv[1]), names(sys.argv[2])
    rows, bad = transition(sys.argv[3])
    req, notes = plan(base, cand, rows, bad)
    for line in notes + verdict(req, sys.argv[4]):
        print(line)


if __name__ == "__main__":
    main()

