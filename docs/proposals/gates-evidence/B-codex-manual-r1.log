#!/usr/bin/env bash
# Manifest-driven test gate (PROVISIONAL, Concrete/README.md gates 4 and 6, hand-written BIR leg):
# every bir: row in tests/manifest.tsv goes through the LLVM path (clang) and the LCB path: the
# adapted body assembled by LCB in process (no text on the proved path), linked with the runtime
# entry, which LCB's command line assembles from QBE text. The manifest's bir: inventory must equal
# the emitter's list in both directions. CONCRETE_TEST_MANIFEST selects another manifest (controls).
# Each executable runs under bounded_run; its observation is its exit status (or "incomplete"),
# the exact bytes on descriptor 2, and descriptor 1, which must be empty. All three must equal the
# manifest expectation checked by the emitter (which writes the expected status and stderr bytes).
#
# Controls: wrong exit and trap expectations must fail in the emitter; a missing row and a
# nonexistent program must fail opposite inventory directions (these child runs are emit-only,
# never native). A body that never returns must
# be observed as incomplete on both backends; a body returning a word that encodes nothing must reach
# the runtime's refusal; and the comparison itself must reject a missing or extra newline, a wrong
# status with the right stderr, and stray stdout. Run inside the nix devshell, from the repo root.
set -euo pipefail
# shellcheck source=scripts/checks/lib/slice0_common.sh
source scripts/checks/lib/slice0_common.sh

fail=0
count=0
examples=0
# check NAME DIR SECS RETRY: build both backends in DIR, run them and judge them.
check() {
  local name=$1 d=$2 backend
  build "$name" "$d/build.log" bounded "$native_secs" bash "$root/scripts/checks/lib/slice0_native.sh" "$d" "$lcb"
  for backend in llvm lcb; do
    observe "$d/$backend.exe" "$d/$backend" "$3" "$4"
    count=$((count + 1))
    if judge "$d" "$d/$backend"; then
      echo "ok   $name [$backend]: status $(cat "$d/$backend.status")"
    else
      echo "FAIL $name [$backend]: status $(cat "$d/$backend.status") (expected $(cat "$d/status"))," \
        "stderr $(od -An -c "$d/$backend.stderr" | tr -s ' ' | head -c 300)," \
        "stdout $(wc -c <"$d/$backend.stdout") bytes"
      fail=1
    fi
  done
}

rows=$(manifest_rows bir)

wrong_expectation() { awk -F '\t' -v OFS='\t' '$1 == "answer" {$3 = "exit 41"} {print}' "$1" >"$1.new"; mv "$1.new" "$1"; }
wrong_trap_expectation() { awk -F '\t' -v OFS='\t' '$1 == "overflow" {$3 = "trap arithmeticOverflow site 1"} {print}' "$1" >"$1.new"; mv "$1.new" "$1"; }
missing_row() { awk -F '\t' '$1 != "answer"' "$1" >"$1.new"; mv "$1.new" "$1"; }
nonexistent_program() { printf 'no_such_program\tbir:no_such_program\texit 0\tslice0\n' >>"$1"; }
manifest_control() { # manifest_control LABEL EXPECTED-MESSAGE MUTATION-FUNCTION
  local label=$1 expected=$2 mutation=$3 dir="$work/ctl/$1" copy rc=0
  mkdir -p "$dir"
  cp -R "$(dirname "$test_manifest")" "$dir/tests"
  copy="$dir/tests/$(basename "$test_manifest")"
  "$mutation" "$copy"
  if cmp -s "$test_manifest" "$copy"; then
    echo "FAIL manifest control $label: mutation changed nothing" >&2; fail=1; return
  fi
  CONCRETE_TEST_MANIFEST="$copy" CONCRETE_TEST_MANIFEST_SKIP_CONTROLS=1 CONCRETE_TEST_EMIT_ONLY=1 \
    bash "$root/scripts/checks/compiler/tests.sh" >"$work/ctl/$label.log" 2>&1 || rc=$?
  if [ "$rc" -ne 0 ] && grep -qF "$expected" "$work/ctl/$label.log"; then
    echo "ok   manifest control $label: refused for the planted reason"
  else
    echo "FAIL manifest control $label: not refused as '$expected'" >&2
    cat "$work/ctl/$label.log" >&2
    fail=1
  fi
}
mkdir -p "$work/ctl"
if [ "${CONCRETE_TEST_MANIFEST_SKIP_CONTROLS:-0}" != 1 ]; then
  manifest_control wrong-expectation "answer: expectation mismatch: BIR run gives" wrong_expectation
  manifest_control wrong-trap-expectation "overflow: expectation mismatch: BIR run gives" wrong_trap_expectation
  manifest_control missing-row "program without a manifest row: answer" missing_row
  manifest_control nonexistent-program "manifest row names no program: no_such_program" nonexistent_program
fi

while IFS=$'\t' read -r name program expect; do
  d="$work/ex/$name"
  read -r -a expectation <<<"$expect"
  "${emitter[@]}" emit "${program#bir:}" "$d" "$target" "${expectation[@]}"
  # Emit-only controls cover every row and never reach a native build, even if a planted defect is
  # accidentally accepted: the control then fails because the child returns zero after the loop.
  if [ "${CONCRETE_TEST_EMIT_ONLY:-0}" = 1 ]; then continue; fi
  check "$name" "$d" 10 20
  examples=$((examples + 1))
done <<<"$rows"
if [ "${CONCRETE_TEST_EMIT_ONLY:-0}" = 1 ]; then exit 0; fi
"${emitter[@]}" loop "$work/ctl/loop" "$target"
expected_timeout check control-loop "$work/ctl/loop" 1 1
"${emitter[@]}" invalid "$work/ctl/invalid" "$target"
check control-invalid-word "$work/ctl/invalid" 10 20

# The comparison's own negative controls: each forged observation must be rejected.
e="$work/ctl/judge"; mkdir -p "$e"
echo 134 >"$e/status"; printf 'concrete: trap: x\n' >"$e/stderr"
forge() { # forge NAME STATUS STDERR-PRINTF STDOUT
  local o="$work/ctl/forged-$1"
  echo "$2" >"$o.status"; printf "$3" >"$o.stderr"; printf '%s' "$4" >"$o.stdout"
  echo "$o"
}
judge "$e" "$(forge same 134 'concrete: trap: x\n' '')" || { echo "FAIL judge rejects an exact match"; fail=1; }
for c in "no-newline|134|concrete: trap: x|" "extra-newline|134|concrete: trap: x\n\n|" \
         "wrong-status|1|concrete: trap: x\n|" "stray-stdout|134|concrete: trap: x\n|42" \
         "incomplete|incomplete||"; do
  IFS='|' read -r n s err out <<<"$c"
  if judge "$e" "$(forge "$n" "$s" "$err" "$out")"; then
    echo "FAIL judge accepts a forged observation: $n"; fail=1
  else
    echo "ok   judge rejects $n"
  fi
done

[ "$examples" -gt 0 ] || { echo "tests: no examples ran" >&2; exit 1; }
echo "tests: $examples examples, $count backend runs (controls included)"
exit "$fail"
# shellcheck shell=bash
# Shared machinery of the slice-0 example gates (PROVISIONAL): tests.sh (gates 4, 6, 6a)
# and slice0_artifacts.sh (gates 10, 11, 12). Source it from the repository root, inside the nix
# devshell, with `set -euo pipefail`. It builds the compiler and LCB's command line under the
# gate's limits (lib/limits.sh: an address-space cap of SLICE0_GATE_MEM_GB GiB, default 64; 0 for
# a gate whose executables under test need no cap, slice0_artifacts.sh) and defines:
#   capped (a command prefix, an array): run under a 64 GiB address-space cap of its own, so
#     every build and analysis command is capped whatever the gate's cap;
#   bounded SECS CMD...: CMD under capped and bounded_run (the gates' only time bound);
#   root, work (removed on exit), lcb, target, emitter (the Lean emitter command, an array);
#   expected_timeout CMD...: CMD with its bounded runs logged apart (a control expecting a timeout);
#   observe EXE OUT SECS RETRY [MEM_MB [ENV...]]: run EXE under bounded_run (and limited_exec.sh
#     MEM_MB, default 1024) with ENV assignments; OUT.status (status or "incomplete"),
#     OUT.stdout, OUT.stderr;
#   judge EXPECTED_DIR OBS: the observation OBS.* equals the expectation, byte for byte;
#   build NAME LOG CMD...: run CMD, or print LOG and fail the gate;
#   manifest_rows KIND: validated rows, with the bir: inventory checked against the emitter;
#   cap_out: copy stdin to stdout, failing above 1 MiB: every command output a gate captures
#     into a variable goes through it, so no producer can grow the gate's shell (which may run
#     with no address-space cap, see SLICE0_GATE_MEM_GB) without bound.
root=$(pwd)
work=$(mktemp -d)
# On every exit, the bounded-run summary (recovered and INCOMPLETE runs, whatever a caller did
# with a command's stderr) goes to the gate's stdout before the scratch directory is removed, and a
# gate that would pass with an INCOMPLETE run exits 3 instead (INCOMPLETE is never a pass).
trap 'rc=$?; bounded_summary || true
  if [ "$rc" = 0 ] && grep -Eqs "^(incomplete|runner-failed)" "${BOUNDED_LOG:-/nonexistent}"; then
    echo "INCOMPLETE: a bounded run timed out twice; not a pass"; rc=3
  fi
  rm -rf "${work:?}"; exit "$rc"' EXIT
BOUNDED_PARENT="$work"
# shellcheck source=scripts/checks/lib/bounded.sh
source scripts/checks/lib/bounded.sh
[ "$BOUNDED_HAVE_WATCHDOG" = 1 ] || { echo "slice0: python3 is required for bounded runs" >&2; exit 2; }
# shellcheck source=scripts/checks/lib/limits.sh
source scripts/checks/lib/limits.sh
gate_limits "${SLICE0_GATE_MEM_GB:-64}" 40000
capped=(bash "$root/scripts/checks/lib/limited_exec.sh" 65536)
# bounded SECS CMD...: CMD under `capped`, through bounded_run (stdin /dev/null; a timeout is
# re-run once with a larger budget; a second timeout writes no output, returns 124 and is reported
# INCOMPLETE, never a pass).
bounded() {
  local secs=$1 rc=0
  shift
  bounded_run -i /dev/null "$secs" -- "${capped[@]}" "$@" || rc=$?
  if [ "$rc" != 0 ] && bounded_is_incomplete "$rc"; then
    echo "slice0: INCOMPLETE (timed out twice): $*" >&2
  fi
  return "$rc"
}
# The build's output is kept and shown on failure: lake prints only "error: build failed" last.
bounded 1800 lake build Concrete lean-compiler-backend/lcb >"$work/lake-build.log" 2>&1 \
  || { tail -n 200 "$work/lake-build.log" >&2; echo "slice0: lake build Concrete failed" >&2; exit 1; }
lcb="$root/.lake/packages/lean-compiler-backend/.lake/build/bin/lcb"
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) target=x86_64-linux ;;
  Linux-aarch64) target=aarch64-linux ;;
  Darwin-arm64) target=aarch64-macos ;;
  *) echo "slice0: unsupported host $(uname -s)-$(uname -m)" >&2; exit 2 ;;
esac
# The time bounds of the emit step (the Lean emitter) and the native step (slice0_native.sh).
emit_secs=120
native_secs=300
emitter=(bounded "$emit_secs" lake env lean --run scripts/checks/compiler/slice0_bir.lean)

# expected_timeout CMD...: run CMD (a function or command) with its bounded runs logged apart, for
# a control whose expected observation IS a timeout (the diverging body): its INCOMPLETE runs are
# the observation that CMD checks, not an incomplete gate, so the exit trap does not count them.
expected_timeout() {
  local BOUNDED_LOG="$work/expected-timeouts.log"
  "$@"
}

observe() {
  local rc=0 mem=${5:-1024}
  local envs=("${@:6}")
  bounded_run -i /dev/null -r "$4" "$3" -- env ${envs[@]+"${envs[@]}"} \
    bash "$root/scripts/checks/lib/limited_exec.sh" "$mem" "$1" \
    >"$2.stdout" 2>"$2.stderr" || rc=$?
  if bounded_is_incomplete "$rc"; then echo incomplete >"$2.status"; else echo "$rc" >"$2.status"; fi
}

judge() {
  cmp -s "$1/status" "$2.status" && cmp -s "$1/stderr" "$2.stderr" && [ ! -s "$2.stdout" ]
}

build() {
  local name=$1 log=$2; shift 2
  "$@" >"$log" 2>&1 || { cat "$log" >&2; echo "slice0: $name: build failed: $*" >&2; exit 1; }
}

cap_out() {
  local LC_ALL=C out
  out=$(head -c 1048577; echo x)
  out=${out%x}
  [ "${#out}" -le 1048576 ] || { echo "slice0: captured output over 1 MiB" >&2; return 1; }
  printf '%s' "$out"
}

test_manifest=${CONCRETE_TEST_MANIFEST:-tests/manifest.tsv}
manifest_rows() {
  local kind=$1 rows emitter_names name
  rows=$(bounded 30 python3 -I "$root/scripts/checks/lib/test_manifest.py" rows --kind "$kind" "$test_manifest" | cap_out) ||
    { echo "slice0: reading $test_manifest failed" >&2; exit 1; }
  [ -n "$rows" ] || { echo "slice0: no $kind tests listed in $test_manifest" >&2; exit 1; }
  if [ "$kind" = bir ]; then
    printf '%s\n' "$rows" | awk -F '\t' '{sub(/^bir:/, "", $2); print $2}' |
      LC_ALL=C sort >"$work/manifest-programs"
    emitter_names=$("${emitter[@]}" list | cap_out) ||
      { echo "slice0: listing emitter programs failed" >&2; exit 1; }
    printf '%s\n' "$emitter_names" | LC_ALL=C sort >"$work/emitter-programs"
    comm -13 "$work/manifest-programs" "$work/emitter-programs" >"$work/programs-without-rows"
    comm -23 "$work/manifest-programs" "$work/emitter-programs" >"$work/rows-without-programs"
    if [ -s "$work/programs-without-rows" ] || [ -s "$work/rows-without-programs" ]; then
      while IFS= read -r name; do
        echo "slice0: program without a manifest row: $name" >&2
      done <"$work/programs-without-rows"
      while IFS= read -r name; do
        echo "slice0: manifest row names no program: $name" >&2
      done <"$work/rows-without-programs"
      exit 1
    fi
  fi
  printf '%s\n' "$rows"
}

