#!/usr/bin/env bash
# The gate environment guard. Every gate sources this first:
#
#   source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
#
# Gates run in three places: the dev shell, Linux CI runners and the macOS CI runner. When each took
# coreutils, sed, grep, python and the rest from whatever host it landed on, a gate could pass on one
# and fail on another for reasons unrelated to what it tests: macOS has no `timeout`, and BSD `sed -i`,
# `stat`, `date` and `readlink` take other flags. flake.nix now defines that userland once (the
# `gates` shell), CI runs every step inside it, and the dev shells include it. Each of those shells
# exports CONCRETE_GATES_SHELL=1; a gate started anywhere else refuses here, before it can produce a
# verdict about the wrong environment.
#
# Use `nix develop .#gates` (no Lean; what CI uses, with elan's Lean on PATH) or `nix develop` (the
# dev shell, with its own Lean). An entry point that must start outside both, like the pre-push
# hook, re-executes itself inside `nix develop` before it runs a gate.
#
# check_gate_hygiene.sh proves every gate sources this file.

if [ "${CONCRETE_GATES_SHELL:-}" != 1 ]; then
  echo "error: ${0##*/} refuses to run outside the gate shell: run inside nix develop .#gates (CI) or nix develop" >&2
  exit 2
fi

# Every gate matches text with has_match, never a pipe into grep -q (bug 283).
source "$(dirname "${BASH_SOURCE[0]}")/has_match.sh" || exit 2
  echo "ok   $name [$backend] stack: bound $bound, measured $measured, externals ${ext:-none}"
}

size_report() { # size_report NAME BACKEND EXE
  local bytes text
  bytes=$(wc -c <"$3" | tr -d ' ')
  text=$(bounded 60 "$CONCRETE_SLICE0_LLVM/llvm-size" "$3" 2>/dev/null |
    awk 'NR == 2 {print $1}' | cap_out) || true
  printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$target" "$bytes" "${text:-unavailable}" >>"$sizes"
}

rows=$(manifest_rows bir)
mkdir -p "$work/ctl"
first_name= first_program= first_expect=
while IFS=$'\t' read -r name program expect; do
  if [ -z "$first_name" ]; then first_name=$name first_program=$program first_expect=$expect; fi
  d="$work/ex/$name"
  t0=$(now_ms)
  read -r -a expectation <<<"$expect"
  "${emitter[@]}" emit "${program#bir:}" "$d" "$target" "${expectation[@]}"
  t1=$(now_ms)
  build "$name" "$d/build.log" bounded "$native_secs" bash "$root/scripts/checks/lib/slice0_native.sh" "$d" "$lcb"
  t2=$(now_ms)
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$target" $((t1 - t0)) $((emit_secs * 1000)) $((t2 - t1)) $((native_secs * 1000)) >>"$times"
  build "$name" "$d/build-san.log" \
    bounded "$native_secs" bash "$root/scripts/checks/lib/slice0_native.sh" "$d" "$lcb" sanitize
  observe "$d/llvm.san.exe" "$d/san" 30 30 0 "${san_env[@]}"
  if judge "$d" "$d/san"; then
    echo "ok   $name [llvm+asan]: status $(cat "$d/san.status")"
  else
    echo "FAIL $name [llvm+asan]: status $(head -c 16 "$d/san.status") (expected $(head -c 16 "$d/status")), stderr" \
      "$(head -c 600 "$d/san.stderr")"
    fail=1
  fi
  for backend in llvm lcb; do
    size_report "$name" "$backend" "$d/$backend.exe"
    stack_check "$name" "$backend" "$d/$backend.exe"
  done
  examples=$((examples + 1))
done <<<"$rows"

# Control (gate 10): an out-of-bounds load in the body must be reported by ASan.
c="$work/ctl/asan"
read -r -a first_expectation <<<"$first_expect"
"${emitter[@]}" emit "${first_program#bir:}" "$c" "$target" "${first_expectation[@]}"
sed -i.orig 's/^define i32 @concrete_body() {$/define i32 @concrete_body_orig() {/' "$c/llvm.ll"
cat >>"$c/llvm.ll" <<'LL'

@concrete_ctl = global [4 x i8] zeroinitializer
define i32 @concrete_body() {
entry:
  %p = getelementptr i8, ptr @concrete_ctl, i64 4
  %v = load volatile i8, ptr %p
  %r = call i32 @concrete_body_orig()
  ret i32 %r
}
#!/usr/bin/env python3
"""Compare the stage outputs of two independent slice-0 builds, byte for byte.

usage: repro_compare.py SIDE_A SIDE_B IDENTITY [MANIFEST]

Each SIDE holds `names` (the example inventory) and `out/NAME/STAGE` for every stage. Every file
is read on both sides: a missing file, a differing inventory or one differing byte fails. With
MANIFEST, writes the identity lines followed by one `SHA256  NAME/STAGE` line per artifact.
"""
import hashlib
import sys
from pathlib import Path

STAGES = ['bir.txt', 'llvm.ll', 'lcb_job.txt', 'lcb_source.txt', 'lcb_body.ssa', 'lcb_body.s',
          'lcb_rt.ssa', 'lcb_rt.s', 'llvm.o', 'lcb_body.o', 'lcb_rt.o', 'llvm.exe', 'lcb.exe']


def main(argv):
    if len(argv) not in (4, 5):
        sys.exit(__doc__)
    a, b, identity = Path(argv[1]), Path(argv[2]), Path(argv[3])
    names = (a / 'names').read_bytes()
    if names != (b / 'names').read_bytes():
        sys.exit('FAIL slice0_repro: example inventory differs')
    if not names.strip():
        sys.exit('FAIL slice0_repro: no examples')
    lines = identity.read_text().splitlines()
    for name in names.decode().splitlines():
        for stage in STAGES:
            try:
                hashes = [hashlib.sha256((d / 'out' / name / stage).read_bytes()).hexdigest()
                          for d in (a, b)]
            except FileNotFoundError as e:
                sys.exit(f'FAIL slice0_repro: {name}: {stage}: missing ({e.filename})')
            if hashes[0] != hashes[1]:
                sys.exit(f'FAIL slice0_repro: {name}: {stage}: {hashes[0]} != {hashes[1]}')
            lines.append(f'{hashes[0]}  {name}/{stage}')
        print(f'ok slice0_repro: {name}: all stages byte-identical')
    if len(argv) == 5:
        Path(argv[4]).write_text('\n'.join(lines) + '\n')


if __name__ == '__main__':
    main(sys.argv)

