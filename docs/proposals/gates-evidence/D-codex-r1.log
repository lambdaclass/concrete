+  let mut errors := []
+  for (n, kinds) in trustedDeclarations env localPrefix do
+    unless declarationListed n cs do
+      errors := errors ++ [s!"unlisted trusted declaration {n} [{", ".intercalate kinds}]"]
+  return errors
