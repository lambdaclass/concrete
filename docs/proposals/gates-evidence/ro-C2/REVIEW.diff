diff --git a/scripts/checks/compiler/determinism.sh b/scripts/checks/compiler/determinism.sh
new file mode 100755
index 00000000..fbeb8b8f
--- /dev/null
+++ b/scripts/checks/compiler/determinism.sh
@@ -0,0 +1,198 @@
+#!/usr/bin/env bash
+# Per-test determinism gate, the one-compiler-build complement of gate 8. Every bir: manifest row is
+# emitted and built natively twice from different absolute output paths, working directories, HOMEs,
+# TMPDIRs and opposite insertion orders of the same explicit env -i keys. Recursive inventories must
+# be equal and every emitted/native file byte-identical; required files also catch absence on both sides.
+# A second emit in the same Lean process checks in-process determinism. Gate 8 instead rebuilds the
+# compiler and LCB independently from two source copies and also compares cross-runner manifests.
+# slice0_native.sh normalizes its own children with env -i, so its step varies paths, cwd and TMPDIR.
+# Controls: a planted CWD in llvm.ll, planted monotonic time in lcb_body.s, and missing or extra files
+# must each fail for that named reason; a clean double run must pass. Plants require
+# --allow-planted-failure in slice0_bir.lean.
+#
+# usage: determinism.sh. Run inside nix develop. DETERMINISM_EMIT_ONLY=1 is the local smoke mode:
+# it builds only Concrete and omits native compilation (the normal gate always builds it and LCB).
+set -euo pipefail
+root=$(cd "$(dirname "$0")/../../.." && pwd)
+cd "$root"
+# shellcheck source=scripts/checks/lib/limits.sh
+source scripts/checks/lib/limits.sh
+gate_limits 64 40000
+work=$(mktemp -d)
+trap 'rc=$?; bounded_summary || true
+  if [ "$rc" = 0 ] && grep -Eqs "^(incomplete|runner-failed)" "${BOUNDED_LOG:-/nonexistent}"; then
+    echo "INCOMPLETE: a bounded run timed out twice; not a pass"; rc=3
+  fi
+  rm -rf "${work:?}"; exit "$rc"' EXIT
+BOUNDED_PARENT="$work"
+# shellcheck source=scripts/checks/lib/bounded.sh
+source scripts/checks/lib/bounded.sh
+[ "$BOUNDED_HAVE_WATCHDOG" = 1 ] || { echo "determinism: python3 is required for bounded runs" >&2; exit 2; }
+bounded() {
+  local secs=$1 rc=0
+  shift
+  bounded_run -i /dev/null "$secs" -- "$@" || rc=$?
+  if [ "$rc" != 0 ] && bounded_is_incomplete "$rc"; then
+    echo "determinism: INCOMPLETE (timed out twice): $*" >&2
+  fi
+  return "$rc"
+}
+emit_only=${DETERMINISM_EMIT_ONLY:-0}
+case "$emit_only" in 0|1) ;; *) echo "determinism: DETERMINISM_EMIT_ONLY must be 0 or 1" >&2; exit 2 ;; esac
+if [ "$emit_only" = 1 ]; then
+  bounded 1800 lake build Concrete >"$work/lake-build.log" 2>&1 ||
+    { tail -n 100 "$work/lake-build.log" >&2; exit 1; }
+else
+  bounded 1800 lake build Concrete lean-compiler-backend/lcb >"$work/lake-build.log" 2>&1 ||
+    { tail -n 100 "$work/lake-build.log" >&2; exit 1; }
+fi
+lcb=$root/.lake/packages/lean-compiler-backend/.lake/build/bin/lcb
+case "$(uname -s)-$(uname -m)" in
+  Linux-x86_64) target=x86_64-linux ;;
+  Linux-aarch64) target=aarch64-linux ;;
+  Darwin-arm64) target=aarch64-macos ;;
+  *) echo "determinism: unsupported host $(uname -s)-$(uname -m)" >&2; exit 2 ;;
+esac
+lake_cmd=$(command -v lake)
+driver=$root/scripts/checks/compiler/slice0_bir.lean
+manifest=${CONCRETE_TEST_MANIFEST:-tests/manifest.tsv}
+bounded 30 python3 -I "$root/scripts/checks/lib/test_manifest.py" rows --kind bir "$manifest" >"$work/rows"
+[ -s "$work/rows" ] || { echo "determinism: no bir tests" >&2; exit 1; }
+awk -F '\t' '{print $1}' "$work/rows" >"$work/names"
+awk -F '\t' '{sub(/^bir:/, "", $2); print $2}' "$work/rows" | LC_ALL=C sort >"$work/manifest-programs"
+bounded 120 "$lake_cmd" --dir "$root" env lean --run "$driver" list | LC_ALL=C sort >"$work/emitter-programs"
+if [ "$emit_only" = 0 ]; then
+  cmp -s "$work/manifest-programs" "$work/emitter-programs" ||
+    { echo "determinism: test manifest inventory differs from emitter" >&2; exit 1; }
+fi
+printf 'one compiler build; per-test determinism\n' >"$work/identity"
+emitted=bir.txt,llvm.ll,lcb_job.txt,lcb_source.txt,lcb_body.ssa,lcb_body.s,lcb_rt.ssa,status,stderr
+all=$emitted,lcb_rt.s,llvm.o,lcb_body.o,lcb_rt.o,llvm.exe,lcb.exe
+compare=(python3 -I "$root/scripts/checks/lib/repro_compare.py" --inventory --label slice0_determinism)
+
+a=$work/first/output-with-one-absolute-path
+b=$work/second/a-different-and-deliberately-longer-absolute-output-path
+for side in "$a" "$b"; do
+  mkdir -p "$side/out" "$side/home" "$side/tmp"
+  cp "$work/names" "$side/names"
+done
+
+emit_one() { # emit_one SIDE CWD NAME PROGRAM EXPECT [PLANT]
+  local side=$1 cwd=$2 name=$3 program=$4 expect=$5 plant=${6:-}
+  local out=$side/out/$name
+  local -a expectation plant_args envs
+  read -r -a expectation <<<"$expect"
+  plant_args=()
+  [ -z "$plant" ] || plant_args=(--allow-planted-failure --plant "$plant")
+  if [ "$side" = "$a" ]; then
+    envs=("PATH=$PATH" "HOME=$side/home" "TMPDIR=$side/tmp" LC_ALL=C TZ=UTC SOURCE_DATE_EPOCH=1 ZERO_AR_DATE=1)
+  else
+    envs=(ZERO_AR_DATE=1 SOURCE_DATE_EPOCH=1 TZ=UTC LC_ALL=C "TMPDIR=$side/tmp" "HOME=$side/home" "PATH=$PATH")
+  fi
+  (cd "$cwd" && bounded 120 env -i "${envs[@]}" "$lake_cmd" --dir "$root" env lean --run "$driver" emit \
+    "${program#bir:}" "$out" "$target" "${expectation[@]}" ${plant_args[@]+"${plant_args[@]}"})
+}
+
+native_one() { # native_one SIDE NAME
+  local side=$1
+  local name=$2
+  local out=$side/out/$name
+  local log=$side/$name.native.log
+  local -a envs
+  if [ "$side" = "$a" ]; then
+    envs=("PATH=$PATH" "HOME=$side/home" "TMPDIR=$side/tmp" LC_ALL=C TZ=UTC SOURCE_DATE_EPOCH=1
+      ZERO_AR_DATE=1 "CONCRETE_SLICE0_CLANG=$CONCRETE_SLICE0_CLANG")
+  else
+    envs=("CONCRETE_SLICE0_CLANG=$CONCRETE_SLICE0_CLANG" ZERO_AR_DATE=1 SOURCE_DATE_EPOCH=1 TZ=UTC
+      LC_ALL=C "TMPDIR=$side/tmp" "HOME=$side/home" "PATH=$PATH")
+  fi
+  if ! (cd "$side" && bounded 300 env -i "${envs[@]}" \
+      bash "$root/scripts/checks/lib/slice0_native.sh" "$out" "$lcb") >"$log" 2>&1; then
+    cat "$log" >&2
+    echo "FAIL slice0_determinism: $name: native build failed" >&2
+    exit 1
+  fi
+}
+
+first_name= first_program= first_expect=
+while IFS=$'\t' read -r name program expect; do
+  if [ -z "$first_name" ]; then first_name=$name first_program=$program first_expect=$expect; fi
+  emit_one "$a" "$root" "$name" "$program" "$expect"
+  emit_one "$b" "$root/scripts" "$name" "$program" "$expect"
+  if [ "$emit_only" = 0 ]; then
+    native_one "$a" "$name"
+    native_one "$b" "$name"
+  fi
+
+  same=$work/same/$name
+  mkdir -p "$same/a/out/$name" "$same/b/out/$name"
+  printf '%s\n' "$name" >"$same/a/names"
+  cp "$same/a/names" "$same/b/names"
+  read -r -a expectation <<<"$expect"
+  bounded 120 "$lake_cmd" --dir "$root" env lean --run "$driver" emit-twice "${program#bir:}" \
+    "$same/a/out/$name" "$same/b/out/$name" "$target" "${expectation[@]}"
+  "${compare[@]}" --required "$emitted" "$same/a" "$same/b" "$work/identity"
+done <"$work/rows"
+
+required=$all
+[ "$emit_only" = 0 ] || required=$emitted
+"${compare[@]}" --required "$required" "$a" "$b" "$work/identity"
+echo 'ok slice0_determinism: clean double run'
+
+control_compare() { # control_compare LABEL ARTIFACT SIDE_A SIDE_B REQUIRED
+  local label=$1 artifact=$2 ca=$3 cb=$4 selected=$5 rc=0
+  local log=$work/control-$label.log
+  "${compare[@]}" --required "$selected" "$ca" "$cb" "$work/identity" >"$log" 2>&1 || rc=$?
+  if [ "$rc" = 0 ] || ! grep -qF "$first_name: $artifact:" "$log"; then
+    echo "FAIL slice0_determinism control $label: comparator did not name $artifact" >&2
+    cat "$log" >&2
+    exit 1
+  fi
+  cat "$log"
+  echo "ok slice0_determinism control $label: refused for the planted reason"
+}
+for plant in nondeterministic monotonic; do
+  c=$work/control-$plant
+  for side in ca cb; do
+    mkdir -p "$c/$side/out" "$c/$side/home" "$c/$side/tmp"
+    printf '%s\n' "$first_name" >"$c/$side/names"
+  done
+  # Reuse emit_one's environment variations by making the control paths the two known sides.
+  old_a=$a old_b=$b
+  a=$c/ca b=$c/cb
+  emit_one "$a" "$root" "$first_name" "$first_program" "$first_expect" "$plant"
+  # The CWD plant needs distinct CWDs; the time plant is deliberately run from the same CWD.
+  cwd=$root
+  [ "$plant" != nondeterministic ] || cwd=$root/scripts
+  emit_one "$b" "$cwd" "$first_name" "$first_program" "$first_expect" "$plant"
+  a=$old_a b=$old_b
+  artifact=llvm.ll
+  [ "$plant" != monotonic ] || artifact=lcb_body.s
+  control_compare "$plant" "$artifact" "$c/ca" "$c/cb" "$emitted"
+done
+
+c=$work/control-missing
+mkdir -p "$c"
+cp -R "$a" "$c/a"
+cp -R "$a" "$c/b"
+rm "$c/b/out/$first_name/lcb_body.s"
+control_compare missing-artifact lcb_body.s "$c/a" "$c/b" "$required"
+
+c=$work/control-extra
+mkdir -p "$c"
+cp -R "$a" "$c/a"
+cp -R "$a" "$c/b"
+touch "$c/b/out/$first_name/unexpected.extra"
+control_compare extra-artifact unexpected.extra "$c/a" "$c/b" "$required"
+
+rc=0
+read -r -a first_expectation <<<"$first_expect"
+(cd "$root" && bounded 120 "$lake_cmd" --dir "$root" env lean --run "$driver" emit "${first_program#bir:}" \
+  "$work/refused" "$target" "${first_expectation[@]}" --plant nondeterministic) >"$work/refusal.log" 2>&1 || rc=$?
+if [ "$rc" != 2 ] || ! grep -qF 'plant without --allow-planted-failure' "$work/refusal.log"; then
+  echo 'FAIL slice0_determinism control refusal: plant did not require the explicit flag' >&2
+  cat "$work/refusal.log" >&2
+  exit 1
+fi
+echo 'ok slice0_determinism control refusal: explicit flag required'
+echo 'PASS slice0_determinism'
diff --git a/scripts/checks/compiler/scaling.lean b/scripts/checks/compiler/scaling.lean
new file mode 100644
index 00000000..cd7e858b
--- /dev/null
+++ b/scripts/checks/compiler/scaling.lean
@@ -0,0 +1,168 @@
+import Concrete
+
+/-!
+Deterministic BIR scaling family and in-process stage timer. This is test machinery, not a
+compiler stage. `scaled k rep` has one checked operation and trap branch, one wrapping operation
+and one truncation per repetition; block arguments carry every result into the next repetition.
+The repetition number changes only source-site metadata, preventing hoisting/CSE across timings.
+
+`lean --run` measures the interpreted compiler. That is the compiler available today (the `concrete`
+executable does not exist yet), and exponents over the same interpreted stages are the useful signal
+until an executable exists; absolute times are not claimed to predict a future native executable.
+-/
+
+open Concrete.BIR Concrete.Backend
+
+private def site (rep i : Nat) : SiteEntry :=
+  ⟨.arithmeticOverflow, ⟨i⟩, ⟨rep + 4 * i, rep + 4 * i + 3⟩,
+    ⟨"tests/slice0/scaled.con", rep + i + 1, 1⟩⟩
+
+private def bodyBlock (k i : Nat) : Block :=
+  let base := 6 * i
+  let previous : Operand := if i = 0 then .imm .u8 1 else .reg base
+  let next := if i + 1 = k then 2 * k else 2 * (i + 1)
+  { params := if i = 0 then [] else [(base, .int .u8)]
+    insts := [
+      .trunc .u8 .u16 (base + 1) previous,
+      .binOvf .add .u16 (base + 2) (base + 3) (.reg (base + 1)) (.imm .u16 0),
+      .bin .add .u16 (base + 4) (.reg (base + 2)) (.imm .u16 0),
+      .trunc .u16 .u8 (base + 5) (.reg (base + 4))]
+    term := .condbr (base + 3) (2 * i + 1) [] next [.reg (base + 5)] }
+
+/-- A linear-size, non-dead family whose expected result is always `exited 1`. -/
+def scaled (k rep : Nat) : Program :=
+  { blocks := (List.range k).flatMap (fun i =>
+        [bodyBlock k i, { params := [], insts := [], term := .trap i }]) ++
+      [{ params := [(6 * k, .int .u8)], insts := [], term := .ret (.reg (6 * k)) }]
+    sites := (List.range k).map (site rep) }
+
+private def instructions (p : Program) : List Inst := p.blocks.flatMap (·.insts)
+
+private def scan (is : List Inst) : Nat := is.foldl (fun n i => n + i.defs.length) 0
+
+private def plantLinear (p : Program) : Nat :=
+  let is := instructions p
+  (List.range 16384).foldl (fun n _ => n + scan is) 0
+
+private def plantQuadratic (p : Program) : Nat :=
+  let is := instructions p
+  (List.range (256 * is.length)).foldl (fun n _ => n + scan is) 0
+
+private def terminatorDigest : LeanCompilerBackend.Verified.Source.Terminator → Nat
+  | .ret _ => 1
+  | .jump target => target + 2
+  | .branch _ yes no => yes + no + 3
+
+private def blockDigest (b : LeanCompilerBackend.Verified.Source.Block) : Nat :=
+  b.instructions.size + b.phis.foldl (fun n phi => n + phi.incoming.size) 0 +
+    terminatorDigest b.terminator
+
+/-- Linear structural forcing: every block, phi arm, instruction count and terminator is visited,
+with no `repr` or string construction. -/
+private def forceEmit : Except String (LeanCompilerBackend.Verified.Source.Function × SiteTable) → Nat
+  | .ok (f, sites) =>
+    f.blocks.foldl (fun n b => 33 * n + blockDigest b) (f.valueWidths.size + sites.length)
+  | .error msg => msg.length
+
+@[noinline] private def opaqueIdentity (x : α) : α := x
+
+/-- Evaluate `force result` in a branch BEFORE reading the second clock, so laziness cannot move the
+stage's work past the measurement. Returning the result lets the next measured stage consume it. -/
+private def timedPure (value : Unit → α) (force : α → Nat) : IO (α × Nat × Nat) := do
+  let start ← IO.monoNanosNow
+  let result := value ()
+  let digest := force result
+  match digest % 2 with
+  | 0 =>
+    let stop ← IO.monoNanosNow
+    return (result, stop - start, digest)
+  | _ =>
+    let stop ← IO.monoNanosNow
+    return (result, stop - start, digest)
+
+private def sample (rep k : Nat) (stage : String) (measurement : α × Nat × Nat) : IO Unit :=
+  IO.println s!"sample\t{rep}\t{k}\t{stage}\t{measurement.2.1}\t{measurement.2.2}"
+
+private def measureOne (rep k : Nat) (t : LCB.Target) (p : Program) (plant : Option String) :
+    IO Bool := do
+  match plant with
+  | some "linear" =>
+    let planted ← timedPure (fun _ => plantLinear (opaqueIdentity p)) id
+    sample rep k "plant_linear" planted
+    return true
+  | some "quadratic" =>
+    let planted ← timedPure (fun _ => plantQuadratic (opaqueIdentity p)) id
+    sample rep k "plant_quadratic" planted
+    return true
+  | some _ => IO.eprintln "unknown plant"; return false
+  | none =>
+    let llvm ← timedPure (fun _ => LLVM.module (opaqueIdentity p)) String.length
+    sample rep k "llvm_module" llvm
+    let emitted ← timedPure (fun _ => LCB.emit (opaqueIdentity p)) forceEmit
+    sample rep k "lcb_emit" emitted
+    match emitted.1 with
+    | .error msg => IO.eprintln s!"scaled {k}: LCB emit: {msg}"; return false
+    | .ok (f, _) =>
+      let assembly ← timedPure (fun _ => LCB.assemble t (opaqueIdentity f)) (fun
+        | .ok asm => asm.length
+        | .error msg => msg.length)
+      sample rep k "lcb_assemble" assembly
+      match assembly.1 with
+      | .error msg => IO.eprintln s!"scaled {k}: LCB assemble: {msg}"; return false
+      | .ok _ => return true
+
+private def validate (k : Nat) (p : Program) : IO Bool := do
+  unless wf p do IO.eprintln s!"scaled {k}: not well formed"; return false
+  unless run p (k + 2) == .exited 1 do
+    IO.eprintln s!"scaled {k}: expected exit 1, got {repr (run p (k + 2))}"; return false
+  return true
+
+private def runMeasurement (k0 repetitions : Nat) (targetName : String) (plant : Option String) : IO UInt32 := do
+  if k0 = 0 || repetitions = 0 then IO.eprintln "k0 and repetitions must be positive"; return 2
+  let some target := LCB.Target.ofName targetName
+    | IO.eprintln s!"unknown target {targetName}"; return 2
+  let sizes := [k0, 10 * k0, 100 * k0]
+  for k in sizes do unless ← validate k (scaled k 0) do return 1
+  IO.println s!"family\tk0={k0}\trepetitions={repetitions}\ttarget={targetName}\texpected=exit-1"
+  for rep in List.range repetitions do
+    for k in sizes do
+      unless ← measureOne rep k target (scaled k rep) plant do return 1
+  return 0
+
+private def emitInputs (k : Nat) (dir : System.FilePath) (targetName : String) : IO UInt32 := do
+  let p := scaled k 0
+  unless ← validate k p do return 1
+  let some target := LCB.Target.ofName targetName
+    | IO.eprintln s!"unknown target {targetName}"; return 2
+  match LCB.emit p with
+  | .error msg => IO.eprintln s!"scaled {k}: LCB emit: {msg}"; return 1
+  | .ok (f, sites) =>
+    match LCB.assemble target f with
+    | .error msg => IO.eprintln s!"scaled {k}: LCB assemble: {msg}"; return 1
+    | .ok asm =>
+      IO.FS.createDirAll dir
+      IO.FS.writeFile (dir / "llvm.ll") (LLVM.module p)
+      IO.FS.writeFile (dir / "lcb_body.s") asm
+      IO.FS.writeFile (dir / "lcb_rt.ssa") (Runtime.qbe sites)
+      return 0
+
+private def parsePlant : List String → Option (Option String)
+  | [] => some none
+  | ["--allow-planted-failure", "--plant", "linear"] => some (some "linear")
+  | ["--allow-planted-failure", "--plant", "quadratic"] => some (some "quadratic")
+  | _ => none
+
+def main (args : List String) : IO UInt32 := do
+  match args with
+  | ["emit", k, dir, target] => match k.toNat? with
+    | some n => emitInputs n dir target
+    | none => IO.eprintln "emit: K must be a natural"; return 2
+  | "measure" :: k :: reps :: target :: plantArgs =>
+    match k.toNat?, reps.toNat?, parsePlant plantArgs with
+    | some n, some r, some plant => runMeasurement n r target plant
+    | _, _, none =>
+      IO.eprintln "plants require --allow-planted-failure --plant linear|quadratic"; return 2
+    | _, _, _ => IO.eprintln "measure: K0 and REPETITIONS must be naturals"; return 2
+  | _ =>
+    IO.eprintln "usage: scaling.lean emit K DIR TARGET | measure K0 REPETITIONS TARGET [--allow-planted-failure --plant linear|quadratic]"
+    return 2
diff --git a/scripts/checks/compiler/scaling.sh b/scripts/checks/compiler/scaling.sh
new file mode 100755
index 00000000..6af4b5b5
--- /dev/null
+++ b/scripts/checks/compiler/scaling.sh
@@ -0,0 +1,188 @@
+#!/usr/bin/env bash
+# Scaling gate (x86-64 Linux only): one machine, one job. Generated BIR at k0, 10*k0 and 100*k0 is
+# checked by the Lean evaluator, then every in-process backend stage and the native step are timed.
+# Repetitions are interleaved across sizes and the minimum is used. The 10x->100x exponent must be
+# at most SCALING_MAX_EXPONENT (default 1.35); 100x in-process stages must be at least
+# SCALING_MIN_STAGE_NS (default 10 ms), and native at least SCALING_MIN_NATIVE_NS (default 100 ms).
+# k0=1 gives 201 blocks and about 58 KiB of LLVM at 100x; smoke measurements put all real in-process
+# stages above 10 ms there, so k0=2 is unnecessary and would make the currently slow adapter exceed
+# the approximately ten-minute budget. scaling.tsv records every minimum and both exponents.
+# Hosted macOS runners are shared VMs; exponents there are not comparable, so x86-64-only is a decision.
+# lean --run measures the interpreted compiler, the only compiler available until concrete exists.
+#
+# usage: scaling.sh [REPORT_DIR] [--allow-planted-failure --plant linear|quadratic]
+# SCALING_IN_PROCESS_ONLY=1 omits native timing for local smoke runs. Every normal run automatically
+# checks linear PASS and quadratic FAIL controls without rebuilding; they measure/analyze only their
+# planted stage, so independent pipeline scaling defects (ISS-0030) cannot mask them. A control's
+# validation, timeout, resolution, inventory or unexpected verdict is a "control setup" failure.
+set -euo pipefail
