            # the only one allowed to attach; not pinned, its identity is recorded in the report).
            CONCRETE_SLICE0_LLVM = "${pkgs.llvmPackages_21.llvm}/bin";
          } // pkgs.lib.optionalAttrs pkgs.stdenv.isLinux {
            CONCRETE_SLICE0_GDB = "${pkgs.gdb}/bin/gdb";
          } // pkgs.lib.optionalAttrs pkgs.stdenv.isDarwin {
            CONCRETE_SLICE0_LLDB = "/usr/bin/lldb";
          } // gatesMarker);

          # `nix develop .#gates` — what CI runs every gate step in: the gate userland, the marker,
          # and no compiler toolchain (mkShellNoCC, so not even stdenv's cc). Lean and the C
          # toolchain come from the runner, exactly as before.
          gates = pkgs.mkShellNoCC ({ packages = gatesUserland; } // gatesMarker);

          # `nix develop .#extcheck` — the gate userland plus cargo and rustc, for
          # scripts/proofs/external.sh, which builds the pinned nanoda checker (a Rust program) once
          # per revision. mkShell, not NoCC: rustc links through the C compiler. Lean still comes
          # from elan, as in the gates shell.
          extcheck = pkgs.mkShell ({ packages = gatesUserland ++ [ pkgs.cargo pkgs.rustc ]; } // gatesMarker);

          # `nix develop .#provers` — adds the independent second kernels.
        });
    };
}
     1	#!/usr/bin/env bash
     2	# Scaling gate (x86-64 Linux only): one machine, one job. Generated BIR at k0, 10*k0 and 100*k0 is
     3	# checked by the Lean evaluator, then every in-process backend stage and the native step are timed.
     4	# Repetitions are interleaved across sizes and the minimum is used. The 10x->100x exponent must be
     5	# at most SCALING_MAX_EXPONENT (default 1.35); 100x in-process stages must be at least
     6	# SCALING_MIN_STAGE_NS (default 10 ms). k0=1 gives 201 blocks and about 58 KiB of LLVM at 100x;
     7	# smoke measurements put all real in-process stages above 10 ms there, so k0=2 is unnecessary and
     8	# would make the currently slow adapter exceed the job's approximately ten-minute budget.
     9	# scaling.tsv records every minimum and both exponents. Native macOS hosted runners are too noisy
    10	# for this gate, which therefore refuses non-x86-64-Linux hosts.
    11	#
    12	# usage: scaling.sh [REPORT_DIR] [--allow-planted-failure --plant linear|quadratic]
    13	# SCALING_IN_PROCESS_ONLY=1 omits native timing for local smoke runs. Plant controls also omit it
    14	# and analyze only the planted stage, so an independent pipeline scaling defect cannot mask them.
    15	set -euo pipefail
    16	root=$(cd "$(dirname "$0")/../../.." && pwd)
    17	cd "$root"
    18	# shellcheck source=scripts/checks/lib/limits.sh
    19	source scripts/checks/lib/limits.sh
    20	gate_limits 64 40000
    21	work=$(mktemp -d)
    22	trap 'rc=$?; bounded_summary || true
    23	  if [ "$rc" = 0 ] && grep -Eqs "^(incomplete|runner-failed)" "${BOUNDED_LOG:-/nonexistent}"; then
    24	    echo "INCOMPLETE: a bounded run timed out twice; not a pass"; rc=3
    25	  fi
    26	  rm -rf "${work:?}"; exit "$rc"' EXIT
    27	BOUNDED_PARENT="$work"
    28	# shellcheck source=scripts/checks/lib/bounded.sh
    29	source scripts/checks/lib/bounded.sh
    30	[ "$BOUNDED_HAVE_WATCHDOG" = 1 ] || { echo "scaling: python3 is required for bounded runs" >&2; exit 2; }
    31	bounded() {
    32	  local secs=$1 rc=0
    33	  shift
    34	  bounded_run -i /dev/null "$secs" -- "$@" || rc=$?
    35	  if [ "$rc" != 0 ] && bounded_is_incomplete "$rc"; then
    36	    echo "scaling: INCOMPLETE (timed out twice): $*" >&2
    37	  fi
    38	  return "$rc"
    39	}
    40	
    41	report=$work/report
    42	if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then report=$1; shift; fi
    43	plant=
    44	if [ "$#" -gt 0 ]; then
    45	  [ "$#" = 3 ] && [ "$1" = --allow-planted-failure ] && [ "$2" = --plant ] &&
    46	    { [ "$3" = linear ] || [ "$3" = quadratic ]; } ||
    47	    { echo "scaling: plants require --allow-planted-failure --plant linear|quadratic" >&2; exit 2; }
    48	  plant=$3
    49	fi
    50	k0=${SCALING_K0:-1}
    51	repetitions=${SCALING_REPETITIONS:-5}
    52	max_exponent=${SCALING_MAX_EXPONENT:-1.35}
    53	min_stage_ns=${SCALING_MIN_STAGE_NS:-10000000}
    54	in_process_only=${SCALING_IN_PROCESS_ONLY:-0}
    55	[ -n "$plant" ] && in_process_only=1
    56	case "$(uname -s)-$(uname -m)" in
    57	  Linux-x86_64) target=x86_64-linux ;;
    58	  *) echo "scaling: runs only on x86-64 Linux (one machine, one job)" >&2; exit 2 ;;
    59	esac
    60	case "$in_process_only" in 0|1) ;; *) echo "scaling: SCALING_IN_PROCESS_ONLY must be 0 or 1" >&2; exit 2 ;; esac
    61	mkdir -p "$report"
    62	samples=$work/samples.tsv
    63	: >"$samples"
    64	driver=(lake env lean --run "$root/scripts/checks/compiler/scaling.lean")
    65	if [ "$in_process_only" = 1 ]; then
    66	  bounded 1800 lake build Concrete >"$work/lake-build.log" 2>&1 ||
    67	    { tail -n 100 "$work/lake-build.log" >&2; exit 1; }
    68	else
    69	  bounded 1800 lake build Concrete lean-compiler-backend/lcb >"$work/lake-build.log" 2>&1 ||
    70	    { tail -n 100 "$work/lake-build.log" >&2; exit 1; }
    71	fi
    72	plant_args=()
    73	[ -z "$plant" ] || plant_args=(--allow-planted-failure --plant "$plant")
    74	bounded 600 "${driver[@]}" measure "$k0" "$repetitions" "$target" ${plant_args[@]+"${plant_args[@]}"} \
    75	  >"$work/in-process.tsv"
    76	cat "$work/in-process.tsv" >>"$samples"
    77	
    78	if [ "$in_process_only" = 0 ]; then
    79	  lcb=$root/.lake/packages/lean-compiler-backend/.lake/build/bin/lcb
    80	  for k in "$k0" "$((10 * k0))" "$((100 * k0))"; do
    81	    bounded 600 "${driver[@]}" emit "$k" "$work/native/$k" "$target"
    82	  done
    83	  now_ns() { python3 -I -c 'import time; print(time.monotonic_ns())'; }
    84	  for ((rep = 0; rep < repetitions; rep++)); do
    85	    for k in "$k0" "$((10 * k0))" "$((100 * k0))"; do
    86	      log=$work/native/$k/build-$rep.log
    87	      start=$(now_ns)
    88	      if bounded 300 bash "$root/scripts/checks/lib/slice0_native.sh" "$work/native/$k" "$lcb" >"$log" 2>&1; then
    89	        stop=$(now_ns)
    90	        printf 'sample\t%s\t%s\tnative\t%s\t0\n' "$rep" "$k" "$((stop - start))" >>"$samples"
    91	      else
    92	        cat "$log" >&2
    93	        echo "FAIL scaling: native build failed at size $k repetition $rep" >&2
    94	        exit 1
    95	      fi
    96	    done
    97	  done
    98	fi
    99	
   100	report_args=()
   101	[ -z "$plant" ] || report_args=(--only-plant "$plant")
   102	bounded 60 python3 -I "$root/scripts/checks/lib/scaling_report.py" "$samples" "$report/scaling.tsv" \
   103	  --k0 "$k0" --repetitions "$repetitions" --max-exponent "$max_exponent" \
   104	  --min-stage-ns "$min_stage_ns" ${report_args[@]+"${report_args[@]}"}
     1	#!/usr/bin/env python3
     2	"""Summarize interleaved scaling samples and enforce the exponent/resolution limits."""
     3	
     4	import argparse
     5	import math
     6	import sys
     7	from collections import defaultdict
     8	
     9	CORE = ["llvm_module", "lcb_emit", "lcb_assemble"]
    10	
    11	
    12	def exponent(small, large):
    13	    if small <= 0 or large <= 0:
    14	        raise ValueError("stage times must be positive")
    15	    return math.log(large / small) / math.log(10)
    16	
    17	
    18	def main():
    19	    parser = argparse.ArgumentParser()
    20	    parser.add_argument("samples")
    21	    parser.add_argument("report")
    22	    parser.add_argument("--k0", type=int, required=True)
    23	    parser.add_argument("--repetitions", type=int, required=True)
    24	    parser.add_argument("--max-exponent", type=float, required=True)
    25	    parser.add_argument("--min-stage-ns", type=int, required=True)
    26	    parser.add_argument("--only-plant", choices=["linear", "quadratic"])
    27	    args = parser.parse_args()
    28	    if args.k0 <= 0 or args.repetitions <= 0 or args.max_exponent <= 0 or args.min_stage_ns < 0:
    29	        parser.error("k0/repetitions/max-exponent must be positive and min-stage-ns nonnegative")
    30	
    31	    samples = defaultdict(dict)
    32	    with open(args.samples, encoding="utf-8") as stream:
    33	        for line_number, line in enumerate(stream, 1):
    34	            fields = line.rstrip("\n").split("\t")
    35	            if not fields or fields[0] != "sample":
    36	                continue
    37	            if len(fields) != 6:
    38	                sys.exit(f"FAIL scaling: malformed sample at line {line_number}")
    39	            _, rep, k, stage, nanos, _ = fields
    40	            samples[stage][(int(rep), int(k))] = int(nanos)
    41	    if args.only_plant:
    42	        wanted = "plant_" + args.only_plant
    43	        samples = {wanted: samples[wanted]} if wanted in samples else {}
    44	    else:
    45	        per_rep = defaultdict(dict)
    46	        for stage, values in samples.items():
    47	            for key, nanos in values.items():
    48	                per_rep[key][stage] = nanos
    49	        derived = {"in_process_total": {}, "total": {}}
    50	        for key, stages in per_rep.items():
    51	            if all(stage in stages for stage in CORE):
    52	                derived["in_process_total"][key] = sum(stages[stage] for stage in CORE)
    53	                if "native" in stages:
    54	                    derived["total"][key] = stages["native"] + derived["in_process_total"][key]
    55	        samples.update({stage: values for stage, values in derived.items() if values})
    56	    if not samples:
    57	        sys.exit("FAIL scaling: no samples")
    58	
    59	    sizes = [args.k0, 10 * args.k0, 100 * args.k0]
    60	    expected_keys = {(rep, k) for rep in range(args.repetitions) for k in sizes}
    61	    lines = [
    62	        f"# k0={args.k0}; sizes={sizes[0]},{sizes[1]},{sizes[2]}; repetitions={args.repetitions}",
    63	        f"# minimum per size; max_exponent={args.max_exponent:.3f}; min_100x_stage_ns={args.min_stage_ns}",
    64	        "stage\t1x_ms\t10x_ms\t100x_ms\texponent_1x_10x\texponent_10x_100x",
    65	    ]
    66	    failures = []
    67	    for stage in sorted(samples):
    68	        values = samples[stage]
    69	        missing = expected_keys - values.keys()
    70	        if missing:
    71	            failures.append(f"FAIL scaling: stage {stage}: incomplete samples ({len(missing)} missing)")
    72	            continue
    73	        minima = [min(values[(rep, k)] for rep in range(args.repetitions)) for k in sizes]
    74	        try:
    75	            exponents = [exponent(minima[i], minima[i + 1]) for i in range(2)]
    76	        except ValueError as error:
    77	            failures.append(f"FAIL scaling: stage {stage}: {error}")
    78	            continue
    79	        lines.append("{}\t{:.3f}\t{:.3f}\t{:.3f}\t{:.3f}\t{:.3f}".format(
    80	            stage, *(nanos / 1_000_000 for nanos in minima), *exponents))
    81	        if stage != "native" and minima[2] < args.min_stage_ns:
    82	            failures.append(
    83	                f"FAIL scaling: stage {stage}: 100x minimum {minima[2]} ns is below resolution "
    84	                f"{args.min_stage_ns} ns; increase SCALING_K0")
    85	        if exponents[1] > args.max_exponent:
    86	            failures.append(
    87	                f"FAIL scaling: stage {stage} exponent 10x->100x = {exponents[1]:.3f} "
    88	                f"exceeds {args.max_exponent:.3f}")
    89	    text = "\n".join(lines) + "\n"
    90	    with open(args.report, "w", encoding="utf-8") as stream:
    91	        stream.write(text)
    92	    sys.stdout.write(text)
    93	    for failure in failures:
    94	        print(failure)
    95	    if failures:
    96	        sys.exit(1)
    97	    print(f"PASS scaling: all 10x->100x exponents are at most {args.max_exponent:.3f}")
    98	
    99	
   100	if __name__ == "__main__":
   101	    main()
