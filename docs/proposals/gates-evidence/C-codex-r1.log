   127	      IO.FS.writeFile (dir / "lcb_rt.ssa") (Runtime.qbe sites)
   128	      return 0
   129	
   130	private def parsePlant : List String → Option (Option String)
   131	  | [] => some none
   132	  | ["--allow-planted-failure", "--plant", "linear"] => some (some "linear")
