     1	import Concrete
     2	
     3	/-!
     4	Deterministic BIR scaling family and in-process stage timer. This is test machinery, not a
     5	compiler stage. `scaled k` has one checked operation and trap branch, one wrapping operation and
     6	one truncation per repetition; block arguments carry every result into the next repetition.
     7	-/
     8	
     9	open Concrete.BIR Concrete.Backend
    10	
    11	private def site (i : Nat) : SiteEntry :=
    12	  ⟨.arithmeticOverflow, ⟨i⟩, ⟨4 * i, 4 * i + 3⟩, ⟨"tests/slice0/scaled.con", i + 1, 1⟩⟩
    13	
    14	private def bodyBlock (k i : Nat) : Block :=
    15	  let base := 6 * i
    16	  let previous : Operand := if i = 0 then .imm .u8 1 else .reg base
    17	  let next := if i + 1 = k then 2 * k else 2 * (i + 1)
    18	  { params := if i = 0 then [] else [(base, .int .u8)]
    19	    insts := [
    20	      .trunc .u8 .u16 (base + 1) previous,
    21	      .binOvf .add .u16 (base + 2) (base + 3) (.reg (base + 1)) (.imm .u16 0),
    22	      .bin .add .u16 (base + 4) (.reg (base + 2)) (.imm .u16 0),
    23	      .trunc .u16 .u8 (base + 5) (.reg (base + 4))]
    24	    term := .condbr (base + 3) (2 * i + 1) [] next [.reg (base + 5)] }
    25	
    26	/-- A linear-size, non-dead family whose expected result is always `exited 1`. -/
    27	def scaled (k : Nat) : Program :=
    28	  { blocks := (List.range k).flatMap (fun i =>
    29	        [bodyBlock k i, { params := [], insts := [], term := .trap i }]) ++
    30	      [{ params := [(6 * k, .int .u8)], insts := [], term := .ret (.reg (6 * k)) }]
    31	    sites := (List.range k).map site }
    32	
    33	private def instructions (p : Program) : List Inst := p.blocks.flatMap (·.insts)
    34	
    35	private def scan (is : List Inst) : Nat := is.foldl (fun n i => n + i.defs.length) 0
    36	
    37	private def plantLinear (p : Program) : Nat :=
    38	  let is := instructions p
    39	  (List.range 16384).foldl (fun n _ => n + scan is) 0
    40	
    41	private def plantQuadratic (p : Program) : Nat :=
    42	  let is := instructions p
    43	  (List.range (256 * is.length)).foldl (fun n _ => n + scan is) 0
    44	
    45	private def forceEmit : Except String (LeanCompilerBackend.Verified.Source.Function × SiteTable) → Nat
    46	  | .ok (f, sites) => (reprStr f).length + sites.length
    47	  | .error msg => msg.length
    48	
    49	/-- Evaluate `force result` in a branch BEFORE reading the second clock, so laziness cannot move the
    50	stage's work past the measurement. Returning the result lets the next measured stage consume it. -/
    51	private def timedPure (value : Unit → α) (force : α → Nat) : IO (α × Nat × Nat) := do
    52	  let start ← IO.monoNanosNow
    53	  let result := value ()
    54	  let digest := force result
    55	  match digest % 2 with
    56	  | 0 =>
    57	    let stop ← IO.monoNanosNow
    58	    return (result, stop - start, digest)
    59	  | _ =>
    60	    let stop ← IO.monoNanosNow
    61	    return (result, stop - start, digest)
    62	
    63	private def sample (rep k : Nat) (stage : String) (measurement : α × Nat × Nat) : IO Unit :=
    64	  IO.println s!"sample\t{rep}\t{k}\t{stage}\t{measurement.2.1}\t{measurement.2.2}"
    65	
    66	private def measureOne (rep k : Nat) (t : LCB.Target) (p : Program) (plant : Option String) :
    67	    IO Bool := do
