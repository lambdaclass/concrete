    90	        sample rep k "plant_quadratic" planted
    91	        return true
    92	      | some _ => IO.eprintln "unknown plant"; return false
    93	
    94	private def validate (k : Nat) (p : Program) : IO Bool := do
    95	  unless wf p do IO.eprintln s!"scaled {k}: not well formed"; return false
    96	  unless run p (k + 2) == .exited 1 do
    97	    IO.eprintln s!"scaled {k}: expected exit 1, got {repr (run p (k + 2))}"; return false
    98	  return true
    99	
   100	private def runMeasurement (k0 repetitions : Nat) (targetName : String) (plant : Option String) : IO UInt32 := do
   101	  if k0 = 0 || repetitions = 0 then IO.eprintln "k0 and repetitions must be positive"; return 2
   102	  let some target := LCB.Target.ofName targetName
   103	    | IO.eprintln s!"unknown target {targetName}"; return 2
   104	  let sizes := [k0, 10 * k0, 100 * k0]
   105	  let programs := sizes.map (fun k => (k, scaled k))
   106	  for (k, p) in programs do unless ← validate k p do return 1
   107	  IO.println s!"family\tk0={k0}\trepetitions={repetitions}\ttarget={targetName}\texpected=exit-1"
   108	  for rep in List.range repetitions do
   109	    for (k, p) in programs do
   110	      unless ← measureOne rep k target p plant do return 1
   111	  return 0
   112	
   113	private def emitInputs (k : Nat) (dir : System.FilePath) (targetName : String) : IO UInt32 := do
   114	  let p := scaled k
   115	  unless ← validate k p do return 1
   116	  let some target := LCB.Target.ofName targetName
   117	    | IO.eprintln s!"unknown target {targetName}"; return 2
   118	  match LCB.emit p with
   119	  | .error msg => IO.eprintln s!"scaled {k}: LCB emit: {msg}"; return 1
   120	  | .ok (f, sites) =>
   121	    match LCB.assemble target f with
   122	    | .error msg => IO.eprintln s!"scaled {k}: LCB assemble: {msg}"; return 1
   123	    | .ok asm =>
   124	      IO.FS.createDirAll dir
   125	      IO.FS.writeFile (dir / "llvm.ll") (LLVM.module p)
