    71	  sample rep k "lcb_emit" emitted
    72	  match emitted.1 with
    73	  | .error msg => IO.eprintln s!"scaled {k}: LCB emit: {msg}"; return false
    74	  | .ok (f, _) =>
    75	    let assembly ← timedPure (fun _ => LCB.assemble t f) (fun
    76	      | .ok asm => asm.length
    77	      | .error msg => msg.length)
