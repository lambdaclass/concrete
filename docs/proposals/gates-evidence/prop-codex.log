#!/usr/bin/env bash
# AXIOM INVENTORY: every theorem of the specification depends, transitively, on no axiom beyond
# propext, Quot.sound and Classical.choice (Q9.17), and the per-theorem inventory equals the golden
# list scripts/proofs/axioms.golden.
#
#   P  population: every module the ConcreteSpec sources declare is in the root's import closure (a
#      module outside it is neither built by default nor read here), and every module whose file
#      declares a theorem contributes one, so the population cannot shrink unnoticed;
#   A  every theorem's transitive axioms (Lean.collectAxioms) are among the standard three;
#   G  the inventory (`<theorem>\t<axioms>`) equals axioms.golden byte for byte. A theorem added,
#      removed or renamed, or one that starts or stops using an axiom, changes the golden in the same
#      commit, where review sees it. `--update` rewrites it from the build.
#
# NEGATIVE CONTROLS run the same code on bad inputs and require the failure: an axiom declared and
# used by a control theorem fails A naming it; new theorems, a private one included, differ from the
# golden; a golden missing a theorem, carrying an extra one, or
# recording other axioms fails G; a control module outside the import closure fails P.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../checks/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"
CHECK_NAME=PROOF-AXIOMS
source scripts/proofs/lib.sh
GOLDEN=scripts/proofs/axioms.golden

population theorems > "$TMP/inv.tsv" 2> "$TMP/inv.err" \
  || { cat "$TMP/inv.err" >&2; echo "error: the enumerator failed" >&2; exit 2; }
if [ "${1:-}" = --update ]; then
  { echo "# Per-theorem transitive axioms of ConcreteSpec (scripts/proofs/axioms.sh). Regenerate with"
    echo "# bash scripts/proofs/axioms.sh --update; review every changed line."
    cat "$TMP/inv.tsv"; } > "$GOLDEN"
  echo "wrote $GOLDEN ($(grep -c . "$TMP/inv.tsv") theorems)"; exit 0
fi

# nonstandard FILE → the theorems of an inventory with an axiom outside the standard three
nonstandard() {
  awk -F'\t' -v std=" $STANDARD_AXIOMS " '{ n = split($2, a, " ")
    for (i = 1; i <= n; i++) if (index(std, " " a[i] " ") == 0) { print $1 " (" a[i] ")"; break } }' "$1"
}
# golden_diff INVENTORY GOLDEN → the differing lines, empty when equal
golden_diff() { diff <(grep -v '^#' "$2") "$1" | grep '^[<>]'; }

echo "=== P: population ==="
population imported > "$TMP/imported.txt" || { no "PROOF_MODE=imported failed"; finish; }
GAP=$(closure_gap "$TMP/imported.txt")
[ -z "$GAP" ] && ok "all $(spec_modules | grep -c .) ConcreteSpec source modules are in the root's import closure" \
  || no "source modules outside the import closure of ConcreteSpec: $(echo $GAP)"
population modules > "$TMP/env-modules.txt" || { no "PROOF_MODE=modules failed"; finish; }
grep -rlE '^\s*(@\[[^]]*\]\s*)?(private |protected )*theorem ' ConcreteSpec ConcreteSpec.lean --include='*.lean' \
  | sed -E 's#\.lean$##; s#/#.#g' | sort -u > "$TMP/src-modules.txt"
UNSEEN=$(comm -13 <(sort -u "$TMP/env-modules.txt") "$TMP/src-modules.txt")
NTHM=$(grep -c . "$TMP/inv.tsv")
[ -s "$TMP/src-modules.txt" ] && [ -z "$UNSEEN" ] && [ "$NTHM" -ge 100 ] \
  && ok "$NTHM theorems from all $(grep -c . "$TMP/src-modules.txt") source modules that declare one" \
  || no "population: $NTHM theorems; modules declaring theorems but absent: $(echo $UNSEEN)"

echo "=== A: standard axioms only ==="
BAD=$(nonstandard "$TMP/inv.tsv")
[ -z "$BAD" ] && ok "every theorem's transitive axioms are among $STANDARD_AXIOMS ($(cut -f2 "$TMP/inv.tsv" | tr ' ' '\n' | grep . | sort | uniq -c | awk '{printf "%s%s %s", s, $2, $1; s=", "}'))" \
  || no "theorems using a non-standard axiom: $(echo $BAD | cut -c1-400)"

echo "=== G: golden list ==="
[ -f "$GOLDEN" ] || { no "$GOLDEN is missing (bash scripts/proofs/axioms.sh --update)"; finish; }
D=$(golden_diff "$TMP/inv.tsv" "$GOLDEN")
[ -z "$D" ] && ok "the inventory equals $GOLDEN ($NTHM theorems)" \
  || no "the inventory differs from $GOLDEN (< golden, > build; regenerate with --update and review): $(printf '%s\n' "$D" | head -10 | tr '\t\n' ' |')"

echo "=== negative controls ==="
cat > "$TMP/c-axiom.lean" <<'EOF'
axiom ConcreteSpecControl.extra : 1 = 2
theorem ConcreteSpecControl.usesExtra : 2 = 1 := ConcreteSpecControl.extra.symm
EOF
population theorems "$TMP/c-axiom.lean" > "$TMP/c-axiom.tsv" 2>"$TMP/c-axiom.err"
CB=$(nonstandard "$TMP/c-axiom.tsv")
[ "$CB" = "ConcreteSpecControl.usesExtra (ConcreteSpecControl.extra)" ] \
  && ok "control: a theorem using a declared axiom is refused, and only it ($CB)" \
  || no "control: the extra-axiom theorem was not refused alone: '$CB' $(head -2 "$TMP/c-axiom.err")"
cat > "$TMP/c-clean.lean" <<'EOF'
theorem ConcreteSpecControl.clean : 1 = 1 := rfl
private theorem ConcreteSpecControl.hidden : 2 = 2 := rfl
EOF
population theorems "$TMP/c-clean.lean" > "$TMP/c-clean.tsv" 2>/dev/null
# A private name carries the file it was declared in (`_private.<file>.0.…`); the temporary copy's
# name is random, so it is normalized before the comparison.
D=$(golden_diff "$TMP/c-clean.tsv" "$GOLDEN" | sed -E 's/^> _private\..*\.0\.ConcreteSpecControl\./> _private.0.ConcreteSpecControl./')
[ "$D" = "$(printf '> ConcreteSpecControl.clean\t\n> _private.0.ConcreteSpecControl.hidden\t')" ] \
  && ok "control: a new theorem, even axiom-free and even private, is a golden difference" \
  || no "control: new public and private theorems gave the diff '$D'"
FIRST=$(head -1 "$TMP/inv.tsv" | cut -f1)
grep -vF -- "$FIRST	" "$GOLDEN" > "$TMP/g-missing"
[ -n "$(golden_diff "$TMP/inv.tsv" "$TMP/g-missing")" ] \
  && ok "control: a golden missing a theorem ($FIRST) differs" || no "control: a golden missing $FIRST compared equal"
awk -F'\t' 'BEGIN{OFS="\t"} !/^#/ && !done && $2 == "" { $2 = "propext"; done = 1 } { print }' "$GOLDEN" > "$TMP/g-axiom"
! cmp -s "$GOLDEN" "$TMP/g-axiom" && [ -n "$(golden_diff "$TMP/inv.tsv" "$TMP/g-axiom")" ] \
  && ok "control: a golden recording other axioms for a theorem differs" || no "control: a changed axiom set compared equal"
printf '%s\n' ConcreteSpec ConcreteSpec.Spec > "$TMP/imp-short.txt"
[ -n "$(closure_gap "$TMP/imp-short.txt")" ] \
  && ok "control: source modules outside a (truncated) import closure are reported" || no "control: a truncated closure reported no gap"
finish
#!/usr/bin/env bash
# TRUST BAN: no `sorry` and no `native_decide` anywhere in the specification (Q9.17), checked
# transitively in the kernel's terms and in the sources the environment does not keep.
#
#   E  no constant of ANY kind the ConcreteSpec library declares (definitions, instances and
#      generated helpers included, not only theorems) depends transitively on sorryAx, on
#      Lean.ofReduceBool or Lean.ofReduceNat (what native_decide and `decide +native` reduce through),
#      on Lean.trustCompiler, or on a generated `._native.` axiom;
#   D  the library declares no axiom of its own;
#   X  every `example`, which the kernel checks and Lean then discards (so E and D never see it),
#      depends only on the standard axioms: in a copy of the library each `example` becomes a
#      named declaration (scripts/proofs/lean_lex.py), the copy is built, and its axioms are
#      collected as E collects a theorem's;
#   S  defence in depth, lexical: the library builds with warningAsError and nothing in lakefile.toml
#      can change that or point the build at other sources; the sources, comments stripped and
#      string literals kept, never spell sorry, sorryAx, admit, native_decide, +native, an
#      option on `decide`, ofReduceBool, ofReduceNat, trustCompiler or skipKernelTC, and define no
#      syntax extension, run no meta code, set no option and import nothing outside the library
#      (the lexer reads what Lean reads only for syntax it knows).
#
# NEGATIVE CONTROLS: a theorem proved by sorry, a definition whose body is sorry (no theorem about
# it), a theorem proved by native_decide and a declared axiom each fail E or D naming the constant;
# a source with an `example` proved by native_decide or a sorry hidden in an interpolation fails S,
# the same words inside comments do not, and an unreadable or unlexable source fails S; examples
# proved by `decide +native` and by `stop` fail X, and one proved by rfl does not.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../checks/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"
CHECK_NAME=PROOF-TRUST-BAN
source scripts/proofs/lib.sh

BANNED_AXIOM_RE='^(sorryAx|Lean[.]ofReduceBool|Lean[.]ofReduceNat|Lean[.]trustCompiler)$|[.]_native[.]'
BANNED_WORD_RE='\b(sorry|sorryAx|admit|native_decide|ofReduceBool|ofReduceNat|trustCompiler|skipKernelTC)\b|\+native\b|\bnative»?\s*:=|\bdecide\s*\(\s*config\b|\bdecide\s*[+-]|\bDecide[.]Config\b'
# `decide` takes no options at all (`decide +native`, `decide (config := ⟨…⟩)` with a positional
# native flag): a term `decide (p)` is unaffected.
# The source scan is lexical, so it holds only for the syntax it lexes: Lean core's. A syntax
# extension could make Lean read a literal differently from the scan (a macro taking `s!` before a
# plain string), so the sources may define none and import nothing outside the library (only Init,
# implicitly, which is where s!, m! and f! live). They set no option either: the library builds with
# warningAsError (checked below in lakefile.toml), so a `sorry` that elaborates anywhere, whatever
# tactic produced it (`stop` is `repeat sorry`), fails the build; `set_option warningAsError false`
# would undo that. Nor do they run meta code (run_cmd, run_tac, #eval and the like).
EXTENSION_RE='#eval\b|\b(run_cmd|run_tac|run_elab|run_meta|set_option|macro|macro_rules|syntax|notation|infix|infixl|infixr|prefix|postfix|elab|elab_rules|declare_syntax_cat|initialize|builtin_initialize)\b'

# banned FILE → `<constant> (<axiom>)` for every constant of a PROOF_MODE=constants listing with a banned axiom
banned() {
  awk -F'\t' -v re="$BANNED_AXIOM_RE" '{ n = split($3, a, " ")
    for (i = 1; i <= n; i++) if (a[i] ~ re) { print $1 " (" a[i] ")"; break } }' "$1"
}
# declared FILE → the axioms a PROOF_MODE=constants listing declares
declared() { awk -F'\t' '$2 == "axiom" { print $1 }' "$1"; }
# scan FILE... → `file:line: text` for every banned word, syntax extension, option, meta command or
# outside import outside comments; exit 3 when a source cannot be lexed (lean_lex.py)
scan() { python3 "$PROOFS_DIR/lean_lex.py" scan "$BANNED_WORD_RE|$EXTENSION_RE" "$@"; }

echo "=== E/D: the environment ==="
population imported > "$TMP/imported.txt" 2> "$TMP/imported.err" || { no "PROOF_MODE=imported failed"; finish; }
GAP=$(closure_gap "$TMP/imported.txt")
[ -z "$GAP" ] && ok "all $(spec_modules | grep -c .) ConcreteSpec source modules are in the environment E and D read" \
  || no "source modules outside the root's import closure, unseen by E and D: $(echo $GAP)"
population constants > "$TMP/consts.tsv" 2> "$TMP/consts.err" \
  || { cat "$TMP/consts.err" >&2; echo "error: the enumerator failed" >&2; exit 2; }
NC=$(grep -c . "$TMP/consts.tsv")
B=$(banned "$TMP/consts.tsv")
[ "$NC" -ge 1000 ] && [ -z "$B" ] \
  && ok "none of the $NC ConcreteSpec constants depends on sorryAx, ofReduceBool/Nat, trustCompiler or a native axiom" \
  || no "$NC constants; banned dependencies: $(echo $B | cut -c1-400)"
A=$(declared "$TMP/consts.tsv")
[ -z "$A" ] && ok "ConcreteSpec declares no axiom" || no "ConcreteSpec declares axioms: $(echo $A)"

echo "=== S: the sources ==="
mapfile -t SRC < <({ echo ConcreteSpec.lean; find ConcreteSpec -name '*.lean'; } | sort)
W=$(scan "${SRC[@]}"); RC=$?
[ "$RC" = 0 ] && [ "${#SRC[@]}" -ge 10 ] && [ -z "$W" ] && ok "none of the ${#SRC[@]} source files spells a banned word outside comments" \
  || no "the source scan (rc=$RC) of ${#SRC[@]} files: $(printf '%s\n' "$W" | head -5 | tr '\n' '|')"

# lake_options LAKEFILE → empty when the specification library builds from ConcreteSpec.lean and
# ConcreteSpec/ (Lake's defaults: no srcDir, roots or globs) with warningAsError, and nothing can turn
# it off. The package holds exactly two libraries, ConcreteSpec and the compiler, Concrete (ROADMAP B0),
# under the same key allow-list. A dependency is a `require` of a git URL pinned to a full commit,
# which lake-manifest.json (beside the lakefile) records at the same URL and commit: the spec may
# import nothing outside itself (S), so a dependency reaches only the compiler. This ban's scope is
# the specification; the compiler's trust gate is Concrete/README.md gate 2.
lake_options() {
  python3 - "$1" <<'EOF'
import sys, tomllib
try:
    cfg = tomllib.load(open(sys.argv[1], "rb"))
except Exception as e:
    print(f"unreadable: {e}"); sys.exit(0)
bad = []
import os
if os.path.exists(os.path.join(os.path.dirname(sys.argv[1]) or ".", "lakefile.lean")):
    bad.append("a lakefile.lean, which Lake reads instead of lakefile.toml")
if cfg.get("leanOptions", {}).get("warningAsError") is not True:
    bad.append("[leanOptions] warningAsError is not true")
# Allow-lists, not deny-lists: a key not named here (srcDir, roots, globs, moreLeanArgs, …) could
# point the build at other sources or pass options, so it is refused.
extra = set(cfg) - {"name", "version", "defaultTargets", "leanOptions", "lean_lib", "require"}
if extra: bad.append(f"the package sets {sorted(extra)}")
if set(cfg.get("leanOptions", {})) != {"warningAsError"}:
    bad.append(f"[leanOptions] sets {sorted(set(cfg.get('leanOptions', {})) - {'warningAsError'})}")
import json, re
reqs = cfg.get("require", [])
if reqs:
    try:
        man = json.load(open(os.path.join(os.path.dirname(sys.argv[1]) or ".", "lake-manifest.json")))
        pkgs = {p.get("name", "").strip("«»"): p for p in man.get("packages", [])}
    except Exception as e:
        bad.append(f"lake-manifest.json unreadable: {e}"); pkgs = {}
    for r in reqs:
        n = r.get("name")
        if set(r) != {"name", "git", "rev"}:
            bad.append(f"the require {n} sets {sorted(set(r) ^ {'name', 'git', 'rev'})}"); continue
        if not re.fullmatch(r"[0-9a-f]{40}", str(r["rev"])):
            bad.append(f"the require {n} is not pinned to a full commit ({r['rev']})")
        p = pkgs.get(n)
        if not p or p.get("type") != "git" or p.get("url") != r["git"] or p.get("rev") != r["rev"] or p.get("inputRev") != r["rev"]:
            bad.append(f"lake-manifest.json does not record the require {n} at {r['git']} {r['rev']}")
libs = cfg.get("lean_lib", [])
if [l.get("name") for l in libs] != ["ConcreteSpec", "Concrete"]: bad.append(f"libraries {[l.get('name') for l in libs]}")
for l in libs:
    extra = set(l) - {"name", "leanOptions"}
    if extra: bad.append(f"the library sets {sorted(extra)}")
    opts = set(l.get("leanOptions", {})) - {"autoImplicit"}
    if opts: bad.append(f"the library sets options {sorted(opts)}")
print("; ".join(bad))
EOF
}
L=$(lake_options lakefile.toml)
[ -z "$L" ] && ok "lakefile.toml builds the library with warningAsError, and nothing overrides it" || no "lakefile.toml: $L"

echo "=== X: the examples, in the kernel's terms ==="
# A copy of the library in which every `example` is a named declaration, built, and its axioms
# collected as E collects a theorem's. warningAsError is off in the copy only: a definition may draw
# a linter warning the example did not, and the copy is read for axioms, not judged for warnings.
EX="$TMP/ex"; mkdir -p "$EX"
cp lakefile.toml lean-toolchain lake-manifest.json "$EX"/ || { no "could not copy the Lake files"; finish; }
[ -d .lake/build ] && mkdir -p "$EX/.lake" && cp -r .lake/build "$EX/.lake/"
sed -i 's/^warningAsError = true$/warningAsError = false/' "$EX/lakefile.toml"
NEX=$(python3 "$PROOFS_DIR/lean_lex.py" examples . "$EX" "${SRC[@]}") \
  || { no "the examples could not be rewritten: $NEX"; finish; }
(cd "$EX" && "$LAKE" build ConcreteSpec) > "$TMP/ex-build.log" 2>&1 \
  || { no "the library with its examples as declarations does not build: $(grep -m3 error "$TMP/ex-build.log" | tr '\n' ' ')"; finish; }
(cd "$EX" && PROOF_MODE=examples "$LAKE" env lean "$ENUMERATOR") > "$TMP/examples.out" 2> "$TMP/examples.err" \
  || { no "PROOF_MODE=examples failed: $(head -2 "$TMP/examples.err" | tr '\n' ' ')"; finish; }
grep -P '\t' "$TMP/examples.out" > "$TMP/examples.tsv"
# nonstandard FILE → `<name> (<axiom>)` for every row whose axioms are not among the standard three
nonstandard() {
  awk -F'\t' -v std=" $STANDARD_AXIOMS " '{ n = split($2, a, " ")
    for (i = 1; i <= n; i++) if (index(std, " " a[i] " ") == 0) { print $1 " (" a[i] ")"; break } }' "$1"
}
NE=$(grep -c . "$TMP/examples.tsv"); X=$(nonstandard "$TMP/examples.tsv")
[ "$NEX" -ge 100 ] && [ "$NE" = "$NEX" ] && [ -z "$X" ] \
  && ok "all $NEX examples, kept as declarations, depend only on the standard axioms" \
  || no "examples: $NEX rewritten, $NE in the environment; on other axioms: $(echo $X | cut -c1-300)"

echo "=== negative controls ==="
# control NAME BODY AXIOM-ERE WHAT: the declarations in BODY must be refused at ConcreteSpecControl.NAME
control() {
  printf '%s\n' "$2" > "$TMP/c-$1.lean"
  population constants "$TMP/c-$1.lean" > "$TMP/c-$1.tsv" 2> "$TMP/c-$1.err"
  local got; got=$(banned "$TMP/c-$1.tsv" | grep -F "ConcreteSpecControl.$1 (")
  has_match -E "\(($3)\)\$" <<<"$got" \
    && ok "control: $4 is refused ($got)" || no "control: $4 was not refused with $3: '$got' $(head -2 "$TMP/c-$1.err" | tr '\n' ' ')"
}
control sorryThm 'theorem ConcreteSpecControl.sorryThm : 1 = 2 := sorry' 'sorryAx' "a theorem proved by sorry"
control sorryDef 'def ConcreteSpecControl.sorryDef : Nat := sorry' sorryAx "a definition with a sorry body and no theorem about it"
control nativeThm 'theorem ConcreteSpecControl.nativeThm : 2 + 2 = 4 := by native_decide' 'Lean\.ofReduceBool|.*\._native\..*' "a theorem proved by native_decide"
printf 'axiom ConcreteSpecControl.ax : 1 = 2\n' > "$TMP/c-ax.lean"
population constants "$TMP/c-ax.lean" > "$TMP/c-ax.tsv" 2>/dev/null
[ "$(declared "$TMP/c-ax.tsv")" = ConcreteSpecControl.ax ] \
  && ok "control: a declared axiom is reported" || no "control: a declared axiom was not reported: '$(declared "$TMP/c-ax.tsv")'"
# A quoted name holding a tab would shift its row's columns (the axiom kind out of column 2) and
# hide the axiom from `declared`; theorems.lean refuses every such name before writing a row.
printf 'axiom ConcreteSpecControl.«a\tb» : 1 = 2\n' > "$TMP/c-tab.lean"
if population constants "$TMP/c-tab.lean" > "$TMP/c-tab.tsv" 2> "$TMP/c-tab.err"; then
  no "control: an axiom whose name holds a tab did not fail the run: '$(declared "$TMP/c-tab.tsv")'"
else
  grep -q 'control character' "$TMP/c-tab.err" "$TMP/c-tab.tsv" \
    && ok "control: an axiom whose name holds a tab fails the run (no row can carry it)" \
    || no "control: the tab-name run failed for another reason: $(head -2 "$TMP/c-tab.err" "$TMP/c-tab.tsv" | tr '\n' ' ')"
fi
mkdir -p "$TMP/src"
cat > "$TMP/src/Bad.lean" <<'EOF'
/- a comment may say sorry and native_decide, /- nested -/ and still sorry -/
-- and so may a line comment: sorry
def quote : Char := '"'
example : 2 + 2 = 4 := by native_decide
def interp : String := s!"{(sorry : Nat)}"
def dashes : String := "-- /- not a comment" ++ toString (sorry : Nat)
example : String := s!"{("--")}{(sorry : Nat)}"
example : String := s!"{"/-"}" ++ toString (sorry : Nat)
def chars : List Char := ['{', '}', '\'', '\\', '"', '\x41']
def h' : Nat := 0 -- a prime in a name starts no character literal: sorry
def r' : String := r#"raw "-- /-" text"# ++ toString (sorry : Nat)
example : True := by have «--» : True := True.intro; sorry
example : False := sorryAx False true
macro "plain" "s!" s:str : term => pure s
import Lean
set_option warningAsError false in
example : False := by stop skip
run_cmd pure ()
#eval (pure () : IO Unit)
example : 2 + 2 = 4 := by decide (config := { native
  := true })
example : 2 + 2 = 4 := by decide (config := ⟨false, true, true, false⟩)
EOF
W=$(scan "$TMP/src/Bad.lean"); RC=$?
B="$TMP/src/Bad.lean"
EXPECT="$B:4: example : 2 + 2 = 4 := by native_decide
$B:5: def interp : String := s!\"{(sorry : Nat)}\"
$B:6: def dashes : String := \"-- /- not a comment\" ++ toString (sorry : Nat)
$B:7: example : String := s!\"{(\"--\")}{(sorry : Nat)}\"
$B:8: example : String := s!\"{\"/-\"}\" ++ toString (sorry : Nat)
$B:11: def r' : String := r#\"raw \"-- /-\" text\"# ++ toString (sorry : Nat)
$B:12: example : True := by have «--» : True := True.intro; sorry
$B:13: example : False := sorryAx False true
$B:14: macro \"plain\" \"s!\" s:str : term => pure s
$B:15: import Lean
$B:16: set_option warningAsError false in
$B:18: run_cmd pure ()
$B:19: #eval (pure () : IO Unit)
$B:20: example : 2 + 2 = 4 := by decide (config := { native
$B:22: example : 2 + 2 = 4 := by decide (config := ⟨false, true, true, false⟩)"
[ "$RC" = 0 ] && [ "$W" = "$EXPECT" ] \
  && ok "control: native_decide, and sorry inside an interpolation, after a string, raw string or quoted name holding comment delimiters, after an interpolation holding a string, a direct sorryAx, a syntax extension, an outside import, an option, meta code and decide options (native split across lines, positional) are found; the words in comments are not" \
  || no "control: source scan (rc=$RC) reported '$W'"
printf 'def s : String := s!"unterminated {\n' > "$TMP/src/Open.lean"
printf 'example : String × Nat := { fst := "{--", snd := sorry\n} -- "\n' > "$TMP/src/Brace.lean"
printf 'def q := `(command|\n/-! hidden -/\n)\n' > "$TMP/src/Quote.lean"
for imp in 'import ConcreteSpec.Spec Lean' 'import ConcreteSpec.Spec
  Lean' 'prelude
import ConcreteSpec.Spec'; do
  printf '%s\nnamespace X\nend X\n' "$imp" > "$TMP/src/Imp.lean"
  W=$(scan "$TMP/src/Imp.lean")
  [ -n "$W" ] && ok "control: the header $(printf '%s' "$imp" | tr '\n' ' ') is reported" \
    || no "control: the header $(printf '%s' "$imp" | tr '\n' ' ') passed the scan"
done
printf '[leanOptions]\nwarningAsError = true\n\n[[lean_lib]]\nname = "ConcreteSpec"\nleanOptions = { autoImplicit = false, warningAsError = false }\n' > "$TMP/lake-off.toml"
L=$(lake_options "$TMP/lake-off.toml")
has_match -F "the library sets options ['warningAsError']" <<<"$L" && ok "control: a library that turns warningAsError off is refused ($L)" \
  || no "control: a lakefile turning warningAsError off was accepted"
printf '[leanOptions]\nwarningAsError = true\n\n[[lean_lib]]\nname = "ConcreteSpec"\nsrcDir = "shadow"\n' > "$TMP/lake-src.toml"
L=$(lake_options "$TMP/lake-src.toml")
has_match -F "the library sets ['srcDir']" <<<"$L" && ok "control: a library built from another source directory is refused ($L)" \
  || no "control: a lakefile with srcDir was accepted"
# The dependency controls run on a copy of this lakefile, beside a manifest, so each varies one thing.
mkdir -p "$TMP/lk"
lake_variant() { # NAME PYTHON-EDIT: lakefile.toml and lake-manifest.json copied to $TMP/lk/NAME, then edited
  mkdir -p "$TMP/lk/$1"; cp lakefile.toml lake-manifest.json "$TMP/lk/$1/"
  (cd "$TMP/lk/$1" && python3 -I -c "$2")
}
lake_variant short 'import re; p="lakefile.toml"; s=open(p).read(); r=re.search("[0-9a-f]{40}", s).group(0); open(p,"w").write(s.replace(r, r[:12]))'
lake_variant branch 'import re; p="lakefile.toml"; s=open(p).read(); open(p,"w").write(re.sub(r"rev = \"[0-9a-f]+\"", "rev = \"main\"", s))'
lake_variant drift 'import json; p="lake-manifest.json"; m=json.load(open(p)); m["packages"][0]["rev"]="0"*40; json.dump(m, open(p,"w"))'
lake_variant subdir 'p="lakefile.toml"; s=open(p).read(); open(p,"w").write(s.replace("[[require]]\n", "[[require]]\nsubDir = \"x\"\n", 1))'
lake_variant thirdlib 'p="lakefile.toml"; s=open(p).read(); open(p,"w").write(s + "\n[[lean_lib]]\nname = \"Other\"\n")'
for v in short:"not pinned to a full commit" branch:"not pinned to a full commit" drift:"does not record the require" subdir:"sets ['subDir']" thirdlib:"libraries ['ConcreteSpec', 'Concrete', 'Other']"; do
  L=$(lake_options "$TMP/lk/${v%%:*}/lakefile.toml")
  case "$L" in *"${v#*:}"*) ok "control: a lakefile whose dependency or library set is changed (${v%%:*}) is refused ($L)" ;;
    *) no "control: the ${v%%:*} lakefile was not refused for '${v#*:}': '$L'" ;; esac
done
for f in missing Open Brace Quote; do
  scan "$TMP/src/$f.lean" > /dev/null 2>&1; RC=$?
  [ "$RC" != 0 ] && ok "control: a source the scan cannot read or lex ($f) fails it (rc=$RC)" \
    || no "control: the scan of $f exited 0"
done
head -n 3 "$TMP/imported.txt" > "$TMP/imp-short.txt"
[ -n "$(closure_gap "$TMP/imp-short.txt")" ] \
  && ok "control: source modules outside a (truncated) import closure are reported" || no "control: a truncated closure reported no gap"
# The example leg's own controls: examples rewritten as that leg rewrites them, then enumerated.
mkdir -p "$TMP/exc-src" "$TMP/exc"
printf 'example : 2 + 2 = 4 := by decide +native\nexample : 1 = 2 := by stop skip\nexample : 1 = 1 := rfl\ndef w : String := "example"\n' > "$TMP/exc-src/C.lean"
N=$(python3 "$PROOFS_DIR/lean_lex.py" examples "$TMP/exc-src" "$TMP/exc" C.lean)
# (Lean prints the warnings of the inserted declarations on stdout too; the rows are the tab lines.)
population examples "$TMP/exc/C.lean" 2>/dev/null | grep -P '\t' > "$TMP/exc.tsv"
X=$(nonstandard "$TMP/exc.tsv")
[ "$N" = 3 ] && [ "$(grep -c . "$TMP/exc.tsv")" = 3 ] && has_match -F "C.lean:1» (" <<<"$X" && has_match -F "C.lean:2» (sorryAx)" <<<"$X" \
  && ! has_match -F "C.lean:3»" <<<"$X" \
  && ok "control: an example proved by decide +native and one closed by stop are reported, rfl is not, and the word example in a string is no example ($(echo $X | tr '\n' ' '))" \
  || no "control: rewritten examples: $N, rows $(grep -c . "$TMP/exc.tsv"), reported '$X'"
finish
/-
The proof population of the specification, read from the elaborated environment (not grepped from
source): every constant the `ConcreteSpec` library declares. The proof-integrity checks
(scripts/proofs/axioms.sh, trust_ban.sh, external.sh) all read it from here, so they agree on what
"every ConcreteSpec theorem" means.

  lake env lean scripts/proofs/theorems.lean
      one line per theorem: `<name>\t<axiom> <axiom> …` (transitive axioms, sorted; empty when none).
      EVERY theorem constant is listed: private ones (`_private.…`) and generated ones (`proof_N`,
      `match_N.eq_N`, `eq_N`) included, so none can be dropped from the inventory or the export.
  PROOF_MODE=encoded …
      one line per theorem: `<name as Lean writes it>\t<encoded name>` (encoding below). The first is
      what lean4export reads on its command line; the second is what the stream is compared by.
  PROOF_MODE=constants …
      one line per constant of ANY kind: `<name>\t<kind>\t<axioms>`. A definition, instance or
      generated helper can carry `sorryAx` or a native axiom without any theorem being about it, so
      the trust ban reads every constant.
  PROOF_MODE=modules …
      the modules that declare at least one theorem of the population, one per line.
  PROOF_MODE=imported …
      every `ConcreteSpec` module in the import closure of this file (the root `ConcreteSpec`).
  PROOF_MODE=decls PROOF_NAMES=<file> PROOF_OUT=<out> …
      writes to <out> every constant whose name is listed in <file> (one per line; the declarations
      of a lean4export stream), rendered in the canonical declaration form `export_inventory.py decls` renders from
      that stream. The two must be equal: that is the check that the exporter handed the external
      checkers the declarations Lean checked (types, definition bodies, proofs, inductive types,
      constructors and recursors), not merely declarations of the same names.

CANONICAL DECLARATION FORM (shared with export_inventory.py; change both or neither). Declarations
are visited in order of their names; each field's expression is visited before the next field, and
an expression's children left to right. Every distinct expression node gets the next number the
first time it is met, and a line `<number>\t<node>` where the node names its children by number, so
the text stays linear in the size of the shared term graph. After its expressions, each declaration
is the line `D\t<name>\t<kind>\t<fields>`. Names are encoded injectively (`enc`), strings are
`<utf-8 byte length>:<bytes>`, and what the kernel ignores is erased: metadata, binder names, binder
annotations and the let `nondep` flag (lean4export shares one index among expressions equal under
`Expr` BEq, which ignores exactly those, so the export legitimately carries whichever spelling it
met first).

NEGATIVE CONTROLS. A declaration made in this file itself under the namespace `ConcreteSpecControl`
is part of the population too. The checks insert their deliberately bad declarations (a `sorry`, a
`native_decide`, an extra axiom) at the marker line below, in a temporary copy, and require the run to
fail; nothing else is ever declared under that namespace.
-/
import Lean
import ConcreteSpec

open Lean

def inPopulation (env : Environment) (n : Name) : Bool :=
  match env.getModuleIdxFor? n with
  | some i => (env.header.moduleNames[i.toNat]?.map (·.getRoot)) == some `ConcreteSpec
  | none => (`ConcreteSpecControl).isPrefixOf (privateToUserName n)

def nm : Name → String
  | .anonymous => ""
  | .str p s => if p.isAnonymous then s else nm p ++ "." ++ s
  | .num p n => if p.isAnonymous then toString n else nm p ++ "." ++ toString n

def lstr (s : String) : String := s!"{s.utf8ByteSize}:{s}"

/-- A name, injectively: each component in order, a string as `s<utf-8 length>:<bytes>` and a number
as `n<digits>:`. Joining components with `.` is not injective (`u.v` the one-component name and
`u`,`v` the two-component one print alike), and the canonical form must not let two names agree. -/
def enc : Name → String
  | .anonymous => ""
  | .str p s => enc p ++ "s" ++ lstr s
  | .num p n => enc p ++ s!"n{n}:"

def lvl : Level → String
  | .zero => "0"
  | .succ l => s!"(s {lvl l})"
  | .max a b => s!"(max {lvl a} {lvl b})"
  | .imax a b => s!"(imax {lvl a} {lvl b})"
  | .param n => s!"(p {enc n})"
  | .mvar _ => "(mvar)"

structure Dag where
  ids : Std.HashMap String Nat := {}
  memo : Std.HashMap Expr Nat := {}
  out : Array String := #[]

-- A state reference, and every lookup and update inside one `modifyGet`: the maps stay uniquely
-- referenced and are updated in place (a lookup through `get` would share them, and each insert
-- would then copy a map of hundreds of thousands of entries).
abbrev DagM := StateRefT Dag IO

/-- The number of a node, allocating the next one (and its line) the first time it is met. -/
def node (s : String) : DagM Nat :=
  modifyGet fun st => match st.ids[s]? with
    | some i => (i, st)
    | none =>
      let i := st.ids.size
      (i, { st with ids := st.ids.insert s i, out := st.out.push s!"{i}\t{s}" })

def seen (e : Expr) : DagM (Option Nat) := modifyGet fun st => (st.memo[e]?, st)

partial def dag (e : Expr) : DagM Nat := do
  if let some i ← seen e then return i
  let i ← match e with
    | .bvar i => node s!"(b {i})"
    | .sort l => node s!"(S {lvl l})"
    | .const n us => node s!"(c {enc n} [{" ".intercalate (us.map lvl)}])"
    | .app f a => do let f ← dag f; let a ← dag a; node s!"(a {f} {a})"
    | .lam _ t b _ => do let t ← dag t; let b ← dag b; node s!"(l {t} {b})"
    | .forallE _ t b _ => do let t ← dag t; let b ← dag b; node s!"(f {t} {b})"
    | .letE _ t v b _ => do let t ← dag t; let v ← dag v; let b ← dag b; node s!"(let {t} {v} {b})"
    | .lit (.natVal v) => node s!"(n {v})"
    | .lit (.strVal s) => node s!"(str {lstr s})"
    | .mdata _ e => dag e
    | .proj s i e => do let e ← dag e; node s!"(j {enc s} {i} {e})"
    | .fvar _ => node "(fvar)"
    | .mvar _ => node "(mvar)"
  modify fun st => { st with memo := st.memo.insert e i }
  return i

/-- A list of names: each encoded and terminated by `;`, so `[]` and `[anonymous]` (`enc` of the
anonymous name is empty) differ, and so do lists of different lengths. -/
def names (ns : List Name) : String := String.join (ns.map (enc · ++ ";"))
def flag (b : Bool) : String := if b then "1" else "0"

/-- The declaration line of a constant, after its expressions (canonical form, above). -/
def declLine (n : Name) (ci : ConstantInfo) : DagM String := do
  let lp := names ci.levelParams
  let t ← dag ci.type
  let row := fun (k : String) (rest : String) => s!"D\t{enc n}\t{k}\t[{lp}]\tT={t}{rest}"
  match ci with
  | .axiomInfo v => return row "axiom" s!" unsafe={flag v.isUnsafe}"
  | .defnInfo v =>
    let hints := match v.hints with
      | .opaque => "opaque" | .abbrev => "abbrev" | .regular h => s!"regular {h}"
    let safety := match v.safety with
      | .safe => "safe" | .unsafe => "unsafe" | .partial => "partial"
    return row "def" s!" V={← dag v.value} hints={hints} safety={safety} all=[{names v.all}]"
  | .thmInfo v => return row "thm" s!" V={← dag v.value} all=[{names v.all}]"
  | .opaqueInfo v => return row "opaque" s!" V={← dag v.value} unsafe={flag v.isUnsafe} all=[{names v.all}]"
  | .quotInfo v =>
    let k := match v.kind with | .type => "type" | .ctor => "ctor" | .lift => "lift" | .ind => "ind"
    return row "quot" s!" kind={k}"
  | .inductInfo v => return row "inductive" s!" params={v.numParams} indices={v.numIndices} \
      all=[{names v.all}] ctors=[{names v.ctors}] rec={flag v.isRec} unsafe={flag v.isUnsafe} \
      reflexive={flag v.isReflexive} nested={v.numNested}"
  | .ctorInfo v => return row "ctor" s!" induct={enc v.induct} cidx={v.cidx} \
      params={v.numParams} fields={v.numFields} unsafe={flag v.isUnsafe}"
  | .recInfo v =>
    let mut rules : Array String := #[]
    for r in v.rules do rules := rules.push s!"{enc r.ctor} {r.nfields} {← dag r.rhs}"
    return row "rec" s!" all=[{names v.all}] params={v.numParams} indices={v.numIndices} \
      motives={v.numMotives} minors={v.numMinors} k={flag v.k} unsafe={flag v.isUnsafe} \
      rules=[{"; ".intercalate rules.toList}]"

def kind : ConstantInfo → String
  | .axiomInfo _ => "axiom"
  | .defnInfo _ => "def"
  | .thmInfo _ => "theorem"
  | .opaqueInfo _ => "opaque"
  | .quotInfo _ => "quot"
  | .inductInfo _ => "inductive"
  | .ctorInfo _ => "ctor"
  | .recInfo _ => "recursor"

/-- Whether a name can be written into a row. Every output of this file is line-based and most are
tab-separated, and a quoted Lean name (`«a	b»`) may hold a tab or a line break, which would shift
or split a row and hide a constant from the checks that parse it. -/
def ctrlFree (s : String) : Bool := s.all fun (c : Char) => 32 ≤ c.toNat && c.toNat != 127

def rowSafe : Name → Bool
  | .anonymous => true
  | .str p s => rowSafe p && ctrlFree s
  | .num p _ => rowSafe p

-- CONTROL DECLARATIONS (negative controls are inserted here, in a temporary copy only)

#eval show CoreM Unit from do
  let env ← getEnv
  let mode := (← IO.getEnv "PROOF_MODE").getD "theorems"
  unless ["theorems", "encoded", "constants", "modules", "imported", "decls", "heads", "examples"].contains mode do
    throwError s!"unknown PROOF_MODE '{mode}'"
  -- Fail closed, once, before any mode writes a row: every constant and module name of the
  -- environment (the population, the axioms its constants depend on, the inductive heads of
  -- `heads`, the modules) must be writable. One check covers every mode.
  for (n, _) in env.constants.map₁.toList ++ env.constants.map₂.toList do
    unless rowSafe n do
      throwError s!"theorems.lean: a constant name holds a control character, so no row can carry it: {repr (toString n)}"
  for m in env.header.moduleNames do
    unless rowSafe m do
      throwError s!"theorems.lean: a module name holds a control character: {repr (toString m)}"
  if mode == "decls" then
    let some path ← IO.getEnv "PROOF_NAMES" | throwError "PROOF_MODE=decls needs PROOF_NAMES"
    let some out ← IO.getEnv "PROOF_OUT" | throwError "PROOF_MODE=decls needs PROOF_OUT"
    let wanted : Std.HashSet String := Std.HashSet.ofList
      ((← IO.FS.lines path).toList.filter (· != ""))
    let mut found : Std.HashMap String (Name × ConstantInfo) := {}
    for (n, ci) in env.constants.map₁.toList ++ env.constants.map₂.toList do
      let s := enc n
      if wanted.contains s then
        if found.contains s then throwError s!"two constants encode as {s}"
        found := found.insert s (n, ci)
    let order := (found.toArray.map (·.1)).qsort (· < ·)
    let run : DagM Unit := do
      for s in order do
        let some (n, ci) := found[s]? | unreachable!
        let line ← declLine n ci
        modify fun st => { st with out := st.out.push line }
    let ((), st) ← (run.run {} : IO (Unit × Dag))
    -- Written to a file: `#eval` turns what it prints into a message, and a message of 400k lines
    -- took minutes to emit.
    IO.FS.writeFile out ("\n".intercalate st.out.toList ++ "\n")
    return
  let mut rows : Array String := #[]
  if mode == "examples" then
    -- The declarations scripts/proofs/lean_lex.py made from `example`s (scripts/proofs/trust_ban.sh).
    for (n, _) in env.constants.map₁.toList ++ env.constants.map₂.toList do
      if let .str _ s := n then
        if s.startsWith "⟪example⟫" then
          rows := rows.push s!"{n}\t{" ".intercalate (((← collectAxioms n).map toString).qsort (· < ·)).toList}"
  else if mode == "imported" then
    for m in env.header.moduleNames do
      if m.getRoot == `ConcreteSpec then rows := rows.push (nm m)
  else
    let consts := env.constants.map₁.toList ++ env.constants.map₂.toList
    for (n, ci) in consts do
      if !inPopulation env n then continue
      let axs := fun () => do
        return " ".intercalate (((← collectAxioms n).map toString).qsort (· < ·)).toList
      if mode == "constants" then
        rows := rows.push s!"{n}\t{kind ci}\t{← axs ()}"
      else if ci matches .thmInfo _ then
        if mode == "modules" then
          if let some i := env.getModuleIdxFor? n then
            if let some m := env.header.moduleNames[i.toNat]? then rows := rows.push (nm m)
        else if mode == "encoded" then
          rows := rows.push s!"{n}\t{enc n}"
        else if mode == "heads" then
          -- A universe-monomorphic theorem whose statement is, as written, an inductive type
          -- applied to arguments (no binder). Such a statement is in weak head normal form, so two
          -- statements with different inductive heads are never definitionally equal.
          if ci.levelParams.isEmpty then
            if let .const h _ := ci.type.getAppFn then
              if let some (.inductInfo _) := env.find? h then
                rows := rows.push s!"{enc n}\t{enc h}"
        else
          rows := rows.push s!"{n}\t{← axs ()}"
  for r in (rows.qsort (· < ·)).toList.eraseDups do IO.println r

