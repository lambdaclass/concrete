  [ "$rc" != 0 ] && ! has_match -E "^Checked [0-9]+ declarations with no errors$" < "$TMP/k-$c.out" \
    && ok "nanoda refuses the $c export (rc=$rc)" \
    || no "nanoda on the $c export: rc=$rc: $(tail -2 "$TMP/k-$c.out" | tr '\n' ' ')"
