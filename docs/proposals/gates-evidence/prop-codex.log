printf '%s\n' '{"in":1,"str":{"pre":0,"str":"ConcreteSpecControl"}}' \
  '{"in":2,"str":{"pre":1,"str":"Classical.choice\nQuot.sound"}}' > "$TMP/c-nl.ndjson"
