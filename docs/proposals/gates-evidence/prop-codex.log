1:#!/usr/bin/env python3
2:"""Compare the stage outputs of two independent slice-0 builds, byte for byte.
3:
4:usage: repro_compare.py SIDE_A SIDE_B IDENTITY [MANIFEST]
5:
6:Each SIDE holds `names` (the example inventory) and `out/NAME/STAGE` for every stage. Every file
7:is read on both sides: a missing file, a differing inventory or one differing byte fails. With
8:MANIFEST, writes the identity lines followed by one `SHA256  NAME/STAGE` line per artifact.
9:"""
10:import hashlib
11:import sys
12:from pathlib import Path
13:
14:STAGES = ['bir.txt', 'llvm.ll', 'lcb_job.txt', 'lcb_source.txt', 'lcb_body.ssa', 'lcb_body.s',
15:          'lcb_rt.ssa', 'lcb_rt.s', 'llvm.o', 'lcb_body.o', 'lcb_rt.o', 'llvm.exe', 'lcb.exe']
16:
17:
18:def main(argv):
19:    if len(argv) not in (4, 5):
20:        sys.exit(__doc__)
21:    a, b, identity = Path(argv[1]), Path(argv[2]), Path(argv[3])
22:    names = (a / 'names').read_bytes()
23:    if names != (b / 'names').read_bytes():
24:        sys.exit('FAIL slice0_repro: example inventory differs')
25:    if not names.strip():
26:        sys.exit('FAIL slice0_repro: no examples')
27:    lines = identity.read_text().splitlines()
28:    for name in names.decode().splitlines():
29:        for stage in STAGES:
30:            try:
31:                hashes = [hashlib.sha256((d / 'out' / name / stage).read_bytes()).hexdigest()
32:                          for d in (a, b)]
33:            except FileNotFoundError as e:
34:                sys.exit(f'FAIL slice0_repro: {name}: {stage}: missing ({e.filename})')
35:            if hashes[0] != hashes[1]:
36:                sys.exit(f'FAIL slice0_repro: {name}: {stage}: {hashes[0]} != {hashes[1]}')
37:            lines.append(f'{hashes[0]}  {name}/{stage}')
38:        print(f'ok slice0_repro: {name}: all stages byte-identical')
39:    if len(argv) == 5:
40:        Path(argv[4]).write_text('\n'.join(lines) + '\n')
41:
42:
43:if __name__ == '__main__':
44:    main(sys.argv)
