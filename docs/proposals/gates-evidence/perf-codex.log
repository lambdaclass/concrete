  2059	  | .literal (.long b) => toString b.toNat
  2060	
  2061	def renderBinary : Source.Binary → String
  2062	  | .add => "add" | .sub => "sub" | .mul => "mul"
  2063	  | .andBits => "and" | .orBits => "or" | .xorBits => "xor"
  2064	  | .shiftLeft => "shl" | .logicalRight => "shr" | .arithmeticRight => "sar"
