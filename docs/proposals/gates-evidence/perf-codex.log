  1053	/-- What a successful `adaptBlock` is. -/
  1054	theorem adaptBlock_ok {p : Program} {j : Nat} {b : Block} {lb : Source.Block}
  1055	    (h : adaptBlock p (j, b) = .ok lb) :
  1056	    ∃ phis xss tm, (indexed b.params).mapM (fun (k, _) => adaptPhi p j k) = .ok phis ∧
  1057	      (indexed b.insts).mapM (adaptInst p j b) = .ok xss ∧ term p b.term = .ok tm ∧
  1058	      lb = { phis := phis.toArray, instructions := xss.flatten.toArray, terminator := tm } := by
  1059	  unfold adaptBlock at h
  1060	  cases hp : (indexed b.params).mapM (fun (k, _) => adaptPhi p j k) <;>
  1061	    cases hi : (indexed b.insts).mapM (adaptInst p j b) <;> cases ht : term p b.term <;>
  1062	    simp_all [bind, Except.bind, pure, Except.pure]
