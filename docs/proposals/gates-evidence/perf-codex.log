  2101	/-! ## The in-process leg: LCB's own evaluator against BIR -/
  2102	
  2103	/-- The result word LCB's semantics gives the adapted body, with `fuel` steps. -/
  2104	def evalBody (f : Source.Function) (fuel : Nat) : Option Nat :=
  2105	  match Source.evaluateFunction f #[] fuel with
  2106	  | .returned (.word w) => some w.toNat
  2107	  | _ => none
  2108	
  2109	end Concrete.Backend.LCB

