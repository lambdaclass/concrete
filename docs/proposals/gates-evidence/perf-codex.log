  1229	/-- A `forIn` whose body yields `g a s` at every element, from the state the earlier elements
  1230	left, folds `g`. -/
  1231	theorem forIn_yields {ε σ α : Type} (F : α → σ → Except ε (ForInStep σ)) (g : α → σ → σ) :
  1232	    ∀ (l : List α) (init : σ),
  1233	      (∀ i (h : i < l.length), F l[i] ((l.take i).foldl (fun s a => g a s) init) =
  1234	        .ok (.yield (g l[i] ((l.take i).foldl (fun s a => g a s) init)))) →
  1235	      forIn l init F = .ok (l.foldl (fun s a => g a s) init)
