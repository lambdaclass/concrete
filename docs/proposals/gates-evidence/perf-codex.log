  2082	  | .divide op a b => s!"{renderDivision op} {renderOperand a}, {renderOperand b}"
  2083	
  2084	def renderTerminator : Source.Terminator → String
  2085	  | .ret a => s!"    ret {renderOperand a}\n"
  2086	  | .jump t => s!"    jmp @b{t}\n"
  2087	  | .branch c y n => s!"    jnz {renderOperand c}, @b{y}, @b{n}\n"
