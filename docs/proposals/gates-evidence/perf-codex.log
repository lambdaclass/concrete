  2089	/-- The body as QBE text for `lcb`. -/
  2090	def render (f : Source.Function) : String :=
  2091	  let blocks := (indexed f.blocks.toList).map fun (j, b) =>
  2092	    s!"@b{j}\n" ++
  2093	    String.join (b.phis.toList.map fun ph =>
  2094	      let arms := ph.incoming.toList.map fun (pred, a) => s!"@b{pred} {renderOperand a}"
  2095	      s!"    %v{ph.destination} ={renderWidth ph.width} phi {", ".intercalate arms}\n") ++
  2096	    String.join (b.instructions.toList.map fun i =>
  2097	      s!"    %v{i.destination} ={renderWidth i.width} {renderOperation i.operation}\n") ++
  2098	    renderTerminator b.terminator
  2099	  "export function w $concrete_body() {\n" ++ String.join blocks ++ "}\n"
