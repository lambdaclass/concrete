  1644	theorem block_wf {p : Program} (hwf : WF p) {j : Nat} {b : Block} (hb : p.blocks[j]? = some b) :
  1645	    Block.wf p b = true := by
  1646	  unfold WF wf at hwf
  1647	  simp only [Bool.and_eq_true, List.all_eq_true] at hwf
  1648	  exact hwf.2 b (List.mem_of_getElem? hb)
  1649	
  1650	theorem term_wf {p : Program} (hwf : WF p) {j : Nat} {b : Block} (hb : p.blocks[j]? = some b) :
  1651	    ∃ scope, b.term.wf p scope = true := by
  1652	  have h := block_wf hwf hb
  1653	  unfold Block.wf at h
  1654	  split at h
  1655	  rename_i ok scope _
  1656	  simp only [Bool.and_eq_true] at h
  1657	  exact ⟨scope, h.2⟩
  1658	
  1659	theorem condbr_ne {p : Program} (hwf : WF p) {j : Nat} {b : Block} (hb : p.blocks[j]? = some b)
  1660	    {c : Reg} {t e : Nat} {ta ea : List Operand} (ht : b.term = .condbr c t ta e ea) : t ≠ e := by
  1661	  obtain ⟨scope, h⟩ := term_wf hwf hb
  1662	  rw [ht] at h
  1663	  simp only [Term.wf, Bool.and_eq_true, bne_iff_ne] at h
  1664	  exact h.1.1.2
