  2067	
  2068	def renderDivision : Source.Division → String
  2069	  | .unsignedDiv => "udiv" | .unsignedRem => "urem" | .signedDiv => "div" | .signedRem => "rem"
  2070	
  2071	def renderOperation : Source.Operation → String
  2072	  | .copy a => s!"copy {renderOperand a}"
  2073	  | .binary op a b => s!"{renderBinary op} {renderOperand a}, {renderOperand b}"
  2074	  | .compare op w a b =>
  2075	    let c := match op with
  2076	      | .eq => "ceq"
  2077	      | .unsignedLT => "cult"
  2078	      | .unsignedLE => "cule"
  2079	      | .signedLT => "cslt"
  2080	      | .signedLE => "csle"
