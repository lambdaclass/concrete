   338	theorem mapM_ok {α β ε : Type} {g : α → Except ε β} :
   339	    ∀ {l : List α} {l' : List β}, l.mapM g = .ok l' →
   340	      l'.length = l.length ∧ ∀ (i : Nat) (x : α), l[i]? = some x → ∃ y, g x = .ok y ∧ l'[i]? = some y
   341	  | [], l', h => by
   342	    simp only [List.mapM_nil] at h
   343	    cases h; exact ⟨rfl, fun i x hx => by simp at hx⟩
   344	  | a :: l, l', h => by
   345	    simp only [List.mapM_cons] at h
   346	    cases ha : g a with
   347	    | error e => simp [ha] at h; cases h
   348	    | ok b =>
   349	      cases hl : l.mapM g with
   350	      | error e => simp [ha, hl] at h; cases h
   351	      | ok bs =>
   352	        simp [ha, hl] at h
   353	        cases h
   354	        obtain ⟨hlen, hel⟩ := mapM_ok hl
   355	        refine ⟨by simp [hlen], fun i x hx => ?_⟩
   356	        cases i with
   357	        | zero => simp at hx; subst hx; exact ⟨b, ha, rfl⟩
   358	        | succ i => simpa using hel i x (by simpa using hx)
   359	
   360	/-- An instruction's expansion has `Inst.width` instructions. -/
   361	theorem inst_length {p : Program} {n : Nat} {ins : Inst} {xs : List Source.Instruction}
   362	    (h : inst p n ins = .ok xs) : xs.length = Inst.width ins := by
   363	  cases ins with
   364	  | bin op t d a b =>
   365	    unfold inst at h
   366	    cases hp : inProfile t <;> cases ha : operand p a <;> cases hb : operand p b <;>
   367	      simp_all [Inst.width, bind, Except.bind, pure, Except.pure] <;> (subst h; rfl)
   368	  | binOvf op t d f a b =>
   369	    unfold inst at h
   370	    cases hp : inProfile t <;> cases ha : operand p a <;> cases hb : operand p b <;>
   371	      simp_all [Inst.width, bind, Except.bind, pure, Except.pure] <;> (subst h; rfl)
   372	  | trunc fr to d a =>
   373	    unfold inst at h
   374	    cases hp : inProfile fr <;> cases hq : inProfile to <;> cases ha : operand p a <;>
   375	      simp_all [Inst.width, bind, Except.bind, pure, Except.pure] <;> (subst h; rfl)
   376	
   377	/-! ## `adapter_correct`, numbering -/
   378	
   379	theorem lookup_of_mem {l : List (Reg × Nat)} (hn : (l.map Prod.fst).Nodup) {r : Reg} {n : Nat}
   380	    (hm : (r, n) ∈ l) : l.lookup r = some n := by
   381	  induction l with
   382	  | nil => simp at hm
   383	  | cons a l ih =>
   384	    obtain ⟨r', n'⟩ := a
   385	    simp only [List.map_cons, List.nodup_cons, List.mem_map] at hn
   386	    simp only [List.mem_cons, Prod.mk.injEq] at hm
   387	    rcases hm with ⟨rfl, rfl⟩ | hm
   388	    · simp [List.lookup]
   389	    · have hne : r ≠ r' := by
   390	        rintro rfl; exact hn.1 ⟨(r, n), hm, rfl⟩
   391	      have hb : (r == r') = false := by simpa using hne
   392	      simp only [List.lookup, hb]
   393	      exact ih hn.2 hm
   394	
   395	/-- A block parameter's id is its position. -/
   396	theorem regId_param {p : Program} (hn : ((ids p).map Prod.fst).Nodup) {j k : Nat} {b : Block}
   397	    {r : Reg} {ty : Ty} (hb : p.blocks[j]? = some b) (hk : b.params[k]? = some (r, ty)) :
   398	    regId p r = some (blockBase p j + k) := by
   399	  apply lookup_of_mem hn
   400	  simp only [ids, List.mem_flatMap, List.mem_append, List.mem_map]
   401	  exact ⟨(j, b), Runtime.mem_indexed hb, Or.inl ⟨(k, (r, ty)), Runtime.mem_indexed hk, rfl⟩⟩
   402	
   403	/-- A register an instruction defines has the id of its slot among the instruction's values. -/
   404	theorem regId_inst {p : Program} (hn : ((ids p).map Prod.fst).Nodup) {j i : Nat} {b : Block}
   405	    {ins : Inst} {r : Reg} {off : Nat} (hb : p.blocks[j]? = some b) (hi : b.insts[i]? = some ins)
   406	    (hd : (r, off) ∈ instDefs ins) :
   407	    regId p r = some (blockBase p j + instBase b i + off) := by
   408	  apply lookup_of_mem hn
   409	  simp only [ids, List.mem_flatMap, List.mem_append, List.mem_map]
   410	  exact ⟨(j, b), Runtime.mem_indexed hb,
   411	    Or.inr ⟨(i, ins), Runtime.mem_indexed hi, ⟨(r, off), hd, rfl⟩⟩⟩
   412	
   413	/-! ## `adapter_correct`, environments -/
   414	
   415	theorem enc_width (v : Val) : (enc v).width = .word := by cases v <;> rfl
   416	
   417	theorem word_bne : (Width.word != Width.word) = false := by decide
   418	
   419	theorem mem_of_lookup {l : List (Reg × Nat)} {r : Reg} {n : Nat} (h : l.lookup r = some n) :
   420	    (r, n) ∈ l := by
   421	  obtain ⟨l₁, l₂, rfl, _⟩ := List.lookup_eq_some_iff.mp h
   422	  simp
   423	
   424	theorem eq_of_snd {l : List (Reg × Nat)} (hn : (l.map Prod.snd).Nodup) {a b : Reg} {n : Nat}
   425	    (ha : (a, n) ∈ l) (hb : (b, n) ∈ l) : a = b := by
   426	  induction l with
   427	  | nil => simp at ha
   428	  | cons x l ih =>
   429	    simp only [List.map_cons, List.nodup_cons, List.mem_map] at hn
   430	    simp only [List.mem_cons] at ha hb
   431	    rcases ha with rfl | ha <;> rcases hb with hb | hb
   432	    · cases hb; rfl
   433	    · exact absurd ⟨(b, n), hb, rfl⟩ hn.1
   434	    · subst hb; exact absurd ⟨(a, n), ha, rfl⟩ hn.1
   435	    · exact ih hn.2 ha hb
   436	
   437	/-- Agreement: every BIR register's newest value sits, encoded, at its LCB id. -/
   438	def Agrees (p : Program) (benv : Env) (lenv : Source.Environment) : Prop :=
   439	  ∀ r v, lookup benv r = some v → ∃ n, regId p r = some n ∧ lenv[n]? = some (some (enc v))
   440	
   441	theorem regId_injective {p : Program} (hok : numberingOk p = true) {a b : Reg} {n : Nat}
   442	    (ha : regId p a = some n) (hb : regId p b = some n) : a = b := by
   443	  simp only [numberingOk, Bool.and_eq_true, decide_eq_true_eq] at hok
   444	  exact eq_of_snd hok.1.1.1.2 (mem_of_lookup ha) (mem_of_lookup hb)
   445	
   446	/-- Reading a translated operand gives the encoded BIR value. -/
   447	theorem read_operand {p : Program} {benv : Env} {lenv : Source.Environment}
   448	    (hag : Agrees p benv lenv) {a : Operand} {a' : Source.Operand} {v : Val}
   449	    (ha : operand p a = .ok a') (hv : evalOp benv a = some v) :
   450	    Source.read lenv .word a' = .ok (enc v) := by
   451	  cases a with
   452	  | reg r =>
   453	    obtain ⟨n, hn, hl⟩ := hag r v hv
   454	    simp [operand, idOf, hn, bind, Except.bind, pure, Except.pure] at ha
   455	    subst ha
   456	    simp [Source.read, hl, enc_width, word_bne, bind, Except.bind, pure, Except.pure]
   457	  | imm t x =>
   458	    simp only [operand, pure, Except.pure] at ha
   459	    cases ha
   460	    simp only [evalOp] at hv
   461	    split at hv
   462	    · cases hv; simp [Source.read, enc, word, Source.Value.width, word_bne, bind, Except.bind, pure, Except.pure]
   463	    · cases hv
   464	
   465	/-- A write at a word slot inside the environment succeeds. -/
   466	theorem write_ok {f : Source.Function} {env : Source.Environment} {n : Nat} {val : Source.Value}
   467	    (hw : f.valueWidths[n]? = some .word) (hs : n < env.size) (hv : val.width = .word) :
   468	    Source.write f env n val = .ok (env.set! n (some val)) := by
   469	  have : ¬ n ≥ env.size := by omega
   470	  simp [Source.write, hw, this, hv, word_bne, pure, Except.pure, Array.set!_eq_setIfInBounds]
   471	
   472	/-- Writing a slot no register owns keeps agreement. -/
   473	theorem agrees_set_other {p : Program} {benv : Env} {lenv : Source.Environment} {m : Nat}
   474	    {x : Option Source.Value} (hag : Agrees p benv lenv) (hm : ∀ r n, regId p r = some n → n ≠ m) :
   475	    Agrees p benv (lenv.set! m x) := by
   476	  intro r v hv
   477	  obtain ⟨n, hn, hl⟩ := hag r v hv
   478	  refine ⟨n, hn, ?_⟩
   479	  rw [Array.set!_eq_setIfInBounds, Array.getElem?_setIfInBounds_ne (hm r n hn).symm]
   480	  exact hl
   481	
   482	/-- Defining register `d` with `v` at its own slot extends agreement. -/
   483	theorem agrees_define {p : Program} (hok : numberingOk p = true) {benv : Env}
   484	    {lenv : Source.Environment} {d : Reg} {nd : Nat} {v : Val} (hag : Agrees p benv lenv)
   485	    (hd : regId p d = some nd) (hs : nd < lenv.size) :
   486	    Agrees p ((d, v) :: benv) (lenv.set! nd (some (enc v))) := by
   487	  intro r w hw
   488	  simp only [lookup] at hw
   489	  by_cases hdr : d = r
   490	  · subst hdr
   491	    simp at hw
   492	    subst hw
   493	    refine ⟨nd, hd, ?_⟩
   494	    simp [Array.set!_eq_setIfInBounds, hs]
   495	  · simp [hdr] at hw
   496	    obtain ⟨n, hn, hl⟩ := hag r w hw
   497	    refine ⟨n, hn, ?_⟩
   498	    have hne : nd ≠ n := by
   499	      rintro rfl; exact hdr (regId_injective hok hd hn)
   500	    rw [Array.set!_eq_setIfInBounds, Array.getElem?_setIfInBounds_ne hne]
   501	    exact hl
   502	
   503	/-! ## `adapter_correct`, instructions -/
   504	
   505	/-- One body step: the instruction at the current position evaluates and writes. -/
   506	theorem step_body {f : Source.Function} {s : Source.State} {lb : Source.Block}
   507	    {i : Source.Instruction} {v : Source.Value} {env' : Source.Environment}
   508	    (hb : f.blocks[s.block]? = some lb) (hi : lb.instructions[s.position]? = some i)
   509	    (he : Source.evaluate s.environment i = .ok v)
   510	    (hw : Source.write f s.environment i.destination v = .ok env') :
   511	    Source.step f s = .ok (.next { s with position := s.position + 1, environment := env' }) := by
   512	  have hp : s.position < lb.instructions.size := by
   513	    rcases Nat.lt_or_ge s.position lb.instructions.size with h | h
   514	    · exact h
   515	    · simp [Array.getElem?_eq_none h] at hi
   516	  have hi' : lb.instructions[s.position] = i := by
   517	    rw [Array.getElem?_eq_getElem hp] at hi; exact Option.some.inj hi
   518	  simp [Source.step, hb, hp, hi', he, hw, bind, Except.bind, pure, Except.pure]
   519	
   520	/-- What a successful `bin` expansion is. -/
   521	theorem inst_bin {p : Program} {n : Nat} {op : BinOp} {t : IntTy} {d : Reg} {a b : Operand}
   522	    {xs : List Source.Instruction} (h : inst p n (.bin op t d a b) = .ok xs) :
   523	    inProfile t = true ∧ ∃ a' b', operand p a = .ok a' ∧ operand p b = .ok b' ∧
   524	      xs = [ins n (.binary (opBinary op) a' b'),
   525	        ins (n + 1) (.binary .sub (.local n) (.literal (word t.min))),
   526	        ins (n + 2) (.binary .andBits (.local (n + 1)) (.literal (word (2 ^ t.bits - 1)))),
   527	        ins (n + 3) (.binary .add (.local (n + 2)) (.literal (word t.min)))] := by
   528	  unfold inst at h
   529	  cases hp : inProfile t <;> cases ha : operand p a <;> cases hb : operand p b <;>
   530	    simp_all [bind, Except.bind, pure, Except.pure]
   531	
   532	/-- What a successful `binOvf` expansion is. -/
   533	theorem inst_binOvf {p : Program} {n : Nat} {op : BinOp} {t : IntTy} {d fl : Reg} {a b : Operand}
   534	    {xs : List Source.Instruction} (h : inst p n (.binOvf op t d fl a b) = .ok xs) :
   535	    inProfile t = true ∧ ∃ a' b', operand p a = .ok a' ∧ operand p b = .ok b' ∧
   536	      xs = [ins n (.binary (opBinary op) a' b'),
   537	        ins (n + 1) (.binary .sub (.local n) (.literal (word t.min))),
   538	        ins (n + 2) (.binary .andBits (.local (n + 1)) (.literal (word (2 ^ t.bits - 1)))),
   539	        ins (n + 3) (.binary .add (.local (n + 2)) (.literal (word t.min))),
   540	        ins (n + 4) (.compare .unsignedLT .word (.local (n + 1)) (.literal (word (2 ^ t.bits)))),
   541	        ins (n + 5) (.compare .eq .word (.local (n + 4)) (.literal (word 0)))] := by
   542	  unfold inst at h
   543	  cases hp : inProfile t <;> cases ha : operand p a <;> cases hb : operand p b <;>
   544	    simp_all [bind, Except.bind, pure, Except.pure]
   545	
   546	/-- What a successful `trunc` expansion is. -/
   547	theorem inst_trunc {p : Program} {n : Nat} {fr to : IntTy} {d : Reg} {a : Operand}
   548	    {xs : List Source.Instruction} (h : inst p n (.trunc fr to d a) = .ok xs) :
   549	    inProfile to = true ∧ ∃ a', operand p a = .ok a' ∧
   550	      xs = [ins n (.binary .sub a' (.literal (word to.min))),
   551	        ins (n + 1) (.binary .andBits (.local n) (.literal (word (2 ^ to.bits - 1)))),
   552	        ins (n + 2) (.binary .add (.local (n + 1)) (.literal (word to.min)))] := by
   553	  unfold inst at h
   554	  cases hp : inProfile fr <;> cases hq : inProfile to <;> cases ha : operand p a <;>
   555	    simp_all [bind, Except.bind, pure, Except.pure]
   556	
   557	/-- Reading a slot just written. -/
   558	theorem read_set_self {env : Source.Environment} {n : Nat} {v : Source.Value} (hs : n < env.size)
   559	    (hv : v.width = .word) : Source.read (env.set! n (some v)) .word (.local n) = .ok v := by
   560	  simp [Source.read, Array.set!_eq_setIfInBounds, hs, hv, word_bne, bind, Except.bind, pure,
   561	    Except.pure]
   562	
   563	theorem read_literal (env : Source.Environment) (z : Int) : Source.read env .word (.literal (word z)) = .ok (word z) := by
   564	  simp [Source.read, word, Source.Value.width, word_bne, bind, Except.bind, pure, Except.pure]
   565	
   566	/-- Evaluating an expansion instruction on two word reads. -/
   567	theorem eval_bin {env : Source.Environment} {d : Nat} {op : Source.Binary} {a b : Source.Operand}
   568	    {p q : BitVec 32} (ha : Source.read env .word a = .ok (.word p))
   569	    (hb : Source.read env .word b = .ok (.word q)) :
   570	    Source.evaluate env (ins d (.binary op a b)) = .ok (.word (Source.binaryBits op p q)) := by
   571	  simp [Source.evaluate, ins, ha, hb, bind, Except.bind, Source.evaluateBinary]
   572	
   573	/-- Four consecutive slot writes, as a `bin` expansion makes them. -/
   574	def set4 (e : Source.Environment) (n : Nat) (u₀ u₁ u₂ v : Option Source.Value) : Source.Environment :=
   575	  (((e.set! n u₀).set! (n + 1) u₁).set! (n + 2) u₂).set! (n + 3) v
   576	
   577	theorem size_set! (e : Source.Environment) (m : Nat) (u : Option Source.Value) :
   578	    (e.set! m u).size = e.size := by
   579	  simp [Array.set!_eq_setIfInBounds]
   580	
   581	/-- The intermediate words of a `bin`/`binOvf` expansion: the raw result, minus `t.min`, masked. -/
   582	def raw (op : BinOp) (x y : Int) : BitVec 32 :=
   583	  Source.binaryBits (opBinary op) (BitVec.ofInt 32 x) (BitVec.ofInt 32 y)
   584	def biased (t : IntTy) (z : BitVec 32) : BitVec 32 := Source.binaryBits .sub z (BitVec.ofInt 32 t.min)
   585	def masked (t : IntTy) (z : BitVec 32) : BitVec 32 :=
   586	  Source.binaryBits .andBits z (BitVec.ofInt 32 (2 ^ t.bits - 1))
   587	
   588	/-- `Steps` compose. -/
   589	theorem steps_append {f : Source.Function} {m k : Nat} {s t u : Source.State} :
   590	    Source.Steps f m s t → Source.Steps f k t u → Source.Steps f (k + m) s u
   591	  | .zero _, h => h
   592	  | .succ h₁ h₂, h => .succ h₁ (steps_append h₂ h)
   593	
   594	/-- The four steps of a `bin` expansion compute the word of `wrap t (a op b)` at slot `n + 3`. -/
   595	theorem bin_steps {f : Source.Function} {s : Source.State} {lb : Source.Block} {n : Nat}
   596	    {op : BinOp} {t : IntTy} {a' b' : Source.Operand} {x y : Int} (ht : inProfile t = true)
   597	    (hb : f.blocks[s.block]? = some lb)
   598	    (hq : ∀ k, k < 4 → lb.instructions[s.position + k]? =
   599	      [ins n (.binary (opBinary op) a' b'),
   600	        ins (n + 1) (.binary .sub (.local n) (.literal (word t.min))),
   601	        ins (n + 2) (.binary .andBits (.local (n + 1)) (.literal (word (2 ^ t.bits - 1)))),
   602	        ins (n + 3) (.binary .add (.local (n + 2)) (.literal (word t.min)))][k]?)
   603	    (hA : Source.read s.environment .word a' = .ok (word x))
   604	    (hB : Source.read s.environment .word b' = .ok (word y))
   605	    (hW : ∀ m, m < s.environment.size → f.valueWidths[m]? = some .word)
   606	    (hs : n + 3 < s.environment.size) :
   607	    Source.Steps f 4 s ⟨s.block, s.position + 4,
   608	      set4 s.environment n (some (.word (raw op x y))) (some (.word (biased t (raw op x y))))
   609	        (some (.word (masked t (biased t (raw op x y))))) (some (word (wrap t (op.exact x y))))⟩ := by
   610	  obtain ⟨blk, pos, env⟩ := s
   611	  simp only at hb hq hA hB hW hs ⊢
   612	  let p₀ := raw op x y
   613	  let p₁ := biased t p₀
   614	  let p₂ := masked t p₁
   615	  let p₃ := Source.binaryBits .add p₂ (BitVec.ofInt 32 t.min)
   616	  let e₁ := env.set! n (some (.word p₀))
   617	  let e₂ := e₁.set! (n + 1) (some (.word p₁))
   618	  let e₃ := e₂.set! (n + 2) (some (.word p₂))
   619	  have z₁ : e₁.size = env.size := size_set! ..
   620	  have z₂ : e₂.size = env.size := (size_set! ..).trans z₁
   621	  have z₃ : e₃.size = env.size := (size_set! ..).trans z₂
   622	  have hv₃ : word (wrap t (op.exact x y)) = .word p₃ := by
   623	    show word _ = .word (Source.binaryBits .add (Source.binaryBits .andBits (Source.binaryBits .sub
   624	      (Source.binaryBits (opBinary op) (BitVec.ofInt 32 x) (BitVec.ofInt 32 y)) _) _) _)
   625	    rw [binaryBits_exact]
   626	    show word _ = Source.Value.word ((BitVec.ofInt 32 (op.exact x y) - BitVec.ofInt 32 t.min &&&
   627	      BitVec.ofInt 32 (2 ^ t.bits - 1)) + BitVec.ofInt 32 t.min)
   628	    rw [wrap_word ht]; rfl
   629	  show Source.Steps f 4 ⟨blk, pos, env⟩ ⟨blk, pos + 4, e₃.set! (n + 3) (some (word _))⟩
   630	  rw [hv₃]
   631	  have s₀ := step_body (s := ⟨blk, pos, env⟩) hb (by simpa using hq 0 (by omega))
   632	    (eval_bin (d := n) (op := opBinary op) hA hB)
   633	    (write_ok (n := n) (hW n (by omega)) (by first | omega | (dsimp only; omega)) rfl)
   634	  have s₁ := step_body (s := ⟨blk, pos + 1, e₁⟩) hb (by simpa [Nat.add_assoc] using hq 1 (by omega))
   635	    (eval_bin (d := n + 1) (op := .sub) (read_set_self (by omega) rfl) (read_literal _ t.min))
   636	    (write_ok (n := n + 1) (hW (n + 1) (by omega)) (by first | omega | (dsimp only; omega)) rfl)
   637	  have s₂ := step_body (s := ⟨blk, pos + 1 + 1, e₂⟩) hb
   638	    (by simpa [Nat.add_assoc] using hq 2 (by omega))
   639	    (eval_bin (d := n + 2) (op := .andBits) (read_set_self (by omega) rfl)
   640	      (read_literal _ (2 ^ t.bits - 1)))
   641	    (write_ok (n := n + 2) (hW (n + 2) (by omega)) (by first | omega | (dsimp only; omega)) rfl)
   642	  have s₃ := step_body (s := ⟨blk, pos + 1 + 1 + 1, e₃⟩) hb
   643	    (by simpa [Nat.add_assoc] using hq 3 (by omega))
   644	    (eval_bin (d := n + 3) (op := .add) (read_set_self (by omega) rfl) (read_literal _ t.min))
   645	    (write_ok (n := n + 3) (hW (n + 3) (by omega)) (by first | omega | (dsimp only; omega)) rfl)
   646	  exact .succ s₀ (.succ s₁ (.succ s₂ (.succ s₃ (.zero _))))
   647	
   648	/-- Reading a slot past a write to another slot. -/
   649	theorem read_set_other {env : Source.Environment} {m k : Nat} {u : Option Source.Value} {w : Width}
   650	    (h : m ≠ k) : Source.read (env.set! m u) w (.local k) = Source.read env w (.local k) := by
   651	  simp [Source.read, Array.set!_eq_setIfInBounds, Array.getElem?_setIfInBounds_ne h]
   652	
   653	/-- Evaluating an expansion comparison on two word reads. -/
   654	theorem eval_cmp {env : Source.Environment} {d : Nat} {op : Source.Comparison}
   655	    {a b : Source.Operand} {p q : BitVec 32} (ha : Source.read env .word a = .ok (.word p))
   656	    (hb : Source.read env .word b = .ok (.word q)) :
   657	    Source.evaluate env (ins d (.compare op .word a b)) =
   658	      Source.evaluateComparison op (.word p) (.word q) := by
   659	  simp [Source.evaluate, ins, ha, hb, word_bne, bind, Except.bind]
   660	
   661	/-- The words LCB's comparisons give. Named, so that unification never evaluates them. -/
   662	def ultBit (p q : BitVec 32) : BitVec 32 := if p.toNat < q.toNat then 1 else 0
   663	def eqBit (p q : BitVec 32) : BitVec 32 := if p.toNat = q.toNat then 1 else 0
   664	
   665	theorem cmp_ult (p q : BitVec 32) : Source.evaluateComparison .unsignedLT (.word p) (.word q) =
   666	    .ok (.word (ultBit p q)) := by
   667	  by_cases h : p.toNat < q.toNat <;>
   668	    simp [Source.evaluateComparison, Source.Value.width, Source.Value.toNat, word_bne, pure,
   669	      Except.pure, ultBit, h]
   670	
   671	theorem cmp_eq (p q : BitVec 32) : Source.evaluateComparison .eq (.word p) (.word q) =
   672	    .ok (.word (eqBit p q)) := by
   673	  by_cases h : p.toNat = q.toNat <;>
   674	    simp [Source.evaluateComparison, Source.Value.width, Source.Value.toNat, word_bne, pure,
   675	      Except.pure, eqBit, h]
   676	
   677	theorem pow_bits_toNat {t : IntTy} (ht : inProfile t = true) :
   678	    (BitVec.ofInt 32 (2 ^ t.bits)).toNat = 2 ^ t.bits := by
   679	  rcases inProfile_cases ht with rfl | rfl | rfl | rfl <;> decide
   680	
   681	/-- The overflow flag word: `1` exactly when the result is outside `t`. -/
   682	theorem flag_value {t : IntTy} (ht : inProfile t = true) (op : BinOp) {x y : Int}
   683	    (hx : t.inRange x = true) (hy : t.inRange y = true) :
   684	    eqBit (ultBit (biased t (raw op x y)) (BitVec.ofInt 32 (2 ^ t.bits))) (BitVec.ofInt 32 0) =
   685	      BitVec.ofInt 32 (if !t.inRange (op.exact x y) then 1 else 0) := by
   686	  unfold eqBit ultBit
   687	  have hf := flag_word ht op hx hy
   688	  have hr : biased t (raw op x y) = BitVec.ofInt 32 (op.exact x y) - BitVec.ofInt 32 t.min := by
   689	    simp only [biased, raw, binaryBits_exact]; rfl
   690	  rw [hr, pow_bits_toNat ht]
   691	  revert hf
   692	  generalize (BitVec.ofInt 32 (op.exact x y) - BitVec.ofInt 32 t.min).toNat = v
   693	  intro hf
   694	  cases h : t.inRange (op.exact x y)
   695	  · have hv : ¬ v < 2 ^ t.bits := by simpa [h] using hf
   696	    simp [hv]
   697	  · have hv : v < 2 ^ t.bits := by simpa [h] using hf
   698	    simp [hv]
   699	
   700	/-- The two flag steps of a `binOvf` expansion, from any slot `n + 1` holding the word `p`. -/
   701	theorem flag_steps {f : Source.Function} {lb : Source.Block} {blk : Source.BlockId} {pos n : Nat}
   702	    {E : Source.Environment} {p Q : BitVec 32} (hb : f.blocks[blk]? = some lb)
   703	    (hi₄ : lb.instructions[pos]? = some (ins (n + 4) (.compare .unsignedLT .word (.local (n + 1))
   704	      (.literal (.word Q)))))
   705	    (hi₅ : lb.instructions[pos + 1]? = some (ins (n + 5) (.compare .eq .word (.local (n + 4))
   706	      (.literal (word 0)))))
   707	    (r₁ : Source.read E .word (.local (n + 1)) = .ok (.word p))
   708	    (hW₄ : f.valueWidths[n + 4]? = some .word) (hW₅ : f.valueWidths[n + 5]? = some .word)
   709	    (hs : n + 5 < E.size) :
   710	    Source.Steps f 2 ⟨blk, pos, E⟩ ⟨blk, pos + 1 + 1,
   711	      (E.set! (n + 4) (some (.word (ultBit p Q)))).set! (n + 5)
   712	        (some (.word (eqBit (ultBit p Q) (BitVec.ofInt 32 0))))⟩ := by
   713	  have rQ : Source.read E .word (.literal (.word Q)) = .ok (.word Q) := by
   714	    simp [Source.read, Source.Value.width, word_bne, bind, Except.bind, pure, Except.pure]
   715	  have s₄ := step_body (s := ⟨blk, pos, E⟩) hb hi₄
   716	    ((eval_cmp (d := n + 4) r₁ rQ).trans (cmp_ult _ _))
   717	    (write_ok (n := n + 4) hW₄ (by show n + 4 < E.size; omega) rfl)
   718	  have r₄ := read_set_self (env := E) (n := n + 4) (v := .word (ultBit p Q)) (by omega) rfl
   719	  have s₅ := step_body (s := ⟨blk, pos + 1, E.set! (n + 4) (some (.word (ultBit p Q)))⟩) hb hi₅
   720	    ((eval_cmp (d := n + 5) r₄ (read_literal _ 0)).trans (cmp_eq _ _))
   721	    (write_ok (n := n + 5) hW₅ (by show n + 5 < (E.set! _ _).size; rw [size_set!]; omega) rfl)
   722	  exact .succ s₄ (.succ s₅ (.zero _))
   723	
   724	/-- The six steps of a `binOvf` expansion: the wrapped result at slot `n + 3` and the overflow flag
   725	at slot `n + 5`, both as `enc` gives them. -/
   726	theorem binOvf_steps {f : Source.Function} {s : Source.State} {lb : Source.Block} {n : Nat}
   727	    {op : BinOp} {t : IntTy} {a' b' : Source.Operand} {x y : Int} (ht : inProfile t = true)
   728	    (hx : t.inRange x = true) (hy : t.inRange y = true)
   729	    (hb : f.blocks[s.block]? = some lb)
   730	    (hq : ∀ k, k < 6 → lb.instructions[s.position + k]? =
   731	      [ins n (.binary (opBinary op) a' b'),
   732	        ins (n + 1) (.binary .sub (.local n) (.literal (word t.min))),
   733	        ins (n + 2) (.binary .andBits (.local (n + 1)) (.literal (word (2 ^ t.bits - 1)))),
   734	        ins (n + 3) (.binary .add (.local (n + 2)) (.literal (word t.min))),
   735	        ins (n + 4) (.compare .unsignedLT .word (.local (n + 1)) (.literal (word (2 ^ t.bits)))),
   736	        ins (n + 5) (.compare .eq .word (.local (n + 4)) (.literal (word 0)))][k]?)
   737	    (hA : Source.read s.environment .word a' = .ok (word x))
   738	    (hB : Source.read s.environment .word b' = .ok (word y))
   739	    (hW : ∀ m, m < s.environment.size → f.valueWidths[m]? = some .word)
   740	    (hs : n + 5 < s.environment.size) :
   741	    ∃ u₄, Source.Steps f 6 s ⟨s.block, s.position + 6,
   742	      ((set4 s.environment n (some (.word (raw op x y))) (some (.word (biased t (raw op x y))))
   743	        (some (.word (masked t (biased t (raw op x y))))) (some (word (wrap t (op.exact x y))))).set!
   744	        (n + 4) u₄).set! (n + 5) (some (enc (.bool (!t.inRange (op.exact x y)))))⟩ := by
   745	  obtain ⟨blk, pos, env⟩ := s
   746	  simp only at hb hq hA hB hW hs ⊢
   747	  let E := set4 env n (some (.word (raw op x y))) (some (.word (biased t (raw op x y))))
   748	    (some (.word (masked t (biased t (raw op x y))))) (some (word (wrap t (op.exact x y))))
   749	  have h4 : Source.Steps f 4 ⟨blk, pos, env⟩ ⟨blk, pos + 4, E⟩ :=
   750	    bin_steps (s := ⟨blk, pos, env⟩) ht hb (fun k hk => by
   751	      rw [hq k (by omega)]; rcases k with _ | _ | _ | _ | k <;> first | rfl | omega)
   752	      hA hB hW (by first | omega | (dsimp only; omega))
   753	  have zE : E.size = env.size := by simp only [E, set4, size_set!]
   754	  have r₁ : Source.read E .word (.local (n + 1)) = .ok (.word (biased t (raw op x y))) := by
   755	    simp only [E, set4]
   756	    rw [read_set_other (by omega), read_set_other (by omega)]
   757	    exact read_set_self (by simp only [size_set!]; omega) rfl
   758	  have h2 := flag_steps (E := E) (pos := pos + 4) (Q := BitVec.ofInt 32 (2 ^ t.bits)) hb
   759	    (hq 4 (by omega)) (by simpa [Nat.add_assoc] using hq 5 (by omega)) r₁
   760	    (hW (n + 4) (by omega)) (hW (n + 5) (by omega)) (by omega)
   761	  refine ⟨some (.word (ultBit (biased t (raw op x y)) (BitVec.ofInt 32 (2 ^ t.bits)))), ?_⟩
   762	  have hflag : enc (.bool (!t.inRange (op.exact x y))) = .word (eqBit (ultBit (biased t
   763	      (raw op x y)) (BitVec.ofInt 32 (2 ^ t.bits))) (BitVec.ofInt 32 0)) := by
   764	    simp only [enc, word]; rw [flag_value ht op hx hy]
   765	  rw [hflag, show pos + 6 = pos + 4 + 1 + 1 from rfl]
   766	  exact steps_append h4 h2
   767	
   768	/-- The three steps of a `trunc` expansion compute the word of `wrap to x` at slot `n + 2`. -/
   769	theorem trunc_steps {f : Source.Function} {s : Source.State} {lb : Source.Block} {n : Nat}
   770	    {to : IntTy} {a' : Source.Operand} {x : Int} (ht : inProfile to = true)
   771	    (hb : f.blocks[s.block]? = some lb)
   772	    (hq : ∀ k, k < 3 → lb.instructions[s.position + k]? =
   773	      [ins n (.binary .sub a' (.literal (word to.min))),
   774	        ins (n + 1) (.binary .andBits (.local n) (.literal (word (2 ^ to.bits - 1)))),
   775	        ins (n + 2) (.binary .add (.local (n + 1)) (.literal (word to.min)))][k]?)
   776	    (hA : Source.read s.environment .word a' = .ok (word x))
   777	    (hW : ∀ m, m < s.environment.size → f.valueWidths[m]? = some .word)
   778	    (hs : n + 2 < s.environment.size) :
   779	    Source.Steps f 3 s ⟨s.block, s.position + 3,
   780	      ((s.environment.set! n (some (.word (biased to (BitVec.ofInt 32 x))))).set! (n + 1)
   781	        (some (.word (masked to (biased to (BitVec.ofInt 32 x)))))).set! (n + 2)
   782	        (some (word (wrap to x)))⟩ := by
   783	  obtain ⟨blk, pos, env⟩ := s
   784	  simp only at hb hq hA hW hs ⊢
   785	  let p₀ := biased to (BitVec.ofInt 32 x)
   786	  let p₁ := masked to p₀
   787	  let e₁ := env.set! n (some (.word p₀))
   788	  let e₂ := e₁.set! (n + 1) (some (.word p₁))
   789	  have z₁ : e₁.size = env.size := size_set! ..
   790	  have z₂ : e₂.size = env.size := (size_set! ..).trans z₁
   791	  have hv : word (wrap to x) = .word (Source.binaryBits .add p₁ (BitVec.ofInt 32 to.min)) := by
   792	    show word _ = Source.Value.word ((BitVec.ofInt 32 x - BitVec.ofInt 32 to.min &&&
   793	      BitVec.ofInt 32 (2 ^ to.bits - 1)) + BitVec.ofInt 32 to.min)
   794	    rw [wrap_word ht]; rfl
   795	  show Source.Steps f 3 ⟨blk, pos, env⟩ ⟨blk, pos + 3, e₂.set! (n + 2) (some (word _))⟩
   796	  rw [hv]
   797	  have s₀ := step_body (s := ⟨blk, pos, env⟩) hb (by simpa using hq 0 (by omega))
   798	    (eval_bin (d := n) (op := .sub) hA (read_literal _ to.min))
   799	    (write_ok (n := n) (hW n (by omega)) (by first | omega | (dsimp only; omega)) rfl)
   800	  have s₁ := step_body (s := ⟨blk, pos + 1, e₁⟩) hb (by simpa [Nat.add_assoc] using hq 1 (by omega))
   801	    (eval_bin (d := n + 1) (op := .andBits) (read_set_self (by omega) rfl)
   802	      (read_literal _ (2 ^ to.bits - 1)))
   803	    (write_ok (n := n + 1) (hW (n + 1) (by omega)) (by first | omega | (dsimp only; omega)) rfl)
   804	  have s₂ := step_body (s := ⟨blk, pos + 1 + 1, e₂⟩) hb
   805	    (by simpa [Nat.add_assoc] using hq 2 (by omega))
   806	    (eval_bin (d := n + 2) (op := .add) (read_set_self (by omega) rfl) (read_literal _ to.min))
   807	    (write_ok (n := n + 2) (hW (n + 2) (by omega)) (by first | omega | (dsimp only; omega)) rfl)
   808	  exact .succ s₀ (.succ s₁ (.succ s₂ (.zero _)))
   809	
   810	/-! ## `adapter_correct`, the invariant through one instruction -/
   811	
   812	/-- Every integer a BIR environment binds is in its type's range (immediates are, by WF; results
   813	are, by `wrap_inRange`). `binOvf_steps` needs it: agreement alone would let a `.u8` register hold
   814	`2 ^ 32`, whose word is `0`. -/
   815	def InRange (benv : Env) : Prop := ∀ r t x, lookup benv r = some (.int t x) → t.inRange x = true
   816	
   817	theorem inRange_cons {benv : Env} {d : Reg} {v : Val} (hr : InRange benv)
   818	    (hv : ∀ t x, v = .int t x → t.inRange x = true) : InRange ((d, v) :: benv) := by
   819	  intro r t x h
   820	  simp only [lookup] at h
   821	  by_cases hdr : d = r
   822	  · simp [hdr] at h; exact hv t x h
   823	  · simp [hdr] at h; exact hr r t x h
   824	
   825	theorem evalOp_inRange {benv : Env} {a : Operand} {t : IntTy} {x : Int} (hr : InRange benv)
   826	    (h : evalOp benv a = some (.int t x)) : t.inRange x = true := by
   827	  cases a with
   828	  | reg r => exact hr r t x h
   829	  | imm t' v =>
   830	    simp only [evalOp] at h
   831	    split at h
   832	    · cases h; assumption
   833	    · cases h
   834	
   835	theorem intArgs_ok {benv : Env} {t : IntTy} {a b : Operand} {x y : Int}
   836	    (h : intArgs benv t a b = some (x, y)) :
   837	    evalOp benv a = some (.int t x) ∧ evalOp benv b = some (.int t y) := by
   838	  unfold intArgs at h
   839	  split at h
   840	  · rename_i ta x' tb y' ha hb
   841	    split at h
   842	    · rename_i hab
   843	      obtain ⟨rfl, rfl⟩ := hab
   844	      cases h
   845	      exact ⟨ha, hb⟩
   846	    · cases h
   847	  · cases h
   848	
   849	/-- A register's id is a slot below `valueCount`. -/
   850	theorem regId_lt {p : Program} (hok : numberingOk p = true) {r : Reg} {n : Nat}
   851	    (h : regId p r = some n) : n < valueCount p := by
   852	  simp only [numberingOk, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at hok
   853	  exact hok.1.1.2 n (List.mem_map.mpr ⟨(r, n), mem_of_lookup h, rfl⟩)
   854	
   855	theorem ids_nodup {p : Program} (hok : numberingOk p = true) : ((ids p).map Prod.fst).Nodup := by
   856	  simp only [numberingOk, Bool.and_eq_true, decide_eq_true_eq] at hok
   857	  exact hok.1.1.1.1
   858	
   859	theorem inter_mem {p : Program} {j i off : Nat} {b : Block} {ins : Inst}
   860	    (hb : p.blocks[j]? = some b) (hi : b.insts[i]? = some ins) (ho : off ∈ interOffsets ins) :
   861	    blockBase p j + instBase b i + off ∈ intermediates p := by
   862	  simp only [intermediates, List.mem_flatMap, List.mem_map]
   863	  exact ⟨(j, b), Runtime.mem_indexed hb, (i, ins), Runtime.mem_indexed hi, off, ho, rfl⟩
   864	
   865	/-- No register has an intermediate's id. -/
   866	theorem inter_not_reg {p : Program} (hok : numberingOk p = true) {m : Nat}
   867	    (hm : m ∈ intermediates p) : ∀ r n, regId p r = some n → n ≠ m := by
   868	  intro r n hr heq
   869	  subst heq
   870	  simp only [numberingOk, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at hok
   871	  have h := hok.2 n hm
   872	  have hmem : n ∈ (ids p).map Prod.snd := List.mem_map.mpr ⟨(r, n), mem_of_lookup hr, rfl⟩
   873	  simp [hmem] at h
   874	
   875	theorem size_set4 (e : Source.Environment) (n : Nat) (u₀ u₁ u₂ v : Option Source.Value) :
   876	    (set4 e n u₀ u₁ u₂ v).size = e.size := by
   877	  simp only [set4, size_set!]
   878	
   879	/-- One `bin` instruction: its four LCB steps keep agreement, range and size, with the result
   880	bound. -/
   881	theorem bin_sim {p : Program} (hok : numberingOk p = true) {f : Source.Function}
   882	    {j i : Nat} {b : Block} {op : BinOp} {t : IntTy} {d : Reg} {a c : Operand}
   883	    {xs : List Source.Instruction} {s : Source.State} {lb : Source.Block} {benv benv' : Env}
   884	    (hbj : p.blocks[j]? = some b) (hi : b.insts[i]? = some (.bin op t d a c))
   885	    (hx : inst p (blockBase p j + instBase b i) (.bin op t d a c) = .ok xs)
   886	    (hb : f.blocks[s.block]? = some lb)
   887	    (hq : ∀ k, k < 4 → lb.instructions[s.position + k]? = xs[k]?)
   888	    (hW : ∀ m, m < s.environment.size → f.valueWidths[m]? = some .word)
   889	    (hsz : s.environment.size = valueCount p)
   890	    (hag : Agrees p benv s.environment) (hr : InRange benv)
   891	    (he : execInst benv (.bin op t d a c) = some benv') :
   892	    ∃ env', Source.Steps f 4 s ⟨s.block, s.position + 4, env'⟩ ∧ env'.size = valueCount p ∧
   893	      Agrees p benv' env' ∧ InRange benv' := by
   894	  obtain ⟨ht, a', c', ha', hc', rfl⟩ := inst_bin hx
   895	  simp only [execInst, bind, Option.bind] at he
   896	  split at he
   897	  · cases he
   898	  · rename_i xy hxy
   899	    obtain ⟨x, y⟩ := xy
   900	    cases he
   901	    obtain ⟨hax, hcy⟩ := intArgs_ok hxy
   902	    let n := blockBase p j + instBase b i
   903	    have hd : regId p d = some (n + 3) := regId_inst (ids_nodup hok) hbj hi (by simp [instDefs])
   904	    have hn3 : n + 3 < s.environment.size := hsz ▸ regId_lt hok hd
   905	    have hst := bin_steps (s := s) (n := n) ht hb hq (read_operand hag ha' hax)
   906	      (read_operand hag hc' hcy) hW hn3
   907	    refine ⟨_, hst, by rw [size_set4]; exact hsz, ?_, ?_⟩
   908	    · have m₀ := inter_not_reg hok (inter_mem (off := 0) hbj hi (by simp [interOffsets]))
   909	      have m₁ := inter_not_reg hok (inter_mem (off := 1) hbj hi (by simp [interOffsets]))
   910	      have m₂ := inter_not_reg hok (inter_mem (off := 2) hbj hi (by simp [interOffsets]))
   911	      exact agrees_define hok (agrees_set_other (agrees_set_other (agrees_set_other hag m₀) m₁) m₂)
   912	        hd (by simp only [size_set!]; omega)
   913	    · exact inRange_cons hr (fun t' x' h => by cases h; exact wrap_inRange _ _)
   914	
   915	/-- One `binOvf` instruction: its six LCB steps keep agreement, range and size, with the result
   916	and the flag bound. -/
   917	theorem binOvf_sim {p : Program} (hok : numberingOk p = true) {f : Source.Function}
   918	    {j i : Nat} {b : Block} {op : BinOp} {t : IntTy} {d fl : Reg} {a c : Operand}
   919	    {xs : List Source.Instruction} {s : Source.State} {lb : Source.Block} {benv benv' : Env}
   920	    (hbj : p.blocks[j]? = some b) (hi : b.insts[i]? = some (.binOvf op t d fl a c))
   921	    (hx : inst p (blockBase p j + instBase b i) (.binOvf op t d fl a c) = .ok xs)
   922	    (hb : f.blocks[s.block]? = some lb)
   923	    (hq : ∀ k, k < 6 → lb.instructions[s.position + k]? = xs[k]?)
   924	    (hW : ∀ m, m < s.environment.size → f.valueWidths[m]? = some .word)
   925	    (hsz : s.environment.size = valueCount p)
   926	    (hag : Agrees p benv s.environment) (hr : InRange benv)
   927	    (he : execInst benv (.binOvf op t d fl a c) = some benv') :
   928	    ∃ env', Source.Steps f 6 s ⟨s.block, s.position + 6, env'⟩ ∧ env'.size = valueCount p ∧
   929	      Agrees p benv' env' ∧ InRange benv' := by
   930	  obtain ⟨ht, a', c', ha', hc', rfl⟩ := inst_binOvf hx
   931	  simp only [execInst, bind, Option.bind] at he
   932	  split at he
   933	  · cases he
   934	  · rename_i xy hxy
   935	    obtain ⟨x, y⟩ := xy
   936	    cases he
   937	    obtain ⟨hax, hcy⟩ := intArgs_ok hxy
   938	    let n := blockBase p j + instBase b i
   939	    have hd : regId p d = some (n + 3) := regId_inst (ids_nodup hok) hbj hi (by simp [instDefs])
   940	    have hf : regId p fl = some (n + 5) := regId_inst (ids_nodup hok) hbj hi (by simp [instDefs])
   941	    have hn5 : n + 5 < s.environment.size := hsz ▸ regId_lt hok hf
   942	    obtain ⟨u₄, hst⟩ := binOvf_steps (s := s) (n := n) ht (evalOp_inRange hr hax)
   943	      (evalOp_inRange hr hcy) hb hq (read_operand hag ha' hax) (read_operand hag hc' hcy) hW hn5
   944	    refine ⟨_, hst, by simp only [size_set!, size_set4]; exact hsz, ?_, ?_⟩
   945	    · have m₀ := inter_not_reg hok (inter_mem (off := 0) hbj hi (by simp [interOffsets]))
   946	      have m₁ := inter_not_reg hok (inter_mem (off := 1) hbj hi (by simp [interOffsets]))
   947	      have m₂ := inter_not_reg hok (inter_mem (off := 2) hbj hi (by simp [interOffsets]))
   948	      have m₄ := inter_not_reg hok (inter_mem (off := 4) hbj hi (by simp [interOffsets]))
   949	      have hdef : Agrees p ((d, .int t (wrap t (op.exact x y))) :: benv)
   950	          (set4 s.environment n (some (.word (raw op x y))) (some (.word (biased t (raw op x y))))
   951	            (some (.word (masked t (biased t (raw op x y))))) (some (word (wrap t (op.exact x y))))) :=
   952	        agrees_define hok (agrees_set_other (agrees_set_other (agrees_set_other hag m₀) m₁) m₂) hd
