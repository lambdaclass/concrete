    82	/-- An LLVM `c"..."` string body over the UTF-8 bytes: printable ASCII except `"` and `\` verbatim,
    83	every other byte as `\XX`. -/
    84	def llvmEscape (s : String) : String :=
    85	  String.join (s.toUTF8.toList.map fun b =>
    86	    let n := b.toNat
    87	    if 32 ≤ n ∧ n < 127 ∧ n ≠ 34 ∧ n ≠ 92 then (Char.ofNat n).toString
    88	    else
    89	      let hex := Nat.toDigits 16 n
    90	      "\\" ++ String.ofList ((if hex.length < 2 then ['0'] else []) ++ hex.map Char.toUpper))
    91	
    92	/-- The runtime entry as LLVM text, for the site table `tbl`. -/
    93	def llvm (tbl : SiteTable) : String :=
    94	  let sites := indexed tbl
    95	  let globals := sites.map fun (i, e) =>
    96	    let line := trapLine e ++ "\n"
    97	    s!"@.site{i} = private constant [{line.utf8ByteSize} x i8] c\"{llvmEscape line}\"\n"
    98	  let cases := String.join (sites.map fun (i, _) => s!" i32 {i}, label %t{i}")
    99	  let traps := sites.map fun (i, e) =>
   100	    s!"t{i}:\n  call void @concrete_rt_write_all(ptr @.site{i}, i64 {(trapLine e ++ "\n").utf8ByteSize})\n" ++
   101	    "  call void @_exit(i32 134)\n  unreachable\n"
   102	  String.join globals ++
   103	  s!"@.bad = private constant [{(invalidLine ++ "\n").utf8ByteSize} x i8] c\"{llvmEscape (invalidLine ++ "\n")}\"\n" ++
   104	  "declare i64 @write(i32, ptr, i64)\n" ++
   105	  "declare void @_exit(i32)\n" ++
   106	  "declare void @abort()\n\n" ++
   107	  "define internal void @concrete_rt_write_all(ptr %p, i64 %n) {\n" ++
   108	  "entry:\n  br label %loop\n" ++
   109	  "loop:\n  %pp = phi ptr [ %p, %entry ], [ %np, %more ]\n" ++
   110	  "  %nn = phi i64 [ %n, %entry ], [ %rest, %more ]\n" ++
   111	  "  %done = icmp eq i64 %nn, 0\n  br i1 %done, label %out, label %wr\n" ++
   112	  "wr:\n  %k = call i64 @write(i32 2, ptr %pp, i64 %nn)\n" ++
   113	  "  %bad = icmp sle i64 %k, 0\n  br i1 %bad, label %out, label %more\n" ++
   114	  "more:\n  %np = getelementptr i8, ptr %pp, i64 %k\n  %rest = sub i64 %nn, %k\n  br label %loop\n" ++
   115	  "out:\n  ret void\n}\n\n" ++
   116	  "define i32 @main() {\n" ++
   117	  "entry:\n  %w = call i32 @concrete_body()\n  %ok = icmp ult i32 %w, 256\n" ++
   118	  "  br i1 %ok, label %exit, label %trap\n" ++
   119	  "exit:\n  ret i32 %w\n" ++
   120	  "trap:\n  %i = sub i32 %w, 256\n" ++
   121	  s!"  switch i32 %i, label %bad [{cases} ]\n" ++
   122	  String.join traps ++
   123	  "bad:\n" ++
   124	  s!"  call void @concrete_rt_write_all(ptr @.bad, i64 {(invalidLine ++ "\n").utf8ByteSize})\n" ++
   125	  "  call void @abort()\n  unreachable\n}\n"
   126	
   127	/-- QBE data bytes for a string: one `b N` per UTF-8 byte, so no character needs escaping. -/
   128	def qbeBytes (s : String) : String := ", ".intercalate (s.toUTF8.toList.map fun b => s!"b {b}")
   129	
   130	/-- The runtime entry as QBE text for LCB, for the site table `tbl`. -/
   131	def qbe (tbl : SiteTable) : String :=
   132	  let sites := indexed tbl
   133	  let datas := sites.map fun (i, e) => s!"data $site{i} = \{ {qbeBytes (trapLine e ++ "\n")} }\n"
   134	  let dispatch := sites.map fun (i, e) =>
   135	    s!"@c{i}\n    %c{i} =w ceqw %i, {i}\n    jnz %c{i}, @t{i}, @c{i + 1}\n" ++
   136	    s!"@t{i}\n    call $concrete_rt_write_all(l $site{i}, l {(trapLine e ++ "\n").utf8ByteSize})\n" ++
   137	    "    call $_exit(w 134)\n    ret 0\n"
   138	  String.join datas ++
   139	  s!"data $bad = \{ {qbeBytes (invalidLine ++ "\n")} }\n" ++
   140	  "function $concrete_rt_write_all(l %p, l %n) {\n" ++
   141	  "@start\n    jmp @loop\n" ++
   142	  "@loop\n    %done =w ceql %n, 0\n    jnz %done, @out, @wr\n" ++
   143	  "@wr\n    %k =l call $write(w 2, l %p, l %n)\n    %bad =w cslel %k, 0\n    jnz %bad, @out, @more\n" ++
   144	  "@more\n    %p =l add %p, %k\n    %n =l sub %n, %k\n    jmp @loop\n" ++
   145	  "@out\n    ret\n}\n\n" ++
   146	  "export function w $main() {\n" ++
   147	  "@start\n    %w =w call $concrete_body()\n    %ok =w cultw %w, 256\n    jnz %ok, @exit, @trap\n" ++
   148	  "@exit\n    ret %w\n" ++
   149	  "@trap\n    %i =w sub %w, 256\n    jmp @c0\n" ++
   150	  String.join dispatch ++
   151	  s!"@c{tbl.length}\n    call $concrete_rt_write_all(l $bad, l {(invalidLine ++ "\n").utf8ByteSize})\n" ++
   152	  "    call $abort()\n    ret 0\n" ++
   153	  "}\n"
   154	
   155	end Concrete.Backend.Runtime
