  1352	/-- The edges into `t` from block `j` are exactly `j`'s own. -/
  1353	theorem incoming_filter {p : Program} {j t : Nat} {bj : Block} (hbj : p.blocks[j]? = some bj) :
  1354	    (incoming p t).filter (·.1 == j) = edgesTo t j bj.term := by
  1355	  unfold incoming
  1356	  rw [List.filter_flatMap]
  1357	  have hc : (fun (kx : Nat × Block) => (match kx with | (k, b) => edgesTo t k b.term).filter
  1358	      (·.1 == j)) = (fun (kx : Nat × Block) => if kx.1 = j then edgesTo t kx.1 kx.2.term else []) := by
  1359	    funext kx
  1360	    obtain ⟨k, b⟩ := kx
  1361	    simp only
  1362	    by_cases h : k = j
  1363	    · simp only [h, ↓reduceIte]
  1364	      apply List.filter_eq_self.mpr
  1365	      intro x hx
  1366	      simp [edgesTo_fst x hx]
  1367	    · simp only [h, ↓reduceIte]
  1368	      apply List.filter_eq_nil_iff.mpr
  1369	      intro x hx
  1370	      simp [edgesTo_fst x hx, h]
  1371	  rw [hc]
  1372	  have := flatMap_indexedFrom_pick (fun k (b : Block) => edgesTo t k b.term) j 0 p.blocks
  1373	  simp only [Nat.sub_zero, hbj, Nat.zero_le, ↓reduceIte] at this
  1374	  exact this
