  1064	/-- The expansions of a block's instructions have the instructions' widths. -/
  1065	theorem insts_lengths {p : Program} {j : Nat} {b : Block} {xss : List (List Source.Instruction)}
  1066	    (hx : (indexed b.insts).mapM (adaptInst p j b) = .ok xss) :
  1067	    xss.map List.length = b.insts.map Inst.width := by
  1068	  have hlen := (mapM_ok hx).1
  1069	  rw [length_indexed] at hlen
  1070	  apply List.ext_getElem?
  1071	  intro m
  1072	  simp only [List.getElem?_map]
  1073	  cases hm : b.insts[m]? with
  1074	  | none =>
  1075	    have : xss.length ≤ m := by
  1076	      have := List.getElem?_eq_none_iff.mp hm; omega
  1077	    simp [List.getElem?_eq_none this]
  1078	  | some ins' =>
  1079	    obtain ⟨ys, hys, hym⟩ := mapM_ok_ok hx (i := m) (x := (m, ins'))
  1080	      (by simp [Runtime.getElem?_indexed, hm])
  1081	    simp [hym, inst_length (show inst p _ ins' = .ok ys from hys)]
