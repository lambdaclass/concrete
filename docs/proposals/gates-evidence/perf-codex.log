  1666	/-- Each BIR run from block `j` is matched by LCB from `⟨j, 0, env⟩`: an exit or a trap by a
  1667	return of its encoding, running out of fuel by at least `fuel` LCB steps. -/
  1668	theorem runBlock_sim {p : Program} (hwf : WF p) (hok : numberingOk p = true) {f : Source.Function}
  1669	    (hf : adapt p = .ok f) :
  1670	    ∀ (fuel j : Nat) (benv : Env) (env : Source.Environment), env.size = valueCount p →
  1671	      Agrees p benv env → InRange benv →
  1672	      match runBlock p fuel j benv with
  1673	      | .exited c => ∃ n s, Source.Steps f n ⟨j, 0, env⟩ s ∧
  1674	          Source.step f s = .ok (.returned (word c))
  1675	      | .trapped st => ∃ n s, Source.Steps f n ⟨j, 0, env⟩ s ∧
  1676	          Source.step f s = .ok (.returned (word (256 + st)))
  1677	      | .outOfFuel => ∃ n s, fuel ≤ n ∧ Source.Steps f n ⟨j, 0, env⟩ s
  1678	      | .stuck => True
  1679	  | 0, j, benv, env, _, _, _ => by
  1680	    simp only [runBlock]
  1681	    exact ⟨0, _, Nat.le_refl 0, .zero _⟩
  1682	  | fuel + 1, j, benv, env, hsz, hag, hr => by
  1683	    simp only [runBlock]
  1684	    cases hbj : p.blocks[j]? with
  1685	    | none => trivial
  1686	    | some bj =>
  1687	    simp only
  1688	    cases hex : execInsts benv bj.insts with
  1689	    | none => trivial
  1690	    | some benv₁ =>
  1691	    simp only
  1692	    obtain ⟨lb, hfb, hlb⟩ := adapt_block hf hbj
  1693	    obtain ⟨env₁, hst, hsz₁, hag₁, hr₁⟩ := body_sim hok (adapt_widths hf) hbj hlb hfb bj.insts 0
  1694	      benv benv₁ env (by simp) hex hsz hag hr
  1695	    simp only [instPos, List.take_zero, List.map_nil, List.sum_nil, Nat.zero_add] at hst
  1696	    -- after a jump to `tgt`, the rest of the run is the run from `tgt`
  1697	    have cont : ∀ (tgt : Nat) (benv₂ : Env) (env₂ : Source.Environment),
  1698	        Source.Steps f ((bj.insts.map Inst.width).sum + 1) ⟨j, 0, env⟩ ⟨tgt, 0, env₂⟩ →
  1699	        env₂.size = valueCount p → Agrees p benv₂ env₂ → InRange benv₂ →
  1700	        match runBlock p fuel tgt benv₂ with
  1701	        | .exited c => ∃ n s, Source.Steps f n ⟨j, 0, env⟩ s ∧
  1702	            Source.step f s = .ok (.returned (word c))
  1703	        | .trapped st => ∃ n s, Source.Steps f n ⟨j, 0, env⟩ s ∧
  1704	            Source.step f s = .ok (.returned (word (256 + st)))
  1705	        | .outOfFuel => ∃ n s, fuel + 1 ≤ n ∧ Source.Steps f n ⟨j, 0, env⟩ s
  1706	        | .stuck => True := by
  1707	      intro tgt benv₂ env₂ hpre hsz₂ hag₂ hr₂
  1708	      have ih := runBlock_sim hwf hok hf fuel tgt benv₂ env₂ hsz₂ hag₂ hr₂
  1709	      revert ih
  1710	      cases runBlock p fuel tgt benv₂ with
  1711	      | exited c =>
  1712	        rintro ⟨n, s, hs, hret⟩
  1713	        exact ⟨_, s, steps_append hpre hs, hret⟩
  1714	      | trapped st =>
  1715	        rintro ⟨n, s, hs, hret⟩
  1716	        exact ⟨_, s, steps_append hpre hs, hret⟩
  1717	      | outOfFuel =>
  1718	        rintro ⟨n, s, hn, hs⟩
  1719	        exact ⟨_, s, by omega, steps_append hpre hs⟩
  1720	      | stuck => intro; trivial
  1721	    have pre : ∀ {tgt : Nat} {env₂ : Source.Environment},
  1722	        Source.step f ⟨j, (bj.insts.map Inst.width).sum, env₁⟩ = .ok (.next ⟨tgt, 0, env₂⟩) →
  1723	        Source.Steps f ((bj.insts.map Inst.width).sum + 1) ⟨j, 0, env⟩ ⟨tgt, 0, env₂⟩ := by
  1724	      intro tgt env₂ hstep
  1725	      have := steps_append hst (.succ hstep (.zero _))
  1726	      rwa [Nat.add_comm] at this
  1727	    cases htm : bj.term with
  1728	    | ret a =>
  1729	      cases hv : evalOp benv₁ a with
  1730	      | none => simp only [hv]
  1731	      | some v =>
  1732	        rcases v with ⟨ty, c⟩ | bb
  1733	        · cases ty
  1734	          case u8 =>
  1735	            simp only [hv]
  1736	            have hc0 : 0 ≤ c := by
  1737	              have := evalOp_inRange hr₁ hv
  1738	              simp [IntTy.inRange, IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at this
  1739	              omega
  1740	            refine ⟨_, _, hst, ?_⟩
  1741	            rw [ret_sim hf hfb hlb htm hag₁ hv]
  1742	            simp [enc, Int.toNat_of_nonneg hc0]
  1743	          all_goals simp only [hv]
  1744	        · simp only [hv]
  1745	    | trap st =>
  1746	      by_cases hs : st < p.sites.length
  1747	      · simp only [hs, ↓reduceIte]
  1748	        exact ⟨_, _, hst, trap_sim hf hfb hlb htm env₁⟩
  1749	      · simp only [hs, ↓reduceIte]
  1750	    | br t args =>
  1751	      simp only
  1752	      cases hen : enter p t args benv₁ with
  1753	      | none => trivial
  1754	      | some benv₂ =>
  1755	      simp only
  1756	      have hedge : edgesTo t j bj.term = [(j, args)] := by simp [htm, edgesTo]
  1757	      obtain ⟨env₂, htr, hsz₂, hag₂, hr₂⟩ := edge_sim hok hf hbj hedge hen hsz₁ hag₁ hr₁
  1758	      have hterm := block_term hlb
  1759	      rw [htm] at hterm
  1760	      simp only [term, pure, Except.pure, Except.ok.injEq] at hterm
  1761	      exact cont t benv₂ env₂ (pre (step_jump hfb (block_size hlb).symm hterm.symm htr)) hsz₂ hag₂ hr₂
  1762	    | condbr c t ta e ea =>
  1763	      have hne := condbr_ne hwf hbj htm
  1764	      have hterm := block_term hlb
  1765	      rw [htm] at hterm
  1766	      simp only [term, bind, Except.bind] at hterm
  1767	      cases hid : idOf p c with
  1768	      | error e => simp [hid] at hterm
  1769	      | ok nc =>
  1770	      simp only [hid, pure, Except.pure, Except.ok.injEq] at hterm
  1771	      cases hl : lookup benv₁ c with
  1772	      | none => simp only [hl]
  1773	      | some v =>
  1774	      rcases v with ⟨ty, x⟩ | bb
  1775	      · simp only [hl]
  1776	      have hread : Source.read env₁ .word (.local nc) = .ok (enc (.bool bb)) :=
  1777	        read_operand (a := .reg c) hag₁ (by simp [operand, hid, bind, Except.bind, pure, Except.pure])
  1778	          (by simpa [evalOp] using hl)
  1779	      cases bb with
  1780	      | true =>
  1781	        simp only [hl]
  1782	        cases hen : enter p t ta benv₁ with
  1783	        | none => simp only
  1784	        | some benv₂ =>
  1785	        simp only
  1786	        have hedge : edgesTo t j bj.term = [(j, ta)] := by
  1787	          simp [htm, edgesTo, Ne.symm hne]
  1788	        obtain ⟨env₂, htr, hsz₂, hag₂, hr₂⟩ := edge_sim hok hf hbj hedge hen hsz₁ hag₁ hr₁
  1789	        exact cont t benv₂ env₂ (pre (step_branch hfb (block_size hlb).symm hterm.symm hread
  1790	          (by simpa [enc, word, Source.Value.toNat] using htr))) hsz₂ hag₂ hr₂
  1791	      | false =>
  1792	        simp only [hl]
  1793	        cases hen : enter p e ea benv₁ with
  1794	        | none => simp only
  1795	        | some benv₂ =>
  1796	        simp only
  1797	        have hedge : edgesTo e j bj.term = [(j, ea)] := by
  1798	          simp [htm, edgesTo, hne]
  1799	        obtain ⟨env₂, htr, hsz₂, hag₂, hr₂⟩ := edge_sim hok hf hbj hedge hen hsz₁ hag₁ hr₁
  1800	        exact cont e benv₂ env₂ (pre (step_branch hfb (block_size hlb).symm hterm.symm hread
  1801	          (by simpa [enc, word, Source.Value.toNat] using htr))) hsz₂ hag₂ hr₂
