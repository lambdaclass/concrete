  1803	theorem steps_prefix {f : Source.Function} :
  1804	    ∀ {k : Nat} {s u : Source.State}, Source.Steps f k s u → ∀ n, n ≤ k → ∃ t, Source.Steps f n s t
  1805	  | _, s, _, _, 0, _ => ⟨s, .zero _⟩
  1806	  | _, _, _, .succ h₁ h₂, n + 1, hn => by
  1807	    obtain ⟨t, ht⟩ := steps_prefix h₂ n (by omega)
  1808	    exact ⟨t, .succ h₁ ht⟩
  1809	  | _, _, _, .zero _, _ + 1, hn => by omega
  1810	
  1811	theorem entry_params {p : Program} (hwf : WF p) {b : Block} (hb : p.blocks[0]? = some b) :
  1812	    b.params = [] := by
  1813	  unfold WF wf at hwf
  1814	  simp only [Bool.and_eq_true, hb, List.isEmpty_iff] at hwf
  1815	  exact hwf.1.1.1.1.1
  1816	
  1817	/-- LCB's initial state for the adapted body: the entry block, an empty environment. -/
  1818	theorem initial_ok {p : Program} (hwf : WF p) {f : Source.Function} (hf : adapt p = .ok f)
  1819	    {b : Block} (hb : p.blocks[0]? = some b) :
  1820	    Source.initial f #[] = .ok ⟨0, 0, Array.replicate (valueCount p) none⟩ := by
  1821	  obtain ⟨lb, hfb, hlb⟩ := adapt_block hf hb
  1822	  obtain ⟨phis, xss, tm, hphis, -, -, rfl⟩ := adaptBlock_ok hlb
  1823	  rw [entry_params hwf hb] at hphis
  1824	  simp only [indexed, Runtime.indexedFrom, List.mapM_nil, pure, Except.pure, Except.ok.injEq] at hphis
  1825	  subst hphis
  1826	  have hf' := adapt_ok hf
  1827	  obtain ⟨-, bs, -, rfl⟩ := hf'
  1828	  simp [Source.initial, hfb, bind, Except.bind, pure, Except.pure]
  1829	
  1830	/-- **`adapter_correct`, over runs.** For a well-formed BIR program that the adapter accepts, under
  1831	LCB's own semantics (`Source.HasBehavior`, imported and never restated): a BIR run that exits with
  1832	`c` makes the adapted body return the word `c`; one that traps at site `s` makes it return the
  1833	word `256 + s`; and a program that runs out of fuel at every fuel makes it diverge. -/
  1834	theorem adapter_correct_run {p : Program} (hwf : WF p) {f : Source.Function}
  1835	    (hf : adapt p = .ok f) :
  1836	    (∀ fuel c, run p fuel = .exited c → Source.HasBehavior f #[] (.returned (word c))) ∧
  1837	    (∀ fuel st, run p fuel = .trapped st →
  1838	      Source.HasBehavior f #[] (.returned (word (256 + st)))) ∧
  1839	    ((∀ fuel, run p fuel = .outOfFuel) → Source.HasBehavior f #[] .diverges) := by
  1840	  have hok := (adapt_ok hf).1
  1841	  have sim := fun fuel => runBlock_sim hwf hok hf fuel 0 [] (Array.replicate (valueCount p) none)
  1842	    (by simp) (fun r v h => by simp [lookup] at h) (fun r t x h => by simp [lookup] at h)
  1843	  refine ⟨fun fuel c h => ?_, fun fuel st h => ?_, fun h => ?_⟩
  1844	  · unfold run at h
  1845	    cases hb : p.blocks[0]? with
  1846	    | none => simp [hb] at h
  1847	    | some b =>
  1848	      simp only [hb] at h
  1849	      have := sim fuel
  1850	      rw [h] at this
  1851	      exact ⟨_, initial_ok hwf hf hb, this⟩
  1852	  · unfold run at h
  1853	    cases hb : p.blocks[0]? with
  1854	    | none => simp [hb] at h
  1855	    | some b =>
  1856	      simp only [hb] at h
  1857	      have := sim fuel
  1858	      rw [h] at this
  1859	      exact ⟨_, initial_ok hwf hf hb, this⟩
  1860	  · have h0 := h 0
  1861	    unfold run at h0
  1862	    cases hb : p.blocks[0]? with
  1863	    | none => simp [hb] at h0
  1864	    | some b =>
  1865	      refine ⟨_, initial_ok hwf hf hb, fun n => ?_⟩
  1866	      have hn := h n
  1867	      unfold run at hn
  1868	      simp only [hb] at hn
  1869	      have := sim n
  1870	      rw [hn] at this
  1871	      obtain ⟨k, s, hk, hs⟩ := this
  1872	      exact steps_prefix hs n hk
