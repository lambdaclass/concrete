  1017	theorem getElem?_flatten_at {α : Type} : ∀ (xss : List (List α)) (i k : Nat) (xs : List α),
  1018	    xss[i]? = some xs → k < xs.length →
  1019	      xss.flatten[((xss.take i).map List.length).sum + k]? = xs[k]?
  1020	  | [], _, _, _, h, _ => by simp at h
  1021	  | ys :: xss, 0, k, xs, h, hk => by
  1022	    simp only [List.getElem?_cons_zero, Option.some.injEq] at h
  1023	    subst h
  1024	    simp [List.getElem?_append_left hk]
  1025	  | ys :: xss, i + 1, k, xs, h, hk => by
  1026	    simp only [List.getElem?_cons_succ] at h
  1027	    rw [List.flatten_cons, List.take_succ_cons, List.map_cons, List.sum_cons,
  1028	      List.getElem?_append_right (by omega)]
  1029	    rw [show ys.length + ((xss.take i).map List.length).sum + k - ys.length =
  1030	      ((xss.take i).map List.length).sum + k by omega]
  1031	    exact getElem?_flatten_at xss i k xs h hk
