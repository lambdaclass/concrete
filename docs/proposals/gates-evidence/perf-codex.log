  1044	/-- What a successful `adapt` is. -/
  1045	theorem adapt_ok {p : Program} {f : Source.Function} (h : adapt p = .ok f) :
  1046	    numberingOk p = true ∧ ∃ bs, (indexed p.blocks).mapM (adaptBlock p) = .ok bs ∧
  1047	      f = { resultWidth := .word, parameters := #[],
  1048	            valueWidths := Array.replicate (valueCount p) .word, blocks := bs.toArray } := by
  1049	  unfold adapt at h
  1050	  cases hn : numberingOk p <;> cases hb : (indexed p.blocks).mapM (adaptBlock p) <;>
  1051	    simp_all [bind, Except.bind, pure, Except.pure]
