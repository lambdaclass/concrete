  1237	  | a :: l, init, h => by
  1238	    rw [List.forIn_cons]
  1239	    have h0 := h 0 (by simp)
  1240	    simp only [List.getElem_cons_zero, List.take_zero, List.foldl_nil] at h0
  1241	    simp only [h0, bind, Except.bind, List.foldl_cons]
  1242	    exact forIn_yields F g l (g a init) fun i hi => by
  1243	      have := h (i + 1) (by simp; omega)
  1244	      simpa only [List.getElem_cons_succ, List.take_succ_cons, List.foldl_cons] using this
