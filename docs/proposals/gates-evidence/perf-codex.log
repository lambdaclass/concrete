  1951	theorem adapter_correct_behaviour {p : Program} (hwf : WF p) {f : Source.Function}
  1952	    (hf : adapt p = .ok f) :
  1953	    (∃ w, Source.HasBehavior f #[] (.returned (.word w)) ∧ behaviour p = decode p.sites w) ∨
  1954	    (Source.HasBehavior f #[] .diverges ∧ behaviour p = .diverges) := by
  1955	  obtain ⟨hexit, htrap, hdiv⟩ := adapter_correct_run hwf hf
  1956	  by_cases hex : ∃ n, (run p n).final = true
  1957	  · obtain ⟨n, hn⟩ := hex
  1958	    have hb := behaviour_of_run hn
