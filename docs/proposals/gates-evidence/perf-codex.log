  1092	    ∃ lb, f.blocks[j]? = some lb ∧ adaptBlock p (j, b) = .ok lb := by
  1093	  obtain ⟨-, bs, hbs, rfl⟩ := adapt_ok h
  1094	  obtain ⟨lb, hlb, hi⟩ := mapM_ok_ok hbs (i := j) (x := (j, b)) (by simp [Runtime.getElem?_indexed, hbj])
  1095	  exact ⟨lb, by simpa using hi, hlb⟩
