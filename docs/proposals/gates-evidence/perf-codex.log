  1326	theorem edgesTo_fst {j k : Nat} {term : Term} : ∀ x ∈ edgesTo j k term, x.1 = k := by
  1327	  intro x hx
  1328	  cases term <;> simp only [edgesTo] at hx <;> (try split at hx) <;> (try split at hx) <;>
  1329	    simp at hx <;> (try rcases hx with rfl | rfl) <;> (try subst hx) <;> rfl
