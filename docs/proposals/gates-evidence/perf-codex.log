     1	import Concrete.BIR
     2	
     3	/-!
     4	# The runtime entry (both backends)
     5	
     6	PROVISIONAL (slice 0). Every backend emits `main`'s body as `concrete_body`, returning the result
     7	word (`Concrete.BIR.encode`). The runtime entry is fixed: it calls the body and then
     8	
     9	* exits with the word if it is below 256;
    10	* otherwise writes the trap line of site `word - 256` to descriptor 2 (looping on partial writes,
    11	  ignoring write errors) and exits 134 (`ConcreteSpec.Observe.Observation.status`);
    12	* on a word that encodes nothing (no well-formed body returns one, `emit_encodes`), writes
    13	  `invalidLine` and aborts.
    14	
    15	Its correctness is premise `P_rt`, and the site it reports is premise `P_trap_site`
    16	(`Concrete/README.md`). This file emits it as LLVM text and as QBE text for LCB.
    17	
    18	The trap line is the owner's decided form (2026-11-06):
    19	`concrete: trap: <kind> at <path>:<line>:<col> (site <id>)`, the path relative to the project
    20	root with forward slashes, line and column 1-based. That the executable writes exactly this line
    21	for the site it trapped at is premise `P_trap_site`.
    22	-/
    23	
    24	namespace Concrete.Backend.Runtime
    25	open Concrete.BIR
    26	open ConcreteSpec (IntTy Trap)
    27	
    28	/-- The trap's name in the trap line. -/
    29	def trapName : Trap → String
    30	  | .arithmeticOverflow => "overflow"
    31	
    32	/-- The trap line for one site, without the final newline. -/
    33	def trapLine (e : SiteEntry) : String :=
    34	  s!"concrete: trap: {trapName e.kind} at {e.loc.path}:{e.loc.line}:{e.loc.col} (site {e.site.id})"
    35	
    36	/-- What the runtime writes before aborting on a result word that encodes nothing. -/
    37	def invalidLine : String := "concrete: runtime: invalid result word"
    38	
    39	/-- The decided form, checked against a literal (not against `trapLine` itself). -/
    40	example : trapLine ⟨.arithmeticOverflow, ⟨9⟩, ⟨40, 47⟩, ⟨"src/main.con", 4, 12⟩⟩ =
    41	    "concrete: trap: overflow at src/main.con:4:12 (site 9)" := by decide +kernel
    42	
    43	/-- Pair every element with its index. -/
    44	def indexedFrom {α : Type} (n : Nat) : List α → List (Nat × α)
    45	  | [] => []
    46	  | a :: l => (n, a) :: indexedFrom (n + 1) l
    47	
    48	def indexed {α : Type} (l : List α) : List (Nat × α) := indexedFrom 0 l
    49	
    50	theorem getElem?_indexedFrom {α : Type} (l : List α) (n k : Nat) :
    51	    (indexedFrom n l)[k]? = l[k]?.map (n + k, ·) := by
    52	  induction l generalizing n k with
    53	  | nil => simp [indexedFrom]
    54	  | cons a l ih =>
    55	    cases k with
    56	    | zero => simp [indexedFrom]
    57	    | succ k =>
    58	      simp only [indexedFrom, List.getElem?_cons_succ, ih]
    59	      congr 1; funext x; congr 1; omega
    60	
    61	theorem getElem?_indexed {α : Type} (l : List α) (k : Nat) :
    62	    (indexed l)[k]? = l[k]?.map (k, ·) := by
    63	  simpa [indexed] using getElem?_indexedFrom l 0 k
    64	
    65	theorem mem_indexedFrom {α : Type} {l : List α} {n k : Nat} {x : α} (h : l[k]? = some x) :
    66	    (n + k, x) ∈ indexedFrom n l := by
    67	  induction l generalizing n k with
    68	  | nil => simp at h
    69	  | cons a l ih =>
    70	    cases k with
    71	    | zero => simp at h; subst h; simp [indexedFrom]
    72	    | succ k =>
    73	      simp only [List.getElem?_cons_succ] at h
    74	      have := ih (n := n + 1) h
    75	      simp only [indexedFrom, List.mem_cons]
    76	      exact Or.inr (by rwa [show n + (k + 1) = n + 1 + k by omega])
    77	
    78	theorem mem_indexed {α : Type} {l : List α} {k : Nat} {x : α} (h : l[k]? = some x) :
    79	    (k, x) ∈ indexed l := by
    80	  simpa [indexed] using mem_indexedFrom (n := 0) h
