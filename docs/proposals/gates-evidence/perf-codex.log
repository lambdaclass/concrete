  2050	/-! ## The QBE debug dump (not on the build path) -/
  2051	
  2052	def renderWidth : Width → String
  2053	  | .word => "w"
  2054	  | .long => "l"
  2055	
  2056	def renderOperand : Source.Operand → String
  2057	  | .local id => s!"%v{id}"
