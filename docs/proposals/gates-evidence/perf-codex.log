  1874	/-! ### LCB's behaviour is unique -/
  1875	
  1876	/-- Determinism: the state `n` steps reach is the prefix of any longer run. -/
  1877	theorem steps_split {f : Source.Function} :
  1878	    ∀ {n m : Nat} {s t u : Source.State}, Source.Steps f n s t → Source.Steps f (n + m) s u →
  1879	      Source.Steps f m t u
  1880	  | 0, _, _, _, _, .zero _, h => by simpa using h
  1881	  | n + 1, m, _, _, _, .succ h₁ h₂, h => by
  1882	    rw [show n + 1 + m = (n + m) + 1 by omega] at h
  1883	    cases h with
  1884	    | succ h₁' h₂' =>
  1885	      cases Source.step_deterministic f _ _ _ h₁ h₁'
  1886	      exact steps_split h₂ h₂'
  1887	
  1888	theorem returned_not_step {f : Source.Function} {t u : Source.State} {v : Source.Value}
  1889	    (hr : Source.step f t = .ok (.returned v)) (hs : Source.Step f t u) : False := by
  1890	  unfold Source.Step at hs
  1891	  rw [hr] at hs
  1892	  cases hs
  1893	
  1894	theorem returns_le {f : Source.Function} {s t₁ t₂ : Source.State} {v₁ v₂ : Source.Value}
  1895	    {n k : Nat} (h₁ : Source.Steps f n s t₁) (r₁ : Source.step f t₁ = .ok (.returned v₁))
  1896	    (h₂ : Source.Steps f (n + k) s t₂) (r₂ : Source.step f t₂ = .ok (.returned v₂)) :
  1897	    v₁ = v₂ := by
  1898	  have h := steps_split h₁ h₂
  1899	  cases k with
  1900	  | zero =>
  1901	    cases h
  1902	    rw [r₁] at r₂
  1903	    cases r₂
  1904	    rfl
  1905	  | succ k =>
  1906	    cases h with
  1907	    | succ hs _ => exact (returned_not_step r₁ hs).elim
  1908	
  1909	theorem returns_unique {f : Source.Function} {s : Source.State} {v₁ v₂ : Source.Value}
  1910	    (h₁ : Source.Returns f s v₁) (h₂ : Source.Returns f s v₂) : v₁ = v₂ := by
  1911	  obtain ⟨n₁, t₁, s₁, r₁⟩ := h₁
  1912	  obtain ⟨n₂, t₂, s₂, r₂⟩ := h₂
  1913	  rcases Nat.le_total n₁ n₂ with h | h
  1914	  · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le h
  1915	    exact returns_le s₁ r₁ s₂ r₂
  1916	  · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le h
  1917	    exact (returns_le s₂ r₂ s₁ r₁).symm
  1918	
  1919	theorem returns_not_diverges {f : Source.Function} {s : Source.State} {v : Source.Value}
  1920	    (hr : Source.Returns f s v) (hd : Source.Diverges f s) : False := by
  1921	  obtain ⟨n, t, hs, ht⟩ := hr
  1922	  obtain ⟨u, hu⟩ := hd (n + 1)
  1923	  cases steps_split hs hu with
  1924	  | succ h _ => exact returned_not_step ht h
  1925	
  1926	/-- LCB's behaviour of a function on given arguments is unique. -/
  1927	theorem hasBehavior_unique {f : Source.Function} {args : Array Source.Value}
  1928	    {b₁ b₂ : Source.Behavior} (h₁ : Source.HasBehavior f args b₁)
  1929	    (h₂ : Source.HasBehavior f args b₂) : b₁ = b₂ := by
  1930	  obtain ⟨s₁, i₁, h₁⟩ := h₁
  1931	  obtain ⟨s₂, i₂, h₂⟩ := h₂
  1932	  rw [i₁] at i₂
  1933	  cases i₂
  1934	  cases b₁ with
  1935	  | returned v₁ =>
  1936	    cases b₂ with
  1937	    | returned v₂ => rw [returns_unique h₁ h₂]
  1938	    | diverges => exact (returns_not_diverges h₁ h₂).elim
  1939	  | diverges =>
