  1331	/-- Picking one index out of an indexed flatMap. -/
  1332	theorem flatMap_indexedFrom_pick {α β : Type} (F : Nat → α → List β) (j : Nat) :
  1333	    ∀ (n : Nat) (l : List α), (Runtime.indexedFrom n l).flatMap
  1334	      (fun (kx : Nat × α) => if kx.1 = j then F kx.1 kx.2 else []) =
  1335	      if n ≤ j then (match l[j - n]? with | some x => F j x | none => []) else []
  1336	  | n, [] => by simp [Runtime.indexedFrom]
  1337	  | n, x :: l => by
  1338	    simp only [Runtime.indexedFrom, List.flatMap_cons]
  1339	    rw [flatMap_indexedFrom_pick F j (n + 1) l]
  1340	    rcases Nat.lt_trichotomy n j with h | h | h
  1341	    · have h1 : j - n = (j - (n + 1)) + 1 := by omega
  1342	      have h2 : n ≠ j := by omega
  1343	      simp only [h2, ↓reduceIte, List.nil_append, h1, List.getElem?_cons_succ,
  1344	        show n + 1 ≤ j by omega, show n ≤ j by omega]
  1345	    · subst h
  1346	      simp only [↓reduceIte, Nat.sub_self, List.getElem?_cons_zero, Nat.le_refl,
  1347	        show ¬ n + 1 ≤ n by omega, List.append_nil]
  1348	    · have h2 : n ≠ j := by omega
  1349	      simp only [h2, ↓reduceIte, List.nil_append, show ¬ n + 1 ≤ j by omega,
  1350	        show ¬ n ≤ j by omega]
