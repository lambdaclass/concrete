  1126	    (hW : ∀ m, m < valueCount p → f.valueWidths[m]? = some .word)
  1127	    {j : Nat} {b : Block} {lb : Source.Block} (hbj : p.blocks[j]? = some b)
  1128	    (hlb : adaptBlock p (j, b) = .ok lb) (hfb : f.blocks[j]? = some lb) :
  1129	    ∀ (l : List Inst) (i : Nat) (benv benv' : Env) (env : Source.Environment),
  1130	      b.insts.drop i = l → execInsts benv l = some benv' → env.size = valueCount p →
  1131	      Agrees p benv env → InRange benv →
  1132	      ∃ env', Source.Steps f (l.map Inst.width).sum ⟨j, instPos b i, env⟩
  1133	          ⟨j, instPos b i + (l.map Inst.width).sum, env'⟩ ∧
  1134	        env'.size = valueCount p ∧ Agrees p benv' env' ∧ InRange benv'
  1135	  | [], _, benv, benv', env, _, he, hsz, hag, hr => by
  1136	    simp only [execInsts, Option.some.injEq] at he
  1137	    subst he
  1138	    exact ⟨env, .zero _, hsz, hag, hr⟩
  1139	  | ins :: rest, i, benv, benv', env, hd, he, hsz, hag, hr => by
  1140	    have hi : b.insts[i]? = some ins := by
  1141	      have := congrArg (·[0]?) hd
  1142	      simpa [List.getElem?_drop] using this
  1143	    have hd' : b.insts.drop (i + 1) = rest := by
  1144	      rw [← List.tail_drop, hd]; rfl
  1145	    simp only [execInsts] at he
  1146	    split at he
  1147	    · rename_i benv₁ he₁
  1148	      obtain ⟨xs, hxs, hq⟩ := block_insts hlb hi
  1149	      obtain ⟨env₁, hst, hsz₁, hag₁, hr₁⟩ := inst_sim (s := ⟨j, instPos b i, env⟩) hok hbj hi hxs hfb
  1150	        hq (fun m hm => hW m (hsz ▸ hm)) hsz hag hr he₁
  1151	      obtain ⟨env', hst', hsz', hag', hr'⟩ := body_sim hok hW hbj hlb hfb rest (i + 1) benv₁ benv'
