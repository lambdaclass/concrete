   961	theorem trunc_sim {p : Program} (hok : numberingOk p = true) {f : Source.Function}
   962	    {j i : Nat} {b : Block} {fr to : IntTy} {d : Reg} {a : Operand}
   963	    {xs : List Source.Instruction} {s : Source.State} {lb : Source.Block} {benv benv' : Env}
   964	    (hbj : p.blocks[j]? = some b) (hi : b.insts[i]? = some (.trunc fr to d a))
   965	    (hx : inst p (blockBase p j + instBase b i) (.trunc fr to d a) = .ok xs)
   966	    (hb : f.blocks[s.block]? = some lb)
   967	    (hq : ∀ k, k < 3 → lb.instructions[s.position + k]? = xs[k]?)
   968	    (hW : ∀ m, m < s.environment.size → f.valueWidths[m]? = some .word)
   969	    (hsz : s.environment.size = valueCount p)
   970	    (hag : Agrees p benv s.environment) (hr : InRange benv)
   971	    (he : execInst benv (.trunc fr to d a) = some benv') :
   972	    ∃ env', Source.Steps f 3 s ⟨s.block, s.position + 3, env'⟩ ∧ env'.size = valueCount p ∧
   973	      Agrees p benv' env' ∧ InRange benv' := by
