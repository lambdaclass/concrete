  1376	/-- A first-component-preserving `mapM` commutes with filtering on the first component. -/
  1377	theorem mapM_filter_fst {α β γ ε : Type} [BEq α] {G : α × β → Except ε (α × γ)}
  1378	    (hG : ∀ x y, G x = .ok y → y.1 = x.1) (j : α) :
  1379	    ∀ {l : List (α × β)} {l' : List (α × γ)}, l.mapM G = .ok l' →
  1380	      (l.filter (·.1 == j)).mapM G = .ok (l'.filter (·.1 == j))
  1381	  | [], l', h => by simp only [List.mapM_nil, pure, Except.pure, Except.ok.injEq] at h; subst h; rfl
  1382	  | x :: l, l', h => by
  1383	    simp only [List.mapM_cons, bind, Except.bind] at h
  1384	    cases hx : G x with
  1385	    | error e => simp [hx] at h
  1386	    | ok y =>
  1387	      cases hl : l.mapM G with
  1388	      | error e => simp [hx, hl] at h
  1389	      | ok ys =>
  1390	        simp only [hx, hl, pure, Except.pure, Except.ok.injEq] at h
  1391	        subst h
  1392	        have ih := mapM_filter_fst hG j hl
  1393	        have hy := hG x y hx
  1394	        simp only [List.filter_cons, hy]
  1395	        split
  1396	        · simp [List.mapM_cons, hx, ih, bind, Except.bind, pure, Except.pure]
  1397	        · exact ih
