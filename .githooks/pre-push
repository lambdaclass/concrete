#!/usr/bin/env bash
# Pre-push gate.
#
# `make test-full` is NOT sufficient and never was — it does not execute the
# check_*.sh gate scripts at all. This repository has shipped a red `main` four
# times on that substitution (2026-06, 2026-07, and twice on 2026-07-25).
#
# SCOPE. This hook deliberately does NOT run the full CI gate set. Measured on
# an 18-core box with JOBS=12 and nothing else running, the full set takes 23+
# minutes; the runner's own header claims "a few". A 23-minute push is bypassed
# by the second day, and a bypassed hook protects nothing. So the hook runs:
#
#   1. the R-0022 fast surface-gate checklist — built precisely to be the fast
#      pre-push check, and identical to CI's Language-surface constituent, and
#   2. the gates this push can break, derived by scripts/tests/select_gates.sh (impact
#      selection, R-0513), with the older AREA map as the fallback.
#
# The full set stays available as `make pre-push-full` and runs in CI. This
# trades some coverage for a check that actually gets run — the alternative
# proved to be no check at all.
#
# Deliberate bypass:  CONCRETE_SKIP_GATES=1 git push
set -uo pipefail
HOOK_SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

if [ "${CONCRETE_SKIP_GATES:-0}" = "1" ]; then
  echo "pre-push: gates SKIPPED by CONCRETE_SKIP_GATES=1 — you own the CI result." >&2
  exit 0
fi

# git feeds the pre-push hook one line per ref being pushed:
#   <local ref> <local sha> <remote ref> <remote sha>
# That is the authoritative range — the whole push, not just the tip commit.
# Deriving it from @{upstream} or HEAD~1 (as this hook first did) inspects the
# wrong set: HEAD~1 sees only the last commit of a five-commit push, which is
# how the first version ran ZERO area gates on a push full of Concrete/Proof
# changes.
changed=""
pushed=""
# WORK-IN-PROGRESS TIER. A push whose every target is refs/heads/wip/* is a backup of an
# unfinished branch: it can never become main (main and ci/* candidates keep the full hook
# below). Agents push WIP every few minutes so a usage limit or crash cannot lose work, and a
# 15-minute gate run per backup would make that impossible. The WIP tier still refuses
# conflict markers in what it publishes. It is decided from stdin alone, before any fallback:
# a by-hand run (no stdin) or any ref outside wip/* — including a deletion — takes the full gates.
# DELETING a wip/* ref publishes nothing, so it is the same tier: a push of only wip/* updates and
# deletions takes the backup check. Before this, a deletion matched no tier, fell through to the
# by-hand fallback and ran the full gates on whatever was checked out (~20 minutes) — long enough
# that GitHub dropped the push connection and the ref was never deleted, though the hook passed
# (twice, 2026-10-25). Deleting main, ci/* or any other ref still takes the full gates.
#
# REVIEW-NOTES TIER (R-0544). scripts/review/review.sh pushes its verdict as a git note under
# refs/notes/concrete-review (and the findings under refs/notes/concrete-review-findings). A notes
# commit holds one blob per annotated commit and no source tree, so the gates have nothing to
# check in it — and running them per review round made every note push take minutes, and fail
# outside the dev shell. Only an UPDATE of exactly those two refs qualifies; deleting one, or
# pushing anything else alongside, takes the tier it would take without it.
#
# BUG-NUMBER RESERVATION TIER. scripts/gen/new_bug.sh reserves a bug number by creating
# refs/bug-reservations/NNN on the remote. That ref carries a parentless commit with the empty tree:
# it publishes no code, so there is nothing to gate. Exactly that shape is accepted on that namespace
# (and the deletion of a reservation); anything else pushed there is refused.
# Both no-code tiers (review notes, reservations) may be pushed together or alongside wip/*; a push
# that also targets any other ref takes the full gates.
wip_refs=0; wip_dels=0; other_refs=0; wip_shas=""; review_note_refs=0; res_refs=0; res_bad=""
EMPTY_TREE="$(git hash-object -t tree /dev/null)"
# Kept whole so the hook can hand the same lines to itself when it re-enters the gate shell (below).
HOOK_STDIN="$(cat)"
while read -r _localref localsha _remoteref remotesha; do
  [ -z "${localsha:-}" ] && continue
  case "${_remoteref:-}" in
    refs/heads/wip/*) case "$localsha" in
                        *[!0]*) wip_refs=$((wip_refs+1)); wip_shas="$wip_shas $localsha" ;;
                        *) wip_dels=$((wip_dels+1)) ;;
                      esac ;;
    refs/notes/concrete-review|refs/notes/concrete-review-findings)
      case "$localsha" in
        *[!0]*) review_note_refs=$((review_note_refs+1)); continue ;;
        *) other_refs=$((other_refs+1)) ;;
      esac ;;
    refs/bug-reservations/[0-9][0-9][0-9])
      res_refs=$((res_refs+1))
      case "$localsha" in
        *[!0]*) if [ "$(git cat-file -t "$localsha" 2>/dev/null)" != commit ] \
                   || [ "$(git rev-parse -q --verify "$localsha^{tree}" 2>/dev/null)" != "$EMPTY_TREE" ] \
                   || git rev-parse -q --verify "$localsha^1" >/dev/null 2>&1; then res_bad="$res_bad $_remoteref"; fi ;;
      esac
      continue ;;
    refs/bug-reservations/*) other_refs=$((other_refs+1)); res_bad="$res_bad ${_remoteref}" ;;
    *) other_refs=$((other_refs+1)) ;;
  esac
  case "$localsha" in *[!0]*) ;; *) continue ;; esac   # all-zero = branch deletion
  pushed="$pushed $localsha"
  case "${remotesha:-}" in
    ""|*[!0-9a-f]*) range="$localsha" ;;
    *[!0]*) range="$remotesha..$localsha" ;;           # normal update
    *)      range="$localsha" ;;                        # new branch: no base
  esac
  if [ "$range" = "$localsha" ]; then
    changed="$changed"$'\n'"$(git diff --name-only "$(git rev-list --max-parents=0 "$localsha" | tail -1)".."$localsha" 2>/dev/null || true)"
  else
    changed="$changed"$'\n'"$(git diff --name-only $range 2>/dev/null || true)"
  fi
done <<< "$HOOK_STDIN"
[ -z "$res_bad" ] || { echo "pre-push (reservation tier): only a parentless empty-tree commit may be pushed to refs/bug-reservations/NNN:$res_bad — refusing"; exit 1; }
if [ "$res_refs" -gt 0 ] && [ "$wip_refs" -eq 0 ] && [ "$wip_dels" -eq 0 ] && [ "$other_refs" -eq 0 ]; then
  echo "pre-push: bug-number reservation — no code published, no gates"
  exit 0
fi
if [ $((wip_refs + wip_dels)) -gt 0 ] && [ "$other_refs" -eq 0 ]; then
  bad=""
  for sha in $wip_shas; do
    rc=0; git grep -qE '^(<{7}|>{7}|\|{7})( |$)|^={7}$' "$sha" -- . >/dev/null 2>&1 || rc=$?
    case "$rc" in
      0) bad="$bad $sha" ;;
      1) ;;
      *) echo "pre-push (wip tier): could not scan $sha (git grep exit $rc) — refusing"; exit 1 ;;
    esac
  done
  [ -z "$bad" ] || { echo "pre-push (wip tier): conflict markers in$bad — refusing"; exit 1; }
  echo "pre-push: wip/* backup push ($wip_refs update(s), $wip_dels deletion(s)) — conflict-marker check only; full gates run on ci/* and main"
  exit 0
fi
if [ "$review_note_refs" -gt 0 ] && [ "$wip_refs" -eq 0 ] && [ "$wip_dels" -eq 0 ] && [ "$other_refs" -eq 0 ]; then
  echo "pre-push: review-notes push (refs/notes/concrete-review*) — no source tree, no gates"
  exit 0
fi
# Fallback when stdin gave nothing (hook invoked by hand, or `make pre-push`).
if [ -z "$(printf '%s' "$changed" | tr -d '[:space:]')" ]; then
  # Everything this branch would publish: from its upstream, else from where it left
  # origin/main. `HEAD~1` checked only the tip commit, so a by-hand run on a multi-commit
  # branch with no upstream skipped the gates for every earlier commit.
  up="$(git rev-parse "@{upstream}" 2>/dev/null || echo "")"
  [ -n "$up" ] || up="$(git merge-base HEAD origin/main 2>/dev/null || echo "")"
  [ -n "$up" ] && changed="$(git diff --name-only "$up"..HEAD)" \
               || changed="$(git diff --name-only HEAD~1..HEAD 2>/dev/null || echo "")"
  pushed="$(git rev-parse HEAD 2>/dev/null || echo "")"   # by hand: the candidate is the checkout
fi
changed="$(printf '%s\n' "$changed" | sed '/^$/d' | sort -u)"
[ -z "$changed" ] && { echo "pre-push: nothing to check"; exit 0; }

# THE GATES RUN IN THE GATE SHELL: scripts/tests/lib/gate_env.sh makes every gate refuse anywhere else.
# git runs this hook in whatever shell `git push` was typed in, so from outside the flake's shells the
# hook re-executes itself inside `nix develop` (the dev shell, as `make` uses), with the same
# arguments and the same ref lines on stdin. Everything above is plain git and simply runs again
# there; the no-gate tiers have already exited, so they never pay for the shell.
if [ "${CONCRETE_GATES_SHELL:-}" != 1 ]; then
  if [ "${CONCRETE_PREPUSH_REENTERED:-0}" = 1 ]; then
    echo "pre-push: nix develop did not provide the gate shell (CONCRETE_GATES_SHELL unset) — refusing to push." >&2; exit 1
  fi
  command -v nix >/dev/null 2>&1 || {
    echo "pre-push: the gates run inside nix develop .#gates (CI) or nix develop, and nix is not on PATH — refusing to push." >&2; exit 1; }
  echo "pre-push: entering nix develop for the gates"
  CONCRETE_PREPUSH_REENTERED=1 exec nix develop "$ROOT_DIR" --command bash "$HOOK_SELF" "$@" <<< "$HOOK_STDIN"
fi
echo "pre-push: $(printf '%s\n' "$changed" | wc -l | tr -d ' ') changed file(s) in this push"

docs_only=1
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in docs/*|*.md) ;; *) docs_only=0; break ;; esac
done <<< "$changed"


# ONE SELECTION, EACH GATE ONCE. Everything below only DECLARES what to run, as selectors for
# run_ci_gates_local.sh; the runner resolves their union into one deduplicated list and executes each
# command exactly once. The hook used to call the runner once per CI job and once per area, and those
# selections overlap — a Concrete/Proof change ran 79 gate invocations for 67 distinct gates
# (scripts/ci/proof_gate.sh twice, the proof/contract/callable name matches inside the evidence job
# twice). `--first` keeps the old order where it mattered: those run sequentially before the rest,
# and a failure there stops the run before the heavy gates launch.
SEL=()
# The area map below is the FALLBACK selection (AREA_SEL). The default is impact selection; see
# "IMPACT SELECTION" after this block.
AREA_SEL=()
# Gate hygiene on EVERY push, whatever changed. It holds the committed-conflict-marker check, and
# the area map below selects it only for scripts/Concrete/build changes: 64cfea38 was a merge that
# changed only Markdown, left a diff3 marker in CHANGELOG.md, passed this hook, and turned main red
# on the lint job. The gate takes seconds; a red main costs a CI round-trip and blocks everyone.
SEL+=(--first "bash scripts/tests/check_gate_hygiene.sh")
if [ "$docs_only" = "1" ]; then
  echo "pre-push: docs-only change — docs gates"
  SEL+=(--first "bash scripts/tests/check_docs_drift.sh"
        --first "bash scripts/tests/check_roadmap_linear.sh")
else
  # The R-0022 fast surface checklist, first.
  SEL+=(--first "bash scripts/tests/run_fast_surface_gates.sh")

  # BUG FILING is three artifacts — document, corpus entry, coverage — and the audit
  # that enforces that is CI-only (the trust gate). Bug 066 shipped with the document and
  # the gate but no map entry, pre-push passed, and main went red. This check runs in
  # under a second, so it belongs on the first local push rather than a CI round-trip.
  # Reads $changed, the union over every pushed ref. It used `git diff "$range"`, but $range
  # held only the LAST ref's range and is unset when the hook runs by hand, where `set -u`
  # failed the substitution and silently skipped this check. A here-string, not a pipe: no
  # producer for an early-exiting grep -q to SIGPIPE (bug 283).
  if grep -qE '^docs/bugs/|^scripts/tests/audit_bug_corpus\.sh$|^tests/programs/.*bug|^scripts/tests/check_.*\.sh$' <<<"$changed"; then
    echo "pre-push: bug-filing completeness selected (docs/bugs, corpus map, coverage)"
    SEL+=(--first "bash scripts/tests/check_bug_filing_complete.sh")
  fi
  if grep -qE '^scripts/gen/(new_bug\.sh|bug_ledger\.py|bug_dashboard\.py|changelog\.py)$|^scripts/tests/check_(new_bug|bug_filing_complete)\.sh$|^\.githooks/pre-push$' <<<"$changed"; then
    echo "pre-push: bug scaffold selected (new_bug.sh, the ledger and dashboard generators, the reservation tier)"
    SEL+=(--first "bash scripts/tests/check_new_bug.sh")
  fi

  # Area filters: map touched paths to the gate-name substrings the runner
  # accepts. Deliberately generous — a superfluous gate costs seconds, a missed
  # one costs a red main and a CI round-trip.
  areas=""
  add() { case " $areas " in *" $1 "*) ;; *) areas="$areas $1" ;; esac; }
  # Whole CI JOBS to run, for areas where a name-substring filter is not
  # trustworthy. `proof` selects 6 gates by name; the "Proof evidence gate" job
  # runs 40, and the one that broke on R-0442
  # (check_operational_vc_auto_discharge.sh, which typechecks Lean fixtures
  # against the Proof API) has no "proof" in its name. The workflow already
  # declares which gates belong to which job — deriving the set from the job is
  # one source instead of a naming convention.
  jobs_to_run=""
  addjob() { case "$jobs_to_run" in *"|$1|"*) ;; *) jobs_to_run="$jobs_to_run|$1|" ;; esac; }
  while IFS= read -r f; do
    case "$f" in
      # A Proof/Report/proofs change runs BOTH: the name-matched areas AND the
      # whole evidence job. Neither alone is sufficient, which is easy to get
      # wrong — proof gates are split across two CI jobs. The name filters catch
      # proof-named gates wherever they live (check_purecore_proofs.sh and
      # check_proofcore_callable_identity.sh are in "Language-surface gates", not
      # the evidence job); the job catches the evidence job's oddly-named ones
      # (check_operational_vc_auto_discharge.sh, which broke on R-0442 and has no
      # "proof" in its name). Dropping the name filters for the job alone would
      # have traded one gap for another.
      # Main.lean drives EVERY `--report` surface, so a change there can move any
      # report's output. Mapping it to `hygiene` alone (via the Concrete/* catch-all
      # below) is how the workspace-resolution regression reached CI: the fix lived
      # in Main.lean, the hook ran one gate, and twelve std proofs broke.
      Main.lean|Concrete/Proof/*|Concrete/Report/*|proofs/*)
        add proof; add evidence; add contract; add callable
        addjob "Proof evidence gate"
        # ...and the release bundle, which CONSUMES report output: it counts the
        # `✓` lines in proof-status, so a verdict change moves its manifest. Only
        # 8 gates, and it is the job that caught R-0004 slice 3 after two rounds of
        # name-filter patching. Route to the job rather than guess another name.
        addjob "Extra gates"
        # ...and the external re-check, whose population is every theorem-declaring module:
        # a new proofs/ library reached CI unchecked (DesignExamples, 03d2edec) because no
        # local route led to it.
        addjob "External proof re-check (con-leche)" ;;
      Concrete/IR/*|Concrete/Backend/*)             add mono; add codegen; add ssa; add trap; add fnptr ;;
      # Semantics and the interpreter are where trap/overflow facts live, and the
      # interpreter is half of every differential. Without this line they matched
      # only the catch-all `Concrete/*` -> hygiene, which is how a change to the
      # trap inventory could reach CI having run no gate that evaluates one.
      # `positions` rather than `differential`: the latter also selects the
      # workload differentials (httpget, wordfreq, tar_list), which are minutes.
      Concrete/Semantics/*|Concrete/Interp/*)       add trap; add totality; add builtin; add positions ;;
      Concrete/Check/*|Concrete/Elab/*)             add linear; add collections; add cli ;;
      Concrete/Resolve/*)                           add linear; add callable; add mono ;;
      std/*)                                        add collections; add stdlib; add proof ;;
      # Example sources feed the release bundle and the snapshot corpus.
      examples/*)                                   add evidence; add examples; addjob "Extra gates" ;;
      scripts/tests/*|.github/workflows/*)          add hygiene ;;
      # A lakefile change can add or drop a Lean library, which moves the external
      # checker's population.
      lakefile.toml)                                add hygiene; addjob "External proof re-check (con-leche)" ;;
      Makefile|.githooks/*|flake.nix)               add hygiene ;;
      Concrete/*)                                   add hygiene ;;
    esac
  done <<< "$changed"

  # while-read, not `for j in $(...)`: CI job names contain SPACES, so word
  # splitting would turn "Proof evidence gate" into three bogus job names and
  # every one of them would fail to match — a loop that appears to run and
  # checks nothing.
  while IFS= read -r j; do
    [ -z "$j" ] && continue
    AREA_SEL+=(--job "$j")
  done <<< "$(printf '%s' "$jobs_to_run" | sed 's/^|//; s/|$//; s/||/\n/g')"
  for a in $areas; do
    AREA_SEL+=(--filter "$a")
  done
fi

RUNNER="scripts/tests/run_ci_gates_local.sh"
TMPD="$(mktemp -d)" || { echo "pre-push: cannot create a temp directory" >&2; exit 1; }
trap 'rm -rf "$TMPD"' EXIT
PLAN_F="$TMPD/plan"; CHANGED_F="$TMPD/changed"
printf '%s\n' "$changed" > "$CHANGED_F"
# IMPACT SELECTION (R-0513). scripts/tests/select_gates.sh derives, from the gate scripts themselves,
# every workflow gate command these changed files can break: what each gate reads (transitively through
# the scripts it runs), every compiler- or Lean-running gate for a compiler, toolchain or stdlib change,
# and every gate for a change no rule maps. The area map above names gates by convention, and four
# failures it did not select reached CI on 2026-10-22 (stack budget, trust-gate audit corpus, float
# round-trip judge, linear discard). It is the fallback when the selector fails, or on request:
#   CONCRETE_PREPUSH_SELECT=area
SELECT_MODE="${CONCRETE_PREPUSH_SELECT:-impact}"
if [ "$SELECT_MODE" = "impact" ] \
   && bash "$RUNNER" --plan "${SEL[@]}" --impact-files "$CHANGED_F" > "$PLAN_F"; then
  echo "pre-push: impact selection (scripts/tests/select_gates.sh)"
  SEL+=(--impact-files "$CHANGED_F")
else
  if [ "$SELECT_MODE" = "impact" ]; then
    echo "pre-push: impact selection FAILED (above); falling back to the area map"
  else
    echo "pre-push: CONCRETE_PREPUSH_SELECT=$SELECT_MODE, area map"
  fi
  [ "${#AREA_SEL[@]}" -eq 0 ] || echo "pre-push: area selectors: ${AREA_SEL[*]}"
  SEL+=("${AREA_SEL[@]}")
fi
# The selection is resolved by the RUNNER, not restated here: --plan is the same code path that the
# real run executes, so the list printed (and bound into any record) is the list that runs.
bash "$RUNNER" --plan "${SEL[@]}" > "$PLAN_F" || {
  echo "pre-push: could not resolve the gate selection (above) — refusing to push." >&2; exit 1; }
[ -s "$PLAN_F" ] || { echo "pre-push: the gate selection is EMPTY — refusing to push." >&2; exit 1; }
echo "pre-push: $(grep -c . "$PLAN_F") unique gate command(s) selected:"
sed 's/^/  /' "$PLAN_F"

# ---------------------------------------------------------------------------
# VALIDATION RECORD (scripts/tests/lib/prepush_record.sh). The same SHA is pushed to more than one
# remote; when this exact candidate already passed this exact selection — same commit and clean
# tree, same untracked files, same toolchain and compiler binary, same gate definitions, same
# changed-file list — the second push reuses that result instead of re-running it. ANY difference,
# or any doubt (no record, truncated, failed, unidentifiable toolchain, dirty tree), is a full run.
# Opt out with CONCRETE_PREPUSH_NO_REUSE=1.
RECORD=""; RECORDABLE=0
COMP0="$TMPD/components.pre"
if source "scripts/tests/lib/prepush_record.sh" 2>/dev/null \
   && [ "$(ppr_available 2>/dev/null)" = "concrete-prepush-record-v1" ] \
   && RECORD="$(ppr_path "$ROOT_DIR")"; then
  if ppr_components "$ROOT_DIR" "$pushed" "$CHANGED_F" "$PLAN_F" "$COMP0"; then
    RECORDABLE=1
    if [ "${CONCRETE_PREPUSH_NO_REUSE:-0}" = "1" ]; then
      echo "pre-push: record reuse disabled by CONCRETE_PREPUSH_NO_REUSE=1 — running the gates"
    elif ppr_check "$RECORD" "$COMP0"; then
      echo "pre-push: REUSED validation record $RECORD"
      echo "pre-push:   $(grep -E '^(head|written_at|selection_count)=' "$RECORD" | tr '\n' ' ')"
      echo "pre-push:   every bound input matches (commit, clean tree, untracked files, toolchain, compiler"
      echo "pre-push:   binary, gate definitions, selection, changed-file list); no gate was re-run."
      exit 0
    else
      echo "pre-push: no reusable validation record ($PPR_REASON) — running the gates"
    fi
  else
    echo "pre-push: this push cannot be recorded ($PPR_REASON) — running the gates; no record will be written"
  fi
else
  echo "pre-push: validation-record library unavailable — running the gates; no record will be written"
fi
# A run is starting, so the previous record no longer describes anything this hook vouches for.
if [ -n "$RECORD" ] && ! ppr_invalidate "$RECORD"; then
  echo "pre-push: could not remove the previous validation record $RECORD — refusing to push." >&2; exit 1
fi

echo "pre-push: building…"
# One log per push: concurrent pushes from different worktrees shared /tmp/prepush-build.log, so a
# failing build's log was overwritten by the next push before anyone read it.
BUILD_LOG="$(mktemp "${TMPDIR:-/tmp}/prepush-build.XXXXXX")" || BUILD_LOG=/dev/null
make build >"$BUILD_LOG" 2>&1 || {
  echo "pre-push: BUILD FAILED — see $BUILD_LOG" >&2; exit 1; }

COMP1="$TMPD/components.start"
[ "$RECORDABLE" = "1" ] && { ppr_components "$ROOT_DIR" "$pushed" "$CHANGED_F" "$PLAN_F" "$COMP1" || RECORDABLE=0; }

# A SIGNAL TO THIS HOOK REACHES THE RUN (bug 244). The runner owns its gates as one process group and
# terminates all of them when IT is signalled; a hook killed while it waited in the foreground died
# alone and left the whole run working the tree. So the run is waited for in the background, where a
# trap can forward the signal, and waited for again until it has actually exited.
bash "$RUNNER" "${SEL[@]}" &
RUNNER_PID=$!
trap 'kill -TERM "$RUNNER_PID" 2>/dev/null' INT TERM HUP
RUNNER_RC=0
wait "$RUNNER_PID" || RUNNER_RC=$?
while kill -0 "$RUNNER_PID" 2>/dev/null; do
  RUNNER_RC=0; wait "$RUNNER_PID" || RUNNER_RC=$?
done
trap - INT TERM HUP
[ "$RUNNER_RC" = "0" ] || {
  echo "pre-push: GATES FAILED (above) — fix, or bypass deliberately." >&2; exit 1; }

if [ "$docs_only" = "1" ]; then
  echo "pre-push: docs gates pass"
else
  echo "pre-push: fast surface gates + touched-area gates pass"
  echo "pre-push: NOTE the full set was not run — 'make pre-push-full' or CI covers it."
fi

# The record binds what the gates actually ran against: components captured after the build, and
# captured again now. If any moved during the run, the result describes neither — fail closed.
if [ "$RECORDABLE" = "1" ]; then
  COMP2="$TMPD/components.end"
  if ! ppr_components "$ROOT_DIR" "$pushed" "$CHANGED_F" "$PLAN_F" "$COMP2"; then
    echo "pre-push: validation inputs became unreadable during the run ($PPR_REASON) — refusing to push." >&2; exit 1
  fi
  if ! cmp -s "$COMP1" "$COMP2"; then
    echo "pre-push: validation inputs MOVED during the run:" >&2
    diff "$COMP1" "$COMP2" | sed 's/^/  /' >&2
    echo "pre-push: the gates' verdict describes neither state — refusing to push." >&2; exit 1
  fi
  if ppr_write "$RECORD" "$COMP2"; then
    echo "pre-push: validation record written to $RECORD (a push of this exact candidate may reuse it)"
  else
    echo "pre-push: warning: could not write the validation record; the next push will re-run." >&2
  fi
fi
exit 0
