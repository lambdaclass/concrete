#!/usr/bin/env bash
# Pre-push gate: run what CI runs, before CI runs it.
#
# `make test-full` is NOT sufficient and never was — it does not execute the
# check_*.sh gate scripts at all. Both times this repository shipped a red main
# (2026-06, 2026-07, and twice more on 2026-07-25) the local fast suite was
# green and the gates had never been run. The ritual was documented in a
# Makefile comment; a comment is not enforcement.
#
# Docs-only pushes take the short path: a full gate pass for a typo would train
# everyone to bypass, which is worse than not having the hook.
#
# Deliberate bypass:  CONCRETE_SKIP_GATES=1 git push
set -uo pipefail
ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

if [ "${CONCRETE_SKIP_GATES:-0}" = "1" ]; then
  echo "pre-push: gates SKIPPED by CONCRETE_SKIP_GATES=1 — you own the CI result." >&2
  exit 0
fi

# What is actually being pushed: compare against the upstream tip when known.
remote_sha="$(git rev-parse "@{upstream}" 2>/dev/null || echo "")"
if [ -n "$remote_sha" ]; then
  changed="$(git diff --name-only "$remote_sha"..HEAD)"
else
  changed="$(git diff --name-only HEAD~1..HEAD 2>/dev/null || echo "")"
fi

docs_only=1
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    docs/*|*.md) ;;                       # prose
    *) docs_only=0; break ;;              # anything else needs the full pass
  esac
done <<< "$changed"

# Gates need the compiler.
echo "pre-push: building…"
make build >/tmp/prepush-build.log 2>&1 || {
  echo "pre-push: BUILD FAILED — see /tmp/prepush-build.log" >&2; exit 1; }

if [ "$docs_only" = "1" ] && [ -n "$changed" ]; then
  echo "pre-push: docs-only change — running docs gates"
  bash scripts/tests/check_docs_drift.sh || exit 1
  bash scripts/tests/check_roadmap_linear.sh || exit 1
  echo "pre-push: docs gates pass"
  exit 0
fi

# Parallel by default: gates are independent processes, and the runner
# re-checks any failure sequentially before believing it. On a multicore box
# this is ~5 minutes rather than ~40, which is the difference between a habit
# and a thing people skip.
CORES="$( (sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null) || echo 4 )"
JOBS_N=$(( CORES > 8 ? 8 : CORES ))
echo "pre-push: running every CI gate locally (JOBS=$JOBS_N) — bypass with CONCRETE_SKIP_GATES=1"
JOBS="$JOBS_N" bash scripts/tests/run_ci_gates_local.sh || {
  echo "pre-push: GATES FAILED — fix before pushing, or bypass deliberately." >&2; exit 1; }
echo "pre-push: all CI gates pass"
