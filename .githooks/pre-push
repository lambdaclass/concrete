#!/usr/bin/env bash
# WIP pushes back up work. GitHub's merge queue validates and updates main.
set -uo pipefail

while read -r _localref localsha remoteref _remotesha; do
  case "$remoteref" in
    refs/heads/wip/*) ;;
    *)
      echo "pre-push: $remoteref is outside refs/heads/wip/*; land through a pull request." >&2
      exit 1 ;;
  esac

  # A deletion has no tree to scan.
  case "$localsha" in *[!0]*) ;; *) continue ;; esac
  rc=0
  git grep -qE '^(<{7}|>{7}|\|{7})( |$)|^={7}$' "$localsha" -- . ':(exclude)legacy/' || rc=$?
  case "$rc" in
    0) echo "pre-push: conflict markers in $localsha ($remoteref)" >&2; exit 1 ;;
    1) ;;
    *) echo "pre-push: could not scan $localsha (git grep exit $rc)" >&2; exit 1 ;;
  esac
done
