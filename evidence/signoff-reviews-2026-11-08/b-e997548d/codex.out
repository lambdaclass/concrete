    49	printf 'pid=%s worktree=%s\n' "$$" "$(pwd)" > "$PUSH_LOCK/owner" 2>/dev/null || true
    50	trap 'rm -f "$PUSH_LOCK/owner" 2>/dev/null; rmdir "$PUSH_LOCK" 2>/dev/null || true' EXIT
    51	
    52	REMOTE="${PUSH_REMOTE:-origin}"
    53	if [ "$REMOTE" = "fork" ]; then
    54	  echo "push-both: refusing the remote named fork (a divergent repository)" >&2
    55	  exit 2
    56	fi
    57	REPO="${LAND_REPO:-lambdaclass/concrete}"
    58	BRANCH="${BRANCH:-main}"
    59	LOCAL="$(git rev-parse HEAD)"
    60	CI_WAIT=0
    61	CI_WORKFLOW="${CI_WORKFLOW:-CI}"
    62	# Bounded so this cannot hang a session forever; a timeout is reported as no verdict.
    63	#
    64	# CALIBRATED against observed runs, not guessed. A first version used 2400s
    65	# (40min) and timed out on a run that was still in progress — this workflow's
    66	# recent full runs took 41m42s and 42m39s, so the timeout was SHORTER than the
    67	# job it was waiting for. A timeout below the expected duration does not bound a
    68	# hang, it manufactures a failure on every healthy push. 4200s leaves real
    69	# headroom above ~43min while still being finite.
    70	CI_TIMEOUT="${CI_TIMEOUT:-4200}"
    71	CI_INTERVAL="${CI_INTERVAL:-30}"
    72	
    73	while [ $# -gt 0 ]; do
    74	  case "$1" in
    75	    --no-ci-wait) CI_WAIT=0; shift ;;          # retained: scripts may still pass it
    76	    --ci-wait)    CI_WAIT=1; shift ;;          # opt in to blocking on the verdict
    77	    *) echo "push-both: unknown option $1" >&2; exit 2 ;;
    78	  esac
    79	done
    80	
    81	echo "push-both: ${LOCAL:0:8} to $REMOTE/$BRANCH"
    82	# Push the RECORDED SHA, not `HEAD`. `HEAD` is a moving ref: everything below —
    83	# the read-back of the remote branch and the optional CI wait — is about $LOCAL,
    84	# so pushing HEAD means publishing something other than what was checked.
    85	if ! git push "$REMOTE" "$LOCAL:$BRANCH"; then
    86	  echo "push-both: the push to $REMOTE failed." >&2
    87	  exit 1
    88	fi
    89	
    90	# A successful exit is not the same as the ref being where we think.
    91	got="$(git ls-remote "$REMOTE" "refs/heads/$BRANCH" | cut -f1)"
    92	if [ "$got" != "$LOCAL" ]; then
    93	  echo "push-both: $REMOTE/$BRANCH is $got, expected $LOCAL." >&2
    94	  exit 1
    95	fi
    96	
