#!/usr/bin/env bash
# Bounded runs: a timeout is INCOMPLETE, never a failure and never a pass.
#
# The rule (docs/project/PROMOTION_PIPELINE.md, result vocabulary): a test that exceeds its time budget
# has produced no observation. Under machine load a freshly linked binary or a compile can overrun
# a budget sized for an idle machine (test_ssa.sh once reported hundreds of 5-second alarms as
# failures), so a timeout is re-run once, alone, with a larger budget:
#   - the re-run completes      -> its result is judged normally (pass or FAIL), recorded "recovered";
#   - the re-run times out too  -> INCOMPLETE: not a pass, not a failure. A gate with an incomplete
#                                  result exits nonzero, and a qualifying run contains none.
#
# Each attempt runs under lib/bounded_exec.py, which makes the command the leader of a new process
# group, reports its outcome through a status file (never through the command's own streams, so
# nothing the command prints can fake or hide a timeout) and, when the budget expires, sends SIGTERM
# and then SIGKILL to the whole group, so no descendant outlives the attempt into the retry.
#
# Sourcing (`BOUNDED_PARENT="$TMP"; source scripts/checks/lib/bounded.sh`) gives the gate PRIVATE
# state: a fresh directory (mktemp under BOUNDED_PARENT, else $TMPDIR) with an outcome file and a
# log. Every sourcing creates its own directory, so nested or parallel gates never share state.
# With BOUNDED_PARENT under the gate's own scratch directory, its cleanup removes the state too.
#
#   bounded_run [-i STDIN_FILE] [-r RETRY_SECS] SECS -- CMD [ARGS...]
#     Runs CMD (an executable, not a shell function). Its stdout and stderr are buffered per
#     attempt and only a COMPLETED attempt's output is written: an incomplete run writes nothing,
#     so output-matching checks never pass on the partial output of a run that hung. Without -i the
#     command inherits stdin, which a re-run cannot replay: callers that feed input pass -i.
#     Returns CMD's status, or 124 when it timed out on both attempts or the runner reported no
#     outcome. SECS and RETRY_SECS are positive decimal seconds. A command may itself exit
#     124, so test with `bounded_is_incomplete "$rc"`, which also reads the outcome bounded_run
#     recorded (this works across `( cd dir && bounded_run ... )` subshells; run one bounded_run
#     at a time per sourcing). RETRY_SECS defaults to BOUNDED_RETRY_FACTOR (2) times SECS.
#   bounded_summary
#     Lists this gate's recovered and incomplete runs; gates print it before their final tally.
#   bounded_watchdog SECS  -> sets the array TO for the watchdog form: "${TO[@]}" CMD [ARGS...]
#     runs CMD through `bash bounded.sh SECS` in a separate process with the same retry; on a second
#     timeout it writes no command output, prints "INCOMPLETE: ..." on stderr and exits 124. Its
#     recovered and incomplete lines go to this gate's log (handed over on its command line).
#   bounded_gate_status
#     The end-of-gate verdict for a gate using the watchdog form: lists recovered, incomplete and
#     runner-failed runs, removes the state directory, and returns 1 when any run was incomplete or
#     the runner failed, so the gate exits nonzero whatever its own checks concluded from a hung
#     command's empty output. Last line:
#       bounded_gate_status && [ "$FAIL" -eq 0 ]
#
# If the runner itself fails (no outcome reported), the command's output is discarded and the run
# is incomplete (status 124, a "runner-failed" log line): never a pass. If the runner is cancelled (the
# gate is interrupted or terminated), it kills the command's group first.
#
# Without python3 commands run directly with no watchdog: one warning when the gate sources this
# file, never inside a command's output, and the watchdog form then runs commands directly too.
# Such a run is never incomplete.

BOUNDED_RETRY_FACTOR="${BOUNDED_RETRY_FACTOR:-2}"
if [[ "$BOUNDED_RETRY_FACTOR" =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk -v f="$BOUNDED_RETRY_FACTOR" 'BEGIN { exit !(f + 0 >= 1) }'; then :
else echo "bounded.sh: BOUNDED_RETRY_FACTOR must be a number >= 1; using 2" >&2; BOUNDED_RETRY_FACTOR=2; fi
# _bounded_secs_ok S: S is a positive decimal number of seconds (fractions allowed).
_bounded_secs_ok() { [[ "$1" =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk -v s="$1" 'BEGIN { exit !(s + 0 > 0) }'; }
# Fixed-point, trailing zeros trimmed: never scientific notation, which _bounded_secs_ok rejects.
_bounded_mul() { awk -v s="$1" -v f="$2" 'BEGIN { r = sprintf("%.6f", s * f); sub(/0+$/, "", r); sub(/\.$/, "", r); print r }'; }
BOUNDED_SH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
BOUNDED_EXEC="$(dirname "$BOUNDED_SH")/bounded_exec.py"
BOUNDED_DIR="$(mktemp -d "${BOUNDED_PARENT:-${TMPDIR:-/tmp}}/bounded.XXXXXX")"
BOUNDED_OUTCOME_FILE="$BOUNDED_DIR/outcome"
BOUNDED_LOG="$BOUNDED_DIR/log"
# The watchdog form appends to its caller's log, handed over explicitly on its command line.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  # A standalone watchdog removes its state however it ends.
  trap 'rm -rf "$BOUNDED_DIR"' EXIT
  [ -z "${BOUNDED_WATCHDOG_LOG:-}" ] || BOUNDED_LOG="$BOUNDED_WATCHDOG_LOG"
fi
: >> "$BOUNDED_LOG"
BOUNDED_HAVE_WATCHDOG=1
if ! command -v python3 >/dev/null 2>&1; then
  BOUNDED_HAVE_WATCHDOG=0
  [ "${BASH_SOURCE[0]}" = "$0" ] || echo "  warn python3 not found — commands run without a hang watchdog" >&2
fi

bounded_is_incomplete() {
  [ "$1" = 124 ] && [ "$(cat "$BOUNDED_OUTCOME_FILE" 2>/dev/null)" = incomplete ]
}

bounded_run() {
  local stdin_file="" retry="" secs="" rc tries=0 budget tmp outcome
  while [ $# -gt 0 ]; do
    case "$1" in
      -i) stdin_file="$2"; shift 2 ;;
      -r) retry="$2"; shift 2 ;;
      --) shift; break ;;
      *) if [ -z "$secs" ]; then secs="$1"; shift; else break; fi ;;
    esac
  done
  [ -n "$secs" ] && [ $# -gt 0 ] || { echo "bounded_run: usage: bounded_run [-i FILE] [-r SECS] SECS -- CMD..." >&2; return 2; }
  [ -n "$retry" ] || retry="$(_bounded_mul "$secs" "$BOUNDED_RETRY_FACTOR")"
  if ! _bounded_secs_ok "$secs" || ! _bounded_secs_ok "$retry"; then
    echo "bounded_run: budgets must be positive numbers of seconds (got $secs, retry $retry)" >&2; return 2
  fi
  echo done > "$BOUNDED_OUTCOME_FILE"
  if [ "$BOUNDED_HAVE_WATCHDOG" != 1 ]; then
    if [ -n "$stdin_file" ]; then "$@" < "$stdin_file"; else "$@"; fi
    return $?
  fi
  tmp="$(mktemp -d "$BOUNDED_DIR/run.XXXXXX")"
  budget="$secs"
  while :; do
    tries=$((tries + 1))
    rm -f "$tmp/status"
    if [ -n "$stdin_file" ]; then
      python3 -I "$BOUNDED_EXEC" --timeout "$budget" --kill-after "${BOUNDED_KILL_AFTER:-10}" --status "$tmp/status" -- "$@" < "$stdin_file" > "$tmp/out" 2> "$tmp/err"
    else
      python3 -I "$BOUNDED_EXEC" --timeout "$budget" --kill-after "${BOUNDED_KILL_AFTER:-10}" --status "$tmp/status" -- "$@" > "$tmp/out" 2> "$tmp/err"
    fi
    outcome="$(cat "$tmp/status" 2>/dev/null)"
    case "$outcome" in
      "exit "*) break ;;
      timeout) [ "$tries" = 1 ] || break; budget="$retry" ;;
      *) outcome=runner-failed; break ;;
    esac
  done
  if [ "$outcome" = timeout ]; then
    echo incomplete > "$BOUNDED_OUTCOME_FILE"
    echo "incomplete ${secs}s+${retry}s $*" >> "$BOUNDED_LOG"
    rc=124
  elif [ "$outcome" = runner-failed ]; then
    # The runner reported nothing (it failed or was cancelled): no observation, so the run is
    # incomplete exactly as a double timeout is (status 124, bounded_is_incomplete true).
    echo "bounded_run: the runner reported no outcome for: $*" >&2
    echo incomplete > "$BOUNDED_OUTCOME_FILE"
    echo "runner-failed ${secs}s $*" >> "$BOUNDED_LOG"
    rc=124
  else
    cat "$tmp/out"; cat "$tmp/err" >&2
    rc="${outcome#exit }"
    [ "$tries" = 2 ] && echo "recovered ${secs}s $*" >> "$BOUNDED_LOG"
  fi
  rm -rf "$tmp"
  return "$rc"
}

bounded_summary() {
  local nrec ninc
  nrec=$(grep -c '^recovered' "$BOUNDED_LOG" 2>/dev/null || true); nrec=${nrec:-0}
  ninc=$(grep -c '^incomplete\|^runner-failed' "$BOUNDED_LOG" 2>/dev/null || true); ninc=${ninc:-0}
  [ "$nrec" -gt 0 ] || [ "$ninc" -gt 0 ] || return 0
  echo "Bounded runs: $nrec recovered (timed out, then completed alone), $ninc incomplete (timed out twice, or the runner failed):"
  sed 's/^/  /' "$BOUNDED_LOG"
}

bounded_watchdog() {
  if [ "$BOUNDED_HAVE_WATCHDOG" = 1 ]; then
    TO=(env "BOUNDED_WATCHDOG_LOG=$BOUNDED_LOG" "BOUNDED_PARENT=$BOUNDED_DIR" bash "$BOUNDED_SH" "$1")
  else
    TO=(env)  # no python3: run commands directly (the gate warned once when it sourced this file)
  fi
}

bounded_gate_status() {
  local ninc
  bounded_summary
  ninc=$(grep -c '^incomplete\|^runner-failed' "$BOUNDED_LOG" 2>/dev/null || true); ninc=${ninc:-0}
  [ "$ninc" -eq 0 ] || echo "INCOMPLETE: $ninc command(s) timed out twice or lost their runner: this run is incomplete, not passed"
  rm -rf "$BOUNDED_DIR"
  [ "$ninc" -eq 0 ]
}

# Watchdog form: `bash bounded.sh SECS CMD...` (through bounded_watchdog's TO array).
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  [ $# -ge 2 ] || { echo "usage: bash $0 SECS CMD [ARGS...]" >&2; exit 2; }
  secs="$1"; shift
  bounded_run "$secs" -- "$@"; rc=$?
  if bounded_is_incomplete "$rc"; then
    echo "INCOMPLETE: timed out twice (${secs}s, then $(_bounded_mul "$secs" "$BOUNDED_RETRY_FACTOR")s alone) or lost its runner: $*" >&2
  fi
  exit "$rc"
fi
#!/usr/bin/env bash
# Every root check, in order; the one entry point the pre-push hook, CI's "Root checks" job and the
# landing tools (scripts/land/train.sh, ready.sh: LAND_FULL_GATES_CMD) run.
#
# The set is every scripts/checks/*.sh except this file, so a new check cannot be written and then
# forgotten here. REQUIRED names the checks that must exist: deleting one fails the run instead of
# shrinking it. Each check runs to completion; the run fails if any check failed.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"
REQUIRED="legacy_frozen root_inventory workflow_yaml doc_links landing_script landing_ready review_tool sandbox_isolation retention_manifest issues oracle_fetch"
missing=""
for c in $REQUIRED; do [ -f "scripts/checks/$c.sh" ] || missing="$missing $c"; done
[ -z "$missing" ] || { echo "run.sh: required check(s) missing:$missing" >&2; exit 1; }
failed="" n=0
for f in scripts/checks/*.sh; do
  [ "$f" = scripts/checks/run.sh ] && continue
  n=$((n+1))
  echo "=== $f ==="
  s="$(date +%s)"
  if bash "$f"; then echo "--- $f: pass ($(( $(date +%s) - s ))s)"
  else echo "--- $f: FAIL ($(( $(date +%s) - s ))s)"; failed="$failed ${f##*/}"; fi
done
echo
if [ -n "$failed" ]; then echo "root checks: FAILED:$failed (of $n)"; exit 1; fi
echo "root checks: all $n pass"
#!/usr/bin/env bash
# Pre-push gate for the restarted root.
#
# A push that can reach main or a ci/* candidate builds the specification and runs every root check
# (scripts/checks/run.sh), the same set CI's "Root checks" and "Spec build" jobs run. The set is small
# and fast, so there is no selection: everything runs on every such push. legacy/ is frozen and never
# run; scripts/checks/legacy_frozen.sh is the only check that looks at it.
#
# Tiers decided from git's ref lines on stdin (`<local ref> <local sha> <remote ref> <remote sha>`):
#   - only refs/heads/wip/* updates or deletions: a backup of unfinished work, which can never become
#     main. Conflict markers are refused; nothing else runs.
#   - only the review-note refs (refs/notes/concrete-review, refs/notes/concrete-review-findings,
#     written by scripts/review/review.sh) and owner sign-off records (refs/owner-signoff/<sha>,
#     written by scripts/land/signoff.sh): no source tree, nothing to check.
#   - anything else, including a by-hand run with no stdin: the full root set, and only from a full
#     clone (a linked worktree is refused; ISS-0015).
#
# Deliberate bypass:  CONCRETE_SKIP_GATES=1 git push   (you then own the CI result)
set -uo pipefail
HOOK_SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
# train.sh asks the hook git would run which hook it is (ISS-0015): called with the single argument
# --concrete-identify (git always passes a remote name and URL, never this), this one answers with
# its real path and runs nothing. A wrapper that passes its arguments on to it (acceptance.sh's
# guard) gets the same answer; a hook that never runs this one gives none. An argument, not an
# environment variable, so nothing a push inherits can turn the gates off.
if [ "$#" = 1 ] && [ "$1" = --concrete-identify ]; then
  echo "concrete-pre-push $(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
  exit 0
fi
ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

if [ "${CONCRETE_SKIP_GATES:-0}" = "1" ]; then
  echo "pre-push: gates SKIPPED by CONCRETE_SKIP_GATES=1 — you own the CI result." >&2
  exit 0
fi

wip_refs=0; wip_dels=0; note_refs=0; other_refs=0; wip_shas=""; full_shas=""
# Kept whole so the hook can hand the same lines to itself when it re-enters the gate shell (below).
HOOK_STDIN="$(cat)"
while read -r _localref localsha remoteref _remotesha; do
  [ -z "${localsha:-}" ] && continue
  case "${remoteref:-}" in
    refs/heads/wip/*)
      case "$localsha" in
        *[!0]*) wip_refs=$((wip_refs+1)); wip_shas="$wip_shas $localsha" ;;
        *) wip_dels=$((wip_dels+1)) ;;
      esac ;;
    refs/owner-signoff/*)
      # Only a record takes the notes tier: a parentless commit, under its subject's 40-hex name, whose
      # tree is exactly the sign-off's seven plain files (record.txt plus each reviewer's request and
      # output), no directory among them. Anything else pushed here, including the old four-file shape
      # or a source commit, takes the full tier, as does a deletion.
      if [[ "${remoteref#refs/owner-signoff/}" =~ ^[0-9a-f]{40}$ ]] && [ "$(git rev-list --parents -n 1 "$localsha" 2>/dev/null)" = "$localsha" ] \
         && [ "$(git ls-tree --format='%(objectmode) %(objecttype) %(path)' "$localsha" 2>/dev/null | LC_ALL=C sort | tr '\n' ' ')" \
              = "100644 blob agy-request.txt 100644 blob agy.txt 100644 blob codex-request.txt 100644 blob codex.txt 100644 blob kimi-request.txt 100644 blob kimi.txt 100644 blob record.txt " ]; then
        note_refs=$((note_refs+1))
      else
        other_refs=$((other_refs+1))
        case "$localsha" in *[!0]*) full_shas="$full_shas $localsha" ;; esac
      fi ;;
    refs/notes/concrete-review|refs/notes/concrete-review-findings)
      case "$localsha" in
        *[!0]*) note_refs=$((note_refs+1)) ;;
        *) other_refs=$((other_refs+1)) ;;   # deleting a review note takes the full tier
      esac ;;
    *) other_refs=$((other_refs+1))
       case "$localsha" in *[!0]*) full_shas="$full_shas $localsha" ;; esac ;;
  esac
done <<< "$HOOK_STDIN"

if [ "$other_refs" -eq 0 ] && [ $((wip_refs + wip_dels)) -gt 0 ]; then
  bad=""
  for sha in $wip_shas; do
    rc=0; git grep -qE '^(<{7}|>{7}|\|{7})( |$)|^={7}$' "$sha" -- . ':(exclude)legacy/' >/dev/null 2>&1 || rc=$?
    case "$rc" in
      0) bad="$bad $sha" ;;
      1) ;;
      *) echo "pre-push (wip tier): could not scan $sha (git grep exit $rc) — refusing"; exit 1 ;;
    esac
  done
  [ -z "$bad" ] || { echo "pre-push (wip tier): conflict markers in$bad — refusing"; exit 1; }
  echo "pre-push: wip/* backup push ($wip_refs update(s), $wip_dels deletion(s)) — conflict-marker check only; the full set runs on ci/* and main"
  exit 0
fi
if [ "$other_refs" -eq 0 ] && [ "$note_refs" -gt 0 ]; then
  echo "pre-push: review-notes push (review notes, owner sign-offs) — no source tree, no gates"
  exit 0
fi

# The checks build sandbox repositories, and a linked worktree hands its hook
# GIT_DIR=<repo>/.git/worktrees/<name>: on 2026-11-06 that turned a review-tool check into writes on a
# real clone and on GitHub (ISS-0015). Every repository-making script now clears git's variables, and
# as a second wall a push that runs the checks must come from a full clone. The wip and notes tiers
# above run nothing, so a worktree may still back up its branch.
if [ "$(cd "$(git rev-parse --git-dir)" && pwd -P)" != "$(cd "$(git rev-parse --git-common-dir)" && pwd -P)" ]; then
  echo "pre-push: refusing: this push runs the root checks, and $ROOT_DIR is a linked worktree; push it from a full clone (git clone), never a worktree." >&2
  exit 1
fi

# The checks run in the gate shell (scripts/checks/lib/gate_env.sh refuses anywhere else). From
# outside it, the hook re-executes itself inside `nix develop` with the same arguments and stdin.
if [ "${CONCRETE_GATES_SHELL:-}" != 1 ] || ! command -v lake >/dev/null 2>&1; then
  if [ "${CONCRETE_PREPUSH_REENTERED:-0}" = 1 ]; then
    echo "pre-push: nix develop did not provide the gate shell with Lean — refusing to push." >&2; exit 1
  fi
  command -v nix >/dev/null 2>&1 || {
    echo "pre-push: the checks run inside nix develop, and nix is not on PATH — refusing to push." >&2; exit 1; }
  echo "pre-push: entering nix develop for the checks"
  CONCRETE_PREPUSH_REENTERED=1 exec nix develop "$ROOT_DIR" --command bash "$HOOK_SELF" "$@" <<< "$HOOK_STDIN"
fi

# The checks judge the work tree, so it must be the commit being pushed, unmodified.
head="$(git rev-parse HEAD)"
for sha in $full_shas; do
  [ "$sha" = "$head" ] || {
    echo "pre-push: pushing ${sha:0:10}, but the checkout is at ${head:0:10}; the checks would judge the wrong commit — check it out and push from there." >&2
    exit 1; }
done
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "pre-push: the work tree has uncommitted changes to tracked files; the checks would not judge what is pushed — refusing." >&2
  exit 1
fi

echo "pre-push: building the specification…"
BUILD_LOG="$(mktemp "${TMPDIR:-/tmp}/prepush-build.XXXXXX")" || BUILD_LOG=/dev/null
lake build >"$BUILD_LOG" 2>&1 || { echo "pre-push: BUILD FAILED — see $BUILD_LOG" >&2; exit 1; }

echo "pre-push: root checks…"
bash scripts/checks/run.sh || { echo "pre-push: ROOT CHECKS FAILED (above) — fix, or bypass deliberately." >&2; exit 1; }
echo "pre-push: build and root checks pass"
exit 0

exec
/bin/bash -lc "sed -n '300,710p' REVIEW.diff" in /tmp/claude-30035/-home-unbalancedparen-projects-concrete2/e2c54e65-31b5-4145-8101-c2d7b071b97e/scratchpad/rev-so-b/src
 succeeded in 0ms:
-- Codex review per step or per small group, until ACCEPT; pushed to both remotes.
+- Codex review per step or per small group, until ACCEPT; pushed to lambdaclass/concrete.
 - phase A steps land on main through the train (review leg on) as soon as they pass; later steps
   land in small groups.
 
