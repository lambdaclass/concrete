{
  description = "Concrete development environment";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
  };

  outputs = { self, nixpkgs }:
    let
      systems = [
        "x86_64-linux"
        "aarch64-linux"
        "x86_64-darwin"
        "aarch64-darwin"
      ];
      forAllSystems = f:
        nixpkgs.lib.genAttrs systems (system:
          f {
            pkgs = import nixpkgs { inherit system; };
          });
    in {
      devShells = forAllSystems ({ pkgs }:
        let
          # LEAN IS THE OFFICIAL v4.34.1 RELEASE ARCHIVE, not nixpkgs' lean4 (R-0208). The checker identity a
          # receipt binds is the executable and libraries that actually load; nixpkgs builds Lean itself
          # (reporting its version tag as the githash), so the devshell and CI's elan ran DIFFERENT checkers
          # under one name. Pinning the archive elan installs makes them the same build. Hashes are the
          # sha256 GitHub publishes for each release asset. macOS binaries are left byte-identical
          # (dontFixup); Linux needs autoPatchelf to run under Nix, so its bytes — and identity — differ
          # from elan's there, which CI (elan) does not use.
          leanRelease =
            let
              sys = pkgs.stdenv.hostPlatform.system;
              asset = {
                "aarch64-darwin" = { name = "darwin_aarch64"; sha256 = "65f22a4f047738ec742667b3247e836a86ebf06eabc12655c3dee00637e37866"; };
                "x86_64-darwin"  = { name = "darwin";         sha256 = "c2fee70250444e46c1106a27bddfef948d1e563eef431eaac05bb946b2f73d3a"; };
                "x86_64-linux"   = { name = "linux";          sha256 = "47bf4bbd78f70c2e9670598ab7124d92b6efb7330ff33e5fbb4030f6fd72e4e4"; };
                "aarch64-linux"  = { name = "linux_aarch64";  sha256 = "fdb974c2cdb4627e090d5d4007b913e09d13c4868720fb5594e22808b3de9e37"; };
              }.${sys};
            in pkgs.stdenv.mkDerivation {
              pname = "lean4-release";
              version = "4.34.1";
              src = pkgs.fetchurl {
                url = "https://github.com/leanprover/lean4/releases/download/v4.34.1/lean-4.34.1-${asset.name}.tar.zst";
                sha256 = asset.sha256;
              };
              nativeBuildInputs = [ pkgs.zstd ]
                ++ pkgs.lib.optionals pkgs.stdenv.isLinux [ pkgs.autoPatchelfHook ];
              buildInputs = pkgs.lib.optionals pkgs.stdenv.isLinux [ pkgs.stdenv.cc.cc.lib pkgs.zlib ];
              autoPatchelfIgnoreMissingDeps = true;
              dontConfigure = true;
              dontBuild = true;
              dontStrip = true;
              dontFixup = pkgs.stdenv.isDarwin;
              unpackPhase = "tar --zstd -xf $src";
              installPhase = "mkdir -p $out && cp -R lean-4.34.1-${asset.name}/. $out/";
            };
          # pyyaml so scripts/tests/check_workflow_yaml.sh can actually run: it needs pyyaml or ruby
          # and FAILS (rather than skips) without either. The only non-stdlib module any gate imports.
          python = pkgs.python3.withPackages (ps: [ ps.pyyaml ]);

          # THE GATE USERLAND: the programs scripts/tests (and the scripts/ci, scripts/gen,
          # scripts/land helpers they call) run, and nothing else. Gates run in three places, the
          # dev shell, Linux CI runners and the macOS CI runner, and used to take these tools from
          # whatever host they landed on: GNU on Linux, BSD on macOS, where `timeout` does not exist
          # and `sed -i`, `stat`, `date` and `readlink` take other flags. CI now runs every gate step
          # inside `nix develop .#gates`, so all three see these exact builds.
          #
          # NO LEAN HERE, and no lake. CI takes Lean from elan, and the checker identity a receipt
          # records is the Lean that actually loads (R-0208); a shell that put the nix-built Lean
          # first on PATH would change it. The C/LLVM/Rust toolchains, z3, valgrind, zola, curl and
          # gh also stay the host's: CI provisions those separately today, and moving them is a
          # different change.
          gatesUserland = with pkgs; [
            bash
            coreutils          # timeout, stat, date, readlink, sha256sum, mktemp, ...
            findutils
            diffutils          # diff, cmp
            gnused
            gnugrep
            gawk
            gnutar             # check_tar_list_differential.sh compares against `tar -tf`
            gzip
            xz
            zstd
            bzip2
            which
            file
            gnumake
            git
            jq
            xxd                # check_hexdump_differential.sh skips its format legs without it
            # perl for `shasum`: the checker identity hashes the Lean images with it
            # (Concrete/Proof/Replay.lean, sha256Files), and without it every receipt is withheld
            # as "Checker: UNIDENTIFIED". The shell used to inherit it from the host, and Arch
            # keeps it in /usr/bin/core_perl, which only login shells put on PATH, so 17
            # receipt/replay/checker-identity gates failed on the Arch gate host (2026-10-23).
            # The digest it prints does not depend on which perl computes it.
            perl
            python
#!/usr/bin/env bash
# Workflow-YAML gate.
#
# GitHub Actions workflows that fail to PARSE do not run at all — they report a
# 0-second "completed failure" with no logs, so every gate they were supposed to
# run is silently skipped. This actually happened: a `name:` value that began
# with a backtick (`` ` `` is a reserved YAML indicator and cannot start a plain
# scalar) killed `lean_action_ci.yml` for 40+ consecutive pushes without any
# obvious signal. This gate parses every workflow locally so a malformed file is
# caught before it is pushed, not after CI has been dark for days.
#
# Uses python3+PyYAML if available, otherwise ruby's psych (both ship the parser
# GitHub uses closely enough to catch indicator/indentation errors).

set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
# Per-run scratch (R-0546): a fixed /tmp path collides with a concurrent run of this gate.
GATE_TMP="$(mktemp -d)"; trap 'rm -rf "$GATE_TMP"' EXIT
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"

WF_DIR=".github/workflows"
[ -d "$WF_DIR" ] || { echo "no $WF_DIR — nothing to check"; exit 0; }

parse_one() {
  local f="$1"
  if python3 -c 'import yaml,sys; yaml.safe_load(open(sys.argv[1]))' "$f" 2>"$GATE_TMP/wfyaml.err"; then
    return 0
  fi
  # python3 missing PyYAML (ModuleNotFoundError) → fall back to ruby
  if grep -q "No module named 'yaml'" "$GATE_TMP/wfyaml.err" 2>/dev/null; then
    ruby -ryaml -e "YAML.load_file(ARGV[0])" "$f" 2>"$GATE_TMP/wfyaml.err"
    return $?
  fi
  return 1
}

PASS=0; FAIL=0
for f in "$WF_DIR"/*.yml "$WF_DIR"/*.yaml; do
  [ -e "$f" ] || continue
  if parse_one "$f"; then
    echo "  ok   $f"; PASS=$((PASS+1))
  else
    echo "  FAIL $f"; sed 's/^/         /' "$GATE_TMP/wfyaml.err" | head -4; FAIL=$((FAIL+1))
  fi
done

echo ""
echo "WORKFLOW-YAML: PASS=$PASS  FAIL=$FAIL"
[ "$FAIL" -eq 0 ]
#!/usr/bin/env bash
# R-0544 — the review tool (scripts/review/review.sh, verify.sh, split_diff.py)
# does what docs/REVIEW.md says it does.
#
# No API key is needed: the reviewer is a fake `codex` that answers according to
# MARK_* markers on the ADDED lines of the diff it receives on stdin, and logs
# every call (prompt kind, stdin size, files) so the legs can check what was sent.
# All git work happens in throwaway repositories with a bare repository as
# `origin`, so the notes push, including the non-fast-forward path, runs for real.
#
# Legs: verdict parsing, note writing and its exact format, notes push and the
# non-fast-forward merge, delta selection (round 2 sees only the delta and the
# previous findings), splitting (file groups, size limit, hunk split, --pieces N),
# the content-filter refusal retry (once, neutral, smaller, then `blocked`), the
# round cap (distinct exit code, no extra round), verify.sh, and the pre-push
# hook's review-notes tier (a notes-only push runs no gates).

set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
REVIEW="$ROOT_DIR/scripts/review/review.sh"
VERIFY="$ROOT_DIR/scripts/review/verify.sh"
SPLIT="$ROOT_DIR/scripts/review/split_diff.py"

PASS=0
FAIL=0
ok() { echo "  ok   $1"; PASS=$((PASS+1)); }
no() { echo "  FAIL $1"; FAIL=$((FAIL+1)); }
check() { # check <label> <command...>: the command must succeed
  local label="$1"; shift
  if "$@"; then ok "$label"; else no "$label"; fi
}

T="$(mktemp -d)"
trap 'rm -rf "$T"' EXIT

# Isolate git from the caller's repository (a hook exports GIT_DIR; ISS-0015) and from the user's
# config (hooks, signing, identity).
source "$ROOT_DIR/scripts/checks/lib/git_sandbox.sh" || exit 2
git_sandbox "$T/gitconfig" || exit 2
cat >"$GIT_CONFIG_GLOBAL" <<'EOF'
[user]
	name = Review Gate
	email = review-gate@example.invalid
[init]
	defaultBranch = main
[advice]
	detachedHead = false
EOF

# ------------------------------------------------------------------ fake codex
FAKE_LOG="$T/fake"
mkdir -p "$FAKE_LOG" "$T/bin"
export FAKE_LOG
# Bug 209's legs prove review.sh OVERRIDES the caller's setting: the gate runs with optional locks
# explicitly on, so a value inherited from whoever launched it cannot satisfy them.
export GIT_OPTIONAL_LOCKS=1
cat >"$T/bin/codex" <<'EOF'
#!/usr/bin/env bash
# Fake reviewer: `codex exec --sandbox read-only ... -o <file> <prompt>`, diff on stdin.
set -uo pipefail
[ "${1:-}" = exec ] || { echo "fake codex: expected exec" >&2; exit 64; }
shift
out="" prompt="" sandbox=""
while [ $# -gt 0 ]; do
#!/usr/bin/env bash
# THE RETENTION MANIFEST GIVES EVERY TRACKED FILE EXACTLY ONE GOVERNING ROW (R-0562; P6, P21).
#
# RETENTION.tsv is written before the legacy/ move so that the move, and later deletions under
# legacy/, cannot drop a corpus, a ledger, the site or an archived service by omission. This gate
# holds it to that, through scripts/land/retention.py (the one owner of the rule): the header is
# exact; every row has six non-empty fields and one of the four dispositions; no path is listed
# twice (so a specific row inside a broad one governs unambiguously, by longest prefix); and every
# tracked file of the tree has a governing row. Each leg has a negative control against a mutated
# copy, so the gate cannot pass by checking nothing.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR" || exit 2
[ -f RETENTION.tsv ] || { echo "FATAL: RETENTION.tsv missing" >&2; exit 2; }
RP="scripts/land/retention.py"
TMP="$(mktemp -d)" || exit 2
trap 'rm -rf "$TMP"' EXIT
PASS=0; FAIL=0
ok(){ echo "  ok   $1"; PASS=$((PASS+1)); }
no(){ echo "  FAIL $1"; FAIL=$((FAIL+1)); }
files="$( { git ls-files; echo RETENTION.tsv; } | LC_ALL=C sort -u)"
problems(){ printf '%s\n' "$files" | python3 -I "$RP" check "$1"; }
govern(){ printf '%s\n' "$2" | python3 -I "$RP" govern "$1" | cut -f3; }

echo "=== RETENTION.tsv governs the tree ==="
out="$(problems RETENTION.tsv)"
[ -z "$out" ] && ok "every tracked file ($(printf '%s\n' "$files" | wc -l | tr -d ' ')) has exactly one governing row" \
  || { no "RETENTION.tsv has problems"; echo "$out" | head -20 | sed 's/^/      /'; }
# Precedence: specific rows inside broad ones govern their own paths.
[ "$(govern RETENTION.tsv docs/decisions.md)" = retained ] && [ "$(govern RETENTION.tsv docs/spec/types.md)" = archived ] \
  && [ "$(govern RETENTION.tsv docs/README.md)" = archived ] && [ "$(govern RETENTION.tsv tests/fixtures/fuzz_farm/findings/x)" = migrate ] \
  && ok "the longest listed prefix governs (decisions.md retained inside archived docs/spec; fuzz findings migrate)" \
  || no "precedence: decisions.md=$(govern RETENTION.tsv docs/decisions.md) types.md=$(govern RETENTION.tsv docs/spec/types.md)"

echo "=== negative controls ==="
out="$( { printf '%s\n' "$files"; echo new-top-level-thing; echo docs/new/deep/file.md; } | python3 -I "$RP" check RETENTION.tsv)"
case "$out" in *"no row governs new-top-level-thing"*) ok "an ungoverned path is refused" ;; *) no "an ungoverned path passed" ;; esac
awk 'BEGIN{FS=OFS="\t"} !/^#/ && $1!="path" && $3=="migrate" && !done {$3="keep-forever"; done=1} {print}' RETENTION.tsv > "$TMP/bad-disp.tsv"
out="$(problems "$TMP/bad-disp.tsv")"
case "$out" in *"keep-forever"*) ok "an unknown disposition is refused" ;; *) no "an unknown disposition passed" ;; esac
awk 'BEGIN{FS=OFS="\t"} !/^#/ && $1!="path" && !done {$6=""; done=1} {print}' RETENTION.tsv > "$TMP/bad-crit.tsv"
out="$(problems "$TMP/bad-crit.tsv")"
case "$out" in *"non-empty tab-separated"*) ok "an empty deletion criterion is refused" ;; *) no "an empty deletion criterion passed" ;; esac
awk -F'\t' '$1 != "std"' RETENTION.tsv > "$TMP/no-std.tsv"
if [ "$(wc -l < "$TMP/no-std.tsv")" -lt "$(wc -l < RETENTION.tsv)" ]; then
  out="$(problems "$TMP/no-std.tsv")"
  case "$out" in *"no row governs std/"*|*"no row governs legacy/std/"*) ok "removing the std row leaves std's files ungoverned" ;; *) no "removing the std row went unnoticed" ;; esac
else
  no "the control did not remove the std row (the mutation itself failed)"
fi
{ cat RETENTION.tsv; printf 'docs/bugs\tdup\tretire\tx\tR-0\tB3\topen\n'; } > "$TMP/dup.tsv"
out="$(problems "$TMP/dup.tsv")"
case "$out" in *"docs/bugs is already listed"*) ok "a path listed twice is refused (no ambiguous deletion authority)" ;; *) no "a duplicate listing passed" ;; esac

#!/usr/bin/env bash
# OWNER SIGN-OFF RECORDS (ROADMAP R-0618; owner, 2026-11-08: "when a branch reaches its review-round
# cap, the owner may approve one exact commit SHA after Codex, Kimi and agy have all reviewed it; the
# approval is recorded"). A sign-off is review provenance for that one commit, as a clean
# refs/notes/concrete-review note is (scripts/review/verify.sh); train.sh accepts either for a member.
#
#   signoff.sh record <commit> --base BASE --rounds-at NOTED --date YYYY-MM-DD --quote TEXT
#                     --codex-request FILE --codex FILE --kimi-request FILE --kimi FILE
#                     --agy-request FILE --agy FILE
#   signoff.sh verify <commit> --base BASE
#
# THE RECORD is the ref refs/owner-signoff/<full sha>, a parentless commit whose tree holds exactly
# seven plain files: record.txt and, for each reviewer r in codex, kimi and agy, r-request.txt and
# r.txt. The output is copied byte for byte. The request is copied verbatim after a structured first
# line, `reviewed: <full sha>`, which `record` prepends to attest the commit reviewed. Thus a clone
# that fetches the ref can check what each reviewer was asked and its output separately. record.txt
# is `key: value` lines, each key once:
#   signoff: owner
#   commit: <the 40-hex SHA approved>
#   date: YYYY-MM-DD
#   quote: <the owner's words, verbatim; they name the commit by an unambiguous prefix of 7+ hex digits>
#   rounds-at: <the 40-hex SHA of the commit whose scripts/review/review.sh note records the rounds used>
#   request-codex: codex-request.txt <sha256>
#   verdict-codex: codex.txt <sha256>
#   request-kimi: kimi-request.txt <sha256>
#   verdict-kimi: kimi.txt <sha256>
#   request-agy: agy-request.txt <sha256>
#   verdict-agy: agy.txt <sha256>
# `record` builds the record, verifies it, and only then writes the ref locally; it pushes nothing
# (push the ref to origin: the pre-push hook takes a refs/owner-signoff/* record in its
# no-source-tree tier). Only the owner's recorded words go in a quote.
#
# THE CAP (R-0618) comes from the class of the member's diff against its base, classified by path,
# the highest class present winning: docs and roadmap 2, scripts 3, compiler and spec 5; a path in no
# class counts as compiler and spec. A sign-off qualifies only when the review rounds recorded on the
# member's own commits reach that cap: `rounds-at` must be the commit itself or one of its ancestors
# not on BASE, and carry a well-formed review.sh note (scripts/review/verify.sh: clean, findings or
# blocked) whose round is at least the cap, whatever its verdict
# (the cap counts rounds used: the other reviewers' rejections are why a branch reaches it).
#
# `verify` accepts the record only if the ref exists, the tree holds exactly those seven 100644 blobs,
# every key is present once and well formed, `commit` is the commit asked about, the quote names it,
# the cap was reached, and every file's sha256 is the recorded one. Each request's `reviewed:` line
# must equal the signed commit, and its body must name that commit by an unambiguous prefix of 7+
# hex digits; output mentions do not bind a review to a commit. Each output's last VERDICT line must
# be `VERDICT: ACCEPT`, and an output without one is refused; request lines never count as verdicts.
# The sign-off judges the exact commit and says nothing about any other commit.
#
# Exit codes: 0 a valid sign-off; 1 a sign-off that does not qualify (the reason is printed);
#             2 no sign-off, or a usage error.
set -euo pipefail
PREFIX=refs/owner-signoff
NOTES_REF=refs/notes/concrete-review
REVIEWERS="codex kimi agy"
VERIFY="$(cd "$(dirname "${BASH_SOURCE[0]}")/../review" && pwd)/verify.sh"

usage() { awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"; }
die() { echo "signoff: $*" >&2; exit 2; }
sha256() { if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -d' ' -f1; else shasum -a 256 | cut -d' ' -f1; fi; }

# path_class PATH → docs | scripts | compiler (anything unlisted is compiler: the highest class)
path_class() {
  case "$1" in
    docs/*|changelog.d/*|ROADMAP.md|CHANGELOG.md|README.md|AGENTS.md|CLAUDE.md) echo docs ;;
    scripts/*|.githooks/*|.github/*|.claude/*|required-checks.txt|required-checks-transition.tsv) echo scripts ;;
    *) echo compiler ;;
  esac
}
# names SHA → reads text on stdin; succeeds when a hex word of at least 7 digits in it is an
# unambiguous name of SHA in this repository (git refuses an ambiguous prefix)
names() {
  local w
  for w in $(tr -c '0-9a-f' ' '); do
    [ "${#w}" -ge 7 ] && [ "${1#"$w"}" != "$1" ] && [ "$(git rev-parse -q --verify "$w^{commit}" 2>/dev/null)" = "$1" ] && return 0
  done
  return 1
}
class_cap() { case "$1" in docs) echo 2 ;; scripts) echo 3 ;; *) echo 5 ;; esac; }
# diff_class SHA BASE → the highest class among the paths SHA changes against its merge base with BASE
diff_class() {
  local mb p c best=docs
  mb="$(git merge-base "$2" "$1")" || return 1
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    c="$(path_class "$p")"
    case "$c" in compiler) best=compiler ;; scripts) [ "$best" = compiler ] || best=scripts ;; esac
  done < <(git diff --no-renames --name-only "$mb" "$1")
  echo "$best"
}

    "${run:--}" "$result" "$dur" "$(printf '%s' "${notes:--}" | tr '\t\n' '  ')" >> "$f"
}

state_get_soft() {
  local f; f="$(state_file "$1")"
  [ -f "$f" ] || return 0
  sed -n "s/^$2=//p" "$f" | tail -1
}

# --- toolchain -----------------------------------------------------------------------------------
# The pre-push hook builds the compiler, so pushes and checks run inside the dev shell.
in_nix() { land_in_nix "$@"; }   # scripts/land/lib.sh

run_or_print() { # cmd... — executes, or prints under --dry-run
  if [ "$DRY" = 1 ]; then printf 'train (dry-run): would run:'; printf ' %q' "$@"; echo; return 0; fi
  "$@"
}

remote_main() { git ls-remote "$REMOTE" refs/heads/main | cut -f1; }

# A push whose result is read from the remote, not from git's exit status. GitHub drops the
# connection during a long pre-push hook: the push can fail AFTER the remote ref moved (then it is
# done) or before (then it is retried). Each attempt is a plain push of the exact SHA, so a retry
# to main is still a fast-forward or a refusal, and the hook's retry reuses the validation record
# of the same range. A ref that moved to anything else stops at once. Prints nothing under --dry-run
# except the command.
push_verified() { # remote sha ref [env assignments...]
  local remote="$1" sha="$2" ref="$3"; shift 3
  if [ "$DRY" = 1 ]; then run_or_print env "$@" git push "$remote" "$sha:refs/heads/$ref"; return 0; fi
  local before now attempt=1 max="${LAND_PUSH_ATTEMPTS:-3}" rc
  before="$(git ls-remote "$remote" "refs/heads/$ref" | cut -f1)"
  while :; do
    rc=0
    ( for kv in "$@"; do export "${kv?}"; done; in_nix git push "$remote" "$sha:refs/heads/$ref" ) || rc=$?
    assert_no_op "push to $remote"
    now="$(git ls-remote "$remote" "refs/heads/$ref" | cut -f1)"
    if [ "$now" = "$sha" ]; then
      [ "$rc" = 0 ] || note "push to $remote $ref exited $rc, but $remote/$ref is at ${sha:0:10}: the connection dropped after the update"
      return 0
    fi
    [ "$now" = "$before" ] || die "push to $remote $ref: the ref moved to ${now:0:10}, neither its old value nor ${sha:0:10}; not retrying"
    [ "$attempt" -lt "$max" ] || die "push to $remote $ref failed $attempt time(s) (last exit $rc); $remote/$ref is still ${before:0:10}"
    note "push to $remote $ref exited $rc and the ref did not move; retrying ($attempt of $max)"
    attempt=$((attempt + 1)); sleep "${LAND_PUSH_RETRY_SLEEP:-15}"
  done
}

# The train's state must describe the checkout: same branch, same HEAD, clean.
require_train_checkout() { # name
  local name="$1" head
  head="$(state_get "$name" head)"

