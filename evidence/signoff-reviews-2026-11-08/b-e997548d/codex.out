                    and not line.strip().strip(fence[0]):
                fence = None
            out.append(" " * len(line))
        else:
            out.append(line)
    return COMMENT.sub(_spaces, "\n".join(out))


def blank_code(text):
    """blank_blocks, and code spans blanked too (a span may cross lines within a paragraph)."""
    return CODE_SPAN.sub(_spaces, blank_blocks(text))


