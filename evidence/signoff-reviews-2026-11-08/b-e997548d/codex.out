scripts/checks/doc_links.sh
#!/usr/bin/env bash
# Markdown-link gate: every local link in the repository's Markdown names a path that exists and,
# into a Markdown file, a heading or explicit id that exists (scripts/checks/lib/doc_links.py holds
# the rules: GitHub slugs, duplicate-heading suffixes, root-relative changelog.d/ fragments).
#
# WHY A GATE AND NOT A MAKE TARGET. The checker used to be a Makefile target only, reached by
# nothing in CI or the pre-push selection, and it checked the path of `file.md#anchor` and dropped
# the anchor. Links to headings renamed or moved to another file passed, and it resolved changelog.d/
# fragments against changelog.d/ although they are folded into the root CHANGELOG.md, so a correct
# fragment link read as broken. Nobody saw either, because nothing ran it (bug 252).
#
# The controls below run the same checker on throwaway trees, so a checker that accepts everything,
# skips anchors, or resolves fragments against the wrong directory fails here before the real run.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"
CHECK="scripts/checks/lib/doc_links.py"
[ -f "$CHECK" ] || { echo "FATAL: $CHECK missing" >&2; exit 2; }

PASS=0; FAIL=0; INCOMPLETE=0
ok(){ echo "  ok   $1"; PASS=$((PASS+1)); }
no(){ echo "  FAIL $1"; FAIL=$((FAIL+1)); }
inc(){ echo "  INCOMPLETE $1"; INCOMPLETE=$((INCOMPLETE+1)); }
TMP="$(mktemp -d)" || { echo "FATAL: mktemp failed" >&2; exit 2; }
trap 'rm -rf "$TMP"' EXIT
BOUNDED_PARENT="$TMP"
source "$ROOT_DIR/scripts/checks/lib/bounded.sh"

# tree NAME: a fresh control tree with a target document carrying the anchors the controls use.
tree() {
  rm -rf "${TMP:?}/$1"; mkdir -p "$TMP/$1/docs" "$TMP/$1/changelog.d"
  cat > "$TMP/$1/docs/TARGET.md" <<'EOF'
# Target

## Phase 9: the `ledger` & its *views*

## Repeated

## Repeated

## A literal _ and __init__ and **bold**

<a id="REF-3"></a>

scripts/checks/issues.sh
#!/usr/bin/env bash
# THE MINIMAL ISSUE RECORD IS WELL-FORMED (P12).
#
# ISSUES.tsv holds spec, proof, launcher, CI and migration defects from day one, before the bug
# ledger returns with slice 1. A record nobody can parse or sort is not a record, so this gate holds
# it to its header: the exact column list; ids ISS-NNNN, unique and increasing; ISO dates; the area,
# severity and status vocabularies; no empty field (evidence, owner and the closure condition are
# what make an issue actionable). Each rule has a negative control against a mutated copy.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR" || exit 2
[ -f ISSUES.tsv ] || { echo "FATAL: ISSUES.tsv missing" >&2; exit 2; }
TMP="$(mktemp -d)" || exit 2
trap 'rm -rf "$TMP"' EXIT
PASS=0; FAIL=0
ok(){ echo "  ok   $1"; PASS=$((PASS+1)); }
no(){ echo "  FAIL $1"; FAIL=$((FAIL+1)); }
problems(){ python3 -I -c '
import re, sys
HDR = ["id", "date", "area", "evidence", "owner", "severity", "closure_condition", "status"]
AREA = {"spec", "proof", "compiler", "launcher", "ci", "migration"}
SEV = {"high", "medium", "low"}; STATUS = {"open", "closed"}
lines = [l.rstrip("\n") for l in open(sys.argv[1]) if not l.startswith("#") and l.strip()]
if not lines or lines[0].split("\t") != HDR:
    print("header is not: " + "\t".join(HDR)); sys.exit(0)
last = 0
for n, l in enumerate(lines[1:], 2):
    f = l.split("\t")
    if len(f) != len(HDR) or any(not x.strip() for x in f):
        print(f"row {n}: needs {len(HDR)} non-empty tab-separated fields"); continue
    m = re.fullmatch(r"ISS-(\d{4})", f[0])
    if not m: print(f"row {n}: id {f[0]!r} is not ISS-NNNN")
    elif int(m.group(1)) <= last: print(f"row {n}: id {f[0]} is not greater than the previous id")
    else: last = int(m.group(1))
    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", f[1]): print(f"row {n}: date {f[1]!r} is not YYYY-MM-DD")
    if f[2] not in AREA: print(f"row {n}: area {f[2]!r} is not one of {sorted(AREA)}")
    if f[5] not in SEV: print(f"row {n}: severity {f[5]!r} is not one of {sorted(SEV)}")
    if f[7] not in STATUS: print(f"row {n}: status {f[7]!r} is not one of {sorted(STATUS)}")
' "$1"; }

echo "=== ISSUES.tsv ==="
out="$(problems ISSUES.tsv)"
[ -z "$out" ] && ok "ISSUES.tsv is well-formed ($(grep -c '^ISS-' ISSUES.tsv) issues, $(grep -c $'\topen$' ISSUES.tsv) open)" \
  || { no "ISSUES.tsv has problems"; echo "$out" | sed 's/^/      /'; }
scripts/checks/landing_ready.sh
#!/usr/bin/env bash
# READINESS AND THE TRAIN'S REMOTE LEG, AGAINST A THROWAWAY REPOSITORY.
#
# Each leg drives the real scripts/land/ready.sh and train.sh against bare-repo remotes, a fake `gh`
# whose CI is red exactly when the candidate contains a file named CIRED, a fake remote runner, and a
# fake pre-push hook that fails exactly when the checkout contains a file named BAD. Nothing here
# touches this repository.
#
#   remote leg  train.sh check never adopts an existing ref at the candidate's SHA for its remote run
#   bisect --ci a CI-red member is named, each probe dispatching its own run, and nothing lands
#   ready.sh    its legs run; any failed leg, the review included, publishes `gates: fail` and revokes
#               readiness over an older clean verdict; passing legs publish `gates: pass`
#   main        no script under scripts/land force-pushes main
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
NOTES="$ROOT_DIR/scripts/land/notes.sh"
[ -f "$NOTES" ] || { echo "FATAL: scripts/land/notes.sh missing" >&2; exit 2; }
TMP="$(mktemp -d)" || { echo "FATAL: could not create a sandbox directory" >&2; exit 2; }
[ -n "$TMP" ] && [ -d "$TMP" ] || { echo "FATAL: sandbox directory is not usable" >&2; exit 2; }
trap 'rm -rf "$TMP"' EXIT
PASS=0; FAIL=0
ok(){ echo "  ok   $1"; PASS=$((PASS+1)); }
no(){ echo "  FAIL $1"; FAIL=$((FAIL+1)); }
has(){ case "$1" in *"$2"*) return 0 ;; esac; return 1; }

source "$ROOT_DIR/scripts/checks/lib/git_sandbox.sh" || exit 2
git_sandbox "$TMP/gitconfig" || exit 2
cat > "$GIT_CONFIG_GLOBAL" <<EOF
[user]
	name = landing gate
	email = gate@example.invalid
[init]
	defaultBranch = main
[core]
	hooksPath = $TMP/nohooks
EOF
mkdir -p "$TMP/nohooks" "$TMP/gh"
# train.sh runs only with the repository's pre-push hook enabled (ISS-0015): it asks the hook git
# would run who it is (its single argument --concrete-identify). The sandbox's global hooksPath holds this
# stand-in, which runs no gate and answers as the repository's .githooks/pre-push would: a test
# fixture impersonating the hook on purpose.
IDENTIFY='[ "$#" = 1 ] && [ "$1" = --concrete-identify ] && { echo "concrete-pre-push $(cd "$(git rev-parse --show-toplevel)" && pwd -P)/.githooks/pre-push"; exit 0; }'
standin_hook() {
  printf '#!/usr/bin/env bash\n%s\nexit 0\n' "$IDENTIFY" > "$TMP/nohooks/pre-push"
scripts/checks/landing_script.sh
#!/usr/bin/env bash
# THE LANDING SCRIPT RESOLVES ONLY WHAT IS MECHANICAL AND REFUSES EVERYTHING ELSE (R-0539).
#
# scripts/land/train.sh builds one integrated candidate from several branches and lands it. The
# hand-run version of that job, on 2026-10-22, made the mistakes this gate pins down: a rebase piped
# to `tail` kept going and a commit was made mid-rebase; union-merged ledgers kept stale entries
# (two OPEN corpus entries for fixed bugs); and candidates were pushed without checking that the CI
# result described them. Each leg below drives the real script against a THROWAWAY repository with
# bare-repo remotes and a fake `gh`, so nothing here can touch this repository, its remotes or CI.
#
#   resolution  generated views (a ROADMAP generated block, a whole generated file) are regenerated,
#               ledgers are union-merged; the train carries both members' entries
#   refusal     a conflict in source or in prose outside a generated block aborts the merge (no
#               MERGE_HEAD left, exit 3); a union that duplicates a corpus key is refused; a
#               merge or rebase already in progress, a dirty tree and an existing train are refused
#   pipeline    check feeds the hook exactly base..head on ci/<name>; ci pushes and records the run
#   watch       a campaign-only failure is reported as such; a landing failure fetches log tails
#   land        refused on a head-SHA mismatch, a red landing job, a moved main, a remote named fork;
#               dry-run pushes nothing; a real land with no lambdaclass remote pushes origin exactly
#               once and no second remote, and cancels no run (main's own run records the train's, R-0570)
#   record      (2026-11-06, R-0570) main's run names the run that qualified its exact SHA only when
#               the newest completed dispatch of the CI workflow at that SHA AND at that base (its
#               title, from the base input train.sh ci passes) passed every landing-tier and required
#               job and the head is ahead of the base; a missing run, a run at another SHA or base, of
#               another workflow or event, unfinished or excluded, a skipped,
#               cancelled or failed job, an older green run behind a newer red one, a diverged or
#               absent base: no record. The workflow gates every job on it (structure check)
#   dropped     (2026-10-25) a push that fails before the remote moved is retried; one that fails
#               after it moved is accepted from ls-remote; exhausted retries fail and move nothing
#   bisect      halving finds a seeded red member
#   report      the median time to land is computed from the log
#   gate host   (2026-11-05) check's impact leg on the gate host: bound to the train head's SHA (a
#               run at another SHA, an unreachable host or a lost log is INCOMPLETE and blocks; only
#               --local-gates runs here); the hook reuses the attestation only for this exact push, and
#               a tampered log or attestation is refused
#   review      (2026-11-06) review fails closed: check with no review command fails; a reviewer that
#               exits 0 but leaves no note, a malformed, blocked or findings note fails the leg; check
#               skips the reviewer when every member is reviewed clean; land requires a clean head
#               note, or (head unreviewed) a clean note on every member, and refuses an absent,
#               malformed, blocked or findings note in either place
#   required    (2026-11-04) a required job (required-checks.txt) that is missing, skipped or
#               cancelled refuses watch and land; a candidate drops a requirement main imposes only
#               through a transition row (replaced by jobs it requires and that pass, or retired with
#               a reason and reported as retired); the file names the workflow's landing-tier jobs
set -uo pipefail
scripts/checks/legacy_frozen.sh
#!/usr/bin/env bash
# legacy/ IS FROZEN (ROADMAP R-0558, R-0562).
#
# legacy/ is a byte-for-byte copy of main's tree at the move's base commit. scripts/checks/legacy.lock
# records that commit and its tree. This check holds three things:
#   1. the recorded tree is the recorded commit's tree (legacy/ is that snapshot, nothing else);
#   2. HEAD:legacy differs from it only by deletions: an added or modified path is refused;
#   3. each deleted path is covered by at least one RETENTION.tsv row, and every row covering it
#      (its own path or an ancestor directory) has `status` = `resolved` (the row's deletion
#      criterion holds): a resolved parent never releases a child with its own unresolved row.
#      Until RETENTION.tsv has a status column, every deletion is refused.
# Negative controls run the same judgment on synthetic trees first, so a judge that accepts
# everything fails here before the real check.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"
LOCK=scripts/checks/legacy.lock
PASS=0; FAIL=0
ok(){ echo "  ok   $1"; PASS=$((PASS+1)); }
no(){ echo "  FAIL $1"; FAIL=$((FAIL+1)); }

# judge FROZEN_TREE CURRENT_TREE RETENTION_FILE (in the current repository): prints one problem per line.
judge() {
  local frozen="$1" cur="$2" ret="$3"
  [ "$frozen" = "$cur" ] && return 0
  git diff-tree -r --no-renames --name-status "$frozen" "$cur" | python3 -I -c '
import sys
ret = sys.argv[1]
rows = [l.rstrip("\n").split("\t") for l in open(ret) if l.strip() and not l.startswith("#")]
hdr, rows = rows[0], rows[1:]
# (path, resolved?) for every path a row names. With no status column, nothing is resolved.
named = []
if "path" in hdr:
    pi = hdr.index("path"); si = hdr.index("status") if "status" in hdr else None
    for r in rows:
        res = si is not None and len(r) > si and r[si].strip() == "resolved"
        named += [(p.rstrip("/"), res) for p in r[pi].split()]
def ok(p):
    # Every row covering p (its own path or an ancestor) must be resolved, and at least one must:
    # a resolved parent does not release a child that has its own unresolved row.
    cover = [res for n, res in named if p == n or p.startswith(n + "/")]
    return bool(cover) and all(cover)
for line in sys.stdin:
    st, path = line.rstrip("\n").split("\t", 1)
scripts/checks/oracle_fetch.sh
#!/usr/bin/env bash
# A RUNNER WITHOUT A VERIFIED ORACLE NEVER PASSES THE ORACLE CHECK (ISS-0005, P13; ROADMAP R-0564).
#
# scripts/oracle/ci_check.sh is the required oracle job on GitHub-hosted runners: fetch.sh downloads
# the published artifact and verifies it, then run.sh runs smoke.con through it. This gate runs the
# real fetch.sh, run.sh and ci_check.sh on a scratch copy of scripts/oracle with a test lock, a test
# artifact built with the real packer (lib.sh oracle_pack) and a fake `curl` (no network), and holds
# them to: a good artifact installs and verifies (positive control); a lock with no published
# artifact, a failed download, an artifact with other bytes, and an artifact whose install fails
# verification (manifest not the locked one) each leave fetch.sh and ci_check.sh INCOMPLETE (exit 3),
# never passed; an installed oracle whose files were altered is refused by run.sh (125) before
# anything runs, and ci_check.sh reports that as INCOMPLETE (an install altered after fetch.sh); a verified oracle whose smoke run exits
# other than 42, a compile failure (whatever its status, 42 included) and a compile that writes no
# program are FAILED (1), through the real run.sh with a fake `nix`. Each refusal is a negative
# control with its expected reason.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR" || exit 2
for f in fetch.sh run.sh ci_check.sh lib.sh smoke.con; do
  [ -f "scripts/oracle/$f" ] || { echo "FATAL: scripts/oracle/$f missing" >&2; exit 2; }
done
TMP="$(mktemp -d)" || exit 2
trap 'rm -rf "$TMP"' EXIT
PASS=0; FAIL=0
ok(){ echo "  ok   $1"; PASS=$((PASS+1)); }
no(){ echo "  FAIL $1"; FAIL=$((FAIL+1)); }
has(){ case "$1" in *"$2"*) return 0;; esac; return 1; }

COMMIT=1111111111111111111111111111111111111111
mkdir -p "$TMP/oracle" "$TMP/bin" "$TMP/art"
cp scripts/oracle/fetch.sh scripts/oracle/run.sh scripts/oracle/ci_check.sh scripts/oracle/lib.sh \
   scripts/oracle/smoke.con "$TMP/oracle/"
# shellcheck source=scripts/oracle/lib.sh
. "$TMP/oracle/lib.sh"

# A test artifact in the real format: bin/concrete, std/, shell/, MANIFEST.sha256 (oracle_pack).
stage() {  # stage DIR BINARY_TEXT
  mkdir -p "$1/bin" "$1/std" "$1/shell"
  printf '#!/bin/sh\n# %s\nexit 0\n' "$2" > "$1/bin/concrete"; chmod +x "$1/bin/concrete"
  printf 'mod std;\n' > "$1/std/lib.con"
  printf '{ }\n' > "$1/shell/flake.nix"; printf '{}\n' > "$1/shell/flake.lock"
  printf 'leanprover/lean4:v4.34.1\n' > "$1/shell/lean-toolchain"
}
stage "$TMP/good" "the test oracle"
scripts/checks/retention_manifest.sh
#!/usr/bin/env bash
# THE RETENTION MANIFEST GIVES EVERY TRACKED FILE EXACTLY ONE GOVERNING ROW (R-0562; P6, P21).
#
# RETENTION.tsv is written before the legacy/ move so that the move, and later deletions under
# legacy/, cannot drop a corpus, a ledger, the site or an archived service by omission. This gate
# holds it to that, through scripts/land/retention.py (the one owner of the rule): the header is
# exact; every row has six non-empty fields and one of the four dispositions; no path is listed
# twice (so a specific row inside a broad one governs unambiguously, by longest prefix); and every
# tracked file of the tree has a governing row. Each leg has a negative control against a mutated
# copy, so the gate cannot pass by checking nothing.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR" || exit 2
[ -f RETENTION.tsv ] || { echo "FATAL: RETENTION.tsv missing" >&2; exit 2; }
RP="scripts/land/retention.py"
TMP="$(mktemp -d)" || exit 2
trap 'rm -rf "$TMP"' EXIT
PASS=0; FAIL=0
ok(){ echo "  ok   $1"; PASS=$((PASS+1)); }
no(){ echo "  FAIL $1"; FAIL=$((FAIL+1)); }
files="$( { git ls-files; echo RETENTION.tsv; } | LC_ALL=C sort -u)"
problems(){ printf '%s\n' "$files" | python3 -I "$RP" check "$1"; }
govern(){ printf '%s\n' "$2" | python3 -I "$RP" govern "$1" | cut -f3; }

echo "=== RETENTION.tsv governs the tree ==="
out="$(problems RETENTION.tsv)"
[ -z "$out" ] && ok "every tracked file ($(printf '%s\n' "$files" | wc -l | tr -d ' ')) has exactly one governing row" \
  || { no "RETENTION.tsv has problems"; echo "$out" | head -20 | sed 's/^/      /'; }
# Precedence: specific rows inside broad ones govern their own paths.
[ "$(govern RETENTION.tsv docs/decisions.md)" = retained ] && [ "$(govern RETENTION.tsv docs/spec/types.md)" = archived ] \
  && [ "$(govern RETENTION.tsv docs/README.md)" = archived ] && [ "$(govern RETENTION.tsv tests/fixtures/fuzz_farm/findings/x)" = migrate ] \
  && ok "the longest listed prefix governs (decisions.md retained inside archived docs/spec; fuzz findings migrate)" \
  || no "precedence: decisions.md=$(govern RETENTION.tsv docs/decisions.md) types.md=$(govern RETENTION.tsv docs/spec/types.md)"

echo "=== negative controls ==="
out="$( { printf '%s\n' "$files"; echo new-top-level-thing; echo docs/new/deep/file.md; } | python3 -I "$RP" check RETENTION.tsv)"
case "$out" in *"no row governs new-top-level-thing"*) ok "an ungoverned path is refused" ;; *) no "an ungoverned path passed" ;; esac
awk 'BEGIN{FS=OFS="\t"} !/^#/ && $1!="path" && $3=="migrate" && !done {$3="keep-forever"; done=1} {print}' RETENTION.tsv > "$TMP/bad-disp.tsv"
out="$(problems "$TMP/bad-disp.tsv")"
case "$out" in *"keep-forever"*) ok "an unknown disposition is refused" ;; *) no "an unknown disposition passed" ;; esac
awk 'BEGIN{FS=OFS="\t"} !/^#/ && $1!="path" && !done {$6=""; done=1} {print}' RETENTION.tsv > "$TMP/bad-crit.tsv"
out="$(problems "$TMP/bad-crit.tsv")"
case "$out" in *"non-empty tab-separated"*) ok "an empty deletion criterion is refused" ;; *) no "an empty deletion criterion passed" ;; esac
awk -F'\t' '$1 != "std"' RETENTION.tsv > "$TMP/no-std.tsv"
scripts/checks/review_tool.sh
#!/usr/bin/env bash
# R-0544 — the review tool (scripts/review/review.sh, verify.sh, split_diff.py)
# does what docs/REVIEW.md says it does.
#
# No API key is needed: the reviewer is a fake `codex` that answers according to
# MARK_* markers on the ADDED lines of the diff it receives on stdin, and logs
# every call (prompt kind, stdin size, files) so the legs can check what was sent.
# All git work happens in throwaway repositories with a bare repository as
# `origin`, so the notes push, including the non-fast-forward path, runs for real.
#
# Legs: verdict parsing, note writing and its exact format, notes push and the
# non-fast-forward merge, delta selection (round 2 sees only the delta and the
# previous findings), splitting (file groups, size limit, hunk split, --pieces N),
# the content-filter refusal retry (once, neutral, smaller, then `blocked`), the
# round cap (distinct exit code, no extra round), verify.sh, and the pre-push
# hook's review-notes tier (a notes-only push runs no gates).

set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
REVIEW="$ROOT_DIR/scripts/review/review.sh"
VERIFY="$ROOT_DIR/scripts/review/verify.sh"
SPLIT="$ROOT_DIR/scripts/review/split_diff.py"

PASS=0
FAIL=0
ok() { echo "  ok   $1"; PASS=$((PASS+1)); }
no() { echo "  FAIL $1"; FAIL=$((FAIL+1)); }
check() { # check <label> <command...>: the command must succeed
  local label="$1"; shift
  if "$@"; then ok "$label"; else no "$label"; fi
}

T="$(mktemp -d)"
trap 'rm -rf "$T"' EXIT

# Isolate git from the caller's repository (a hook exports GIT_DIR; ISS-0015) and from the user's
# config (hooks, signing, identity).
source "$ROOT_DIR/scripts/checks/lib/git_sandbox.sh" || exit 2
git_sandbox "$T/gitconfig" || exit 2
cat >"$GIT_CONFIG_GLOBAL" <<'EOF'
[user]
	name = Review Gate
	email = review-gate@example.invalid
[init]
scripts/checks/root_inventory.sh
#!/usr/bin/env bash
# THE ROOT HOLDS ONLY THE DAY-ONE SET (ROADMAP R-0558). Every tracked top-level entry, and every
# first-level entry under docs/ and scripts/, must be listed in scripts/checks/root_inventory.txt,
# and every listed entry must exist. A negative control runs the same judgment on a synthetic
# listing first.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"
LIST=scripts/checks/root_inventory.txt
PASS=0; FAIL=0
ok(){ echo "  ok   $1"; PASS=$((PASS+1)); }
no(){ echo "  FAIL $1"; FAIL=$((FAIL+1)); }

# judge LIST: reads tracked paths on stdin, prints one problem per line.
judge() {
  python3 -I -c '
import sys
want = {l.strip() for l in open(sys.argv[1]) if l.strip() and not l.startswith("#")}
have = set()
for p in (l.rstrip("\n") for l in sys.stdin):
    if not p: continue
    parts = p.split("/")
    have.add(parts[0])
    if parts[0] in ("docs", "scripts") and len(parts) > 1:
        have.add(parts[0] + "/" + parts[1])
for e in sorted(have - want): print("not in the day-one set: " + e)
for e in sorted(want - have): print("listed but missing: " + e)
' "$1"
}

echo "=== negative controls ==="
TMP="$(mktemp -d)" || exit 2
trap 'rm -rf "$TMP"' EXIT
printf 'a\nb\ndocs\ndocs/x.md\n' > "$TMP/list"
[ -z "$(printf 'a\nb/c\ndocs/x.md\n' | judge "$TMP/list")" ] && ok "control: exactly the listed set passes" || no "control: listed set refused"
[ -n "$(printf 'a\nb/c\ndocs/x.md\nstray\n' | judge "$TMP/list")" ] && ok "control: an unlisted top-level entry is refused" || no "control: stray accepted"
[ -n "$(printf 'a\nb/c\ndocs/x.md\ndocs/y.md\n' | judge "$TMP/list")" ] && ok "control: an unlisted docs/ entry is refused" || no "control: docs stray accepted"
[ -n "$(printf 'a\ndocs/x.md\n' | judge "$TMP/list")" ] && ok "control: a missing listed entry is refused" || no "control: missing accepted"

echo "=== the tracked root against $LIST ==="
[ -f "$LIST" ] || { no "$LIST is missing"; echo "root_inventory: PASS=$PASS FAIL=$FAIL"; exit 1; }
out="$(git ls-files --cached | judge "$LIST")"
[ -z "$out" ] && ok "the root holds exactly the day-one set" || { no "the root differs from the day-one set:"; echo "$out" | sed 's/^/      /'; }
echo "root_inventory: PASS=$PASS FAIL=$FAIL"
scripts/checks/run.sh
#!/usr/bin/env bash
# Every root check, in order; the one entry point the pre-push hook, CI's "Root checks" job and the
# landing tools (scripts/land/train.sh, ready.sh: LAND_FULL_GATES_CMD) run.
#
# The set is every scripts/checks/*.sh except this file, so a new check cannot be written and then
# forgotten here. REQUIRED names the checks that must exist: deleting one fails the run instead of
# shrinking it. Each check runs to completion; the run fails if any check failed.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"
REQUIRED="legacy_frozen root_inventory workflow_yaml doc_links landing_script landing_ready review_tool sandbox_isolation retention_manifest issues oracle_fetch"
missing=""
for c in $REQUIRED; do [ -f "scripts/checks/$c.sh" ] || missing="$missing $c"; done
[ -z "$missing" ] || { echo "run.sh: required check(s) missing:$missing" >&2; exit 1; }
failed="" n=0
for f in scripts/checks/*.sh; do
  [ "$f" = scripts/checks/run.sh ] && continue
  n=$((n+1))
  echo "=== $f ==="
  s="$(date +%s)"
  if bash "$f"; then echo "--- $f: pass ($(( $(date +%s) - s ))s)"
  else echo "--- $f: FAIL ($(( $(date +%s) - s ))s)"; failed="$failed ${f##*/}"; fi
done
echo
if [ -n "$failed" ]; then echo "root checks: FAILED:$failed (of $n)"; exit 1; fi
echo "root checks: all $n pass"
scripts/checks/sandbox_isolation.sh
#!/usr/bin/env bash
# SANDBOXES NEVER TOUCH THE CALLER'S REPOSITORY (ISS-0015).
#
# A pre-push hook of a linked worktree runs with GIT_DIR=<repo>/.git/worktrees/<name> exported. On
# 2026-11-06 review_tool.sh, run that way, did its sandbox work in the caller's clone and pushed 28 +
# 12 test notes to GitHub. The owner of the fix is the sandbox helper, scripts/checks/lib/
# git_sandbox.sh, which unsets every variable `git rev-parse --local-env-vars` names.
#
# Legs:
#   structural  every script under scripts/ that makes a repository
#               (git init, git clone, git worktree add) sources the helper and calls git_sandbox.
#   live        a throwaway CALLER (bare upstream, full clone, linked worktree; no hook installed
#               anywhere) runs review_tool.sh and legacy_frozen.sh, at this checkout's version, from
#               the linked worktree with GIT_DIR exported exactly as a hook sees it. The caller's
#               refs (refs/notes/* included), core.bare, worktree HEAD and its upstream's refs must be
#               byte-for-byte unchanged.
#   control     the same harness around a script that writes through an inherited GIT_DIR (as the
#               unfixed review_tool.sh did) must report the change, so the live leg cannot pass by
#               not looking.
#
# Every run is bounded in time (120 s per attempt, bounded_run) and in aggregate: a systemd user
# scope with TasksMax=512 and MemoryMax=8G (fede-256gb, concrete-ci-2 logins), or, where there is
# none (a CI runner service), the cgroup the check already runs in when it has a finite memory.max
# (concrete-ci-2's runners: 28G per runner) plus `ulimit -u` of 512 more processes. With neither, the
# live probes do not run and the check fails as INCOMPLETE: never an unbounded run. macOS has
# neither (no unprivileged aggregate memory limit), so there the root checks are INCOMPLETE by design
# and a gated push from a macOS clone is refused: gated pushes (trains) are made from a Linux clone
# with a bound (fede-256gb or concrete-ci-2; no laptop builds), and CI runs on bounded runners. The 2026-11-06
# reproducer had no such bound, recursed through a test hook and exhausted the machine.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR" || exit 2
HELPER="scripts/checks/lib/git_sandbox.sh"
[ -f "$HELPER" ] || { echo "FATAL: $HELPER missing" >&2; exit 2; }
PASS=0; FAIL=0
ok(){ echo "  ok   $1"; PASS=$((PASS+1)); }
no(){ echo "  FAIL $1"; FAIL=$((FAIL+1)); }

echo "=== structural: every repository-making script sources the sandbox helper ==="
# One exception, not a sandbox: worktree-new.sh makes a worktree OF the caller's repository by design.
EXEMPT=" scripts/worktree-new.sh "
MAKES='git( -C [^ ]+)? (init|clone)\b|worktree add'
# shell_scripts DIR: every shell script under DIR/scripts at ANY depth, as paths relative to DIR,
# sorted: a `*.sh` file, or any other file whose first line is a sh/bash shebang. (Until 2026-11-08
scripts/checks/workflow_yaml.sh
#!/usr/bin/env bash
# Workflow-YAML gate.
#
# GitHub Actions workflows that fail to PARSE do not run at all — they report a
# 0-second "completed failure" with no logs, so every gate they were supposed to
# run is silently skipped. This actually happened: a `name:` value that began
# with a backtick (`` ` `` is a reserved YAML indicator and cannot start a plain
# scalar) killed `lean_action_ci.yml` for 40+ consecutive pushes without any
# obvious signal. This gate parses every workflow locally so a malformed file is
# caught before it is pushed, not after CI has been dark for days.
#
# Uses python3+PyYAML if available, otherwise ruby's psych (both ship the parser
# GitHub uses closely enough to catch indicator/indentation errors).

set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate_env.sh" || exit 2
# Per-run scratch (R-0546): a fixed /tmp path collides with a concurrent run of this gate.
GATE_TMP="$(mktemp -d)"; trap 'rm -rf "$GATE_TMP"' EXIT
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"

WF_DIR=".github/workflows"
[ -d "$WF_DIR" ] || { echo "no $WF_DIR — nothing to check"; exit 0; }

parse_one() {
  local f="$1"
  if python3 -c 'import yaml,sys; yaml.safe_load(open(sys.argv[1]))' "$f" 2>"$GATE_TMP/wfyaml.err"; then
    return 0
  fi
  # python3 missing PyYAML (ModuleNotFoundError) → fall back to ruby
  if grep -q "No module named 'yaml'" "$GATE_TMP/wfyaml.err" 2>/dev/null; then
    ruby -ryaml -e "YAML.load_file(ARGV[0])" "$f" 2>"$GATE_TMP/wfyaml.err"
    return $?
  fi
  return 1
}

PASS=0; FAIL=0
for f in "$WF_DIR"/*.yml "$WF_DIR"/*.yaml; do
  [ -e "$f" ] || continue
  if parse_one "$f"; then
    echo "  ok   $f"; PASS=$((PASS+1))
  else
    echo "  FAIL $f"; sed 's/^/         /' "$GATE_TMP/wfyaml.err" | head -4; FAIL=$((FAIL+1))
  fi

exec
