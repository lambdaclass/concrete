// COUNTEREXAMPLE FIXTURE — this program is NOT correct, and that is the point.
//
// H23 in docs/verification/KNOWN_HOLES.md. `bad` indexes a 4-element array with a counter
// running to 99. The array-bounds obligation nevertheless reports
//
//     [lam.bad#bounds0]  array_bounds  ->  proved_by_kernel_decision (omega)
//     with --all-provers:               ->  proved_by_multi_kernel (3: lean, rocq, isabelle)
//
// because it is allowed to ASSUME the loop invariant `0 <= i && i <= 3`, whose
// own preservation VC in the SAME report reads
//
//     [lam.bad@6#O2]  invariant_preservation  ->  unproven
//
// Nothing composes those two statuses, so an unproven assumption launders into a
// proved conclusion. Three kernels across two logics agree — on a vacuous goal.
//
// The compiled binary aborts (SIGABRT) on the access that was reported proved;
// the runtime bounds check is what actually saves the program.
//
// Owned by R-0461. When the status-composition rule lands, `bounds0` must read as
// conditional on the invariant (or `unproven`), and a gate over this file must
// assert that it is NOT reported proved.
mod lam {
    pub fn bad(a: [i32; 4]) -> i32 {
        let mut s: i32 = 0;
        #[invariant(0 <= i && i <= 3)]
        #[variant(100 - i)]
        for (let mut i: i32 = 0; i < 100; i = i + 1) {
            s = s + a[i];
        }
        return s;
    }
}

pub fn main() with(Std) -> Int {
    let arr: [i32; 4] = [1, 2, 3, 4];
    let r: i32 = lam::bad(arr);
    return 0;
}
