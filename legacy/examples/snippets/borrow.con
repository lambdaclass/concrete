mod Example {
    // (This snippet used to read its input from a `main(argc: i64)` parameter.
    // `main` takes no parameters -- the wrapper calls it with none -- so the
    // input is a local now; see docs/bugs/111 for why that form misbehaved.)
    fn main() -> i64 {
        let x: i64 = 3;
        return references(x) + dereference(&x);
    }

    fn dereference(a: &i64) -> i64 {
        return *a;
    }

    // A reference exists as a call argument or parameter, never as a `let` (exit 2i REF-6@1).
    fn references(a: i64) -> i64 {
        let x: i64 = a;
        return dereference(&x);
    }
}
