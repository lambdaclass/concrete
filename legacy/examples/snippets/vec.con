mod vec {
    extern fn malloc(size: u64) with(Alloc) -> *mut u8;
    extern fn realloc(ptr: *mut u8, size: u64) with(Alloc) -> *mut u8;
    extern fn free(ptr: *mut u8) with(Alloc);

    #[intrinsic = "sizeof"]
    trusted fn sizeof<T>() -> u64;

    // A user-level generic vector over raw memory (the language's own Vec is a
    // builtin; this one shows generic impls, intrinsics and pointer arithmetic).
    struct MyVec<T> {
        ptr: *mut T,
        len: u64,
        cap: u64,
    }

    impl<T> MyVec<T> {
        pub fn new() with(Alloc, Unsafe) -> MyVec<T> {
            let vec: MyVec<T> = MyVec::<T> {
                ptr: malloc(sizeof::<T>() * 32) as *mut T,
                len: 0,
                cap: 32,
            };
            return vec;
        }

        pub fn push(&mut self, value: T) with(Alloc, Unsafe) {
            let type_size: u64 = sizeof::<T>();

            if self.len >= self.cap {
                let new_cap: u64 = self.cap * 2;
                self.ptr = realloc(self.ptr as *mut u8, type_size * new_cap) as *mut T;
                self.cap = new_cap;
            }

            let target_ptr: *mut T = (self.ptr + self.len) as *mut T;
            *target_ptr = value;
            self.len = self.len + 1;
        }

        // The buffer is linear: releasing it consumes the vector.
        pub fn free(self) with(Alloc, Unsafe) {
            let MyVec { ptr, len, cap } = self;
            free(ptr as *mut u8);
        }
    }

    impl<T: Copy> MyVec<T> {
        // References never leave a function, so an element is read out by value.
        pub fn get(&self, at: u64) with(Unsafe) -> T {
            // todo: bounds check
            let target_ptr: *mut T = self.ptr + at;
            return *target_ptr;
        }
    }

    fn main() with(Alloc, Unsafe) -> i32 {
        let mut vec: MyVec<i32> = MyVec::<i32>::new();

        vec.push(2);
        vec.push(3);
        vec.push(4);
        vec.push(5);
        let pushed: i32 = vec.get(2);
        vec.free();

        return pushed;
    }
}
