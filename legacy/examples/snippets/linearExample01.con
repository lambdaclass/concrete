mod LinearExampleStub {

	struct Linear {
	    x: i32,
	    y: i32,
	}
	
	fn main() -> i32 {
		let mut xy: Linear = 
                    Linear {
                        x: 1,
                        y: 0,
                    };
		// linear value is written/consumed
		xy.x = xy.x + 1;
		// the linear value must be consumed before main returns:
		// destructuring it is that consumption.
		let Linear { x, y } = xy;
		return x;
	}				
}