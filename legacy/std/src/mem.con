mod mem {
    // `trusted`, because a BODY-LESS declaration is typed as an extern, and
    // `externFnRequiredCaps` charges an untrusted extern `Unsafe`. These two have no
    // foreign symbol to vouch for — the compiler answers them at compile time from a
    // type — so charging `Unsafe` for a size query would be an artifact of how they are
    // spelled, not a fact about what they do.
    //
    // It surfaced only when the sibling-submodule signature repair (R-0484, 2026-09-20)
    // made cross-module requirements bind at all: `check_std_compiled_coverage.sh`
    // compiles one probe per std module with the full `Std` capability set, which by
    // construction excludes `Unsafe`, and the `mem` probe stopped compiling.
    #[intrinsic = "sizeof"]
    pub trusted fn sizeof<T>() -> u64;

    #[intrinsic = "alignof"]
    pub trusted fn alignof<T>() -> u64;

    #[test]
    fn test_size() -> i32 {
        if sizeof::<i8>() != 1 { return 1; }
        if sizeof::<i16>() != 2 { return 1; }
        if sizeof::<i32>() != 4 { return 1; }
        if sizeof::<i64>() != 8 { return 1; }
        if sizeof::<u8>() != 1 { return 1; }
        if sizeof::<u16>() != 2 { return 1; }
        if sizeof::<u32>() != 4 { return 1; }
        if sizeof::<u64>() != 8 { return 1; }
        if sizeof::<f32>() != 4 { return 1; }
        if sizeof::<f64>() != 8 { return 1; }
        return 0;
    }

    #[test]
    fn test_align() -> i32 {
        if alignof::<i8>() != 1 { return 1; }
        if alignof::<i16>() != 2 { return 1; }
        if alignof::<i32>() != 4 { return 1; }
        if alignof::<i64>() != 8 { return 1; }
        if alignof::<u8>() != 1 { return 1; }
        if alignof::<u16>() != 2 { return 1; }
        if alignof::<u32>() != 4 { return 1; }
        if alignof::<u64>() != 8 { return 1; }
        if alignof::<f32>() != 4 { return 1; }
        if alignof::<f64>() != 8 { return 1; }
        return 0;
    }
}
