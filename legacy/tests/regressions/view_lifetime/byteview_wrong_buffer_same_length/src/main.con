mod byteview_wrong_buffer_same_length {
    import std.bytes.{Bytes};
    import std.numeric.{ByteView};

    fn main() with(Alloc) -> Int {
        let mut a: Bytes = Bytes::new();
        a.push(10); a.push(11); a.push(12); a.push(13); a.push(14);
        let mut b: Bytes = Bytes::new();
        b.push(90); b.push(91); b.push(92); b.push(93); b.push(94);

        // View over a[1..4]. SAME LENGTH as b, different buffer.
        let v: ByteView = match ByteView::new(1, 3, &a) {
            Option::Some { value } => value,
            Option::None => { destroy(a); destroy(b); return 200; },
        };
        // Read it against the WRONG buffer of the same length.
        let got: Int = match v.byte(&b, 0) {
            Option::Some { value } => value as Int,   // 91 => brand did NOT catch it
            Option::None => 0,                        // 0  => brand caught it
        };
        destroy(a);
        destroy(b);
        return got;
    }
}
