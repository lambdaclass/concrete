mod byteview_byte_rejected {
    import std.bytes.{Bytes};
    import std.numeric.{ByteView};
    fn main() with(Alloc) -> Int {
        let mut b: Bytes = Bytes::with_capacity(4);
        b.push(65);
        let v: ByteView = match ByteView::new(0, 1, &b) {
            Option::Some { value } => value,
            Option::None => { destroy(b); return 2; },
        };
        destroy(b);
        // Coordinates-only view: accessor DEMANDS the buffer, which is gone.
        match v.byte(&b, 0) {
            Option::Some { value } => { return value as Int; },
            Option::None => { return 1; },
        }
    }
}
