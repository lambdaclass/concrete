mod uaf {
    import std.bytes.{Bytes};
    import std.numeric.{ByteCursor, CursorError};

    fn main() with(Alloc) -> Int {
        let mut b: Bytes = Bytes::with_capacity(8);
        b.push(65);
        b.push(66);

        let mut c: ByteCursor = ByteCursor::from_bytes(&b);

        // Consume the owner while the cursor is still live.
        destroy(b);

        // Read through the cursor after its buffer is gone.
        let r: Result<u8, CursorError> = c.read_u8();
        match r {
            Result::Ok { value } => { return value as Int; },
            Result::Err { error } => { return 1; },
        }
    }
}
