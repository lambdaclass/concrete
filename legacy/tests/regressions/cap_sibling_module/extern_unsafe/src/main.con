// The same hole reached through an EXTERN rather than an ordinary function, and
// the more serious leg: `syscall_direct` is neither trusted nor `with(Unsafe)`,
// yet it issues write(2). A same-module call is refused correctly (E0520); only
// the sibling-submodule path lost the requirement.
mod extern_unsafe {
    mod raw;
    import raw.{write as raw_write};

    fn syscall_direct(data: *const u8, len: u64) -> i64 {
        return raw_write(1, data, len);
    }

    fn main() -> i64 { return 0; }
}
