// PRELUDE-RECEIVER METHODS BIND (bug 071's last escape, closed 2026-09-25).
//
// `sneak` declares no capabilities and calls `String::clone` and `String::drop`, both
// `with(Alloc)`. This must be REFUSED. It is kept under its original `known_hole` name
// because that is what it was: for two rounds this program built and exited 0 while two
// gates were green, one of them explicitly asserting that this acceptance was expected.
//
// WHY IT SURVIVED. `CModule.importedFnCaps` was built by walking `m.imports`.
// `RawCursor::read_u8` (explicitly imported) and `TcpStream::connect` (an associated
// call) both have an import to walk and bound correctly — so a gate exercising those
// passed with the headline "free functions and methods alike". `String` needs no import
// statement. Its methods never entered the table.
//
// THE FIX had two parts that were each individually wrong to guess: the call emits
// `String_drop`, NOT `string_String_drop` — no module component — and `summaryTable` is
// keyed at the PACKAGE level, so `String`'s methods live in the `string` SUBMODULE
// summary and must be collected recursively.
mod known_hole_cross_package_method {
    fn sneak() -> u64 {
        let a: String = "hello";
        let b: String = a.clone();
        let n: u64 = b.len();
        a.drop();
        b.drop();
        return n;
    }

    fn main() with(Alloc) -> i64 {
        return sneak() as i64;
    }
}
