// Bug 145: vec_set overwrote an initialized non-Copy element without consuming it (the old
// String was lost). Refused (E0291); Vec::replace hands the old element back.
fn main() with(Alloc) -> Int {
    let mut v: Vec<String> = vec_new::<String>();
    vec_push::<String>(&mut v, "old");
    vec_set::<String>(&mut v, 0, "new");
    v.drop();
    return 0;
}
