// D1 (decision Q1, 2026-10-23): every `&mut` argument is an implicit reborrow, borrow-block binders
// included. This program was `error_mut_ref_loop_consume.con`, refused when a borrow-block binder was
// consumed by the call it was passed to; it now runs. Exit 13.
fn increment(x: &mut Int) {
    *x = *x + 1;
}

fn main() -> Int {
    let mut n: Int = 10;
    borrow mut n as r in R {
        let mut i: Int = 0;
        while i < 3 {
            increment(r);
            i = i + 1;
        }
    }
    return n;
}
