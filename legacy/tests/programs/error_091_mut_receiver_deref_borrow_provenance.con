// Bug 091 round 3 (Codex review, fourth pass): `let r = &*(&p);` recorded no borrow of
// `p`, so `p.bump()` ran under the live `r`. Provenance follows `*` and borrows: E0232.
mod m {
    struct P { n: i64 }
    impl P {
        fn bump(&mut self) { self.n = self.n + 1; }
    }
    fn main() with(Std) -> Int {
        let mut p: P = P { n: 0 };
        let r: &P = &*(&p);
        p.bump();
        print_int(r.n);
        let P { n } = p;
        return 0;
    }
}
