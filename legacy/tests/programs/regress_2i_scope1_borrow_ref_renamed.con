// Exit 2i SCOPE-1@1 migration twin of error_2i_scope1_borrow_ref.con: a borrow-block reference name reuses an outer `let`, with the new binder renamed
// (the §15.5 rewrite). Run 42, binary = --interp.
fn read(r: &Int) -> Int {
    return *r;
}

fn main() -> Int {
    let x: Int = 42;
    let r: Int = 0;
    borrow x as rx in R {
        if read(rx) != 42 { return 0; }
    }
    return x + r;
}
