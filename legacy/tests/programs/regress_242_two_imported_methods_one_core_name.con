// Bug 242: two imported types of one spelling, each with a method `mk`, called as `M::mk` (the alias of
// `m.P`) and `P::mk` (`q.P`). Each call names its own type's method. When this was written Core
// called a method by its mangled spelling, `P_mk` for both, so Check refused the second (E0299, bug
// 223's refusal). Since bugs 238 – 239 a method call carries the method namespace and each type's
// methods are spelled by their type (`m_P_mk`, `q_P_mk`): the program compiles and each call reaches
// its own type's method. Expected: 42 (40 + 200 / 100), natively and --interp.
mod m {
    pub struct Copy P { v: i64 }
    impl P { pub fn mk(x: i64) -> P { return P { v: x }; } pub fn get(self) -> i64 { return self.v; } }
}
mod q {
    pub struct Copy P { w: i32 }
    impl P { pub fn mk(x: i32) -> P { return P { w: x * 100 }; } pub fn get(self) -> i64 { return self.w as i64; } }
}
import m.{P as M};
import q.{P};
fn main() -> Int { let a: M = M::mk(40); let b: P = P::mk(2); return a.get() + b.get() / 100; }
