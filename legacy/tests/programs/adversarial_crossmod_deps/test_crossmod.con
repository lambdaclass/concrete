// Cross-module dependency identity test.
// Two modules each have a function named "add" — proved via registry.
// A caller in one module uses "add" from the same module.
// The dependency must use the correct qualified name.

mod left {
    #[spec(left_add_spec)]
    #[proof_by(Examples.TestFixtures.Proofs.left_add_correct)]
    #[proof_fingerprint("v2:46afa9c2c5a5f723ebebcf2f42218191")]
    pub fn add(a: i64, b: i64) -> i64 {
        return a + b;
    }

    pub fn use_add(x: i64) -> i64 {
        return add(x, 1);
    }
}

mod right {
    #[spec(right_add_spec)]
    #[proof_by(Examples.TestFixtures.Proofs.right_add_correct)]
    #[proof_fingerprint("v2:a9da9205fd23e51283f66e967196474b")]
    pub fn add(a: i64, b: i64) -> i64 {
        return a + b;
    }

    pub fn use_add(x: i64) -> i64 {
        return add(x, 2);
    }
}

fn main() -> i64 {
    let a: i64 = left::use_add(10);
    let b: i64 = right::use_add(20);
    return a + b;
}
