// Bug 212 negative control: the head holds a struct literal and still parses as written
// (`Foo { value: 1 }.value > 0`, then the block), so the parse error inside the block
// (`let = 1;`) must NOT carry the struct-literal hint.
mod m {
    struct Copy Foo { value: i32 }

    fn main() -> i32 {
        if Foo { value: 1 }.value > 0 { let = 1; }
        return 0;
    }
}
