// Test: create a listening socket, verify fd >= 0, close it
trusted extern fn socket(domain: i32, typ: i32, protocol: i32) with(Network) -> i32;
trusted extern fn bind(sockfd: i32, addr: *const u8, addrlen: u32) with(Network) -> i32;
trusted extern fn listen(sockfd: i32, backlog: i32) with(Network) -> i32;
trusted extern fn close(fd: i32) with(Network) -> i32;
trusted extern fn htons(hostshort: u16) with() -> u16;
trusted extern fn setsockopt(sockfd: i32, level: i32, optname: i32, optval: *const u8, optlen: u32) with(Network) -> i32;
trusted extern fn malloc(size: u64) with(Alloc) -> *mut u8;
trusted extern fn free(ptr: *mut u8) with(Alloc);

trusted fn tcp_listen(port: i64, backlog: i64) with(Network, Alloc) -> Int {
    let lsock: i32 = socket(2, 1, 0);
    let reuse_buf: *mut u8 = malloc(4);
    let reuse_ptr: *mut i32 = reuse_buf as *mut i32;
    *reuse_ptr = 1;
    // SO_REUSEADDR is spelled differently per platform: SOL_SOCKET is 1 on Linux and
    // 0xffff on BSD/macOS, and SO_REUSEADDR is 2 there against 4 here. Both are
    // attempted and neither is checked: this is an ergonomic option, not a
    // precondition of what the test asserts.
    setsockopt(lsock, 1, 2, reuse_buf as *const u8, 4);
    setsockopt(lsock, 65535, 4, reuse_buf as *const u8, 4);
    free(reuse_buf);
    let saddr: *mut u8 = malloc(16);
    let mut i: u64 = 0;
    while i < 16 {
        let p: *mut u8 = saddr + i;
        *p = 0;
        i = i + 1;
    }
    let port16: u16 = port as u16;
    let port_n: u16 = htons(port16);
    let sp: *mut u16 = (saddr + 2) as *mut u16;
    *sp = port_n;
    // `sockaddr_in` DISAGREES AT BYTE ZERO and no single pattern satisfies both.
    // Linux has no `sin_len`: `sin_family` is a little-endian u16 at offset 0, so
    // AF_INET is [2, 0]. BSD/macOS puts `sin_len` = 16 at offset 0 and `sin_family`
    // = 2 at offset 1, so the same field reads as 0x0210 = 528 on Linux and bind
    // refuses with EAFNOSUPPORT. This file previously hardcoded the BSD form, which
    // is why it could not pass on Linux.
    //
    // Try the Linux layout, then fall back. The test asserts that a listening socket
    // can be created and closed — not that a particular ABI is in force — so
    // discovering the layout by attempting it is the honest portable form, and it
    // exercises the real syscalls on both platforms instead of skipping one.
    let sf: *mut u8 = saddr + 1;
    *saddr = 2;
    *sf = 0;
    let mut bind_ret: i32 = bind(lsock, saddr as *const u8, 16);
    if bind_ret < 0 {
        *saddr = 16;
        *sf = 2;
        bind_ret = bind(lsock, saddr as *const u8, 16);
    }
    free(saddr);
    if bind_ret < 0 {
        close(lsock);
        return -1;
    }
    let listen_ret: i32 = listen(lsock, backlog as i32);
    if listen_ret < 0 {
        close(lsock);
        return -1;
    }
    return lsock as Int;
}

trusted fn socket_close(fd: Int) with(Network) {
    close(fd as i32);
}

fn main() with(Std) -> Int {
    let fd: Int = tcp_listen(0, 1);
    socket_close(fd);
    if fd >= 0 {
        return 1;
    } else {
        return 0;
    }
}
