// Exit 2i SCOPE-1@1 (MEMORY_SEMANTICS §15.4): a `while let` binder reuses an outer `let`. Rejected: E0301, with the earlier
// binding as the related span. Its migration twin is regress_2i_scope1_while_let_renamed.con.
fn main() -> Int {
    let step: Int = 0;
    let mut total: Int = 0;
    let mut cur: Option<Int> = Option::Some { value: 42 };
    while let Option::Some { value: step } = cur {
        total = total + step;
        cur = Option::None;
    }
    return total + step;
}
