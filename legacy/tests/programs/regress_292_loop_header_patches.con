// Bug 292: a loop header's phis and an aggregate merge's stores are added to finished blocks when
// the function's blocks are assembled, not by a map over every finished block per loop. Nested
// loops with continue and break edges, an aggregate merged inside a loop, and a header patched
// after an inner loop's.
struct Copy P {
    a: i64,
    b: i64,
}

fn nest(n: i64) -> i64 {
    let mut s: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        let mut j: i64 = 0;
        while j < 10 {
            j = j + 1;
            if j == 2 {
                continue;
            }
            if j > 4 {
                break;
            }
            s = s + j;
        }
        i = i + 1;
    }
    return s;
}

// An aggregate-valued `match` inside a loop merges its arms through a result slot with one store
// per arm (`insertStoresBeforeTerm`), patched into the arms' finished blocks.
fn merged(n: i64) -> i64 {
    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        let p: P = match i % 2 {
            0 => {
                P { a: i + 1, b: 0 }
            },
            _ => {
                P { a: i, b: 2 }
            },
        };
        acc = acc + p.a + p.b;
        i = i + 1;
    }
    return acc;
}

fn main() -> Int {
    // nest(3): each inner loop adds 1 + 3 + 4 (2 is skipped, 5 breaks), three times = 24
    // merged(6): 1 + 3 + 3 + 5 + 5 + 7 = 24; 24 + 24 - 6 = 42
    return (nest(3) + merged(6) - 6) as Int;
}
