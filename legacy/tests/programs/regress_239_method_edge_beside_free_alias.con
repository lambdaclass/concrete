// Bug 239 (FIXED), Codex review r10: `user` calls the imported `P`'s method `P::get` (definition
// `P_get`) and imports an unrelated extern under the alias `P_get`. The assumption summary
// normalized the method edge through the free import alias (`P_get` → `other`) and then found no
// method of that name: an unresolved edge (before the branch: a foreign assumption on `ffi.other`).
// A method edge takes its raw spelling first.
// Expected: 42, natively and --interp; `user.run` complete with no assumptions in `--report assumptions`.
mod defs {
    pub struct Copy P { pub v: i32 }
    impl P {
        pub fn get(x: i32) -> i32 { return 42; }
    }
}
mod ffi {
    #[link_name = "abs"]
    pub trusted extern fn other(x: i32) with() -> i32;
}
mod user {
    import defs.{P};
    import ffi.{other as P_get};
    pub fn run() -> i32 { return P::get(-42); }
}
fn main() -> Int {
    return user::run() as Int;
}
