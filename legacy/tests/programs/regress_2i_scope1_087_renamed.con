// Exit 2i (MEMORY_SEMANTICS §15.4 / §15.6): the SCOPE-1@1 migration twin of
// regress_087_let_block_shadow.con. That fixture's shadowing is now refused (E0301); this is the
// same program with every inner binder renamed, so the lexical answers bug 087 pinned are still
// checked on the binary, the interpreter and the extracted model (the renamed inner binders appear
// under their own names, with no `.bN` alpha-renaming suffix). main returns 42.
mod m {
    // Inner `x` is visible only inside the `if`; `return x` reads the outer 1.
    fn shadow_if(a: i32) -> i32 {
        let x: i32 = 1;
        if a > 0 { let inner_x: i32 = 100; let y: i32 = inner_x; }
        return x;
    }
    // Shadow inside a loop body; outer `k` (5) survives two iterations.
    fn shadow_loop(a: i32) -> i32 {
        let mut s: i32 = 0;
        let k: i32 = 5;
        for (let mut i: i32 = 0; i < 2; i = i + 1) {
            let inner_k: i32 = 1000;
            s = s + inner_k;
        }
        return s + k;
    }
    // Shadowing a PARAMETER inside a branch.
    fn shadow_param(a: i32) -> i32 {
        if a > 0 { let inner_a: i32 = 7; }
        return a;
    }
    // Same-block rebinding with a DIFFERENT type, then the outer read after
    // an else-branch shadow; the inner value is used inside its block.
    fn shadow_else(a: i32) -> i32 {
        let v: i32 = 3;
        let mut got: i32 = 0;
        if a < 0 { got = 1; } else { let wide_v: i64 = 40; got = wide_v as i32; }
        let matched: bool = got == 40;
        if matched { return 9; }
        return 0;
    }
    // Value-if branch and while body shadows.
    fn shadow_value_if(a: i32) -> i32 {
        let n: i32 = 2;
        let r: i32 = if a > 0 { let inner_n: i32 = 50; inner_n + 1 } else { n };
        let mut c: i32 = 0;
        while c < 3 { let loop_n: i32 = 1000; c = c + 1; }
        return r + n;
    }

    fn main() -> Int {
        let mut acc: i32 = 0;
        if shadow_if(5) != 1 { return 1; }
        acc = acc + 1;                       // 1
        if shadow_loop(0) != 2005 { return 2; }
        acc = acc + 2;                       // 3
        if shadow_param(3) != 3 { return 3; }
        acc = acc + 3;                       // 6
        if shadow_else(1) != 9 { return 4; }
        acc = acc + 9;                       // 15
        if shadow_value_if(1) != 53 { return 5; }
        acc = acc + 27;                      // 42
        return acc as Int;
    }
}
