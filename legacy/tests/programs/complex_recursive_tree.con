// Complex test: binary tree via Heap pointers
// Tree:     10
//          /  \
//         20   12
// Sum = 42
struct Copy Leaf { value: Int }

struct Branch {
    value: Int,
    left: Heap<Leaf>,
    right: Heap<Leaf>
}

// Heap interiors are linearity-tracked (bug 144): move the node out of its cell and destructure.
fn tree_sum(root: Heap<Branch>) with(Alloc) -> Int {
    let Branch { value, left, right } = *root;
    let lv: Int = left.value;
    let rv: Int = right.value;
    free(left);
    free(right);
    return value + lv + rv;
}

fn main() with(Std) -> Int {
    let left: Heap<Leaf> = alloc(Leaf { value: 20 });
    let right: Heap<Leaf> = alloc(Leaf { value: 12 });
    let root: Heap<Branch> = alloc(Branch { value: 10, left: left, right: right });
    let result: Int = tree_sum(root);
    return result;
}
