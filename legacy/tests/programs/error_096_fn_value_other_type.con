// Bug 096 (Codex round 7): read taken as a function value of type fn(&Q) -> i64 (main's Q)
// while read's parameter is a's P (c's alias Q). Refused (E0299) at the value.
mod a { pub struct Copy P { pub x: i64, pub pad: i64 } }
mod z { pub struct Copy P { pub unused: i64 } }
mod c {
    import a.{ P as Q };
    pub fn read(p: &Q) -> i64 { return p.x; }
}
mod main {
    import c.{ read };
    struct Copy Q { pub pad: i64, pub x: i64 }
    fn main() with(Std) -> Int {
        let q: Q = Q { pad: 99, x: 7 };
        let f: fn(&Q) -> i64 = read;
        print_int(f(&q));
        print_char(10);
        return 0;
    }
}
