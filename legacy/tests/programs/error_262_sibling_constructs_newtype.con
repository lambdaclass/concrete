// Bug 262 (control): a module constructing its sibling's imported newtype is refused (TYPE-11),
// E0296. It was refused before the fix too; it pins the sibling direction of the rule.
mod outer {
    mod a { pub newtype K = i64; }
    mod b {
        import a.{K};
        pub fn mk() -> i64 { let k: K = K(30); return 0; }
    }
    pub fn main() -> i64 { return b::mk(); }
}
