// A trusted method (declared per method, bug 189) and a trusted fn for --report unsafe verification
struct Buffer {
    len: i32,
}

impl Buffer {
    trusted fn get_len(&self) -> i32 {
        return self.len;
    }
}

trusted fn raw_read(p: *const i32) -> i32 {
    return *p;
}

fn main() -> i32 {
    return 0;
}
