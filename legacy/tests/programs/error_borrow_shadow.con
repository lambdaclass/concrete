// Exit 2i (MEMORY_SEMANTICS §15.4): this program shadows a visible binding, so SCOPE-1@1
// refuses it first (E0301; before: E0214). The check below it stays as defense in depth.
// Error: borrow ref shadows existing name
fn main() -> Int {
    let x: Int = 10;
    let r: Int = 20;
    borrow x as r in R {
        let y: Int = *r;
    }
    return 0;
}
