// Bug 145: `vec_free` of a Vec<String> is refused in safe code (it would drop live elements); a
// trusted helper vouches that the vector was emptied first.
trusted fn free_emptied(v: Vec<String>) with(Alloc) { vec_free::<String>(v); }

// Test: string literals inside loops must be properly materialized.
// Previously produced invalid LLVM IR: store %struct.String @global, ptr %ssa
fn main() with(Std) -> Int {
    let mut strings: Vec<String> = vec_new::<String>();
    let mut i: Int = 0;
    while i < 5 {
        let s: String = "hello";
        vec_push::<String>(&mut strings, s);
        i = i + 1;
    }
    let slen: Int = vec_len::<String>(&mut strings) as Int;
    let mut si: Int = 0;
    while si < slen {
        // Each element leaves the Vec exactly once (bug 115: vec_get no longer
        // copies a non-Copy element out, which owned the same buffer twice).
        match vec_pop::<String>(&mut strings) {
            Option::Some { value } => { drop_string(value); },
            Option::None => {},
        }
        si = si + 1;
    }
    free_emptied(strings);
    return slen;
}
