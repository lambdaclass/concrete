// Exit 2i REF-6@1 (MEMORY_SEMANTICS §15.3): a named projected borrow outlives `free` of its owner (bug 091's projected case). Rejected: E0302 (the shape is unwritable once REF-6 lands).
struct B { v: Int }

fn main() with(Std) -> Int {
    let h: Heap<B> = alloc(B { v: 42 });
    let r: &Int = &h.v;
    free(h);
    return *r;
}
