// Bug 218: a struct and a function may share a spelling (types and values are separate
// namespaces), a method may share a free function's name, and two modules may each declare a
// name. Expected: 42.
struct Copy Pt { n: Int }

fn Pt(n: Int) -> Pt { return Pt { n: n }; }

impl Pt {
    fn get(&self) -> Int { return self.n; }
}

fn get(p: Pt) -> Int { return p.n; }

mod other {
    pub fn get() -> Int { return 2; }
}

fn main() -> Int {
    let p: Pt = Pt(20);
    return p.get() + get(p) + other::get();
}
