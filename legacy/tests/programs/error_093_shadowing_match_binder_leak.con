// Exit 2i (MEMORY_SEMANTICS §15.4): this program shadows a visible binding, so SCOPE-1@1
// refuses it first (E0301; before: E0208). The check below it stays as defense in depth.
// Bug 093: a match payload binder named like a consumed outer binding escaped
// the never-consumed check; the payload `Heap<Int>` leaked. E0208.
struct R { v: Int }
fn eat(r: R) -> Int { let R { v } = r; return v; }
fn mk(k: Int) with(Alloc) -> Option<Heap<Int>> { return Option::Some { value: alloc(k) }; }
fn main() with(Std) -> Int {
    let value: R = R { v: 7 };
    let a: Int = eat(value);
    match mk(3) {
        Option::Some { value } => { println(1); },
        Option::None => { println(2); },
    }
    return a;
}
