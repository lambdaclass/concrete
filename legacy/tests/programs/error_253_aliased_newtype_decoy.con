// Bug 253 (fixed): as error_253_child_newtype_decoy through an alias: `import m.{N as M}` beside a
// child's `newtype M`. `M(42)` is `m.N`'s constructor outside `m`: E0296.
mod outer {
    mod m { pub newtype N = i64; pub fn ok() -> i64 { return 1; } }
    mod user {
        mod decoy { newtype M = i64; }
        import m.{N as M};
        pub fn run() -> i64 { let x: M = M(42); return 0; }
    }
    import user.{run};
    pub fn main() -> i64 { return run(); }
}
