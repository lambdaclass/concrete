// Bug 251 (fixed, Codex review): a generic of `a` calls `a`'s own `extern fn abs` while the
// instantiating module defines a Concrete `fn abs`. Binary and --interp return 40.
mod a {
    trusted extern fn abs(x: i32) with() -> i32;
    pub fn get<T: Copy>(x: T) -> i32 { return abs(0 - 40); }
}
import a.{get};
fn abs(x: i32) -> i32 { return 2; }
fn main() -> i32 { return get::<i32>(0) + abs(0) - 2; }
