// Bug 088 regression: constant casts, compares, divisions, shifts and
// remainders fold to the value the interpreter computes. Pre-fix the unhinted
// literal 0xFFFFFFFFFFFFFFFF was an unchecked `Int` holding 2^64-1; identity-cast
// elimination dropped `as i64` and the folder compared the unwrapped constant,
// so h1 was false compiled and true interpreted (1048574 vs 1048575).
// Every bit set = every row agrees. The interp/binary differential for each row
// is check_cast_matrix.sh's constant section.
mod main {
    fn h1(a: i64) -> bool { return 0xFFFFFFFFFFFFFFFF as i64 < 0; }
    fn h2(a: i64) -> i64 { return 0xFFFFFFFFFFFFFFFF as i64; }
    fn h3(a: i64) -> bool { return (0xFFFFFFFFFFFFFFFF as u64) > 9223372036854775807; }
    fn h4(a: i64) -> u64 { return (0xFFFFFFFFFFFFFFFF as u64) / 2; }
    fn h5(a: i64) -> u64 { return (0xFFFFFFFFFFFFFFFF as u64) >> 60; }
    fn h6(a: i64) -> bool { return (-1 as u32) > 5; }
    fn h7(a: i64) -> u32 { return (-1 as u32) / 16; }
    fn h8(a: i64) -> i32 { return 0xFFFFFFFF as i32; }
    fn h9(a: i64) -> bool { return (200 as i8) < 0; }
    fn h10(a: i64) -> u8 { return 300 as u8; }
    fn h11(a: i64) -> bool { return (0xFFFFFFFF as i32) == -1; }
    fn h12(a: i64) -> i64 { return ((0xFFFFFFFF as i32) as i64) / 1; }
    fn h13(a: i64) -> u64 { return ((-1 as i32) as u64) >> 32; }
    fn h14(a: i64) -> i64 { return (0xFFFFFFFFFFFFFFFF as i64) >> 1; }
    fn h15(a: i64) -> u64 { let x: u64 = 0xFFFFFFFFFFFFFFFF; return x % 10; }
    fn h16(a: i64) -> bool { let x: u64 = 0xFFFFFFFFFFFFFFFF; return x as i64 == -1; }
    fn h17(a: i64) -> i64 { return (9223372036854775808 as i64); }
    fn h18(a: i64) -> bool { return ((128 as u8) as i8) < 0; }
    fn h19(a: i64) -> u16 { return (70000 as u16) % 7; }
    fn h20(a: i64) -> bool { return (0xFFFFFFFFFFFFFFFF as u8) == 255; }
    pub fn main() with(Console) -> i32 {
        let mut c: i64 = 0;
        if h1(0) { c = c + 1; }
        if h2(0) == -1 { c = c + 2; }
        if h3(0) { c = c + 4; }
        if h4(0) == 9223372036854775807 { c = c + 8; }
        if h5(0) == 15 { c = c + 16; }
        if h6(0) { c = c + 32; }
        if h7(0) == 268435455 { c = c + 64; }
        if h8(0) == -1 { c = c + 128; }
        if h9(0) { c = c + 256; }
        if h10(0) == 44 { c = c + 512; }
        if h11(0) { c = c + 1024; }
        if h12(0) == -1 { c = c + 2048; }
        if h13(0) == 4294967295 { c = c + 4096; }
        if h14(0) == -1 { c = c + 8192; }
        if h15(0) == 5 { c = c + 16384; }
        if h16(0) { c = c + 32768; }
        if h17(0) == -9223372036854775807 - 1 { c = c + 65536; }
        if h18(0) { c = c + 131072; }
        if h19(0) == 4464 % 7 { c = c + 262144; }
        if h20(0) { c = c + 524288; }
        print_int(c);
        return 0;
    }
}
