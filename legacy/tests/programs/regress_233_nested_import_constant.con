// Bug 233 (FIXED, R-0492 step 4): the constant import in a nested submodule, whose imports Check
// validates (E0323 while contained). Returns 42.
mod m {
    mod a { pub const X: i32 = 42; }
    mod b {
        import m.a.{X};
        pub fn g() -> i32 { return X; }
    }
    pub fn h() -> i32 { return b::g(); }
}

fn main() -> Int {
    return m::h() as Int;
}
