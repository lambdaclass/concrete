// Exit 2i SCOPE-1@1 (MEMORY_SEMANTICS §15.4): a `let` in a block reuses a parameter. Rejected: E0301, with the earlier
// binding as the related span. Its migration twin is regress_2i_scope1_param_in_block_renamed.con.
fn f(a: Int) -> Int {
    if a > 0 {
        let a: Int = 7;
        if a != 7 { return 0; }
    }
    return a;
}

fn main() -> Int {
    return f(42);
}
