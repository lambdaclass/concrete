// Since batch 4 (bug 092), storing a reference in an aggregate is itself refused at the
// declaration (E0239), which fires first; the place rule's E0238 below stays as defense in depth.
// Normalized place rule (Codex static review): `w.r as R` (`type R = &P`) in an inferred `let`
// is a reference read out of an aggregate — untraced. E0238.
mod m {
    struct P { n: i64 }
    type R = &P;
    struct W { r: &P }
    fn main() -> Int {
        let p: P = P { n: 1 };
        let w: W = W { r: &p };
        let s = w.r as R;
        let W { r } = w;
        let P { n } = p;
        return 0;
    }
}
