// Bug 192: an integer is not a condition (TYPE-5). The for statement's condition type was
// discarded by the checker and admitted by CoreCheck as truthiness. Expected: E0223.
fn main() -> Int {
    let n: Int = 1;
    for (let mut i: Int = 0; n; i = i + 1) {
        return 42;
    }
    return 0;
}
