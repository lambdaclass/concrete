// Bug 307, second fixture: a call argument `&mut v` is `v`'s place for every owner type the checker
// admits, now that no argument takes the copy path: a raw-pointer local (the callee repoints it), a
// `Heap` local (MEMORY_SEMANTICS §5, one hop: the callee reaches the cell through the slot) and a
// `&mut` parameter passed on (plain lending, OD2 part 1). Binary = --interp = 42, on main as on
// the fix (no defined program told the copy apart; this pins the owner types the review asked about).
struct Copy B {
    v: i64,
    w: i64,
}

trusted fn rd(pp: &mut *mut i64) -> i64 {
    return **pp;
}

trusted fn repoint(pp: &mut *mut i64, v: *mut i64) {
    *pp = v;
}

// Every raw pointer is derived from a named loan (`rx`, `ry`) that lives through every dereference
// (G19, OD15: a pointer derived from a loan is valid only while the loan lives).
trusted fn ptr_owner() -> i64 {
    let mut x: i64 = 1;
    let mut y: i64 = 2;
    let mut out: i64 = 0;
    borrow mut x as rx in RX {
        borrow mut y as ry in RY {
            let mut p: *mut i64 = rx as *mut i64;
            let a: i64 = rd(&mut p);
            repoint(&mut p, ry as *mut i64);
            // a = 1; p now points at y: 100 + 20 + 1
            out = a * 100 + *p * 10 + *rx;
        }
    }
    return out;
}

fn bump(h: &mut Heap<B>) {
    h.v = h.v + 1;
}

fn get(h: &mut Heap<B>) -> i64 {
    return h.v * 10 + h.w;
}

fn heap_owner() with(Alloc) -> i64 {
    let mut h: Heap<B> = alloc(B { v: 1, w: 2 });
    bump(&mut h);
    bump(&mut h);
    let a: i64 = get(&mut h);
    free(h);
    // v = 3, w = 2
    return a;
}

fn set(q: &mut i64) {
    *q = *q + 1;
}

fn lend(p: &mut i64) {
    set(p);
    set(p);
}

fn param_owner() -> i64 {
    let mut x: i64 = 5;
    lend(&mut x);
    return x;
}

fn main() with(Alloc) -> Int {
    // ptr_owner() = 121, heap_owner() = 32, param_owner() = 7
    return (ptr_owner() + heap_owner() + param_owner() - 118) as Int;
}
