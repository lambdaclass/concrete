// Bug 227 (FIXED): a user `enum Result` in an enclosing module and the builtin `Result<T, E>` used in
// its nested submodule. Resolve, Check and Elab gave `inner` the builtin (the user enum is not in
// its scope) and `--interp` returned 42, but Core spelled both enums `Result`, and Lower, which
// looks an enum up by its Core name in one program-wide list, found the user's: E0602 "variant 'Ok'
// not found in enum 'Result'". Core now spells a user `Result` by its module when another module
// can see the builtin (`Elab.shadowsVisibleBuiltinEnum`, R-0492 slice 6 step 2): `outer_Result`.
// Expected: 42, natively and --interp.
mod outer {
    enum Copy Result { A }
    mod inner {
        pub fn h(r: Result<i32, i32>) -> Int {
            match r {
                Result::Ok { value } => { return value as Int; },
                Result::Err { error } => { return error as Int; },
            }
        }
        pub fn k() -> Int { return h(Result::<i32, i32>::Ok { value: 42 }); }
    }
    pub fn g() -> Int { return inner::k(); }
}

fn main() -> Int {
    return outer::g();
}
