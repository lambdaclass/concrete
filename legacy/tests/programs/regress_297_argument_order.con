// Bug 297: Elab and Lower now cons each call argument (and each `&mut` write-back, and each arm's
// incoming value at a merge) and restore the order once. This pins argument order, each `&mut`
// local written back to itself, field-to-name association and each arm's merged value; the
// order of write-backs to distinct locals is not observable and is pinned by the IR comparison.
struct P {
    a: i64,
    b: i64,
    c: i64,
}

fn weigh(a: i64, b: i64, c: i64, d: i64, e: i64) -> i64 {
    return a * 10000 + b * 1000 + c * 100 + d * 10 + e;
}

fn bump(x: &mut i64, y: &mut i64, z: &mut i64) {
    *x = *x + 1;
    *y = *y * 2;
    *z = *z - 3;
}

fn pick(k: i64) -> i64 {
    let mut s: i64 = 0;
    match k {
        0 => { s = 7; },
        1 => { s = 8; },
        2 => { s = 9; },
        _ => { s = 10; },
    }
    return s;
}

fn main() -> Int {
    let w: i64 = weigh(1, 2, 3, 4, 5);
    let mut x: i64 = 1;
    let mut y: i64 = 2;
    let mut z: i64 = 3;
    bump(&mut x, &mut y, &mut z);
    let p: P = P { c: 3, a: 1, b: 2 };
    let P { a, b, c } = p;
    // Each term is 0 only when its values arrive in their own positions: arguments in order
    // (12345), each borrowed local written back to itself (240), each field read under its own
    // name (123), each arm's value merged from its own predecessor (7900).
    return ((w - 12345) + (x * 100 + y * 10 + z - 240) + (a * 100 + b * 10 + c - 123)
        + (pick(0) * 1000 + pick(1) * 100 + pick(2) * 10 + pick(3) - 7900) + 42) as Int;
}
