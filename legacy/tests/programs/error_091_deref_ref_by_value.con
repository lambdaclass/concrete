// Bug 091 round 3: `let q: P = *r;` with `r: &P` duplicated a non-Copy pointee its owner
// still held. Expected: E0290.
mod m {
    struct P { n: i64 }
    fn take(p: P) -> i64 { let P { n } = p; return n; }
    fn dup(r: &P) -> i64 { let q: P = *r; return take(q); }
    fn main() -> Int { let p: P = P { n: 1 }; let a: i64 = dup(&p); return a + take(p); }
}
