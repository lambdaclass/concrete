// Bug 096 (Codex round 4): sibling submodules a and c both declare P, and c's W mentions its
// P; nothing imports W. Sibling declarations are visible without an import and are not
// checked strictly, so this is not refused. Expected (compiled AND --interp): 1.
mod main {
    mod a { pub struct Copy P { pub x: i64 } pub fn fa() -> i64 { let p: P = P { x: 1 }; return p.x; } }
    mod c { pub struct Copy P { pub y: i64, pub z: i64 } pub struct Copy W { pub p: P } }
    import a.{ fa };
    fn main() with(Std) -> Int { print_int(fa()); print_char(10); return 0; }
}
