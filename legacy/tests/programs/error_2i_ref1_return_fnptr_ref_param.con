// Exit 2i REF-1@1 (MEMORY_SEMANTICS §15.3): a function returns a function pointer whose parameter is a reference (a reference anywhere in the return type). Rejected: E0236.
fn read(r: &Int) -> Int {
    return *r;
}

fn give() -> fn(&Int) -> Int {
    return read;
}

fn main() -> Int {
    return 0;
}
