// Bug 223 (FIXED, R-0492 step 3): an imported type under an alias was a different type. `Q`
// resolved to the struct (bug 069) but had none of `P`'s methods (Resolve's E0106 `Q::mk`, Check's
// E0264) and a `P` returned by the defining module was not a `Q` (E0220). Types are now compared,
// and their methods looked up, by declaration identity (`TypeId`, `MethodKey`) in Resolve, Check
// and Elab, so the alias names the same type. Returns 42, as it does without `as Q`.
mod m {
    mod shapes {
        pub struct Copy P { pub v: i64 }
        impl P {
            pub fn mk(n: i64) -> P { return P { v: n }; }
            pub fn get(&self) -> i64 { return self.v; }
        }
        pub fn make(n: i64) -> P { return P { v: n }; }
    }
    mod user {
        import m.shapes.{P as Q, make};
        pub fn run() -> i64 {
            let a: Q = Q::mk(40);
            let b: Q = make(2);
            return a.get() + b.v;
        }
    }
    import user.{run};
    pub fn main() -> i64 { return run(); }
}
