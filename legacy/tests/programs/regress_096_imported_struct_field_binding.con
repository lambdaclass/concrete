// Bug 096 (Codex round 2): module b imports c's W, whose field is c's P, and binds no P
// itself; a third module declares another P. The field keeps c's binding in b's Core.
// Expected (compiled AND --interp): 73.
mod a { pub struct Copy P { pub pad: i64, pub pad2: i64, pub x: i64 } }
mod c {
    pub struct Copy P { pub x: i64 }
    pub struct Copy W { pub p: P, pub k: i64 }
    pub fn mkw(v: i64) -> W { return W { p: P { x: v }, k: 3 }; }
}
mod b {
    import c.{ W, mkw };
    pub fn probe() -> i64 { let w: W = mkw(7); return w.p.x * 10 + w.k; }
}
mod main {
    import b.{ probe };
    fn main() with(Std) -> Int { print_int(probe()); print_char(10); return 0; }
}
