// D13 (semantics evaluation, 2026-10-21): output printed before a trap is part of the run.
// The binary prints "5 7 " and then aborts on the division by zero, after running no further
// defer; the interpreter used to print nothing at all, because its stdout lived in the
// environment it lost with the failure. check_codegen_differential.sh requires both sides to
// trap AND to have printed the same bytes first.
fn show(n: Int) with(Console) {
    print_int(n);
    print_char(32);
}

fn div(a: Int, b: Int) with(Console) -> Int {
    defer show(9);
    return a / b;
}

fn main() with(Console) -> Int {
    let z: Int = 0;
    defer show(8);
    show(5);
    show(7);
    return div(1, z);
}
