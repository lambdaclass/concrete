// Bug 216 (OPEN, needs a language decision): a write into a field, a nested array element or a
// heap cell of a binding not declared `mut` is accepted, while `&mut` of the same place is refused
// (E0233) and a direct array element write is refused (E0217, bug 030). Both backends return 42.
struct Copy P { x: i32, y: i32 }
struct Copy Q { a: [i32; 2] }

fn main() -> Int {
    let s: P = P { x: 1, y: 1 };
    s.y = 20;
    let q: Q = Q { a: [1, 2] };
    q.a[1] = 20;
    return (s.x + s.y + q.a[1]) as Int;
}
