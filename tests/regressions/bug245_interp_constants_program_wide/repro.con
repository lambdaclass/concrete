// Bug 245 (OPEN): the interpreter looks a module constant up program-wide by its bare spelling,
// while Lower looks it up in the using function's top-level module tree. Two top-level modules each
// reading their own private `K` run natively (42) and are refused by --interp ("defined by more than
// one module", bug 132's refusal). Owner: R-0492 / R-0514 (constant references by identity). Pinned
// as an open-bug reproducer (interp-fails).
mod a { const K: i32 = 40; pub fn ga() -> i32 { return K; } }
mod b { const K: i32 = 2; pub fn gb() -> i32 { return K; } }
import a.{ga};
import b.{gb};
fn main() -> Int { return (ga() + gb()) as Int; }
