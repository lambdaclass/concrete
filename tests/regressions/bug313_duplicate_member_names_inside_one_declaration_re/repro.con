// Bug 313: two methods of one name in one impl. Before the fix Check accepted it, the native build
// failed in llvm-as (a redefinition: "LLVM IR validation failed") and `--interp` stopped on an
// internal error ("call 'S_g' by name reaches 2 definitions"). Expected: refused at check, E0324
// (MOD-5).
struct Copy S { a: Int }
impl S {
    fn g(&self) -> Int { return 1; }
    fn g(&self) -> Int { return 42; }
}
fn main() -> Int {
    let s: S = S { a: 1 };
    return s.g();
}
