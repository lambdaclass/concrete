// Bug 137: enum-variant literal fields are evaluated in the variant's declaration
// order (Elab walks the variant's fields) in both the binary and --interp, where
// the rule (STATEMENT_EXPRESSION_MODEL, evaluation order rule 4) is source order.
// Both exit 65 (tick(6) for `a` ran first). Expected: 56.
enum E { V { a: Int, b: Int } }

fn tick(t: &mut Int, v: Int) -> Int {
    *t = *t * 10 + v;
    return v;
}

fn main() -> Int {
    let mut t: Int = 0;
    let e: E = E::V { b: tick(&mut t, 5), a: tick(&mut t, 6) };
    match e {
        E::V { a, b } => { return t + a * 0 + b * 0; }
    }
}
