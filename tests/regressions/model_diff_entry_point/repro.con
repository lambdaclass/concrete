// The entry point is compared against the model (it is excluded from proof only for being main):
// a program whose behaviour is all in main, with a let, a call, an assignment and a branch.
fn less(n: Int) -> Int {
    return n - 40;
}

fn main() -> Int {
    let mut acc: Int = 80;
    acc = less(acc);
    if acc > 30 {
        acc = acc + 2;
    }
    return acc;
}
