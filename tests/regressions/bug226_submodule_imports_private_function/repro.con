// Bug 226: MOD-2@1 says a declaration crosses a module boundary only when it is `pub`, and
// Resolve refused importing a private function from a top-level module (E0111). A module written
// after `main` is a submodule, whose imports Check and Elab resolve with FileSummary.resolveImports,
// which admitted every function and extern of the exporting module, so this program returned 42 on
// both consumers. Expected: refused at check (E0285), as from a top-level module (E0111).
fn main() -> Int {
    return b::g();
}

mod a {
    fn secret() -> Int { return 42; }
}

mod b {
    import a.{secret};
    pub fn g() -> Int { return secret(); }
}
