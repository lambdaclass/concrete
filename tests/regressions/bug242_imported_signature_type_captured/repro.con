// Bug 242 (OPEN): an imported signature names a type by its definition's spelling, and the importer
// reads that spelling in its own environment. `make`'s result is `m.shapes`'s `P`; the import
// closure adds that `P` to `user`'s environment ahead of `user`'s own `struct P`, so `user`'s literal
// `P { w: 2 }` is checked against the imported `P` (E0252 missing field 'v'). Expected: 42. Owner:
// R-0492 / R-0514 (signature types carried by declaration identity). Pinned as an open-bug
// reproducer (compile-fails).
mod m {
    mod shapes {
        pub struct Copy P { pub v: i64 }
        pub fn make(n: i64) -> P { return P { v: n }; }
    }
    mod user {
        import m.shapes.{make};
        struct Copy P { w: i64 }
        pub fn run() -> i64 {
            let p: P = P { w: 2 };
            return make(40).v + p.w;
        }
    }
    import user.{run};
    pub fn main() -> i64 { return run(); }
}
