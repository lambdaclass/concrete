// Bug 330: a `continue` inside a `for` loop's step. Check accepts this statement-`if` step. On main
// 71df9c25 the binary never terminates (Lower re-enters the step with the header's k = 2), while
// --interp prints 4 (the step's continue goes to the condition). No rule decides what such a
// continue does: re-running the step gives 3, going to the condition gives 4; never terminating is
// wrong under both. The open-bug reproducers leg only pins that it is accepted (it is not run).
fn f() -> i64 {
    let mut n: i64 = 0;
    for (let mut k: i64 = 0; k < 5; if k == 2 { k = 4; continue; } else { k = k + 1; }) {
        n = n + 1;
        if n > 50 {
            return 99;
        }
    }
    return n;
}

fn main() -> Int {
    return f() as Int;
}
