// Bug 140: a comparison consumed its linear operands. `a == b` on two `Heap<Int>` compared the
// two cell addresses, consumed both shells and freed neither (a silent leak); it now is E0229.
fn b2i(b: bool) -> Int { if b { return 1; } return 0; }

fn main() with(Alloc) -> Int {
    let a: Heap<Int> = alloc(1);
    let b: Heap<Int> = alloc(1);
    return b2i(a == b);
}
