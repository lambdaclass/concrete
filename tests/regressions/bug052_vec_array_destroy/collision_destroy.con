// Bug 052 round 3 (Codex): a top-level `Tracked` (+100) and a nested `inner::Tracked`
// (+1) both implement Destroy. Core names types by their bare name, so generic
// destruction of the NESTED value chose the top-level destructor (Mono preferred
// the top-level definition; the interpreter keyed impls by bare type name):
// compiled AND --interp printed 101 instead of 2. Until the defining module
// survives into Core and runtime values, the ambiguous dispatch is refused:
// E0814 compiled, a runtime error under --interp — never a guess.
mod m {
    mod inner {
        pub struct Tracked { cell: *mut u64 }
        trusted impl Destroy for Tracked {
            pub fn destroy(&self) {
                *self.cell = *self.cell + 1;
            }
        }
        fn kill<T: Destroy>(x: T) with(Alloc) {
            x.destroy();
        }
        pub fn run(cell: *mut u64) with(Alloc) {
            let a: Tracked = Tracked { cell: cell };
            destroy(a);
            kill::<Tracked>(Tracked { cell: cell });
        }
    }
    struct Tracked { cell: *mut u64 }
    trusted impl Destroy for Tracked {
        pub fn destroy(&self) {
            *self.cell = *self.cell + 100;
        }
    }
    trusted fn count(p: *mut u64) -> u64 { return *p; }
    fn main() with(Std, Unsafe) -> Int {
        let mut c: u64 = 0;
        let cell: *mut u64 = &mut c as *mut u64;
        inner::run(cell);
        print_int(count(cell) as i64);
        print_char(10);
        return 0;
    }
}
