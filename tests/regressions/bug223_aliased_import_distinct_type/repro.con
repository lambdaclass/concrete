// Bug 223 (OPEN): an imported type under an alias is a different type. `Q` resolves to the
// struct (bug 069) but has none of `P`'s methods (E0264), and a `P` returned by the defining
// module is not a `Q` (E0220). Without `as Q` the program returns 42. Owner: R-0492 / R-0514
// (types compared and looked up by declaration identity). Pinned by check_example_outputs.sh
// (open-bug reproducers, compile-fails).
mod m {
    mod shapes {
        pub struct Copy P { pub v: i64 }
        impl P {
            pub fn mk(n: i64) -> P { return P { v: n }; }
            pub fn get(&self) -> i64 { return self.v; }
        }
        pub fn make(n: i64) -> P { return P { v: n }; }
    }
    mod user {
        import m.shapes.{P as Q, make};
        pub fn run() -> i64 {
            let a: Q = Q::mk(40);
            let b: Q = make(2);
            return a.get() + b.v;
        }
    }
    import user.{run};
    pub fn main() -> i64 { return run(); }
}
