// Bug 227 (OPEN), the Resolve side: with `a` and `b` top-level modules (`main` written last), `b`'s
// scope falls back to the program-wide first-wins scope, which holds `a`'s non-generic
// `enum Result`, so `Result<i32, i32>` in `b` is refused: E0113 "'Result' takes 0 type arguments,
// but 2 were given". `b` declares and imports no `Result`; the builtin is meant.
mod a {
    enum Copy Result { A }
    pub fn z() -> Int { return 0; }
}

mod b {
    pub fn h(r: Result<i32, i32>) -> Int {
        match r {
            Result::Ok { value } => { return value as Int; },
            Result::Err { error } => { return error as Int; },
        }
    }
    pub fn k() -> Int { return h(Result::<i32, i32>::Ok { value: 42 }); }
}

fn main() -> Int {
    return b::k();
}
