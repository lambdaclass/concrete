// Negative: a Sink<Console> from another package must not let a function that does
// not declare Console reach it through the imported helper (E0240).
import sinklib.{Sink, apply};

fn shout(x: i32) with(Console) -> i32 { print_int(x as i64); return x; }

fn sneaky(s: &Sink<Console>) -> i32 { return apply(s, 1); }

fn main() with(Console) -> i32 {
    let s: Sink<Console> = Sink { f: shout };
    return sneaky(&s);
}
