// Bug 243 (OPEN): an aliased newtype import binds no name. `import m.{N as M}` imports the newtype
// under its own name only (`FileSummary.resolveImports` appends the declaration unchanged), so `M`
// is unknown: Resolve refuses `M::mk` (E0106). Expected: 42, as with `import m.{N}` and `N`.
// Owner: R-0492 / R-0514 (an import binds the local spelling to the declaration's identity). Pinned
// as an open-bug reproducer (compile-fails).
mod m {
    pub newtype N = i64;
    impl N { pub fn mk(x: i64) -> N { return N(x); } pub fn get(self) -> i64 { return self.0; } }
}
import m.{N as M};
fn main() -> Int { let a: M = M::mk(42); return a.get(); }
