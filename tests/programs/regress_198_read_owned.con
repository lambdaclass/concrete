// Bug 198 (T-RAWDUP): the intrinsic `read_owned(p)` is the one way to move a non-Copy value out of
// raw memory; the slot is then logically uninitialized until a value is stored back. A heap cell is
// moved out of a slot, the slot is refilled, and both cells are freed exactly once; a pointer
// spelled through an alias works; a Copy pointee still reads with `*p`. Exit 42, binary = --interp.
struct Copy B { v: Int }

type HP = *mut Heap<B>;

trusted fn take_and_replace(slot: &mut Heap<B>, fresh: Heap<B>) -> Heap<B> {
    let p: *mut Heap<B> = slot as HP;
    let old: Heap<B> = read_owned(p as HP);
    *p = fresh;
    return old;
}

trusted fn read_int(p: *mut Int) -> Int {
    return *p;
}

fn main() with(Alloc) -> Int {
    let mut h: Heap<B> = alloc(B { v: 40 });
    let old: Heap<B> = take_and_replace(&mut h, alloc(B { v: 2 }));
    let a: B = free(old);
    let b: B = free(h);
    let mut n: Int = 0;
    let s: Int = read_int(&mut n as *mut Int);
    return a.v + b.v + s;
}
