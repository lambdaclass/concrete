// Bug 233: MOD-2 lets a `pub` declaration cross a module boundary by import, but no import binds a
// constant (Core names a constant by its bare spelling, bug 132, so an imported one could not be
// told from the importer's own). Resolve admitted the import and bound nothing, and Check refused it
// as "'BASE' is not public in module 'cfg'", which it is. Now refused at Resolve with the reason
// (E0126). The bug stays open until constants carry their declaration's identity (R-0492).
mod cfg {
    pub const BASE: i32 = 42;
}

import cfg.{BASE};

fn main() -> Int {
    return BASE as Int;
}
