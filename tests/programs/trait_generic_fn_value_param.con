// Bug 091 normalized place rule (integration review): a callback that only RECEIVES the
// type parameter (`f: fn(T) -> Int`) is not storage, so instantiating T = &Int is allowed.
fn read(x: &Int) -> Int { return *x; }
fn apply<T>(x: T, f: fn(T) -> Int) -> Int {
    return f(x);
}
fn main() -> Int {
    let v: Int = 7;
    return apply::<&Int>(&v, read);
}
