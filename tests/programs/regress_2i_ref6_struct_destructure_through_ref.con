// Exit 2i REF-6@1: a struct destructure through `&S` binds value fields; Elab's internal
// `__destr_S` temporary holds the reference and is not a source `let`, so the post-mono check
// must not refuse it (exit 2i review). Run 42, binary = --interp.
struct Copy S { x: Int, y: Int }

fn read(s: &S) -> Int {
    let S { x, y } = s;
    return x + y;
}

fn main() -> Int {
    let s: S = S { x: 40, y: 2 };
    return read(&s);
}
