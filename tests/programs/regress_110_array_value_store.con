// Bug 110: two shapes stored an array SSA value (a pointer to its storage) as if
// it were the aggregate, which llvm-as rejected:
//  1. `a[1] = [3, 4]` on `[[i32; 2]; 2]`: the literal was elaborated unhinted as
//     `[Int; 2]` and "coerced" to `[i32; 2]` by a whole-array cast (which, had it
//     compiled, reinterpreted the bytes: 3, 0 rather than 3, 4).
//  2. `x as *mut u8` on an array local: the cast stored the pointer as the array.
//  3. (found with the fix) a newtype wrap of an array, `Buf(x)`: the same-LLVM-type
//     cast spilled the array pointer into a slot typed as the array.
// The interpreter refuses the pointer and newtype casts, so this is native-only.
newtype Buf = [i32; 3];

fn buf_sum(b: Buf) -> i32 {
    let a: [i32; 3] = b.0;
    return a[0] + a[1] + a[2];
}
fn set_row(m: &mut [[i32; 2]; 2]) {
    m[0] = [7, 8];
}

fn first_byte(x: [u8; 3]) with(Unsafe) -> u8 {
    let p: *mut u8 = x as *mut u8;
    return *p;
}

fn main() with(Unsafe) -> i32 {
    let mut a: [[i32; 2]; 2] = [[1, 2], [9, 9]];
    a[1] = [3, 4];
    if a[1][0] != 3 { return 1; }
    if a[1][1] != 4 { return 2; }
    set_row(&mut a);
    if a[0][0] != 7 { return 3; }
    if a[0][1] != 8 { return 4; }
    let mut w: [[u8; 2]; 2] = [[0, 0], [0, 0]];
    w[0] = [200, 1];
    if w[0][0] != 200 { return 5; }
    if w[0][1] != 1 { return 6; }
    let bytes: [u8; 3] = [104, 105, 0];
    if first_byte(bytes) != 104 { return 7; }
    let q: *mut u8 = bytes as *mut u8;
    if *q != 104 { return 8; }
    let raw: [i32; 3] = [10, 20, 12];
    if buf_sum(Buf(raw)) != 42 { return 9; }
    return a[1][0] + a[1][1] + a[0][0] + a[0][1] + 20;
}
