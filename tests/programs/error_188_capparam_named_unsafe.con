// Bug 188: a capability parameter may not be spelled like a capability. Inside a
// fn-pointer type a variable is a plain name, so `<cap Unsafe>` would hold the real
// `Unsafe` by name without being granted it (E0121).
fn launder<cap Unsafe>(f: fn(i32) with(Unsafe) -> i32, p: *const i32) with(Unsafe) -> i32 {
    return f(*p);
}

fn add_one(x: i32) -> i32 { return x + 1; }

fn main() -> i32 {
    let v: i32 = 41;
    return launder(add_one, &v as *const i32);
}
