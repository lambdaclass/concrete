// Exit 2i SCOPE-1@1 migration twin of error_2i_scope1_destructure.con: a destructuring `let` binder reuses an outer `let`, with the new binder renamed
// (the §15.5 rewrite). Run 42, binary = --interp.
struct P { v: Int, w: Int }

fn main() -> Int {
    let v: Int = 40;
    let p: P = P { v: 1, w: 1 };
    let P { v: pv, w } = p;
    return v + pv + w;
}
