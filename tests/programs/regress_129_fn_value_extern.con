// Bug 129 (fixed), Codex round 2: an imported extern taken as a function VALUE binds C too.
// `let f: fn(i32) -> i32 = abs;` is devirtualized to a direct call of `abs`, which must stay
// C's `abs` although module `d` defines a Concrete `abs`. Expected: 5 + 100 = 105.
mod c {
    pub trusted extern fn abs(x: i32) with() -> i32;
}
mod d {
    pub fn abs(x: i32) -> i32 {
        return 100;
    }
}
mod u {
    import c.{abs};
    pub fn call_c() -> i32 {
        let f: fn(i32) -> i32 = abs;
        return f(0 - 5);
    }
}
mod m {
    import u.{call_c};
    import d.{abs};
    pub fn main() -> i32 {
        return call_c() + abs(1);
    }
}
