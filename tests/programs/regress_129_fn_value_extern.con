// Bug 129 (fixed), Codex round 2: an imported extern reached through a function VALUE binds C too.
// Since bug 166 (D4) an extern is never itself a value (E0588), so the value is a Concrete wrapper
// whose body calls the imported `abs` directly; that call must stay C's `abs` although module `d`
// defines a Concrete `abs`. Expected: 5 + 100 = 105.
mod c {
    pub trusted extern fn abs(x: i32) with() -> i32;
}
mod d {
    pub fn abs(x: i32) -> i32 {
        return 100;
    }
}
mod u {
    import c.{abs};
    fn c_abs(x: i32) -> i32 {
        return abs(x);
    }
    pub fn call_c() -> i32 {
        let f: fn(i32) -> i32 = c_abs;
        return f(0 - 5);
    }
}
mod m {
    import u.{call_c};
    import d.{abs};
    pub fn main() -> i32 {
        return call_c() + abs(1);
    }
}
