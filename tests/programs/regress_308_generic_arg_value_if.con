// Bug 308: generic inference peeks each argument's type before checking it, and the peek had no
// case for a value `if` or `match`: a bare type parameter given only such an argument was left
// unbound, and Check refused the call (E0220, "expected <unknown>"). The peek now reads an arm's
// trailing value.
fn gid<T>(x: T) -> T {
    return x;
}

fn if_arg(c: bool) -> i64 {
    return gid(if c { 1 } else { 2 });
}

fn match_arg(k: i64) -> i64 {
    return gid(match k { 0 => 10, _ => 20 });
}

// The first arm's value is an arm-local binding written with its type.
fn local_arm(c: bool) -> i64 {
    return gid(if c {
        let t: i64 = 5;
        t
    } else {
        7
    });
}

// Both arms' values are arm-local bindings written with their type.
fn both_local(c: bool) -> i64 {
    return gid(if c {
        let x: i64 = 1;
        x
    } else {
        let y: i64 = 2;
        y
    });
}

// Arms that assign before their value bind nothing.
fn assigning(c: bool) -> i64 {
    let mut x: i64 = 0;
    let r: i64 = gid(if c {
        x = 1;
        2
    } else {
        x = 2;
        3
    });
    return r + x;
}

// A wildcard arm binds nothing.
fn wildcard(k: i64) -> i64 {
    return gid(match k { _ => 6 });
}

fn main() -> Int {
    // 2 + 20 + 7 + 2 + 6 + 5 (3 + 2) = 42
    return (if_arg(false) + match_arg(1) + local_arm(false) + both_local(false) + wildcard(3)
        + assigning(false)) as Int;
}
