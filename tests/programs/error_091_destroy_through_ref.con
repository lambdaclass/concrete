// Bug 091 round 3 (Codex): admitting Destroy's by-value receiver (0aacb889) left
// generic `x.destroy()` checked against a BORROWED receiver, so this program
// consumed an owner through `&T` while the owner stayed live and was destroyed
// again (compiled and --interp printed 2: one owner, two destructor runs).
// `Destroy::destroy` consumes its receiver; through a reference it is E0290
// outside trusted drop glue.
mod m {
    struct Tracked { cell: *mut u64 }
    trusted impl Destroy for Tracked {
        fn destroy(self) {
            let Tracked { cell } = self;
            *cell = *cell + 1;
        }
    }
    fn kill<T: Destroy>(x: &T) with(Alloc) {
        x.destroy();
    }
    trusted fn count(p: *mut u64) -> u64 { return *p; }
    fn main() with(Std, Unsafe) -> Int {
        let mut c: u64 = 0;
        let cell: *mut u64 = &mut c as *mut u64;
        let t: Tracked = Tracked { cell: cell };
        kill::<Tracked>(&t);
        destroy(t);
        print_int(count(cell) as i64);
        print_char(10);
        return 0;
    }
}
