// Exit 2i REF-6@2 (MEMORY_SEMANTICS §15.3): a destructuring `let ... else` through a borrowed
// scrutinee would bind a reference by `let` (here in an impl method, which desugarStmts did not
// visit before exit 2i: the binder was undeclared, E0201). Rejected: E0302.
struct P { n: Int }
struct S { k: Int }
impl S {
    fn get(&self, o: &Option<P>) -> Int {
        let Option::Some { value } = o else {
            return 0;
        };
        return value.n + self.k;
    }
}

fn main() -> Int {
    let s: S = S { k: 2 };
    let o: Option<P> = Option::Some { value: P { n: 40 } };
    let out: Int = s.get(&o);
    match o {
        Option::Some { value: inner } => { let P { n } = inner; },
        Option::None => {}
    }
    let S { k } = s;
    return out + k * 0;
}
