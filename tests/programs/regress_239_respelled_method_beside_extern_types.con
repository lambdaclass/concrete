// Bug 239 (FIXED), Codex review r7: the respelled `outer_a_P`'s static method `get(p: P)` called as
// `P::get(..)` beside `user`'s extern `outer_a_P_get(x: i32)`, the caller spelling of the method.
// The type-agreement backstop looked the call up by spelling and compared the method's argument
// with the extern's `i32` (E0299, "two modules' same-named types meet here"); a method call is
// compared with the method.
// Expected: 42, natively and --interp.
mod outer {
    mod a {
        pub struct Copy P { pub v: i32 }
        impl P {
            pub fn get(p: P) -> i32 { return p.v; }
        }
    }
    mod b {
        pub struct Copy P { pub w: i32 }
    }
}
mod user {
    import outer.a.{P};
    #[link_name = "abs"]
    trusted extern fn outer_a_P_get(x: i32) with() -> i32;
    pub fn run() -> i32 {
        return P::get(P { v: 42 });
    }
}
fn main() -> Int {
    return user::run() as Int;
}
