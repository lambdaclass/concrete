// Bug 186 / TC-2 (E0591): a blanket impl over a type parameter overlaps every other impl of
// its trait. Before, `impl<T> Tr for T` was accepted as an impl for a type NAMED `T`.
trait Tr { fn m(&self) -> Int; }
struct Copy Foo { a: Int }
impl<T> Tr for T { fn m(&self) -> Int { return 3; } }
impl Tr for Foo { fn m(&self) -> Int { return 4; } }
fn call<T: Tr>(x: &T) -> Int { return x.m(); }
pub fn main() -> Int { let f: Foo = Foo { a: 0 }; return call::<Foo>(&f); }
