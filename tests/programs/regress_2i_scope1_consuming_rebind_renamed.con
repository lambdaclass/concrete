// Exit 2i SCOPE-1@1 migration twin of error_2i_scope1_consuming_rebind.con: `let s = transform(s)` reuses `s` although its initializer consumed it, with the new binder renamed
// (the §15.5 rewrite). Run 42, binary = --interp.
struct S { n: Int }

fn transform(s: S) -> S {
    let S { n } = s;
    return S { n: n + 1 };
}

fn main() -> Int {
    let mut s: S = S { n: 41 };
    s = transform(s);
    let S { n } = s;
    return n;
}
