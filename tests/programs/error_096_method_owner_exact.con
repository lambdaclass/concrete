// Bug 096 (Codex round 4): `A_B_get` is A_B's `get` (module c), not A's `B_get`; its return
// type is c's P while b binds P to a's. Refused (E0299).
mod a { pub struct Copy A { pub v: i64 } pub struct Copy P { pub pad: i64, pub pad2: i64, pub x: i64 } }
mod c {
    pub struct Copy P { pub x: i64 }
    pub struct Copy A_B { pub v: i64 }
    impl A_B { pub fn get(&self) -> P { return P { x: self.v }; } }
}
mod b {
    import a.{ A, P };
    import c.{ A_B };
    pub fn probe() -> i64 { let o: A_B = A_B { v: 9 }; return o.get().x; }
}
mod main { import b.{ probe }; fn main() with(Std) -> Int { print_int(probe()); print_char(10); return 0; } }
