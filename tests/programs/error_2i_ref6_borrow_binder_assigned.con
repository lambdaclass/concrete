// Exit 2i REF-6@1 (MEMORY_SEMANTICS §15.3): a borrow-block reference is assigned another reference. Rejected: E0303.
fn read(r: &Int) -> Int {
    return *r;
}

fn main() -> Int {
    let x: Int = 1;
    let y: Int = 42;
    let mut out: Int = 0;
    borrow x as r in R {
        r = &y;
        out = read(r);
    }
    return out;
}
