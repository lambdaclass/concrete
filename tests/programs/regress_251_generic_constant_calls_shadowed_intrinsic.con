// Bug 251 (fixed, Codex review): as regress_251_generic_calls_shadowed_intrinsic, through a
// constant whose initializer calls `a`'s `fn sizeof`. Binary and --interp return 40.
mod a {
    fn sizeof() -> u64 { return 40; }
    const K: u64 = sizeof();
    pub fn get<T: Copy>(x: T) -> u64 { return K; }
}
import a.{get};
fn main() -> Int { return get::<Int>(0) as Int; }
