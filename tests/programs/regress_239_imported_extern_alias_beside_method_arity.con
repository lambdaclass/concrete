// Bug 239 (FIXED), Codex review r19 control: `user` calls the extern `ffi.P_get`, imported as
// `ext`, while the root's method `P::get(x, y)` has the Core name `P_get`. CoreCheck must check the
// call against the extern, not the method of the declared name (an intermediate version of this
// fix reported E0522, "expects 2 args").
// Expected: 42 (`abs(-42)`), natively and --interp.
struct Copy P { v: i32 }
impl P {
    fn get(x: i32, y: i32) -> i32 { return x; }
}
mod ffi {
    #[link_name = "abs"]
    pub trusted extern fn P_get(x: i32) with() -> i32;
}
mod user {
    import ffi.{P_get as ext};
    pub fn run() -> i32 { return ext(-42); }
}
fn main() -> Int {
    return user::run() as Int;
}
