// Bug 242: two imported types of one spelling, each with a method `mk`, called as `M::mk` (the alias of
// `m.P`) and `P::mk` (`q.P`). Each call names its own type's method, but Core still calls a method
// by its mangled spelling, `P_mk` for both, so Check refuses the second (E0299, bug 223's
// refusal) instead of letting one call reach the other's method.
mod m {
    pub struct Copy P { v: i64 }
    impl P { pub fn mk(x: i64) -> P { return P { v: x }; } pub fn get(self) -> i64 { return self.v; } }
}
mod q {
    pub struct Copy P { w: i32 }
    impl P { pub fn mk(x: i32) -> P { return P { w: x * 100 }; } pub fn get(self) -> i64 { return self.w as i64; } }
}
import m.{P as M};
import q.{P};
fn main() -> Int { let a: M = M::mk(40); let b: P = P::mk(2); return a.get() + b.get() / 100; }
