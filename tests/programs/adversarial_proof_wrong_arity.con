// This file defines parse_byte with only one parameter, so the stored subject
// (signature and body) no longer matches.
//
// Expected: parse_byte → enforced (proof stale or just enforced, not proved)

#[spec(Concrete.Proof.parseByteExpr)]
#[proof_by(Concrete.Proof.parse_byte_correct)]
