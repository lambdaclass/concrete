// Bug 343 (MOD-1): another module's private fn m_f captured main's qualified call m::f() (exit 7).
// Contained: refused (E0299).
mod m {
    pub fn f() -> u8 {
        return 42;
    }
}

mod z {
    fn m_f() -> u8 {
        return 7;
    }

    pub fn g() -> u8 {
        return m_f();
    }
}

fn main() -> u8 {
    if z::g() != 7 {
        return 1;
    }
    return m::f();
}
