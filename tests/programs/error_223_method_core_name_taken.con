// Bug 223 (R-0492 step 3, Codex review): a method is found by its type's identity but called in
// Core by its mangled name; a free function of that name here would receive the call. Refused
// (E0299), where the spelled lookup used to select the free function's signature.
mod a {
    pub struct Copy P {}
    impl P { pub fn mk() -> i64 { return 42; } }
}
import a.{P};
fn P_mk() -> bool { return true; }
fn main() -> Int { return P::mk(); }
