// Bug 091 round 3 (Codex review, eighth pass): `(w).0.destroy()` is `w.0.destroy()` — it moves
// the whole owned newtype's payload and destroys it exactly once (was a false E0290).
// Expected (compiled): 1. Compiled-only: the interpreter does not model newtype casts.
mod m {
    struct P { n: i64, cell: *mut u64 }
    newtype W = P;
    trusted impl Destroy for P { fn destroy(&self) { *self.cell = *self.cell + 1; } }
    trusted fn count(p: *mut u64) -> u64 { return *p; }
    fn main() with(Std, Unsafe) -> Int {
        let mut c: u64 = 0;
        let cell: *mut u64 = &mut c as *mut u64;
        let w: W = W(P { n: 1, cell: cell });
        (w).0.destroy();
        print_int(count(cell) as i64);
        print_char(10);
        return 0;
    }
}
