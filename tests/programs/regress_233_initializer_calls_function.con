// Bug 233 (R-0492 step 4, Codex review): an imported constant's initializer calls a function of a
// third module; that function reads its own module's `H`, which the initializer's scope (`cfg`'s
// constants) does not hold, in the binary and under --interp alike. Returns 42.
mod helper {
    const H: i32 = 42;
    pub fn get() -> i32 { return H; }
}
mod cfg {
    import helper.{get};
    const K: i32 = 7;
    pub const X: i32 = get();
}
import cfg.{X};
fn main() -> Int { return X as Int; }
