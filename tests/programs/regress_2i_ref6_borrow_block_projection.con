// Exit 2i REF-6@2 (MEMORY_SEMANTICS §15.3): a borrow block names the owner, and each use borrows a projection of the binder (`f(&rw.p)`); also the twin of the borrow-block copy rows. Run 42, binary = --interp.
struct P { n: Int }
struct W { p: P, q: P }

fn get(r: &P) -> Int {
    return r.n;
}

fn main() -> Int {
    let w: W = W { p: P { n: 21 }, q: P { n: 0 } };
    let mut out: Int = 0;
    borrow w as rw in R {
        out = get(&rw.p) + get(&rw.p);
    }
    let W { p, q } = w;
    let P { n } = p;
    let P { n: m } = q;
    return out + n * 0 + m;
}
