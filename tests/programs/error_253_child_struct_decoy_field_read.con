// Bug 253 (fixed): reading `m.P`'s private field outside `m`, admitted because a child of the
// reader declares a `P`. E0298.
mod outer {
    mod m { pub struct Copy P { v: i64 } pub fn mk() -> P { return P { v: 42 }; } }
    mod user {
        mod decoy { struct Copy P { v: i64 } }
        import m.{P, mk};
        pub fn run() -> i64 { let x: P = mk(); return x.v; }
    }
    import user.{run};
    pub fn main() -> i64 { return run(); }
}
