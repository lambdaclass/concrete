// Bug 091 round 3: the concrete spelling of the `&mut &T` receiver — `x.bump()`
// on `x: &P` for an inherent `&mut self` method (the compiled binary aborted,
// --interp failed). Refused: E0237.
mod m {
    struct P { a: i64, b: i64 }
    impl P {
        fn bump(&mut self) { self.b = self.b + 1; }
    }
    fn f(x: &P) { x.bump(); }
    fn main() -> Int {
        let p: P = P { a: 1, b: 2 };
        f(&p);
        let P { a, b } = p;
        return a + b;
    }
}
