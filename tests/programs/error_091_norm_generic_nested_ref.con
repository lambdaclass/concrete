// Since batch 4 (bug 092), storing a reference in an aggregate is itself refused at the
// declaration (E0239), which fires first; the place rule's E0238 below stays as defense in depth.
// Normalized place rule (Codex static review): the rule checks a generic body once, at its
// opaque `T`. `forward::<&P>` would let the body read a `T` (a stored reference) out of
// `w: &W<T>` that the rule never saw, so instantiating a type parameter with a reference where
// it occurs inside a parameter type is refused: E0238.
mod m {
    struct P { n: i64 }
    struct W<T> { v: T }
    fn show(p: &P) { }
    fn forward<T: Copy>(w: &W<T>, f: fn(T)) { f(w.v); }
    fn main() -> Int {
        let p: P = P { n: 1 };
        let w: W<&P> = W::<&P> { v: &p };
        forward::<&P>(&w, show);
        let W { v } = w;
        let P { n } = p;
        return n;
    }
}
