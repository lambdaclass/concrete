// Bug 091 round 3: the implicit `&mut` borrow of a `&mut self` receiver obeys
// the explicit borrow's aliasing rule — `y` is shared-borrowed by a live `r`,
// so `y.bump()` (a `&mut y`) is E0232, through a trait bound as concretely.
mod m {
    trait Bump {
        fn bump(&mut self);
        fn get(&self) -> i64;
    }
    struct P { a: i64, b: i64 }
    impl Bump for P {
        fn bump(&mut self) { self.b = self.b + 1; }
        fn get(&self) -> i64 { return self.b; }
    }
    fn g<T: Bump>(x: T) -> T {
        let mut y: T = x;
        let r: &T = &y;
        y.bump();
        let n: i64 = r.get();
        return y;
    }
    fn main() -> Int {
        let p: P = g::<P>(P { a: 1, b: 2 });
        let P { a, b } = p;
        return a + b;
    }
}
