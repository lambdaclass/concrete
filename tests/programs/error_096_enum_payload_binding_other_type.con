// Bug 096 (Codex round 9): b matches c's E::V { p }, whose payload is c's P, while b binds
// P to a's; the arm binder's type and the payload disagree (native read 99, --interp 7).
// Refused (E0299).
mod a {
    pub struct Copy P { pub x: i64, pub pad: i64 }
}
mod c {
    pub struct Copy P { pub pad: i64, pub x: i64 }
    pub enum Copy E { V { p: P } }
    pub fn mk() -> E {
        return E::V { p: P { pad: 99, x: 7 } };
    }
}
mod b {
    import a.{ P };
    import c.{ E, mk };
    pub fn probe() -> i64 {
        return match mk() { E::V { p } => p.x };
    }
}
mod main {
    import b.{ probe };
    fn main() with(Std) -> Int {
        print_int(probe()); print_char(10); return 0;
    }
}
