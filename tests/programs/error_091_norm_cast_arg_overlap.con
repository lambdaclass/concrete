// Normalized place rule (Codex review): a cast to a reference (`r as &P`) is an argument
// borrow of what its operand points to, so it overlaps the exclusive receiver `r`. E0293.
mod m {
    struct P { n: i64 }
    impl P {
        fn bump(&mut self, other: &P) -> i64 { self.n = self.n + 1; return other.n; }
    }
    fn f(r: &mut P) -> i64 { return r.bump(r as &P); }
    fn main() -> Int { let mut p: P = P { n: 1 }; let x: i64 = f(&mut p); let P { n } = p; return x; }
}
