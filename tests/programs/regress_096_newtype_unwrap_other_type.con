// Since bug 242 (an imported signature's types carry their declaration) this program is valid:
// the type that crosses the import is the defining module's, and both backends print 7.
// Bug 096 (Codex round 14): c's newtype W wraps c's P; b unwraps it as a's P (`mk().0.x` in a
// constant). The backstop checks newtype constructors and unwraps.
mod a { pub struct Copy P { pub x: i64, pub pad: i64 } }
mod c {
    pub struct Copy P { pub pad: i64, pub x: i64 }
    pub newtype W = P;
    pub fn mk() -> W { return W(P { pad: 99, x: 7 }); }
}
mod b {
    import a.{ P };
    import c.{ W, mk };
    const ANSWER: i64 = mk().0.x;
    fn main() with(Std) -> Int {
        print_int(ANSWER); print_char(10); return 0;
    }
}
