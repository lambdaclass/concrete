// Bug 091 round 3: the explicit `&mut (*r)` with `r: &P` (not only the implicit receiver
// borrow) mutated through a shared reference. Expected: E0237.
mod m {
    struct P { n: i64 }
    fn bump(q: &mut P) { q.n = q.n + 1; }
    fn bad(r: &P) { bump(&mut (*r)); }
    fn main() -> Int {
        let p: P = P { n: 1 };
        bad(&p);
        let P { n } = p;
        return n;
    }
}
