// Exit 2i REF-8@2 (MEMORY_SEMANTICS §15.3): the owner is freed after the borrow block over it ends. Run 42 (binary; the interpreter has no heap allocation).
struct Copy B { v: Int }

fn read(r: &Int) -> Int {
    return *r;
}

fn main() with(Std) -> Int {
    let h: Heap<B> = alloc(B { v: 42 });
    let mut out: Int = 0;
    borrow h as r in R {
        out = 42;
    }
    out = read(&h.v) * 0 + out;
    free(h);
    return out;
}
