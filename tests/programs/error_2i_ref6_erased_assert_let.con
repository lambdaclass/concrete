// Exit 2i REF-6@2: a `let` of a type-parameter type inside an `assert` condition. The condition
// is erased before monomorphization, so post-mono never sees the binding at `T := &Int`; it is
// refused at Check (exit 2i review). Rejected: E0302.
fn probe<T: Copy>(x: T) -> Int {
    assert(if true { let y: T = x; true } else { true });
    return 42;
}

fn main() -> Int {
    let n: Int = 1;
    return probe::<&Int>(&n);
}
