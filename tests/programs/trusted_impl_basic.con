// Trusted methods (each declares `trusted fn`; an impl block confers no trust, bug 189) can do pointer casts without with(Unsafe) — compiles successfully
struct Wrapper {
    value: i32,
}

impl Wrapper {
    trusted fn cast_ref(p: *const i32) -> *const u8 {
        let q: *const u8 = p as *const u8;
        return q;
    }
}

fn main() -> i32 {
    return 0;
}
