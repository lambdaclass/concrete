// Bug 091 round 3: the implicit `&mut` borrow of a `&mut self` receiver obeys
// the explicit `&mut y` rules — an immutable binding cannot be mutably borrowed
// (E0233), through a trait bound or not.
mod m {
    trait Bump { fn bump(&mut self); }
    struct P { a: i64, b: i64 }
    impl Bump for P {
        fn bump(&mut self) { self.b = self.b + 1; }
    }
    fn g<T: Bump>(x: T) -> T {
        let y: T = x;
        y.bump();
        return y;
    }
    fn main() -> Int {
        let p: P = g::<P>(P { a: 1, b: 2 });
        let P { a, b } = p;
        return a + b;
    }
}
