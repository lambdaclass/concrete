// Bug 091 gate regression (batch 2): E0587 required the builtin Destroy method's
// receiver to be exactly `&self`, refusing the canonical by-value terminal form
// `fn destroy(self) { let T { .. } = self; }` (OWNERSHIP_MODEL.md H17) used by
// fixtures and gates. Both receivers are admitted; a by-value destructor runs
// through generic `x.destroy()` and through `destroy(t)`. Expect 2 (compiled and
// --interp).
mod m {
    struct Tracked { cell: *mut u64 }
    trusted impl Destroy for Tracked {
        fn destroy(self) {
            let Tracked { cell } = self;
            *cell = *cell + 1;
        }
    }
    fn kill<T: Destroy>(x: &T) with(Alloc) {
        x.destroy();
    }
    trusted fn count(p: *mut u64) -> u64 { return *p; }
    fn main() with(Std, Unsafe) -> Int {
        let mut c: u64 = 0;
        let cell: *mut u64 = &mut c as *mut u64;
        let t: Tracked = Tracked { cell: cell };
        kill::<Tracked>(&t);
        destroy(t);
        print_int(count(cell) as i64);
        print_char(10);
        return 0;
    }
}
