// Normalized place rule (Codex review): passing the parent `r` as a `&mut` argument while its
// exclusive reborrow `s` is live is a use of `r` (E0232), as `r.bump()` is.
mod m {
    struct P { n: i64 }
    impl P { fn bump(&mut self) { self.n = self.n + 1; } }
    fn main() -> Int {
        let mut p: P = P { n: 1 };
        if true {
            let r: &mut P = &mut p;
            let s: &mut P = &mut *r;
            P::bump(r);
            P::bump(s);
        }
        let P { n } = p;
        return n;
    }
}
