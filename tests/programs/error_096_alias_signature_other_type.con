// Bug 096 (Codex round 6): c's read takes `&Q`, c's alias of a's P; main passes its own Q.
// The backstop sees a_P declared and main's Q given, and refuses it (E0299).
mod a { pub struct Copy P { pub x: i64, pub pad: i64 } }
mod z { pub struct Copy P { pub unused: i64 } }
mod c {
    import a.{ P as Q };
    pub fn read(p: &Q) -> i64 { return p.x; }
}
mod main {
    import c.{ read };
    struct Copy Q { pub pad: i64, pub x: i64 }
    fn main() with(Std) -> Int {
        let q: Q = Q { pad: 99, x: 7 };
        print_int(read(&q));
        print_char(10);
        return 0;
    }
}
