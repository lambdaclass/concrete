// Bug 200: a generic type named without its argument list was accepted (this program
// compiled and returned 42). It must be rejected with E0113, as `Box1<Int, bool>` is.
struct Copy Box1<T> { v: Int }

fn get(b: Box1) -> Int {
    return b.v;
}

fn main() -> Int {
    return get(Box1::<Int> { v: 42 });
}
