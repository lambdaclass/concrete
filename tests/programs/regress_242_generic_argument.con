// Bug 242 (fixed): a generic imported type's argument beside the importer's own type of that spelling. The transported type keeps its declaration. Binary and --interp return 42.
mod m {
    pub struct Copy P { pub v: i64 }
    pub struct Copy W<T> { pub x: T }
    pub fn wrap(n: i64) -> W<P> { return W::<P> { x: P { v: n } }; }
}
import m.{W, wrap};
struct Copy P { w: i64 }
fn main() -> Int { let a: W<P> = W::<P> { x: P { w: 2 } }; let b = wrap(40); return b.x.v + a.x.w; }
