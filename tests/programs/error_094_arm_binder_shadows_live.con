// Bug 094: an enum-arm binder shadowing a LIVE linear binding. Consuming the
// binder marked the outer `value` consumed too, so on the Some path the outer
// Heap<Int> leaked (the None arm's free(value) is the outer one). Consumption
// now marks only the binder, so the arms disagree on the outer `value` (E0209).
fn mk(k: Int) with(Alloc) -> Option<Heap<Int>> { return Option::Some { value: alloc(k) }; }
fn main() with(Std) -> Int {
    let value: Heap<Int> = alloc(5);
    match mk(7) {
        Option::Some { value } => { free(value); },
        Option::None => { free(value); },
    }
    return 0;
}
