// Bug 092 positive control: references still flow DOWN — reference arguments (a
// `let` may not bind a reference since exit 2i REF-6@2; the old `let r = &h` became
// a borrow at each use), and a struct holding a fn pointer whose parameter is a
// reference (a fn pointer stores no reference). A borrow-block binder over a Heap
// passed to a `&Heap<B>` parameter is miscompiled (bug 126, borrow-block form).
struct Copy B { v: Int }
struct Ops { f: fn(&Heap<B>) -> Int }
fn read(h: &Heap<B>) -> Int { return h.v; }
fn both(a: &Heap<B>, b: &Heap<B>) -> Int { return a.v + b.v; }
fn main() with(Std) -> Int {
    let h: Heap<B> = alloc(B { v: 20 });
    let ops: Ops = Ops { f: read };
    let Ops { f } = ops;
    let mut out: Int = 0;
    if true {
        out = both(&h, &h) + f(&h) - read(&h);
    }
    free(h);
    return out + 2;
}
