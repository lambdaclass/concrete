// Bug 146 positive control: `*h` moves the value out of the cell and frees it (run_tests.sh checks
// the emitted SSA calls @free). Prints 42.
struct Copy P { x: Int }
fn main() with(Alloc, Console) -> Int {
    let h: Heap<P> = alloc(P { x: 42 });
    let p: P = *h;
    print_int(p.x);
    return 0;
}
