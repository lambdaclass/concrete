// Bug 242 (fixed): an aliased type's `-> Self` method beside the importer's own type of the definition's spelling. The transported type keeps its declaration. Binary and --interp return 42.
mod m {
    pub struct Copy P { v: i64 }
    impl P { pub fn mk(x: i64) -> Self { return P { v: x }; } pub fn get(self) -> i64 { return self.v; } }
}
import m.{P as Q};
struct Copy P { w: i64 }
fn main() -> Int { let q: Q = Q::mk(40); let mine: P = P { w: 2 }; return q.get() + mine.w; }
