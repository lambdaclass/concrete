// Exit 2i SCOPE-1@1 migration twin of error_2i_scope1_block_let.con: a `let` in an `if` block reuses an outer `let`, with the new binder renamed
// (the §15.5 rewrite). Run 42, binary = --interp.
fn main() -> Int {
    let x: Int = 1;
    if true {
        let inner_x: Int = 100;
        if inner_x != 100 { return 0; }
    }
    return x + 41;
}
