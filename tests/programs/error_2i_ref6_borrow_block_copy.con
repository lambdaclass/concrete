// Exit 2i REF-6@2 (MEMORY_SEMANTICS §15.3): a `let` copies a borrow-block reference out of its binder. Rejected: E0302 (before: E0234).
fn read(r: &Int) -> Int {
    return *r;
}

fn main() -> Int {
    let x: Int = 42;
    let mut out: Int = 0;
    borrow x as r in R {
        let s: &Int = r;
        out = read(s);
    }
    return out;
}
