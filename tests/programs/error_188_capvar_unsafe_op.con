// Bug 188: a capability variable does not authorize a raw-pointer operation
// (the `Unsafe` operation gate, E0521's predicate). `sneaky` dereferences a raw
// pointer holding only `C`.
fn sneaky<cap C>(f: fn(i32) with(C) -> i32, p: *const i32) with(C) -> i32 {
    return f(*p);
}

fn pure_id(x: i32) -> i32 { return x; }

fn main() -> i32 {
    let x: i32 = 42;
    return sneaky(pure_id, &x as *const i32);
}
