// Bug 262 (control): a child constructing its parent's imported newtype is refused (TYPE-11),
// E0296. It was refused before the fix too; it pins the child-to-parent direction of the rule.
mod outer {
    mod top {
        pub newtype K = i64;
        mod kid {
            import top.{K};
            pub fn mk() -> i64 { let k: K = K(30); return 0; }
        }
        pub fn run() -> i64 { return kid::mk(); }
    }
    import top.{run};
    pub fn main() -> i64 { return run(); }
}
