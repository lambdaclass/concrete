// Error: storing borrow ref into struct field outside block.
// Since bug 092 a struct field may not hold a reference at all, so this is
// rejected at the declaration (E0239) before the escape check (E0234).
struct Holder {
    val: &Int
}

fn main() -> Int {
    let mut x: Int = 10;
    let mut h: Holder = Holder { val: &x };
    borrow x as r in R {
        h.val = r;
    }
    return 0;
}
