// Bug 116: `vec_push(&mut p.v, x)` with `p: &mut P` and `v` P's FIRST field
// lowered to `gep p, 0`, and GEP-zero elimination substituted `p` with its own
// type (`&mut P`), so the call lost its Vec element type and was emitted as the
// undefined, unspecialized `@vec_push`. A later field (a nonzero GEP) worked.
// The first-field Vec is pushed through a reference, read back, and set.
struct P {
    v: Vec<i32>,
    w: Vec<u8>,
}

fn add(p: &mut P, x: i32) with(Alloc) {
    vec_push::<i32>(&mut p.v, x);
}

fn add_byte(p: &mut P, b: u8) with(Alloc) {
    vec_push::<u8>(&mut p.w, b);
}

fn main() with(Alloc) -> Int {
    let mut p: P = P { v: vec_new::<i32>(), w: vec_new::<u8>() };
    add(&mut p, 5);
    add(&mut p, 30);
    add_byte(&mut p, 7);
    let n: Int = vec_len::<i32>(&mut p.v) as Int;
    let s: Int = (vec_get::<i32>(&p.v, 0) + vec_get::<i32>(&p.v, 1)) as Int;
    let b: Int = vec_get::<u8>(&p.w, 0) as Int;
    let P { v, w } = p;
    vec_free::<i32>(v);
    vec_free::<u8>(w);
    // 2 elements, 5 + 30, one byte 7: 2 + 35 + 7 - 2 = 42
    return n + s + b - 2;
}
