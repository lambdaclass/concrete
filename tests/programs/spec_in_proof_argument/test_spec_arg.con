// The specification inside an arbitrary function's proposition argument, in a conclusion that is an
// equation of values. Examples.TestFixtures.Proofs.spec_in_proof_argument proves
// `ignoreProof (eval … add_commutativity = none) h = 0`, which says only that ignoreProof is 0; the
// subject binding reads only direct evaluator applications and whole spec terms, so this claim is
// spec_unbound, never proved.
// Checked by check_subject_binding.sh (leg H).

#[spec(add_commutativity)]
#[proof_by(Examples.TestFixtures.Proofs.spec_in_proof_argument)]
#[proof_fingerprint("v2:7bd7ae4e79b8542ec15512b64e4242ad")]
fn add(a: i64, b: i64) -> i64 {
    return a + b;
}

fn main() -> i64 {
    return add(1, 2);
}
