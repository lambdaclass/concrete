// BUG 081 — a call's KEY must denote the callee it reaches.
//
// The pure core of examples/elf_header under the same package name, so its checks are attested in
// `Concrete.Proof.elfFns` exactly as the example's are. `check_class` is renamed `check_class_orig`
// (its body and proof link unchanged), so nothing here DEFINES `check_class`.
//
// `evil.validate_header` is the example's `validate_header`, body and proof link included, but it
// imports `check_version` AS `check_class`. Its extracted body spells `check_class(cls)` — exactly
// what the specification `validateHeaderExpr` calls — while the call reaches `check_version`.
// Containment ("elfFns holds check_version somewhere") justified that edge, so on 00efbaf4 this was
// `proved`. In elfFns the key `check_class` denotes `main.check_class`: the claim must be refused and
// must not mint. `main` shows the difference at run time: for class 2 (valid) the aliased call
// answers 0, so the program exits 0, where validateHeaderExpr says 1.
//
// Checked by scripts/tests/check_subject_binding.sh (legs X).

// Check ELF magic bytes: 0x7F (127), 0x45 ('E'), 0x4C ('L'), 0x46 ('F').
// Returns 1 if all four bytes match, 0 otherwise.
#[spec(Concrete.Proof.checkMagicExpr)]
#[proof_by(Examples.ElfHeader.Proofs.check_magic_correct)]
#[proof_fingerprint("v2:a669dd14614bc56a33be35aa10226679")]
pub fn check_magic(b0: Int, b1: Int, b2: Int, b3: Int) -> Int {
    if b0 == 127 {
        if b1 == 69 {
            if b2 == 76 {
                if b3 == 70 {
                    return 1;
                } else {
                    return 0;
                }
            } else {
                return 0;
            }
        } else {
            return 0;
        }
    } else {
        return 0;
    }
}

// Check ELF class field: 1 = 32-bit, 2 = 64-bit.
// Returns 1 if valid, 0 otherwise.
#[spec(Concrete.Proof.checkClassExpr)]
#[proof_by(Examples.ElfHeader.Proofs.check_class_correct)]
#[proof_fingerprint("v2:a5b26ee3698719fea42b20621a7efbda")]
fn check_class_orig(cls: Int) -> Int {
    if cls == 1 {
        return 1;
    } else {
        if cls == 2 {
            return 1;
        } else {
            return 0;
        }
    }
}

// Check ELF data encoding: 1 = little-endian, 2 = big-endian.
// Returns 1 if valid, 0 otherwise.
#[spec(Concrete.Proof.checkDataExpr)]
#[proof_by(Examples.ElfHeader.Proofs.check_data_correct)]
#[proof_fingerprint("v2:7ac6fe15f54ef809d5e742d7c5be7dc7")]
pub fn check_data(encoding: Int) -> Int {
    if encoding == 1 {
        return 1;
    } else {
        if encoding == 2 {
            return 1;
        } else {
            return 0;
        }
    }
}

// Check ELF version: must be 1 (EV_CURRENT).
// Returns 1 if valid, 0 otherwise.
#[spec(Concrete.Proof.checkVersionExpr)]
#[proof_by(Examples.ElfHeader.Proofs.check_version_correct)]
#[proof_fingerprint("v2:0d368796ab5dee78d031bac527ddeced")]
pub fn check_version(ver: Int) -> Int {
    if ver == 1 {
        return 1;
    } else {
        return 0;
    }
}

import evil.{ validate_header };

fn main() -> Int {
    return validate_header(127, 69, 76, 70, 2, 1, 1);
}

mod evil {
    import main.{ check_magic, check_version as check_class, check_data, check_version };

    #[spec(Concrete.Proof.validateHeaderExpr)]
    #[proof_by(Examples.ElfHeader.Proofs.validate_header_correct)]
    #[proof_fingerprint("v2:699ea3b7418991f75c805053cd1d23d7")]
    pub fn validate_header(b0: Int, b1: Int, b2: Int, b3: Int,
                       cls: Int, encoding: Int, ver: Int) -> Int {
        let magic_ok: Int = check_magic(b0, b1, b2, b3);
        if magic_ok == 1 {
            let cls_ok: Int = check_class(cls);
            if cls_ok == 1 {
                let enc_ok: Int = check_data(encoding);
                if enc_ok == 1 {
                    let ver_ok: Int = check_version(ver);
                    if ver_ok == 1 {
                        return 1;
                    } else {
                        return 0;
                    }
                } else {
                    return 0;
                }
            } else {
                return 0;
            }
        } else {
            return 0;
        }
    }
}
