// Bug 180 regression: in a project, `--report mono`, `--report verify` and `--report traceability`
// ran Mono and lowering on the invoked file's modules alone, without the dependencies CoreCheck had
// checked them against, under a `ValidatedCore` whose modules had been replaced. The report then
// described a program nothing compiles: `std.math.max` is generic, so its `u16` instance exists only
// in the whole program, and the old report listed no specialization at all.
mod regress_180_report_scope {
    import std.math.{max};

    pub fn main() -> i32 {
        let a: u16 = 40;
        let b: u16 = 42;
        let m: u16 = max(a, b);
        return m as i32;
    }
}
