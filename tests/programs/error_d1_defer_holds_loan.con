// D1: a deferred call holds the loan of the `&mut` reference it was given until it runs, so the
// reference may not be used again before that (E0206).
fn inc(r: &mut Int) {
    *r = *r + 1;
}

fn main() -> Int {
    let mut x: Int = 0;
    borrow mut x as r in R {
        defer inc(r);
        inc(r);
    }
    return x;
}
