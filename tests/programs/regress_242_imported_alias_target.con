// Bug 242 (fixed): an imported alias whose target is a type the importer declares a namesake of. The transported type keeps its declaration. Binary and --interp return 42.
mod m {
    pub struct Copy P { pub v: i64 }
    pub type T = P;
    pub fn mk(n: i64) -> T { return P { v: n }; }
}
import m.{T, mk};
struct Copy P { w: i64 }
fn main() -> Int { let t: T = mk(40); let mine: P = P { w: 2 }; return t.v + mine.w; }
