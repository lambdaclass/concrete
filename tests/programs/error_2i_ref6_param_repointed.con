// Exit 2i REF-6@2 (MEMORY_SEMANTICS §15.3): a reference parameter is re-pointed: at another parameter, and at a block local (the dead-slot read of bug 131). Rejected: E0303.
fn f(r: &Int, q: &Int) -> Int {
    r = q;
    return *r;
}

fn g(r: &Int) -> Int {
    if true {
        let local: Int = 7;
        r = &local;
    }
    return *r;
}

fn main() -> Int {
    let a: Int = 1;
    let b: Int = 41;
    return f(&a, &b) + g(&a) * 0 + 1;
}
