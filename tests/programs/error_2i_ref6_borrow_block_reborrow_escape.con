// Exit 2i REF-6@1 (MEMORY_SEMANTICS §15.3): an outer reference `let` is re-pointed at a borrow-block owner (`out = &*r`). Rejected: E0302 at the outer `let`.
fn read(r: &Int) -> Int {
    return *r;
}

fn main() -> Int {
    let x: Int = 42;
    let y: Int = 0;
    let mut out: &Int = &y;
    borrow x as r in R {
        out = &*r;
    }
    return read(out);
}
