// Bug 186 / TC-4 (E0593): the target's type arguments were parsed and DROPPED, so this impl
// for Box2<i32> implemented Tr for every Box2<_>: a Box2<bool> satisfied the bound and ran the
// i32 body (binary and --interp both returned 7). Silent wrong code.
trait Tr { fn m(&self) -> Int; }
struct Copy Box2<T> { v: Int }
impl Tr for Box2<i32> { fn m(&self) -> Int { return 7; } }
fn call<T: Tr>(x: &T) -> Int { return x.m(); }
pub fn main() -> Int { let b: Box2<bool> = Box2::<bool> { v: 0 }; return call::<Box2<bool>>(&b); }
