// Bug 240 (FIXED), the other type positions: a parameter, a field, a let annotation, a type
// argument and a return type naming a trait are each refused E0108 at Resolve (before the fix a
// parameter `m: Marker` reached Check as an opaque linear type, E0208).
trait Marker {
    fn tag(&self) -> i32;
}
struct Holder { m: Marker }
fn take(m: Marker) -> Int { return 0; }
fn give() -> Marker { return give(); }
fn id<T>(t: T) -> T { return t; }
fn main() -> Int {
    let a: [Marker; 1] = id::<[Marker; 1]>([give()]);
    return 0;
}
