enum Result<T, E> {
    Ok { value: T },
    Err { error: E },
}

enum MyError {
    Bad,
}

fn might_fail(ok: bool) -> Result<Int, MyError> {
    if ok {
        return Result::<Int, MyError>::Ok { value: 42 };
    }
    return Result::<Int, MyError>::Err { error: MyError::Bad };
}

fn use_result() -> Result<Int, MyError> {
    let v: Int = match might_fail(true) {
        Result::Ok { value } => value,
        Result::Err { error } => {
            return Result::<Int, MyError>::Err { error: error };
        },
    };
    return Result::<Int, MyError>::Ok { value: v };
}

fn run() -> Int {
    let r: Result<Int, MyError> = use_result();
    match r {
        Result::Ok { value } => { return value; },
        // bug 197: a bare `Result::Err` dropped the non-Copy `MyError`; consume it instead
        Result::Err { error } => {
            match error {
                MyError::Bad => { return 0; }
            }
        },
    }

}

fn main() with(Console) {
    println((run()));
}
