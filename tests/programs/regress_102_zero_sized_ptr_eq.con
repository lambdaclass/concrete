// Bug 102's interpreter half (Codex review): pointer equality on reference paths compares
// places, but two distinct elements of an array of a zero-sized type share one address in
// the binary (exit 1 here). The interpreter cannot know that from paths alone, so it refuses
// the comparison with an explicit "not modelled" error instead of answering 0.
struct Copy Z {}

trusted fn main() -> Int {
    let a: [Z; 2] = [Z {}, Z {}];
    let p: *const Z = &a[0] as *const Z;
    let q: *const Z = &a[1] as *const Z;
    if p == q { return 1; }
    return 0;
}
