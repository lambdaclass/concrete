// Bug 231: the bounds Resolve now checks still admit every trait Check gives the module: `Copy`,
// the builtin `Destroy` and the module's own traits, at top level and in a nested module, on
// functions, generic structs, impl blocks and their methods. Exits 42 natively and under --interp.
trait Score { fn score(&self) -> i64; }
struct Copy Pt { x: i64 }
impl Score for Pt { fn score(&self) -> i64 { return self.x; } }
struct Copy Wrap<T: Copy> { v: T }
impl<T: Copy> Wrap<T> {
    fn get(&self) -> T { return self.v; }
}
fn total<T: Score + Copy>(a: T, b: T) -> i64 { return a.score() + b.score(); }

mod m {
    pub trait Weigh { fn weight(&self) -> i64; }
    pub struct Copy W { pub n: i64 }
    impl Weigh for W { fn weight(&self) -> i64 { return self.n * 2; } }
    fn heavy<T: Weigh>(x: &T) -> i64 { return x.weight(); }
    pub fn run() -> i64 { let w: W = W { n: 5 }; return heavy(&w); }
}

fn main() -> Int {
    let w: Wrap<i64> = Wrap::<i64> { v: 12 };
    let t: i64 = total(Pt { x: 10 }, Pt { x: 10 });
    return (w.get() + t + m::run()) as Int;
}
