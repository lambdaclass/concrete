// Since batch 4 (bug 092), storing a reference in an aggregate is itself refused at the
// declaration (E0239), which fires first; the place rule's E0238 below stays as defense in depth.
// Normalized place rule (Codex static review): a reference spelled through a type alias
// (`type R = &P`) is still a reference: `w.r.f = 5` writes through an untraced reference. E0238.
mod m {
    struct P { f: i64 }
    type R = &P;
    struct W { r: R }
    fn main() -> Int {
        let p: P = P { f: 1 };
        let w: W = W { r: &p };
        w.r.f = 5;
        let W { r } = w;
        let P { f } = p;
        return f;
    }
}
