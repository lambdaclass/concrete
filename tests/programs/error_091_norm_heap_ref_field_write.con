// Since batch 4 (bug 092), storing a reference in an aggregate is itself refused at the
// declaration (E0239), which fires first; the place rule's E0238 below stays as defense in depth.
// Normalized place rule (Codex static review): `h.r.f = v` with `h: Heap<S>` and `S.r: &P`
// writes through a reference stored in a heap-backed field. The type peek now auto-derefs the
// heap shell, so `h.r` is seen as a reference — untraced (E0238), as `(*h.r).f` is.
mod m {
    struct P { f: i64 }
    struct S { r: &P }
    fn main() with(Alloc) -> Int {
        let p: P = P { f: 1 };
        let h: Heap<S> = alloc(S { r: &p });
        h.r.f = 5;
        let s: S = *h;
        let S { r } = s;
        let P { f } = p;
        return f;
    }
}
