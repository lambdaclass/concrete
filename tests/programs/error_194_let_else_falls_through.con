// Bug 194: a `let ... else` whose `else` block falls through, in a function with a result
// type: the desugared catch-all arm reaches the end. Expected: E0307.
fn get(o: Option<Int>) -> Int {
    let Option::Some { value } = o else {
        let z: Int = 0;
    };
    return value;
}

fn main() -> Int {
    return get(Option::Some { value: 42 });
}
