// Complex test: heap-based linked structure
// Demonstrates Heap<T> fields in structs and chained traversal
// 10 + 20 + 12 = 42
struct Copy Leaf { value: Int }

struct Mid {
    value: Int,
    next: Heap<Leaf>
}

struct Head {
    value: Int,
    next: Heap<Mid>
}

// Heap interiors are linearity-tracked (bug 144): a node's non-Copy field is moved out by
// moving the node out of its cell (`*h`, which frees the cell) and destructuring it.
fn mid_sum(m: Heap<Mid>) with(Alloc) -> Int {
    let Mid { value, next } = *m;
    let v3: Int = next.value;
    free(next);
    return value + v3;
}

fn sum_chain(h: Heap<Head>) with(Alloc) -> Int {
    let Head { value, next } = *h;
    return value + mid_sum(next);
}

fn main() with(Std) -> Int {
    let leaf: Heap<Leaf> = alloc(Leaf { value: 12 });
    let mid: Heap<Mid> = alloc(Mid { value: 20, next: leaf });
    let head: Heap<Head> = alloc(Head { value: 10, next: mid });
    let result: Int = sum_chain(head);
    return result;
}
