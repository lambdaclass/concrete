      (∀ d ∈ divisionDecls, ∃ v, AList.lookup env d.id = some v ∧
        ConstDemo.U.ofC v.ty = d.ty ∧ ConstDemo.U.isCopy (ConstDemo.U.ofC v.ty) = true)) := by
