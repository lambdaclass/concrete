+    ⟨ConstDemo.cid "Q", .c (.int .i8), .plain .div (.int .i8 100) (.int .i8 7)⟩
+    (by simp [divisionDecls])
+  simp only [AList.lookup, ↓reduceIte, Option.some.injEq] at hT
