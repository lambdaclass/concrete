+          exact .convert_int_invalid iha hloss
+      | bool b =>
+        simp only [CExpr.eval, ha, CEvalResult.bind]
+        exact .convert_bool_ok iha
+      | unit =>
+        simp only [CExpr.eval, ha, CEvalResult.bind]
