      (∃ d ∈ [ConstDecl.mk (U := ConstDemo.U) (ConstDemo.cid "USED") (.c (.int .u8)) (.int .u8 1),
              ConstDecl.mk (U := ConstDemo.U) (ConstDemo.cid "UNUSED") (.c (.int .i8))
