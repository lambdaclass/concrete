# Copy to ~/.config/concrete/notify.env and `chmod 600` it. NEVER commit the real file.
# scripts/land/notify.sh parses KEY=VALUE lines (it does not source this file).

# ntfy (https://ntfy.sh): install the ntfy app on the phone and subscribe to this topic. No account.
# An ntfy topic is a shared secret, not a name: anyone who knows it can read every notification and
# post fake ones. Use a long random string, for example the output of
#   python3 -c 'import secrets; print("concrete-" + secrets.token_urlsafe(24))'
# notify.sh refuses a topic shorter than 24 characters.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# Only for a self-hosted server or a reserved topic (values never carry trailing comments):
# NTFY_TOKEN=

# Slack incoming webhook (optional). The URL is itself the credential.
SLACK_WEBHOOK_URL=

# An identical (level, title, body) inside this many seconds is sent once.
NOTIFY_DEDUP_SECONDS=900
