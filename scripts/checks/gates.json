      "tools": {
        "lean": "lean-toolchain",
        "lcb": "lake-manifest.json",
        "nix": "flake.lock"
      },
      "seed": 0,
      "controls": [
        {
          "id": "refusal-unauthorised-plant",
          "command": [
            "env",
            "CAMPAIGN_EXPECT_FAILURE=1",
            "bash",
            "scripts/checks/compiler/scaling.sh",
            "--plant",
            "quadratic"
          ],
          "exit_code": 2,
          "diagnostic": "scaling: plants require --allow-planted-failure --plant linear|quadratic"
        },
        {
          "id": "refusal-invalid-tier",
          "command": [
            "env",
            "CAMPAIGN_EXPECT_FAILURE=1",
            "env",
            "SELECTED_TIER=invalid",
            "bash",
            "scripts/checks/compiler/scaling.sh"
          ],
          "exit_code": 2,
          "diagnostic": "scaling: invalid SELECTED_TIER"
        },
        {
          "id": "refusal-forged-runner",
          "command": [
            "env",
            "CAMPAIGN_EXPECT_FAILURE=1",
            "env",
            "GITHUB_REPOSITORY=unbalancedparentheses/concrete2",
            "RUNNER_ENVIRONMENT=github-hosted",
            "RUNNER_NAME=ubuntu-latest",
            "bash",
            "scripts/checks/compiler/scaling.sh"
          ],
          "exit_code": 1,
          "diagnostic": "forged runner: expected RUNNER_ENVIRONMENT=self-hosted"
        },
        {
          "id": "refusal-unauthorized-sha",
          "command": [
            "env",
            "CAMPAIGN_EXPECT_FAILURE=1",
            "env",
            "SELECTED_SHA=not-a-sha",
            "bash",
            "scripts/checks/compiler/scaling.sh"
          ],
          "exit_code": 1,
          "diagnostic": "FAIL scaling: unauthorized or invalid expected SHA: not-a-sha"
        },
        {
          "id": "refusal-mismatched-sha",
          "command": [
            "env",
            "CAMPAIGN_EXPECT_FAILURE=1",
            "env",
            "SELECTED_SHA=0000000000000000000000000000000000000000",
            "bash",
            "scripts/checks/compiler/scaling.sh"
          ],
          "exit_code": 1,
          "diagnostic": "FAIL scaling: checked-out HEAD does not match authorized expected SHA 0000000000000000000000000000000000000000"
        }
      ],
      "workflow": {
        "job": "scaling",
        "step": "Small deterministic family coverage (PR; no timing qualification)"
      }
