  "gates": [
    {
      "id": "landing-record",
      "tiers": [
        "pr",
        "qualification"
      ],
      "command": [
        "bash",
        "-c",
        "recorded=false run=\"\"\nif out=\"$(git fetch -q --depth=1 origin \"$BEFORE\" 2>&1 \\\n          && bash scripts/land/train.sh record \"$HEAD_SHA\" --base \"$BEFORE\" --exclude-run \"$GITHUB_RUN_ID\" 2>&1)\"; then\n  run=\"$(printf '%s\\n' \"$out\" | sed -n 's/^qualifying_run=\\([0-9][0-9]*\\)$/\\1/p' | tail -1)\"\nfi\nprintf '%s\\n' \"$out\"\nif [ -n \"$run\" ]; then\n  recorded=true\n  { echo \"### Landing record\"\n    echo \"Run [$run](https://github.com/$LAND_REPO/actions/runs/$run) passed every landing-tier and required job at exactly \\`$HEAD_SHA\\`.\"\n    echo \"This run skips those jobs: that run is the result for this SHA.\"; } >> \"$GITHUB_STEP_SUMMARY\"\nelse\n  { echo \"### No landing record\"\n    echo \"No run qualifies \\`$HEAD_SHA\\`, so every job runs here:\"\n    printf '\\n```\\n%s\\n```\\n' \"$out\"; } >> \"$GITHUB_STEP_SUMMARY\"\nfi\necho \"recorded=$recorded\" >> \"$GITHUB_OUTPUT\"\n"
      ],
      "budget_seconds": 120,
      "runner_class": "ci",
      "artifacts": [],
      "tools": {},
      "seed": null,
      "controls": [],
      "workflow": {
        "job": "landing-record",
        "step": "Look up the run that qualified this exact SHA (none found: every job runs here)"
      }
    },
